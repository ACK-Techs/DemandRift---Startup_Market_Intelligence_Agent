# Application
NODE_ENV=development
APP_NAME=DemandRift
APP_URL=http://localhost:3000
APP_PORT=3000
LOG_LEVEL=info
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
AUTH_SECRET=replace-with-a-local-random-value

# PostgreSQL
DATABASE_URL=postgresql://demandrift_local:demandrift_local@localhost:5432/demandrift_local
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Temporal durable workflows
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=demandrift-local
TEMPORAL_TLS_ENABLED=false

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=demandrift-local
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key

# AI Gateway and providers
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_BASE_URL=http://localhost:4010
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=mock-model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search providers and connector runtime
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
CONNECTOR_HTTP_USER_AGENT=DemandRift-Local/0.1
CONNECTOR_REQUEST_TIMEOUT_MS=15000
CONNECTOR_MAX_RESPONSE_BYTES=10485760
CONNECTOR_BROWSER_ENABLED=false
CONNECTOR_DEEP_RESEARCH_ENABLED=false

# Optional Redis coordination (not used as the workflow queue)
REDIS_URL=redis://localhost:6379/0

# Observability
OTEL_SERVICE_NAME=demandrift-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
