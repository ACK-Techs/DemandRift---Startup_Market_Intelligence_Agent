{
  "schemaVersion": "1.0.0",
  "systemName": "startup-research-platform-orchestrator",
  "paths": {
    "entrypoints": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents/skills/orchestrate-research-platform/SKILL.md"
    ],
    "skillRoots": [
      ".agents/skills",
      ".agent/skills",
      ".cursor/skills",
      ".claude/skills",
      ".codex/skills"
    ],
    "sourceRoots": [
      "apps",
      "packages",
      "infra",
      "faz-1-fikir-ve-arastirma",
      "faz-2-veri-toplama-ve-hazirlama",
      "faz-3-karar-ve-rapor",
      "ortak"
    ],
    "requiredContext": [
      "README.md",
      "ortak/README.md",
      "ortak/mimari-ve-kararlar.md",
      ".orchestrator/SYSTEM.md",
      ".orchestrator/roles/pm-manager.md"
    ],
    "runs": ".orchestrator/runs",
    "catalog": ".orchestrator/catalog/repo-context.json",
    "adapters": ".orchestrator/adapters"
  },
  "lifecycle": {
    "statuses": [
      "draft",
      "ready",
      "active",
      "blocked",
      "done",
      "failed",
      "cancelled"
    ],
    "terminalStatuses": [
      "done",
      "failed",
      "cancelled"
    ],
    "transitions": {
      "draft": [
        "ready",
        "cancelled"
      ],
      "ready": [
        "active",
        "blocked",
        "cancelled"
      ],
      "active": [
        "done",
        "blocked",
        "failed",
        "cancelled"
      ],
      "blocked": [
        "ready",
        "cancelled"
      ],
      "done": [],
      "failed": [],
      "cancelled": []
    }
  },
  "riskPolicy": {
    "levels": [
      "low",
      "medium",
      "high",
      "critical"
    ],
    "independentGateKinds": [],
    "requireIndependentReviewAt": [],
    "requireVerificationAt": [],
    "requireHumanDecisionFor": [
      "production-write",
      "destructive-operation",
      "secret-access",
      "paid-provider-enable",
      "external-message",
      "legal-source-approval",
      "schema-policy-change",
      "faz8-start"
    ],
    "forceQualityGateKinds": []
  },
  "authorityPolicy": {
    "managerHasDelegatedProjectAuthority": true,
    "managerMayApproveBoundaries": false,
    "platformApprovalsRemainExternal": true
  },
  "parallelPolicy": {
    "defaultMaxWriters": 1,
    "serializeUnknownWriteScope": true,
    "readOnlyItemsMayShareBatch": true,
    "preferWorktreeForParallelWriters": false
  },
  "historyPolicy": {
    "format": "jsonl",
    "appendOnly": true,
    "storeRawPrompts": false,
    "redactKeyFragments": [
      "authorization",
      "cookie",
      "password",
      "secret",
      "token",
      "apiKey",
      "privateKey",
      "personalData"
    ],
    "commitGeneratedRunsByDefault": false
  },
  "repoGuardrails": {
    "protectedPrefixes": [
      ".git"
    ],
    "doNotTouch": [],
    "controlledWritePaths": [],
    "commitRequiresExplicitRequest": true,
    "commitAfterValidatedWriteItemWhenApproved": false,
    "commitMessageConvention": "conventional-commits",
    "commitMessageFormat": "type(scope): summary",
    "commitWorkItemIdInBodyOrFooter": true,
    "pushRequiresExplicitRequest": true,
    "defaultTargetBranch": "main",
    "atomicCommitsRequired": true,
    "pushAcceptedIntegrationOnly": false,
    "forcePushAllowed": false,
    "mainOnly": true,
    "allowBranchCreation": false,
    "allowWorktreeCreation": false
  },
  "developmentWorkflow": {
    "mode": "main-final-validation",
    "plan": "ortak/gelistirme-plani.md",
    "orchestratorRequired": false,
    "testTiming": "after-all-features",
    "gitRole": "code_pusher",
    "allowBranchCreation": false,
    "allowWorktreeCreation": false
  }
}
