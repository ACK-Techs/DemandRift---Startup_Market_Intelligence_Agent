<!DOCTYPE html><html lang="en"><head><script async defer src="https://cdn.jsdelivr.net/npm/altcha/dist/altcha.min.js" type="module"></script><style>body {display: flex;flex-direction: column;width: 100vw;height: 100vh;background: #f8f8f6;overflow-y: auto;overflow-x: hidden;scroll-behavior: smooth;} .flex {display: flex;justify-content: center;} altcha-widget {width: 200px;margin-top: 100px;}</style><script>let uuid="1739603761270|38hQiIeKogwWs85Sr21UiMezD3BYZ6rbXt9S9Nj8Fto"; let redirect = "/"; let hash_search = localStorage.getItem("gbd.hashSearches"); function guid() {function _p8(s) {    var p = (Math.random().toString(16)+"000000000").substr(2,8); return s ? "-" + p.substr(0,4) + "-" + p.substr(4,4) : p ;}return _p8() + _p8(true) + _p8(true) + _p8();}</script></head><body><div class="flex"><altcha-widget challengeurl="https://api.branddb.wipo.int/captcha", auto="onload", hidefooter="true", hidelogo="true"></altcha-widget></div><script> if(hash_search){document.cookie = "session_id="+ uuid +"; path=/"; document.location.href = redirect}else{document.querySelector("altcha-widget").addEventListener("statechange", (ev) => {if (ev.detail.state === "verified"){let token = ev.detail.payload; hash_search = guid(); let url = "https://api.branddb.wipo.int/dbinfo?token="+ token; var xmlHttp = new XMLHttpRequest(); xmlHttp.onreadystatechange = function() {if (xmlHttp.readyState == 4 && xmlHttp.status == 200){ localStorage.setItem("gbd.hashSearches", hash_search); document.cookie = "session_id="+ uuid +"; path=/"; document.location.href=redirect;}}; xmlHttp.open("GET", url, true); xmlHttp.setRequestHeader("HashSearch",hash_search);xmlHttp.send(null);}});}</script></body></html>

