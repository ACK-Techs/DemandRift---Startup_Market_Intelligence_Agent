    }
    data.sendOnlyTo = 'aa';
  }

  (trulia.dataLayer.listeners || []).forEach(function (listener) {
    listener(event, data);
  });

  handleComscore(data, event);
};

const queue = [];
const processQueue = function () {
  if (listenersDefined()) {
    if (queue.length) {
      let queuedData;
      while ((queuedData = queue.shift())) {
        handleEvent(
          queuedData.event,
          queuedData.data,
          queuedData.isInitialPageView
        );
      }
    }
    return true;
  }

  if (count <= MAX_COUNT) {
    setTimeout(processQueue, 300);
    count += 1;
  }
  return false;
};

const track = function (event, data, isInitialPageView) {
  if (processQueue()) {
    handleEvent(event, data, isInitialPageView);
  } else {
    queue.push({
      event: event,
      data: data,
      isInitialPageView: isInitialPageView,
    });
  }
};

if (pageviewPayload) {
  track('trackState', pageviewPayload, true);
}

