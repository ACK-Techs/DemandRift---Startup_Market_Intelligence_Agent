{"total_count":339074,"incomplete_results":false,"items":[{"url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38","repository_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft","labels_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38/labels{/name}","comments_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38/comments","events_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38/events","html_url":"https://github.com/d-ducluzeaud/pace-craft/issues/38","id":5435875559,"node_id":"I_kwDOUYHbVM8AAAABRADg5w","number":38,"title":"Detect breaking OpenAPI contract changes","user":{"login":"d-ducluzeaud","id":322582907,"node_id":"U_kgDOEzo5ew","avatar_url":"https://avatars.githubusercontent.com/u/322582907?v=4","gravatar_id":"","url":"https://api.github.com/users/d-ducluzeaud","html_url":"https://github.com/d-ducluzeaud","followers_url":"https://api.github.com/users/d-ducluzeaud/followers","following_url":"https://api.github.com/users/d-ducluzeaud/following{/other_user}","gists_url":"https://api.github.com/users/d-ducluzeaud/gists{/gist_id}","starred_url":"https://api.github.com/users/d-ducluzeaud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-ducluzeaud/subscriptions","organizations_url":"https://api.github.com/users/d-ducluzeaud/orgs","repos_url":"https://api.github.com/users/d-ducluzeaud/repos","events_url":"https://api.github.com/users/d-ducluzeaud/events{/privacy}","received_events_url":"https://api.github.com/users/d-ducluzeaud/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":12169133577,"node_id":"LA_kwDOUYHbVM8AAAAC1VY-CQ","url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/labels/type:story","name":"type:story","color":"1D76DB","default":false,"description":"Vertical user-facing backend slice","archived_at":null,"archived_by":null},{"id":12169133604,"node_id":"LA_kwDOUYHbVM8AAAAC1VY-JA","url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/labels/area:foundation","name":"area:foundation","color":"C5DEF5","default":false,"description":"Platform and delivery foundation","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/milestones/1","html_url":"https://github.com/d-ducluzeaud/pace-craft/milestone/1","labels_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/milestones/1/labels","id":17821903,"node_id":"MI_kwDOUYHbVM4BD_DP","number":1,"title":"Foundation","description":"Reproducible API platform and delivery baseline","creator":{"login":"d-ducluzeaud","id":322582907,"node_id":"U_kgDOEzo5ew","avatar_url":"https://avatars.githubusercontent.com/u/322582907?v=4","gravatar_id":"","url":"https://api.github.com/users/d-ducluzeaud","html_url":"https://github.com/d-ducluzeaud","followers_url":"https://api.github.com/users/d-ducluzeaud/followers","following_url":"https://api.github.com/users/d-ducluzeaud/following{/other_user}","gists_url":"https://api.github.com/users/d-ducluzeaud/gists{/gist_id}","starred_url":"https://api.github.com/users/d-ducluzeaud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-ducluzeaud/subscriptions","organizations_url":"https://api.github.com/users/d-ducluzeaud/orgs","repos_url":"https://api.github.com/users/d-ducluzeaud/repos","events_url":"https://api.github.com/users/d-ducluzeaud/events{/privacy}","received_events_url":"https://api.github.com/users/d-ducluzeaud/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":4,"closed_issues":0,"state":"open","created_at":"2026-09-12T20:36:42Z","updated_at":"2026-09-12T20:39:13Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-09-12T20:39:13Z","updated_at":"2026-09-12T20:39:13Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/2","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## User outcome\\n\\nReviewers can distinguish intentional API evolution from accidental contract drift.\\n\\n## Scope\\n\\nCompare the generated contract with the accepted baseline; fail CI on unexplained drift; report breaking changes clearly; document the intentional-change workflow.\\n\\n## Out of scope\\n\\nPublishing a public client SDK or supporting multiple API versions.\\n\\n## Acceptance criteria\\n\\n- [ ] The stated behavior is observable through the public API contract where applicable.\\n- [ ] Runtime validation and RFC 9457 errors cover invalid input and failure paths.\\n- [ ] Relevant automated tests and PostgreSQL constraints pass.\\n- [ ] OpenAPI, Bruno, and operational documentation are updated when affected.\\n- [ ] CI is green.","reactions":{"url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/d-ducluzeaud/pace-craft/issues/38/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899","repository_url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy","labels_url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899/labels{/name}","comments_url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899/comments","events_url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899/events","html_url":"https://github.com/damien-robotsix/robotsix-central-deploy/pull/899","id":5522581638,"node_id":"PR_kwDOTE8Yrs8AAAABEXQFJQ","number":899,"title":"chore: Add OpenAPI breaking-change detection to CI (20260920T150053Z-add-openapi-breaking-change-detection-to-b570)","user":{"login":"robotsix-mill[bot]","id":285582353,"node_id":"BOT_kgDOEQWkEQ","avatar_url":"https://avatars.githubusercontent.com/u/130368771?v=4","gravatar_id":"","url":"https://api.github.com/users/robotsix-mill%5Bbot%5D","html_url":"https://github.com/apps/robotsix-mill","followers_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/followers","following_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/repos","events_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/robotsix-mill%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-09-21T04:02:36Z","updated_at":"2026-09-21T04:02:36Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/pulls/899","html_url":"https://github.com/damien-robotsix/robotsix-central-deploy/pull/899","diff_url":"https://github.com/damien-robotsix/robotsix-central-deploy/pull/899.diff","patch_url":"https://github.com/damien-robotsix/robotsix-central-deploy/pull/899.patch","merged_at":null},"body":"## Problem\n\nThe repository has strong OpenAPI schema validation in CI (drift checking and Redocly linting at `.github/workflows/ci.yml` lines 524–554), but **no breaking-change detection**. The current `openapi-drift` job ensures the schema matches the code and is syntactically valid, but does not flag when endpoints are removed, response fields are required, parameter types change, or HTTP status codes shift — all of which could break API consumers.\n\n## Current State\n\n- `openapi-drift` CI job regenerates `docs/lifecycle/openapi.json` and checks for staleness with `git diff --exit-code`\n- Redocly linting validates schema syntax compliance\n- Route stability test (`tests/lifecycle/routers/test_self_config.py:323`) manually checks specific critical routes\n- **Missing**: Automated detection of backward-incompatible schema changes\n\n## Solution\n\nIntegrate a breaking-change detector into the CI pipeline:\n\n1. Add `openapi-diff` (or similar tool) as a dev dependency:\n   ```\n   npm install --save-dev @openapitools/openapi-diff\n   # or: uv run --with openapi-diff\n   ```\n\n2. Extend `.github/workflows/ci.yml` `openapi-drift` job (after Redocly lint):\n   ```bash\n   - name: Check for OpenAPI breaking changes\n     run: |\n       if [ -f docs/lifecycle/openapi.json.baseline ]; then\n         openapi-diff docs/lifecycle/openapi.json.baseline docs/lifecycle/openapi.json --fail-on-breaking-changes\n       fi\n   ```\n\n3. On intentional breaking changes, document the change in CHANGELOG.md and require manual approval (e.g., commit signing or approval gate).\n\n## Why This Matters\n\n- **API stability**: Prevents accidental breaking changes from silently reaching consumers\n- **Observability**: CI output clearly lists what changed (removed endpoints, schema changes, etc.)\n- **Standard practice**: Tools like GitHub's OpenAPI, AWS SDK, and major API providers enforce breaking-change detection\n- **Low friction**: Single CI step, no code changes required\n\n## References\n\n- Current schema: `docs/lifecycle/openapi.json` (version \"0.1.0\")\n- Current drift check: `.github/workflows/ci.yml` lines 524–554\n- Tools: `openapi-diff`, `spectacle`, or equivalent\n\n\n<!-- survey-gap-id: openapi_breaking_change_detection -->\n\n---\nAutomated by robotsix-mill · ticket `20260920T150053Z-add-openapi-breaking-change-detection-to-b570`","reactions":{"url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/damien-robotsix/robotsix-central-deploy/issues/899/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479","repository_url":"https://api.github.com/repos/Health-watchers/health_watchers","labels_url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479/labels{/name}","comments_url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479/comments","events_url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479/events","html_url":"https://github.com/Health-watchers/health_watchers/issues/1479","id":5553370653,"node_id":"I_kwDORoWSFs8AAAABSwG2HQ","number":1479,"title":"[CI/CD] Detect breaking OpenAPI changes on pull requests","user":{"login":"soma-enyi","id":198760496,"node_id":"U_kgDOC9jYMA","avatar_url":"https://avatars.githubusercontent.com/u/198760496?v=4","gravatar_id":"","url":"https://api.github.com/users/soma-enyi","html_url":"https://github.com/soma-enyi","followers_url":"https://api.github.com/users/soma-enyi/followers","following_url":"https://api.github.com/users/soma-enyi/following{/other_user}","gists_url":"https://api.github.com/users/soma-enyi/gists{/gist_id}","starred_url":"https://api.github.com/users/soma-enyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/soma-enyi/subscriptions","organizations_url":"https://api.github.com/users/soma-enyi/orgs","repos_url":"https://api.github.com/users/soma-enyi/repos","events_url":"https://api.github.com/users/soma-enyi/events{/privacy}","received_events_url":"https://api.github.com/users/soma-enyi/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11057406925,"node_id":"LA_kwDORoWSFs8AAAACkxKjzQ","url":"https://api.github.com/repos/Health-watchers/health_watchers/labels/api","name":"api","color":"abcfab","default":false,"description":"","archived_at":null,"archived_by":null},{"id":12326426680,"node_id":"LA_kwDORoWSFs8AAAAC3rZYOA","url":"https://api.github.com/repos/Health-watchers/health_watchers/labels/ci","name":"ci","color":"c5def5","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-09-23T12:26:34Z","updated_at":"2026-09-23T12:26:34Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Labels:** `ci`, `api` · **Difficulty:** 🟡 Medium\n\n**Description:**\nAPI consumers (web, mobile, third parties) break when endpoints change without notice.\n\n**Tasks:**\n- Generate the OpenAPI spec in CI (depends on the Zod→OpenAPI issue)\n- Diff it against `main` with `oasdiff` and label PRs with `breaking-api-change`\n- Require a changeset or migration note when the change is breaking\n\n**Acceptance Criteria:**\n- Removing a response field in a test PR is flagged as breaking","reactions":{"url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Health-watchers/health_watchers/issues/1479/timeline","performed_via_github_app":{"id":54007,"client_id":"Iv1.ad5f73e593b03f40","slug":"github-codespaces","node_id":"MDM6QXBwNTQwMDc=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url":"https://api.github.com/users/github/following{/other_user}","gists_url":"https://api.github.com/users/github/gists{/gist_id}","starred_url":"https://api.github.com/users/github/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github/subscriptions","organizations_url":"https://api.github.com/users/github/orgs","repos_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Codespaces","description":"","external_url":"https://github.com/features/codespaces","html_url":"https://github.com/apps/github-codespaces","created_at":"2020-02-13T17:53:37Z","updated_at":"2026-06-22T12:47:28Z","permissions":{"actions":"read","checks":"read","codespaces":"read","codespaces_secrets":"write","codespaces_user_secrets":"write","contents":"write","deployments":"read","discussions":"read","issues":"write","metadata":"read","packages":"read","pages":"read","pull_requests":"write","pull_requests_comment_only_reviews":"write","pull_requests_from_forks":"write","repository_projects":"read","statuses":"read","workflows":"write"},"events":[]},"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706","repository_url":"https://api.github.com/repos/dotnet/AspNetCore.Docs","labels_url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706/labels{/name}","comments_url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706/comments","events_url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706/events","html_url":"https://github.com/dotnet/AspNetCore.Docs/issues/37706","id":5519758542,"node_id":"I_kwDOAa7mX88AAAABSQDUzg","number":37706,"title":"v11 update: OpenAPI 3.2.0 support (Microsoft.OpenApi 3.x breaking change)","user":{"login":"wadepickett","id":10985336,"node_id":"MDQ6VXNlcjEwOTg1MzM2","avatar_url":"https://avatars.githubusercontent.com/u/10985336?v=4","gravatar_id":"","url":"https://api.github.com/users/wadepickett","html_url":"https://github.com/wadepickett","followers_url":"https://api.github.com/users/wadepickett/followers","following_url":"https://api.github.com/users/wadepickett/following{/other_user}","gists_url":"https://api.github.com/users/wadepickett/gists{/gist_id}","starred_url":"https://api.github.com/users/wadepickett/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wadepickett/subscriptions","organizations_url":"https://api.github.com/users/wadepickett/orgs","repos_url":"https://api.github.com/users/wadepickett/repos","events_url":"https://api.github.com/users/wadepickett/events{/privacy}","received_events_url":"https://api.github.com/users/wadepickett/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":6445100334,"node_id":"LA_kwDOAa7mX88AAAABgChtLg","url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/labels/fundamentals/subsvc","name":"fundamentals/subsvc","color":"ededed","default":false,"description":null,"archived_at":null,"archived_by":null},{"id":8922431543,"node_id":"LA_kwDOAa7mX88AAAACE9GANw","url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/labels/11.0","name":"11.0","color":"c0ff41","default":false,"description":".NET 11","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-09-20T18:46:22Z","updated_at":"2026-09-24T04:32:38Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"> [!NOTE]\n> This is an AI-assisted coverage analysis created by wadepickett.\n\n**Target repository:** `dotnet/AspNetCore.Docs`\n**Analyzed at commit:** `4986136881f2bbf1879f10106467769df5a49932`\n**Product source verified at:** `dotnet/aspnetcore` @ `1fcd7ef305697a1888f3ede076010350ae9f4f8d`\n**Source release note:** [OpenAPI 3.2.0 support (Breaking Change)](https://learn.microsoft.com/en-us/aspnet/core/release-notes/aspnetcore-11#openapi-320-support-breaking-change)\n\n> [!IMPORTANT]\n> **`customize-openapi.md` is split by three separate .NET 11 issues.** The article body is a single `:::moniker range=\">= aspnetcore-10.0\"` zone (L13 → L233), and three issues each need an independent State D split inside it:\n>\n> | Issue | Insertion point | Subject |\n> |---|---|---|\n> | **This issue** | **L30** | `Microsoft.OpenApi` 3.x upgrade warning for transformer authors |\n> | [#37705](https://github.com/dotnet/AspNetCore.Docs/issues/37705) | L108 | `[Obsolete]` replaces the manual deprecation transformer |\n> | [#37703](https://github.com/dotnet/AspNetCore.Docs/issues/37703) | L202 | Array schema reference IDs |\n>\n> The splits don't overlap textually and can be applied in any order, but **each issue's stated moniker balance assumes it is the only one applied.** The zone count goes 1 / 1 → 3 / 3 → 5 / 5 → **7 / 7** once all three land. Apply them bottom-up (L202, then L108, then L30) so earlier line numbers stay valid, and re-derive the enclosing zone before each.\n\n---\n\n## 🎯 Goal\n\n**The feature itself is documented and so is the breaking change. The problem is that nothing connects them to the article where the break is felt.**\n\nBoth halves of this release note already have homes:\n\n* OpenAPI 3.2.0 support is stated at [`fundamentals/openapi/aspnetcore-openapi.md` L17](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L17), and how to select the version is shown at [L25–L34](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L25-L34).\n* The `Microsoft.OpenApi` 2.x → 3.x break has a full, high-quality dedicated article at [`breaking-changes/11/microsoft-openapi-3x.md`](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md), listed in the .NET 11 breaking-changes index at [`breaking-changes/11/overview.md` L24](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/overview.md#L24). It enumerates the removed `OpenApiAny` types, the `IOpenApiSchema`/`IOpenApiAny` interface shift, the removed `ParseNode` infrastructure, and the reshaped `OpenApiReference`.\n\nWhat's missing is the link between them. **A repository-wide search of `aspnetcore/fundamentals/openapi/` for any reference to a `breaking-changes/11/` article returns zero results.** The only breaking-change link anywhere in that folder is to a .NET 10 analyzers change at [`include-metadata.md` L468](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/include-metadata.md#L468).\n\nThat matters because of *who* this break hits. Per the breaking-change article: \"Transformer code that does anything more than read-only inspection—sets extension values, walks nested schemas, or constructs new schemas—usually needs to be updated.\" The reader whose `AddSchemaTransformer` call stopped compiling opens [*Customize OpenAPI documents*](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md) — the transformers article — not a breaking-changes index they've never browsed. That article says nothing about the upgrade.\n\nA second, smaller problem: the breaking-change article pins a specific patch version that has already gone stale.\n\n---\n\n## ✅ Coverage status summary\n\n**Legend:** ✅ already documented · ✏️ update needed · 🟣 could not determine\n\n| # | Feature element from What's New | Status | Where |\n|---|---|:--:|---|\n| 1 | `Microsoft.AspNetCore.OpenApi` supports generating OpenAPI 3.2.0 documents | ✅ | [`aspnetcore-openapi.md` L17](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L17) |\n| 2 | The support comes via an updated dependency on `Microsoft.OpenApi` 3.x | ✅ | [`breaking-changes/11/microsoft-openapi-3x.md` L9](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L9) |\n| 3 | The update includes breaking changes from the underlying library | ✅ | [`microsoft-openapi-3x.md` L37–L46](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L37-L46) |\n| 4 | Breaking change is listed in the .NET 11 breaking-changes index | ✅ | [`breaking-changes/11/overview.md` L24](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/overview.md#L24) |\n| 5 | Which transformer interfaces are affected | ✅ | [`microsoft-openapi-3x.md` L67–L72](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L67-L72) |\n| 6 | Set `options.OpenApiVersion = OpenApiSpecVersion.OpenApi3_2` when calling `AddOpenApi` | ✅ | [`aspnetcore-openapi.md` L25–L34](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L25-L34) |\n| 7 | **No article under `fundamentals/openapi/` links to the `Microsoft.OpenApi` 3.x breaking change — including the transformers article, where the break is actually felt** | ✏️ | **1. Update** — [`fundamentals/openapi/customize-openapi.md` L25–L31](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L25-L31) |\n| 8 | **The breaking-change article pins \"currently 3.6.0\"; the product's version range has since moved, and the article doesn't link the canonical upgrade guide the release note points at** | ✏️ | **2. Update** — [`breaking-changes/11/microsoft-openapi-3x.md` L9](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L9) and [L65](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L65) |\n| 9 | \"Subsequent updates take advantage of new capabilities in the 3.2.0 specification, such as item schema support for streaming events\" | 🟣 | Forward reference to Server-Sent Events `itemSchema` support. **Owned by [#37704](https://github.com/dotnet/AspNetCore.Docs/issues/37704)**, where it's a confirmed gap. Not addressed here. |\n\n---\n\n## 🔢 Version applicability\n\n**Applies to:** `>= aspnetcore-11.0`\n**Target moniker:** `>= aspnetcore-11.0`\n**Earlier versions affected:** None. .NET 10 and earlier depend on `Microsoft.OpenApi` 2.x and must not see this content.\n\n| Article | `monikerRange` | Moniker state |\n|---|---|---|\n| `aspnetcore/fundamentals/openapi/customize-openapi.md` | `'>= aspnetcore-9.0'` | **State D — insertion sits inside a broader zone.** The article body has exactly one zone: `:::moniker range=\">= aspnetcore-10.0\"` opens at [L13](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L13) and `:::moniker-end` closes at [L233](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L233). The insertion point at L30 is inside it, and `>= aspnetcore-10.0` is **broader** than the target `>= aspnetcore-11.0`. The full four-directive split is required. |\n| `aspnetcore/breaking-changes/11/microsoft-openapi-3x.md` | *(none)* | **State A — no moniker zones.** Verified: the file contains **0** `:::moniker range=` and **0** `:::moniker-end` directives, and **0** tab-group markers. Breaking-change articles are version-scoped by folder (`breaking-changes/11/`), not by moniker. Edit the prose directly; adding a zone here would be wrong. |\n\n**Tab groups:** Neither insertion point is inside a `# [Tab](#tab/...)` group. `customize-openapi.md` contains no tab groups at all.\n\n---\n\n## 📋 Coverage gap summary\n\nThe `Microsoft.OpenApi` 2.x → 3.x bump is a source-incompatible change that breaks exactly one kind of code: OpenAPI transformers. ASP.NET Core has a whole article about writing those — *Customize OpenAPI documents* — and it was written against the 2.x object model. It registers document, operation, and schema transformers, walks schemas, and sets extension values. It never mentions that in .NET 11 the types those transformers receive changed shape.\n\nA developer upgrading to .NET 11 gets a compile error on `new OpenApiString(...)` and goes straight to the transformers article for the fix. It isn't there. The fix is one folder away in a breaking-changes article they have no reason to guess exists, and nothing in the OpenAPI documentation set points at it.\n\nSeparately, the breaking-change article states the dependency is \"`Microsoft.OpenApi` 3.x (currently 3.6.0).\" At the pinned product commit, `eng/Versions.props` declares `<MicrosoftOpenApiVersion>[3.10.2,4.0.0)</MicrosoftOpenApiVersion>`. Pinning a patch version in prose guarantees the article goes stale between servicing releases; the major version is the durable fact and is already in the title.\n\n**Feature announced in What's New:**\n> `Microsoft.AspNetCore.OpenApi` now supports OpenAPI 3.2.0 through an updated dependency on `Microsoft.OpenApi` 3.3.1. This update includes breaking changes from the underlying library. For more information, see the [Microsoft.OpenApi upgrade guide](https://github.com/microsoft/OpenAPI.NET/blob/main/docs/upgrade-guide-3.md).\n\n**Breaking change:** Yes — source incompatible, and binary incompatible for libraries compiled against `Microsoft.OpenApi` 2.x. Already correctly classified in the existing breaking-change article.\n\n> **Note on the version number in the release note.** The release note says the dependency is `Microsoft.OpenApi` **3.3.1**. The breaking-change article says **3.6.0**. Product source at the pinned commit says **`[3.10.2,4.0.0)`**. Three different numbers in three places. The release-note figure is a separate problem and is deliberately **not** treated as a docset coverage gap here. Change 2 below fixes only the docset half.\n\n---\n\n## 📁 Affected files\n\n| Item | Path | Lines | Section |\n|------|------|-------|---------|\n| 1. | [`aspnetcore/fundamentals/openapi/customize-openapi.md`](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L25-L31) | 25–31 | \"OpenAPI document transformers\" |\n| 2. | [`aspnetcore/breaking-changes/11/microsoft-openapi-3x.md`](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L9) | 9, 65 | Intro; \"Recommended action\" |\n\n**Target article uids:** `fundamentals/openapi/customize-openapi` *(the breaking-change article has no `uid`; link it by site-relative path, as `include-metadata.md` L468 already does for the .NET 10 analyzers change)*\n\n---\n\n## 📝 Proposed changes\n\n### ✏️ 1. Update — `aspnetcore/fundamentals/openapi/customize-openapi.md`, insert after line 30\n\n**Applies to:** `>= aspnetcore-11.0`\n**Moniker handling:** **State D — full four-directive split required.** The insertion point is inside `:::moniker range=\">= aspnetcore-10.0\"` (opens L13, closes L233), which is broader than the target. The edit must close that zone, open `>= aspnetcore-11.0`, add the content, close it, and reopen `>= aspnetcore-10.0` with the range expression reproduced **character for character**, including the double quotes and the space after `range=`.\n**Moniker balance:** currently **1** `:::moniker range=` and **1** `:::moniker-end`. After this edit alone: **3** and **3**. See the callout at the top of this issue — two other issues split the same zone, and all three together produce **7 / 7**.\n**Location:** [Line 30](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L25-L31), between the three-category transformer list and the paragraph that begins \"Transformers can be registered onto the document\".\n\n**Before (lines 25–31):**\n\n```markdown\nTransformers fall into three categories:\n\n* Document transformers have access to the entire OpenAPI document. These can be used to make global modifications to the document.\n* Operation transformers apply to each individual operation. Each individual operation is a combination of path and HTTP method. These can be used to modify parameters or responses on endpoints.\n* Schema transformers apply to each schema in the document. These can be used to modify the schema of request or response bodies, or any nested schemas.\n\nTransformers can be registered onto the document by calling the <xref:Microsoft.AspNetCore.OpenApi.OpenApiOptions.AddDocumentTransformer%2A> method on the <xref:Microsoft.AspNetCore.OpenApi.OpenApiOptions> object. The following snippet shows different ways to register transformers onto the document:\n```\n\n**After:**\n\n```markdown\nTransformers fall into three categories:\n\n* Document transformers have access to the entire OpenAPI document. These can be used to make global modifications to the document.\n* Operation transformers apply to each individual operation. Each individual operation is a combination of path and HTTP method. These can be used to modify parameters or responses on endpoints.\n* Schema transformers apply to each schema in the document. These can be used to modify the schema of request or response bodies, or any nested schemas.\n\n:::moniker-end\n\n:::moniker range=\">= aspnetcore-11.0\"\n\n> [!IMPORTANT]\n> .NET 11 upgrades `Microsoft.AspNetCore.OpenApi` from `Microsoft.OpenApi` 2.x to 3.x. The transformer interfaces are unchanged, but the shape of the `OpenApiDocument`, `OpenApiOperation`, and `OpenApiSchema` objects they receive has changed. Transformer code that sets extension values, walks nested schemas, or constructs new schemas usually needs to be updated. For migration guidance, see [Microsoft.OpenApi upgraded to 3.x](/aspnet/core/breaking-changes/11/microsoft-openapi-3x).\n\n:::moniker-end\n\n:::moniker range=\">= aspnetcore-10.0\"\n\nTransformers can be registered onto the document by calling the <xref:Microsoft.AspNetCore.OpenApi.OpenApiOptions.AddDocumentTransformer%2A> method on the <xref:Microsoft.AspNetCore.OpenApi.OpenApiOptions> object. The following snippet shows different ways to register transformers onto the document:\n```\n\n**Rationale:** This is the article the reader is already in when the question occurs to them. It's placed after the definition of the three transformer categories — so the reader knows what a transformer *is* before being told theirs may not compile — and before the registration walkthrough, so they see the warning before copying any sample. It's a pointer, not a duplicate: all the migration detail stays in the breaking-change article, which is the right owner and is already thorough.\n\n> ⚠️ **Don't take the article's `>= aspnetcore-9.0` front matter as license to insert directly.** Front-matter `monikerRange` gates which versions render the article at all; it says nothing about which zone an insertion point falls in. The enclosing zone here is `>= aspnetcore-10.0`, and .NET 10 readers must not see a .NET 11 upgrade warning.\n\n---\n\n### ✏️ 2. Update — `aspnetcore/breaking-changes/11/microsoft-openapi-3x.md`, replace line 9 and line 65\n\n**Applies to:** the whole article (version-scoped by its `breaking-changes/11/` folder)\n**Moniker handling:** **State A — no zones exist and none should be added.** The file has 0 moniker directives and 0 tab groups. **Moniker balance is 0/0 before and 0/0 after.**\n**Location:** [Line 9](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L9) (opening paragraph) and [line 65](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md#L65) (last line of \"Recommended action\").\n\n**Before (line 9):**\n\n```markdown\n`Microsoft.AspNetCore.OpenApi` in ASP.NET Core 11 takes a dependency on `Microsoft.OpenApi` 3.x (currently 3.6.0). The previous release (.NET 10) depended on `Microsoft.OpenApi` 2.x. This is a major-version bump of a transitive dependency, and several types that document and operation transformers receive have changed shape.\n```\n\n**After (line 9):**\n\n```markdown\n`Microsoft.AspNetCore.OpenApi` in ASP.NET Core 11 takes a dependency on `Microsoft.OpenApi` 3.x. The previous release (.NET 10) depended on `Microsoft.OpenApi` 2.x. This is a major-version bump of a transitive dependency, and several types that document and operation transformers receive have changed shape.\n```\n\n**Before (line 65):**\n\n```markdown\nFor the canonical migration notes for the 3.0, 3.1, 3.2, and later releases, see the [OpenAPI.NET release notes](https://github.com/microsoft/OpenAPI.NET/releases).\n```\n\n**After (line 65):**\n\n```markdown\nFor step-by-step migration instructions, see the [Microsoft.OpenApi 3.x upgrade guide](https://github.com/microsoft/OpenAPI.NET/blob/main/docs/upgrade-guide-3.md). For the per-release notes covering the 3.0, 3.1, 3.2, and later releases, see the [OpenAPI.NET release notes](https://github.com/microsoft/OpenAPI.NET/releases).\n```\n\n**Rationale:** Dropping \"(currently 3.6.0)\" removes the only part of the sentence guaranteed to rot — the patch version moves with every servicing release, and at the pinned product commit the declared range is already `[3.10.2,4.0.0)`. The major version, which is the fact readers act on, survives in the title and in the remaining sentence. The line 65 change adds the upgrade guide the release note itself links to; it's the actionable migration document, while the releases page is a changelog.\n\n---\n\n### ✅ 3. Update — TOC\n\n**No TOC change required.** Both articles already have entries: `customize-openapi.md` under *Fundamentals > OpenAPI*, and `microsoft-openapi-3x.md` in the .NET 11 breaking-changes index at [`overview.md` L24](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/overview.md#L24).\n\n---\n\n## ✅ Action plan\n\n1. Read [`breaking-changes/11/microsoft-openapi-3x.md`](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md) end to end and confirm rows 2–5. It is comprehensive; resist the urge to restate any of it in `customize-openapi.md`.\n2. Apply change 2 first. It's two single-line prose replacements in an article with no moniker zones and no tab groups — the lowest-risk edit in this issue.\n3. Check whether [#37705](https://github.com/dotnet/AspNetCore.Docs/issues/37705) (L108) or [#37703](https://github.com/dotnet/AspNetCore.Docs/issues/37703) (L202) has already split `customize-openapi.md`. If so, re-derive the enclosing zone of L30 and the expected balance from the current file rather than trusting the figures below.\n4. Apply change 1. Copy `:::moniker range=\">= aspnetcore-10.0\"` from L13 verbatim when reopening the zone. A reopened range that differs by even a space silently drops the rest of the article from the .NET 10 build.\n5. Verify zone balance in `customize-openapi.md`: **3** `:::moniker range=` and **3** `:::moniker-end` after this edit alone, up from 1 and 1 — or **5 / 5** or **7 / 7** if the other issues have landed.\n6. Build with the .NET 10 moniker and confirm everything from the transformer-registration paragraph to the end of the article still renders. This is the specific failure a mismatched reopened range produces.\n7. Build with the .NET 11 moniker and confirm the new `IMPORTANT` note renders exactly once.\n8. Verify the site-relative link `/aspnet/core/breaking-changes/11/microsoft-openapi-3x` resolves. The breaking-change article has no `uid`, so it can't be referenced with `<xref:>`; [`include-metadata.md` L468](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/include-metadata.md#L468) establishes the site-relative pattern for this docset.\n9. Verify the external link `https://github.com/microsoft/OpenAPI.NET/blob/main/docs/upgrade-guide-3.md` resolves (confirmed HTTP 200 at analysis time).\n10. Resolve any OpenPublishing.Build warnings.\n\n---\n\n## ⚠️ Review considerations\n\n* **Row 9 is deliberately left at 🟣 here.** The release note's closing sentence — \"Subsequent updates take advantage of new capabilities in the 3.2.0 specification, such as item schema support for streaming events\" — is a forward reference to the Server-Sent Events `itemSchema` work, which is its own release-note section. It's a confirmed docset gap, but [#37704](https://github.com/dotnet/AspNetCore.Docs/issues/37704) owns it. Fixing it here would put streaming-events content in the transformers article, which is the wrong place.\n* **Overlap with [#37701](https://github.com/dotnet/AspNetCore.Docs/issues/37701).** The release note tells readers to set `options.OpenApiVersion = OpenApiSpecVersion.OpenApi3_2` to get a 3.2 document. A later change in the same release made 3.2 the default, so that instruction is no longer necessary. [`aspnetcore-openapi.md` L25](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L25) already states the default correctly, so the docset is right where the release note is misleading. #37701 covers the default-version story and the one remaining stale spot at [L117–L126](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L117-L126). Don't duplicate that here.\n* **Should the pointer also go in `aspnetcore-openapi.md`?** Considered and not proposed. That article is the OpenAPI overview; the break is specific to transformer authors, and a second copy of the warning in the overview would dilute it and add a second State D split for marginal benefit. If a reviewer wants broader signposting, the cheaper option is a line in the breaking-changes index rather than another zone split.\n* **Change 2 touches a breaking-change article, not a `fundamentals/` article.** That's intentional and in scope: `breaking-changes/11/` is evergreen reference content, not release notes, so it's a legitimate edit target. `aspnetcore/release-notes/**` is not, and nothing here proposes an edit there.\n* **Out of scope for this issue:** the `Microsoft.OpenApi` version number in the release note (a release-note problem, not a docset gap); OpenAPI 3.2 becoming the default ([#37701](https://github.com/dotnet/AspNetCore.Docs/issues/37701)); Server-Sent Events item schemas ([#37704](https://github.com/dotnet/AspNetCore.Docs/issues/37704)).\n\n---\n\n## 🔗 References\n\n* What's New section: [OpenAPI 3.2.0 support (Breaking Change)](https://learn.microsoft.com/en-us/aspnet/core/release-notes/aspnetcore-11#openapi-320-support-breaking-change)\n* Existing breaking-change article: [`breaking-changes/11/microsoft-openapi-3x.md`](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/microsoft-openapi-3x.md)\n* Breaking-changes index entry: [`breaking-changes/11/overview.md` L24](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/breaking-changes/11/overview.md#L24)\n* 3.2 support statement: [`aspnetcore-openapi.md` L17](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/aspnetcore-openapi.md#L17)\n* Edit target: [`customize-openapi.md` L13–L43](https://github.com/dotnet/AspNetCore.Docs/blob/4986136881f2bbf1879f10106467769df5a49932/aspnetcore/fundamentals/openapi/customize-openapi.md#L13-L43)\n* Product source — the declared `Microsoft.OpenApi` version range at the pinned commit: [`eng/Versions.props` L219–L220](https://github.com/dotnet/aspnetcore/blob/1fcd7ef305697a1888f3ede076010350ae9f4f8d/eng/Versions.props#L219-L220)\n* Upstream migration guide: [Microsoft.OpenApi 3.x upgrade guide](https://github.com/microsoft/OpenAPI.NET/blob/main/docs/upgrade-guide-3.md)\n* Implementing PRs cited by the existing breaking-change article: [dotnet/aspnetcore#65415](https://github.com/dotnet/aspnetcore/pull/65415), [dotnet/aspnetcore#66998](https://github.com/dotnet/aspnetcore/pull/66998)","reactions":{"url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/dotnet/AspNetCore.Docs/issues/37706/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282","repository_url":"https://api.github.com/repos/OAI/tools.openapis.org","labels_url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282/labels{/name}","comments_url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282/comments","events_url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282/events","html_url":"https://github.com/OAI/tools.openapis.org/issues/282","id":5122472095,"node_id":"I_kwDOGrU1l88AAAABMVK4nw","number":282,"title":"Add OpenAPI Breaking Change Checker","user":{"login":"MartinGryner","id":934713,"node_id":"MDQ6VXNlcjkzNDcxMw==","avatar_url":"https://avatars.githubusercontent.com/u/934713?v=4","gravatar_id":"","url":"https://api.github.com/users/MartinGryner","html_url":"https://github.com/MartinGryner","followers_url":"https://api.github.com/users/MartinGryner/followers","following_url":"https://api.github.com/users/MartinGryner/following{/other_user}","gists_url":"https://api.github.com/users/MartinGryner/gists{/gist_id}","starred_url":"https://api.github.com/users/MartinGryner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MartinGryner/subscriptions","organizations_url":"https://api.github.com/users/MartinGryner/orgs","repos_url":"https://api.github.com/users/MartinGryner/repos","events_url":"https://api.github.com/users/MartinGryner/events{/privacy}","received_events_url":"https://api.github.com/users/MartinGryner/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-08-11T16:43:35Z","updated_at":"2026-08-11T16:43:35Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"> **This tool is not hosted in a public GitHub repository.**\n\n## Tool Properties\n\n- Display name: OpenAPI Breaking Change Checker\n- Description: Free browser tool that compares Swagger 2.0 and OpenAPI 3.0/3.1 JSON or YAML descriptions locally and reports likely client-breaking, review-needed, and compatible changes. Internal JSON Pointer references are resolved; external references are reported but not fetched.\n- Repository: Not open source; no public repository.\n- Homepage: https://martingruner.com/tools/openapi-breaking-change-checker\n\n## OpenAPI Versions\n\n- 3.1: true\n- 3.0: true\n- 2.0: true","reactions":{"url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/OAI/tools.openapis.org/issues/282/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0}],"search_type":"lexical"}