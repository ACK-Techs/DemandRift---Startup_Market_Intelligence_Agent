 \u00c7erezler","info":{"value":"","format":"not_html"},"uri":"","needConsent":true}],"weight":3},"reklam_pazarlama_cerezler":{"id":"reklam_pazarlama_cerezler","services":[{"key":"reklam_pazarlama_cerezler","type":"reklam_pazarlama_cerezler","name":"Reklam\/Pazarlama \u00c7erezler","info":{"value":"","format":"not_html"},"uri":"","needConsent":true}],"weight":4}},"translation":{"_core":{"default_config_hash":"PpB_t3-mnEd5Lckhxc9rfquSMa0CndPslGvJZlcg61E"},"langcode":"tr","bannerText":"Sitemizden en iyi \u015fekilde faydalanabilmeniz i\u00e7in, ama\u00e7larla s\u0131n\u0131rl\u0131 ve gizlili\u011fe uygun \u015fekilde \u00e7erez konumland\u0131rmaktay\u0131z. \u00c7erezleri nas\u0131l kulland\u0131\u011f\u0131m\u0131z\u0131 incelemek ve \u00e7erezleri nas\u0131l kontrol edebilece\u011finizi \u00f6\u011frenmek i\u00e7in \u00c7erez Politikas\u0131n\u0131 inceleyebilirsiniz. ","privacyPolicy":"Gizlilik Politikas\u0131","privacyUri":"","imprint":"Imprint","imprintUri":"","cookieDocs":"Detayl\u0131 Bilgi","cookieDocsUri":"\/node\/13661","officialWebsite":"Resmi web sitesi","denyAll":"T\u00fcm\u00fcn\u00fc reddet","alwaysActive":"Her zaman aktif","settings":"\u00c7erez ayarlar\u0131","acceptAll":"T\u00fcm\u00fcn\u00fc kabul et","requiredCookies":"Gerekli \u00e7erezler","cookieSettings":"\u00c7erez ayarlar\u0131","close":"Kapat","readMore":"Devam\u0131n\u0131 oku","allowed":"Allowed","denied":"Reddet","settingsAllServices":"T\u00fcm hizmetler i\u00e7in ayarlar","saveSettings":"Kaydet","default_langcode":"en","disclaimerText":"All cookie information is subject to change by the service providers. We update this information regularly.","disclaimerTextPosition":"above","processorDetailsLabel":"Processor Company Details","processorLabel":"Company","processorWebsiteUrlLabel":"Company Website","processorPrivacyPolicyUrlLabel":"Company Privacy Policy","processorCookiePolicyUrlLabel":"Company Cookie Policy","processorContactLabel":"Data Protection Contact Details","placeholderAcceptAllText":"T\u00fcm \u00c7erezleri Kabul Et","zorunlu_cerezler":{"title":"Zorunlu \u00c7erezler","details":"Bu \u00e7erezler internet sitemizin \u00e7al\u0131\u015fmas\u0131 amac\u0131yla gerekli olan \u00e7erezlerdir. S\u00f6z konusu \u00e7erezler birinci taraf \u00e7erezler olup oturum s\u00fcresince ki\u015fisel veri i\u015flemekte, oturum sonland\u0131\u011f\u0131nda otomatikman silinmektedirler. S\u00f6z konusu \u00e7erezler talep etmi\u015f oldu\u011funuz bir bilgi toplumu hizmetinin (log-in olma, form doldurma ve gizlilik tercihlerinin hat\u0131rlanmas\u0131) yerine getirilebilmesi i\u00e7in zorunlu olarak kullan\u0131lmaktad\u0131rlar. "},"islevsel_cerezler":{"title":"\u0130\u015flevsel \u00c7erezler","details":"Web sitesi veya uygulamalarda (masa\u00fcst\u00fc, mobil veya IOT cihazlardaki uygulamalar da d\u00e2hil olmak \u00fczere) kullan\u0131lan ki\u015fiselle\u015ftirme ve tercihlerin hat\u0131rlanmas\u0131 ama\u00e7lar\u0131 ile kullan\u0131lan \u00e7erezlerdir. Bu \u00e7erezler zorunlu \u00e7erezler d\u0131\u015f\u0131nda kalan i\u015flevsellikleri sa\u011flama amac\u0131yla kullan\u0131lmaktad\u0131r."},"performans_analitik_cerezler":{"title":"Performans\/Analitik \u00c7erezler","details":"Bu \u00e7erezler, internet sitelerinde kullan\u0131c\u0131lar\u0131n davran\u0131\u015flar\u0131n\u0131 analiz etmek amac\u0131yla istatistiki \u00f6l\u00e7\u00fcm\u00fcne imk\u00e2n veren \u00e7erezlerdir. Bu \u00e7erezler sayesinde sitemizde ki kullan\u0131m\u0131n\u0131z\u0131 ve sitemizin performans\u0131n\u0131 analiz ederek sizlere verdi\u011fimiz hizmetleri daha iyi hale getirebiliyor ve sitemizin i\u015flevsellik kapsam\u0131nda daha da geli\u015ftirebiliyoruz. "},"reklam_pazarlama_cerezler":{"title":"Reklam\/Pazarlama \u00c7erezler","details":"Bu \u00e7erezler ile internet ortam\u0131nda kullan\u0131c\u0131lar\u0131n \u00e7evrim i\u00e7i hareketleri takip edilerek ki\u015fisel ilgi alanlar\u0131n\u0131n saptan\u0131p bu ilgi alanlar\u0131na y\u00f6nelik internet ortam\u0131nda kullan\u0131c\u0131lara reklam g\u00f6sterilmesi hedeflenmektedirler."}}},"cookiesTexts":{"_core":{"default_config_hash":"PpB_t3-mnEd5Lckhxc9rfquSMa0CndPslGvJZlcg61E"},"langcode":"tr","bannerText":"Sitemizden en iyi \u015fekilde faydalanabilmeniz i\u00e7in, ama\u00e7larla s\u0131n\u0131rl\u0131 ve gizlili\u011fe uygun \u015fekilde \u00e7erez konumland\u0131rmaktay\u0131z. \u00c7erezleri nas\u0131l kulland\u0131\u011f\u0131m\u0131z\u0131 incelemek ve \u00e7erezleri nas\u0131l kontrol edebilece\u011finizi \u00f6\u011frenmek i\u00e7in \u00c7erez Politikas\u0131n\u0131 inceleyebilirsiniz. ","privacyPolicy":"Gizlilik Politikas\u0131","privacyUri":"","imprint":"Imprint","imprintUri":"","cookieDocs":"Detayl\u0131 Bilgi","cookieDocsUri":"\/node\/13661","officialWebsite":"Resmi web sitesi","denyAll":"T\u00fcm\u00fcn\u00fc reddet","alwaysActive":"Her zaman aktif","settings":"\u00c7erez ayarlar\u0131","acceptAll":"T\u00fcm\u00fcn\u00fc kabul et","requiredCookies":"Gerekli \u00e7erezler","cookieSettings":"\u00c7erez ayarlar\u0131","close":"Kapat","readMore":"Devam\u0131n\u0131 oku","allowed":"Allowed","denied":"Reddet","settingsAllServices":"T\u00fcm hizmetler i\u00e7in ayarlar","saveSettings":"Kaydet","default_langcode":"en","disclaimerText":"All cookie information is subject to change by the service providers. We update this information regularly.","disclaimerTextPosition":"above","processorDetailsLabel":"Processor Company Details","processorLabel":"Company","processorWebsiteUrlLabel":"Company Website","processorPrivacyPolicyUrlLabel":"Company Privacy Policy","processorCookiePolicyUrlLabel":"Company Cookie Policy","processorContactLabel":"Data Protection Contact Details","placeholderAcceptAllText":"T\u00fcm \u00c7erezleri Kabul Et"},"services":{"zorunlu_cerezler":{"uuid":"73f50a9b-1bfd-41a0-ae7a-8c77952e60f1","langcode":"tr","status":true,"dependencies":[],"id":"zorunlu_cerezler","label":"Zorunlu \u00c7erezler","group":"zorunlu_cerezler","info":{"value":"",