9824ee\"},{\"index\":1,\"groupName\":\" Industries\",\"groupMenuList\":[{\"index\":0,\"subMenuHeading\":\"\",\"subMenuLink\":\"/industries/utilities\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Utilities\",\"slug\":\"industries/utilities\",\"categoryName\":\"\",\"productName\":\"Utilities\",\"image\":[],\"_id\":\"6a5d9f8d47531606e49824f2\",\"groupMenuList\":[]},{\"index\":1,\"subMenuHeading\":\"\",\"subMenuLink\":\"/industries/iot-smart-cities\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"IoT-Smart Cities\",\"slug\":\"industries/iot-smart-cities\",\"categoryName\":\"\",\"productName\":\"IoT-Smart Cities\",\"image\":[],\"_id\":\"6a5d9f8d47531606e49824f3\",\"groupMenuList\":[]}],\"image\":[],\"description\":\"EDX Wireless supports utilities, smart cities, public safety, transportation, and critical communications with advanced RF planning solutions that help organizations design, optimize, and deploy reliable, scalable, and high-performance wireless networks.\",\"path\":\"/industries\",\"menuType\":\"category\",\"slug\":\"industries\",\"_id\":\"6a5d9f8d47531606e49824f1\"},{\"index\":2,\"groupName\":\"Company\",\"groupMenuList\":[{\"index\":0,\"subMenuHeading\":\"About Us\",\"subMenuLink\":\"/company/about-us\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"About us\",\"slug\":\"company/about-us\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"About Us\",\"_id\":\"6a5d9f8d47531606e49824f5\",\"groupMenuList\":[]},{\"index\":1,\"subMenuHeading\":\"Team\",\"subMenuLink\":\"/company/team\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Team\",\"slug\":\"company/team\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"Team\",\"_id\":\"6a5d9f8d47531606e49824f6\",\"groupMenuList\":[]},{\"index\":2,\"subMenuHeading\":\"CEO Message\",\"subMenuLink\":\"/company/ceo-message\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Ceo Message\",\"slug\":\"company/ceo-message\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"CEO Message\",\"_id\":\"6a5d9f8d47531606e49824f7\",\"groupMenuList\":[]},{\"index\":3,\"subMenuHeading\":\"Contact Us\",\"subMenuLink\":\"/company/contact-us\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Contact Us\",\"slug\":\"company/contact-us\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"Contact Us\",\"_id\":\"6a5d9f8d47531606e49824f8\",\"groupMenuList\":[]},{\"index\":4,\"subMenuHeading\":\"Partnerships\",\"subMenuLink\":\"/partnerships\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Partnerships\",\"slug\":\"partnerships\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"Partnerships\",\"_id\":\"6a5d9f8d47531606e49824f9\",\"groupMenuList\":[]},{\"index\":5,\"subMenuHeading\":\"Maintenance\",\"subMenuLink\":\"/maintenance\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Maintenance\",\"slug\":\"maintenance\",\"categoryId\":\"\",\"productId\":\"\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"Maintenance\",\"_id\":\"6a5d9f8d47531606e49824fa\",\"groupMenuList\":[]}],\"image\":[],\"description\":\"Access product briefs, technical documents, blogs, videos, and industry insights that help engineers and organizations stay informed on wireless network planning, optimization, deployment, and evolving communication technologies across multiple industries worldwide.\",\"path\":\"/company\",\"menuType\":\"custom\",\"slug\":\"company\",\"_id\":\"6a5d9f8d47531606e49824f4\"},{\"index\":3,\"groupName\":\"Resources\",\"groupMenuList\":[{\"index\":0,\"subMenuHeading\":\"Document Library\",\"subMenuLink\":\"/document-library\",\"self\":\"1\",\"menuType\":\"pages\",\"pageName\":\"Document library\",\"slug\":\"document-library\",\"categoryName\":\"\",\"productName\":\"\",\"image\":[],\"title\":\"Document Library\",\"_id\":\"6a5d9f8d47531606e49824fc\",\"groupMenuList\":[]},{\"index\":1,\"subMenuHeading\":\"Product Brief\",\"subMenuLink\":\"/product-brief\",\"self\":