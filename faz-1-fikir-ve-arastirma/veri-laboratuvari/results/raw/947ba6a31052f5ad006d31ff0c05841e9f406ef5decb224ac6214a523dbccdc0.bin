ectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"\"},\"restSections\":[{\"_id\":\"69a66e9d3c6f97b5a6e94ea4\",\"sectionName\":\"features\",\"categoryName\":\"\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Power wireless network design with high-quality map data from EDX Wireless, delivering reliable terrain and clutter datasets for accurate network predictions across complex urban and rural environments.\",\"heading\":\"Support wireless network engineering with advanced geospatial datasets from EDX Wireless, enabling RF planning across complex propagation environments and diverse deployment scenarios.\",\"button\":{\"text\":\"Schedule a Demo\",\"url\":\"/\"},\"layoutType\":\"single-video\",\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/media/3940941c-a68d-4f8f-b747-1a8f9878686b.mp4\",\"__v\":0,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"description\":\"\",\"newMedia\":{\"fileKey\":\"sections/media/3940941c-a68d-4f8f-b747-1a8f9878686b.mp4\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/media/3940941c-a68d-4f8f-b747-1a8f9878686b.mp4\"},\"sectionTag\":\"\"},{\"_id\":\"69a66eab3c6f97b5a6e94efc\",\"sectionName\":\"OurSolutions\",\"categoryName\":\"\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Operational Control With Engineering Grade Map Data\",\"heading\":\"Reduce cost, shorten project timelines, and strengthen prediction accuracy using GIS data for telecom integrated directly into your RF planning workflow.\",\"button\":{\"text\":\"View Detailed Modules and Supported Technologies\",\"url\":\"/\"},\"layoutType\":\"card-grid\",\"items\":[{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_23.webp\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/image_23.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_23.webp\"},\"title\":\"Buy Only What You Need\",\"description\":\"\u003cp\u003ePurchase specific service areas instead of entire tiles, aligning data investment directly with project scope and budget constraints.\u003c/p\u003e\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680934\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_17.webp\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/image_17.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_17.webp\"},\"title\":\"Direct In-Platform Downloads\",\"subTitle\":\"\",\"description\":\"\u003cp\u003eDownload US 5m hybrid clutter and 10m terrain datasets directly into active projects without leaving the engineering environment.\u003c/p\u003e\",\"linkText\":\"\",\"linkUrl\":\"\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680935\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_18.webp\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/image_18.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_18.webp\"},\"title\":\"Global Dataset Availability\",\"subTitle\":\"\",\"description\":\"\u003cp\u003eAccess 30m terrain and clutter coverage worldwide to support international studies, feasibility analysis, and RFP submissions.\u003c/p\u003e\",\"linkText\":\"\",\"linkUrl\":\"\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680936\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_20.webp\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/image_20.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_20.webp\"},\"title\":\"Project-Based Licensing\",\"subTitle\":\"\",\"description\":\"\u003cp\u003eUse data on a project-by-project basis to support short-term engagements and competitive bid timelines.\u003c/p\u003e\",\"linkText\":\"\",\"linkUrl\":\"\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680937\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/group_1171277462.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/group_1171277462.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/group_1171277462.png\"},\"title\":\"Automatic Dataset Updates\",\"subTitle\":\"\",\"description\":\"\u003cp\u003eReceive ongoing updates after subscription, maintaining accurate propagation modeling data across evolving terrain and land use changes.\u003c/p\u003e\",\"linkText\":\"\",\"linkUrl\":\"\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680938\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_21.webp\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/icons/image_21.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/icons/image_21.webp\"},\"title\":\"Eliminate Manual Data Preparation\",\"subTitle\":\"\",\"description\":\"\u003cp\u003eRemove sourcing, formatting, and conversion steps to save engineering time and keep focus on network design accuracy.\u003c/p\u003e\",\"linkText\":\"\",\"linkUrl\":\"\",\"attachments\":[],\"_id\":\"69a195876bf884d44e680939\"}],\"__v\":2,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"benefits\"},{\"_id\":\"69a66eb43c6f97b5a6e94f60\",\"sectionName\":\"addOn\",\"categoryName\":\"Products\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Dedicated Modules for Advanced Network Studies\",\"heading\":\"SignalPro modules deliver focused analysis tools for specific technologies and deployment scenarios.\",\"button\":{\"text\":\"\",\"url\":\"\"},\"layoutType\":\"card-grid\",\"items\":[{\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/0bd62d1a-b968-4629-a1be-82cdc11485bd.jpeg\",\"title\":\"5G\",\"subTitle\":\"\",\"description\":\"5G NR propagation and performance analysis\",\"linkText\":\"\",\"linkUrl\":\"\",\"_id\":\"69a1964f6bf884d44e680944\",\"newMedia\":{\"fileKey\":\"sections/gallery/0bd62d1a-b968-4629-a1be-82cdc11485bd.jpeg\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/0bd62d1a-b968-4629-a1be-82cdc11485bd.jpeg\"}},{\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/47adcdd8-d4b1-479d-8c44-c88db915499b.jpeg\",\"title\":\"Mesh\",\"subTitle\":\"\",\"description\":\"Mesh and point-to-multipoint network studies\",\"linkText\":\"\",\"linkUrl\":\"\",\"_id\":\"69a1964f6bf884d44e680945\",\"newMedia\":{\"fileKey\":\"sections/gallery/47adcdd8-d4b1-479d-8c44-c88db915499b.jpeg\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/47adcdd8-d4b1-479d-8c44-c88db915499b.jpeg\"}},{\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/4df3e751-e683-4dac-9675-3380c964cd3b.jpeg\",\"title\":\"LTE-PRO\",\"subTitle\":\"\",\"description\":\"LTE coverage, CQI, and capacity analysis\",\"linkText\":\"\",\"linkUrl\":\"\",\"_id\":\"69a1964f6bf884d44e680946\",\"newMedia\":{\"fileKey\":\"sections/gallery/4df3e751-e683-4dac-9675-3380c964cd3b.jpeg\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/4df3e751-e683-4dac-9675-3380c964cd3b.jpeg\"}},{\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/2f32e10d-8179-4724-9252-fd65b69fc199.jpeg\",\"title\":\"In-Building\",\"subTitle\":\"\",\"description\":\"Indoor RF modelling and DAS planning\",\"linkText\":\"\",\"linkUrl\":\"\",\"_id\":\"69a1964f6bf884d44e680947\",\"newMedia\":{\"fileKey\":\"sections/gallery/2f32e10d-8179-4724-9252-fd65b69fc199.jpeg\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/2f32e10d-8179-4724-9252-fd65b69fc199.jpeg\"}},{\"media\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/140d655d-e617-4543-9c48-49aa92fca905.jpeg\",\"title\":\"LoRa/IoT\",\"subTitle\":\"\",\"description\":\"LPWAN coverage and link budget analysis\",\"linkText\":\"\",\"linkUrl\":\"\",\"_id\":\"69a1964f6bf884d44e680948\",\"newMedia\":{\"fileKey\":\"sections/gallery/140d655d-e617-4543-9c48-49aa92fca905.jpeg\",\"s3Bucket\":\"smart-cms-images\",\"url\":\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/gallery/140d655d-e617-4543-9c48-49aa92fca905.jpeg\"}}],\"__v\":2,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"ADD-ON FUNCTIONALITY\"},{\"_id\":\"69a66ec13c6f97b5a6e94fc8\",\"sectionName\":\"featureCards\",\"categoryName\":\"\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Comprehensive RF Mapping Layers\",\"heading\":\"Structured datasets engineered to support precise wireless network design, validation, and deployment modeling across technologies and geographies.\",\"button\":{\"text\":\"\",\"url\":\"\"},\"layoutType\":\"card-grid\",\"items\":[{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/high-resolution.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/high-resolution.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/high-resolution.png\"},\"title\":\"High Resolution\",\"subTitle\":\"US 5m hybrid clutter and 10m terrain datasets support refined propagation modeling and improved prediction reliability.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e5m hybrid clutter provides detailed land use classification for improved building and vegetation loss modeling.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e10m terrain resolution strengthens path profiling, diffraction calculations, and line of sight validation.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImproves signal level prediction accuracy across dense urban cores and irregular topography.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e680957\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/5.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/5.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/5.png\"},\"title\":\"Flexible Licensing\",\"subTitle\":\"Data acquisition aligned directly with the engineering scope and budget control.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003ePurchase specific service areas instead of committing to full geographic tiles.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProject-based licensing supports feasibility studies, RFP responses, and short timeline deployments.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScale subscriptions as network footprints expand without overcommitting capital.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e680958\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/4.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/4.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/4.png\"},\"title\":\"Seamless Integration\",\"subTitle\":\"Download and activate datasets directly within active RF studies.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003eNo external sourcing, reformatting, or manual file conversion required before modeling.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eApply geographic boundaries to control which terrain and clutter datasets are active.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContinue network design tasks while datasets are downloaded in the background.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMaintain study grid consistency during updates and dataset activation.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e680959\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/3.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/3.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/3.png\"},\"title\":\"Global\",\"subTitle\":\"Worldwide terrain and clutter coverage support international planning requirements.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e30m terrain and clutter datasets available for global deployments.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConsistent dataset structure across domestic and international regions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupports broadband expansion, utility smart grid systems, and public safety networks.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnables standardized modeling processes across multi-country engineering teams.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e68095a\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/7.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/7.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/7.png\"},\"title\":\"Data Control\",\"subTitle\":\"Manage how terrain and clutter layers are applied inside projects.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003eDefine geographic boundaries to precisely control dataset selection.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eActivate only the required terrain and clutter files to maintain performance.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePrevent unnecessary data loading that increases processing time.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e68095b\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/6.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/map_data/6.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/map_data/6.png\"},\"title\":\"Engineered For RF Planning Workflows\",\"subTitle\":\"Built to support structured modeling and long-term engineering accuracy.\",\"description\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003eCompatible with established propagation engines and study configurations.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDirectory-based dataset management aligned with existing database structures.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutomatic updates after subscription to maintain current terrain and clutter references.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePreserves modeling consistency across ongoing design, optimization, and expansion projects.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"linkText\":\"Schedule a Demo\",\"linkUrl\":\"/\",\"attachments\":[],\"_id\":\"69a197de6bf884d44e68095c\"}],\"__v\":5,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"FEATURE CHAPTERS\"},{\"_id\":\"69a66ecb3c6f97b5a6e95037\",\"sectionName\":\"cases\",\"categoryName\":\"\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Proven Deployment Applications\",\"heading\":\"Map data supports engineering teams across commercial, public, and utility networks where prediction accuracy and cost control directly impact deployment success.\",\"button\":{\"text\":\"\",\"url\":\"\"},\"layoutType\":\"card-grid\",\"items\":[{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/wi-fi-by-edx-wireless.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/case_studies/wi-fi-by-edx-wireless.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/wi-fi-by-edx-wireless.png\"},\"title\":\"Wi-Fi by EDX Wireless\",\"subTitle\":\"Advanced Wi-Fi Network Planning Software\",\"description\":\"Wi-Fi, built on the robust SignalPro platform by EDX Wireless, is the ideal tool for planning, designing,  and optimizing Wi-Fi networks, including Wi-Fi 6 and Wi-Fi 7. It supports the latest 802.11 standards  and provides advanced capabilities to address the challenges of real-world RF environments. Designed  for network operators, consultants, and IT professionals, Wi-Fi delivers the accuracy needed for robust,  high-performance wireless networks across various settings.\",\"linkText\":\"\",\"linkUrl\":\"/product-brief\",\"attachments\":[],\"_id\":\"69a198936bf884d44e680972\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/edx-wireless-mesh-solution.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/case_studies/edx-wireless-mesh-solution.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/edx-wireless-mesh-solution.png\"},\"title\":\"EDX Wireless MESH Solution\",\"subTitle\":\"Product Solution Document\",\"description\":\"The EDX Wireless MESH Solution is designed to deliver scalable, flexible, and resilient wireless  communication networks that meet the complex needs of diverse industries. From utilities deploying  Advanced Metering Infrastructure (AMI) to smart cities, industrial IoT, and last-mile broadband, the EDX  MESH Solution supports reliable connectivity across large, complex environments.\",\"linkText\":\"\",\"linkUrl\":\"/product-brief\",\"attachments\":[],\"_id\":\"69a198936bf884d44e680973\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/lte-network-planning.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/case_studies/lte-network-planning.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/lte-network-planning.png\"},\"title\":\"LTE by EDX Wireless\",\"subTitle\":\"Elevate Your LTE Network Planning\",\"description\":\"LTE by EDX Wireless is a comprehensive software solution for designing, planning, and optimizing LTE  networks. Fully compliant with all 3GPP standards for LTE, it ensures that mobile operators, utilities,  enterprises, and engineering consultants have the precise tools needed to meet the demands of modern  wireless networks. LTE by EDX Wireless delivers robust coverage, high-speed data, and exceptional  network performance.\",\"linkText\":\"\",\"linkUrl\":\"/product-brief\",\"attachments\":[],\"_id\":\"69a198936bf884d44e680974\"},{\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/cbrs.png\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/case_studies/cbrs.png\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/case_studies/cbrs.png\"},\"title\":\"CBRS by EDX Wireless\",\"subTitle\":\"Comprehensive Network Planning for CBRS Deployments\",\"description\":\"CBRS, powered by the industry-leading SignalPro platform from EDX Wireless, is the ultimate tool  for planning, designing, and optimizing networks using the Citizens Broadband Radio Service (CBRS)  spectrum. Supporting a range of applications—from private LTE and 5G to fixed broadband and industrial  automation—CBRS equips network operators, consultants, and enterprises with advanced capabilities  to navigate the unique challenges of CBRS deployments, ensuring reliable, high-performance coverage  across real-world environments. Additionally, CBRS supports compliance with the latest Broadband Data  Collection (BDC) filing requirements mandated by the FCC.\",\"linkText\":\"\",\"linkUrl\":\"/product-brief\",\"attachments\":[],\"_id\":\"69a198936bf884d44e680975\"}],\"__v\":3,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"cases\"},{\"_id\":\"69a66edc3c6f97b5a6e9503e\",\"sectionName\":\"semiBanner\",\"categoryName\":\"\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\" \",\"heading\":\"Map Data Technical Brief\",\"subHeading\":\"Review detailed specifications covering dataset resolution, terrain and clutter formats, service area purchasing, Map Sync operation, geographic boundary controls, and update mechanisms. The brief provides the technical depth required for engineering validation, procurement review, compliance assessment, and internal approval across wireless, utility, and public safety network programs.\",\"button\":{\"text\":\"Request For Map Data Brief\",\"url\":\"/\"},\"layoutType\":\"single-image\",\"media\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/image_15.webp\",\"__v\":0,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"newMedia\":{\"fileKey\":\"media/sumit_royfdfdd(699e)/edx(699e)/sites/image_15.webp\",\"s3Bucket\":\"foxsuite\",\"url\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/image_15.webp\"},\"sectionTag\":\"\"},{\"_id\":\"69a670d23c6f97b5a6e95079\",\"sectionName\":\"FAQ\",\"categoryName\":\"Products\",\"productName\":\"Map Data\",\"extraFields\":[],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Map Data: FAQs\",\"heading\":\"Technical and operational considerations that engineers raise before committing to new mapping datasets.\",\"button\":{\"text\":\"\",\"url\":\"\"},\"layoutType\":\"key-value\",\"items\":[{\"key\":\"1. How does US resolution compare to international coverage options?\",\"value\":\"US coverage includes 5m hybrid clutter and 10m terrain datasets designed for detailed urban and suburban propagation studies. Outside the US, 30m terrain and clutter datasets are available globally. This structure supports high-precision domestic deployments while enabling immediate access for international feasibility assessments and RFP driven planning.\",\"_id\":\"69a52b9f15d02de3f7c10b96\"},{\"key\":\"2. Can data be purchased only for defined service areas?\",\"value\":\"Yes. Data can be acquired for specific service areas rather than entire geographic tiles. This allows teams to align dataset investment with project scope, control OPEX, and support short-term studies or competitive bid responses without committing to unnecessary coverage.\",\"_id\":\"69a52b9f15d02de3f7c10b97\"},{\"key\":\"3. Is external sourcing or file conversion required before use?\",\"value\":\"No. Map Sync allows engineers to select service areas and download terrain and clutter datasets directly within the planning environment. There is no requirement to manually source, reformat, or convert files before using them in active RF studies.\",\"_id\":\"69a52b9f15d02de3f7c10b98\"},{\"key\":\"4. How are terrain and clutter files managed within a project?\",\"value\":\"Engineers can define geographic boundaries inside the study grid to control which terrain and clutter files are used. Activating only relevant datasets reduces processing overhead and maintains performance during coverage, interference, and capacity analysis.\",\"_id\":\"69a52b9f15d02de3f7c10b99\"},{\"key\":\"5. Are dataset updates handled manually after subscription?\",\"value\":\"Once subscribed, users receive automatic dataset updates. This ensures ongoing projects continue using current terrain and land use references, helping maintain the integrity of propagation modeling data as environmental conditions evolve.\",\"_id\":\"69a52b9f15d02de3f7c10b9a\"},{\"key\":\"6. Can engineers continue working while the datasets download?\",\"value\":\"Yes. After initiating downloads through Map Sync, engineers can continue modeling and analysis tasks while terrain and clutter datasets transfer in the background. Once complete, the data becomes available for both new and existing projects without interrupting workflow.\",\"_id\":\"69a52b9f15d02de3f7c10b9b\"}],\"__v\":1,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\"},{\"_id\":\"69a670e43c6f97b5a6e95082\",\"sectionName\":\"askAQuestion\",\"categoryName\":\"Products\",\"productName\":\"Map Data\",\"extraFields\":[{\"name\":\"Image\",\"type\":\"images\",\"value\":{\"list\":[\"https://smart-cms-images.s3.us-east-1.amazonaws.com/sections/extra-fields/e3173744-d405-47cd-9e26-b84455f21829.jpeg\"]}}],\"customerId\":\"699edaf8b86bd1dc5bd646dd\",\"title\":\"Ask a question\",\"heading\":\"Talk to one of our experts to answer your questions and get a demo of  Ativa Net with no strings attached. Submit your contact details and we will get back to you shortly.\",\"subHeading\":\"We’re looking forward to connecting!\",\"button\":{\"text\":\"\",\"url\":\"\"},\"layoutType\":\"forms\",\"formIds\":[\"69a130cdd5d3212b71163210\"],\"__v\":1,\"isHidden\":false,\"projectId\":\"699edb75281d0813dec9f097\",\"sectionTag\":\"KEY BENEFITS\"}]}]\n"])</script><script>self.__next_f.push([1,"f:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/4dd57ee4807393a6.js\"],\"IconMark\"]\n8:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Wireless Network Planning and RF Map Data Solutions\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Access high-resolution map data for wireless network planning, RF planning software, and digital terrain models to optimize telecom network design.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Map Data\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://www.edx.com/products/map-data\"}],[\"$\",\"link\",\"4\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.8e8dcc3a.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"5\",{\"rel\":\"icon\",\"href\":\"https://cdn.foxsuite.ai/media/sumit_royfdfdd%28699e%29/edx%28699e%29/sites/theme/favicon_01.ico\"}],[\"$\",\"$Lf\",\"6\",{}]]\n"])</script><script>self.__next_f.push([1,"11:I[51999,[\"/_next/static/chunks/3a15def42a6fab4a.js\",\"/_next/static/chunks/04daeaef2b9f9a01.js\",\"/_next/static/chunks/430e776ab24d634c.js\",\"/_next/static/chunks/b6c15fa55f15cc5c.js\",\"/_next/static/chunks/390cd88f68eb28de.js\"],\"default\"]\n12:I[34474,[\"/_next/static/chunks/3a15def42a6fab4a.js\",\"/_next/static/chunks/04daeaef2b9f9a01.js\",\"/_next/static/chunks/430e776ab24d634c.js\",\"/_next/static/chunks/b6c15fa55f15cc5c.js\",\"/_next/static/chunks/390cd88f68eb28de.js\"],\"SiteChromeProvider\"]\n13:I[45234,[\"/_next/static/chunks/3a15def42a6fab4a.js\",\"/_next/static/chunks/04daeaef2b9f9a01.js\",\"/_next/static/chunks/430e776ab24d634c.js\",\"/_next/static/chunks/b6c15fa55f15cc5c.js\",\"/_next/static/chunks/390cd88f68eb28de.js\"],\"default\"]\n"])</script><script>self.__next_f.push