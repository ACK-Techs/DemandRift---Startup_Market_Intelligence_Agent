\"topics.ANGLE_LATEST_DEVELOPMENT\":\"Latest development\",\"topics.ANGLE_BACKGROUND\":\"Background\",\"topics.ANGLE_ANALYSIS_OPINION\":\"Analysis \u0026 opinion\",\"topics.ANGLE_REACTION\":\"Reaction\",\"topics.ANGLE_LIVE_COVERAGE\":\"Live coverage\",\"topics.ANGLE_PROFILE\":\"Profile\",\"topics.ANGLE_REVIEW\":\"Review\",\"topics.ANGLE_PHOTOS_VIDEO\":\"Photos \u0026 video\",\"topics.ANGLE_OTHER_ARTICLES\":\"Other articles\",\"topics.SUMMARIZED_FROM_N_SOURCES\":\"Covered by {count} {count, plural, one {source} other {sources}}\",\"topics.COVERED_BY_MULTIPLE_SOURCES\":\"Covered by multiple sources\",\"topics.TOPIC_RANK_A11Y\":\"Rank\",\"topics.TOPIC_STATUS_GAINING_ATTENTION\":\"Gaining attention\",\"topics.TOPIC_STATUS_NEW\":\"New\",\"topics.TOPIC_STATUS_RECENT_HOURS\":\"{hours} hrs\",\"topics.TOPIC_STATUS_MOST_VIEWS\":\"Most views\",\"topics.TOPIC_STATUS_DAYS_ON_LIST\":\"{days} days on list\",\"topics.TOPIC_STATUS_MOST_COMMENTED\":\"Top commented\",\"topics.TOPIC_STATUS_MOST_SHARED\":\"Most shared\",\"topics.TOPIC_STATUS_TRENDING_ON_INSTAGRAM\":\"Trending on Instagram\",\"topics.TOPIC_STATUS_TRENDING_ON_TIKTOK\":\"Trending on TikTok\",\"topics.TOPIC_STATUS_TRENDING_ON_YOUTUBE\":\"Trending on YouTube\",\"topics.TOPIC_STATUS_TRENDING_UP\":\"Trending up\",\"topics.TRENDING_ON_YAHOO_100\":\"Trending on Yahoo 100\",\"topics.VIEW_ALL_IMAGES\":\"More Photos\",\"topics.VIEW_EDITORS_NOTE\":\"View Editor's note\",\"topics.Y100_ALSO_TRENDING\":\"Also trending\",\"topics.Y100_THE_TOP_10\":\"The top 10\",\"topics.AI_SUMMARY_LATEST_UPDATES\":\"Latest updates\",\"topics.ALL_ENTITIES\":\"All Topics\",\"topics.ALL_ENTITIES_META_DESCRIPTION\":\"Browse all topics by category on Yahoo News.\",\"topics.ALL_ENTITIES_SUBTITLE\":\"Browse all topics by category\",\"topics.ENTITY_TYPE_BACK_LINK\":\"All Topics\",\"topics.EMPTY_CATEGORY_SUBTITLE\":\"No topics found in this category.\",\"topics.ENTITY_TYPE_DESCRIPTION\":\"Browse all {label} topics on Yahoo News.\",\"topics.ENTITY_TYPE_GUIDES\":\"Guides\",\"topics.ENTITY_TYPE_DISASTERS\":\"Disasters\",\"topics.ENTITY_TYPE_EVENTS\":\"Events\",\"topics.ENTITY_TYPE_FILMS\":\"Films\",\"topics.ENTITY_TYPE_HOLIDAYS\":\"Holidays\",\"topics.ENTITY_TYPE_ISSUES\":\"Issues\",\"topics.ENTITY_TYPE_ORGANIZATIONS\":\"Organizations\",\"topics.ENTITY_TYPE_PEOPLE\":\"People\",\"topics.ENTITY_TYPE_PLACES\":\"Places\",\"topics.ENTITY_TYPE_SHOWS\":\"Shows\",\"topics.ENTITY_TYPE_TOPICS_COUNT\":\"{count, number} {count, plural, one {topic} other {topics}}\",\"trendingSearches.ALT_FLAME_ICON\":\"flame icon representing popular or new trending item\",\"trendingSearches.CAROUSEL_SLIDE_ARIA_LABEL\":\"Slide {index} of {total}\",\"trendingSearches.NEXT_SLIDE\":\"Next trending search item\",\"trendingSearches.PREV_SLIDE\":\"Previous trending search item\",\"trendingSearches.SHORT_TITLE\":\"Trending\",\"trendingSearches.SUBTITLE\":\"Top news about what people are searching for\",\"trendingSearches.TITLE\":\"Trending Searches\",\"trendingSearches.UPDATED_MINS\":\"{minutes} min ago\",\"trending_topics.YAHOO_100_TITLE\":\"Yahoo 100\",\"trending_topics.YAHOO_100_SUBTITLE\":\"A real-time snapshot of what the internet is talking about.\",\"trending_topics.AI_SUBHEADING\":\"Powered by \",\"trending_topics.YAHOO_SCOUT\":\"Yahoo Scout\",\"trending_topics.AI_LEGAL_HOVER_TEXT\":\"Yahoo uses AI to summarize trending stories. Mistakes are possible.\",\"trending_topics.TOC_TITLE\":\"Trending stories\",\"trending_topics.UI_TOGGLE_SIMPLE\":\"Compact\",\"trending_topics.UI_TOGGLE_DETAILED\":\"Detailed\",\"trending_topics.METHODOLOGY_SECTION_TITLE\":\"Methodology\",\"trending_topics.METHODOLOGY_SECTION_BODY\":\"The stories that make up the Yahoo 100 ranking come from two different places. Some are drawn from the thousands of articles that are published across Yahoo each day, while others are based on social videos trending across Instagram, TikTok and Facebook. The stories are enhanced by the perspectives, judgements, and human personalities of the writers and editors of the Yahoo newsroom.\",\"trending_topics.METHODOLOGY_SECTION_ARTICLE_LINK_TEXT\":\"To rank the storylines, we combine internal Yahoo data on article traffic and search trends with \\\"lift\\\" metrics from social media. Then we use a large language model to help write the descriptions that help you make sense of it all.\",\"trending_topics.MILESTONE_RANKING_TEXT\":\"#{rank} trending story\",\"trending_topics.GOING_VIRAL\":\"Racking up views\",\"trending_topics.BIGGEST_JUMP\":\"Biggest jump\",\"trending_topics.FUN_STUFF\":\"Mood booster\",\"trending_topics.TOP_COMMENTED\":\"Driving conversation\",\"trending_topics.YAHOO_100_GREEN_SIGN\":\"Powered by Yahoo Scout\",\"trending_topics.YAHOO_100_YELLOW_SIGN\":\"Polished by people\",\"trending_topics.YAHOO_100_PURPLE_SIGN\":\"Don't miss\",\"trending_topics.ALL_STORIES\":\"All stories\",\"trending_topics.LEFT_RAIL_ABOUT_BODY\":\"The Yahoo 100 is powered by \u003cscoutLink\u003eYahoo Scout\u003c/scoutLink\u003e, which uses AI to identify emerging stories and generate summaries. Learn more about how stories are ranked in \u003cmethodologyLink\u003eour methodology\u003c/methodologyLink\u003e.\",\"trending_topics.LEFT_RAIL_AI_DISCLAIMER\":\"AI can make mistakes and info may not always match what’s in the article.\",\"trending_topics.PUSH_ALERT_TITLE\":\"Never miss the day's top trend.\",\"trending_topics.PUSH_ALERT_DESCRIPTION\":\"One daily desktop alert with the top trending story.\",\"trending_topics.PUSH_ALERT_CTA\":\"Turn on alerts\",\"trending_topics.PUSH_ALERT_NEWSLETTER_TITLE\":\"Rise and shine with The Yodel.\",\"trending_topics.PUSH_ALERT_NEWSLETTER_DESCRIPTION\":\"News, delightful stories and a hit of nostalgia.\",\"trending_topics.PUSH_ALERT_NEWSLETTER_CTA\":\"Sign up\",\"trending_topics.PUSH_ALERT_DISMISS\":\"Dismiss\",\"trending_topics.PUSH_ALERT_PILL\":\"Alerts on\",\"trending_topics.PUSH_ALERT_MANAGE\":\"Manage\",\"trending_topics.PUSH_ALERT_MANAGE_TITLE\":\"Daily alert is on.\",\"trending_topics.PUSH_ALERT_MANAGE_DESCRIPTION\":\"The #1 trending story on Yahoo 100, every morning.\",\"trending_topics.PUSH_ALERT_TURN_OFF\":\"Turn off alerts\",\"trending_topics.PUSH_ALERT_CONFIRM_NEW\":\"You're all set! Your first alert arrives tomorrow morning.\",\"trending_topics.PUSH_ALERT_CONFIRM_EXISTING\":\"Yahoo 100 alerts added — you're already set up for Yahoo notifications.\",\"trending_topics.PUSH_ALERT_CONFIRM_OFF\":\"Yahoo 100 alerts turned off.\",\"uvRadar.ADVICE_0\":\"There's zero to minimal ultraviolet radiation. It may be night, winter or very cloudy. Feel free to step outside sans sun protection.\",\"uvRadar.ADVICE_1\":\"You can safely spend time outside without sun protection. However, wearing sunscreen daily is recommended. Grab some SPF 15+ and go!\",\"uvRadar.ADVICE_2\":\"Low UV, low risk. SPF 15+ will suffice. But be careful: Reflective surfaces like snow, sand and water can increase exposure.\",\"uvRadar.ADVICE_3\":\"When the UV hits 3, proceed with caution. Hat? Check. Sunglasses? Check. SPF 30+ sunscreen? Check. In midday, seek shade for bonus points.\",\"uvRadar.ADVICE_4\":\"Your sunburn risk is moderate. Grab polarized sunglasses, slather on SPF 30+ and wear a wide-brimmed hat and protective clothing.\",\"uvRadar.ADVICE_5\":\"The forecast is sunny with a side of caution. Seek shade between 10 a.m. and 4 p.m. and reapply SPF 30+ when outside.\",\"uvRadar.ADVICE_6\":\"Sun protection is vital. Fair-skinned people may burn in 20 minutes or less. Apply SPF 30+, seek shade and don't forget to hydrate.\",\"uvRadar.ADVICE_7\":\"Sun protection is key: hat, shades and long sleeves. When applying SPF 30+, don't skip your ears, eyelids, lips, scalp and feet.\",\"uvRadar.ADVICE_8\":\"We're in risky UV territory. Wear SPF 30+, sunnies, hat and loose-fitting long-sleeved shirts and pants. Stay inside if possible.\",\"uvRadar.ADVICE_9\":\"Sun safety is the name of the game. Avoid the outdoors midday as the shade can't fully protect you and cover up your skin.\",\"uvRadar.ADVICE_10\":\"In the high-risk UV zone, use the shadow rule: If it's shorter than you, head indoors or seek shade and always use maximum sun protection.\",\"uvRadar.ADVICE_11\":\"It's best to stay indoors, but max sun protection is a must if you're going out. Fair skin can burn in 5 minutes or less.\",\"uvRadar.TITLE\":\"UV Index\",\"verticalVideo.TITLE\":\"Videos from Yahoo News\",\"verticalVideo.WATCH_VIDEO\":\"{title} - Watch video\",\"weather.CANCEL\":\"Cancel\",\"weather.REAL_FEEL\":\"RealFeel® {real_feel_temp}°, {condition}\",\"weather.REAL_FEEL_SHORT\":\"RealFeel\",\"weather.REAL_FEEL_EXPANDED_CARD\":\"RealFeel® {real_feel_temp}°\",\"weather.FULL_FORECAST\":\"View full forecast\",\"weather.LOCATION_PLACEHOLDER\":\"Enter City or Zipcode\",\"weather.LOCATION_INPUT_PLACEHOLDER_TEXT\":\"Search city or zip code\",\"weather.LOCATION_AUTO_DETECT\":\"Detect my location\",\"weather.LOCATION_PICKER_CLOSE\":\"Cancel\",\"weather.NO_PLACES_FOUND\":\"No places found\",\"weather.POWERED_BY_ACCUWEATHER\":\"Powered by AccuWeather\",\"weather.SET_LOCATION\":\"Set location\",\"weather.SET_NEW_LOCATION\":\"Set a new location\",\"weather.TEMPERATURE_DEGREES\":\"{temperature}°\",\"weather.UPDATE_AUTOMATICALLY\":\"Update automatically\",\"weather.WEATHER_TITLE\":\"Weather\",\"weather.WEATHER_TODAY\":\"Today\",\"weather.WEATHER_TOMORROW\":\"Tomorrow\",\"weather.NO_DATA_ERROR\":\"Looks like the weather in your area isn’t available. Check back later\",\"weather.MOBILE_HIGH_TEMPERATURE_INDICATOR\":\"H\",\"weather.MOBILE_LOW_TEMPERATURE_INDICATOR\":\"L\",\"weather.SEE_WEATHER_FORECAST\":\"See forecast\",\"what_to_watch.ARIA_IMDB\":\"IMDB rating\",\"what_to_watch.ARIA_RTAUDIENCE\":\"Rotten Tomatoes audience score\",\"what_to_watch.ARIA_RTCRITIC\":\"Rotten Tomatoes critic score\",\"what_to_watch.EDITORS_PICKS\":\"Editors' pick\",\"what_to_watch.VIEW_FULL_DETAILS\":\"View full details\",\"what_to_watch.READ_MORE\":\"Read More\",\"what_to_watch.WHAT_TO_WATCH\":\"What to Watch\",\"wha