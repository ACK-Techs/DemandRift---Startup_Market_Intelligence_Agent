adges\":[{\"id\":\"US\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"de5f70cc-1816-3563-98ca-cefb8b19b4d3-1790498359455\",\"categoryLabel\":\"U.S.\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"de5f70cc-1816-3563-98ca-cefb8b19b4d3\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T07:56:21Z\",\"slides\":null,\"summary\":\"U.S. casualties sustained during the Iran war over the last nearly seven months are published on a publicly-available database.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Secretary of Defense Pete Hegseth testifies during a Senate Armed Services Committee hearing on the proposed 2027 fiscal year budget for the Department of Defense in the Dirksen Senate Office Building on April 30, 2026 in Washington, D.C.\",\"originalHeight\":800,\"originalUrl\":\"https://media.zenfs.com/en/newsweek_sports_200/be14232bef66b82bc2ab76b6d0c24930.jpg\",\"originalWidth\":1200,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/7f06cdf5e8c0b24f166fcb3d451813637a771dd6fd054ae42dbd1a214beed7e0/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fnewsweek_sports_200%2Fbe14232bef66b82bc2ab76b6d0c24930.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/d19213fb247efe8918c7e264d9dbf6e1331972f757531ddd935cde958a91f12d/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fnewsweek_sports_200%2Fbe14232bef66b82bc2ab76b6d0c24930.jpg\",\"width\":260}]},\"title\":\"US Navy explains rise in Iran war casualty numbers\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/news/us/articles/us-navy-explains-rise-iran-075621067.html\",\"viewCount\":0,\"wpm200\":63,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Florida Gators pull off a monumental victory by defeating No. 4 Ole Miss, shaking up the SEC rankings.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"LSU Tigers dominate Texas A\u0026M but slide in the rankings due to Florida's win over Ole Miss impacting their standing.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Texas Longhorns narrowly defeat No. 14 Tennessee to maintain their grip on the No. 1 spot in the AP Top 25 rankings.\"}],\"attribution\":{\"authors\":[\"Ameek Abdullah Jamal\"],\"brandAlias\":\"essentiallysports\",\"brandUuid\":\"d44bc5d7-fe20-34af-90df-89208688133c\",\"image\":{\"altText\":\"EssentiallySports Logo\",\"caption\":\"EssentiallySports Logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/essentiallysports_logo.png_b87f8e0f1eb9e9d01300e3e72f5de50494941f658108871cf51412202c4deb5e.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/9d1b53c49bfe168de4474a7e1510db65c1c5a389a14499fe5ee5466158190ba5/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2Fessentiallysports_logo.png_b87f8e0f1eb9e9d01300e3e72f5de50494941f658108871cf51412202c4deb5e.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"d44bc5d7-fe20-34af-90df-89208688133c\",\"providerSourceId\":\"essentiallysports_articles_591\",\"showBrandPage\":true,\"source\":\"EssentiallySports\",\"brandUrl\":\"https://profiles.yahoo.com/brands/essentiallysports/\",\"description\":\"Essentially Sports is a global sports media platform launched in 2014, focusing on human interest stories and the \\\"moment behind the moment\\\" in sports. It covers various sports, including NBA, UFC, and tennis, targeting underserved fans and niche communities.\"},\"badges\":[{\"id\":\"SPORTS\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"73fa3e39-85bf-3590-b0e3-8bd2a5d30eec-1790498359455\",\"categoryLabel\":\"Sports\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"73fa3e39-85bf-3590-b0e3-8bd2a5d30eec\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T07:53:14Z\",\"slides\":null,\"summary\":\"Week 4 of the college football season brought us some of the wildest games and biggest upsets we’ve seen all year. It featured six ranked matchups, with unranked teams coming ready to play and apparently ending a couple of Blue Bloods’ playoff aspirations, especially in the Big Ten.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"GAINESVILLE, FL – SEPTEMBER 12: Jon Sumrall of the Florida Gators runs out on the field before the game between the Florida Gators and the Campbell Fighting Camels on September 12, 2026 at Steve Spurrier-Florida Field at Ben Hill Griffin Stadium in Gainesville, Fl. Photo by David Rosenblum/Icon Sportswire COLLEGE FOOTBALL: SEP 12 Campbell at Florida EDITORIAL USE ONLY Icon260912261055 ©IMAGO/Icon Sportswire\",\"originalHeight\":1707,\"originalUrl\":\"https://media.zenfs.com/en/essentiallysports_articles_591/c9b872af3b21b9037e37ee0f0ee17910.jpg\",\"originalWidth\":2560,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/70349969179ccfc3e0588e054183a25210c9de5bf13c5208c24e94bac09adee9/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fessentiallysports_articles_591%2Fc9b872af3b21b9037e37ee0f0ee17910.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/122ac4b15c8d7cbbfd5cf461fab3ed2e5ba5e3eee372a28cd53b806b442bbfd9/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fessentiallysports_articles_591%2Fc9b872af3b21b9037e37ee0f0ee17910.jpg\",\"width\":260}]},\"title\":\"College Football Rankings: Florida Breaks Top 10, LSU Falls Despite Win \u0026 More\",\"type\":\"story\",\"url\":\"https://sports.yahoo.com/articles/college-football-rankings-florida-breaks-075314268.html\",\"viewCount\":0,\"wpm200\":815,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"A homeowner experienced a decrease in battery state of charge instead of an increase after running a propane generator to support a solar battery bank.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Commenters on Reddit explained that the battery charging outcome depends on the system's configuration, with some setups requiring manual settings like AC input or bulk charge to start charging the bank.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"For those considering off-grid solar setups, understanding how a solar-plus-battery system charges can help avoid wasted fuel, outages, and performance drops, while adding battery storage can protect against outages and save on energy costs.\"}],\"attribution\":{\"authors\":[\"Vivian Tran\"],\"brandAlias\":\"the_cool_down\",\"brandUuid\":\"063dff55-2c1a-3c9d-b2de-17888f26264f\",\"image\":{\"altText\":\"TCD logo\",\"caption\":\"TCD logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/TCD_Yahoo_Logo.png_fec93c8f2366e33444d5a8e07af47b9e2a807bc7a246ad3e936916fdd92340f9.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/6eedd107de236293cb6776323314c52b3677740ea23c47ad69a25bfaa8fe5709/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2FTCD_Yahoo_Logo.png_fec93c8f2366e33444d5a8e07af47b9e2a807bc7a246ad3e936916fdd92340f9.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"063dff55-2c1a-3c9d-b2de-17888f26264f\",\"providerSourceId\":\"the_cool_down_737\",\"showBrandPage\":true,\"source\":\"The Cool Down\",\"brandUrl\":\"https://profiles.yahoo.com/brands/the-cool-down/\",\"description\":\"The Cool Down is America's mainstream guide to a cleaner, cooler future, making it easy for people from all walks of life to help themselves while helping the planet.\"},\"badges\":[{\"id\":\"TECHNOLOGY\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"0fe32e3a-c14e-38e9-a924-8aa5e89850d5-1790498359455\",\"categoryLabel\":\"Technology\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"0fe32e3a-c14e-38e9-a924-8aa5e89850d5\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T07:53:00Z\",\"slides\":null,\"summary\":\"\\\"If the generator produces less energy than you're consuming, then the charge will go down.\\\"\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Off-grid homeowner runs propane generator at 38%, learns the inverter may need AC input\",\"originalHeight\":1080,\"originalUrl\":\"https://media.zenfs.com/en/the_cool_down_737/5a9fbe9bb7cef0686497b90abac01e4b.jpg\",\"originalWidth\":1920,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/a1c41b13ed4c48a83393ac94a3aa2d9153375306f8e5ed894985e8b7afcd57f8/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fthe_cool_down_737%2F5a9fbe9bb7cef0686497b90abac01e4b.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/fea72708757428f744d042275e434e5190d78db54a9c75a0eeba428110ba0331/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fthe_cool_down_737%2F5a9fbe9bb7cef0686497b90abac01e4b.jpg\",\"width\":260}]},\"title\":\"Off-grid homeowner runs propane generator at 38%, learns the inverter may need AC input\",\"type\":\"story\",\"url\":\"https://tech.yahoo.com/home/articles/off-grid-homeowner-runs-propane-075300701.html\",\"viewCount\":0,\"wpm200\":174,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"WWE legend and Mayor of Knox County Glenn Jacobs, also known as Kane, attended the Texas Longhorns vs. Tennessee Volunteers game alongside President Donald Trump.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Jacobs, a two-term Mayor of Knox County, has expressed his support for President Trump during his 2020 and 2024 Presidential campaigns.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Despite the Volunteers losing the game, Jacobs' photo with President Trump has sparked mixed reactions among fans, with some expressing excitement and others disappointment.\"}],\"attribution\":{\"authors\":[\"Ishaan Bhattacharya\"],\"brandAlias\":\"hitc\",\"brandUuid\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"image\":{\"altText\":\"HITC Logo\",\"caption\":\"HITC Logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/hitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/6db83a642c866802d185948d53aaac192f9ba39995d8e7a19b281ff573de486e/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2Fhitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"providerSourceId\":\"hitc_articles_832\",\"showBrandPage\":true,\"source\":\"HITC\",\"brandUrl\":\"https://profiles.yahoo.com/brands/hitc/\",\"description\":\"HITC is a British sport news website focused primarily on football, with coverage extending to Formula 1, NBA, Tennis, and Golf. It was formerly known as Here Is the City and focused on financial news and entertainment before switching to sport in 2023.\"},\"badges\":[{\"id\":\"POLITICS\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"4ac1ec95-d3ef-3949-86e1-01a578d234e3-1790498359455\",\"categoryLabel\":\"Politics\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"4ac1ec95-d3ef-3949-86e1-01a578d234e3\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T07:52:38Z\",\"slides\":null,\"summary\":\"President Donald Trump attended the Texas Longhorns’ 20-17 win over the Tennessee Volunteers and sat beside WWE legend and Mayor of Knox County Glenn Jacobs (f. k.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Credit: Jared C. Tilton/Matt Kelley via Getty Images\",\"originalHeight\":1080,\"originalUrl\":\"https://media.zenfs.com/en/hitc_articles_832/9a2cca7d72b08a2e1c55a42acb98b41a.jpg\",\"originalWidth\":1920,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/809898c023c8d51f3c6bc5db2bb1e6e5c4ab91b3fd18dc2439d142163c7e0b20/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2F9a2cca7d72b08a2e1c55a42acb98b41a.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/2ab719f5d738a61e484b44dffc6080798cae5fff5948234eb9b8c9b34303e97f/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2F9a2cca7d72b08a2e1c55a42acb98b41a.jpg\",\"width\":260}]},\"title\":\"Fans are split after President Donald Trump sat with WWE legend Kane at Texas vs Tennessee\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/entertainment/celebrity/articles/fans-split-president-donald-trump-075238171.html\",\"viewCount\":0,\"wpm200\":101,\"metadata\":{\"ccode\":\"\"}},{\"attribution\":{\"authors\":[\"Reuters\"],\"brandAlias\":\"reuters\",\"brandUuid\":\"b7a7f6ef-d51a-318f-8dc4-584e2489e41e\",\"image\":{\"altText\":\"Reuters logo\",\"caption\":\"Reuters logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/480-ORANGE-CIRCLE.jpg_4939f4243502912db4959416ec20ea7dd4aebe0d822cea68b46cab91b828bdbe.jpg\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/e4cac38ae5e65950f87de032a161e6eff3c642e126f0b581becf3fdcc2156dd0/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2F480-ORANGE-CIRCLE.jpg_4939f4243502912db4959416ec20ea7dd4aebe0d822cea68b46cab91b828bdbe.jpg\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"b7a7f6ef-d51a-318f-8dc4-584e2489e41e\",\"providerSourceId\":\"reuters.com\",\"showBrandPage\":true,\"source\":\"Reuters\",\"brandUrl\":\"https://profiles.yahoo.com/brands/reuters/\",\"description\":\"Reuters is the source for independent, factual news from all corners of the world.\"},\"badges\":[{\"id\":\"WORLD\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"96c876ef-95b5-302d-a699-c62fe757b84d-1790498359455\",\"categoryLabel\":\"World\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"96c876ef-95b5-302d-a699-c62fe757b84d\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T07:52:10Z\",\"slides\":null,\"summary\":\"LONDON, Sept 27 () - British police said on Sunday they had arrested several men on suspicion of offences under the Explosives Act and the ‌army was examining a number of vehicles after security was stepped up ‌at a British air base used by US air forces in southwest England. The British government gave authorisation ​to the US to use RAF Fairford to carry out strikes on Iranian missile sites that are attacking ships in the Strait of Hormuz.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Emergency vehicles are parked at Fairford Youth Football club, near RAF Fairford airbase, which hosts United States Air Force (USAF) personnel, in Fairford, Gloucestershire, Britain, September 27, 2026. REUTERS/Toby Shepheard\",\"originalHeight\":533,\"originalUrl\":\"https://media.zenfs.com/en/reuters.com/574fea342a852b2645bf7ef9fd5cc509.jpg\",\"originalWidth\":800,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/59f4b7300056a7c8d132e0e65ca51b6a649ef8368a4eda929ccc21e18ca0853a/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Freuters.com%2F574fea342a852b2645bf7ef9fd5cc509.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/149b8cfe7f2c3ee66bfe1e179863ee125f54520553288cfebe647e779262f249/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Freuters.com%2F574fea342a852b2645bf7ef9fd5cc509.jpg\",\"width\":260}]},\"title\":\"Police declare major incident at UK's Fairford air base, used by US air forces\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/news/articles/police-declare-major-incident-uks-075210133.html\",\"viewCount\":0,\"wpm200\":103,\"metadata\":{\"ccode\":\"\"}},{\"attribution\":{\"authors\":[\"Emily Dozier\"],\"brandAlias\":\"the_sporting_news\",\"brandUuid\":\"0f040722-7db6-3b5b-839d-8b308c03f8af\",\"image\":{\"altText\":\"\",\"caption\":\"\",\"originalHeight\":400,\"originalUrl\":\"https://s.yimg.com/os/creatr-uploaded-images/2025-07/99afc130-569a-11f0-bfdf-9ad58b40b5c3\",\"originalWidth\":400,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.y