s.yimg.com/lo/mysterio/api/e22d5e3cc0f20dc05dc3f5ca9225deb812f2d556aa0df70b7753c1f9f16bbc6d/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2F2026-09%2Fbaee36b6-1e7e-4f34-a06e-c1ba39882b07\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/a68b9efd6a60a9940fa7f4ae58bdc4ecbd73c5af09f771c4b84fb5c93d993d81/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2F2026-09%2Fbaee36b6-1e7e-4f34-a06e-c1ba39882b07\",\"width\":260}]},\"title\":\"2026 VMAs: How to watch live, who's performing, full nominations list and more\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/entertainment/music/article/2026-vmas-how-to-watch-live-whos-performing-full-nominations-list-and-more-200630503.html\",\"viewCount\":0,\"wpm200\":407,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Brandt Snedeker praised Scottie Scheffler for handling being left out of the Saturday afternoon session at the Presidents Cup.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Despite winning two out of three matches, Scottie Scheffler struggled with his approach play during the Presidents Cup.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Snedeker's decision to sit Scheffler out of the afternoon session backfired as the International Team maintained their lead heading into the singles matches.\"}],\"attribution\":{\"authors\":[\"Jordan Harris\"],\"brandAlias\":\"hitc\",\"brandUuid\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"image\":{\"altText\":\"HITC Logo\",\"caption\":\"HITC Logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/hitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/6db83a642c866802d185948d53aaac192f9ba39995d8e7a19b281ff573de486e/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2Fhitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"providerSourceId\":\"hitc_articles_832\",\"showBrandPage\":true,\"source\":\"HITC\",\"brandUrl\":\"https://profiles.yahoo.com/brands/hitc/\",\"description\":\"HITC is a British sport news website focused primarily on football, with coverage extending to Formula 1, NBA, Tennis, and Golf. It was formerly known as Here Is the City and focused on financial news and entertainment before switching to sport in 2023.\"},\"badges\":[{\"id\":\"SPORTS\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"2dbda24f-bb79-33dd-892b-fcd86e258f3d-1790498359454\",\"categoryLabel\":\"Sports\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"2dbda24f-bb79-33dd-892b-fcd86e258f3d\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T08:30:00Z\",\"slides\":null,\"summary\":\"Brandt Snedeker has praised Scottie Scheffler for how he handled learning that he was sitting out the Saturday afternoon session at the Presidents Cup. It has been yet another tough week for Scheffler while representing Team USA.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Photo by Matthew Maxey/Icon Sportswire via Getty Images\",\"originalHeight\":1280,\"originalUrl\":\"https://media.zenfs.com/en/hitc_articles_832/33395ecef7da9d2bddc51725cd61c619.jpg\",\"originalWidth\":1920,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/3afc71c4a49356f604d34103e1f8f19ff03218eb6ec9bacc21ef6604fe9a9848/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2F33395ecef7da9d2bddc51725cd61c619.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/2d816b49c25c4ae25af583b9135d5ef9a235091c7635030c04ed592a1d7b8fce/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2F33395ecef7da9d2bddc51725cd61c619.jpg\",\"width\":260}]},\"title\":\"Brandt Snedeker reveals how Scottie Scheffler reacted to sitting out Saturday afternoon at the Presidents Cup\",\"type\":\"story\",\"url\":\"https://sports.yahoo.com/articles/brandt-snedeker-reveals-scottie-scheffler-083000789.html\",\"viewCount\":0,\"wpm200\":188,\"metadata\":{\"ccode\":\"\"}},{\"attribution\":{\"authors\":[\"Tereza Shkurtaj\"],\"brandAlias\":\"people\",\"brandUuid\":\"c8b1150b-d2bf-37c3-b659-f30bbd6b6d3b\",\"image\":{\"altText\":\"\",\"caption\":\"\",\"originalHeight\":400,\"originalUrl\":\"https://s.yimg.com/os/creatr-uploaded-images/2020-11/2bcc7fd0-2b81-11eb-b8bf-81d014a63a87\",\"originalWidth\":400,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/d3862dc9fe70d4a43365bdbb94ce258af17b1aa996134e707bff8d5cdd13b21e/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fs.yimg.com%2Fos%2Fcreatr-uploaded-images%2F2020-11%2F2bcc7fd0-2b81-11eb-b8bf-81d014a63a87\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"c8b1150b-d2bf-37c3-b659-f30bbd6b6d3b\",\"providerSourceId\":\"people_218\",\"showBrandPage\":true,\"source\":\"People\",\"brandUrl\":\"https://profiles.yahoo.com/brands/people/\",\"description\":\"PEOPLE defines celebrity, drives conversation and inspires action. We are your everyday escape, taking you inside the lives of the world’s most intriguing people and making you an integral part of the cultural conversation. We enrich your life with indispensable service and social connection.\"},\"badges\":[{\"id\":\"GOODABLE\",\"type\":\"Contextual\"},{\"id\":\"HEALTH\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"6b02cb60-126c-35df-a510-f3701086f53a-1790498359454\",\"categoryLabel\":\"Health\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"6b02cb60-126c-35df-a510-f3701086f53a\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T08:29:00Z\",\"slides\":null,\"summary\":\"“Of course it has changed the way we see things, but we do not let it stop us from living life,” Olivia Jones tells PEOPLE\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Olivia Jones; mail plane.Credit: Olivia Jones\",\"originalHeight\":1000,\"originalUrl\":\"https://media.zenfs.com/en/people_218/eaf04405aed211a8039e4a3d76d13d4c.jpg\",\"originalWidth\":1500,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/414aceab8b2cdb498045931a395a6e164174c7dd55f6e582bd54f7e8de505a38/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fpeople_218%2Feaf04405aed211a8039e4a3d76d13d4c.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/c0f28a7b2a353d6ed2e7a2ed532f64cc058f21ce50df6ad3643e2c8ce2c790e3/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fpeople_218%2Feaf04405aed211a8039e4a3d76d13d4c.jpg\",\"width\":260}]},\"title\":\"Alaskan Woman Reveals How Family Handles Medical Emergencies When Road to Hospital Is Closed for 6 Months a Year (Exclusive)\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/lifestyle/articles/alaskan-woman-reveals-family-handles-082900314.html\",\"viewCount\":0,\"wpm200\":233,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Buffalo Bills WR DJ Moore went viral for paying for meals at a local restaurant after a fan paid for his, endearing himself even more to the Bills Mafia.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Moore quietly paid for the meals of everyone at ZJ’s Family Restaurant in Hamburg, including those who hadn't gotten a table yet, and distributed the remaining money as tips to the wait staff.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"The star receiver's gesture of kindness, without informing any patrons, has strengthened his connection with local fans and increased his popularity among the Buffalo Bills fanbase.\"}],\"attribution\":{\"authors\":[\"Aaditya Krishnamurthy\"],\"brandAlias\":\"hitc\",\"brandUuid\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"image\":{\"altText\":\"HITC Logo\",\"caption\":\"HITC Logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/hitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/6db83a642c866802d185948d53aaac192f9ba39995d8e7a19b281ff573de486e/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2Fhitc_logo.png_b3c091d244c8dee9d0bbdf832c69df51fedac0865422c9e2ec2f351235f77301.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"712bfad4-bb3d-4b7d-8f1c-473270c298a1\",\"providerSourceId\":\"hitc_articles_832\",\"showBrandPage\":true,\"source\":\"HITC\",\"brandUrl\":\"https://profiles.yahoo.com/brands/hitc/\",\"description\":\"HITC is a British sport news website focused primarily on football, with coverage extending to Formula 1, NBA, Tennis, and Golf. It was formerly known as Here Is the City and focused on financial news and entertainment before switching to sport in 2023.\"},\"badges\":[{\"id\":\"GOODABLE\",\"type\":\"Contextual\"},{\"id\":\"CELEBRITY\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"9c4ff8c3-829a-3773-9f6e-4c8591068b57-1790498359454\",\"categoryLabel\":\"Celebrity\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"9c4ff8c3-829a-3773-9f6e-4c8591068b57\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T08:27:30Z\",\"slides\":null,\"summary\":\"Buffalo Bills WR DJ Moore is going viral on social media for his response to a fan paying for his meal at a restaurant. Moore is already one of the most popular players among Bills fans, as he has become an incredibly reliable offensive weapon for Josh Allen.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"Photo by Michael Reaves/Getty Images\",\"originalHeight\":1280,\"originalUrl\":\"https://media.zenfs.com/en/hitc_articles_832/c1de2441a647be8262a7916e9be429f3.jpg\",\"originalWidth\":1920,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/57dc28d3842ba993a68d009a81d8cebbddc81c3e29bfc34c11f301f00d665398/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2Fc1de2441a647be8262a7916e9be429f3.jpg\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/8ac93ee596507a9e3084e785a95024ff8acfc21911b0a1c0e228c41a25105bbe/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fhitc_articles_832%2Fc1de2441a647be8262a7916e9be429f3.jpg\",\"width\":260}]},\"title\":\"DJ Moore’s kind gesture after one fan paid his restaurant bill goes viral among Buffalo Bills fans\",\"type\":\"story\",\"url\":\"https://sports.yahoo.com/articles/dj-moore-kind-gesture-one-082730967.html\",\"viewCount\":