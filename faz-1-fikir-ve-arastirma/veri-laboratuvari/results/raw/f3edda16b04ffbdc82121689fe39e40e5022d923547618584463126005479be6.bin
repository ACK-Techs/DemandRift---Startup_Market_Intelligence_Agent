h\":720,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":286,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/f31860a607213a0aff5d3b0f54de071383ae407c05b8f20d57c3e844d1abb255/lightyear_networkapi/smartcrop_w520_h286_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmotleyfool.com%2Fd2f528e04fefac628f16e57a4afa1a6f.png\",\"width\":520},{\"__typename\":\"ImageResized\",\"height\":260,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/af63279566778c96da5702318e2e3c9d4de59f8eb96852053660ece1c2b20ce1/lightyear_networkapi/smartcrop_w260_h260_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmotleyfool.com%2Fd2f528e04fefac628f16e57a4afa1a6f.png\",\"width\":260}]},\"title\":\"History Says a Bear Market Is Coming. Here's What the Smartest Investors Are Already Doing.\",\"type\":\"story\",\"url\":\"https://finance.yahoo.com/markets/stocks/articles/history-says-bear-market-coming-080500963.html\",\"viewCount\":0,\"wpm200\":261,\"metadata\":{\"ccode\":\"\"}},{\"attribution\":{\"authors\":[\"Reuters\"],\"brandAlias\":\"reuters\",\"brandUuid\":\"b7a7f6ef-d51a-318f-8dc4-584e2489e41e\",\"image\":{\"altText\":\"Reuters logo\",\"caption\":\"Reuters logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/480-ORANGE-CIRCLE.jpg_4939f4243502912db4959416ec20ea7dd4aebe0d822cea68b46cab91b828bdbe.jpg\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/e4cac38ae5e65950f87de032a161e6eff3c642e126f0b581becf3fdcc2156dd0/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2F480-ORANGE-CIRCLE.jpg_4939f4243502912db4959416ec20ea7dd4aebe0d822cea68b46cab91b828bdbe.jpg\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"b7a7f6ef-d51a-318f-8dc4-584e2489e41e\",\"providerSourceId\":\"reuters.com\",\"showBrandPage\":true,\"source\":\"Reuters\",\"brandUrl\":\"https://profiles.yahoo.com/brands/reuters/\",\"description\":\"Reuters is the source for independent, factual news from all corners of the world.\"},\"badges\":[{\"id\":\"WORLD\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"f341949c-98fb-3641-99f0-e29b1852ab18-1790498359455\",\"categoryLabel\":\"World\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"f341949c-98fb-3641-99f0-e29b1852ab18\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T08:04:46Z\",\"slides\":null,\"summary\":\"JOHANNESBURG, Sept 27 (Reuters) - South African police said 27 people were killed in two separate shootings within hours of each other, and they were hunting the perpetrators who attacked patrons at a\",\"title\":\"South Africa police hunt suspects after 27 killed in two separate shootings\",\"type\":\"story\",\"url\":\"https://www.yahoo.com/news/articles/south-africa-police-launch-manhunt-054953144.html\",\"viewCount\":0,\"wpm200\":95,\"metadata\":{\"ccode\":\"\"}},{\"aiSummary\":[{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"The Forest Service is considering a policy change that would presume trails in national forests open to motorized vehicles, a move that has sparked concerns about environmental damage and confusion.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Critics argue that the proposed change could harm wildlife habitat, worsen erosion, and reduce forests' ability to store carbon, while supporters believe it would expand public access and simplify regulations.\"},{\"__typename\":\"AISummaryItem\",\"type\":\"text\",\"value\":\"Opponents of the policy change maintain that existing travel plans already strike a balance between recreation and conservation, while proponents argue that opening more routes would benefit elderly visitors and people with disabilities.\"}],\"attribution\":{\"authors\":[\"Kim LaCapria\"],\"brandAlias\":\"the_cool_down\",\"brandUuid\":\"063dff55-2c1a-3c9d-b2de-17888f26264f\",\"image\":{\"altText\":\"TCD logo\",\"caption\":\"TCD logo\",\"originalHeight\":480,\"originalUrl\":\"https://d29szjachogqwa.cloudfront.net/images/user-uploaded/TCD_Yahoo_Logo.png_fec93c8f2366e33444d5a8e07af47b9e2a807bc7a246ad3e936916fdd92340f9.png\",\"originalWidth\":480,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":80,\"width\":80,\"url\":\"https://s.yimg.com/lo/mysterio/api/6eedd107de236293cb6776323314c52b3677740ea23c47ad69a25bfaa8fe5709/lightyear_networkapi/smartcrop_w80_h80%3Bformat_webp/https%3A%2F%2Fd29szjachogqwa.cloudfront.net%2Fimages%2Fuser-uploaded%2FTCD_Yahoo_Logo.png_fec93c8f2366e33444d5a8e07af47b9e2a807bc7a246ad3e936916fdd92340f9.png\",\"tag\":null}]},\"isCreatorContent\":false,\"isOriginalContent\":false,\"providerBrandId\":\"063dff55-2c1a-3c9d-b2de-17888f26264f\",\"providerSourceId\":\"the_cool_down_737\",\"showBrandPage\":true,\"source\":\"The Cool Down\",\"brandUrl\":\"https://profiles.yahoo.com/brands/the-cool-down/\",\"description\":\"The Cool Down is America's mainstream guide to a cleaner, cooler future, making it easy for people from all walks of life to help themselves while helping the planet.\"},\"badges\":[{\"id\":\"US\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"c85194cb-35fd-36fe-90de-a16cfc93b929-1790498359455\",\"categoryLabel\":\"U.S.\",\"commentCount\":0,\"contentType\":\"story\",\"id\":\"c85194cb-35fd-36fe-90de-a16cfc93b929\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"liveBlog\":false,\"pubDate\":\"2026-09-27T08:04:00Z\",\"slides\":null,\"summary\":\"Opponents argue that broader motorized access would affect both the land itself and the people who use it.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"US Forest Service proposes opening most national forest trails to ATVs, dirt bikes, and 4x4s\",\"originalHeight\":1080,\"originalUrl\":\"https://media.zenfs.com/en/the_cool_down_737/feebae14c48cc1b016