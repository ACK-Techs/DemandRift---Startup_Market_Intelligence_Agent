entation-horizontal"><div class="cdk-virtual-scroll-content-wrapper" style="transform: translateX(0px);"><!----></div><div class="cdk-virtual-scroll-spacer" style="width:3408px;height:;"></div></cdk-virtual-scroll-viewport></app-home-carousel-v3></div><div _ngcontent-sc134="" class="my-4"><app-advertisement _ngcontent-sc134="" _nghost-sc132=""><div _ngcontent-sc132="" class="ad-container"><div _ngcontent-sc132="" class="text-center oc-ad desktop-banner" id="nn_lb3"></div></div></app-advertisement></div><hr _ngcontent-sc134=""><div _ngcontent-sc134="" class="mt-4 mb-4"><h2 _ngcontent-sc134="">Who is "Mighty Man"?</h2><p _ngcontent-sc134="">"Mighty Man" is OpenCritic's way of tagging games based on the scores awarded to them by top critics.</p><p _ngcontent-sc134="">The color scheme comes from video games, where "orange" loot is often best, with purple, blue, and green tiered loot following.</p><div _ngcontent-sc134="" class="row mighty-man-explainer mb-4"><div _ngcontent-sc134="" class="col-lg-3"><div _ngcontent-sc134="" class="d-flex align-items-center mt-2 mt-lg-0"><app-tier-display _ngcontent-sc134="" display="head" tier="Mighty" _nghost-sc124=""><img _ngcontent-sc124="" src="//img.opencritic.com/mighty-man/mighty-head.png" alt="Mighty" width="50" height="60"><!----><!----></app-tier-display><div _ngcontent-sc134="" class="ml-1"><strong _ngcontent-sc134="">Mighty</strong><br _ngcontent-sc134=""> The top 10% of game ratings. Best in their genre. Universal critical acclaim. </div></div></div><div _ngcontent-sc134="" class="col-lg-3"><div _ngcontent-sc134="" class="d-flex align-items-center mt-2 mt-lg-0"><app-tier-display _ngcontent-sc134="" display="head" tier="Strong" _nghost-sc124=""><img _ngcontent-sc124="" src="//img.opencritic.com/mighty-man/strong-head.png" alt="Strong" width="50" height="60"><!----><!----></app-tier-display><div _ngcontent-sc134="" class="ml-1"><strong _ngcontent-sc134="">Strong</strong><br _ngcontent-sc134=""> The next 30% of all games scored on OpenCritic. Great execution with a few flaws. </div></div></div><div _ngcontent-sc134="" class="col-lg-3"><div _ngcontent-sc134="" class="d-flex align-items-center mt-2 mt-lg-0"><app-tier-display _ngcontent-sc134="" display="head" tier="Fair" _nghost-sc124=""><img _ngcontent-sc124="" src="//img.opencritic.com/mighty-man/fair-head.png" alt="Fair" width="50" height="60"><!----><!----></app-tier-display><div _ngcontent-sc134="" class="ml-1"><strong _ngcontent-sc134="">Fair</strong><br _ngcontent-sc134=""> Games scored in the 30th - 60th percentiles. Some issues hold these games. </div></div></div><div _ngcontent-sc134="" class="col-lg-3"><div _ngcontent-sc134="" class="d-flex align-items-center mt-2 mt-lg-0"><app-tier-display _ngcontent-sc134="" display="head" tier="Weak" _nghost-sc124=""><img _ngcontent-sc124="" src="//img.opencritic.com/mighty-man/weak-head.png" alt="Weak" width="50" height="60"><!----><!----></app-tier-display><div _ngcontent-sc134="" class="ml-1"><strong _ngcontent-sc134="">Weak</strong><br _ngcontent-sc134=""> The bottom 30% of game ratings. Games that missed on some key elements. </div></div></div></div></div><hr _ngcontent-sc134=""><div _ngcontent-sc134=""><div _ngcontent-sc134="" class="text-center my-4"><span _ngcontent-sc134="" class="loader"></span></div></div><!----><!----><div _ngcontent-sc134="" class="mt-4"><app-advertisement _ngcontent-sc134="" _nghost-sc132=""><div _ngcontent-sc132="" class="ad-container offset-px"><div _ngcontent-sc132="" class="text-center oc-ad mobile-box" id="nn_mobile_mpu2"></div></div></app-advertisement></div><div _ngcontent-sc134="" class="desktop-home my-4"><div _ngcontent-sc134="" class="d-flex border-bottom mb-2 align-items-end"><h2 _ngcontent-sc134="" id="more-news">Industry Headlines</h2></div><div _ngcontent-sc134=""><div _ngcontent-sc134="" class="row article align-items-center"><div _ngcontent-sc134="" class="col-lg-5 pb-3 order-1"><div _ngcontent-sc134="" class="view overlay rounded z-depth-2 arti