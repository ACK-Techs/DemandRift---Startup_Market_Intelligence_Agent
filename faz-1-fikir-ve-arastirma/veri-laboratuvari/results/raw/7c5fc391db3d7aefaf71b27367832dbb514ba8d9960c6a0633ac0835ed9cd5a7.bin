<div class='s-container s-gridMaxXs24'>
<h1 class='s-marginVert1 s-fontSize35 u-fontWeight800 help_articles-category__title'>
FAQ: Fundraising
</h1>
<div class='s-gridMaxSm14'>
<div class="help_articles-search_form" data-rc="help_articles/search_form"><form class="simple_form c-form help" action="/help/search" accept-charset="UTF-8" method="post"><input name="utf8" type="hidden" value="&#x2713;" autocomplete="off" /><input type="hidden" name="authenticity_token" value="LOxbb88-8JnK_arGQ0i6qmbxtVp4483piD8jXEQvw4TqPmuumc9DmHUrv2fRJuG-Kw-InQpQBM453Lre0GLRJg" autocomplete="off" /><input value="Fundraising" autocomplete="off" type="hidden" name="help[category]" id="help_category" />
