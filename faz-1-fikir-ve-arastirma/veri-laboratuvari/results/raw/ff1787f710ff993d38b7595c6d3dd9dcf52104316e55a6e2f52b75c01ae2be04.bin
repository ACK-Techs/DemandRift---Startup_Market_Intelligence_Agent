null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715663387750566031","clanid":"39257154","posterid":"0","headline":"Introducing the Chants of Sennaar x The S\u00e9ance of Blake Manor Bundle","posttime":1788876032,"updatetime":1788876032,"body":"Hello detectives, \n\nWe are so excited to reveal our new bundle with the fantastic Chants of Sennaar. \n\n[img]{STEAM_CLAN_IMAGE}\/39257154\/422e13b6150ddefba08f2e6e3c854abff15e5697.jpg[\/img]\n[b]About Chants of Sennaar [\/b]\n\nChants of Sennaar is an award-winning puzzle adventure game where you play as the Traveler on a quest to reunite the Peoples of the Tower. You must decipher ancient languages in an enthralling world full of secrets. \n[b]\nComplete the Set [\/b]\n\nThe Chants of Sennaar x The S\u00e9ance of Blake Manor bundle is a \u201ccomplete the set\u201d bundle, which means that you will pay for and receive just the items you do not already own in your Steam Library at the discounted price. \n\nBuy the bundle: https:\/\/store.steampowered.com\/bundle\/80608\/Chants_of_Sennaar_x_The_Seance_of_Blake_Manor\/  \n","commentcount":4,"tags":["mod_reviewed","ModAct_1889321037_1788877065_0"],"language":0,"hidden":0,"forum_topic_id":"582807520276629390","event_gid":"715663387750566030","voteupcount":90,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1788876000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582807520276629390","rtime32_last_modified":1789623605,"news_post_gid":"0","rtime_mod_reviewed":1788877065,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788869236,"votes_up":90,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"508449490226648572","gidfeature2":"582807520276629390"},{"gid":"715663387750563864","clan_steamid":"103582791468778562","event_name":"Demo Update 1.1.2.337 & Patch 1.1.12.360","event_type":13,"appid":1395520,"server_address":null,"server_password":null,"rtime32_start_time":1788339480,"rtime32_end_time":1788343201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"ae230aee8bcdd023d441c51783bba5620ed9d35a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"38318f464ab487bc930fce7cbbf3d1ffc93a69c4.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715663387750563865","clanid":"39257154","posterid":"0","headline":"Demo Update 1.1.2.337 & Patch 1.1.12.360","posttime":1788339472,"updatetime":1788339597,"body":"Hello detectives, \n\nWe have released a demo update and patch for the full game today. \n\nThe demo update brings this in line with the full released version of the game.\n\nPatch 1.1.12.360 includes a number of improvements and fixes to the full game. \n\nThe full changelog can be found below (please note this changelog may contain spoilers).\n\n[img]{STEAM_CLAN_IMAGE}\/39257154\/eac9c0b1f133d1206a3c7eb1844ed517a0f9cc5e.png[\/img]\n[list]\n[*]Various bug fixes and stability improvements, bringing the demo in line with the full game.\n[\/list]\n\n[img]{STEAM_CLAN_IMAGE}\/39257154\/3f9f9cf491bf260b6cd7b39dec5fe8d2a3ed356e.png[\/img]\nUI and settings changes\n[list]\n[*]Added the option to turn V-Sync off via the Options menu\n[*]Added target frame rate option\n[*]Changed binding for cycling through hotspot interactions to Q\n[*]Implemented a double click to skip option for dialogue\n[*]Added an option to disable skipping dialogue.\n[*]Order of categories in the Records and Discussable screens now align more closely with each other\n[*]Guest names are now sorted by last name\n[\/list]\nUI and settings bug fixes\n[list]\n[*]Fixed a visual error on the how to play screen background\n[*]Increased scroll sensitivity on how to play screen\n[*]Fixed an issue where the hourglass tutorial window didn\u2019t work with the Tutorial Mode set to Press\n[*]Preventing time data being carried over when loading save from main menu\n[*]Credits updated\n[*]Fixed an issue where the journal could get stuck on specific mindmaps after tutorials forcibly bring you to a specific one\n[*]Fixed an issue where inputs start working during ftue if alt tabbing out and back in\n[*]Changed where the cursor disabling\/enabling happens during loading\n[*]Fixed an issue where the game continues to react to your mouse clicks when using Steam overlay.\n[*]Made ampm work on timetable screen for cultures with different characters\n[*]Stopped multiple hypothesis considerations from triggering when button is spammed\n[*]Fixed some issues with the journal\u2019s behaviour on closing and switching tabs\n[*]Corrected position of the monument on the maze map\n[*]Fixed an issue that enabled players to accidentally press F5 to Quick Save while in the Title Screen\n[*]Items should only show up as discussable with Varley after you have met him.\n[\/list]\nAudio\n[list]\n[*]Removed rogue fire sfx\n[*]Fixed an issue where Ettienne\u2019s voice audio would stop before the line was finished\n[*]Added missing door sounds to some scene transitions\n[*]Adjusted sfx for analysis\n[*]Ensured voice over lines respect volume settings.\n[*]Wind and crows SFX will fade out when you enter the ballroom from the walled garden, when [*]Doyle kicks you out of the walled garden for the seance and when you enter the church.\n[*]Thunder and rain sfx should now play during the seance.\n[*]Fixed an issue where music did not play in gardens during day 3 before the seance\n[*]Fixed some music issues after loading a save at the seance.\n[*]Fixed wind and rain for some Day 3 cutscenes\n[\/list]\nJournal\n[list]\n[*]Various adjustments to NPC mind maps\n[*]Various adjustments to Main Mystery mind maps\n[*]Updated religious lore for characters.\n[\/list]\nEnvironment\n[list]\n[*]Sigil fire effects should no longer disappear when you leave the room.\n[*]Stopped Sigil lines from disappearing when moving the camera away from them.\n[*]Added missing top face collider to an object in Manager\u2019s Office.\n[*]Fixed some incorrect shadows and floating characters\n[*]Alcohol bottle now has more generic logo\n[*]Fixed various occlusion culling issues\n[*]Visually corrected some light sources in the Manor.\n[*]Corrected the Library name plaque\n[*]Fixed an issue where containers would not auto-close after walking away from them\n[*]Removed an old door hotspot for the ballroom door\n[*]Fix to prevent the player from getting stuck on a crate cart puzzle\n[*]Drawing room rope will now not still be there after time skip.\n[*]Updated age of Percival Blake\u2019s death.\n[*]Fixed a visual issue with Atrium door windows in the Ballroom from 5PM onwards on day 3\n[*]The typewriter should correctly reset on day 2.\n[*]Door open position and hotspots are now remembered in the storeroom.\n[*]Renamed travel plans hotspot to map of Europe.\n[*]Fixed highlight on garden gate\n[*]Footstep sounds on tiles outside bedroom should now play correctly.\n[*]Removed the hotspot from Lau\u2019s nightstand\n[\/list]\nTime\n[list]\n[*]Each of Hazel's lockbox barks should only take a single click now.\n[*]All coats in the cloakroom now cost 1 tick\n[*]Fixed an issue where you could progress time infinitely by interacting with one object in Ines room\n[*]Removed time cost from an item in Skerrit\u2019s room, and fixed collider\n[\/list]\nLore\n[list]\n[*]Added Doyle [spoiler]writing fact to pile of books[\/spoiler]\n[*]Added shoe size onto Jonathan Blake's shoe bark.\n[*]Removed fact and all references to fact for O Finn - [spoiler]He cannot read or write English.[\/spoiler]\n[*]Caitlin fact - [spoiler]I found some of her writings - Unlocks if you have discarded note and bible.[\/spoiler]\n[*]Caitlin fact - [spoiler]Writing lore wording tweaked, and unlocked on women's dorm letter.[\/spoiler]\n[*]Carmela fact - [spoiler]Writing lore wording tweaked, and unlocked on crumpled note in laundry.[\/spoiler]\n[*]Fixed bug where you can't access Blake\u2019s shoes in the empty bedroom.\n[*]Sinnott fact - [spoiler]In his mid-60s - should drop when you speak to him normally.[\/spoiler]\n[*]Jonathan Blake fact - [spoiler]He is mourning his late wife - unlocks when you present Mary Blake.[\/spoiler]\n[*]Saoirse fact - [spoiler]Miss Deane had started to teach her magic - unlocks on ballroom eavesdrop.[\/spoiler]\n[*]Hunter fact - [spoiler]He is in his mid-50s - drops when you speak to him for the first time in the front courtyard on day 2, 12PM.[\/spoiler]\n[*]Doyle fact - [spoiler]He is in his late 20s - Unlocks if you speak to him before a meal in the east corridors.[\/spoiler]\n[*]Ines fact - [spoiler]She is mourning the recent loss of her mother - Unlocks when you look at burial record.[\/spoiler]\n[*]Cathal fact - [spoiler]I found writings in his journal in his room - Unlocks when you interact with his journal.[\/spoiler]\n[*]Carmela fact - [spoiler]she is a famed mystic, who is helming the s\u00e9ance. Unlocks whenever you get conductor of the seance.[\/spoiler]\n[*]Seamus fact - [spoiler]age lore should unlock when you click on the dining room door.[\/spoiler]\n[\/list]\nMisc\n[list]\n[*]Addressed various typos\n[*]Fixed missing lip animations for a cutscene with Etienne\n[*]Ensured sigils still work when reloading a scene from a save.\n[*]Fixed an issue where only right clicking through a cutscene will prevent the cursor from showing to scroll through the dialog.\n[*]Fixed an issue with the Brandy staying disappeared when reloading a save.\n[*]Disabled inaccurate barks when you've found everything in rooms.\n[*]Protestant service should fire a notification when you eavesdrop.\n[*]Fixed an issue with the crow appearing outside without triggering the cutscene\n[*]Fixed an issue causing Ward to die too when loading a save in the church at the end of the game.\n[*]Changed conditions for the final bit of dialogue unlocking for the sigil under O Finn's bed to avoid early spoilers.\n[*]Angry face comic panel now appears in church cutscene\n[*]Fixed an issue where loading a save incorrectly reenables the spirit board minigame\n[*]Corrected low res evidence art for Rejected Request and Letter from Doctor Callaghan\n[*]Added a hotspot for Mantovani\u2019s remains after the seance ritual cutscene\n[*]Fixed flickering image issues on the Point of No Return screen\n[*]Fixed issues where O Finn\u2019s kidnapping could be spoiled for players by some text\/dialogue if they hadn\u2019t found out yet\n[*]Moved Ettienne to the bar at 5PM and updated his timetable dialogue accordingly.\n[*]Made Ward's reaction in the church after the Seance play by default instead of via an awkwardly placed hotspot\n[*]Fixed an issue where players were able to manually save at moments saving is meant to be blocked\n[\/list]\nThe S\u00e9ance of Blake Manor is OUT NOW. \n\nhttps:\/\/store.steampowered.com\/app\/1395520\/The_Sance_of_Blake_Manor\/","commentcount":11,"tags":["mod_reviewed","ModAct_1434411615_1788340077_0"],"language":0,"hidden":0,"forum_topic_id":"582807198746321603","event_gid":"715663387750563864","voteupcount":198,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582807198746321603","rtime32_last_modified":1789352964,"news_post_gid":"0","rtime_mod_reviewed":1788340078,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788337928,"votes_up":198,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"508449490226648572","gidfeature2":"582807198746321603"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["715663387750566031","715663387750563865"],"last_update_event":{"rtime":1788339480,"event_gid":"715663387750563864","announcement_gid":"715663387750563865","clan_account_id":39257154}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				

					<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="game_area_reviews" class="game_area_description">
						<h2>Reviews</h2>
												<p>“The Séance of Blake Manor is an autumnal treat filled with spooky scenes but it is also that most joyous of discoveries: a game that challenges, delights, thrills and educates in equal measure.”<br>5/5 – <a href="https://steamcommunity.com/linkfilter/?u=https%3A%2F%2Fwww.theguardian.com%2Fgames%2F2025%2Foct%2F27%2Fthe-seance-of-blake-manor-review-gripping-gothic-detective-game-steeped-in-mystery-and-menace" target="_blank" rel=" noopener"  >The Guardian</a><br><br>“one of the best mystery games in recent years”<br>4.5/5 – <a href="https://steamcommunity.com/linkfilter/?u=https%3A%2F%2Fwww.gamesradar.com%2Fgames%2Fadventure%2Fthe-seance-of-blake-manor-review%2F" target="_blank" rel=" noopener"  >Gamesradar +</a><br><br>“This enthralling mystery quickly had me in its ghostly grip and refused to let go”<br>87/100 – <a href="https://www.pcgamer.com/games/adventure/the-seance-of-blake-manor-review/" target="_blank" rel=""  >PC Gamer</a><br></p>
					</div>
				
								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><i>Ireland, October 29, 1897. </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>I’ll waste no time, since there’s none for wasting. I write from Blake Manor in Connemara. </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>Yesterday, a guest went missing – a young woman named Evelyn Deane. The owner and staff carry on as if nothing has happened.  </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>She has not left, of that I am sure.</i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/5f8a9c181cea7e8a681f9c26c0c638a7.poster.avif?t=1788513685" width=616 height=205 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/5f8a9c181cea7e8a681f9c26c0c638a7.webm?t=1788513685" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" >It is October 29th, 1897, and Private Investigator Declan Ward arrives at Blake Manor to find a missing woman.  </p><p class="bb_paragraph" >What he finds is the Grand Séance and a group of mystics who have gathered from all corners of the world – waiting for All Hallow’s Eve, the night when the veil between worlds is thinnest. The night to tear down the barrier and speak to the dead.  </p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/82cc6998e3f7298017ee58a556cdb350.poster.avif?t=1788513685" width=616 height=205 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/82cc6998e3f7298017ee58a556cdb350.webm?t=1788513685" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" >Interview and interrogate your suspects, keep a record of all evidence, motivations, and clues in your journal, and confront them about their motivations when you’re certain of your deductions. Uncover the truth about Blake Manor and the mysterious séance that has brought everyone together. </p><p class="bb_paragraph" >Navigate Blake Manor's haunted corridors and uncover its secrets as you race against time to save Miss Deane. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/a536e81e5eca3693cd51502e34aa8be3.poster.avif?t=1788513685" width=616 height=205 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/a536e81e5eca3693cd51502e34aa8be3.webm?t=1788513685" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" >Investigate the manor, solve environmental clues and reach the forbidden areas of the hotel…and beyond. </p><p class="bb_paragraph" >But be careful - each action counts the day down. Be in the right place at the right time to catch critical events pertinent to your investigation. Everyone has their own agendas and schedules – it could truly be a loss to miss out on a quick chat by mistiming your actions. And who knows what hidden secrets lie in wait once you’ve turned in for the night...   </p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/f6da7c4a0fb6e215d1bac1fa6e9d5f28.poster.avif?t=1788513685" width=616 height=205 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1395520/extras/f6da7c4a0fb6e215d1bac1fa6e9d5f28.webm?t=1788513685" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" >Brought to you by the creators of The Darkside Detective and Raw Fury, The Séance of Blake Manor is depicted by a beautiful comic-book art style. Inspired by Irish Mythology and the spiritualist movements of the Victorian era, players are cast into a first-person narrative adventure, blending the supernatural with a classic detective mystery. With its striking cutscenes, compelling narrative and dynamic soundtrack that reacts to the environment around you, Blake Manor and its secrets will leave you on the edge of your seat morning through night. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>...I know the West of Ireland might as well be the far side of the world, for its distance from you but there is no one else to turn to.  </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>I hear you are an honourable man, a steadfast investigator. And – perhaps most importantly – godly. </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>I pray for the girl that this is true... </i></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >This game is currently only available in English language.</p>						</div>
					</div>
