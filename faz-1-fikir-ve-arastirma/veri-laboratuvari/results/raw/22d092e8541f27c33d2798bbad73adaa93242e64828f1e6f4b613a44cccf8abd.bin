<script type="text/javascript">
  var breakpoints = [{"browser_size":"[768, 0]","ad_sizes":"[120, 60]"}];
  var browserWidth = window.innerWidth;
  var shouldDisplayAd = true;

  // Sort breakpoints by browser size in ascending order because yml file can have any order
  breakpoints.sort(function(a, b) {
    var aBrowserSize = JSON.parse(a.browser_size)[0];
    var bBrowserSize = JSON.parse(b.browser_size)[0];
    return aBrowserSize - bBrowserSize;
  });

  // Check through the ads breakpoints and compare against browser
  for (var i = 0; i < breakpoints.length; i++) {
    var breakpoint = breakpoints[i];
    var breakpointBrowserSize = JSON.parse(breakpoint.browser_size);
    var breakpointAdSizes = JSON.parse(breakpoint.ad_sizes);
    if (browserWidth >= breakpointBrowserSize[0]) {
      if (breakpointAdSizes.length === 0) {
        // Ad is not to render at this breakpoint
        shouldDisplayAd = false;
      } else {
        // if desktop display only ad
        shouldDisplayAd = true;
      }
    }
  }
  if (shouldDisplayAd) {
    window.adsList.push({
        id: "js-dfp-tag-yA4",
        name: "/3244/Watchlist/MyQuotesButton",
        size: [120, 60] // Handle fluid size
    });

    googletag.cmd.push(function() {
                // Start by defining breakpoints for this ad.
          var mapping = googletag.sizeMapping()
                      .addSize([768, 0], [120, 60])
                    .build();
      
      googletag.slots["js-dfp-tag-yA4"] = googletag.defineSlot("/3244/Watchlist/MyQuotesButton", [120, 60], "js-dfp-tag-yA4")

            .addService(googletag.pubads())

      
      
      
                    // Apply size mapping when there are breakpoints.
        .defineSizeMapping(mapping)
            ;
    });
  }
</script>
