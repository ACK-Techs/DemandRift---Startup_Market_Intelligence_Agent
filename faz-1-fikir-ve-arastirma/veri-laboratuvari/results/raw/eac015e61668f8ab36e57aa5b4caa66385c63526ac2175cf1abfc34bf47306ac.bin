unks/0p_basg-q0p1-.js\",\"/_next/static/chunks/1lwwx8jp-krrn.js\",\"/_next/static/chunks/23iiadbb3p1c9.js\",\"/_next/static/chunks/10hu79clk2pnf.js\",\"/_next/static/chunks/3g6_ydsaj7-hg.js\",\"/_next/static/chunks/2d81991nr3rk-.js\",\"/_next/static/chunks/3s8xiyu-fkuwb.js\",\"/_next/static/chunks/3qzqfxcpcbvj6.js\",\"/_next/static/chunks/2r7_04vsoofvi.js\",\"/_next/static/chunks/1t4a000tb02ow.js\",\"/_next/static/chunks/29ezhxar8nl2r.js\",\"/_next/static/chunks/2cc1u1-zav_8s.js\"],\"TestimonialCarousel\",1]\n27:[\"$\",\"$L34\",\"6a29eadaa160e700198597ca\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a29eadaa160e700198597ca\",\"isHidden\":false,\"label\":\"29 UNICORNS \u0026 COUNTING\",\"labelAppearance\":\"phosphor\",\"useAllUnicorns\":true,\"speed\":\"slow\",\"pauseOnHover\":true,\"blockName\":\"Unicorn banner\",\"blockType\":\"unicornTicker\",\"unicorns\":[]}]\n28:[\"$\",\"$L35\",\"6ab4042244ab59545e6990bb\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6ab4042244ab59545e6990bb\",\"isHidden\":false,\"heading\":\"Techstars Network Highlights\",\"subheading\":\"The latest news from across the Techstars network.\",\"bgColor\":\"light-gray\",\"source\":\"custom\",\"mode\":\"recent\",\"limit\":3,\"tagMatch\":\"any\",\"nameQuery\":null,\"sourceField\":null,\"blockName\":null,\"items\":[{\"id\":\"6ab405d044ab59545e6990bc\",\"imageAsset\":null,\"imageUrl\":\"https://cdn.bfldr.com/CBWQP80B/at/cg3r5x7qmf76pc4tpx3cbjvr/TS_techstars_TIME_rank_blog_1.png?format=png\",\"title\":\"Techstars Is No. 1 on TIME and Statista's 2026 Accelerator List\",\"description\":null,\"link\":\"/newsroom/techstars-is-no-1-on-time-and-statista-s-2026-accelerator-list\"},{\"id\":\"6ab4065644ab59545e6990bd\",\"imageAsset\":null,\"imageUrl\":\"https://cdn.bfldr.com/CBWQP80B/at/hw5stgt8qngm48w7cj65/Inc_5000_2026.png?format=png\",\"title\":\"22 Techstars Portfolio Companies Named to the 2026 Inc. 5000\",\"description\":null,\"link\":\"/blog/startup-spotlight/22-techstars-portfolio-companies-named-to-the-2026-inc-5000\"},{\"id\":\"6ab4069644ab59545e6990be\",\"imageAsset\":null,\"imageUrl\":\"https://cdn.bfldr.com/CBWQP80B/at/bj3nbb8nrtmssj4ffcp8khf/zipline_uber_graphic.png?format=png\",\"title\":\"Your Burrito Just Got Wings: Uber and Zipline Are Taking Delivery to the Sky\",\"description\":null,\"link\":\"/blog/startup-spotlight/your-burrito-just-got-wings-uber-and-zipline-are-taking-delivery-to-the-sky\"}],\"blockType\":\"postsCarousel\",\"headingFlair\":{\"showUnderscore\":false,\"glow\":true},\"viewAllCta\":{\"label\":null,\"href\":null,\"appearance\":null},\"tags\":[],\"posts\":[]}]\n29:[\"$\",\"$L36\",\"6a29eadaa160e700198597ce\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a29eadaa160e700198597ce\",\"isHidden\":false,\"label\":\"ABOUT TECHSTARS\",\"eyebrowColor\":\"phosphor\",\"heading\":\"Backing Ambitious Founders Since 2006\",\"body\":\"Techstars is the accelerator and investor for founders who do more faster. Since 2006, we've backed the world's most promising early-stage startups, and today every company gets $220K in capital, three months of relentless hands-on mentorship, and a network of investors, operators, and corporate partners that keeps opening doors for years. With programs in the world's leading startup hubs and across specialized verticals, we take founders from first check to global scale. The proof: a portfolio worth more than $300 billion, built by unicorns and thousands of high-growth companies still writing their stories.\",\"ctaLabel\":\"Learn more\",\"ctaHref\":\"/about\",\"ctaAppearance\":\"greyOutline\",\"bgColor\":\"white\",\"flipLayout\":false,\"videoUrl\":\"https://youtu.be/vfTYYdWfBx4\",\"videoTitle\":\"About Techstars\",\"blockName\":\"About and video\",\"blockType\":\"textVideo\"}]\n2a:[\"$\",\"$L37\",\"6a29eadaa160e700198597d3\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a29eadaa160e700198597d3\",\"isHidden\":false,\"label\":\"OUR IMPACT\",\"eyebrowColor\":\"phosphor\",\"heading\":\"The Backbone of the Techstars Network\",\"body\":\"The Techstars network is one of the most powerful assets a founder can access. Beyond the numbers, it's a global community of mentors, investors, and alumni who understand the journey and know how to help navigate it. Our mentors are seasoned executives and builders who work alongside founders at every stage, helping them navigate challenges, sharpen their thinking, and move faster than they could alone. With thousands of companies across the portfolio, the connections made here open doors long after the accelerator ends.\",\"ctaLabel\":\"Learn more\",\"ctaHref\":\"/portfolio\",\"ctaAppearance\":\"greyOutline\",\"bgColor\":\"light-gray\",\"flipLayout\":false,\"animateValues\":false,\"blockName\":\"Impact and stats\",\"stats\":[{\"id\":\"6a29eadaa160e700198597cf\",\"value\":\"{foundersCount}\",\"statLabel\":\"Founders Building the Future\",\"color\":\"green\"},{\"id\":\"6a29eadaa160e700198597d0\",\"value\":\"{unicornCount}\",\"statLabel\":\"Unicorns and Counting\",\"color\":\"dark-green\"},{\"id\":\"6a29eadaa160e700198597d1\",\"value\":\"{totalRaisedB}\",\"statLabel\":\"Capital Raised\",\"color\":\"charcoal\"},{\"id\":\"6a29eadaa160e700198597d2\",\"value\":\"{combinedMcapB}\",\"statLabel\":\"Combined Market Cap\",\"color\":\"black\"}],\"blockType\":\"statsProof\"}]\n2b:[\"$\",\"$L38\",\"6a4d5e6126b8351a13b09e88\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a4d5e6126b8351a13b09e88\",\"isHidden\":false,\"eyebrow\":\"\",\"heading\":\"Your Advantage. Worldwide.\",\"lead\":\"Connect to a global collective built for your success. From local hubs to industry-specific powerhouses, we ensure you have the people and the capital required to scale your vision in any market.\",\"mapHref\":\"/locations\",\"blockName\":null,\"pills\":[{\"id\":\"6a4d5e62e787220001511977\",\"label\":\"Accelerators\",\"tone\":\"success\"},{\"id\":\"6a4d5e62e787220001511978\",\"label\":\"Founder Catalyst\",\"tone\":\"neutral\"},{\"id\":\"6a4d5e62e787220001511979\",\"label\":\"Startup Community Partnerships\",\"tone\":\"primary\"},{\"id\":\"6a4d5e62e78722000151197a\",\"label\":\"Startup Weekend \u0026 Startup Week\",\"tone\":\"info\"}],\"blockType\":\"globalNetworkMap\",\"headingFlair\":{\"showUnderscore\":false,\"glow\":true}}]\n2c:[\"$\",\"$L39\",\"6a29eadaa160e700198597ef\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a29eadaa160e700198597ef\",\"isHidden\":false,\"overline\":\"\",\"eyebrowColor\":\"phosphor\",\"heading\":\"Highlighted Verticals\",\"description\":\"Sectors where regulatory moats, physical infrastructure, and proprietary data make replication incredibly difficult.\",\"bgColor\":\"black\",\"source\":\"verticals\",\"blockName\":\"Vertical Accelerators\",\"items\":[],\"blockType\":\"linkedCardCarousel\",\"headingFlair\":{\"showUnderscore\":false,\"glow\":true},\"viewAllCta\":{\"label\":null,\"href\":null,\"appearance\":null}}]\n2d:[\"$\",\"$L39\",\"6a29eadaa160e700198597f0\",{\"ctx\":\"$5:0:props:ctx\",\"id\":\"6a29eadaa160e700198597f0\",\"isHidden\":false,\"overline\":\"\",\"eyebrowColor\":\"phosphor\",\"heading\":\"Accelerators\",\"description\":\"High-performance markets designed to accelerate growth\\nthrough regional density and global network access.\",\"bgColor\":\"white\",\"source\":\"offices\",\"blockName\":\"City Accelerators\",\"items\":[],\"blockType\":\"linkedCardCarousel\",\"headingFlair\":{\"showUnderscore\":false,\"glow\":true},\"viewAllCta\":{\"label\":null,\"href\":null,\"appearance\":null}}]\n2e:[\"$\",\"$L3a\",\"6a29eadaa160e700198597cd\",{\"id\":\"6a29eadaa160e700198597cd\",\"isHidden\":false,\"sectionLabel\":\"Techstars Portfolio Companies\",\"autoplay\":true,\"blockName\":\"Portfolio slider\",\"slides\":[{\"id\":\"6a29eadaa160e700198597cb\",\"backgroundImageAsset\":{\"id\":629,\"title\":\"Chainalysis - Techstars Portfolio Company - Stories Carousel\",\"alt\":\"Chainalysis - Techstars Portfolio Company\",\"brandfolderRef\":\"{\\\"attachmentId\\\":\\\"wv4mcsz4545c8c7bzwx6pcj\\\",\\\"cdnUrl\\\":\\\"https://cdn.bfldr.com/70W92OEX/as/8crb8tx35mvw3krjk6p5k29/Chai