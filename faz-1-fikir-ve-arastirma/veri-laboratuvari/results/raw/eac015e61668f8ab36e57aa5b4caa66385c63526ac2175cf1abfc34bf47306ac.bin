f/zipline_uber_graphic.png?format=png&amp;width=1920&amp;auto=webp 1920w, https://cdn.bfldr.com/CBWQP80B/at/bj3nbb8nrtmssj4ffcp8khf/zipline_uber_graphic.png?format=png&amp;width=2048&amp;auto=webp 2048w, https://cdn.bfldr.com/CBWQP80B/at/bj3nbb8nrtmssj4ffcp8khf/zipline_uber_graphic.png?format=png&amp;width=3840&amp;auto=webp 3840w" src="https://cdn.bfldr.com/CBWQP80B/at/bj3nbb8nrtmssj4ffcp8khf/zipline_uber_graphic.png?format=png&amp;width=3840&amp;auto=webp"/></div><div class="MuiStack-root mui-vxfgcs"><h3 class="MuiTypography-root MuiTypography-h5 mui-1w19x9c">Your Burrito Just Got Wings: Uber and Zipline Are Taking Delivery to the Sky</h3><span class="MuiTypography-root MuiTypography-body2 pc-cta mui-4g41zu">Read More</span></div></a></div></div></div></section><section aria-label="Backing Ambitious Founders Since 2006" sx="[object Object]" class="mui-mu9hq7"><div class="MuiContainer-root MuiContainer-maxWidthLg mui-196mcor"><div class="MuiBox-root mui-1dyo6aa"><div class="MuiStack-root mui-87ncr7"><span class="MuiTypography-root MuiTypography-overline mui-zaimnn">ABOUT TECHSTARS</span><h2 class="MuiTypography-root MuiTypography-h1 mui-wzqkt">Backing Ambitious Founders Since 2006</h2><p class="MuiTypography-root MuiTypography-body1 mui-1f70dg2">Techstars is the accelerator and investor for founders who do more faster. Since 2006, we&#x27;ve backed the world&#x27;s most promising early-stage startups, and today every company gets $220K in capital, three months of relentless hands-on mentorship, and a network of investors, operators, and corporate partners that keeps opening doors for years. With programs in the world&#x27;s leading startup hubs and across specialized verticals, we take founders from first check to global scale. The proof: a portfolio worth more than $300 billion, built by unicorns and thousands of high-growth companies still writing their stories.</p><div class="MuiBox-root mui-0"><a class="MuiButtonBase-root MuiButton-root MuiButton-grey-outline MuiButton-grey-outlinePrimary MuiButton-sizeMedium MuiButton-grey-outlineSizeMedium MuiButton-colorPrimary MuiButton-root MuiButton-grey-outline MuiButton-grey-outlinePrimary MuiButton-sizeMedium MuiButton-grey-outlineSizeMedium MuiButton-colorPrimary mui-11fy49l" tabindex="0" href="/about">Learn more</a></div></div><div class="MuiBox-root mui-12qt04s"><button class="MuiBox-root mui-pip822" aria-label="Play: About Techstars"><img alt="" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 900px) 100vw, 58vw" srcSet="/_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fimg.youtube.com%2Fvi%2FvfTYYdWfBx4%2Fmaxresdefault.jpg&amp;w=3840&amp;q=75"/><div class="MuiBox-root mui-cd05ln" aria-hidden="true"></div><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium play-icon mui-mjxaay" focusable="false" aria-hidden="true" viewBox="0 0 24 24"><path d="m10 16.5 6-4.5-6-4.5zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8"></path></svg></button></div></div></div></section><section aria-label="The Backbone of the Techstars Network" sx="[object Object]" class="mui-bkavui"><div class="MuiContainer-root MuiContainer-maxWidthLg mui-196mcor"><div class="MuiBox-root mui-15nwci"><div class="MuiBox-root mui-1d00m2e"><div class="MuiBox-root mui-kqxuul"><span class="MuiTypography-root MuiTypography-h1 mui-a8h4qv">11,061</span><span class="MuiTypography-root MuiTypography-body2 mui-6k62n1">Founders Building the Future</span></div><div class="MuiBox-root mui-obmu6u"><span class="MuiTypography-root MuiTypography-h1 mui-1c8lky3">29</span><span class="MuiTypography-root MuiTypography-body2 mui-1qsaycq">Unicorns and Counting</span></div><div class="MuiBox-root mui-166pau"><span class="MuiTypography-root MuiTypography-h1 mui-1c8lky3">$56B</span><span class="MuiTypography-root MuiTypography-body2 mui-ydvn0k">Capital Raised</span></div><div class="MuiBox-root mui-nwmd31"><span class="MuiTypography-root MuiTypography-h1 mui-9tu116">$345B</span><span class="MuiTypography-root MuiTypography-body2 mui-asezhf">Combined Market Cap</span></div></div><div class="MuiStack-root mui-87ncr7"><span class="MuiTypography-root MuiTypography-overline mui-zaimnn">OUR IMPACT</span><h2 class="MuiTypography-root MuiTypography-h1 mui-wzqkt">The Backbone of the Techstars Network</h2><p class="MuiTypography-root MuiTypography-body1 mui-1f70dg2">The Techstars network is one of the most powerful assets a founder can access. Beyond the numbers, it&#x27;s a global community of mentors, investors, and alumni who understand the journey and know how to help navigate it. Our mentors are seasoned executives and builders who work alongside founders at every stage, helping them navigate challenges, sharpen their thinking, and move faster than they could alone. With thousands of companies across the portfolio, the connections made here open doors long after the accelerator ends.</p><div class="MuiBox-root mui-0"><a class="MuiButtonBase-root MuiButton-root MuiButton-grey-outline MuiButton-grey-outlinePrimary MuiButton-sizeMedium MuiButton-grey-outlineSizeMedium MuiButton-colorPrimary MuiButton-root MuiButton-grey-outline MuiButton-grey-outlinePrimary MuiButton-sizeMedium MuiButton-grey-outlineSizeMedium MuiButton-colorPrimary mui-11fy49l" tabindex="0" href="/portfolio">Learn more</a></div></div></div></div></section><section aria-label="Your Advantage. Worldwide." sx="[object Object]" class="mui-mu9hq7"><div class="MuiContainer-root MuiContainer-maxWidthLg mui-196mcor"><div class="MuiStack-root mui-1nsc5nr"><div class="MuiStack-root mui-ssfk4p"><div class="MuiStack-root mui-1vw6whb"><h2 class="MuiTypography-root MuiTypography-h2 mui-17z63dh">Your Advantage. Worldwide.</h2><p class="MuiTypography-root MuiTypography-body1 mui-1u1mfzg">Connect to a global collective built for your success. From local hubs to industry-specific powerhouses, we ensure you have the people and the capital required to scale your vision in any market.</p></div></div><div class="MuiStack-root mui-100ejw7"><div class="MuiChip-root MuiChip-filled MuiChip-sizeMedium MuiChip-colorDefault MuiChip-filledDefault mui-1c0x9ri"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall MuiChip-icon MuiChip-iconMedium MuiChip-iconColorDefault mui-vh810p" focusable="false" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7m0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5"></path></svg><span class="MuiChip-label MuiChip-labelMedium mui-s01idy">Accelerators</span></div><div class="MuiChip-root MuiChip-filled MuiChip-sizeMedium MuiChip-colorDefault MuiChip-filledDefault mui-jnya0r"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall MuiChip-icon MuiChip-iconMedium MuiChip-iconColorDefault mui-vh810p" focusable="false" aria-hidden="