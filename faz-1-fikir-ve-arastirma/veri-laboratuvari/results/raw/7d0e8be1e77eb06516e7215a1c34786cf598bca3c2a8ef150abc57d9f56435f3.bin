    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    will-change: opacity;
    z-index: 2147483646;
    backdrop-filter: blur(8px);
    background-color: #00000014;
    position: fixed;
    inset: 0%;
    height: 100vh;
  }

  [js-modal~="globalForm"].isActive
  [data-class~="form-blur-background"] {
    opacity: 1;
  }

  [js-modal~="globalForm"]
  [data-class~="form-popup-container"] {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    will-change: opacity;
