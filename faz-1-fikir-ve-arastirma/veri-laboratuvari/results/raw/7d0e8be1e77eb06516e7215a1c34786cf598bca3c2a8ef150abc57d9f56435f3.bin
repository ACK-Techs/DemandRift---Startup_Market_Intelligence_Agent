<input type="hidden" id="customerIoAnonymousId" data-name="cio_anonymous_id" value="">
<input type="hidden" data-name="lead_source_site" value="reviews.io"></div><div class="apphub-sites--g-stack-l apphub-sites--stack-l"><div class="apphub-sites--field"><label for="email" class="apphub-sites--custom-field-label apphub-sites--stack-xs">Enter your email address</label><input class="apphub-sites--c-google-playbook-form-input apphub-sites--c-google-form w-input" maxlength="256" name="email" data-name="email" placeholder="firstname@yourcompany.com" type="email" id="email" required=""/></div></div><div class="apphub-sites--clr-space-small"></div><input type="submit" data-wait="Please wait..." class="apphub-sites--clr-button--primary apphub-sites--full-width w-button" value="Download now"/></form></div><div class="apphub-sites--clr-display--none w-embed w-script"><script type="text/plain" data-categories="analytics">
  // Config
  var INPUT_SELECTOR = '[data-name="cio_anonymous_id"]';
  var POLL_INTERVAL_MS = 500; // how often to check
  var MAX_WAIT_MS = 30000; // stop after 30s

  // State
  var timeWaited = 0;
  var pollTimer = setInterval(setCustomerioAnonymousId, POLL_INTERVAL_MS);

  function setCustomerioAnonymousId() {
    if (timeWaited >= MAX_WAIT_MS) {
      clearInterval(pollTimer);
      console.warn(
        "Customer.io anonymous ID not set within " + MAX_WAIT_MS / 1000 + "s."
      );
      return;
    }
    timeWaited += POLL_INTERVAL_MS;

    var customerioInputField = document.querySelector(INPUT_SELECTOR);
    if (!customerioInputField) return;

    var analyticsAvailable =
      window.cioanalytics &&
      typeof window.cioanalytics.user === "function" &&
      typeof window.cioanalytics.user().anonymousId === "function";
    if (!analyticsAvailable) return;

    var customerioAnonymousId = window.cioanalytics.user().anonymousId();
    if (!customerioAnonymousId) return;

    customerioInputField.value = customerioAnonymousId;
    clearInterval(pollTimer);
  }
</script></div></div><div class="apphub-sites--relative"><img loading="lazy" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/69b3e9381e97700814329dda_1608ae8c741cccad2f346ee8daae32f1_graphic-growth-playbook.webp" alt="" class="apphub-sites--c-form-image"/><img loading="lazy" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/69b3df963044e46c0dd45e73_cefbd366eae8ef0900afb5e040bb7664_graphic-playbook-blur.svg" alt="" class="apphub-sites--form-underlay-img"/></div></div><img data-class="close-icon" loading="lazy" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/69b3df963044e46c0dd45e72_a94b16db5ff11bbd2fe9b6c85b82847f_thin-close.svg" class="apphub-sites--c-close-icon"/><div hide-modal="set" data-class="message-block-container" class="apphub-sites--c-redirect-container"><div class="apphub-sites--c-fullwidth-section__bg--reviews"></div><div hide-modal="set" data-class="success-container" class="apphub-sites--c-form-countdown-container"><img loading="lazy" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/69b3df963044e46c0dd45e71_714c24762f1bbf9e5f53dd3ed629bbdb_icon-circled-checkmark--md--colour.svg" alt="" class="apphub-sites--c-form-success-checkmark"/><div class="apphub-sites--clr-space-xsmall"></div><div class="apphub-sites--clr-heading-xsmall apphub-sites--clr-text-align-center">Your Playbook is on its way to your email inbox. It should arrive in the next few minutes.</div></div></div></div><div class="apphub-sites--clr-display--none w-embed"><style>
