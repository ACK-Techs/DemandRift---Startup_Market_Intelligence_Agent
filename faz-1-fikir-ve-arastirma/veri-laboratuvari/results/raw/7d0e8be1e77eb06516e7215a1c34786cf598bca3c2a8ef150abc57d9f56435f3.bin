  .ai-insights-nav-button,
  .ai-insights-nav-button * {
    box-sizing: border-box;
  }

  .ai-insights-nav-button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 12px 15px;
    border: 0;
    border-radius: 0.5rem;
    font: inherit;
    text-decoration: none;
    background: linear-gradient(135deg, #031616 0%, #042527 42%, #053843 100%);
    box-shadow: 0 10px 24px rgba(0, 120, 130, 0.18);
  }

  .ai-insights-nav-button::before,
  .ai-insights-nav-button::after {
    content: '';
    position: absolute;
    inset: -40%;
    z-index: 0;
    border-radius: 50%;
    filter: blur(56px);
    pointer-events: none;
  }

  .ai-insights-nav-button::before {
    background: radial-gradient(circle, rgba(26, 230, 220, 0.58) 0%, rgba(26, 230, 220, 0) 70%);
    animation: aiAuroraOne 6s ease-in-out infinite alternate;
  }

  .ai-insights-nav-button::after {
    background: radial-gradient(circle, rgba(16, 67, 112, 0.54) 0%, rgba(16, 67, 112, 0) 70%);
    animation: aiAuroraTwo 8s ease-in-out infinite alternate;
  }

  .ai-aurora-wave {
    position: absolute;
    left: -20%;
    top: 40%;
    z-index: 0;
    width: 140%;
    height: 100px;
    background: linear-gradient(90deg, transparent, rgba(34, 241, 230, 0.15), transparent);
    filter: blur(22px);
    transform: rotate(-8deg);
    animation: aiWaveFlow 9s ease-in-out infinite;
    pointer-events: none;
  }

  .ai-edge-glare {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(34, 241, 230, 0.72), rgba(34, 241, 230, 0.32) 24%, rgba(255, 255, 255, 0.13) 40%, transparent 72%) top left / 100% 1px no-repeat,
      linear-gradient(180deg, rgba(34, 241, 230, 0.48), rgba(34, 241, 230, 0.16) 38%, transparent 76%) top left / 1px 100% no-repeat,
      radial-gradient(80% 100% at 0% 0%, rgba(34, 241, 230, 0.2), transparent 58%);
    opacity: 0.95;
  }

  .ai-edge-glare::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 8%;
    width: 46%;
    height: 5px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), rgba(34, 241, 230, 0.68), transparent);
    filter: blur(3px);
    opacity: 0.72;
    animation: aiEdgeGlow 4.6s ease-in-out infinite;
  }

  .ai-edge-glare::after {
    content: '';
    position: absolute;
    right: 10%;
    bottom: 0;
    width: 36%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(34, 241, 230, 0.32), transparent);
    opacity: 0.36;
  }

  .ai-insights-icon,
  .ai-insights-copy {
    position: relative;
    z-index: 2;
  }

  .ai-insights-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    transform: translateY(-3px);
  }

  .ai-insights-icon svg {
    width: 34px;
    height: 34px;
    overflow: visible;
  }

  .ai-spark {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation-duration: 3s;
    animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    animation-iteration-count: infinite;
  }

  .ai-spark-1 {
    animation-name: aiSparkOne;
  }
  .ai-spark-2 {
    animation-name: aiSparkTwo;
  }
  .ai-spark-3 {
    animation-name: aiSparkThree;
  }
  .ai-spark-4 {
    animation-name: aiSparkFour;
  }

  .ai-connection-glow,
  .ai-connection-line {
    stroke-dasharray: 70;
    stroke-dashoffset: 70;
    opacity: 0;
  }

  .ai-connection-glow {
    animation: aiConnectionGlow 3s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .ai-connection-line {
    animation: aiConnectionLine 3s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .ai-bar {
    transform-origin: bottom;
    transform-box: fill-box;
    opacity: 0;
    animation-duration: 3s;
    animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    animation-iteration-count: infinite;
  }

  .ai-bar-1 {
    animation-name: aiBarOne;
  }
  .ai-bar-2 {
    animation-name: aiBarTwo;
  }
  .ai-bar-3 {
    animation-name: aiBarThree;
  }
  .ai-bar-4 {
    animation-name: aiBarFour;
  }

  .ai-insights-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .ai-insights-heading-row {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .ai-insights-title {
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }

  .ai-insights-subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ai-insights-badge {
    flex: 0 0 auto;
    padding: 3px 7px;
    border-radius: 999px;
    background: #20f0e6;
    color: #05302e;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
  }

  @keyframes aiAuroraOne {
    0% {
      transform: translate(-20%, -10%) scale(1);
    }
    50% {
      transform: translate(14%, 12%) scale(1.35);
    }
    100% {
