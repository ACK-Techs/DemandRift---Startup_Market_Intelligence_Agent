<!-- DISABLE WEBFLOW FORM SUCCESS WINDOW -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const forms = document.querySelectorAll('[ms-code-form="form"]');
    const successEls = document.querySelectorAll('[ms-code-success="true"]');

    if (!forms.length || !successEls.length) return;

    forms.forEach((form, index) => {
      const successEl = successEls[index];
      if (!successEl) return;

      const observer = new MutationObserver(() => {
        const isVisible = window.getComputedStyle(successEl).display !== 'none';
        if (isVisible) {
          successEl.style.display = 'none';
          form.style.display = 'block';
        }
      });

      observer.observe(successEl, { attributes: true, attributeFilter: ['style'] });

      // Cleanup observer when done (optional, for performance)
      form.addEventListener('w-form-success', () => {
        setTimeout(() => {
          observer.disconnect();
        }, 100);
      });
    });
  });
</script>

<script>
  Webflow.push(function () {
    $("#wf-form-Shopify-ebook-Form").submit(function (event) {
      event.preventDefault();
      const emailEl = document.querySelector('[data-name="email"]');
      const email = emailEl ? emailEl.value ?? emailEl.textContent.trim() : "";
      const anonCioId = document.querySelector('[data-name="cio_anonymous_id"]');
      const cioId = anonCioId ? anonCioId.value ?? anonCioId.textContent.trim() : "";
      if (email) {
        fetch("https://hook.eu1.make.com/frwm1hv0lchs6agu43fvdd6r8rv6rth4", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, cio_anonymous_id: cioId }),
        })
          .then((response) => response.text())
          .then((data) => {
            if (data.trim() === "true") {
              // Select relevant elements
              const gridContainer = document.querySelector(
                '[data-class~="form-grid-container"]'
              );
              const popupContainer = document.querySelector(
                '[data-class~="message-block-container"]'
              );
              const successContainer = document.querySelector(
                '[data-class~="success-container"]'
              );

              if (!gridContainer || !popupContainer) return;

              // 1️⃣ Hide the form grid
              gridContainer.classList.add("display-none");

              // 2️⃣ Show the message block container with fade-in
              popupContainer.classList.remove("display-none");
              requestAnimationFrame(() => {
                popupContainer.classList.add("full-opacity");
              });

              // 3️⃣ Immediately show the success container (no PDF open)
              successContainer.classList.remove("display-none");
            }
          })
          .catch((err) => {
            console.warn("Webhook POST error:", err);
          });
      }
    });
  });
</script><script>
    // Cookie utility functions
    function setCookie(cname, cvalue, exdays) {
        var d = new Date();
        d.setTime(d.getTime() + (exdays*24*60*60*1000));
        var expires = "expires="+ d.toUTCString();
        document.cookie = cname + "=" + cvalue + "; " + expires + "; path=/";
    }

    function getCookie(cname) {
        var name = cname + "=";
        var ca = document.cookie.split(';');
        
        for(var i = 0; i <ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0)==' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length,c.length);
            }
        }
        return "";
    }

    // Function to hide chat/intercom widgets for blacklisted users
    function hideChatWidgets() {
        let hideChatInterval = setInterval(function() {
            if (window.Intercom) {
                window.Intercom('shutdown');
                document.querySelector('.rio-intercom-trigger__button').style.display = 'none';
                clearInterval(hideChatInterval);
            }
        }, 500);
    
    }
    
    if (getCookie('user_blacklisted') === 'true') {
        hideChatWidgets();
    }
</script></body></html>