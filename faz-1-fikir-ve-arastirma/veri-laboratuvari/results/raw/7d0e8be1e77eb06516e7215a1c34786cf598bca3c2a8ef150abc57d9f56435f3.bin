</style></div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  document.addEventListener("DOMContentLoaded", function () {
    const OPEN_SELECTOR = '[data-class~="js-open-popup-form"][form-type~="global-playbook"]';
    const CONTAINER_SELECTOR = '[js-modal~="globalForm"][form-type~="global-playbook"]';
    const CLOSE_SELECTOR = '[data-class~="close-icon"]';
    const BG_SELECTOR = '[data-class~="form-blur-background"]';

    const container = document.querySelector(CONTAINER_SELECTOR);
    if (!container) {
      return;
    }

    // --- SCROLL LOCK HELPERS ---
    function lockScroll() {
      document.documentElement.classList.add("scroll-locked");
      document.body.classList.add("scroll-locked");
    }
    function unlockScroll() {
      document.documentElement.classList.remove("scroll-locked");
      document.body.classList.remove("scroll-locked");
    }

    // Utility to create the blur background element (appended to body)
    function createBlurBackground() {
      let bg = document.querySelector(`${BG_SELECTOR}.c-form-wrapper-blur`);
      if (!bg) {
        bg = document.createElement("div");
        bg.className = "c-form-wrapper-blur";
        bg.setAttribute("data-class", "form-blur-background");
        document.body.appendChild(bg);
        // Force reflow to ensure opacity transition works
        void bg.offsetWidth;
        // start fade-in transition
        requestAnimationFrame(() => {
          bg.style.opacity = "1";
        });
      }
      return bg;
    }

    // Removes the blur background element from DOM (with fade-out)
    function removeBlurBackground() {
      const bg = document.querySelector(`${BG_SELECTOR}.c-form-wrapper-blur`);
      if (!bg) {
        return;
      }

      bg.style.opacity = "0";

      const onBgEnd = (e) => {
        if (e.target === bg && e.propertyName === "opacity") {
          if (bg.parentNode) {
            bg.parentNode.removeChild(bg);
          }
          bg.removeEventListener("transitionend", onBgEnd);
        }
      };
      bg.addEventListener("transitionend", onBgEnd, { once: true });

      // fallback
      setTimeout(() => {
        if (bg.isConnected) {
          bg.parentNode && bg.parentNode.removeChild(bg);
        }
      }, 350);
    }

    // --- OPEN HANDLER ---
    function openPopup(evt) {
      if (evt) evt.preventDefault();

      // Step 0: Create the blur background before showing popup
      createBlurBackground();

      // Step 1: Add display-block
      if (!container.classList.contains("display-block")) {
        container.classList.add("display-block");
      }

      // Step 2: Wait for style application, then add isActive
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          container.classList.add("isActive");
          lockScroll();
        });
      });
    }

    // --- CLOSE HANDLER ---
    function closePopup(evt) {
      if (evt) evt.preventDefault();
      if (!container.classList.contains("display-block")) {
        return;
      }

      container.classList.remove("isActive");
      removeBlurBackground();

      const handleEnd = (e) => {
        if (e.target === container && e.propertyName === "opacity") {
          container.classList.remove("display-block");
          container.removeEventListener("transitionend", handleEnd);
          unlockScroll();
        }
      };

      container.addEventListener("transitionend", handleEnd, { once: true });

      // fallback
      setTimeout(() => {
        if (!container.classList.contains("isActive")) {
          container.classList.remove("display-block");
          unlockScroll();
        }
      }, 350);
    }

    // --- BIND OPEN BUTTONS ---
    const openButtons = document.querySelectorAll(OPEN_SELECTOR);
    openButtons.forEach((el) => el.addEventListener("click", openPopup));

    // --- BIND CLOSE ICON ---
    container.addEventListener("click", (evt) => {
      const closeEl = evt.target.closest(CLOSE_SELECTOR);
      if (closeEl && container.contains(closeEl)) {
        closePopup(evt);
      }
    });

    // --- OPTIONAL: expose helpers ---
    window.PopupForm = { open: openPopup, close: closePopup };
  });
</script></div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  document.addEventListener('DOMContentLoaded', function () {
    const PARAM = 'show_form';
    const OPEN_SELECTOR = '[data-class~="js-open-popup-form"]';

    function getShowFormParam() {
      const params = new URLSearchParams(window.location.search);
      return params.get(PARAM);
    }

    function getOpenTriggers() {
      return Array.from(document.querySelectorAll(OPEN_SELECTOR));
    }

    function getFormTypesFromTrigger(trigger) {
      const formTypes = trigger.getAttribute('form-type') || '';
      return formTypes.split(/\s+/).filter(Boolean);
    }

    function getUniqueFormTypes(triggers) {
      const uniqueFormTypes = new Set();

      triggers.forEach((trigger) => {
        getFormTypesFromTrigger(trigger).forEach((formType) => {
          uniqueFormTypes.add(formType);
        });
      });

      return Array.from(uniqueFormTypes);
    }

    function triggerOpen(trigger) {
      if (!trigger) {
        return;
      }

      const event = new MouseEvent('click', {
        bubbles: true,
        cancelable: true,
        view: window,
      });

      trigger.dispatchEvent(event);
    }

    function waitForTriggerAndOpen(showFormValue, deadline = performance.now() + 3000) {
      const triggers = getOpenTriggers();

      if (triggers.length) {
        // Backwards-compatible behaviour:
        // ?show_form=true opens only when there is one unique form-type on the page.
        if (showFormValue === 'true') {
          const uniqueFormTypes = getUniqueFormTypes(triggers);

          if (uniqueFormTypes.length === 1) {
            const target = triggers.find((trigger) => {
              return getFormTypesFromTrigger(trigger).includes(uniqueFormTypes[0]);
            });

            triggerOpen(target);
          }

          return;
        }

        // Targeted behaviour:
        // ?show_form=global-playbook opens only matching form-type.
        const target = triggers.find((trigger) => {
          return getFormTypesFromTrigger(trigger).includes(showFormValue);
        });

        if (target) {
          triggerOpen(target);
        }

        return;
      }

      if (performance.now() < deadline) {
        requestAnimationFrame(() => waitForTriggerAndOpen(showFormValue, deadline));
      }
    }

    function maybeOpen() {
      const showFormValue = getShowFormParam();

      if (showFormValue) {
        waitForTriggerAndOpen(showFormValue);
      }
    }

    // Wait one tick so other DOMContentLoaded handlers can bind their click listeners first.
    setTimeout(maybeOpen, 0);
  });
</script></div><div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('#wf-form-Global-Playbook-Form');
    if (!form) return;

    const turnstileSiteKey = '0x4AAAAAADevD7ApwBRpj1ns';

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const emailEl = form.querySelector('[data-name="email"]');
      const email = emailEl ? (emailEl.value ?? emailEl.textContent ?? '').trim() : '';

      const anonCioIdEl = form.querySelector('[data-name="cio_anonymous_id"]');
      const cioId = anonCioIdEl ? (anonCioIdEl.value ?? anonCioIdEl.textContent ?? '').trim() : '';

      const leadSourceEl = form.querySelector('[data-name="lead_source_site"]');
      const leadSource = leadSourceEl ? (leadSourceEl.value ?? leadSourceEl.textContent ?? '').trim() : '';

      const turnstileTokenEl = form.querySelector('[name="cf-turnstile-response"]');
      const turnstileToken = turnstileTokenEl ? (turnstileTokenEl.value ?? turnstileTokenEl.textContent ?? '').trim() : '';

      if (!email) return;

      if (!turnstileToken) {
        console.warn('Missing Cloudflare Turnstile token. Add the Turnstile widget inside this form using site key:', turnstileSiteKey);
        return;
      }

      const showSuccessUI = () => {
        const gridContainer = document.querySelector('[data-class~="form-grid-container"]');
        const popupContainer = document.querySelector('[data-class~="message-block-container"]');
        const successContainer = document.querySelector('[data-class~="success-container"]');

        if (!gridContainer || !popupContainer || !successContainer) return;

        // 1️⃣ Hide the form grid
        gridContainer.classList.add('display-none');
        gridContainer.setAttribute('hide-modal', 'set');

        // 2️⃣ Show the message block container with fade-in
        popupContainer.classList.remove('display-none');
        popupContainer.removeAttribute('hide-modal');
        requestAnimationFrame(() => {
          popupContainer.classList.add('full-opacity');
        });

        // 3️⃣ Immediately show the success container (no PDF open)
        successContainer.classList.remove('display-none');
        successContainer.removeAttribute('hide-modal');
      };

      fetch('https://form-helper.clearer.io', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, cio_anonymous_id: cioId, lead_source_site: leadSource, form_type: 'global_leadership', 'cf-turnstile-response': turnstileToken }),
      })
        .catch((err) => {
          console.warn('Webhook POST error:', err);
        })
        .finally(showSuccessUI);
    });
  });
</script></div></div></div></div></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=642419dd2be643c50e400f66" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/js/reviews-io-2.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/js/reviews-io-2.8eb18bfb.ebbb4942a650c36b.js" type="text/javascript" integrity="sha384-hoa+CLMAwDmS/f7G3PTNf2dBHmPr58ap/0XF9pfOMfXh1nSahUq+ODqC6bOJJvDO" crossorigin="anonymous"></script><link
