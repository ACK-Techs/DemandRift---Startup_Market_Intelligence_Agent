<script>
  function geoip(json) {
    function applyGeoClasses() {
      const body = document.body;
      if (!body) return;

      const countryCode = json.country_code;
      const regionString = json.region;
      const timezone = json.timezone;
      const countryCodeElement = document.getElementById('countryCode');
      const classesToAdd = [];

      if (countryCodeElement) {
        countryCodeElement.value = countryCode;
      }

      function sanitizeForClassName(str) {
        return String(str)
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/\s+/g, '-')
          .replace(/[^a-zA-Z0-9-_]/g, '');
      }

      if (timezone) {
        const slashIndex = timezone.indexOf('/');

        if (slashIndex !== -1) {
          classesToAdd.push(sanitizeForClassName(timezone.slice(0, slashIndex)));
        }
      }

      if (countryCode) {
        classesToAdd.push(sanitizeForClassName(countryCode));
      }

      if (regionString) {
        classesToAdd.push(sanitizeForClassName(regionString));
      }

      if (classesToAdd.length) {
        body.classList.add(...classesToAdd);
      }
    }

    if (document.body) {
      applyGeoClasses();
    } else {
      document.addEventListener('DOMContentLoaded', applyGeoClasses, {
        once: true,
      });
    }
  }
</script>
<!-- PAGE SPECIFIC GEOLOCATION CODE END --><script>
  const DEBUG = false;

  function debugLog(...args) {
    if (!DEBUG) return;
    console.log(...args);
  }

  function activateBlockedResources() {
    debugLog("[activateBlockedResources] Starting conversion...");

    const blockedScripts = document.querySelectorAll(
      'script[type="text/plain"][data-categories]:not([data-converted])',
    );

    debugLog(
      `[activateBlockedResources] Found ${blockedScripts.length} blocked scripts`,
    );

    blockedScripts.forEach((oldScript, index) => {
      debugLog(`[script ${index}] Converting`, oldScript);

      const s = document.createElement("script");

      for (const attr of oldScript.attributes) {
        if (attr.name === "type") continue;
        s.setAttribute(attr.name, attr.value);
      }

      const hintedType = oldScript.getAttribute("data-script-type");
      if (hintedType) {
        s.type = hintedType;
        debugLog(`[script ${index}] Applied hinted type: ${hintedType}`);
      }

      if (!oldScript.hasAttribute("src")) {
        s.textContent = oldScript.textContent || "";
        debugLog(`[script ${index}] Inline script detected`);
      } else {
        debugLog(
          `[script ${index}] External script: ${oldScript.getAttribute("src")}`,
        );
      }

      if (oldScript.hasAttribute("set-async")) {
        s.async = true;
        debugLog(`[script ${index}] async enabled`);
      } else {
        s.async = false;
      }

      if (oldScript.hasAttribute("set-defer")) {
        s.defer = true;
        debugLog(`[script ${index}] defer enabled`);
      } else {
        s.defer = false;
      }

      s.setAttribute("data-converted", "true");

      oldScript.replaceWith(s);
      debugLog(`[script ${index}] Replaced and executed`);
    });

    const noscripts = document.querySelectorAll(
      "noscript:not([data-converted])",
    );
    debugLog(
      `[activateBlockedResources] Found ${noscripts.length} <noscript> blocks`,
    );

    noscripts.forEach((noscriptEl, index) => {
      const raw = (noscriptEl.textContent || "").trim();

      if (!raw) {
        debugLog(`[noscript ${index}] Empty, skipping`);
        return;
      }

      if (!raw.includes("data-src=")) {
        debugLog(`[noscript ${index}] No data-src found, skipping`);
        return;
      }

      const wrapper = document.createElement("div");
      wrapper.innerHTML = raw;

      const candidates = wrapper.querySelectorAll("[data-src]");

      if (candidates.length === 0) {
        debugLog(`[noscript ${index}] No candidates after parsing`);
        return;
      }

      debugLog(
        `[noscript ${index}] Found ${candidates.length} elements to convert`,
      );

      const frag = document.createDocumentFragment();

      candidates.forEach((oldEl, i) => {
        const newEl = document.createElement(oldEl.tagName.toLowerCase());

        for (const attr of oldEl.attributes) {
          const name = attr.name === "data-src" ? "src" : attr.name;
          newEl.setAttribute(name, attr.value);
        }

        if (oldEl.textContent && oldEl.textContent.trim()) {
          newEl.textContent = oldEl.textContent;
        }

        debugLog(`[noscript ${index}] Converted element ${i}`, newEl);

        frag.appendChild(newEl);
      });

      noscriptEl.replaceChildren(frag);
      noscriptEl.setAttribute("data-converted", "true");

      debugLog(`[noscript ${index}] Replaced content`);
    });

    debugLog("[activateBlockedResources] Conversion complete");
  }

  function initConsentAndConvert() {
    debugLog("[initConsentAndConvert] Checking consent state...");

    const getConsentState =
      window.Termly && typeof window.Termly.getConsentState === "function"
        ? window.Termly.getConsentState
        : null;

    const consentState = getConsentState ? getConsentState() : null;

    if (consentState) {
      debugLog("[initConsentAndConvert] Consent state:", consentState);

      const denyList = ["do_not_sell"];

      const filteredEntries = Object.entries(consentState).filter(
        ([key]) => !denyList.includes(key),
      );

      const allEnabled = filteredEntries.every(([, value]) => value === true);

      debugLog("[initConsentAndConvert] Filtered consent entries:", filteredEntries);
      debugLog("[initConsentAndConvert] allEnabled:", allEnabled);

      if (allEnabled) {
        debugLog(
          "[initConsentAndConvert] All consent granted -> activating resources",
        );
        activateBlockedResources();
      } else {
        debugLog(
          "[initConsentAndConvert] Consent not fully granted -> skipping",
        );
      }
    } else {
      debugLog(
        "[initConsentAndConvert] No consent system detected -> activating resources",
      );
      activateBlockedResources();
    }
  }

  function onTermlyLoaded() {
    debugLog("[onTermlyLoaded] Triggered");

    if (document.readyState === "loading") {
      debugLog("[onTermlyLoaded] Waiting for DOMContentLoaded");

      document.addEventListener("DOMContentLoaded", initConsentAndConvert, {
        once: true,
      });
    } else {
      debugLog("[onTermlyLoaded] DOM already ready -> running immediately");
      initConsentAndConvert();
    }
  }

  window.activateBlockedResources = activateBlockedResources;
  window.onTermlyLoaded = onTermlyLoaded;
</script>

