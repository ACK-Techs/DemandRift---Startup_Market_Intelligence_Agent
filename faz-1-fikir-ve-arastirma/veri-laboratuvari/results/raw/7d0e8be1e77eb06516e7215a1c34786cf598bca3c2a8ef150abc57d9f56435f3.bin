</style></div><div class="apphub-sites--clr-page-padding"><div class="apphub-sites--clr-container-large"><div class="apphub-sites--clr-u-minheight-3rem"></div><div data-duration-in="400" data-duration-out="200" data-class="clr-reversegridarea__inner" data-current="Tab 1" data-easing="ease" class="apphub-sites--clr-tab-vertical__component apphub-sites--clr-reversegridarea__inner w-tabs"><div data-class="clr-tab-vertical__menu-content" js-animation="anchor-links" id="w-node-f2e8df64-e898-3f5e-d87e-922c7670c2bd-7670c2b4" class="apphub-sites--clr-tab-vertical__menu-content w-tab-menu"><a data-w-tab="Tab 1" data-class="clr-tab-vertical__link" class="apphub-sites--clr-tab-vertical__link w-inline-block w-tab-link w--current"><h3 data-class="" class="apphub-sites--clr-heading-xsmall">30% of Denman&#x27;s revenue affected by reviews</h3><div class="apphub-sites--clr-space-xxsmall"></div><div data-class="tab-spotlight-subheading" class="apphub-sites--clr-text-size-medium">In just a year, Denman has collected over 7,000 reviews and noted that authentic feedback is directly contributing to conversions and sales.</div></a><a data-w-tab="Tab 2" data-class="clr-tab-vertical__link" class="apphub-sites--clr-tab-vertical__link w-inline-block w-tab-link"><h3 class="apphub-sites--clr-heading-xsmall">Boxraw achieved 98% positive reviews</h3><div class="apphub-sites--clr-space-xxsmall"></div><div data-class="tab-spotlight-subheading" class="apphub-sites--clr-text-size-medium">BOXRAW got 350 reviews in the first 30 days, 98% of them positive. Results revealed that displaying UGC increased trust and conversions.</div></a><a data-w-tab="Tab 3" data-class="clr-tab-vertical__link" class="apphub-sites--clr-tab-vertical__link w-inline-block w-tab-link"><h3 class="apphub-sites--clr-heading-xsmall">Hunter &amp; Gather collected 8,000+ product reviews</h3><div class="apphub-sites--clr-space-xxsmall"></div><div data-class="tab-spotlight-subheading" class="apphub-sites--clr-text-size-medium">By combining the power of REVIEWS.io and Klaviyo, Hunter &amp; Gather collected over 8,000 reviews and earned a 4.9-star rating.</div></a></div><div js-animation="tab-content" class="apphub-sites--tabs-content apphub-sites--u-overflow-visible w-tab-content"><div data-w-tab="Tab 1" class="w-tab-pane w--tab-active"><div data-class="clr-tab-vertical__image-wrapper" class="apphub-sites--clr-tab-vertical__image-wrapper"><img data-class="clr-tab-vertical__image__underlay" loading="eager" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade2dc396a59bde7842cbb_graphic-vertical-tabs-blur.svg" class="apphub-sites--clr-tab-vertical__image__underlay"/><img js-animation="animation__target" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade22ae27b0e7f746bb183_graphic-denman.webp" loading="eager" class="apphub-sites--clr-tab-vertical__image"/></div></div><div data-w-tab="Tab 2" class="w-tab-pane"><div data-class="clr-tab-vertical__image-wrapper" class="apphub-sites--clr-tab-vertical__image-wrapper"><img data-class="clr-tab-vertical__image__underlay" loading="eager" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade2dc396a59bde7842cbb_graphic-vertical-tabs-blur.svg" class="apphub-sites--clr-tab-vertical__image__underlay"/><img js-animation="animation__target" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade22a3ccd595e73be1fd5_graphic-boxraw.webp" loading="eager" class="apphub-sites--clr-tab-vertical__image"/></div></div><div data-w-tab="Tab 3" class="w-tab-pane"><div data-class="clr-tab-vertical__image-wrapper" class="apphub-sites--clr-tab-vertical__image-wrapper"><img data-class="clr-tab-vertical__image__underlay" loading="eager" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade2dc396a59bde7842cbb_graphic-vertical-tabs-blur.svg" class="apphub-sites--clr-tab-vertical__image__underlay"/><img js-animation="animation__target" alt="" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67ade22a09bb0e065636c4d6_graphic-hunter.webp" loading="eager" class="apphub-sites--clr-tab-vertical__image"/></div></div></div></div></div></div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  document.addEventListener("DOMContentLoaded", function () {
    const tabContainers = document.querySelectorAll(
      "[data-class~='animated-tab-loop']"
    );
    if (!tabContainers || !tabContainers.length) return;

    tabContainers.forEach((tabContainer) => {
      if (!tabContainer) return;

      const tabMenuContainer = tabContainer.querySelector(
        "[js-animation='anchor-links']"
      );

      let tabTimeout;

      // --- Function to start the tab animation loop ---
      function tabAnimationLoop() {
        if (!tabMenuContainer) return;

        tabTimeout = setTimeout(function () {
          if (!tabMenuContainer) return;

          const currentTab = tabMenuContainer.querySelector(".w--current");
          const nextTab = currentTab ? currentTab.nextElementSibling : null;

          if (nextTab && typeof nextTab.click === "function") {
            nextTab.click();
          } else {
            const firstTab = tabMenuContainer.querySelector(
              ".w-tab-link:first-of-type"
            );
            if (firstTab && typeof firstTab.click === "function") {
              firstTab.click();
            }
          }
        }, 5000);
      }

      // --- Function to stop the tab animation loop ---
      function stopTabAnimationLoop() {
        if (tabTimeout) clearTimeout(tabTimeout);
      }

      // --- Add click event listeners to tab links ---
      if (tabMenuContainer) {
        const tabLinks = tabMenuContainer.querySelectorAll(".w-tab-link");
        if (tabLinks && tabLinks.length) {
          tabLinks.forEach(function (tabLink) {
            if (!tabLink) return;
            tabLink.addEventListener("click", function () {
              stopTabAnimationLoop();
              tabAnimationLoop();
            });
          });
        }
      }

      // --- Intersection Observer to start/stop animation based on visibility ---
      if (tabContainer && typeof IntersectionObserver !== "undefined") {
        try {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry || typeof entry.isIntersecting === "undefined") return;
                if (entry.isIntersecting) {
                  tabAnimationLoop();
                } else {
                  stopTabAnimationLoop();
                }
              });
            },
            {
              root: null,
              threshold: 0.1,
            }
          );

          observer.observe(tabContainer);
        } catch (err) {
          console.error("IntersectionObserver error:", err);
        }
      } else {
        console.warn("Tab menu container or IntersectionObserver not available!");
      }
    });
  });
</script></div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  document.addEventListener("DOMContentLoaded", () => {
    const CONTAINER = '[data-class~="one-tab-active-only"]';
    const LINK_SEL = '[data-class~="clr-tab-vertical__link"]';
    const SUBH_SEL = '[data-class~="tab-spotlight-subheading"]';

    const containers = document.querySelectorAll(CONTAINER);
    if (!containers.length) return;

    containers.forEach((container) => {
      if (!container) return;

      const links = Array.from(container.querySelectorAll(LINK_SEL));
      if (!links.length) return;

      let lastWidth = window.innerWidth;

      function openSubheading(sh) {
        if (!sh) return;
        sh.style.height = sh.scrollHeight + "px";
        sh.style.opacity = "1";
      }

      function closeSubheading(sh) {
        if (!sh) return;
        sh.style.opacity = "0";
        sh.style.height = "0px";
      }

      function sync() {
        if (!container) return;
        const activeLink = container.querySelector(`${LINK_SEL}.w--current`);
        links.forEach((link) => {
          if (!link) return;
          const sh = link.querySelector(SUBH_SEL);
          if (link === activeLink) openSubheading(sh);
          else closeSubheading(sh);
        });
      }

      // Initial run
      sync();

      // Click (wait for Webflow to toggle .w--current)
      links.forEach((link) => {
        if (!link) return;
        link.addEventListener("click", () => setTimeout(sync, 30));
      });

      // --- 🔥 Combined Resize Handling ---
      function handleResize() {
        if (!container) return;
        const active = container.querySelector(`${LINK_SEL}.w--current ${SUBH_SEL}`);
        if (!active) return;

        // Disable transitions only for this measurement
        active.classList.add('is-measuring');

        // Set to auto to get true natural height, then force layout
        active.style.height = 'auto';
        void active.offsetHeight; // reflow

        // Read the real height and lock it back to px
        const rect = active.getBoundingClientRect?.();
        const h = rect ? Math.round(rect.height) : 0;
        active.style.height = h + 'px';

        // Re-enable transitions next frame
        requestAnimationFrame(() => {
          if (!active) return;
          active.classList.remove('is-measuring');
        });
      }

      if (typeof ResizeObserver !== "undefined") {
        const ro = new ResizeObserver(() => {
          if (window.innerWidth !== lastWidth) {
            lastWidth = window.innerWidth;
            handleResize();
          }
        });
        if (document.body) ro.observe(document.body);
      }

      window.addEventListener("load", handleResize);
    });
  });
</script></div><div class="apphub-sites--clr-display--none w-embed w-script"><script>
  (function () {
    document.addEventListener("DOMContentLoaded", function () {
      // --- State ---
      let lockedHeight = null;
      let wrappers = [];
      let underlays = [];
      let imgs = [];

      // --- Helpers ---
      function collectNodes() {
        const containers = Array.from(
          document.querySelectorAll('[js-animation~="tab-menu-container"]')
        );

        wrappers = containers.flatMap((container) =>
          Array.from(
            container.querySelectorAll(
              'div[data-class~="clr-tab-vertical__image-wrapper"]'
            )
          )
        );

        underlays = containers.flatMap((container) =>
          Array.from(
            container.querySelectorAll(
              'img[data-class~="clr-tab-vertical__image__underlay"]'
            )
          )
        );

        imgs = containers.flatMap((container) =>
          Array.from(
            container.querySelectorAll(
              'img[js-animation~="animation__target"]'
            )
          )
        );
      }

      function computeTallestImageHeight() {
        let max = 0;
        imgs.forEach((img) => {
          const h = img.getBoundingClientRect().height;
          if (h > max) max = h;
        });
        return Math.round(max);
      }

      function applyLockedHeight() {
        if (!lockedHeight || lockedHeight <= 0) {
          return;
        }
        wrappers.forEach((wrapper, i) => {
          wrapper.style.minHeight = lockedHeight + "px";
          wrapper.style.maxHeight = lockedHeight + "px";
        });
        underlays.forEach((underlay) => {
          underlay.style.minHeight = lockedHeight + "px";
          underlay.style.maxHeight = lockedHeight + "px";
          underlay.style.height = lockedHeight + "px";
        });
      }

      // Debounced “lock height now” — used on resize-only
      const lockOnNextFrame = (() => {
        let scheduled = false;
        return () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            // Re-collect in case resize changed visibility/flow
            collectNodes();
            const tallest = computeTallestImageHeight();
            lockedHeight = tallest > 0 ? tallest : lockedHeight;
            applyLockedHeight();
          });
        };
      })();

      // --- Initial collect & first lock (once images are ready or on first resize) ---
      collectNodes();

      // If images are already loaded, we can lock immediately; otherwise wait for ANY to load once
      const tryInitialLock = () => {
        if (lockedHeight == null) {
          lockOnNextFrame();
        }
      };

      // Wait for the first image to load if needed (single shot)
      if (imgs.some((img) => !img.complete)) {
        let initialTriggered = false;
        imgs.forEach((img) => {
          if (!img.complete) {
            img.addEventListener(
              "load",
              () => {
                if (!initialTriggered && lockedHeight == null) {
                  initialTriggered = true;
                  tryInitialLock();
                }
              },
              { once: true }
            );
            img.addEventListener(
              "error",
              () => {
                if (!initialTriggered && lockedHeight == null) {
                  initialTriggered = true;
                  tryInitialLock();
                }
              },
              { once: true }
            );
          }
        });
        // Also fallback in case all fail to fire
        setTimeout(tryInitialLock, 500);
      } else {
        tryInitialLock();
      }

      // --- Viewport changes: ONLY here do we recompute & re-lock ---
      window.addEventListener("resize", () => {
        lockOnNextFrame();
      });

      window.addEventListener("orientationchange", () => {
        lockOnNextFrame();
      });

      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", () => {
          lockOnNextFrame();
        });
      }

      // --- MutationObserver: DO NOT RECOMPUTE ---
      // Observe only containers with js-animation="tab-menu-container"
      const mo = new MutationObserver(() => {
        collectNodes(); // refresh node lists
        applyLockedHeight(); // re-apply existing lock, no recompute
      });

      // Attach the observer to each matching container present now
      Array.from(
        document.querySelectorAll('[js-animation~="tab-menu-container"]')
      ).forEach((container) => {
        mo.observe(container, { childList: true, subtree: true });
      });
    });
  })();
</script></div></section></div></div><div class="apphub-sites--clr-page-padding"><div class="apphub-sites--clr-container-large"><div class="apphub-sites--clr-u-minheight-5rem"></div><div class="apphub-sites--clr-page-banner"><div class="w-richtext"><div class="w-embed"><div data-class="animated-gradient animated-gradient--jelly">
