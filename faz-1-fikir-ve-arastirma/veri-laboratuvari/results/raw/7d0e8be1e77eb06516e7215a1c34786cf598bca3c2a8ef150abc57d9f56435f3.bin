  [js-animation="animation__slide"] img,
  [js-animation="animation__slide"] video {
    opacity: 0;
    transition: all 1.5s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  [js-animation="animation__slide"] img.active,
  [js-animation="animation__slide"] video.active {
    opacity: 1;
  }

  [js-animation="animation__overlay"] {
    transition: all 1.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    transform: translateX(0);
  }
</style>

<script>
  let heroSectionContainerWidth;
  const heroSectionSlideWrapper = document.querySelector(
    '[data-class="hero-section-wrapper"]'
  );
  const heroSectionSlideContainer = document.querySelector(
    '[js-animation="animation__slide"]'
  );

  const heroSectionOverlayContainer = document.querySelector(
    '[js-animation="animation__overlay"]'
  );

  if (
    heroSectionSlideContainer &&
    heroSectionOverlayContainer &&
    heroSectionSlideWrapper
  ) {
    const heroSectionSlides =
      heroSectionSlideContainer.querySelectorAll("img, video");
    let heroSectionIntervalTime = 4400;
    let currentHeroSectionSlideIndex = 0;
    let heroSectionIntervalID;
    let heroSectionIntersectionFlag = false;
    heroSectionSlides[currentHeroSectionSlideIndex].classList.add("active");
    if (heroSectionSlides[currentHeroSectionSlideIndex].tagName === "VIDEO") {
      const videoElement = heroSectionSlides[currentHeroSectionSlideIndex];
      videoElement.play();
    }

    const startHeroSectionAnimationLoop = () => {
      heroSectionIntervalID = setInterval(
        startHeroSectionAnimation,
        heroSectionIntervalTime
      );
    };

    const stopHeroSectionAnimationLoop = () => {
      if (heroSectionIntervalID) {
        clearInterval(heroSectionIntervalID);
        heroSectionIntervalID = null;
      }
    };

    function resetOverlayAnimation() {
      heroSectionOverlayContainer.style.transition = "none";
      heroSectionOverlayContainer.style.transform = `translateX(0px)`;
      heroSectionOverlayContainer.offsetHeight;
      heroSectionOverlayContainer.style.transition =
        "all 1.5s cubic-bezier(0.645, 0.045, 0.355, 1.000)";
      currentHeroSectionSlideIndex = 0;
    }

    function startHeroSectionAnimation() {
      heroSectionSlides[currentHeroSectionSlideIndex].classList.remove(
        "active"
      );

      if (heroSectionSlides[currentHeroSectionSlideIndex].tagName === "VIDEO") {
        const videoElement = heroSectionSlides[currentHeroSectionSlideIndex];
        setTimeout(() => {
          videoElement.pause();
          videoElement.currentTime = 0;
        }, 1500);
      }

      if (currentHeroSectionSlideIndex === heroSectionSlides.length - 1) {
        resetOverlayAnimation();
      }

      currentHeroSectionSlideIndex++;
      heroSectionSlides[currentHeroSectionSlideIndex].classList.add("active");

      if (heroSectionSlides[currentHeroSectionSlideIndex].tagName === "VIDEO") {
        const videoElement = heroSectionSlides[currentHeroSectionSlideIndex];
        videoElement.play();
      }

      setTimeout(() => {
        heroSectionOverlayContainer.style.transform = `translateX(-${
          currentHeroSectionSlideIndex * heroSectionContainerWidth
        }px)`;
      }, 1100);
    }

    const heroSectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            heroSectionIntersectionFlag = true;
            if (!heroSectionIntervalID) {
              startHeroSectionAnimationLoop();
            }
          } else {
            heroSectionIntersectionFlag = false;
          }
        });
      },
      {
        root: null,
        threshold: 0.1,
      }
    );

    heroSectionObserver.observe(heroSectionSlideWrapper);

    // Resize Observer for dynamic width changes
    const heroSectionResizeObserver = new ResizeObserver((entries) => {
      for (let entry of entries) {
        heroSectionContainerWidth = entry.contentRect.width;
        heroSectionOverlayContainer.style.transition = "none";
        heroSectionOverlayContainer.style.transform = `translateX(-${
          currentHeroSectionSlideIndex * heroSectionContainerWidth
        }px)`;
        heroSectionOverlayContainer.offsetHeight;
        heroSectionOverlayContainer.style.transition =
          "all 1.5s cubic-bezier(0.645, 0.045, 0.355, 1)";
      }
    });

    heroSectionResizeObserver.observe(heroSectionSlideContainer);

    /* Focus/Blur Event Listeners START */
    window.addEventListener("blur", () => {
      stopHeroSectionAnimationLoop();
    });

    window.addEventListener("focus", () => {
      if (heroSectionIntersectionFlag) {
        if (!heroSectionIntervalID) {
          startHeroSectionAnimationLoop();
        }
      }
    });
    /* Focus/Blur Event Listeners END */
  } else {
    console.error(
      "Cannot find containers with attributes [data-class='hero-section-wrapper'], [js-animation='animation__slide'], and [js-animation='animation__overlay']"
    );
  }
</script></div></div></header></div><div class="c-underlay-bg-container"><div class="c-underlay-bg__image--opacity80"><img loading="lazy" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67acafd875efc03c3f54dcf2_graphic-mesh-bg.webp" alt="reviews.io mesh bg" class="c-underlay-bg__src-rio-page-home-horizontal-tabs-bg"/></div><header class="apphub-sites--clr-global-section-header--center"><div class="apphub-sites--clr-u-minheight-3rem"></div><div class="apphub-sites--c-section_header08__content"><div class="apphub-sites--clr-page-padding"><div class="apphub-sites--clr-container-small"><div class="apphub-sites--clr-text-align-center"><h2 data-class="text--heading" class="apphub-sites--clr-heading-h2-large">Empowering you to drive growth</h2></div></div></div></div></header><div class="clr-page-padding-2"><div class="w-embed"><style>
