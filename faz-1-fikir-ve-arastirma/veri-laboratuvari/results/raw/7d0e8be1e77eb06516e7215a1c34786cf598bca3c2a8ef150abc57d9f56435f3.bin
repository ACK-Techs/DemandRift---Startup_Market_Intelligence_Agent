<!-- Animation: Zoom in element when it's in a viewport START -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // First, select the parent element with the attribute [js-animation="zoomin-animation"]
    let parentElement = document.querySelector(
      '[js-animation="zoomin-animation"]'
    );
    // Check if the parent element exists
    if (parentElement) {
      let animation_elements = document.querySelectorAll(
        '[js-animation="animation__target"]'
      );

      let observer_animation_elements = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.setAttribute(
              "js-animation-show",
              "animation__target-show"
            );
          } else {
            entry.target.setAttribute("js-animation-show", "");
          }
        });
      });

      animation_elements.forEach((el) => {
        observer_animation_elements.observe(el);
      });
    }
  });
</script>
<style>
  [js-animation="zoomin-animation"] [js-animation="animation__target"] {
    transform: scale(0.9);
    transition: transform 1s, filter 3s ease-in-out;
  }
  [js-animation="zoomin-animation"]
    [js-animation="animation__target"][js-animation-show="animation__target-show"] {
    transform: scale(1);
  }
</style>
<!-- Animation: Zoom in element when it's in a viewport END --></div></div></div><div data-class="dark-mode-override--reviews" class="c-ai-insights-hp-section"><div class="c-underlay-bg__image--opacity20 home"><img src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/6a1d9169d7f3639ed5a440a2_graphic-mesh-bg-dark-mode.webp" loading="eager" alt="" class="c-underlay-bg__src-rio-page-home-dark--one"/></div><header class="apphub-sites--clr-global-section-header--center"><div class="apphub-sites--clr-u-minheight-5rem"></div><div class="apphub-sites--c-section_header08__content"><div class="apphub-sites--clr-page-padding"><div class="apphub-sites--clr-container-small"><div class="apphub-sites--clr-text-align-center"><div data-class="text--preheader" class="apphub-sites--clr-heading-subheading">Customer signals</div><h2 data-class="text--heading" class="apphub-sites--clr-heading-h2-large">AI Insights &amp; Analytics that turn customer feedback into growth</h2><div class="apphub-sites--clr-space-small"></div><div data-class="text--body" class="apphub-sites--clr-text-size-large">Uncover the signals that drive growth. AI Insights &amp; Analytics reveals what customers love, where they’re experiencing friction, and which actions are most likely to improve performance and experience. Helping you make smarter decisions, faster.</div></div></div></div></div><div class="apphub-sites--clr-u-minheight-3rem"></div></header><div class="clr-page-padding"><div class="clr-container-large c-ai-insights-max-width"><div class="clr-display--none w-embed"><style>
  .ai-insights-hero-visual {
    padding-top: 0px !important;
    padding-bottom: 0px !important;
    margin-bottom: -32px !important;
  }
</style></div><div class="c-ai-insights-panel w-embed w-script"><style>
  .ai-insights-page-shell {
    --ai-insights-page-bg: #020706;
    --ai-insights-teal: #27d6d1;
    --ai-insights-teal-deep: #005c58;
    --ai-insights-shell-width: 2338;
    --ai-insights-shell-height: 1285;
    --ai-insights-card-width: 687;
    --ai-insights-frame-padding: clamp(10px, 1vw, 18px);
    --ai-insights-frame-radius: clamp(8px, 1.35vw, 22px);
  }

  .ai-insights-hero-visual {
    width: 100%;
    padding: 34px 0 48px;
  }

  .ai-insights-dashboard-frame {
    position: relative;
    isolation: isolate;
    width: min(1710px, 100%);
    margin: 0 auto;
  }

  .ai-insights-dashboard-visual-layer {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: var(--ai-insights-frame-padding);
    border: 1px solid rgb(39 214 209 / 30%);
    border-radius: var(--ai-insights-frame-radius);
    background: linear-gradient(145deg, rgba(28, 87, 82, 0.4), rgba(4, 13, 12, 0.5)), rgba(4, 28, 27, 0.62);
    box-shadow:
      0 0 0 1px rgba(39, 214, 209, 0.16) inset,
      0 0 34px rgba(39, 214, 209, 0.28),
      0 24px 80px rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(34px) saturate(1.35);
    -webkit-backdrop-filter: blur(34px) saturate(1.35);
    transform-origin: center;
    transition:
      filter 420ms ease,
      transform 420ms ease;
  }

  .ai-insights-dashboard-visual-layer::before,
  .ai-insights-dashboard-visual-layer::after {
    position: absolute;
    pointer-events: none;
    content: '';
    border-radius: inherit;
  }

  .ai-insights-dashboard-visual-layer::before {
    inset: -1px;
    z-index: -1;
    padding: 1px;
    background: conic-gradient(from var(--ai-insights-glow-angle, 0deg), rgba(39, 214, 209, 0.1), rgba(39, 214, 209, 0.95), rgba(82, 255, 244, 0.18), rgba(39, 214, 209, 0.08), rgba(39, 214, 209, 0.85), rgba(39, 214, 209, 0.1));
    filter: blur(0.5px);
    opacity: 0.9;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    animation: ai-insights-edge-spin 8s linear infinite;
  }

  .ai-insights-dashboard-visual-layer::after {
    inset: 1px;
    z-index: 1;
    border: 0;
    border-radius: calc(var(--ai-insights-frame-radius) - 2px);
    box-shadow:
      0 0 36px rgba(39, 214, 209, 0.22) inset,
      0 0 80px rgba(39, 214, 209, 0.14) inset;
  }

  .ai-insights-edge-glare {
    position: absolute;
    left: var(--ai-insights-glare-left);
    z-index: 2;
    width: var(--ai-insights-glare-width);
    height: clamp(10px, 1vw, 18px);
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(39, 214, 209, 0.06) 8%, rgba(96, 255, 246, 0.98) 22%, rgba(39, 214, 209, 0.66) 48%, rgba(39, 214, 209, 0.1) 78%, transparent 100%);
    filter: blur(var(--ai-insights-glare-blur));
    opacity: 0;
    transform: translateZ(0);
    transform-origin: var(--ai-insights-glare-origin);
    will-change: opacity, transform;
    animation-duration: var(--ai-insights-glare-duration);
    animation-delay: var(--ai-insights-glare-delay);
    animation-iteration-count: infinite;
    animation-timing-function: linear;
  }

  .ai-insights-edge-glare-top {
    top: -8px;
    --ai-insights-glare-left: 8%;
    --ai-insights-glare-width: 56%;
    --ai-insights-glare-blur: 12px;
    --ai-insights-glare-duration: 9.6s;
    --ai-insights-glare-delay: -1.6s;
    --ai-insights-glare-origin: 12% 50%;
    animation-name: ai-insights-top-glare-drift;
  }

  .ai-insights-edge-glare-bottom {
    bottom: -8px;
    --ai-insights-glare-left: 52%;
    --ai-insights-glare-width: 39%;
    --ai-insights-glare-blur: 15px;
    --ai-insights-glare-duration: 6.9s;
    --ai-insights-glare-delay: -4.1s;
    --ai-insights-glare-origin: 82% 50%;
    animation-name: ai-insights-bottom-glare-drift;
  }

  .ai-insights-dashboard-composition {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--ai-insights-shell-width) / var(--ai-insights-shell-height);
    border-radius: calc(var(--ai-insights-frame-radius) - 2px);
    background: #010605;
  }

  .ai-insights-hover-cta {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(220px, 72%);
    min-height: 58px;
    padding: 0 22px;
    border: 0;
    border-radius: 0.5rem;
    background: linear-gradient(145deg, rgb(11 85 78 / 94%), rgb(6 62 58 / 94%)), #064943;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 7%),
      0 18px 48px rgb(0 0 0 / 42%),
      0 0 28px rgb(39 214 209 / 10%);
    color: #ffffff;
    font:
      800 16px/1 Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    text-align: center;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.92);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
    white-space: nowrap;
  }

  .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:hover .ai-insights-dashboard-visual-layer,
  .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:focus-within .ai-insights-dashboard-visual-layer {
    filter: blur(20px);
    transform: scale(0.9);
  }

  .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:hover .ai-insights-hover-cta,
  .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:focus-within .ai-insights-hover-cta {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-insights-dashboard-shell,
  .ai-insights-dashboard-card {
    display: block;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ai-insights-dashboard-shell {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-insights-dashboard-card {
    position: absolute;
    width: calc((var(--ai-insights-card-width) / var(--ai-insights-shell-width)) * 100%);
    height: auto;
    opacity: 0.2;
    transform: translateY(2.2%) scale(0.92);
    transform-origin: center;
    filter: drop-shadow(0 20px 28px rgba(0, 0, 0, 0.3));
    will-change: opacity, transform;
  }

  .ai-insights-hero-visual.ai-insights-is-visible .ai-insights-dashboard-card {
    animation: ai-insights-card-reveal-pulse 12s ease-in-out infinite;
    animation-delay: var(--ai-insights-card-delay, 0s);
  }

  .ai-insights-card-insight-1,
  .ai-insights-card-insight-2,
  .ai-insights-card-insight-3 {
    top: calc((250 / var(--ai-insights-shell-height)) * 100%);
  }

  .ai-insights-card-metric-1,
  .ai-insights-card-metric-2,
  .ai-insights-card-metric-3 {
    top: calc((610 / var(--ai-insights-shell-height)) * 100%);
  }

  .ai-insights-card-insight-1,
  .ai-insights-card-metric-1 {
    left: calc((150 / var(--ai-insights-shell-width)) * 100%);
  }

  .ai-insights-card-insight-1 {
    --ai-insights-card-delay: 0s;
  }

  .ai-insights-card-insight-2,
  .ai-insights-card-metric-2 {
    left: calc((883 / var(--ai-insights-shell-width)) * 100%);
  }

  .ai-insights-card-insight-2 {
    --ai-insights-card-delay: 0.24s;
  }

  .ai-insights-card-insight-3,
  .ai-insights-card-metric-3 {
    left: calc((1616 / var(--ai-insights-shell-width)) * 100%);
  }

  .ai-insights-card-insight-3 {
    --ai-insights-card-delay: 0.48s;
  }

  .ai-insights-card-metric-1 {
    --ai-insights-card-delay: 0.72s;
  }

  .ai-insights-card-metric-2 {
    --ai-insights-card-delay: 0.96s;
  }

  .ai-insights-card-metric-3 {
    --ai-insights-card-delay: 1.2s;
  }

  @keyframes ai-insights-edge-spin {
    to {
      --ai-insights-glow-angle: 360deg;
    }
  }

  @keyframes ai-insights-top-glare-drift {
    0% {
      opacity: 0;
      transform: translateX(-18%) scaleX(0.46);
    }

    22% {
      opacity: 0.46;
      transform: translateX(-9%) scaleX(0.78);
    }

    46% {
      opacity: 0.92;
      transform: translateX(2%) scaleX(1.08);
    }

    72% {
      opacity: 0.34;
      transform: translateX(14%) scaleX(1.3);
    }

    100% {
      opacity: 0;
      transform: translateX(27%) scaleX(1.48);
    }
  }

  @keyframes ai-insights-bottom-glare-drift {
    0% {
      opacity: 0;
      transform: translateX(12%) scaleX(0.5);
    }

    26% {
      opacity: 0.7;
      transform: translateX(5%) scaleX(0.86);
    }

    54% {
      opacity: 0.82;
      transform: translateX(-2%) scaleX(1.04);
    }

    78% {
      opacity: 0.24;
      transform: translateX(-8%) scaleX(0.92);
    }

    100% {
      opacity: 0;
      transform: translateX(-14%) scaleX(0.62);
    }
  }

  @keyframes ai-insights-card-reveal-pulse {
    0% {
      opacity: 0.2;
      transform: translateY(2.2%) scale(0.92);
    }

    4% {
      opacity: 1;
      transform: translateY(-0.6%) scale(1.035);
    }

    7% {
      opacity: 1;
      transform: translateY(0.15%) scale(0.992);
    }

    10% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    54% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    60% {
      opacity: 1;
      transform: translateY(-0.35%) scale(1.018);
    }

    66% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    86% {
      opacity: 0.98;
      transform: translateY(0) scale(1);
    }

    100% {
      opacity: 0.2;
      transform: translateY(2.2%) scale(0.92);
    }
  }

  @property --ai-insights-glow-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @media (max-width: 760px) {
    .ai-insights-page-shell {
      justify-items: start;
    }

    .ai-insights-hero-visual {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-insights-dashboard-visual-layer::before {
      animation: none;
      background: linear-gradient(90deg, rgba(39, 214, 209, 0.28), rgba(82, 255, 244, 0.88), rgba(39, 214, 209, 0.28));
    }

    .ai-insights-edge-glare {
      animation: none;
      opacity: 0.58;
      transform: none;
    }

    .ai-insights-dashboard-card {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .ai-insights-dashboard-visual-layer,
    .ai-insights-hover-cta {
      transition: opacity 160ms ease;
    }

    .ai-insights-hover-cta {
      transform: translate(-50%, -50%) scale(1);
    }

    .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:hover .ai-insights-dashboard-visual-layer,
    .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:focus-within .ai-insights-dashboard-visual-layer {
      transform: scale(0.9);
    }

    .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:hover .ai-insights-hover-cta,
    .ai-insights-hover-cta-enabled .ai-insights-dashboard-frame:focus-within .ai-insights-hover-cta {
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>
<main class="ai-insights-page-shell" aria-label="REVIEWS.io AI insights dashboard mockup">
  <section class="ai-insights-hero-visual" aria-label="Composed analytics dashboard illustration">
    <div class="ai-insights-dashboard-frame">
      <div class="ai-insights-dashboard-visual-layer">
        <span class="ai-insights-edge-glare ai-insights-edge-glare-top" aria-hidden="true"></span>
        <span class="ai-insights-edge-glare ai-insights-edge-glare-bottom" aria-hidden="true"></span>
        <div class="ai-insights-dashboard-composition">
          <img class="ai-insights-dashboard-shell" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-dashboard-shell.webp" width="2338" height="1285" alt="REVIEWS.io analytics dashboard shell" />

          <img class="ai-insights-dashboard-card ai-insights-card-insight-1" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-insight-1.webp" width="687" height="324" alt="AI insight card for material quality concerns" />
          <img class="ai-insights-dashboard-card ai-insights-card-insight-2" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-insight-2.webp" width="687" height="324" alt="AI insight card for customers praising comfort and design" />
          <img class="ai-insights-dashboard-card ai-insights-card-insight-3" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-insight-3.webp" width="687" height="324" alt="AI insight card for fulfilment and stock reliability gaps" />
          <img class="ai-insights-dashboard-card ai-insights-card-metric-1" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-metric-1.webp" width="687" height="660" alt="Sentiment analysis metric card" />
          <img class="ai-insights-dashboard-card ai-insights-card-metric-2" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-metric-2.webp" width="687" height="663" alt="Sentiment topics metric card" />
          <img class="ai-insights-dashboard-card ai-insights-card-metric-3" src="https://assets.reviews.io/webflow/custom-pages/reviews/ai-insights/img/graphic-metric-3.webp" width="687" height="662" alt="Best-performing products metric card" />
        </div>
      </div>
      <a class="ai-insights-hover-cta" href="/front/ai-insights" aria-hidden="true" tabindex="-1">Discover AI Insights</a>
    </div>
  </section>
</main>

<script>
  (() => {
    const aiInsightsConfig = { enableHoverCta: true };
    const heroVisual = document.querySelector('.ai-insights-hero-visual');
    const hoverCta = document.querySelector('.ai-insights-hover-cta');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!heroVisual) {
      return;
    }

    if (aiInsightsConfig.enableHoverCta && hoverCta) {
      heroVisual.classList.add('ai-insights-hover-cta-enabled');
      hoverCta.removeAttribute('aria-hidden');
      hoverCta.removeAttribute('tabindex');
    }

    if (prefersReducedMotion) {
      return;
    }

    if (!('IntersectionObserver' in window)) {
      heroVisual.classList.add('ai-insights-is-visible');
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.35) {
          heroVisual.classList.add('ai-insights-is-visible');
          observer.disconnect();
        }
      },
      { threshold: [0, 0.35] },
    );

    observer.observe(heroVisual);
  })();
</script></div></div></div></div><div class="c-underlay-bg-container"><div class="c-underlay-bg__image--opacity80"><img loading="lazy" src="https://cdn.prod.website-files.com/642419dd2be643c50e400f66/67acafd875efc03c3f54dcf2_graphic-mesh-bg.webp" alt="reviews.io mesh bg" class="c-underlay-bg__src-rio-page-home--casestudy-bg"/></div><header class="apphub-sites--clr-global-section-header--center"><div class="apphub-sites--clr-u-minheight-5rem"></div><div class="apphub-sites--c-section_header08__content"><div class="apphub-sites--clr-page-padding"><div class="apphub-sites--clr-container-small"><div class="apphub-sites--clr-text-align-center"><div data-class="text--preheader" class="apphub-sites--clr-heading-subheading">Proven success</div><h2 data-class="text--heading" class="apphub-sites--clr-heading-h2-large">Authentic reviews. Real results.</h2><div class="apphub-sites--clr-space-small"></div><div data-class="text--body" class="apphub-sites--clr-text-size-large">Thousands of merchants have grown faster by leveraging customer feedback, UGC and AI insights, enabling them to take data-driven actions.</div><div class="apphub-sites--clr-space-medium"></div><div class="apphub-sites--clr-button-row apphub-sites--clr-reverse-mobile-landscape apphub-sites--clr-align-center"><div class="apphub-sites--clr-button-wrapper apphub-sites--clr-max-width-full-mobile-landscape"></div><div class="apphub-sites--clr-button-wrapper apphub-sites--clr-max-width-full-mobile-landscape"><a data-class="button--primary" data-optibase-click-conversion-id="" data-tracking="" href="/lets-chat" class="apphub-sites--clr-button--primary w-inline-block"><div>Book demo</div></a></div></div></div></div></div></div></header><div js-animation="perspective-animation-mouseover" class="js-animation-via-attributes"><section data-class="one-tab-active-only animated-tab-loop" js-animation="tab-menu-container" class="apphub-sites--clr-tab-vertical__layout"><div class="apphub-sites--clr-display--none w-embed"><style>
