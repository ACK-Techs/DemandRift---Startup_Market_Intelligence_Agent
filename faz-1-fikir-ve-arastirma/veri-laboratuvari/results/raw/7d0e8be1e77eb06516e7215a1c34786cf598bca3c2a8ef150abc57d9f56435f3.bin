es--clr-link__icon w-embed"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.83301 14.1667L14.1663 5.83334M14.1663 5.83334H5.83301M14.1663 5.83334V14.1667" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div></div></div></div></div></a></div></div><div data-class="clr-navbar__dropdown-banner-item-overlay" class="apphub-sites--clr-navbar__dropdown-banner-item-overlay"></div></div></div></div></nav></div><div data-class="c-ai-btn-display-selector" class="apphub-sites--clr-navbar__standoutlink"><div class="apphub-sites--c-standout-link-custom-code w-embed"><style>
  .ai-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 39px;
    padding: 0 16px;

    border-radius: 999px;
    background: transparent;

    cursor: pointer;
    text-decoration: none;

    overflow: hidden;
    isolation: isolate;
  }

  .ai-btn::before {
    content: '';
    position: absolute;
    inset: 0;

    border-radius: inherit;
    padding: 1.5px;

    background: linear-gradient(115deg, #4285f4 0%, #7baaf7 18%, #ea4335 34%, #fbbc05 52%, #34a853 72%, #4285f4 100%);

    background-size: 260% 260%;
    animation: border-flow 4s linear infinite;

    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);

    -webkit-mask-composite: xor;
    mask-composite: exclude;

    z-index: 6;
    pointer-events: none;
  }

  .ai-btn-surface {
    position: absolute;
    inset: 1.5px;

    border-radius: inherit;
    overflow: hidden;

    z-index: 0;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 2px 6px rgba(40, 50, 80, 0.06);

    transition: box-shadow 0.2s ease;
  }

  .ai-btn-surface-light,
  .ai-btn-surface-dark,
  .ai-btn-inner-flow,
  .ai-btn-inner-sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .ai-btn-surface-light {
    background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);

    opacity: 1;
    z-index: 1;
    transition: opacity 0.18s ease;
  }

  .ai-btn-surface-dark {
    background: linear-gradient(180deg, #191c22 0%, #0f1115 100%);

    opacity: 0;
    z-index: 2;
    transition: opacity 0.18s ease;
  }

  .ai-btn-inner-flow {
    inset: -70% -38%;

    background: conic-gradient(from 0deg, rgba(66, 133, 244, 0) 0deg, rgba(66, 133, 244, 0.4) 58deg, rgba(234, 67, 53, 0.28) 112deg, rgba(251, 188, 5, 0.28) 168deg, rgba(52, 168, 83, 0.34) 230deg, rgba(66, 133, 244, 0.32) 292deg, rgba(66, 133, 244, 0) 360deg);

    opacity: 0;
    filter: blur(18px);
    transform: translateX(-24%) rotate(0deg);

    mix-blend-mode: screen;

    z-index: 3;
    transition: opacity 0.18s ease;
  }

  .ai-btn-inner-sheen {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.045) 38%, rgba(255, 255, 255, 0) 100%);

    opacity: 0;
    z-index: 4;
    transition: opacity 0.18s ease;
  }

  .ai-btn:hover .ai-btn-surface-light {
    opacity: 0;
  }

  .ai-btn:hover .ai-btn-surface-dark {
    opacity: 1;
  }

  .ai-btn:hover .ai-btn-inner-flow {
    opacity: 0.82;
    animation: inner-glow-flow 4.2s linear infinite;
  }

  .ai-btn:hover .ai-btn-inner-sheen {
    opacity: 0.9;
  }

  .ai-btn:hover .ai-btn-surface {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      inset 0 0 12px rgba(66, 133, 244, 0.15),
      inset 0 0 16px rgba(52, 168, 83, 0.1),
      0 1px 7px rgba(66, 133, 244, 0.13),
      0 1px 9px rgba(234, 67, 53, 0.09),
      0 1px 11px rgba(52, 168, 83, 0.1);
  }

  .ai-btn-content {
    position: relative;
    z-index: 7;

    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-btn-text {
    color: #4b5565;

    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;

    white-space: nowrap;

    transition: color 0.18s ease;
  }

  .ai-btn:hover .ai-btn-text {
    color: #ffffff;
  }

  .sparkle {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .sparkle path {
    fill: url(#sparkleGradient);

    transform-box: fill-box;
    transform-origin: center;

    animation: sparkle-flow 1.8s ease-in-out infinite;

    opacity: 0;

    transition: fill 0.18s ease;
  }

  .ai-btn:hover .sparkle path {
    fill: #ffffff;
  }

  .sparkle .s1 {
    animation-delay: 0s;
  }

  .sparkle .s2 {
    animation-delay: 0.25s;
  }

  .sparkle .s3 {
    animation-delay: 0.5s;
  }

  @keyframes sparkle-flow {
    0% {
      transform: scale(0.35);
      opacity: 0;
    }

    50% {
      transform: scale(1.15);
      opacity: 1;
    }

    100% {
      transform: scale(0.35);
      opacity: 0;
    }
  }

  @keyframes border-flow {
    0% {
      background-position: 0% 50%;
    }

    100% {
      background-position: 260% 50%;
    }
  }

  @keyframes inner-glow-flow {
    0% {
      transform: translateX(-24%) rotate(0deg);
    }

    50% {
      transform: translateX(20%) rotate(180deg);
    }

    100% {
      transform: translateX(-24%) rotate(360deg);
    }
  }

  @media screen and (max-width: 1200px) {
    [data-class~="c-ai-btn-display-selector"] {
      display: none;
    }
  }

  @media screen and (max-width: 991px) {
    [data-class~="c-ai-btn-display-selector"] {
      display: inline-block;
    }
  }
</style>

