<script>
document.addEventListener("DOMContentLoaded", function() {
    const teaser = document.querySelector('[dr-element="teaser2-component-aidemo"]');
    if (!teaser) return;
    const closeBtn = teaser.querySelector('[dr-element="teaser2-close-button-aidemo"]');
    const link = teaser.querySelector('[dr-element="teaser2-link-aidemo"]');
    if (!closeBtn || !link) return;
    const teaserId = teaser.getAttribute('dr-element').split('-').pop();
    const hiddenKey = `teaser_hide_temp_${teaserId}`;
    function showTeaser() {
        teaser.classList.add('is-visible');
    }
    function hideTeaserTemporarily() {
        teaser.classList.remove('is-visible');
        const expireDate = new Date();
        expireDate.setTime(expireDate.getTime() + (24 * 60 * 60 * 1000));
        localStorage.setItem(hiddenKey, expireDate.getTime());
    }
    const hideUntil = localStorage.getItem(hiddenKey);
    const now = Date.now();
    if (hideUntil) {
        if (now < hideUntil) {
            teaser.classList.remove('is-visible');
        } else {
            localStorage.removeItem(hiddenKey);
            showTeaser();
        }
    } else {
        showTeaser();
    }
    link.addEventListener('click', hideTeaserTemporarily);
    closeBtn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        hideTeaserTemporarily();
    });
});
</script>

<style>
  .w-webflow-badge { display: none !important }
</style>




