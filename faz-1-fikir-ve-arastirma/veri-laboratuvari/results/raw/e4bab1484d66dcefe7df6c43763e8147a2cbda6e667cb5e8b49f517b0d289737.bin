4 L746,305 L746,305 Z M707.17921,274.428187 L707.117121,274.428187 C704.0127,274.428187 702,272.350964 702,269.717936 C702,267.033681 704.072201,265 707.238711,265 C710.402634,265 712.348071,267.028559 712.41016,269.710252 C712.41016,272.34328 710.402634,274.428187 707.17921,274.428187 L707.17921,274.428187 L707.17921,274.428187 Z M703.109831,277.827047 L711.685795,277.827047 L711.685795,305 L703.109831,305 L703.109831,277.827047 L703.109831,277.827047 Z" fill="currentColor"/></g></g></svg></div></a></div></div></div><div data-wf--footer-bottom--variant="base" class="footer_bottom2"><div class="footer_bottom2_left"><div>© Copyright 2026 DealRoom Technologies, Inc.</div></div><div class="footer_bottom2_links"><a href="/company/privacy" class="footer_link">Privacy Policy</a><a href="/product/terms" class="footer_link">Terms of Use</a><a href="/cookie-policy" class="footer_link">Cookie Policy</a><div class="footer_link w-embed"><button class="consent_footer-change-button" type="button" onclick="revisitCkyConsent()">
