<!-- Nav BG -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const nav = document.querySelector('[dr-element="nav"]');
  if (!nav) return;
  const navBg = nav.querySelector('[dr-element="nav-bg"]');
  if (!navBg) return;

  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:30px;left:0;width:1px;height:1px;pointer-events:none;';
  document.body.appendChild(sentinel);

  const io = new IntersectionObserver(([entry]) => {
    navBg.style.opacity = entry.isIntersecting ? 0 : 1;
  }, { threshold: 0 });
  io.observe(sentinel);
});
</script>

<!-- Sticky Elements Position Fix -->
<!-- Sticky Elements Position Fix -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    if (window.innerWidth < 992) return;
    const DEFAULT_TOP_VISIBLE = 124;
    const DEFAULT_TOP_HIDDEN = 80;
    const considerElement = document.querySelector('[dr-sticky="to-consider"]');
    const stickyElements = document.querySelectorAll('[dr-sticky^="sticky-"], [dr-sticky="default"], [dr-sticky=""]');
    const stickyAnchors = document.querySelectorAll('[dr-sticky="sticky-anchor"]');
    if (!considerElement || stickyElements.length === 0) return;
    const cache = new Map();
    stickyElements.forEach((el) => {
        const attr = el.getAttribute("dr-sticky");
        if (!attr || attr === "default") {
            cache.set(el, [DEFAULT_TOP_VISIBLE, DEFAULT_TOP_HIDDEN]);
        } else {
            cache.set(el, attr.split("-").slice(1).map(Number));
        }
    });
    let lastState = null;
    function apply(visible) {
        if (visible === lastState) return;
        lastState = visible;
        let lastTopValue = 0;
        stickyElements.forEach((el) => {
            const [topVisible, topHidden] = cache.get(el);
            const topValue = visible ? topVisible : topHidden;
            lastTopValue = topValue;
            el.style.setProperty("top", `${topValue}px`, "important");
        });
        if (stickyAnchors.length > 0) {
            stickyAnchors.forEach((anchor) => {
                anchor.style.setProperty("top", `${-lastTopValue}px`, "important");
            });
        }
    }
    const ro = new ResizeObserver(entries => {
        for (const entry of entries) {
            const r = entry.contentRect;
            apply(r.width > 0 || r.height > 0);
        }
    });
    ro.observe(considerElement);
});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modalCloseButtons = document.querySelectorAll('[dr-modal="close"]');
    if (modalCloseButtons.length > 0) {
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                modalCloseButtons.forEach(button => button.click());
            }
        });
    }
});
</script>

<!-- Mobile Tabs fix within the navbar, by Tony Seets -->
<script>
  (function() {
  const TabConfig = {
    tabletBreakpoint: 992,
    allowTabContentLinkBubbling: true,
    debounceTime: 100,
    tabSelector: '[dr-element="nav"] .w-tabs'
  };

  let resizeTimeout;
  let tabContainers;

  function handleClick(event) {
    if (
      TabConfig.allowTabContentLinkBubbling &&
      event.target.closest('.w-tab-content') &&
      event.target.tagName === 'A'
    ) {
      return;
    }
    event.stopPropagation();
  }

  function updateTabStopPropagation() {
    if (!tabContainers) {
      tabContainers = document.querySelectorAll(TabConfig.tabSelector);
      if (tabContainers.length === 0) return;
    }

    const isMobile = window.innerWidth <= TabConfig.tabletBreakpoint;
    
    tabContainers.forEach(tabContainer => {
      tabContainer.removeEventListener('click', handleClick, false);
      if (isMobile) {
        tabContainer.addEventListener('click', handleClick, false);
      }
    });
  }

  function onResize() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(updateTabStopPropagation, TabConfig.debounceTime);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateTabStopPropagation);
  } else {
    updateTabStopPropagation();
  }

  window.addEventListener('resize', onResize, { passive: true });
})();
</script>

<!-- Forgiving Nav Dropdowns Hover -->
<script>
(function () {
  var BRIDGE = 12;
  var triangles = [];
  var mouseX = 0;
  var rafId = 0;
  var anyOpen = false;

  function createTriangleFor(dd) {
    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'safe-triangle-svg');
    svg.style.display = 'none';
    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    svg.appendChild(path);
    dd.appendChild(svg);
    return {
      dd: dd,
      svg: svg,
      path: path,
      panel: dd.querySelector('.w-dropdown-list'),
      trigger: dd.querySelector('.w-dropdown-toggle'),
      isOpen: false,
      cache: null
    };
  }

  function computeCache(t) {
    if (!t.panel || !t.trigger) return null;
    var ddRect = t.dd.getBoundingClientRect();
    var triggerRect = t.trigger.getBoundingClientRect();
    var panelRect = t.panel.getBoundingClientRect();
    if (panelRect.height === 0 || panelRect.width === 0) return null;
    return {
      panelLeft: panelRect.left,
      width: panelRect.width,
      height: (panelRect.top - triggerRect.bottom) + BRIDGE * 2,
      top: triggerRect.bottom - ddRect.top - BRIDGE,
      left: panelRect.left - ddRect.left
    };
  }

  function applyCache(t) {
    var c = t.cache;
    if (!c) { t.svg.style.display = 'none'; return; }
    t.svg.style.display = '';
    t.svg.setAttribute('width', c.width);
    t.svg.setAttribute('height', c.height);
    t.svg.style.left = c.left + 'px';
    t.svg.style.top = c.top + 'px';
  }

  function updateApex(t) {
    var c = t.cache;
    if (!c) return;
    var apexX = mouseX - c.panelLeft;
    if (apexX < 0) apexX = 0;
    else if (apexX > c.width) apexX = c.width;
    t.path.setAttribute('d', 'M ' + apexX + ',0 L ' + c.width + ',' + c.height + ' L 0,' + c.height + ' Z');
  }

  function setOpen(t, open) {
    if (open === t.isOpen) return;
    t.isOpen = open;
    if (open) {
      t.cache = computeCache(t);
      applyCache(t);
      updateApex(t);
    } else {
      t.cache = null;
      t.svg.style.display = 'none';
    }
    anyOpen = false;
    for (var i = 0; i < triangles.length; i++) {
      if (triangles[i].isOpen) { anyOpen = true; break; }
    }
  }

  function checkOpen(t) {
    return !!(t.trigger && t.trigger.getAttribute('aria-expanded') === 'true');
  }

  function onMouseMove(e) {
    mouseX = e.clientX;
    if (!anyOpen || rafId) return;
    rafId = requestAnimationFrame(function () {
      rafId = 0;
      for (var i = 0; i < triangles.length; i++) {
        if (triangles[i].isOpen) updateApex(triangles[i]);
      }
    });
  }

  function onResize() {
    for (var i = 0; i < triangles.length; i++) {
      var t = triangles[i];
      if (t.isOpen) {
        t.cache = computeCache(t);
        applyCache(t);
        updateApex(t);
      }
    }
  }

  document.querySelectorAll('.nav-dropdown_component-click').forEach(function (dd) {
    triangles.push(createTriangleFor(dd));
  });

  triangles.forEach(function (t) {
    if (!t.trigger) return;
    new MutationObserver(function () {
      setOpen(t, checkOpen(t));
    }).observe(t.trigger, { attributes: true, attributeFilter: ['aria-expanded'] });
    setOpen(t, checkOpen(t));
  });

  document.addEventListener('mousemove', onMouseMove, { passive: true });
  window.addEventListener('resize', onResize, { passive: true });
})();
</script></body></html>