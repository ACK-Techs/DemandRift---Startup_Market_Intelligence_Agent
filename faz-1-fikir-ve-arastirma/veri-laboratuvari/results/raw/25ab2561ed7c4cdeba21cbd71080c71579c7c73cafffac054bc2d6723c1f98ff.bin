ader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"downloadingOrdering_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","editorsChoiceProductReviews","productReviewsFooter","editorsChoiceProductReviews","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"downloadingOrdering_ExpandedMedia_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","editorsChoiceProductReviews","productReviewsFooter","editorsChoiceProductReviews","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"newPurchaseDownloadingOrdering":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","allProductReviews","allProductReviewActions","productReviewsFooter","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"newPurchaseDownloadingOrdering_ExpandedMedia":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","allProductReviews","allProductReviewActions","productReviewsFooter","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"newPurchaseDownloadingOrdering_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","editorsChoiceProductReviews","productReviewsFooter","editorsChoiceProductReviews","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"],"newPurchaseDownloadingOrdering_ExpandedMedia_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItemsDownloading","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","editorsChoiceProductReviews","productReviewsFooter","editorsChoiceProductReviews","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper","similarItems"]},"shelfMapping":{"topLockup":{"$kind":"Shelf","impressionMetrics":null,"contentType":"marker","marker":"productTopLockup","items":[],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"topLockup"},"description":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"description","idType":"sequential","impressionIndex":0}},"contentType":"productDescription","marker":null,"items":[{"$kind":"ProductDescription","paragraph":{"$kind":"Paragraph","text":"Booksy is the booking app and business tool for beauty pros doing it on their own. Side-hustlers turned full-timers. Commissioned turned independent. Solo pros building a name behind the chair. And the salon owners building something bigger. Every feature built with you in mind. Every feature included.\n\nBooksy is the top online scheduling and client management platform for appointment-based businesses.\n\nEasy for you to run. Easy for your clients to love.\n\nWHAT YOU GET WITH BOOKSY BIZ\n\nGET BOOKED 24/7, EVEN WHEN YOU SLEEP\nClients book themselves through your booking site, Instagram, Google, and Facebook. They love how easy it is to book, reschedule, and rebook. You set the rules, the hours, and the prices. We handle the rest. \n\nSTOP GETTING GHOSTED\nSet your cancellation policy and we’ll enforce it for you. Charge deposits, charge cancellation fees, fill empty slots automatically from the waitlist. No more chasing payments. No more awkward texts. Pros using Booksy recovered over $15.6 million from no-shows last year.\n\nGET PAID FAST, SECURE, AND YOUR WAY\nTake card, tap, mobile wallet, or in-app payments. Powered by Stripe. Free next-business-day payouts, or cash out in under 30 minutes with Fast Payouts. Every transaction is tracked and reported in one place - no more juggling multiple payment apps disconnected from your business.\n\nBUILD THE CLIENT BASE THAT KEEPS YOU BUSY \nFree text and email marketing. Promotions to fill slow days. Loyalty cards to reward your regulars. Automated rebooking reminders so they never lapse. \n\nLOOK LIKE THE PROFESSIONAL YOU ARE \nYour booking site, portfolio, and verified reviews build trust before clients even book. Show off your work, display your prices, and let your reviews do the talking.\n\nGET FOUND BY CLIENTS SEARCHING NEARBY\nYour business gets listed on the Booksy marketplace. Show up in Google Search, Google Maps, and Google AI Mode. Add a Book Now button to Instagram, Facebook, and Google. The clients are already searching — you just need to show up and make it easy to book. That’s where we come in.\n\nRUN THE WHOLE THING FROM YOUR PHONE \nCalendar, client cards, payments, marketing, reports — all in one app. Log in on the web or tablet for a complete front desk experience.\n\nGROW YOUR TEAM. STAY IN CONTROL.\nAdd staff, manage shifts, set commissions, track performance. Build a system that runs without you in the room — while you stay in complete control of how it operates. Booksy grows with you, from solo to salon and beyond.\n\nONE PRICE, EVERY FEATURE INCLUDED\nNo plan tiers. No paywalls. No \"upgrade for that feature.\" Every Booksy subscription includes scheduling, marketing, payments, reports, and 24/7 support. You only pay more if you add staff. \n\nABOUT BOOST \nBoost is the optional marketing tool to get you in front of more clients on the Booksy marketplace. We charge 30% of the FIRST visit from a Boost client only. Every appointment after that is 100% yours. We do not charge for appointments from existing clients, or for any client bookings when Boost is off.\n\nREAL HUMAN SUPPORT, 24/7\nLive chat in under 30 seconds. Phone and email support during business hours. We also offer 1:1 personal onboarding and transfer your data over for FREE. \n\nTHE NUMBERS\n• 330,000+ pros trust Booksy worldwide\n• 9.52 appointments created every second\n• $15.6 million protected from no-shows last year\n• 4.9 stars from 740,000+ reviews on the consumer app\n\nTry free for 14-days, no credit card required. Cancel anytime.\nTry Booksy Biz today","mediaType":"text/plain","style":"standard","alignment":"localized","isCollapsed":true,"suppressVerticalMargins":false,"wantsCollapsedNewlines":true},"developerAction":{"title":"Booksy","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/developer/booksy/id1604561890","location":[{"locationPosition":0,"locationType":"button","name":"Booksy","idType":"its_id","id":"1604561890"}],"eventType":"click","targetType":"button","targetId":"1604561890","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"page","pageUrl":"https://apps.apple.com/us/developer/booksy/id1604561890","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","id":"1604561890","$kind":"DeveloperPageIntent"}},"tags":[],"developerLinks":[{"$kind":"ProductPageLink","text":"Website","clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://biz.booksy.com/","isSensitive":false},"systemImageName":"safari"},{"$kind":"ProductPageLink","text":"Support","clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://support.booksy.com/hc/en-us","isSensitive":false},"systemImageName":"questionmark.circle"}]}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"description"},"informationRibbon":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"1","name":"","impressionType":"informationRibbon","idType":"sequential","impressionIndex":0}},"contentType":"productBadge","marker":null,"items":[{"$kind":"Badge","type":"rating","key":"rating","content":{"rating":4.5,"ratingFormatted":"4.5"},"heading":"15K Ratings","caption":"15K Ratings","longCaption":"4.5, 15K Ratings","leadingValue":"infer","accessibilityTitle":"4.5 Stars","accessibilityCaption":"15K Ratings","style":"standard","isMonochrome":true,"clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"select","actionDetails":{"position":0},"location":[{"locationPosition":19,"locationType":"badge","name":"","idType":"sequential","id":"rating"}],"eventType":"click","targetType":"badge","targetId":"rating","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"ShelfB