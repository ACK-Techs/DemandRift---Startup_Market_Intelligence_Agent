e":"badge","targetId":"size","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"ShelfBasedPageScrollAction","actionClass":"ShelfBasedPageScrollAction","shelfId":"information","notPurchasedShelfId":null,"purchasedShelfId":null,"index":1,"clicksOnScroll":true}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"informationRibbon"},"productRatings":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"18","name":"Ratings & Reviews","impressionType":"ratingsOverview","idType":"sequential","impressionIndex":2}},"contentType":"productRatings","marker":null,"items":[{"$kind":"Ratings","productId":"725335996","ratingAverage":4.5,"totalNumberOfRatings":14888,"context":"productPage","ratingCounts":[12271,805,358,240,1214]}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"See All","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/725335996?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"SeeAllReviews"}],"eventType":"click","targetType":"button","targetId":"SeeAllReviews","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageUrl":"https://apps.apple.com/us/app/725335996?see-all=reviews&platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","platform":"iphone","id":"725335996","see-all":"reviews","$kind":"SeeAllPageIntent"}},"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"productRatings"},"allProductReviews":{"$kind":"Shelf","impressionMetrics":null,"contentType":"productReview","marker":null,"items":[{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"11814245180","title":"Booksy App and Team","date":"2024-10-09T11:20:45.000Z","dateText":"* null *","contents":"I’m a Stylist of 10 years in the hair industry. I have recently ventured out into my own Salon! Booksy has been a major help! My experience has been made easy with the exceptional support from the team! Gabi was a team member that helped me through the set up process and making my profile look professional! She did an amazing job double checking everything over! My clients experience has been that it’s very easy to use and very straightforward when it comes to finding what they are looking for. I tried out other apps to ensure which would be best for my business. Booksy is the right choice for not only myself but my clients as well. Thank you to the Booksy team for always being on top of it and for always making sure everything is running smoothly! You guys truly have answered all my questions and then some! The advice and kindness I have received from each member has honestly been a game changer! It’s awesome to know that I have a great support team on my side whenever! I also appreciate the efforts made when I’ve made suggestions upon features within the App. I’m truly satisfied! Thank you again!","rating":5,"reviewerName":"KaylaMae123","dateAuthorText":"* null * · KaylaMae123","response":{"$kind":"Response","id":"47416433","contents":"We’re grateful for your review! Thank you!","date":"2024-10-13T18:46:19.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"11814245180","title":"Booksy App and Team","date":"2024-10-09T11:20:45.000Z","dateText":"* null *","contents":"I’m a Stylist of 10 years in the hair industry. I have recently ventured out into my own Salon! Booksy has been a major help! My experience has been made easy with the exceptional support from the team! Gabi was a team member that helped me through the set up process and making my profile look professional! She did an amazing job double checking everything over! My clients experience has been that it’s very easy to use and very straightforward when it comes to finding what they are looking for. I tried out other apps to ensure which would be best for my business. Booksy is the right choice for not only myself but my clients as well. Thank you to the Booksy team for always being on top of it and for always making sure everything is running smoothly! You guys truly have answered all my questions and then some! The advice and kindness I have received from each member has honestly been a game changer! It’s awesome to know that I have a great support team on my side whenever! I also appreciate the efforts made when I’ve made suggestions upon features within the App. I’m truly satisfied! Thank you again!","rating":5,"reviewerName":"KaylaMae123","dateAuthorText":"* null * · KaylaMae123","response":{"$kind":"Response","id":"47416433","contents":"We’re grateful for your review! Thank you!","date":"2024-10-13T18:46:19.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"11814245180"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":0}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8998079020","title":"Disappointed","date":"2022-08-20T12:53:36.000Z","dateText":"* null *","contents":"While I like the layout of this app, it’s a bit tricky to navigate. I’m not a fan of all the various payment options. There are to many and only two of them process payments through the app. What is the point for the others. In trying to use two of those, it generated receipts that say paid but clients didn’t have to run their card. I had to go back and contact clients to check their bank accounts for payments then send them a payment link (a feature that you should off) from square to collect their payments. Now I’m strictly running my payments through the square option ( my previous booking app) but, the sales are not showing a zero balance in the Booksy app. So I have to go check my square app to see the transaction went through. Also, if Booksy had a debit card and held funds in the app, that would be extremely helpful. I prefer keeping my business funds in the app and using my debit card for my business purchases from the same app. (Like square does) lastly, when I’m trying to chat with a live agent and get handed off to 3 different people, that takes about 10 minutes between them to respond to me, that is extremely irritating. Time is money, if I have an issue and need to chat with somebody for a few minutes, that conversation drags out over 30 minutes. I’m probably going back to square, but I’m trying to give this app an opportunity to meet my needs and fix these issues.","rating":3,"reviewerName":"super mad, mad, mad","dateAuthorText":"* null * · super mad, mad, mad","response":{"$kind":"Response","id":"32065508","contents":"Thank you for sharing your feedback. We are sorry to hear you have had a difficult experience with our customer service. You can remove payment methods that you and your clients don't use in the Customer payments section in the settings.\n\nWe want to take a closer look at this for you. Kindly write to us at info.us@booksy.com. We will help you at the earliest.\r\n","date":"2022-09-16T19:38:43.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8998079020","title":"Disappointed","date":"2022-08-20T12:53:36.000Z","dateText":"* null *","contents":"While I like the layout of this app, it’s a bit tricky to navigate. I’m not a fan of all the various payment options. There are to many and only two of them process payments through the app. What is the point for the others. In trying to use two of those, it generated receipts that say paid but clients didn’t have to run their card. I had to go back and contact clients to check their bank accounts for payments then send them a payment link (a feature that you should off) from square to collect their payments. Now I’m strictly running my payments through the square option ( my previous booking app) but, the sales are not showing a zero balance in the Booksy app. So I have to go check my square app to see the transaction went through. Also, if Booksy had a debit card and held funds in the app, that would be extremely helpful. I prefer keeping my business funds in the app and using my debit card for my business purchases from the same app. (Like square does) lastly, when I’m trying to chat with a live agent and get handed off to 3 different people, that takes about 10 minutes between them to respond to me, that is extremely irritating. Time is money, if I have an issue and need to chat with somebody for a few minutes, that conversation drags out over 30 minutes. I’m probably going back to square, but I’m trying to give this app an opportunity to meet my needs and fix these issues.","rating":3,"reviewerName":"super mad, mad, mad","dateAuthorText":"* null * · super mad, mad, mad","response":{"$kind":"Response","id":"32065508","contents":"Thank you for sharing your feedback. We are sorry to hear you have had a difficult experience with our customer service. You can remove payment methods that you and your clients don't use in the Customer payments section in the settings.\n\nWe want to take a closer look at this for you. Kindly write to us at info.us@booksy.com. We will help you at the earliest.\r\n","date":"2022-09-16T19:38:43.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"8998079020"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"1","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":1}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8466575223","title":"They tried to charge me for cancelling an account that doesn’t exist","date":"2022-03-17T22:10:40.000Z","dateText":"* null *","contents":"I am a very small college town nail artist doing nails out of my dorm room and I though this would be a good way to just organize my clients. I didn’t realize it was a subscription but it’s fine because I didn’t buy it and I didn’t even get to finish setting anything up before I got 5 calls in a row from a Florida number I didn’t know and when I picked up it was the Booksy people. The guy on the other line started explaining that people were “trying to find me” specifically and calling them to get my account finalized which I just know isn’t true because I hadn’t told anyone I was using this yet and I do not advertise except through friends. After explaining that I did not want ads posted anywhere or for random people to be able to get my contact information I apologized and said I had downloaded the wrong type of app for what I need with my business and I wanted to delete my account. That’s when the guy said I had to pay $5 to cancel my account that wasn’t even set up or active? I’m not going to give any money to someone over the phone regardless but definitely not for something like that. They also do not have my billing info because I don’t have that set up so It’s not like they can charge me I haven’t agreed to any sort of payments. \nTLDR: got spammed with calls from this company until I answered and then they wanted me to pay them $5 for doing nothing and I hung up.","rating":1,"reviewerName":"geemaroe","dateAuthorText":"* null * · geemaroe","response":{"$kind":"Response","id":"28858954","contents":"Sorry to hear that and apologies for the troubles! We do not charge for the account cancellation. Would you mind contacting us at info.us@booksy.com? We'd like to investigate the call you got.\nThank you for sharing your feedback!","date":"2022-03-29T19:30:35.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8466575223","title":"They tried to charge me for cancelling an account that doesn’t exist","date":"2022-03-17T22:10:40.000Z","dateText":"* null *","contents":"I am a very small college town nail artist doing nails out of my dorm room and I though this would be a good way to just organize my clients. I didn’t realize it was a subscription but it’s fine because I didn’t buy it and I didn’t even get to finish setting anything up before I got 5 calls in a row from a Florida number I didn’t know and when I picked up it was the Booksy people. The guy on the other line started explaining that people were “trying to find me” specifically and calling them to get my account finalized which I just know isn’t true because I hadn’t told anyone I was using this yet and I do not advertise except through friends. After explaining that I did not want ads posted anywhere or for random people to be able to get my contact information I apologized and said I had downloaded the wrong type of app for what I need with my business and I wanted to delete my account. That’s when the guy said I had to pay $5 to cancel my account that wasn’t even set up or active? I’m not going to give any money to someone over the phone regardless but definitely not for something like that. They also do not have my billing info because I don’t have that set up so It’s not like they can charge me I haven’t agreed to any sort of payments. \nTLDR: got spammed with calls from this company until I answered and then they wanted me to pay them $5 for doing nothing and I hung up.","rating":1,"reviewerName":"geemaroe","dateAuthorText":"* null * · geemaroe","response":{"$kind":"Response","id":"28858954","contents":"Sorry to hear that and apologies for the troubles! We do not charge for the account cancellation. Would you mind contacting us at info.us@booksy.com? We'd like to investigate the call you got.\nThank you for sharing your feedback!","date":"2022-03-29T19:30:35.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"8466575223"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":2}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"13714757436","title":"Long term customer and Booksy Blocked my Boost because of new clients not showing","date":"2026-02-05T07:51:44.000Z","dateText":"* null *","contents":"I had to cancel my account because of clients booking and not showing. I had no show policy in place and even switched to deposit. Despite all of these precautions I still wasted time and money. Eventually leading to booksy blocking my boost and receiving fewer and fewer new clients. I started a new account and the booking issues continued on this account. Leading me to being charged for a no show I didn't know I had. No notifications from booksy on the booksy app about the client or the charge. I noticed because I an extra charge had occurred in my bank account from booksy. I searched everywhere but saw no reason for the charge until I check my client list as I was about to import my clients to another platform. And that's when I saw it; a client I had never seen. They never booked, so I thought. After examining their profile I see their appointment was only a few days prior. Deposit in place; failed charge; no notification and it had not been on my books that day. Side note: I check everyday all day religiously; I had problems with not receiving push notifications from booksy. I reached out to customer service and they offered no resolution only preventative measures; which I had already done. On another point they raised the cap level for 1st time boost services; it was set at 30% up to $50 now if I'm not mistaken it's up to $100 or more. Luckily for me this was my back up booking app. Styleseat is better and they only take up to $50.","rating":1,"reviewerName":"Madame Yoshee","dateAuthorText":"* null * · Madame Yoshee","response":{"$kind":"Response","id":"60645721","contents":"Thank you for sharing your thoughts. We apologize that your experience didn’t meet your expectations. ","date":"2026-03-24T20:31:38.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"13714757436","title":"Long term customer and Booksy Blocked my Boost because of new clients not showing","date":"2026-02-05T07:51:44.000Z","dateText":"* null *","contents":"I had to cancel my account because of clients booking and not showing. I had no show policy in place and even switched to deposit. Despite all of these precautions I still wasted time and money. Eventually leading to booksy blocking my boost and receiving fewer and fewer new clients. I started a new account and the booking issues continued on this account. Leading me to being charged for a no show I didn't know I had. No notifications from booksy on the booksy app about the client or the charge. I noticed because I an extra charge had occurred in my bank account from booksy. I searched everywhere but saw no reason for the charge until I check my client list as I was about to import my clients to another platform. And that's when I saw it; a client I had never seen. They never booked, so I thought. After examining their profile I see their appointment was only a few days prior. Deposit in place; failed charge; no notification and it had not been on my books that day. Side note: I check everyday all day religiously; I had problems with not receiving push notifications from booksy. I reached out to customer service and they offered no resolution only preventative measures; which I had already done. On another point they raised the cap level for 1st time boost services; it was set at 30% up to $50 now if I'm not mistaken it's up to $100 or more. Luckily for me this was my back up booking app. Styleseat is better and they only take up to $50.","rating":1,"reviewerName":"Madame Yoshee","dateAuthorText":"* null * · Madame Yoshee","response":{"$kind":"Response","id":"60645721","contents":"Thank you for sharing your thoughts. We apologize that your experience didn’t meet your expectations. ","date":"2026-03-24T20:31:38.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"13714757436"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":3}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8398531015","title":"Not completely Satisfied","date":"2022-02-26T14:50:21.000Z","dateText":"* null *","contents":"As far as the system, it is pretty user friendly once you get a hang of it. Lots of tutorials and webinars to help you. My only issue is in the beginning the support chat was very helpful and responsive, but soon as you have an issue with the boost portion, the system tells me I’m claiming to mean clients! What!! How, I’m new to booksy and I’m advertising and marketing everywhere, especially on Groupon, I have 3 ads running and majority of my clients are either already mines or have purchased through Groupon. I have the new clients place notes in the system that they purchased a Groupon and the boost system still denies that they are my clients. Initially I’m told I’ll be refunded, and to stop claiming the clients the same day. I never was refunded. Then I was told to make sure I use my specific link and share it with the clients. Really!! That’s the only way, the clients are finding me and booking me. I have placed the link on all of my social platforms as instructed in the setup, and I utilize it through the Groupon, the boost is still acting as if the client is coming through their system. I have written them multiple times on this and now am not getting a response and just the other day they denied 2 of my new clients from Groupon and also new to boost. I know this seems like a lot but, if the system is suppose to identify you clients through your “unique link” it’s not happening and that part of the system is broken. Like I said I really do like he system overall but this portion definitely needs to be fixed, because Booksy hasn’t given me any new clients, I have worked hard as advertising myself, heck, I’m still not even “recommended” yet!","rating":3,"reviewerName":"Chyna3k","dateAuthorText":"* null * · Chyna3k","response":{"$kind":"Response","id":"28599788","contents":"Thank you for letting us know. As you've mentioned, sharing a link should prevent Boost charges. We're sorry this does not work for you. If the issue is not resolved, please contact us. Our team can be reached by chat or at info.us@booksy.com.","date":"2022-03-16T06:54:16.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8398531015","title":"Not completely Satisfied","date":"2022-02-26T14:50:21.000Z","dateText":"* null *","contents":"As far as the system, it is pretty user friendly once you get a hang of it. Lots of tutorials and webinars to help you. My only issue is in the beginning the support chat was very helpful and responsive, but soon as you have an issue with the boost portion, the system tells me I’m claiming to mean clients! What!! How, I’m new to booksy and I’m advertising and marketing everywhere, especially on Groupon, I have 3 ads running and majority of my clients are either already mines or have purchased through Groupon. I have the new clients place notes in the system that they purchased a Groupon and the boost system still denies that they are my clients. Initially I’m told I’ll be refunded, and to stop claiming the clients the same day. I never was refunded. Then I was told to make sure I use my specific link and share it with the clients. Really!! That’s the only way, the clients are finding me and booking me. I have placed the link on all of my social platforms as instructed in the setup, and I utilize it through the Groupon, the boost is still acting as if the client is coming through their system. I have written them multiple times on this and now am not getting a response and just the other day they denied 2 of my new clients from Groupon and also new to boost. I know this seems like a lot but, if the system is suppose to identify you clients through your “unique link” it’s not happening and that part of the system is broken. Like I said I really do like he system overall but this portion definitely needs to be fixed, because Booksy hasn’t given me any new clients, I have worked hard as advertising myself, heck, I’m still not even “recommended” yet!","rating":3,"reviewerName":"Chyna3k","dateAuthorText":"* null * · Chyna3k","response":{"$kind":"Response","id":"28599788","contents":"Thank you for letting us know. As you've mentioned, sharing a link should prevent Boost charges. We're sorry this does not work for you. If the issue is not resolved, please contact us. Our team can be reached by chat or at info.us@booksy.com.","date":"2022-03-16T06:54:16.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"8398531015"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":4}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"9492280563","title":"By far my favorite","date":"2023-01-10T14:33:14.000Z","dateText":"* null *","contents":"So I moved over to Booksy after using two different booking apps, and so far my experience have been nothing but good. I do like the fact that I have the opportunity to set up my pricing and services as I like I also like the message blast option, and that I can upload as many pictures as I like to my profile. I love that I can share my review directly from my booksy \nonto my different social media platform. My favorite by choice is Instagram. I love the same day cash out option from payments made through my card reader the only thing that I would to see change is payment that’s me through Booksy to have it separated from payment made through the card reader, so that way it’s easier to track of when deposit will be made directly to your bank account. I’m still confused on how that but other than that again I love using this app I love the fact that it breaks down your pricing it breaks down your the money that you’re bringing him through the app monthly weekly you could have your statement sent to you at any time beautiful development.","rating":5,"reviewerName":"korpor86","dateAuthorText":"* null * · korpor86","response":{"$kind":"Response","id":"34801579","contents":"Thank you for your feedback and suggestion! We are incredibly grateful that you took the time out to leave us this note. Our company values put customer satisfaction as top priority, and we are committed to our customers. Its customers like you that make our job wonderful. ","date":"2023-02-10T19:17:44.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"9492280563","title":"By far my favorite","date":"2023-01-10T14:33:14.000Z","dateText":"* null *","contents":"So I moved over to Booksy after using two different booking apps, and so far my experience have been nothing but good. I do like the fact that I have the opportunity to set up my pricing and services as I like I also like the message blast option, and that I can upload as many pictures as I like to my profile. I love that I can share my review directly from my booksy \nonto my different social media platform. My favorite by choice is Instagram. I love the same day cash out option from payments made through my card reader the only thing that I would to see change is payment that’s me through Booksy to have it separated from payment made through the card reader, so that way it’s easier to track of when deposit will be made directly to your bank account. I’m still confused on how that but other than that again I love using this app I love the fact that it breaks down your pricing it breaks down your the money that you’re bringing him through the app monthly weekly you could have your statement sent to you at any time beautiful development.","rating":5,"reviewerName":"korpor86","dateAuthorText":"* null * · korpor86","response":{"$kind":"Response","id":"34801579","contents":"Thank you for your feedback and suggestion! We are incredibly grateful that you took the time out to leave us this note. Our company values put customer satisfaction as top priority, and we are committed to our customers. Its customers like you that make our job wonderful. ","date":"2023-02-10T19:17:44.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"9492280563"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":5}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"10720455585","title":"My review","date":"2023-12-20T02:28:07.000Z","dateText":"edited * null *","contents":"I have been using Booksy for a little over a month. I was hesitant at first due to the fees monthly. It seems like many of these apps are trying to bank off the stylist. What I don’t like is the fact that they take a cut from anyone who books through their portal the first time. With having booth tent, if I charge a client $100 for loc maintenance, Booksy is taking $29 of that and then I have to put aside for rent and there is a surcharge on the $100 so after all of that I’ll be keeping about $60. Though that’s just got first time clients through Booksy it’s still a lot esp if we are paying monthly to already use the services. I understand style seat is a competitor but y’all have thousands of stylist millions even who are being charged. I also think since y’all are taking a portion of our labor that we should not be charge for the square card reader or get more discounts as customers to y’all. I don’t like that I can’t see a text go to a client but that it goes to them from a random number. I’d love to track the history of text threads they received esp Appt reminders. How do we know they actually go through? I also had a issue with Booksy double charging my client after I cancelled the Appt. Booksy also doesn’t show a zero balance when you pay with a secondary payment system like square. I wish the layout of the interface was different it’s very wordy maybe more visual click of buttons. More modern. I appreciated the service lost switch over from my old app. I love that we can use the app to create fliers. So far this is all I got. I appreciate that they do guarantee to send you clients As well. At least two a week. I know we all in rotation here. I’ll be back with updates in 90 days. Keep up the updates!","rating":3,"reviewerName":"myblessedhands","dateAuthorText":"edited * null * · myblessedhands","response":{"$kind":"Response","id":"32111275","contents":"Thanks for your review! We are grateful for your feedback. Booksy prides itself on the quality of its services and good value for money. You are a valued customer and your business is very important to us. \n\nWe are constantly making various improvements to make our application more comfortable to use and we would appreciate your sending us additional suggestions at info.us@booksy.com.","date":"2022-09-19T21:33:44.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"8","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"10720455585","title":"My review","date":"2023-12-20T02:28:07.000Z","dateText":"edited * null *","contents":"I have been using Booksy for a little over a month. I was hesitant at first due to the fees monthly. It seems like many of these apps are trying to bank off the stylist. What I don’t like is the fact that they take a cut from anyone who books through their portal the first time. With having booth tent, if I charge a client $100 for loc maintenance, Booksy is taking $29 of that and then I have to put aside for rent and there is a surcharge on the $100 so after all of that I’ll be keeping about $60. Though that’s just got first time clients through Booksy it’s still a lot esp if we are paying monthly to already use the services. I understand style seat is a competitor but y’all have thousands of stylist millions even who are being charged. I also think since y’all are taking a portion of our labor that we should not be charge for the square card reader or get more discounts as customers to y’all. I don’t like that I can’t see a text go to a client but that it goes to them from a random number. I’d love to track the history of text threads they received esp Appt reminders. How do we know they actually go through? I also had a issue with Booksy double charging my client after I cancelled the Appt. Booksy also doesn’t show a zero balance when you pay with a secondary payment system like square. I wish the layout of the interface was different it’s very wordy maybe more visual click of buttons. More modern. I appreciated the service lost switch over from my old app. I love that we can use the app to create fliers. So far this is all I got. I appreciate that they do guarantee to send you clients As well. At least two a week. I know we all in rotation here. I’ll be back with updates in 90 days. Keep up the updates!","rating":3,"reviewerName":"myblessedhands","dateAuthorText":"edited * null * · myblessedhands","response":{"$kind":"Response","id":"32111275","contents":"Thanks for your review! We are grateful for your feedback. Booksy prides itself on the quality of its services and good value for money. You are a valued customer and your business is very important to us. \n\nWe are constantly making various improvements to make our application more comfortable to use and we would appreciate your sending us additional suggestions at info.us@booksy.com.","date":"2022-09-19T21:33:44.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"725335996","targetReviewId":"10720455585"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":6}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"13708866547","title":"I am highly disappointed with the…","date":"2026-02-03T16:39:45.000Z","dateText":"* null *","contents":"I am highly disappointed with the service I’ve received from Booksy as of late i’ve been with Booky for the past eight years or so, and one of the reasons I stayed on this platform was because it felt safe as a business owner in our world today businesses can rise and fall based on our reviews, businesses thrive on reliability, quality of service, honesty, and a sense of trust as a subscriber I represented Booky and pride myself on bringing good business to the platform and I’ve managed to do so for the entire time I’ve used the platform, recently Booksy changed their policy, which now allows clients who didn’t even receive a service from you to leave a bad review on your platform, which wasn’t always so from my experience in order for someone to leave a review on your profile they had to at least receive a service from your establishment to base the review on. As a long-term paying client and subscriber to the platform there needs to be some sort of protection for us as business owners to feel safe to conduct business but, when I called Customer Service to try to get some help to properly investigate the situation they treated me like a complete stranger and that hurt. If there’s no protection for clients that use the platform to bring good business to your platform then “What are we paying you for” this has been a terrible waste of my time I would highly NOT recommend the use of this platform to upcoming business owners simply because your loyalty means NOTHING to them, and anyone can go on your profile, even if They’ve never made contact with you or your business and leave a bad review which initially can harm your business in the long run","rating":1,"reviewerName":"Hash Poetin","dateAuthorText":"* null * · Hash Poetin","response":{"$kind":"Response","id":"60645733","contents":"Thank you for sharing your thoughts. We apologize that your experience didn’t meet your expectations. ","date":"2026-03-24T20:33:19.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"9","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"13708866547","title":"I am highly disappointed with the…","date":"2026-02-03T16:39:45.000Z","dateText":"* null *","contents":"I am highly disappointed with the service I’ve received from Booksy as of late i’ve been with Booky for the past eight years or so, and one of the reasons I stayed on this platform was because it felt safe as a business owner in our world today businesses can rise and fall based on our reviews, businesses thrive on reliability, quality of service, honesty, and a sense of trust as a subscriber I represented Booky and pride myself on bringing good business to the platform and I’ve managed to do so for the entire time I’ve used the platform, recently Booksy changed their policy, which now allows clients who didn’t even receive a service from you to leave a bad review on your platform, which wasn’t always so from my experience in order for someone to leave a review on your profile they had to at least receive a service from your establishment to base the review on. As a long-term paying client and subscriber to the platform there needs to be some sort of protection for us as business owners to feel safe to conduct business but, when I called Customer Service to try to get some help to properly investigate the situation they treated me like a complete stranger and that hurt. If there’s no protection for clients that use the platform to bring good business to your platform then “What are we paying you for” this has been a terrible waste of my time I would highly NOT r