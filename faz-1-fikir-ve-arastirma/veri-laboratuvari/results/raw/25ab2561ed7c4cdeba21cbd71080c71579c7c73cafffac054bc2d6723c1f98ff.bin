:"app","adamId":"1023050786","bundleId":"com.squareup.appointments","style":"white","environment":"light","offerTint":{"type":"blue"},"titles":{"standard":"Get"},"titleSymbolNames":{},"subtitles":{},"hasInAppPurchases":false,"hasExternalPurchases":false,"isDeletableSystemApp":false,"isFree":true,"isPreorder":false,"offerLabelStyle":"none","contentRating":100,"useAdsLocale":false,"ignoresContentRestrictions":false,"isRedownloadDisallowed":false,"isOpenBundleAllowed":false,"bypassOnDeviceCompleteMyBundleCalculation":false},"clickAction":{"title":"Square Appointments: Scheduler","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/square-appointments-scheduler/id1023050786","location":[{"locationPosition":0,"locationType":"lockup","name":"Square Appointments: Scheduler","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1023050786"},{"locationPosition":17,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"eventType":"click","targetType":"lockup","targetId":"1023050786","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"product","pageUrl":"https://apps.apple.com/us/app/square-appointments-scheduler/id1023050786","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","referrerUrl":"https://amp-api-edge.apps.apple.com/v1/catalog/us/apps/725335996?platform=web&additionalPlatforms=appletv%2Cipad%2Ciphone%2Cmac%2CrealityDevice%2Cwatch&extend=accessibility%2CaccessibilityDetails%2CageRating%2CbackgroundAssetsInfo%2CbackgroundAssetsInfoWithOptional%2CcustomArtwork%2CcustomDeepLink%2CcustomIconArtwork%2CcustomPromotionalText%2CcustomScreenshotsByType%2CcustomVideoPreviewsByType%2Cdescription%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1023050786","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1023050786","name":"Square Appointments: Scheduler","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":0,"contentRating":100,"bundleId":"com.squareup.appointments"}}},{"$kind":"Lockup","adamId":"1179146771","bundleId":"com.acuityscheduling.app.ios","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9254901960784314,"green":0.9333333333333333,"blue":0.9058823529411765,"type":"rgb"},"textColor":{"red":0.043137254901960784,"green":0.054901960784313725,"blue":0.07058823529411765,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/5c/23/fe/5c23fe1d-cb00-bff7-820a-2ac47099e809/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Acuity: Appointment Scheduler","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Client scheduling & calendar","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Client scheduling & calendar","ageRating":"16+","productDescription":"Looking for an appointment scheduling app that helps you book clients, accept payments, collect intake forms, and reduce no-shows?\n\nAcuity Scheduling by Squarespace is the all-in-one scheduling software for service-based businesses. It’s built for professionals who need more than a basic meeting scheduler—so clients can self-book online, pay at booking, fill out forms before appointments, and get automatic reminders in one smooth booking flow.\n\nIf you want to save time, avoid missed appointments, and run your business with less admin, Acuity helps you do it all in one place.\n\n• REDUCE NO-SHOWS AND MISSED APPOINTMENTS\nNeed a tool that helps you avoid empty time slots? Acuity helps you reduce no-shows with automated email and SMS reminders, confirmation messages, easy rescheduling, cancellation links, and booking policies that set expectations clearly.\n\n• ACCEPT PAYMENTS AT THE TIME OF BOOKING\nLooking for appointment scheduling with payments? Acuity lets clients pay when they book with Stripe, Square, or PayPal. Collect deposits, send invoices and receipts, sell gift certificates, offer packages, support recurring memberships, and enable tipping—all built in. No extra tools required.\n\n• COLLECT CLIENT INTAKE FORMS BEFORE APPOINTMENTS\nNeed a booking system with intake forms? Acuity lets you attach customizable intake forms to every booking so clients can complete questionnaires, consent forms, waivers, and health history forms before they arrive. This helps therapists, wellness practitioners, coaches, and consultants stay prepared and organized.\n\n• MANAGE COMPLEX SERVICES AND AVAILABILITY\nIf your business has multiple services, different durations, or changing availability, Acuity makes it easy to manage. Offer different appointment types, control your calendar, manage multiple staff calendars and locations, and let clients book only what’s available.\n\n• SCHEDULE VIRTUAL APPOINTMENTS AND TELEHEALTH SESSIONS\nNeed online scheduling software for virtual consultations? Acuity can automatically generate Zoom, Google Meet, and GoToMeeting links for appointments, making it easy to run remote sessions, online coaching, and telehealth bookings.\n\n• RUN GROUP CLASSES, WORKSHOPS, AND RECURRING SESSIONS\nAcuity also supports group scheduling with capacity limits, class packages, and session bundles. Ideal for fitness studios, yoga instructors, tutors, workshops, and group coaching businesses.\n\n• BUILT FOR SERVICE BUSINESSES, NOT JUST MEETINGS\nAcuity is designed for businesses that need scheduling + client management + payments + automation in one tool.\n\n• INTEGRATIONS ADAPTED TO YOUR WORKFLOW\nEmbed your booking page on Squarespace, WordPress, Wix, or other websites, customize it to match your brand, and let clients book online 24/7.\n\nPerfect for:\n- Hairdressers, salons, estheticians, tattoo artists, and beauty pros who want clients to self-book, prepay, and receive reminders automatically\n- Therapists, psychologists, and healthcare professionals who need intake forms, secure workflows, and scheduling tools designed to support HIPAA compliance, with features like encrypted data handling and a signed Business Associate Agreement (BAA) on eligible plans\n- Coaches and consultants who want to reduce admin, send booking links, and get client details before sessions\n- Personal trainers, yoga teachers, and fitness studios who sell packages, memberships, and group classes\n- Small service-based businesses and teams that want an online booking system without per-user pricing on select plans\n- Photographers who want to deliver a better booking experience.\n\n• MORE THAN A BASIC CALENDAR BOOKING APP\nUnlike simple meeting schedulers, Acuity is built for real service workflows. It helps you schedule appointments, get paid, collect client information, and automate communication.\n\nTry Acuity free for 7 days — no credit card required.\n_____________\nPrivacy Policy: https://squarespace.com/privacy\nTerms of Service: https://squarespace.com/terms-of-service","rating":4.8,"ratingCount":"30K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1179146771&pricingParameters=STDQ&pg=default&appExtVrsId=891741686"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1179146771"},{"locationPosition":1,"locationType":"lockup","name":"Acuity: Appointment Scheduler","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1179146771"},{"locationPosition":17,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1179146771","eventType":"click","targetType":"button","targetId":"1179146771","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1179146771"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1179146771","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"pro