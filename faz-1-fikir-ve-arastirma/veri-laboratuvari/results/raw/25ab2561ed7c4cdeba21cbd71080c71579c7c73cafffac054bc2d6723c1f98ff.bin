lso-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1068911190","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1068911190","name":"Goldie: Appointment Scheduler","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":3,"variantId":"default","experimentId":"d8298f91-554c-4254-81df-010963aa0ec5","experimentLocale":"en-US","contentRating":100,"bundleId":"com.appointfix.Appointfix"}}},{"$kind":"Lockup","adamId":"665859578","bundleId":"com.setmore.app","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.1411764705882353,"green":0.23921568627450981,"blue":0.2,"type":"rgb"},"textColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d8/18/13/d81813be-0318-9c50-0282-7d947304882d/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Setmore Appointment Scheduling","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Booking and payments app","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Booking and payments app","ageRating":"4+","productDescription":"Setmore is a free all-in-one app with appointment scheduling, payments, team management, and more. Book clients, get paid, and run your day from anywhere — so you have more time for what matters.\n\nWhat you can do with Setmore:\n\n- Let clients self-book 24/7 on your branded Booking Page\n- Get booked from Facebook, Instagram, and Google Business Profile\n- Share your Booking Page by link or QR code\n- Take payments with Tap to Pay, Payment Links, and deposits\n- Charge quick payments—no appointment needed\n- Cut no-shows with automated reminders\n- Create unlimited services and classes\n- Grow your reputation with Google review requests\n- Chat with your team using Connect\n- Manage everyone's schedule in one place\n- Host video meetings over Google Meet or Zoom\n- Foster loyalty and bookings with your own branded mobile app\n- Sync every booking across mobile and desktop\n- Get 24/7 human support\n\nYour Booking Page, everywhere\nEvery account includes a mobile-friendly Booking Page you can personalize to match your brand. Share it as a booking link via DM, a social post, or email; add a QR code to your window or marketing materials; or put it on your customers' phones with your own branded mobile app—so rebooking takes just a tap.\n\nGrow your brand, not a marketplace\nEvery booking, payment, and customer is yours—not shared with competitors in someone else's directory. Own your reputation, keep clients coming back, and keep every experience on brand.\n\nGet booked, get paid\nTake payments online or in person. Use Tap to Pay to accept cards on your phone, send a Payment Link for remote bookings, or collect a deposit when clients book. Need to charge without an appointment? Take a quick payment in a couple of taps.\n\nBring your team together\nLet staff manage their own schedules and bookings, and get push notifications for new or updated appointments. With Connect, your whole team can chat in one place and stay on the same page.\n\nMeet clients anywhere\nAttach Google Meet or Zoom links to your bookings and host sessions or classes from your phone. Setting up a single session? Create a one-time meeting and share the link in seconds.\n\nSee your schedule at a glance\nCheck your calendar in real time with 'Agenda', 'Day', or '3 Day' view. Book, reschedule, or cancel on the go—everything syncs with your desktop, and notifications flag new or changed bookings the moment they land.\n\nReal people, around the clock\nOur team is here whenever you need a hand. Email, chat, or call, and a real person will help—24/7.\n\nReady to grow?\nStart your 14-day free trial of Pro whenever you're ready, and unlock more of what your business needs.\n\nMake time for what truly matters. Setmore automates your bookings so you can focus on your customers and your craft.\n\nStart now with free online scheduling for your business.\n\nPrivacy Policy: https://www.setmore.com/privacy\nTerms of Use: https://www.setmore.com/terms","rating":4.7,"ratingCount":"9.2K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=665859578&pricingParameters=STDQ&pg=default&appExtVrsId=891796572"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"665859578"},{"locationPosition":4,"locationType":"lockup","name":"Setmore Appointment Scheduling","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"665859578"},{"locationPosition":17,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"665859578","eventType":"click","targetType":"button","targetId":"665859578","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"665859578"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"665859578","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=665859578&pricingParameters=STDQ&pg=default&appExtVrsId=891796572","ve