loper-response-header svelte-1b79zq6"><span class="developer-response-heading svelte-1b79zq6">Developer Response</span> <time class="date svelte-1b79zq6" datetime="2026-03-24T20:31:38.000Z">Mar 24</time></div> <!-- HTML_TAG_START -->Thank you for sharing your thoughts. We apologize that your experience didn’t meet your expectations. <!-- HTML_TAG_END --></div></p></div> </div> </div> </dialog> </div></li>   <li class="shelf-grid__list-item svelte-13b6ljx placeholder" data-test-id="shelf-grid-list-item-4" data-index="4" aria-hidden="true"></li>   <li class="shelf-grid__list-item svelte-13b6ljx placeholder" data-test-id="shelf-grid-list-item-5" data-index="5" aria-hidden="true"></li>   <li class="shelf-grid__list-item svelte-13b6ljx placeholder" data-test-id="shelf-grid-list-item-6" data-index="6" aria-hidden="true"></li>   <li class="shelf-grid__list-item svelte-13b6ljx placeholder" data-test-id="shelf-grid-list-item-7" data-index="7" aria-hidden="true"></li> </ul> <button aria-label="Next Page" type="button" class="shelf-grid-nav__arrow shelf-grid-nav__arrow--right svelte-133ytgj" data-testid="shelf-button-right" style="--offset: 0px;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 31"><path d="M5.275 29.46a1.61 1.61 0 0 0 1.456 1.077c1.018 0 1.772-.737 1.772-1.737 0-.526-.277-1.186-.449-1.62l-4.68-11.912L8.05 3.363c.172-.442.45-1.116.45-1.625A1.7 1.7 0 0 0 6.728.002a1.6 1.6 0 0 0-1.456 1.09L.675 12.774c-.301.775-.677 1.744-.677 2.495 0 .754.376 1.705.677 2.498L5.272 29.46Z"></path></svg></button></div> </section> </div> </section> <section id="mostRecentVersion" data-test-id="shelf-wrapper" aria-label="What’s New" class="shelf svelte-1svznay    padding-top padding-bottom"><div slot="title" class="title-container svelte-qq59rp"><button>  <div class="title-action-wrapper svelte-1oivr99">  <div class="link-contents svelte-1oivr99"><h2 class="shelf-title svelte-1oivr99" data-test-id="shelf-title">What’s New</h2> <span class="chevron-container svelte-1oivr99" da