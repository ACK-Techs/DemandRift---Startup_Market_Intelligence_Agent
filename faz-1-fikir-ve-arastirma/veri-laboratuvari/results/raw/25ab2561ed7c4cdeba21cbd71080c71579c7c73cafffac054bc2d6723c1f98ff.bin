,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"purchasedLinks"},"textLinksShelf":null,"moreByDeveloper":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"25","name":"More by Booksy","impressionType":"developer","idType":"sequential","impressionIndex":15}},"contentType":"smallLockup","marker":null,"items":[{"$kind":"Lockup","adamId":"723961236","bundleId":"com.sensi.BooksyCUST","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.3215686274509804,"green":0.6705882352941176,"blue":0.7137254901960784,"type":"rgb"},"textColor":{"red":0.058823529411764705,"green":0.07450980392156863,"blue":0.07450980392156863,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/ac/cb/d5/accbd574-9708-857e-4e9d-aec56c69f379/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Booksy for Customers","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Book self-care in seconds","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Book self-care in seconds","ageRating":"18+","productDescription":"Self-care, on your schedule. Instantly book with your favorite beauty and wellness providers, anytime and anywhere.\n\nJoin over 50 million clients who use Booksy to find and book top-rated beauty and wellness professionals. Skip the phone tag and back-and-forth DMs. With Booksy, your next appointment is just a tap away.\n\nBOOK 24/7 ON YOUR SCHEDULE\nNo more waiting for a callback. Pick a service, view open slots, and lock in your spot in seconds. \n\nEASILY MANAGE YOUR OWN APPOINTMENTS\nPlans change, we get it. Reschedule or cancel directly in the app in seconds. Automatic reminders keep you on track so you never miss a service.\n\nFIND THE BEST IN YOUR NEIGHBORHOOD\nDiscover nearby barbers, nail techs, hairstylists, massage therapists, and more. Explore real-time availability, check verified reviews, and browse portfolios to find your perfect match.\n\nWHY YOU’LL LOVE BOOKSY:\n• Rebook in seconds: Rebook your go-to services in just a couple clicks.\n• Automatic reminders: We’ll send you a nudge so you never miss an appointment.\n• Secure payments: Pay right through the app—no cash needed.\n• Special offers: Find and save on local services with exclusive deals.\n• Find local gems: Search and filter to find exactly what you need.\n\nReady to prioritize you? Download Booksy today and see why we’re the world’s top-rated beauty booking app.","rating":4.9,"ratingCount":"858K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=723961236&pricingParameters=STDQ&pg=default&appExtVrsId=891777984"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"723961236"},{"locationPosition":0,"locationType":"lockup","name":"Booksy for Customers","idType":"its_id","id":"723961236"},{"locationPosition":15,"locationType":"swoosh","name":"More by Booksy","idType":"sequential","id":"25"}],"jet_adamId":"723961236","eventType":"click","targetType":"button","targetId":"723961236","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"723961236"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"723961236","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParam