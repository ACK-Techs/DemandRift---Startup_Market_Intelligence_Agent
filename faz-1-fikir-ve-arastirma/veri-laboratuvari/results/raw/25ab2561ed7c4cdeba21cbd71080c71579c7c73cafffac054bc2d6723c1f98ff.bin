medicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1081286979","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1081286979","name":"GlossGenius: Booking, Payments","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":2,"contentRating":100,"bundleId":"com.glossgenius.GlossGeniusSaaS"}}},{"$kind":"Lockup","adamId":"1068911190","bundleId":"com.appointfix.Appointfix","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.11764705882352941,"green":0.10588235294117647,"blue":0.19215686274509805,"type":"rgb"},"textColor":{"red":0.9529411764705882,"green":0.8941176470588236,"blue":0.3254901960784314,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/e4/b5/a4/e4b5a417-15ad-b7d8-1f74-ec44f1253dae/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Goldie: Appointment Scheduler","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Payments & Booking System","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Payments & Booking System","ageRating":"4+","productDescription":"Goldie (formerly Appointfix) is a free appointment scheduling and planner app designed to help you manage and grow your business. Built for salons, barbers, and beauty professionals to take their business to the next level, schedule appointments, manage customer bookings, send automatic appointment reminders, and more. \nJoin over 150,000 hair stylists, nail salons, lash artists, barbers, spas, tattooists, and other business professionals who trust Goldie as their booking software to schedule clients and grow their business.\n\n\nAccelerate your business in any profession\n• Hair salon and barber shops\n• Beauty, eyelash, and nail technicians\n• Tattoo artists\n• Massage therapists\n• Personal trainers\n• Pet grooming \n• And many more professionals who want to drive more appointment bookings\n\n\nFast and easy appointment scheduling\n• Schedule clients anytime, anywhere \n• Access from multiple devices to run your business on the go.\n• Sync with your business calendar \n\n\nEffortless client booking and management\n• Stay up to date with client profiles, booking history and notes\n• 24/7 booking with custom booking sites \n• Attract regulars, set up recurring appointments with Pro\n\n\nAccessible communication with clients\n• Automated appointment reminders and confirmations to avoid no shows\n• Market your business with ease using mass promotional messaging\n• Use message templates with Pro for swift client communication\n\n\nSecure payments and revenue\n• Deposits to reduce cancellations with Pro\n• Online and in-person payments with Pro\n• Easily track your income with revenue reports\n\n\nGet started for free\n• Try our free starter plan to see if Goldie is right for you\n• Access even more great features with our paid Pro and Pro Plus plans\n• Relaunch your business on Goldie with easy and free data transfer from other apps.\n\n\nSimple appointment scheduling\nLet clients book 24/7, with a personalized online booking page showing real-time availability. Access your calendar, clients, and appointments across all your devices, anywhere.\n\n\nBook more clients\nTurn first-time clients into regulars. Track booking history, notes, and preferences to deliver a high-quality service for each appointment. \n\n\nStop no-shows before they happen\nAutomatic reminders and deposits to prevent last-minute cancellations. Keep up effective communication with your clients to keep them informed with promotional messaging.\n\n\nGoldie grows with you\nStart your business with our starter plan and move on to paid tiers when your business grows, with team plans available when employee numbers expand.\n\n\nKick start your business for free\nEverything you need to start your business and schedule like a pro. Manage appointments, schedule reminders, and accept bookings 24/7 with personalized booking sites. Organize client details, carry out reports, and keep track of appointments with calendars across multiple devices. \n\n\nBoost revenue with our Pro Plan \nReady to level up your business? Reduce no-shows by taking deposits, accepting secure payments and managing complex bookings. Keep clients informed with automated and personalized client communication, as well as custom message templates. Enjoy priority customer support.\n\n\nExpand your team with Pro Plus\nBuilt for businesses with growing teams. Manage staff, assign roles, and host multiple calendars while tracking staff performance. Everything from Pro, with tools to keep your team operating efficiently.\n\n\n\n\n\n\n---\n\nPayment Policy: Your Goldie subscription will be charged to your Apple ID account, and it will automatically renew unless canceled at least 24 hours before the end of the current period. You can manage your subscription by going to your Apple ID Account Settings after purchase. Any unused portion of a free trial period, if offered, will be forfeited when you purchase a subscription.\n\nTerms of Use: https://heygoldie.com/terms-conditions\nPrivacy Policy: https://heygoldie.com/privacy\n","rating":4.8,"ratingCount":"13K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1068911190&pricingParameters=STDQ&pg=default&appExtVrsId=891771816"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1068911190","variantId":"default","experimentId":"d8298f91-554c-4254-81df-010963aa0ec5","experimentLocale":"en-US"},{"locationPosition":3,"locationType":"lockup","name":"Goldie: Appointment Scheduler","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1068911190","variantId":"default","experimentId":"d8298f91-554c-4254-81df-010963aa0ec5","experimentLocale":"en-US"},{"locationPosition":17,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1068911190","eventType":"click","targetType":"button","targetId":"1068911190","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1068911190"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1068911190","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1068911190&pricingParameters=STDQ&pg=default&appExtVrsId