,"impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":7,"contentRating":100,"bundleId":"com.saloncentric.app"}}},{"$kind":"Lockup","adamId":"6450964559","bundleId":"io.cloudwalk.jim","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9333333333333333,"green":0.41568627450980394,"blue":0.2,"type":"rgb"},"textColor":{"red":0.0784313725490196,"green":0.01568627450980392,"blue":0.00784313725490196,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/e4/e1/0d/e4e10d08-c871-70de-e92a-0f384e955eb4/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Jim: sell & get paid instantly","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Tap to Pay & Payment Links","tertiaryTitle":"Designed for iPhone.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Tap to Pay & Payment Links","ageRating":"4+","productDescription":"Download Jim and the phone in your hand starts taking card payments. No reader to buy. No cables. No monthly fees. Your customer taps, you get paid, and the money hits your Jim Card in seconds.\n\nBuilt for barbers, nail techs, food trucks, tutors, drivers, market sellers, photographers — anyone who sells something and needs to get paid.\n\nTAP TO PAY. 1.99% PER SALE\nWith Tap to Pay, customers tap their card, phone, or watch directly on your phone.\nNo reader. No cables. No bulky machine taking up space.\nAccept major card brands, Apple Pay, Google Pay, and Samsung Pay for one flat fee of 1.99% per sale.\n\nPAYMENT LINK. SELL TO ANYONE, ANYWHERE\nCustomer not standing in front of you? Send them a Payment Link.\nEnter an amount, generate the link, and share it by text, email, or DM. They click and pay without downloading Jim or creating an account.\nYou can even choose whether you or the customer covers the fee.\nPayment Link fee: 4.99% + $0.30 per sale.\n\nYOUR FREE BUSINESS WEBSITE\nJIM builds you a professional website, free. Your services, your prices and a payment link, all at the same place. Want to change something? Chat with Jim and it updates. No coding, no designer, no monthly fee.\n\nBOOKINGS\nLet clients book themselves. Share one link, they pick a service and a time and pay a deposit upfront. Automatic reminders go out before every appointment, so you can stop confirming over text. You collect the rest in person with Tap to Pay.\n\nAI BUSINESS AGENT\nA marketing team and a business analyst in your pocket. Ask JIM what's selling, which hours make you the most money, what to post this week. It reads your real numbers and answers.\n\nTIPS WITHOUT THE AWKWARD STARE\nAdd an optional tipping screen to Tap to Pay. Customers can choose a suggested percentage, enter a custom tip, or skip. Tips arrive instantly with the sale.\n\nNO HIDDEN FEES. EVER.\nFree to download. Free to set up. No monthly charges. No contracts, no minimums. You only pay when you sell.\n\nSAFE AND CERTIFIED\nCertified by Visa, Mastercard, Amex and Discover. PCI DSS compliant. End-to-end encryption and real-time fraud prevention.\n\nUP AND RUNNING IN MINUTES\n1. Download Jim. It’s free\n2. Create your account and verify your identity\n3. Enter the amount and let your customer tap\n4. Get paid in seconds\n\nThousands of sellers across all 50 states already use JIM. Download it and make your next sale with the phone you already have.\n\nThe JIM Card is issued by Lead Bank, Member FDIC., pursuant to license from Visa U.S.A. Inc. Instant settlements subject to terms. Fees and T&C apply. See jim.com for more details.\n\n* Jim is a financial technology company, not a bank. Prepaid debit cards issued by Lead Bank, Member FDIC.\n\n** Instant and immediate settlements are subject to the Terms and Conditions of Services and the Accelerated Payment Services Terms.\n\n***Cloudwalk Inc. (\"Cloudwalk\") is not a bank. Cloudwalk is a financial technology company. Banking services are provided by Lead Bank, Member FDIC. The JIM.com Visa Prepaid Card (the \"JIM\" Card) is issued by Lead Bank pursuant to licensing by Visa® U.S.A. Inc. and is available to commercial entities in select industries. Fees and eligibility requirements apply. See Terms and Cardholder Agreement for more details. Funds held in the Cloudwalk Prepaid Card Account are held with Lead Bank, Member FDIC, and are insured up to $250,000 in the event Lead Bank fails and if specific deposit insurance requirements are met and your card is registered. FDIC insurance does not protect funds in the event of Cloudwalk's failure or from the risk of theft or fraud. \n\nContact JIM.com Support by mail at help@jim.com\n\nCloudwalk, Inc.\n440 N Wolfe Rd\nSunnyvale, CA 94085","rating":4.8,"ratingCount":"13K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6450964559&pricingParameters=STDQ&pg=default&appExtVrsId=891682240"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6450964559"},{"locationPosition":8,"locationType":"lockup","name":"Jim: sell & get paid instantly","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6450964559"},{"locationPosition":17,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"6450964559","eventType":"click","targetType":"button","targetId":"6450964559","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapsh