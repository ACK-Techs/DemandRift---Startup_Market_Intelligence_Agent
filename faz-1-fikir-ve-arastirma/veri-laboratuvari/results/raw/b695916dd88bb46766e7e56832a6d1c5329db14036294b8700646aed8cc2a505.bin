shby-workday-integration.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Ashby's integration with Workday is API-based to allow for a flexible, bi-directional sync. ","type":"text"},{"text":"Learn more","type":"text","marks":[{"type":"link","attrs":{"href":"/workday-integration","uuid":"0d0d363c-588e-49b1-a050-1ea04c5d2a73","anchor":null,"target":"_self","linktype":"story"}}]}]}]}},{"_uid":"c5634d98-0c24-4b08-9d56-506ce88de231","title":"Zapier","component":"MiniCard","heroImage":{"id":82689571657043,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/1059x786/d804b6b501/ashby-zapier-integration.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Zapier automates work across 5000+ app integrations, so you can focus on what matters. ","type":"text"},{"text":"Learn more","type":"text","marks":[{"type":"link","attrs":{"href":"https://zapier.com/apps/ashby/integrations?","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]}]}]}},{"_uid":"9045fb56-6c1f-4c29-92c3-60041efd1255","title":"Slack","component":"MiniCard","heroImage":{"id":82704742770106,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/1059x786/fb65462f77/ashby-slack-integration.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"description":{"type":"doc","attrs":{"backgroundColor":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Get instant alerts, approve offers, and automatically create channels for interviews with Ashby's Slack integration. ","type":"text"},{"text":"Learn more","type":"text","marks":[{"type":"link","attrs":{"href":"https://docs.ashbyhq.com/slack","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]}]}]}}],"component":"ThreeColumn"}],"headline":[{"_uid":"651b6f86-c2cf-47cd-9680-1882a9d782aa","icon":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"align":"left","quote":[],"section":"New","headline":"Featured integrations","component":"Headline","description":{"type":"doc","content":[{"type":"paragraph"}]},"headlineIsNavLink":[]}],"component":"CardGridSection","topPadding":true,"bottomPadding":false,"backgroundColor":"primary"},{"_uid":"06857438-101f-4528-b1ce-b4a06190444c","headline":[{"_uid":"dd210c13-bc57-4c8a-8481-18e4991cea89","icon":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"align":"left","quote":[],"section":"","headline":"Integrations Directory","component":"Headline","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Explore our growing ecosystem of over 250+ integrations.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#444746"}}]}]}]},"headlineIsNavLink":[]}],"component":"IntegrationsDirectory"},{"_uid":"a31a5741-fadf-4e63-a68f-0118a971ff69","badge":"API","image":{"id":734216,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/3840x2711/75294ce225/api-integration-docs.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"header":"Platform extensibility","component":"CardSection","primaryCta":[],"topPadding":false,"description":"Build custom workflows, connectors, or automation that's unique to your hiring process directly into the platform using Ashby's open API.","secondaryCta":[],"bottomPadding":false},{"_uid":"f75ddec4-f0a9-4f46-a400-05930ee13c0e","grid":[{"_uid":"fb0a62a1-bcd7-4374-9326-9a3ebb0f2ff9","icon":{"id":843652,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/24x24/bb468b3810/union-horiz-alt.svg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"text":"Open, modern API","component":"IconWithText","supportingText":"Ashby's open API is a core product, designed with the same principles as the rest of the platform. "},{"_uid":"2af4754b-4a6e-490d-8052-a9a748776ef1","icon":{"id":59450942548615,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/24x25/a46132aafe/rocket-01.svg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"text":"Fast, developer-friendly experience","component":"IconWithText","supportingText":"Extensive documentation, consistent data structures, and a dedicated team of integration experts reduces time-to-build."},{"_uid":"7fd04917-0fa4-4f89-a2f0-b5e23e023413","icon":{"id":843655,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/24x24/9a98e3ef50/heart.svg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"text":"Build deeper connections","component":"IconWithText","supportingText":"Because Ashby unifies ATS, CRM, scheduling, and analytics, an integration can live across multiple workflows."},{"_uid":"887c7e98-19e7-43d0-8dde-1207ac6c8192","icon":{"id":843649,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/24x24/2143cfc2b1/page-edit.svg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"text":"Fast and responsive","component":"IconWithText","supportingText":"We move quickly, helping partners go to market in weeks, not months."},{"_uid":"e18320a5-dc62-4d18-8060-43d771a39e64","icon":{"id":843898,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/24x24/5a70e244df/agile.svg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"text":"High-demand ecosystem","component":"IconWithText","supportingText":"We actively spotlight partners in high-demand areas of our ecosystem. "}],"headline":[{"_uid":"2baf993e-d651-482c-8d06-50ef2ba882ee","icon":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"align":"left","quote":[],"section":"","headline":"Why integrate with Ashby","component":"Headline","description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"We designed our open API and partner ecosystem as first-class products, making it faster, easier, and more rewarding for partners to create integrations that customers love.","type":"text"}]}]},"headlineIsNavLink":[]}],"component":"IconGridSection","topPadding":true,"bottomPadding":true},{"_uid":"d5e740a6-1fcf-4c64-8247-2a5d6147a308","content":[{"_uid":"be05d3ac-8c1e-4094-aafc-96ebd462a08c","title":"Introduction call","component":"HeroContent","heroImage":{"id":734216,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/3840x2711/75294ce225/api-integration-docs.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"description":"We’ll reach out to schedule an introduction call. This helps us learn more about you, what you’re building, and how your product fits into our customers’ workflows. If we determine it’s not a fit, we’ll be transparent about why.\n\nAt this stage, we like to see that you have a solution that’s built and will be a seamless experience for integrating customers. \n"},{"_uid":"e598c944-0daa-4502-a712-48b99a8e8299","title":"Agreement and access","component":"HeroContent","heroImage":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"description":"Once we’ve validated your product and workflow, we’ll go through a legal review process. Once approved, we’ll provide a sandbox and technical support contacts."},{"_uid":"0d5e7115-95cf-4a71-82f4-07425ad466b9","title":"Build","component":"HeroContent","heroImage":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"description":"We’ll support you throughout the build for any technical or workflow questions."},{"_uid":"d0443073-8d0b-481e-ae5b-539a82333a7b","title":"Validation and testing","component":"HeroContent","heroImage":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"description":"Once ready, you’ll demo the integration end-to-end for our team on a live call."},{"_uid":"205cc740-e38a-40d1-ae9c-4d2d03516e50","title":"Marketplace go-live","component":"HeroContent","heroImage":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"description":"After your demo is approved, we’ll collect support and marketing assets to publish you on our Marketplace. All new partners are featured in our monthly customer newsletter via email and LinkedIn."}],"headline":[{"_uid":"1939b12a-4a3c-4067-8512-03f6ae616cc0","icon":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"align":"left","quote":[],"section":"Working with our team","headline":"Integration process","component":"Headline","description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"We have a simple and streamlined integration process for prospective partners. After you reach out to us, here’s what to expect:","type":"text"}]}]},"headlineIsNavLink":[]}],"component":"FeatureSection","heroMedia":{"id":82723767391737,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017310/1646x1148/cd96b3a221/development-cycles.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":fal