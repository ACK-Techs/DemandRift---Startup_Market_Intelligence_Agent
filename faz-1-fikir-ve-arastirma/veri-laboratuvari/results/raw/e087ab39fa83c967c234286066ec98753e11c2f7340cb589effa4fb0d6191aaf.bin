      z-index: 2;
    }

    .intergration__tabs::after {
      content: "";
      position: sticky;
      top: 0;
      right: -2rem;
      min-width: 32px;
      height: 100%;
      background: linear-gradient(-270deg, rgba(37, 77, 76, 0.5) 0%, #254D4C 100%);
      z-index: 2;
    }

