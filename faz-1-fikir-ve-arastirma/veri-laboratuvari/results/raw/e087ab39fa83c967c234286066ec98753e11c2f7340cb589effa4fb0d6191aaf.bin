document.addEventListener('DOMContentLoaded', () => {
  const mainWrapper = document.querySelector('.intergration__wrapper');
  if (!mainWrapper) return;

  const cardWrappers = mainWrapper.querySelectorAll('.intergration__cards-wrapper');
  const originalCard = document.getElementById('and-more-card');

  if (!originalCard || cardWrappers.length === 0) return;

  cardWrappers.forEach((cardsWrapper, index) => {
    let card;

    if (index === 0) {
      // Move original card into the first wrapper (and keep its id)
      card = originalCard;
    } else {
      // Clone for other wrappers
      card = originalCard.cloneNode(true);
      // remove or change id so it's unique
      card.removeAttribute('id'); 
    }

    cardsWrapper.appendChild(card); // will be last element in grid
  });
});
</script></div></header><main class="new-page-wrapper"><section class="home-hero__section"><div class="new-container padding-global"><div class="home-hero__wrapper"><div id="w-node-_2873ecc6-0863-a9ec-5313-59fe3a81c478-04d36ed4" class="home-hero__content"><h1 class="home-hero__title"><strong class="bold-text-66">Your </strong><span class="text-span-100"><strong class="bold-text-64">AI co-pilot </strong></span><strong class="bold-text-65">for software management.</strong></h1><p class="home-hero__text">Sastrify empowers IT, Procurement, and Finance teams with full visibility, automated tracking, and guaranteed ROI on their software landscape.<br/></p><div id="w-node-d7e9aeda-9303-b617-5a04-3fa8ab56cc3b-04d36ed4" class="home-hero__button-group"><a href="/schedule-demo" class="btn is--large w-button">Get a Demo</a></div></div></div></div></section><section class="companies-logo__section"><div class="new-container padding-global is--marquee"><div class="companies-logo__wrapper"><div class="track-gradient-2 is--right is--redesigned"></div><div class="track-gradient-2 is--redesigned"></div><div class="companies-logo__track"><img src="https://cdn.prod.website-files.com/61926ae506154e2b813f793d/67a5cbc19940fbc31f89af15_logo-riverty.webp" loading="lazy" alt="" class="companies-logo__image"/><img src="https://cdn.prod.website-files.com/61926ae506154e2b813f793d/679c7a8bdd83c2c4600a1357_logo-recharge.webp" loading="lazy" alt="" class="companies-logo__image"/><img src="https://cdn.prod.website-files.com/61926ae506154e2b813f793d/679c7a8b9d826171b9f69e89_logo-billie.webp" loading="lazy" alt="" class="companies-logo__image"/><img src="https://cdn.prod.website-files.com/61926ae506154e2b813f793d/679c7a8b8198ca36a35b2675_logo-billie-1.webp" loading="lazy" alt="" class="companies-logo__image"/><img src="https://cdn.prod.website-files.com/61926ae506154e2b813f793d/679c7a8cdd83c2c4600a13dd_logo-urban.webp" loading="lazy" alt="" class="companies-logo__image"/><img src="https://cdn.prod.web