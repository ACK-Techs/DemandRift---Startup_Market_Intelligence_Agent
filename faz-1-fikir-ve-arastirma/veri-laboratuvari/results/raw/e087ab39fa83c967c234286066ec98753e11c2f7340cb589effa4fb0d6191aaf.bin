  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.querySelector('.hamburger') || document.querySelector('.w-nav-burger');
    const hamburgerButton = document.querySelector('.w-nav-button') || document.querySelector('[data-collapse="medium"]');
    const mobileMenu = document.querySelector('.navigation__menu-mobile') || document.querySelector('.w-nav-menu');

    if (hamburgerButton) {
      // Add direct click handler to the button
      hamburgerButton.addEventListener('click', (e) => {
        console.log('Button clicked!');

        if (hamburger) {
          hamburger.classList.toggle('active');
        }

        if (mobileMenu) {
          mobileMenu.classList.toggle('mobile-flex');
        }

        // Prevent any default behaviors or event propagation issues
        e.preventDefault();
        e.stopPropagation();
      });
    }

    // Remove 'mobile-flex' class when resizing the window
    window.addEventListener('resize', () => {
      if (window.innerWidth > 767) {
        if (mobileMenu) {
          mobileMenu.classList.remove('mobile-flex');
        }
        if (hamburger) {
          hamburger.classList.remove('active');
        }
      }
    });
  });
</script></div></div></div><div class="hide w-embed"><style>
