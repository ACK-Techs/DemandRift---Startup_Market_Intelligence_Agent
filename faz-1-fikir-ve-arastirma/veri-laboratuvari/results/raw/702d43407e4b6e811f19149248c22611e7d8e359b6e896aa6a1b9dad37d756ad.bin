px_8px_rgba(0,0,0,0.1)] md:mb-0 md:w-full"/></div><div class="w-full text-[14px] leading-[20px] md:w-3/4 md:pl-[30px] lg:pr-[50px]"><div class="mr-[5px] inline rounded-[5px] bg-black/[0.06] p-[5px] text-[16px] leading-[20px] opacity-50">Online Course</div><h3 class="mt-[15px] mb-[10px] text-[30px] font-extrabold leading-[30px] text-ink md:text-[36px] md:leading-[44px]">Pre-Sell to Validate</h3><p class="mb-[15px] text-[20px] leading-[30px] text-ink-2">In this course, you&#x27;ll learn the exact framework I&#x27;ve used to validate several startup ideas. Forget about customer interviews and waitlists; pre-sales are the key validation indicator.</p><a href="https://failory.podia.com/pre-sales" target="_blank" rel="noopener noreferrer nofollow" class="mt-[15px] inline-block w-full rounded-[5px] bg-ink px-[15px] py-[17px] text-center text-[16px] font-bold leading-[22px] text-white min-[480px]:w-auto min-[480px]:px-[30px] md:mt-0">Get Pre-Sell to Validate for $250<!-- --> </a></div></div><div class="my-5 flex flex-col items-center bg-black/[0.04] px-[15px] py-10 text-center hover:scale-[1.02] md:my-[30px] md:flex-row md:text-left lg:mb-[50px] lg:px-[30px] lg:py-[50px]"><div class="w-full md:w-1/4 md:px-[10px]"><img src="https://p9hrvc3hnid3jlgq.public.blob.vercel-storage.com/img/624320ecff72950652d28f70_1-min-f0c08ef4.webp" alt="Product-Market Fit eBook" loading="lazy" class="mb-[30px] inline-block w-[200px] shadow-[1px_1px_8px_rgba(0,0,0,0.1)] md:mb-0 md:w-full"/></div><div class="w-full text-[14px] leading-[20px] md:w-3/4 md:pl-[30px] lg:pr-[50px]"><div class="mr-[5px] inline rounded-[5px] bg-black/[0.06] p-[5px] text-[16px] leading-[20px] opacity-50">eBook</div><h3 class="mt-[15px] mb-[10px] text-[30px] font-extrabold leading-[30px] text-ink md:text-[36px] md:leading-[44px]">Product-Market Fit eBook</h3><p class="mb-[15px] text-[20px] leading-[30px] text-ink-2">Our eBook will explain you the concept of Product-Market Fit, how to measure it and the exact strategies used by Slack, Intercom, AirBnB, and more, to achieve it.</p><a href="/product-market-fit" class="mt-[15px] inline-block w-full rounded-[5px] bg-ink px-[15px] py-[17px] text-center text-[16px] font-bold leading-[22px] text-white min-[480px]:w-auto min-[480px]:px-[30px] md:mt-0">Get the PMF eBook for $15<!-- --> </a></div></div></section><section><h2 class="section-h2 mt-[75px]">Data</h2><div class="my-5 flex flex-col items-center bg-black/[0.04] px-[15px] py-10 text-center hover:scale-[1.02] md:my-[30px] md:flex-row md:text-left lg:mb-[50px] lg:px-[30px] lg:py-[50px]"><div class="w-full md:w-1/4 md:px-[10px]"><img src="https://p9hrvc3hnid3jlgq.public.blob.vercel-storage.com/img/639a3a5cb0ff26b0017b74cc_unicorns-lead-magnet-0aa67c74.webp" alt="1,190 Unicorn Companies" loading="lazy" class="mb-[30px] inline-block w-[200px] shadow-[1px_1px_8px_rgba(0,0,0,0.1)] md:mb-0 md:w-full lg:w-[220px] lg:max-w-full"/></div><div class="w-full text-[14px] leading-[20px] md:w-3/4 md:pl-[30px] lg:pr-[50px]"><div class="mr-[5px] inline rounded-[5px] bg-black/[0.06] p-[5px] text-[16px] leading-[20px] opacity-50">Sheet</div><h3 class="mt-[15px] mb-[10px] text-[30px] font-extrabold leading-[30px] text-ink md:text-[36px] md:leading-[44px]">1,190 Unicorn Companies</h3><p class="mb-[15px] text-[20px] leading-[30px] text-ink-2">This sheet contains all the information about the top 1,190 unicorns, including their valuation, HQ&#x27;s location, founded year, name of founders, funding amount and number of employees.</p><a href="/unicorns-list" class="mt-[15px] inline-block w-full rounded-[5px] bg-ink px-[15px] py-[17px] text-center text-[16px] font-bold leading-[22px] text-white min-[480px]:w-auto min-[480px]:px-[30px] md:mt-0">Get the Sheet for $25<!-- --> <span class="line-through">$50</span></a></div></div><div class="mt-[15px] mb-[50px] flex flex-col items-center gap-x-[30px] bg-black/[0.04] py-[30px] text-center hover:scale-[1.02] md:flex-row md:px-[30px] md:text-left"><div class="w-full md:w-[calc((100%-30px)*0.25)] md:px-[10px]"><img src="https://p9hrvc3hnid3jlgq.public.blob.vercel-storage.com/img/65de3f1213bc3d6f69b7ddf4_fundraising-os-website-image-768fedb3.webp" alt="Fundraising OS" loading="lazy" class="mb-[30px] inline-block w-[200px] shadow-[1px_1px_8px_rgba(0,0,0,0.1)] md:mb-0 md:w-full"/></div><div class="w-full text-[14px] leading-[20px] md:w-[calc((100%-30px)*0.75)] md:pl-[10px] md:pr-[50px]"><div class="mr-[5px] inline rounded-[5px] bg-black/[0.06] p-[5px] text-[16px] leading-[20px] opacity-50">Tool</div><h3 class="mt-[15px] mb-[10px] text-[30px] font-extrabold leading-[30px] text-ink md:text-[36px] md:leading-[44px]">Fundraising OS</h3><p class="mb-[15px] text-[20px] leading-[30px] text-ink-2">Everything you need to raise funding for your startup, including 3,500+ investors, 7 tools, 18 templates and 3 learning resources.</p><a href="https://newsletter.failory.com/c/fundraising-os" target="_blank" rel="noopener noreferrer" class="mt-[15px] inline-block w-full rounded-[5px] bg-ink px-[15px] py-[17px] text-center text-[16px] font-bold leading-[22px] text-white min-[480px]:w-auto min-[480px]:px-[30px] md:mt-0">Buy It For $97<!-- --> <span class="line-through">$297</span><span> <!-- -->→</span></a></div></div></section></div><section class="mt-[100px] bg-light-black"><div class="site-container pt-[75px] pb-[70px]"><h2 class="mb-5 text-[40px] font-extrabold leading-[40px] text-white md:text-[50px] md:leading-[60px]">The <span class="underline">All-In-One</span> Newsletter for Startup Founders</h2><p class="mb-5 text-[20px] leading-[30px] text-white/60">90% of startups fail. Learn how not to with our weekly guides and stories.<!-- --> <strong class="text-white">Join +40,000 other startup founders!</strong></p><div class="mb-[15px]"><form class="flex w-full flex-col items-center gap-4 min-[480px]:flex-row min-[480px]:items-stretch"><input type="email" required="" maxLength="256" autoComplete="email" placeholder="Enter your best email" class="h-[55px] w-full min-w-0 px-[15px] max-[479px]:mb-[10px] max-[479px]:px-5 min-[480px]:mr-[10px] min-[480px]:flex-1 rounded-[5px] border-2 border-[#2d2d2d] bg-[#1a1a1a] text-[16px] font-normal text-white outline-none placeholder:text-[#999]" name="Email" value=""/><button type="submit" class="w-full shrink-0 px-[30px] py-[17px] max-[479px]:px-[15px] min-[480px]:w-auto cursor-pointer rounded-[5px] bg-white text-[16px] leading-5 font-bold text-ink hover:bg-white/90 disabled:opacity-60">Subscribe For Free →</button><div class="empty:hidden"></div></form></div></div></section><!--$--><!--/$--></main><footer class="border-t-[3px] border-light-black bg-ink"><div class="mx-auto max-w-[1150px] px-5 py-[50px] max-md:py-[30px] max-[480px]:px-[10px]"><div class="md:-mx-[10px] md:flex"><div class="flow-root px-[10px] md:w-[41.6667%]"><div class="mb-[15px] flex items-center"><img src="/brand/failory-white-icon.svg" alt="Failory white logo" width="23" height="30" loading="lazy" decoding="async" class="mr-2.5 h-[30px] w-[22.8px]"/><span class="text-[20px] font-extrabold leading-[30px] text-white">Failory</span></div><p class="mb-2.5 text-[16px] leading-6 text-white/60 max-[479px]:mb-5">An all-in-one newsletter for startup founders, ruled by one philosophy: there&#x27;s more to learn from failures than from successes.</p></div><div class="flow-root px-[10px] md:w-[58.3333%]"><div class="-mx-[10px] flex flex-wrap"><div class="w-full flow-root px-[10px] md:w-1/2"><p class="mb-2.5 text-[20px] font-bold leading-5 text-white max-md:mt-5">Learn</p><div class="-mx-[10px] min-[480px]:flex"><div class="flow-root px-[10px] min-[480px]:w-1/2"><a class="mb-2.5 block text-[16px] leading-5 text-white/60 hover:text-white" href="/interviews">Interviews</a><a class="mb-2.5 block text-[16px] leading-5 text-white/60 hover:text-white" href="/blog">Blog</a><a class="mb-2.5 block text-[16px] leading-5 text-white/60 hover:text-white" href="/podcast">Podcast</a><a class="mb-2.5 block text-[16px] leading-5 text-