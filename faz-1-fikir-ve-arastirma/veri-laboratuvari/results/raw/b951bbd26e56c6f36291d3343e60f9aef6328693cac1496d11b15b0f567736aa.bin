            column-gap: 10px;
            grid-template-columns: repeat(4, max-content);
            justify-content: space-between;
        }



        @media screen and (max-width: 1080px) {
            .saasbox-footer-wrap .footer-middle {
                grid-template-columns: repeat(3, max-content);
