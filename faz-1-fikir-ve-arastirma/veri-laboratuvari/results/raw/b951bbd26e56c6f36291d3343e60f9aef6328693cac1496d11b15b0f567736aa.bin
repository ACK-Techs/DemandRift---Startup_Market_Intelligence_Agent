<div class="iframe-loading">
    <svg viewBox="25 25 50 50" class="circular">
        <circle cx="50" cy="50" r="20" fill="none" class="path"></circle>
    </svg>
</div>
<div class="load-tip-box">
    <img src="http://static-global.zingfront.com/common/img/empty.svg" alt="">
    <p style="">Request timed out, please refresh the page and try again.</p>
    <a href="javascript: window.location.reload();" class="load-tip-btn">Refresh Now</a>
</div>
<script charset="utf-8" src="https://zbase-global.zingfront.com/zbase/js/iframe-transfer-layout.js"
        type="text/javascript"></script>
<script src="https://static-global.zingfront.com/common/js/jszip.js"></script>
<script src="https://static-global.zingfront.com/common/js/fileSaver.js"></script>
<script>
    var inUrlList = "";
    var inUrlListAdideas = "";
    var inUrlListUser = "";
    var user_id = "";
    function getNowFormatDate() {
        let date = new Date();
        let month = date.getMonth() + 1;
        let strDate = date.getDate();
        if (month >= 1 && month <= 9) {
            month = '0' + month;
        }
        if (strDate >= 0 && strDate <= 9) {
            strDate = '0' + strDate;
        }
        let currentdate = date.getFullYear() + '-' + month + '-' + strDate;
        return currentdate;
    };
    function num() {
        let mm = Math.random();
        let six = '';
        if (mm > 0.1) {
            six = Math.round(mm * 1000000);
        } else {
            mm += 0.1;
            six = Math.round(mm * 1000000);
        }
        return six;
    };
    function getExtension(fileName) {
        return fileName.includes('.') ? `.${fileName.split('.').pop()}` : ''
    };
    function asyncPool(dataItem,poolLimit, array, getFile) {
        // let downloadData = []
        // if ( window.localStorage.getItem('downloadData')) {
        //     downloadData = JSON.parse(window.localStorage.getItem('downloadData'));
        // } else {
        //     window.localStorage.setItem('downloadData',JSON.stringify([]));
        // }
        let i = 0;
        let ret = []; // 存储所有的异步任务
        let executing = []; // 存储正在执行的异步任务
        let zip = new JSZip();
        let cache = {};
        let numcount = 0;
        let enqueue = function () {
            if (i === array.length) {
            return Promise.resolve();
            }
            let item = array[i++]; // 获取新的任务项
            let p = Promise.resolve().then(() => getFile(item.url).then(data => {
                let arr = item.url.split('/');
                let arrType = arr[arr.length - 1].split('.')[1];
                let file_name =  (dataItem.advertiser_name ? dataItem.advertiser_name.split('.').join('') : dataItem.advertiser_id.split('.').join('')) + (dataItem.ad_width ? '-' + dataItem.ad_width +' X ' +  dataItem.ad_height : '') + '-' + getNowFormatDate() + '-' + num() + (item.domain == 1 ? '-' + 'Main Ads' : '') + '.' + arrType;
                zip.file(file_name, data, { binary: true });
                cache[file_name] = data;
                let oneNum = (100 / array.length).toFixed(2)
                numcount += oneNum * 1;
                if (numcount == 100) {
                    numcount = 99
                }
                // dataItem.downloadNumber += oneNum * 1
                // if (downloadData != '') {
                //     for (let i = 0; i < downloadData.length; i++) {
                //         if (downloadData[i].ad_key == dataItem.ad_key) {
                //             downloadData[i].downloadCount = dataItem.downloadNumber;
                //             window.localStorage.setItem('downloadData',JSON.stringify(downloadData));
                //             break;
                //         } else if (i == downloadData.length -1 && downloadData[i].ad_key != dataItem.ad_key) {
                //             downloadData.push({
                //                 ad_key: dataItem.ad_key,
                //                 downloadCount: dataItem.downloadNumber
                //             })
                //             window.localStorage.setItem('downloadData',JSON.stringify(downloadData));
                //         }
                //     }
                // } else {
                //     downloadData.push({
                //         ad_key: dataItem.ad_key,
                //         downloadCount: dataItem.downloadNumber
                //     })
                //     window.localStorage.setItem('downloadData',JSON.stringify(downloadData));
                // }
                document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'downloadNum',number:numcount}, '*');
            }));
            ret.push(p);

            let r = Promise.resolve();

            // 当poolLimit值小于或等于总任务个数时，进行并发控制
            if (poolLimit <= array.length) {
            // 当任务完成后，从正在执行的任务数组中移除已完成的任务
            let e = p.then(() => executing.splice(executing.indexOf(e), 1));
            executing.push(e);
            if (executing.length >= poolLimit) {
                r = Promise.race(executing);
            }
            }

            // 正在执行任务列表 中较快的任务执行完成之后，才会从array数组中获取新的待办任务
            return r.then(() => enqueue());
        };
        return enqueue().then(() => Promise.all(ret).then(() => {
            zip.generateAsync({ type: 'blob' }).then(content => {
                            // 生成二进制流
                            // FileSaver.saveAs(content, '文件下载.zip') // 利用file-saver保存文件  自定义文件名
                 saveAs( (dataItem.advertiser_name ? dataItem.advertiser_name.split('.').join('') : dataItem.advertiser_id.split('.').join(''))  + '-' + getNowFormatDate() + '-' + num(), content);
                //saveAs(content, (dataItem.advertiser_name ? dataItem.advertiser_name.split('.').join('') : dataItem.advertiser_id.split('.').join(''))  + '-' + getNowFormatDate() + '-' + num()); // 利
                //用file-saver保存文件  自定义文件名
                document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'downloadNum',number: 100}, '*');
                document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'isDownloadAllTwo'}, '*');
            });    
            }));
    }
    function saveAs( name, blob ) {
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.download = name || Math.random();
        a.href = blobUrl;
        a.click();
        URL.revokeObjectURL(blob);
    }
    function handleDownload(dataItem, arr) {
        let zip = new JSZip();
        let cache = {};
        let promises = [];
        arr.forEach(item => {
    
            let promise = this.getFile(item.url).then(data => {
                let arr = item.url.split('/');
                let arrType = arr[arr.length - 1].split('.')[1];
                let file_name =  (dataItem.advertiser_name ? dataItem.advertiser_name.split('.').join('') : dataItem.advertiser_id.split('.').join('')) + (dataItem.ad_width ? '-' + dataItem.ad_width + ' X ' +  dataItem.ad_height : '') + '-' + getNowFormatDate() + '-' + num() + (item.domain == 1 ? '-' + 'Main Ads' : '') + '.' + arrType;
                zip.file(file_name, data, { binary: true });
                cache[file_name] = data;
            });
            promises.push(promise);
        });
        Promise.all(promises).then(() => {
            zip.generateAsync({ type: 'blob' }).then(content => {
                // 生成二进制流
                // FileSaver.saveAs(content, '文件下载.zip') // 利用file-saver保存文件  自定义文件名
                saveAs(content, (dataItem.advertiser_name ? dataItem.advertiser_name.split('.').join('') : dataItem.advertiser_id.split('.').join(''))  + '-' + getNowFormatDate() + '-' + num()); // 利用file-saver保存文件  自定义文件名
            });
            // this.isDownloadAllTwo = false;
            document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'isDownloadAllTwo'}, '*');
        });
    // this.isDownloadAllTwo = false;
    };
    function getFile(url) {
        return new Promise((resolve, reject) => {
            $.ajax({
                method: 'get',
                url,
                responseType: 'blob'
                // responseType: 'arraybuffer'
            })
                .then(data => {
                    resolve(data);
                })
                .catch(error => {
                    reject(error.toString());
                });
        });
    };
    $(document).ready(function () {
        let isIframeLoad = false;
        let iframeTimeout = false;
        window.addEventListener('message', function (e) {
            let data = e.data;
            if (data.message_type == 'iframeLoad' && data.status == 200) {
                isIframeLoad = true;
                $('.iframe-loading').hide();
                if(!iframeTimeout) {
                    $('#iframe-transfer-content iframe').show();
                }
            }
            // sendGA
            if (data.message_type == 'sendGA') {
                if (data.label) {
                    gtag('event', data.handle, { event_category: data.category, event_label: data.label });
                } else {
                    gtag('event', data.handle, { event_category: data.category });
                }
            }
            // reload
            if (data.message_type == 'iframeReload') {
                window.location.reload();
            }
            // login
            if (data.message_type == 'smbLogout') {
                window.location.href = '/user/login';
            }
            // sign
            if (data.message_type == 'smbRegister') {
                window.location.href = '/user/register';
            }
            // href url
            if (data.message_type == 'iframeJump' && data.url) {
                window.location.href = data.url;
            }
            // zbase
            if (data.message_type == 'smbPopup' && data.code) {
                callZbasePopupOpen(data.code);
            }
            // sassbox nav banner
            if (data.message_type == 'openSaasboxNavBanner') {
                saasboxOpenNavBanner(data.placeholder1);
            }
            //sassbox nav height
            if (data.message_type == 'smbNavHeight' && data.tab) {
                $('.nav-hover').removeClass('nav-actived');
                $(`.nav-hover a[href= '${data.tab}']`)
                    .parent()
                    .addClass('nav-actived'); //导航栏选中
            }
            //ga
            if (data.message_type == 'gtag') {
                gtag('event', data.type ? data.type : '', {
                    event_category: data.event_category, 
                    event_label: data.event_label,
                    value: data.value ? data.value : ''
                });
            }
            if (data.message_type == 'contactUs') {
                if (typeof ssq !== 'undefined' && ssq !== null) {
                    ssq.push('chatOpen');
                } else {
                    $crisp.push(['do', 'chat:open']);
                }
            }

            if (data.message_type == 'downAds') {
                data.data.resource_urls.map((item, index) => {
                    let xhr = new XMLHttpRequest();
                    if (data.activeCard && data.activeCard == 2) {
                        xhr.open('get', data.data.html_url);
                    } else {
                        if (item.type == 1) {
                            xhr.open('get', item.image_url);
                        } else {
                            xhr.open('get', item.video_url);
                        }
                    }
                    xhr.responseType = 'blob';
                    xhr.onload = (e) => {
                        let mp4 = xhr.response;
                        let mu = URL.createObjectURL(mp4);
                        let doc = document;
                        let a = doc.createElement('a');
                        a.href = mu;
                        a.download =
                              (data.data.advertiser_name
                                ? data.data.advertiser_name.split('.').join('')
                                : data.data.advertiser_id.split('.').join('')) +
                            (data.data.ad_width
                                ? '-' + data.data.ad_width + ' X ' + data.data.ad_height
                                : '') +
                            '-' +
                            getNowFormatDate() +
                               '-' +
                            num() +
                            (data.imgData.length > 0 ? '-' + 'Main Ads' : '') +
                       
                            getExtension(e.target.responseURL);
                        a.click();
                        // this.isDownload = false;
                        document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'isDownload'}, '*');
                    };
                    xhr.send();
                });
            }
            if (data.message_type == 'downAdsOne') {

                let xhr = new XMLHttpRequest();
                if (data.data.resource_urls[data.activeIndex].video_url) {
                    xhr.open('get', data.data.resource_urls[data.activeIndex].video_url);
                } else {
                    xhr.open('get', data.data.resource_urls[data.activeIndex].image_url);
                }
                xhr.responseType = 'blob';
                xhr.onload = (e) => {
                    let mp4 = xhr.response;
                    let mu = URL.createObjectURL(mp4);
                    let doc = document;
                    let a = doc.createElement('a');
                    a.href = mu;
                    a.download =   
                            (data.data.advertiser_name
                            ? data.data.advertiser_name.split('.').join('')
                            : data.data.advertiser_id.split('.').join(''))+                   
                        (data.data.ad_width
                            ? '-' + data.data.ad_width + ' X ' + data.data.ad_height
                            : '') +
                        '-' +
                        getNowFormatDate() +
                          '-' +
                        num() +
                        (data.imgData.length > 0 ? '-' + 'Main Ads' : '') +
              
                        getExtension(e.target.responseURL);
                        
                    a.click();
                    // this.isDownload = false;
                    document.getElementById('zbaseiframe').contentWindow.postMessage({ data: 'isDownload'}, '*');
                };
                xhr.send();
            }
            if (data.message_type == 'xhrAjax') {
                this.asyncPool(data.data, 5 , data.arr, this.getFile);
            }
        }, false);
        let timer30 = setTimeout(() => {
            if(!isIframeLoad) {
                iframeTimeout = true;
                $('.iframe-loading').hide();
                $('.load-tip-box').show();
                gtag('event', 'load', { event_category: 'iframe_load', event_label: 'iframe_load_timeout' });
            }
            clearTimeout(timer30);
        }, 30000);
        $('#layout-footer a').click(function (e) {
            if(e.preventDefault) {
                e.preventDefault();
            } else {
                window.event.returnValue == false;
            }
            let url = $(this).attr('href');
            if (url.indexOf(document.domain) != -1 || url[0] == '/') {
                window.parent.postMessage({ message_type: 'iframeJump', url: url }, '*');
            } else {
                window.open(url);
            }
        })
    });
</script>
</div>
