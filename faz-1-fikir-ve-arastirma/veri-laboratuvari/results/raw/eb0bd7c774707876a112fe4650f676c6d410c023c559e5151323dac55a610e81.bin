						</article>
												<article class="m27__post-item">
						<a href="https://www.openbanking.org.uk/insights/latest-impact-report-shows-strong-growth-and-the-power-of-payments/" target="_self" class="m27__single-item__link">

														<figure class="m27__single-item__media">
									<picture>
									<source data-srcset="https://www.openbanking.org.uk/wp-content/uploads/Impact-Report-March-2024-feature-image.png" media="(min-width: 768px)" />
									<source data-srcset="https://www.openbanking.org.uk/wp-content/uploads/Impact-Report-March-2024-feature-image.png" media="(min-width: 375px)" />
