												<article class="m27__post-item">
						<a href="https://www.openbanking.org.uk/news/smart-data-forum-keynote-spotlight-on-the-open-banking-roadmap/" target="_self" class="m27__single-item__link">

														<figure class="m27__single-item__media">
									<picture>
									<source data-srcset="https://www.openbanking.org.uk/wp-content/uploads/SDF3a-1024x768.jpg" media="(min-width: 768px)" />
									<source data-srcset="https://www.openbanking.org.uk/wp-content/uploads/SDF3a-768x576.jpg" media="(min-width: 375px)" />
