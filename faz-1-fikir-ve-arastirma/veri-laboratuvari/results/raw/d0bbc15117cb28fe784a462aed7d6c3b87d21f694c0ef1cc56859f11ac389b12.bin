,\"values\":[{\"value\":null,\"id\":5295,\"sortOrder\":0,\"cultureCode\":\"tr-TR\"}],\"collectionItems\":{\"items\":[{\"tarih\":\"2026-08-29\",\"etiket\":\"Kutlama\",\"aciklama\":\"30 Ağustos Zafer Bayramı’mız kutlu olsun\",\"belgeListesi\":[{}],\"haberBaslik\":\"30 Ağustos Zafer Bayramı\",\"gorselListesi\":[{}],\"haberIcerigi\":\"\u003cp class=\\\"ql-align-justify\\\"\u003eBir milletin bağımsızlığından vazgeçmeyeceğini tarihe ilan ettiği Büyük Zafer’in üzerinden 104 yıl geçti.\u003c/p\u003e\u003cp class=\\\"ql-align-justify\\\"\u003eGazi Mustafa Kemal Atatürk’ün başkomutanlığında kazanılan 30 Ağustos Zaferi’nin yıl dönümünde aziz şehitlerimizi rahmetle, kahraman gazilerimizi minnetle anıyoruz.\u003c/p\u003e\u003cp class=\\\"ql-align-justify\\\"\u003e30 Ağustos Zafer Bayramı’mız kutlu olsun.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/101416/view\",\"downloadPath\":\"/media-library/bac7095ec8b14c6fba8220cfb766aacf.jpeg\",\"mediaUrl\":\"/media-library/bac7095ec8b14c6fba8220cfb766aacf.jpeg\",\"fileName\":\"WhatsApp Image 2026-08-28 at 10.36.55.jpeg\",\"name\":\"WhatsApp Image 2026-08-28 at 10.36.55\"},\"slug\":\"mansetler/30-agustos-zafer-bayrami\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-06-10\",\"etiket\":\"Forum\",\"aciklama\":\"3–6 Haziran 2026 tarihleri arasında Rusya’nın St. Petersburg kentinde düzenlenen 29. St. Petersburg Uluslararası Ekonomik Forumu’nda (SPIEF), Genel Müdürümüz Hakan Gedikli konuşmacı olarak yer aldı.\",\"belgeListesi\":[{}],\"haberBaslik\":\"St. Petersburg Uluslararası Ekonomik Forumu\",\"gorselListesi\":[{}],\"haberIcerigi\":\"$46\",\"haberKartGorseli\":{\"storagePath\":\"/media/101174/view\",\"downloadPath\":\"/media-library/463bc70af33744dfb3c264858fcca913.webp\",\"mediaUrl\":\"/media-library/463bc70af33744dfb3c264858fcca913.webp\",\"fileName\":\"petersburg-webp.webp\",\"name\":\"petersburg-webp\"},\"slug\":\"mansetler/st-petersburg-uluslararasi-ekonomik-forumu\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-06-05\",