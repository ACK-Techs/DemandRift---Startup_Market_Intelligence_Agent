0.2859V36.8522H67.3642V30.3947C67.3642 29.298 66.7369 28.7414 65.7793 28.7414C64.8217 28.7414 64.1315 29.3284 64.1315 30.5174V36.8509H60.427V30.3934C60.427 29.2967 59.8615 28.7402 58.9669 28.7402C58.0722 28.7402 57.4437 29.3271 57.4437 30.5161V36.8497H53.7393V26.0357H57.319V27.1172C57.9784 26.252 58.999 25.7891 60.3486 25.7891C61.6983 25.7891 62.7972 26.2837 63.4721 27.2412C64.2574 26.2685 65.4811 25.7891 66.9104 25.7891C69.5004 25.7891 71.0699 27.35 71.0699 30.2846L71.0686 30.2859Z' fill='black'\u003e\u003c/path\u003e\n\u003cpath d='M83.3758 26.0381V36.852H79.7806V35.6934C79.0736 36.5889 78.0543 37.0987 76.7355 37.0987C74.1764 37.0987 72.6699 35.3834 72.6699 32.2945V26.0381H76.3744V32.187C76.3744 33.5468 77.0183 34.1489 77.9759 34.1489C78.9335 34.1489 79.6713 33.5 79.6713 32.063V26.0381H83.3758ZM74.8358 23.9219C74.8358 23.1034 75.4476 22.5469 76.2484 22.5469C77.0492 22.5469 77.661 23.1034 77.661 23.9219C77.661 24.7403 77.0492 25.2817 76.2484 25.2817C75.4476 25.2817 74.8358 24.7415 74.8358 23.9219ZM78.3204 23.9219C78.3204 23.1034 78.9322 22.5469 79.733 22.5469C80.5338 22.5469 81.1456 23.1034 81.1456 23.9219C81.1456 24.7403 80.5338 25.2817 79.733 25.2817C78.9322 25.2817 78.3204 24.7415 78.3204 23.9219Z' fill='black'\u003e\u003c/path\u003e\n\u003cpath d='M94.9446 34.1026V36.8526H84.8506V34.8438L86.8442 32.5733H85.6359V30.1016H89.0113L90.1733 28.7734H85.0241V26.0234H94.7106V28.0322L92.843 30.1636H93.942V32.6353H90.6772L89.3892 34.1026H94.9459H94.9446Z' fill='black'\u003e\u003c/path\u003e\n\u003cpath d='M106.028 36.1407C104.866 36.7277 103.107 37.0983 101.381 37.0983C97.5816 37.0983 95.6201 35.6929 95.6201 33.731C95.6201 32.6495 96.232 31.7387 97.3464 31.2593C96.498 30.7964 96.0751 30.0235 96.0751 29.1583C96.0751 27.3975 97.786 25.791 101.601 25.791C103.124 25.791 104.615 26.0693 105.714 26.5019L104.709 29.1595C103.658 28.7421 102.7 28.5726 101.742 28.5726C100.393 28.5726 99.8117 28.8977 99.8117 29.391C99.8117 29.792 100.062 30.0551 100.832 30.0551H104.051V32.7431H100.582C99.7346 32.7431 99.3567 33.0366 99.3567 33.4844C99.3567 33.9789 99.9531 34.3192 101.523 34.3192C102.606 34.3192 103.971 34.0106 104.944 33.5008L106.028 36.142V36.1407Z' fill='black'\u003e\u003c/path\u003e\n\u003c/g\u003e\n\u003cdefs\u003e\n\u003cclipPath id='clip0_3806_23818'\u003e\n\u003crect width='108.384' height='46.7402' fill='white'\u003e\u003c/rect\u003e\n\u003c/clipPath\u003e\n\u003c/defs\u003e\n\u003c/svg\u003e\n"])</script><script>self.__next_f.push([1,"56:T823,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-align-justify\"\u003e3–6 Haziran 2026 tarihleri arasında Rusya’nın St. Petersburg kentinde düzenlenen 29. St. Petersburg Uluslararası Ekonomik Forumu’nda (SPIEF), Genel Müdürümüz Hakan Gedikli konuşmacı olarak yer aldı.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eGedikli, forum kapsamında gerçekleştirilen “Mekânsal Gelişimin Ülkenin Değerinin ve Rekabet Gücünün Artırılmasındaki Rolü” başlıklı oturumda Türkiye’nin tapu ve kadastro sistemi, dijital dönüşüm çalışmaları, mekânsal veri altyapıları ve kurumumuz tarafından yürütülen güncel projelere ilişkin sunum gerçekleştirdi.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eSunumda özellikle üç boyutlu şehir modelleri, üç boyutlu kadastro uygulamaları ve elektronik sicile geçiş sürecine ilişkin çalışmalar ele alındı. Bu alanlardaki uygulamalar ve edinilen tecrübeler uluslararası katılımcılar tarafından ilgiyle takip edildi.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eOturumda ayrıca Rusya Kadastro Kurumu Başkanı, Rusya Federasyonu İnşaat, Konut ve Kamu Hizmetleri Bakanı, Rusya Federasyonu Ekonomik Kalkınma Bakan Yardımcısı ile Suudi Arabistan, Azerbaycan ve Özbekistan’ın kadastro kurumlarının üst düzey temsilcileri de konuşmacı olarak yer aldı.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eOturum sonrasında, özellikle dijital kadastro uygulamaları ve mekânsal veri yönetimi alanlarında kurumumuzun deneyimlerine yönelik görüş alışverişinde bulunuldu. Katılımcılarla bu alanlarda iş birliği imkânları ve ortak çalışma fırsatları değerlendirildi.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eYoğun katılımla gerçekleştirilen oturum, mekânsal gelişim, arazi yönetimi ve dijital dönüşüm alanlarında ülkeler arasındaki bilgi ve tecrübe paylaşımına katkı sunarken, Türkiye’nin bu alanlardaki çalışmalarının uluslararası düzeyde tanıtılmasına da katkı sağladı.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"57:Taac,"])</script><script>self.__next_f.push([1,"\u003cp\u003eTapu ve Kadastro Genel Müdürlüğümüz, 179 yıldır devletimizin hafızasını taşıyan en köklü kurumlardan biri olarak, geçmişten aldığı tecrübeyi geleceğin vizyonuyla birleştiren güçlü bir kurumsal mirasa sahiptir.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eMülkiyetin güvence altına alınmasından mekânsal veri üretimine, arşiv mirasımızın korunmasından dijital hizmet altyapılarının geliştirilmesine kadar geniş bir sorumluluk alanında faaliyet gösteren Genel Müdürlüğümüz; bugün, teknolojiyi merkeze alan güçlü dönüşüm süreciyle kamu hizmetlerinde yeni dönemin öncülerinden biri haline gelmiştir.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eWeb Tapu, TAKBİS, MEGSİS, Parsel Sorgu, üç boyutlu şehir modelleri ve dijital kadastro uygulamalarıyla vatandaşlarımızın hizmetlere daha hızlı, güvenli ve şeffaf şekilde erişimini sağlıyor; aynı zamanda Türkiye’nin mekânsal veri altyapısını daha güçlü bir yapıya kavuşturuyoruz.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eBugün ulaştığımız seviye, ülkemiz ölçeğinde olduğu kadar uluslararası alanda da dikkatle takip edilen bir dönüşüm modelini ortaya koymaktadır. Azerbaycan’dan KKTC’ye uzanan iş birlikleri, bilgi paylaşımı programları ve teknik projelerle Tapu ve Kadastro Genel Müdürlüğümüz, sahip olduğu kurumsal birikimi dost ve kardeş ülkelerle paylaşmayı sürdürmektedir.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e“Türkiye’ye Gelecek, Dünyaya Model” anlayışıyla geliştirdiğimiz sistemler ve dijital uygulamalar, birçok ülke tarafından örnek alınan güçlü bir kamu teknolojisi altyapısına dönüşmüştür.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e179 yıllık bu büyük mirası geleceğe taşırken; Çevre, Şehircilik ve İklim Değişikliği Bakanımız Sayın Murat Kurum’un ortaya koyduğu şehircilik ve dijital dönüşüm vizyonu doğrultusunda, köklü devlet geleneğimizi modern teknolojiyle buluşturmaya, vatandaş odaklı hizmet anlayışımızı güçlendirmeye ve ülkemizin dijital dönüşüm sürecine katkı sunmaya kararlılıkla devam ediyoruz.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eCumhurbaşkanımız Sayın Recep Tayyip Erdoğan’ın liderliğinde şekillenen Türkiye Yüzyılı vizyonu doğrultusunda; Tapu ve Kadastro Genel Müdürlüğü olarak, güçlü teknolojik altyapımız, nitelikli insan kaynağımız ve yenilikçi yaklaşımımızla ülkemize değer üretmeyi sürdüreceğiz.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eBu anlamlı yıl dönümünde, kuruluşumuzdan bugüne kurumumuza emek veren tüm mensuplarımıza şükranlarımı sunuyor; Tapu ve Kadastro Genel Müdürlüğümüzün 179. kuruluş yıl dönümünü en içten duygularımla kutluyorum.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"58:T718,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eTapu ve Kadastro Genel Müdürlüğümüz, geliştirdiği yenilikçi projelerle dijital dönüşüm alanındaki başarılarına bir yenisini daha ekledi. Türkiye Bilişim Derneği tarafından “Teknolojiyle Güçlenen Türkiye” temasıyla düzenlenen Türkiye Bilişim Ödülleri 2025 kapsamında, Kurumumuz “Yeni Çipli T.C. Kimlik Kartları ve KVK Uyumlu Çip ve Parmak İzi Kullanarak Elektronik Kimlik Doğrulama” projesiyle Milli Teknoloji Hamlesi kategorisinde birincilik ödülüne layık görüldü.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eKamunun dijital dönüşüm yolculuğuna ışık tutan ve ülkemizin teknoloji vizyonuna katkı sunan projeleri görünür kılmak amacıyla düzenlenen Türkiye Bilişim Ödülleri, bu yıl 30 Ekim 2025 tarihinde “Milli Teknoloji Hamlesi” vizyonuyla sahiplerini buldu.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003e200’ün üzerinde kamu ve özel sektör projesinin değerlendirildiği etkinlikte, alanında uzman jüri üyeleri tarafından yürütülen titiz bir ön inceleme ve puanlama sürecinin ardından finalist projeler belirlendi. Final programında katılımcıların canlı oylamalarıyla Kurumumuzun projesi, vizyoner proje olarak öne çıktı.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eÖdül törenine Genel Müdürlüğümüzü temsilen Genel Müdür Yardımcımız Ömer Sinan BAYÇELEBİ, Bilgi Teknolojileri Dairesi Başkanımız Cevdet Ekmel HATİPOĞLU ve kurum personelimiz katıldı.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eBu ödül, Türkiye Yüzyılı vizyonu doğrultusunda dijital dönüşüm çalışmalarımızın bir nişanesidir. Tapu ve Kadastro Genel Müdürlüğü olarak bu kararlılıkla yolumuza devam ediyoruz.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"59:T7cf,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eÇevre, Şehircilik ve İklim Değişikliği Bakanımız Sayın Murat Kurum, Cenevre’de düzenlenen Birleşmiş Milletler Avrupa Ekonomik Komisyonu (UNECE) Bakanlar Toplantısı’nda Türkiye’nin şehircilik vizyonunu, sürdürülebilir konut politikalarını ve “asrın felaketi” olarak nitelendirilen depremlerin ardından 11 ilde yürütülen çalışmaları uluslararası kamuoyuyla paylaştı.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eToplantıda konuşan Sayın Bakanımız, Türkiye’nin konut üretimi, afet sonrası yeniden inşa süreçleri ve sosyal konut projeleriyle dünyaya örnek olduğunu vurgulayarak şu ifadeleri kullandı:\u003c/span\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003e“Türkiye; Cumhurbaşkanımız Recep Tayyip Erdoğan'ın güçlü liderliği, özel sektörünün gücüyle, yine kamu tecrübesi ve bankacılık deneyimiyle dostlarının her zaman yanındadır. Bilhassa erişilebilir konut üretimine dair her türlü ortaklık arayışına cevap vermeye, her konuda yapıcı bir aktör olmaya hazırdır.”\u003c/span\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eSayın Bakanımız ayrıca deprem bölgesindeki yeniden inşa çalışmalarına da değinerek;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003e“Deprem bölgesinde saatte 23, günde 550 konut üreterek dünyada eşi az görülecek bir hızla inşa sürecini yürütüyoruz. Hiç konutu olmayan vatandaşlarımız için 500 bin sosyal konut projemizi başlattık.” ifadelerini kullandı.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eTapu ve Kadastro Genel Müdürlüğü olarak, 178 yıllık kurumsal birikimimizle ülkemizin sürdürülebilir şehircilik vizyonuna; güvenilir mülkiyet sistemimiz ve dijital dönüşüm projelerimizle katkı sunmaya devam ediyoruz.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5a:T468,\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eEmlak Katılım’ın iştiraki olarak kurulan Emlak Katılım Tasarruf Finansman A.Ş., düzenlenen tanıtım toplantısıyla kamuoyuna duyuruldu. Toplantıya Tapu ve Kadastro Genel Müdürümüz Hakan Gedikli'de katıldı.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eYeni şirketle birlikte Türkiye’de ilk kez bir kamu bankası tasarruf finansman sektörüne girmiş oldu. Ev, araç ve çatılı iş yeri için faizsiz ve güvenilir çözümler sunmayı hedefleyen Emlak Katılım Tasarruf Finansman A.Ş., faaliyetlerini Emlak Katılım şubeleri üzerinden yürütecek.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eSistem kapsamında katılımcılar, bütçelerine uygun taksitlerle tasarruf yaparak belirli bir birikime ulaştıklarında, kalan finansmanı faizsiz şekilde karşılayarak ev, araç ya da iş yeri sahibi olabilecek.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(41, 41, 41);\"\u003eTürkiye’nin 81 ilinde geçerli olacak sistem; ev, araç ve iş yeri finansmanı seçenekleriyle hem bireylere hem de girişimcilere yeni fırsatlar sunuyor.\u003c/span\u003e\u003c/p\u003e5b:T539,\u003cp class=\"text-align-justify\"\u003eKurumumuz personelinin maaş promosyonlarının planlanmasına ilişkin “Aylık ve Ücret Ödeme ile Promosyon Protokolü” komisyonunun 17/02/2026 tarihinde saat 13:30’da yapılan 4. toplantısında 1. grup promosyon ihalesinde yer alan 608 birim ve 6.481 personelimiz için davet edilen 10 bankadan (Ziraat Bankası, Halk Bankası, Vakıfbank, Yapı Kredi Bankası, Garanti Bankası, İş Bankası, Denizbank, Akbank, QNB Bank ve TEB) 7 bankanın (Ziraat Bankası, Halk Bankası, Vakıfbank, Yapı Kredi Bankası, Garanti Bankası, İş Bankası ve Denizbank) katılımıyla promosyon ihalesi gerçekleştirilmiştir. Bankalar tarafından sunulan kapalı zarf teklifleri ilgili Komisyon ve katılımcılar huzurunda açılarak açık artırma usulü ile ihale devam ettirilmiş, ihale sonucunda komisyon tarafından yapılan görüşmeler neticesinde İş Bankası tarafından sunulan 105.000,00-₺ nakit, 10.000,00-₺ Maxipuan olmak üzere toplam 115.000,00-₺ karşılığında 48 aylık 1. grup maaş promosyon ihalesi sonuçlanmıştır. 1. grup maaş promosyon ihalesinde olduğu gibi 2. ve 3. grupta yer alacak olan ihale süreçleri de aynı titizlik, şeffaflık ve hassasiyet içerisinde yürütülecek ayrıca tüm personelimiz sürecin her aşamasında mutlaka haberdar edilecektir.\u003c/p\u003e5c:T6b1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eAfganistan Ekonomi Bakanlığı temsilcilerinden oluşan heyet, Türkiye’nin tapu, kadastro ve dijitalleşme alanındaki tecrübelerinden faydalanmak amacıyla Kurumumuzu ziyaret etti.\u003cbr\u003eAfganistan''da gayrimenkul yönetimi ve düzenlenmesi çalışmalarına ışık tutmak amacıyla gerçekleştirilen program kapsamında, Afganistan Ekonomi Bakanlığı Ulusal Ekonomi Genel Müdürü Mohammad Yunus Salik başkanlığındaki 6 kişilik heyet, 17-18 Şubat tarihlerinde Kurumumuzda temaslarda bulundu.\u003cbr\u003eGenel Müdür Yardımcımız Dr. Mustafa Akkul başkanlığında gerçekleştirilen heyetler arası toplantılarda; ülkemizdeki tapu sicilinin işleyişi, modern kadastro çalışmaları ve kurumumuz tarafından başarıyla yürütülen projelere ilişkin kapsamlı bilgi ve tecrübe paylaşımı gerçekleştirildi. Görüşmelerde özellikle Türkiye’nin dijitalleşme sürecindeki başarısı ve mülkiyet güvenliği konusundaki birikimi ön plana çıktı.\u003cbr\u003eProgramın devamında Harita Dairesi Başkanlığı ile Bilgi Teknolojileri Dairesi Başkanlığına teknik bir ziyaret de gerçekleştiren heyet, başkanlıkların faaliyet alanları hakkında detaylı şekilde bilgilendirildi. Bu kapsamda sistem odası tanıtılarak, verilerin dijital ortamda korunması ve yönetilmesi süreçleri paylaşıldı.\u003cbr\u003eÇalışma ziyaretinin saha ayağında ise Ankara Bölge Müdürlüğü, Ankara Kadastro Müdürlüğü ve Çankaya Tapu Müdürlüğü ziyaret edildi. Bu birimlerde yürütülen çalışmalar ve işleyiş hakkında yerinde incelemelerde bulunan heyet, ülkemizin Tapu ve Kadastro Sisteminin teknolojik altyapısı hakkında ayrıntılı bilgi alarak programını tamamladı.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5d:T6f7,"])</script><script>self.__next_f.push([1,"\u003cp class=\"text-align-justify\"\u003eFIG (Uluslararası Haritacılar Federasyonu) Kadastro ve Arazi Yönetimi Komisyonu (7. Komisyon) yıllık toplantısı; FIG Değerleme ve Taşınmaz Yönetimi Komisyonu (9. Komisyon) ve kurumumuzun da büro üyesi olduğu Birleşmiş Milletler Arazi İdaresi Çalışma Grubu ile birlikte ortak etkinlik olarak 28-30 Ekim 2026 tarihlerinde İstanbul''da gerçekleştirilecek.\u003c/p\u003e\u003cp class=\"text-align-justify\"\u003eFIG üyesi Harita ve Kadastro Mühendisleri Odası ve UNECE Arazi İdaresi Çalışma Grubu üyesi kurumumuz tarafından birlikte organize edilen çalıştayın teması \"Hukuki Güvenlik, Elektronik Siciller, Yapay Zekâ ve Taşınmaz Değerleme\" olarak belirlendi. Çalıştay hazırlıklarına ilişkin ilk ortak toplantı HKMO Genel Merkez binasında gerçekleştirildi. Kurumumuzu temsilen Taşınmaz Değerleme Dairesi Başkanı Ümit Yıldız, Harita Dairesi Başkanı Ekrem Ayyıldız, Mühendis Meryem Aydın, Tapu ve Kadastro Uzmanı Emre Ergin Ergani, Kadastro Dairesi Başkanlığından Cihat Erda Gümüş ve Yabancı İşler Dairesi Başkanlığından Birim Amiri Çağlayan Dikmen katıldı.\u003c/p\u003e\u003cp class=\"text-align-justify\"\u003eİstanbul’da yürütülmekte olan Taşınmaz Yönetim Sistemi Kurulumu projesi, elektronik sicile geçiş süreci, değer haritalarının oluşturulması ve değer bilgi merkezinin kurulması gibi kurumsal çalışmalarımızın aktarılacağı çalıştaya 50''den fazla ülkeden temsilcinin katılması bekleniyor. Söz konusu ortak etkinliğin kurumsal faaliyetlerin tanıtımının yapılması ve desteklenmesini sağlamasının yanı sıra Türki Cumhuriyetler başta olmak üzere temasımızın olduğu ülkelerle iş birliğinin geliştirilmesine katkı sunması hedefleniyor.\u0026nbsp;\u003cbr\u003e\u0026nbsp;\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5e:T532,\u003csvg width='42' height='41' viewBox='0 0 42 41' fill='none' xmlns='http://www.w3.org/2000/svg'\u003e\n\u003cpath d='M18 34.75C8.61116 34.75 1 27.3627 1 18.25C1 9.1373 8.61116 1.75 18 1.75C27.3888 1.75 35 9.1373 35 18.25C35 18.8408 34.968 19.4243 34.9056 19.9991' stroke='#2152BC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'\u003e\u003c/path\u003e\n\u003cpath d='M25 18.25C25 7.25 18 1.75 18 1.75C18 1.75 11 7.25 11 18.25C11 29.25 18 34.75 18 34.75' stroke='#2152BC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'\u003e\u003c/path\u003e\n\u003cpath d='M2 12.75H33' stroke='#2152BC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'\u003e\u003c/path\u003e\n\u003cpath d='M3 24.75H21' stroke='#2152BC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'\u003e\u003c/path\u003e\n\u003cpath d='M28.3438 37.4068V31.6568H32.6562V37.4068H38.4062V28.7818C38.4063 28.6874 38.3878 28.5939 38.3517 28.5066C38.3157 28.4194 38.2627 28.3401 38.196 28.2733L31.0085 21.0858C30.9418 21.019 30.8625 20.966 30.7752 20.9298C30.688 20.8936 30.5945 20.875 30.5 20.875C30.4055 20.875 30.312 20.8936 30.2248 20.9298C30.1375 20.966 30.0582 21.019 29.9915 21.0858L22.804 28.2733C22.7373 28.3401 22.6843 28.4194 22.6483 28.5066C22.6122 28.5939 22.5937 28.6874 22.5938 28.7818V37.4068H28.3438Z' stroke='#2152BC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'\u003e\u003c/path\u003e\n\u003c/svg\u003e\n5f:Tce4,"])</script><script>self.__next_f.push([1,"\u003csvg width='40' height='31' viewBox='0 0 40 31' fill='none' xmlns='http://www.w3.org/2000/svg'\u003e\n\u003cg clip-path='url(#clip0_4091_1049)'\u003e\n\u003cpath d='M4.01358 30.7676C1.80193 30.7676 0 29.0076 0 26.8473V16.1508C0 13.9905 1.80193 12.2305 4.01358 12.2305C5.8354 12.2305 7.38276 13.4233 7.86805 15.0513L10.4178 13.7302C13.067 12.3548 16.102 12.0751 18.966 12.9337L26.3846 15.0901C28.286 15.6613 29.5191 17.4602 29.2645 19.2824C29.169 19.9702 28.9503 20.4947 28.6917 20.891C29.9487 21.0076 31.2176 21.0386 32.4945 20.9881L36.6751 20.8249C36.7308 20.8211 36.7865 20.8249 36.8462 20.8288C38.6043 21.0076 40.0125 22.3247 40.2671 24.0343C40.4222 25.06 40.1318 26.1168 39.4715 26.9289C38.8112 27.7409 37.8247 28.2577 36.7666 28.3432L31.675 28.755