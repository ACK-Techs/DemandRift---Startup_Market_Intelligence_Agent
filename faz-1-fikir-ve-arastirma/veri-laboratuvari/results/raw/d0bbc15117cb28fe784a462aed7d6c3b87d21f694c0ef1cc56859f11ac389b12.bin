94eeec2d015.JPG\",\"fileName\":\"197519ddff2a41e495fd194eeec2d015.JPG\",\"name\":\"fc8b391c-e2f8-4de9-b36e-23e4887a09b7\"}},{\"gorsel\":{\"storagePath\":\"/media/11789/view\",\"downloadPath\":\"/media-library/a3db0e6d110a4bfe97deb764019c2fe3.JPG\",\"mediaUrl\":\"/media-library/a3db0e6d110a4bfe97deb764019c2fe3.JPG\",\"fileName\":\"a3db0e6d110a4bfe97deb764019c2fe3.JPG\",\"name\":\"AYZ_9224 (Copy)_0\"}},{\"gorsel\":{\"storagePath\":\"/media/11790/view\",\"downloadPath\":\"/media-library/76996bd8d87c4ff6993ca68c5723149a.JPG\",\"mediaUrl\":\"/media-library/76996bd8d87c4ff6993ca68c5723149a.JPG\",\"fileName\":\"76996bd8d87c4ff6993ca68c5723149a.JPG\",\"name\":\"AYZ_9273 (Copy)\"}},{\"gorsel\":{\"storagePath\":\"/media/11791/view\",\"downloadPath\":\"/media-library/5765bfb38e1a40b2816efe7a6d8bbc73.JPG\",\"mediaUrl\":\"/media-library/5765bfb38e1a40b2816efe7a6d8bbc73.JPG\",\"fileName\":\"5765bfb38e1a40b2816efe7a6d8bbc73.JPG\",\"name\":\"AYZ_9281 (Copy)\"}}],\"haberIcerigi\":\"$5c\",\"haberKartGorseli\":{\"storagePath\":\"/media/11792/view\",\"downloadPath\":\"/media-library/bbe9d30e1cc442beaa218e1995ea77bd.JPG\",\"mediaUrl\":\"/media-library/bbe9d30e1cc442beaa218e1995ea77bd.JPG\",\"fileName\":\"bbe9d30e1cc442beaa218e1995ea77bd.JPG\",\"name\":\"AYZ_9293 (Copy)\"},\"slug\":\"haberler/afganistan-heyetinden-genel-mudurlugumuze-ziyaret\",\"__isCompanyOnly\":false},{\"tarih\":\"26 Ocak 2026\",\"belgeListesi\":[],\"haberBaslik\":\"Maaş Promosyonları İçin 1. Grup İhale Süreci Başlıyor\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/11782/view\",\"downloadPath\":\"/media-library/ee6db1a8b39e428c8d26f0b9d96361d3.jpg\",\"mediaUrl\":\"/media-library/ee6db1a8b39e428c8d26f0b9d96361d3.jpg\",\"fileName\":\"ee6db1a8b39e428c8d26f0b9d96361d3.jpg\",\"name\":\"foto 1_0\"}}],\"haberIcerigi\":\"\u003cp class=\\\"text-align-justify\\\"\u003eGenel Müdürlüğümüz personeline yönelik maaş promosyon süreçlerinin planlanması kapsamında oluşturulan “Aylık ve Ücret Ödeme ile Promosyon Protokolü Komisyonu”, 14.01.2026 tarihinde 3. toplantısını gerçekleştirdi.\u003c/p\u003e\u003cp class=\\\"text-align-justify\\\"\u003eToplantıda, sözleşme süreleri tamamlanan birimlerimizde görev yapan personelimizi kapsayacak 1. Grup Maaş Promosyon İhalesinin, Döner Sermaye İşletmesi Müdürlüğümüz tarafından 17.02.2026 tarihinde saat 13.30’da gerçekleştirilmesi kararlaştırıldı.\u003c/p\u003e\u003cp class=\\\"text-align-justify\\\"\u003eKomisyon tarafından yapılan açıklamada planlama ve ihale süreçlerinin titizlikle yürütüldüğü, konuya ilişkin detaylı bilgilere Döner Sermaye İşletmesi Müdürlüğümüzden alınabileceği kaydedildi.\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/11783/view\",\"downloadPath\":\"/media-library/a6441876d0e2448abb01246ab9f16be9.jpg\",\"mediaUrl\":\"/media-library/a6441876d0e2448abb01246ab9f16be9.jpg\",\"fileName\":\"a6441876d0e2448abb01246ab9f16be9.jpg\",\"name\":\"foto 1\"},\"slug\":\"haberler/gm-maas-promosyonlari-icin-1-grup-ihale-sureci-basliyor\",\"__isCompanyOnly\":false},{\"tarih\":\"\",\"belgeListesi\":[],\"haberBaslik\":\"FIG KADASTRO VE ARAZİ YÖNETİMİ TOPLANTISI İÇİN BİR ARAYA GELİNDİ \",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/11779/view\",\"downloadPath\":\"/media-library/a7f8ce1ddb8943f287ee08fc2e1fa680.jpg\",\"mediaUrl\":\"/media-library/a7f8ce1ddb8943f287ee08fc2e1fa680.jpg\",\"fileName\":\"a7f8ce1ddb8943f287ee08fc2e1fa680.jpg\",\"name\":\"fatih çağatay atama \"}},{\"gorsel\":{\"storagePath\":\"/media/11780/view\",\"downloadPath\":\"/media-library/8cf865f7ce0a40aa8dde9da8d29e3d4b.jpg\",\"mediaUrl\":\"/media-library/8cf865f7ce0a40aa8dde9da8d29e3d4b.jpg\",\"fileName\":\"8cf865f7ce0a40aa8dde9da8d29e3d4b.jpg\",\"name\":\"foto 2\"}}],\"haberIcerigi\":\"$5d\",\"haberKartGorseli\":{\"storagePath\":\"/media/11781/view\",\"downloadPath\":\"/media-library/4e89c8140182486f8e3ff918723128bb.jpg\",\"mediaUrl\":\"/media-library/4e89c8140182486f8e3ff918723128bb.jpg\",\"fileName\":\"4e89c8140182486f8e3ff918723128bb.jpg\",\"name\":\"foto 3\"},\"slug\":\"haberler/fig-kadastro-ve-arazi-yonetimi-toplantisi-icin-bir-araya-gelindi\",\"__isCompanyOnly\":false},{\"tarih\":\"30 Aralık 2025\",\"belgeListesi\":[],\"haberBaslik\":\"Berlin’de Tapu ve Kadastro Hizmetleri Bilgilendirme Toplantısı Gerçekleştirildi\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/11775/view\",\"downloadPath\":\"/media-library/fcc259055f9d43afbead377c7edaf2a4.jpeg\",\"mediaUrl\":\"/media-library/fcc259055f9d43afbead377c7edaf2a4.jpeg\",\"fileName\":\"fcc259055f9d43afbead377c7edaf2a4.jpeg\",\"name\":\"6fc4c42c-0ff1-476c-ac31-b854942e29c1_1\"}},{\"gorsel\":{\"storagePath\":\"/media/11776/view\",\"downloadPath\":\"/media-library/4067774ade8e48669021f8223766b2fc.jpeg\",\"mediaUrl\":\"/media-library/4067774ade8e48669021f8223766b2fc.jpeg\",\"fileName\":\"4067774ade8e48669021f8223766b2fc.jpeg\",\"name\":\"da3ab670-e1b8-4783-b318-fc1ae1cdae52\"}},{\"gorsel\":{\"storagePath\":\"/media/11777/view\",\"downloadPath\":\"/media-library/0351774330cb46d68faf87a8f4cc1861.jpeg\",\"mediaUrl\":\"/media-library/0351774330cb46d68faf87a8f4cc1861.jpeg\",\"fileName\":\"0351774330cb46d68faf87a8f4cc1861.jpeg\",\"name\":\"da3ab670-e1b8-4783-b318-fc1ae1cdae52_0\"}}],\"haberIcerigi\":\"\u003cp class=\\\"text-align-justify\\\"\u003eBerlin Çorumlular Derneği’nin daveti üzerine, Başkonsolos \u0026nbsp;İlker Okan Şanlı’nın katılımıyla Tapu ve Kadastro Hizmetleri Bilgilendirme Toplantısı düzenlendi.\u003cbr\u003eToplantıda, Berlin Tapu ve Kadastro Temsilcisi Fidan Elçi tarafından tapu işlemleri ve işlem süreçlerine ilişkin kapsamlı bir sunum gerçekleştirildi. Sunum kapsamında vatandaşların merak ettiği konular ele alınarak sorular yanıtlandı ve uygulamaya yönelik bilgiler paylaşıldı.\u003cbr\u003eTürkiye dışında tapu işlemlerinin gerçekleştirilebildiği ilk ve tek merkez olma özelliğine sahip Berlin Tapu ve Kadastro Temsilciliği, toplantıya katılan vatandaşlar tarafından yoğun ilgi gördü ve olumlu geri bildirimler aldı.\u003cbr\u003eBilgilendirici içeriği ve sağladığı doğrudan iletişim imkânı sayesinde etkinlik, katılımcıların memnuniyetiyle başarıyla tamamlandı.\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/11778/view\",\"downloadPath\":\"/media-library/72c49f8fc5c14fdf9f52a8989267b097.jpeg\",\"mediaUrl\":\"/media-library/72c49f8fc5c14fdf9f52a8989267b097.jpeg\",\"fileName\":\"72c49f8fc5c14fdf9f52a8989267b097.jpeg\",\"name\":\"fatih çağatay atama _0\"},\"slug\":\"haberler/gm-berlinde-tapu-ve-kadastro-hizmetleri-bilgilendirme-toplantisi-gerceklestirildi\",\"__isCompanyOnly\":false},{\"tarih\":\"26 Aralık 2025\",\"belgeListesi\":[],\"haberBaslik\":\"Üst Yönetimde Atama\",\"gorselListesi\":[{\"gorsel\":null}],\"haberIcerigi\":\"\u003cp\u003eBakanlık Makamının 24.12.2025 tarih ve 18914991 Sayılı Oluru ile Kadastro Dairesi Başkanlığında görev yapan Fatih Çağatay KAPLAN, Bilgi Teknolojileri Dairesi Başkanı olarak asaleten atanmıştır.\u0026nbsp;\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/11774/view\",\"downloadPath\":\"/media-library/30871b0192aa482c926bc1ff10bc3c09.jpg\",\"mediaUrl\":\"/media-library/30871b0192aa482c926bc1ff10bc3c09.jpg\",\"fileName\":\"30871b0192aa482c926bc1ff10bc3c09.jpg\",\"name\":\"kapak\"},\"slug\":\"haberler/ust-yonetimde-atama\",\"__isCompanyOnly\":false}],\"totalCount\":668,\"globalItems\":[{\"tarih\":\"2026-08-20\",\"belgeListesi\":[{}],\"haberBaslik\":\"Edirne Milletvekilimiz Sayın Dr. Fatma AKSAL ve Heyetinden Ziyaret\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/101197/view\",\"downloadPath\":\"/media-library/267c95871e5c4aa78c9a09900e3718f8.jpeg\",\"mediaUrl\":\"/media-library/267c95871e5c4aa78c9a09900e3718f8.jpeg\",\"fileName\":\"2.jpeg\",\"name\":\"2\"}},{\"gorsel\":{\"storagePath\":\"/media/101200/view\",\"downloadPath\":\"/media-library/dab57393b23245dc8ee5e264465c4ae2.jpeg\",\"mediaUrl\":\"/media-library/dab57393b23245dc8ee5e264465c4ae2.jpeg\",\"fileName\":\"5.jpeg\",\"name\":\"5\"}},{\"gorsel\":{\"storagePath\":\"/media/101201/view\",\"downloadPath\":\"/media-library/0ab9f5acf5fb4514a45912fcc033e688.jpeg\",\"mediaUrl\":\"/media-library/0ab9f5acf5fb4514a45912fcc033e688.jpeg\",\"fileName\":\"4.jpeg\",\"name\":\"4\"}},{\"gorsel\":{\"storagePath\":\"/media/101202/view\",\"downloadPath\":\"/media-library/e1df65a9538e413db93c7b38dd895405.jpeg\",\"mediaUrl\":\"/media-library/e1df65a9538e413db93c7b38dd895405.jpeg\",\"fileName\":\"3.jpeg\",\"name\":\"3\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp class=\\\"ql-align-justify\\\"\u003eEdirne Milletvekilimiz Sayın Dr. Fatma AKSAL beraberinde Keşan Belediye Başkanı Sayın Op. Dr. Mehmet ÖZCAN,Edirne Çevre Şehircilik ve İklim Değişikliği Müdürü Ayşe SARI ve Edirne Milli Emlak Müdürü Kemal ALICI ile  birlikte Bölge Müdürümüz Sayın Hayrullah AKDEMİR'i makamında ziyaret etmişlerdir. Samimi bir atmosferde gerçekleşen ziyarette, Edirne'de yürütülen çalışmalar, kurumlar arası iş birliği ve bölgeye yönelik projeler hakkında karşılıklı görüş alışverişinde bulunulmuştur. Bölgenin gelişimine katkı sağlayacak konuların ele alındığı görüşmede, ortak çalışma kültürünün önemine vurgu yapılırken, yapıcı diyaloğun bölgenin gelişimi açısından önemli olduğu ifade edilmiştir.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/101196/view\",\"downloadPath\":\"/media-library/4fd6a1e122db41bf9bc12a94e72abd2b.jpeg\",\"mediaUrl\":\"/media-library/4fd6a1e122db41bf9bc12a94e72abd2b.jpeg\",\"fileName\":\"1.jpeg\",\"name\":\"1\"},\"slug\":\"edirne-bm/haberler/edirne-bm-edirne-milletvekilimiz-sayin-dr-fatma-aksal-ve-heyetinden-ziyaret-1\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"TAPU VE KADASTRO MÜDÜRLÜKLERİMİZDE YÜZ YÜZE EĞİTİM YAPILMIŞTIR\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100519/view\",\"downloadPath\":\"/media-library/eb9ed77309a14aebb89646b3bb79f169.jpg\",\"mediaUrl\":\"/media-library/eb9ed77309a14aebb89646b3bb79f169.jpg\",\"fileName\":\"ağlasun.jpg\",\"name\":\"ağlasun\"}},{\"gorsel\":{\"storagePath\":\"/media/100520/view\",\"downloadPath\":\"/media-library/8e8229ab882c4641b8c104cf0ea0f0f0.jpg\",\"mediaUrl\":\"/media-library/8e8229ab882c4641b8c104cf0ea0f0f0.jpg\",\"fileName\":\"bucak.jpg\",\"name\":\"bucak\"}},{\"gorsel\":{\"storagePath\":\"/media/100521/view\",\"downloadPath\":\"/media-library/d3628b51d60e45c8a7961909bc40bdaf.jpg\",\"mediaUrl\":\"/media-library/d3628b51d60e45c8a7961909bc40bdaf.jpg\",\"fileName\":\"çeltikçi.jpg\",\"name\":\"çeltikçi\"}},{\"gorsel\":{\"storagePath\":\"/media/100522/view\",\"downloadPath\":\"/media-library/38086c71a1e14529ac62d115cf2ccd6b.jpg\",\"mediaUrl\":\"/media-library/38086c71a1e14529ac62d115cf2ccd6b.jpg\",\"fileName\":\"ısparta km.jpg\",\"name\":\"ısparta km\"}},{\"gorsel\":{\"storagePath\":\"/media/100523/view\",\"downloadPath\":\"/media-library/d266c106c196453f8102f596e05a9f1c.jpg\",\"mediaUrl\":\"/media-library/d266c106c196453f8102f596e05a9f1c.jpg\",\"fileName\":\"yenişarbademli.jpg\",\"name\":\"yenişarbademli\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eTapu ve Kadastro Müdürlüklerimizde görev yapan personelin nitelik, bilgi, beceri, tutum ve davranış olarak geliştirilmesine yönelik planlanan 2026 Haziran ayı ''Yüz Yüze Eğitimleri'' Bölge Müdürlüğümüze bağlı Tapu ve Kadastro Müdürlüklerimizce yapılmıştır.\u003c/span\u003e\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100518/view\",\"downloadPath\":\"/media-library/38a28c37d4ed4e568e99d234dfa11c95.jpg\",\"mediaUrl\":\"/media-library/38a28c37d4ed4e568e99d234dfa11c95.jpg\",\"fileName\":\"ısparta tm.jpg\",\"name\":\"ısparta tm\"},\"slug\":\"antalya-bm/haberler/antalya-bm-tapu-ve-kadastro-mudurluklerimizde-yuz-yuze-egitim-yapilmistir-53\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"DÖŞEMEALTI TAPU MÜDÜRLÜĞÜNE BAŞARI BELGESİ\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100517/view\",\"downloadPath\":\"/media-library/09f985072e71463ea61b74818b8ff1e2.jpg\",\"mediaUrl\":\"/media-library/09f985072e71463ea61b74818b8ff1e2.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eDöşemealtı Tapu Müdürlüğümüzde 26.06.2026 tarihindeki sahtecilik girişimini dikkatli ve titiz çalışmaları sonucu ortaya çıkaran, suçluların emniyet güçlerine teslimini sağlayan Tapu Müdürü İsmail KOCAOĞLU, Tapu Sicil Müdür Yardımcısı Ahmet ŞIK ve Tekniker Yusuf GÜVEN Döşemealtı Kaymakamı Sayın  Ünal ÇAKICI tarafından başarı belgesi ile ödüllendirilmiştir.\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eBölge Müdürlüğü olarak personelimizi  tebrik eder, başarılarının devamını dileriz.\u003c/span\u003e\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100516/view\",\"downloadPath\":\"/media-library/7ae98069c7804b18ac191235f997bfb5.jpg\",\"mediaUrl\":\"/media-library/7ae98069c7804b18ac191235f997bfb5.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"},\"slug\":\"antalya-bm/haberler/antalya-bm-dosemealti-tapu-mudurlugune-basari-belgesi\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"KEPEZ TAPU MÜDÜRLÜĞÜNE TEŞEKKÜR BELGESİ\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100514/view\",\"downloadPath\":\"/media-library/0a378463e1a0416cae3fd0730461646b.jpg\",\"mediaUrl\":\"/media-library/0a378463e1a0416cae3fd0730461646b.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"}},{\"gorsel\":{\"storagePath\":\"/media/100515/view\",\"downloadPath\":\"/media-library/93acc90dfa2c4d3a959375104330b3f0.jpg\",\"mediaUrl\":\"/media-library/93acc90dfa2c4d3a959375104330b3f0.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eBölge Müdürümüz Sayın Funda AYDIN SEYMEN tarafından Kepez Tapu Müdürlüğü personeli Tekniker Enes Şehmus DEMİR ve Tunahan YILMAZ’ a  CİMER başvurularının değerlendirilmesi neticesinde; müdürlük başvuru hizmetlerinin etkin, güvenli ve zamanında sunulması, vatandaşa verilen hizmet ve kurumsal imajımıza verdikleri katkıdan dolayı “ Teşekkür Belgesi “ verilmiştir. \u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eBölge Müdürlüğü olarak personelimizi tebrik eder, başarılarının devamını dileriz.\u003c/span\u003e\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100513/view\",\"downloadPath\":\"/media-library/4d67107d49fa4bcf95b36aefa7f843f2.jpg\",\"mediaUrl\":\"/media-library/4d67107d49fa4bcf95b36aefa7f843f2.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"},\"slug\":\"antalya-bm/haberler/antalya-bm-kepez-tapu-mudurlugune-tesekkur-belgesi\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"MANAVGAT KADASTRO BİRİMİ TEFRİŞAT YENİLEME\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100506/view\",\"downloadPath\":\"/media-library/3d1de5d37c3142fdb93abdf533608a4f.jpg\",\"mediaUrl\":\"/media-library/3d1de5d37c3142fdb93abdf533608a4f.jpg\",\"fileName\":\"3.jpg\",\"name\":\"3\"}},{\"gorsel\":{\"storagePath\":\"/media/100509/view\",\"downloadPath\":\"/media-library/72563b9795ce4562b366e95d7e37bad9.jpg\",\"mediaUrl\":\"/media-library/72563b9795ce4562b366e95d7e37bad9.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}},{\"gorsel\":{\"storagePath\":\"/media/100508/view\",\"downloadPath\":\"/media-library/6f14294131ec4c1eac5f9458c244b857.jpg\",\"mediaUrl\":\"/media-library/6f14294131ec4c1eac5f9458c244b857.jpg\",\"fileName\":\"4.jpg\",\"name\":\"4\"}},{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürlüğümüze bağlı Antalya Kadastro Müdürlüğü Manavgat Birimimiz bakım ve onarımı yapılarak tefrişatı yenilenmiştir.\u003c/p\u003e\u003cp\u003eÇalışma alanlarımız ve vatandaş hizmet alanları ile işlevsel hale getirilen kadastro birimimiz artık yeni çehresi ile hizmet vermektedir. Hayırlı olsun.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100505/view\",\"downloadPath\":\"/media-library/8f1b338c443c4d388cc78aa9226fadf8.jpg\",\"mediaUrl\":\"/media-library/8f1b338c443c4d388cc78aa9226fadf8.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"},\"slug\":\"ankara-bm/haberler/antalya-bm-manavgat-kadastro-birimi-tefrisat-yenileme\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"ALTINYAYLA TAPU MÜDÜRLÜĞÜ TEFRİŞAT YENİLEME\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100501/view\",\"downloadPath\":\"/media-library/306c57907c9d4c66b03726e09534ce8d.jpg\",\"mediaUrl\":\"/media-library/306c57907c9d4c66b03726e09534ce8d.jpg\",\"fileName\":\"4.jpg\",\"name\":\"4\"}},{\"gorsel\":{\"storagePath\":\"/media/100502/view\",\"downloadPath\":\"/media-library/c193ba55e532496f80b5508b7401a911.jpg\",\"mediaUrl\":\"/media-library/c193ba55e532496f80b5508b7401a911.jpg\",\"fileName\":\"3.jpg\",\"name\":\"3\"}},{\"gorsel\":{\"storagePath\":\"/media/100503/view\",\"downloadPath\":\"/media-library/2b1c692b74dc41cb8e1ebfe8cf0ffd02.jpg\",\"mediaUrl\":\"/media-library/2b1c692b74dc41cb8e1ebfe8cf0ffd02.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"}},{\"gorsel\":{\"storagePath\":\"/media/100504/view\",\"downloadPath\":\"/media-library/e878d286d87b4cc38c8a52b70b2bd870.jpg\",\"mediaUrl\":\"/media-library/e878d286d87b4cc38c8a52b70b2bd870.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürlüğümüze bağlı Altınyayla Tapu Müdürlüğünün bakım ve onarımı yapılarak tefrişatı yenilenmiştir. Çalışma alanlarımız ve vatandaş hizmet alanları ile işlevsel hale getirilen müdürlüğümüz artık yeni çehresi ile hizmet vermektedir. Hayırlı olsun.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100500/view\",\"downloadPath\":\"/media-library/8fc5b3d347e640f78b8cc503c06f06fe.jpg\",\"mediaUrl\":\"/media-library/8fc5b3d347e640f78b8cc503c06f06fe.jpg\",\"fileName\":\"4.jpg\",\"name\":\"4\"},\"slug\":\"ankara-bm/haberler/antalya-bm-altinyayla-tapu-mudurlugu-tefrisat-yenileme\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"TOPLANTI\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100497/view\",\"downloadPath\":\"/media-library/9a61619d490343c38de67ce89eef650e.jpg\",\"mediaUrl\":\"/media-library/9a61619d490343c38de67ce89eef650e.jpg\",\"fileName\":\"3.jpg\",\"name\":\"3\"}},{\"gorsel\":{\"storagePath\":\"/media/100498/view\",\"downloadPath\":\"/media-library/59ce5e02a04d4671b657302931f85525.jpg\",\"mediaUrl\":\"/media-library/59ce5e02a04d4671b657302931f85525.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}},{\"gorsel\":{\"storagePath\":\"/media/100499/view\",\"downloadPath\":\"/media-library/d128473fea814005b6968c89edf858d7.jpg\",\"mediaUrl\":\"/media-library/d128473fea814005b6968c89edf858d7.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"}}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003e2026 yılı ANT- ELM II Referans Numaralı Kadastro Harita ve Bilgilerinin Güncelleme İşi kapsamında, çalışmaların planlanan takvime uygun, etkin ve sağlıklı bir şekilde yürütülmesini sağlamak amacıyla yüklenici firma yetkilileri ile Antalya Kadastro Müdürlüğü personelerinin katılımıyla koordinasyon toplantısı gerçekleştirildi.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eToplantıda, iş programı, uygulama süreci, yüklenici ile kadastro müdürlüğü personelleri arasında koordinasyon ve sahada yürütülecek çalışmalar hakkında değerlendirmelerde bulunuldu\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100496/view\",\"downloadPath\":\"/media-library/c2a8a572e0304d479f195c9f0c28126f.jpg\",\"mediaUrl\":\"/media-library/c2a8a572e0304d479f195c9f0c28126f.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"},\"slug\":\"ankara-bm/haberler/antalya-bm-toplanti-20\",\"__isCompanyOnly\":false},{\"belgeListesi\":[{}],\"haberBaslik\":\"ATABEY TAPU MÜDÜRLÜĞÜ TEFRİŞAT YENİLEME\",\"gorselListesi\":[{\"gorsel\":{\"storagePath\":\"/media/100493/view\",\"downloadPath\":\"/media-library/681ecdefcce64298b3bdbb039342c2d8.jpg\",\"mediaUrl\":\"/media-library/681ecdefcce64298b3bdbb039342c2d8.jpg\",\"fileName\":\"1.jpg\",\"name\":\"1\"}},{\"gorsel\":{\"storagePath\":\"/media/100494/view\",\"downloadPath\":\"/media-library/1ebeeab398d5465f84b55474db8ccfd4.jpg\",\"mediaUrl\":\"/media-library/1ebeeab398d5465f84b55474db8ccfd4.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"}},{\"gorsel\":{\"storagePath\":\"/media/100495/view\",\"downloadPath\":\"/media-library/e91557a5ebce48a0be25cb44034d57eb.jpg\",\"mediaUrl\":\"/media-library/e91557a5ebce48a0be25cb44034d57eb.jpg\",\"fileName\":\"3.jpg\",\"name\":\"3\"}},{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(41, 41, 41);\\\"\u003eölge Müdürlüğümüze bağlı Atabey Tapu Müdürlüğünün bakım ve onarımı yapılarak tefrişatı yenilenmiştir. Çalışma alanlarımız ve vatandaş hizmet alanları ile işlevsel hale getirilen müdürlüğümüz artık yeni çehresi ile hizmet vermektedir. Hayırlı olsun.\u003c/span\u003e\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/100492/view\",\"downloadPath\":\"/media-library/dec1355063f14a98b322d92fcac467c1.jpg\",\"mediaUrl\":\"/media-library/dec1355063f14a98b322d92fcac467c1.jpg\",\"fileName\":\"2.jpg\",\"name\":\"2\"},\"slug\":\"ankara-bm/haberler/antalya-bm-atabey-tapu-mudurlugu-tefrisat-yenileme\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-09-22\",\"belgeListesi\":[{}],\"haberBaslik\":\"\u003cp\u003eSayıştaş Denetimi Başladı\u003c/p\u003e\",\"gorselListesi\":[{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürlüğümüz faaliyetlerine yönelik gerçekleştirilecek Sayıştaş Denetimi, 21.09.2026 tarihinde düzenlenen açılış toplantısı ile başlamıştır.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/101664/view\",\"downloadPath\":\"/media-library/c4ec93f99ec641aa8e8dd16941e8307b.JPG\",\"mediaUrl\":\"/media-library/c4ec93f99ec641aa8e8dd16941e8307b.JPG\",\"fileName\":\"IMG_6779.JPG\",\"name\":\"IMG_6779\"},\"slug\":\"istanbul-bm/haberler/istanbul-bm-sayistas-denetimi-basladi\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-09-17\",\"belgeListesi\":[{}],\"haberBaslik\":\"\u003cp\u003eBaşakşehir Tapu Müdürlüğü Üstün Başarı Belgesi\u003c/p\u003e\",\"gorselListesi\":[{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürlüğümüze bağlı Başakşehir Tapu Müdürlüğümüz personelinden Tapu Sicil Müdür Yardımcısı Ali TOPAL, Başakşehir Kaymakamı Sn. Cemil Özgür ÖNEĞİ tarafından çalışmalarında gösterdiği gayretlerinden dolayı üstün başarı belgesi ile ödüllendirilmiştir.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/101623/view\",\"downloadPath\":\"/media-library/53667a7e9f284f86ba14e85bc7b8e2b8.jpg\",\"mediaUrl\":\"/media-library/53667a7e9f284f86ba14e85bc7b8e2b8.jpg\",\"fileName\":\"IMG-20260818-WA0001.jpg\",\"name\":\"IMG-20260818-WA0001\"},\"slug\":\"istanbul-bm/haberler/istanbul-bm-basaksehir-tapu-mudurlugu-ustun-basari-belgesi\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-09-15\",\"belgeListesi\":[{}],\"haberBaslik\":\"Serdivan Kaymakamlığı Ziyareti\",\"gorselListesi\":[{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürümüz Hasan UZUN, Serdivan Kaymakamı Tolga TOĞAN'ı 14.09.2026 tarihinde Makamında ziyaret etmiştir.\u003c/p\u003e\",\"haberKartGorseli\":{\"storagePath\":\"/media/101593/view\",\"downloadPath\":\"/media-library/4b9c1baab40b4c1fb5a512921cd21812.jpg\",\"mediaUrl\":\"/media-library/4b9c1baab40b4c1fb5a512921cd21812.jpg\",\"fileName\":\"IMG_6771-1.jpg\",\"name\":\"IMG_6771-1\"},\"slug\":\"istanbul-bm/haberler/istanbul-bm-serdivan-kaymakamligi-ziyareti\",\"__isCompanyOnly\":false},{\"tarih\":\"2026-09-15\",\"belgeListesi\":[{}],\"haberBaslik\":\"Hendek Kaymakamlığı Ziyareti\",\"gorselListesi\":[{}],\"icerikTuru\":\"Haber\",\"haberIcerigi\":\"\u003cp\u003eBölge Müdürümüz Hasan UZUN, Hendek Kaymakamı Hacı Hasan GÖKPINAR'ı 14.09.2026 tarihinde Makamında ziyaret etmiştir.\u003c/p\u003e\",\