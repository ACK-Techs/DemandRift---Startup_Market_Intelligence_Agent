<svg  class="checkmark" data-name="icon-reviews" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" > <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <path d="M12,1 C18.0751322,1 23,5.92486775 23,12 C23,18.0751322 18.0751322,23 12,23 C5.92486775,23 1,18.0751322 1,12 C1,5.92486775 5.92486775,1 12,1 Z M12,3.32222222 L10.0695,9.67777778 L4.05555556,9.67777778 L8.96522222,13.1812778 L7.09827778,19.2111111 L12,15.4851667 L16.9096667,19.2111111 L15.0427222,13.1812778 L19.9444444,9.67777778 L13.9305,9.67777778 L12,3.32222222 Z" fill="#333333"></path> </g></svg>
