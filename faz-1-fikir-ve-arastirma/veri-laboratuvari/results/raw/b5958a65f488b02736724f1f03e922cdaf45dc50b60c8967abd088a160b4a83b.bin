  try {
    var el = document.currentScript;
    if (!el) return;
    var params = JSON.parse(el.getAttribute("data-params"));
    if (!params || typeof params !== "object") return;
    var attribute = params.attribute;
    var weights = params.weights;
    if (typeof attribute !== "string" || !attribute) return;
    if (!Array.isArray(weights) || weights.length === 0) return;
    var total = 0;
    for (var i = 0; i < weights.length; i++) {
      var entry = weights[i];
      if (!Array.isArray(entry) || typeof entry[0] !== "string") return;
      if (typeof entry[1] !== "number" || !isFinite(entry[1]) || entry[1] < 0) return;
      total += entry[1];
    }
    var chosenId = weights[0][0];
    if (total > 0) {
      var roll = Math.floor(Math.random() * total);
      var acc = 0;
      for (var j = 0; j < weights.length; j++) {
        acc += weights[j][1];
        if (roll < acc) {
          chosenId = weights[j][0];
          break;
        }
      }
    }
    document.documentElement.setAttribute(attribute, chosenId);
  } catch (e) {}
})();</script></head><body><div class="css-13o7eu2-root css-10klw3m-root" style="" id="root"><div class="css-k008qs-layout css-cgq59l-layout" style=""><div class="css-lgj0h8-container css-19m61fo-container css-1xdtxco-stack css-2o4qcf-stack css-1p6brg8-stackGridRows css-1gkqny0-stackGridDirection css-stydb2-stackJustifyContent css-1x2eit8-stackAlignContent" style="--gapDesktop-ry71n2:0;--gapTablet-oc2ewx:0;--gapMobile-11dbs0s:0;--gridRows-ntdmil:auto;--directionDesktop-1d1xm6y:row;--directionTablet-12pdsr3:row;--directionMobile-2fl0zc:row;--justifyContentDesktop-zzniix:initial;--justifyContentTablet-18yw0qd:initial;--justifyContentMobile-uj3hc:initial;--alignContentDesktop-v4tyqs:initial;--alignContentTablet-al4c9h:initial;--alignContentMobile-10dtb5f:initial"><div><style>.banner-variant-header-letaido-capabilities-banner { display: none; }
