$undefined\"},{\"id\":18482,\"created_at\":\"2026-09-03T10:11:30.519729+00:00\",\"product_id\":18977,\"version\":\"v1\",\"url\":\"https://toolscope.biz\",\"status\":\"live\",\"description\":\"ToolScope is an AI discovery platform that helps users find, evaluate and review useful AI tools across a wide range of categories. Visitors can explore detailed listings, follow products and discover new solutions, while founders can submit tools, claim their pages and verify ownership. ToolScope also features interactive AI characters that users can chat with or create and customise, bringing software discovery and AI interaction together in one platform.\",\"maker_name\":\"Alexandru Dumbrava\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/toolscope/ToolScope-Microlaunch-Hero-680x340.png\",\"batch_num\":202609,\"start_date\":\"2026-09-05\",\"is_premium\":true,\"votes\":6,\"votes_all_time\":6,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.166666666666667,\"score_execution\":0,\"product_points\":6058.370563888011,\"product_points_week\":2800,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocIwkxYiLEFPk5V6NppXRVrl4l2Mlkrw1hcVNc1jkhA1YWt__Q=s96-c\"],\"feedback_arr\":[{\"vote_id\":20774,\"created_at\":\"2026-09-09T03:51:19.006815+00:00\",\"user_id\":\"0674ce8a-7ccd-4fa0-a552-7592f1d8f22b\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIwkxYiLEFPk5V6NppXRVrl4l2Mlkrw1hcVNc1jkhA1YWt__Q=s96-c\",\"feedback\":\"nice one \",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17554,\"created_at\":\"2026-08-04T23:30:59.147261+00:00\",\"product_id\":18053,\"version\":\"v1\",\"url\":\"https://adcorrector.com\",\"status\":\"live\",\"description\":\"Ad Corrector helps you review billboard and outdoor ad creative for clarity, visibility, and impact. Upload your design and get a quick visual check showing what stands out, what gets overlooked, and how your ad reads at real-world viewing distance. Built for advertisers, designers, and brands who want outdoor ads that communicate clearly and perform in fast-moving environments.\",\"maker_name\":\"Dan Resnikoff\",\"maker_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKFiO08rvWKxV-xrlZulHyEvQwpD9ikQZMBTG2fPbHTN_m9mtSU=s96-c\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/adcorrector/IMG_5747.jpeg\",\"batch_num\":202608,\"start_date\":\"2026-08-04\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":12,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.25,\"score_execution\":5,\"product_points\":6045,\"product_points_week\":4013,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocKFiO08rvWKxV-xrlZulHyEvQwpD9ikQZMBTG2fPbHTN_m9mtSU=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\"],\"feedback_arr\":[{\"vote_id\":19909,\"created_at\":\"2026-08-20T16:59:32.270334+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Ad Corrector Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19451,\"created_at\":\"2026-08-06T08:35:33.503323+00:00\",\"user_id\":\"e186ec02-0cfa-4cd0-aad6-d86ced7adc4e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLLOrHZBYj-4KrFvKQkPAVKBJcdYIbiYsrJAP6p6KeoUd78hA=s96-c\",\"feedback\":\"Clean launch otherwise - robots, sitemap, alt text, single h1 all pass. Two header gaps: no HSTS (HTTPS can be stripped to HTTP on a hostile network) and no CSP. With uploaded ad creative, run CSP report-only first, then enforce.\",\"is_roast\":true,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17831,\"created_at\":\"2026-08-14T10:35:40.465541+00:00\",\"product_id\":18333,\"version\":\"v1\",\"url\":\"https://tailero.com\",\"status\":\"live\",\"description\":\"Tailero is a free career toolkit designed to help people move from job loss to their next opportunity. Create professional CVs, cover letters and career documents, follow practical Restart guidance after losing a job, and get country-specific resources for your job search. Tailero brings the essential tools and next steps into one place, helping you understand what to do next and get back to work faster.\",\"maker_name\":\"Roman Marushko\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@Brain_Orbital/avatar.png\",\"maker_social_handle\":\"Brain_Orbital\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/tailero/LogoTailero2.png\",\"batch_num\":202608,\"start_date\":\"2026-08-16\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":17,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.411764705882353,\"score_execution\":4.833333333333333,\"product_points\":6031,\"product_points_week\":3999,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\"],\"feedback_arr\":[{\"vote_id\":19903,\"created_at\":\"2026-08-20T16:57:41.351081+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Tailero Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19862,\"created_at\":\"2026-08-19T07:15:03.706852+00:00\",\"user_id\":\"70702374-aaa1-45ff-b136-19fcb7f27e39\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK0XyNDCXdHt5UnmgciXr07LIBPiDQ9yaswQywMqKZzwWi-bw=s96-c\",\"feedback\":\"Found Tailero while looking for CV tools and it actually surprised me. Lots of useful templates, clear examples for different jobs, and the AI suggestions feel genuinely helpful.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19857,\"created_at\":\"2026-08-19T06:35:12.076418+00:00\",\"user_id\":\"804cfdd5-6773-4d58-84f0-fd877826911a\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIOtTlD6MAR90H6HLThSQ7sQgm5cYvYCAnAyb_VdrzJuPJ75g=s96-c\",\"feedback\":\"Me gustó porque no parece el típico creador de CV. Eliges tu profesión, partes de tu experiencia y la IA te ayuda a darle forma. Hay buenas plantillas y el resultado queda bastante profesional sin perder horas editando.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19850,\"created_at\":\"2026-08-18T15:31:21.616605+00:00\",\"user_id\":\"9e4f2eff-915d-4c49-941b-d4c39d61e5c4\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJjdFUlRt3N7EEhG2BN2NL7Wi0JWMAfery9UDv22ysrpi07bg=s96-c\",\"feedback\":\"It seemed to me that the interface is very intuitive and everything is quite straightforward. Plus, the service is completely free.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19761,\"created_at\":\"2026-08-17T08:22:16.207191+00:00\",\"user_id\":\"8e1b055c-8e3e-4abf-b1ea-e34cdbe96175\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJ_hyfopdYXa70Vv-AG5EGvRNZUit1UCjlnrzUYYCrYy-vHGwza=s96-c\",\"feedback\":\"Really solid experience. English templates look professional, AI rewrote my CV to match the vacancy perfectly and the ATS check gave clear feedback. Super fast, completely free, no account needed.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19758,\"created_at\":\"2026-08-17T07:44:11.066807+00:00\",\"user_id\":\"06862dce-e978-4f02-83ca-327c860e2ef1\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLty3vAFC2KRRwrLvzIto7k8qWYaPredgyKE5jyxTtAz-f8kB4=s96-c\",\"feedback\":\"La experiencia fue mucho mejor de lo que esperaba. Las plantillas en inglés tienen un acabado muy profesional, la IA adaptó mi CV al puesto y el análisis ATS me señaló exactamente qué podía mejorar. Todo fue rápido, gratis y sin necesidad d\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19757,\"created_at\":\"2026-08-17T07:43:17.001419+00:00\",\"user_id\":\"8426df7e-7115-4e40-923f-341c86de06e3\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLEmra0lrCxPOIDCrxCFaZqSBYFL_O9aYrnnr3o90V6KvhXyQ=s96-c\",\"feedback\":\"Really solid experience. English templates look professional, AI rewrote my CV to match the vacancy perfectly and the ATS check gave clear feedback. Super fast, completely free, no account needed.\