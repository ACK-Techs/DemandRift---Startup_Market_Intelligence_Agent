CMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18458,\"created_at\":\"2026-09-02T09:44:59.638971+00:00\",\"product_id\":18953,\"version\":\"v1\",\"url\":\"https://www.indietools.app\",\"status\":\"live\",\"description\":\"IndieTools is a discovery platform for independent products and the founders behind them. Makers can list their products for free, build founder profiles, share product updates, follow other builders, connect through direct messages, and stay discoverable beyond launch day. Products live in an organically ranked directory, while optional paid features provide additional exposure without changing organic rankings.\",\"maker_name\":\"Cengiz YILMAZ\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@cengizyilmaz_/avatar.png\",\"maker_social_handle\":\"cengizyilmaz_\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/indietools/IndieTools-cover680.png\",\"batch_num\":202609,\"start_date\":\"2026-09-03\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.25,\"score_execution\":0,\"product_points\":5345,\"product_points_week\":2813,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJr9442QHBu6YorGKcPBm5rAAx1ElwYGSrqM8fVvkV7QFDDENyqCg=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1797908061794770944/17ij-3IV_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18648,\"created_at\":\"2026-09-08T19:57:17.23205+00:00\",\"product_id\":19142,\"version\":\"v1\",\"url\":\"https://chartdrill.app?ref=ml\",\"status\":\"live\",\"description\":\"Most people learn trading by watching endless videos and never touching a chart. Chart Drill flips that. Short, Duolingo-style lessons introduce one price action concept, quiz you on real candles, then bring it back later so it sticks. Built by a trader who taught himself the same way. In beta now, free to start, with more units coming.\",\"maker_name\":\"Jake\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@chartdrill/avatar.png\",\"maker_social_handle\":\"chartdrill\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/chartdrill/hero680x340.png\",\"batch_num\":202609,\"start_date\":\"2026-09-14\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.25,\"score_execution\":0,\"product_points\":5345,\"product_points_week\":2813,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJRpIJXwOyKsHKflTd-aRpJYXO68H9CxLn2x1ycqtqT4L9pwv0=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18490,\"created_at\":\"2026-09-03T14:14:03.688467+00:00\",\"product_id\":18985,\"version\":\"v1\",\"url\":\"https://www.seedances3.com/\",\"status\":\"live\",\"description\":\"Seedance 3.0 is a reference-controlled AI video creation workspace for creators, marketers, educators, filmmakers, and product teams. Generate cinematic videos from text, images, video, and audio references with up to 4K output, clips up to 30 seconds, and up to 50 multimedia inputs in one workflow. Create product demos, ads, explainers, storyboards, social videos, and concept films with precise creative direction.\",\"maker_name\":\"Faye Buffey\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@thinkingpeach/avatar.png\",\"maker_social_handle\":\"thinkingpeach\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/seedance30/home.png\",\"batch_num\":202609,\"start_date\":\"2026-09-05\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5305,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",null],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18564,\"created_at\":\"2026-09-06T03:47:15.406245+00:00\",\"product_id\":19058,\"version\":\"v1\",\"url\":\"https://www.peregrineintell.com\",\"status\":\"live\",\"description\":\"Peregrine OS is a suite of B2B intelligence tools built on the Flightpath.AI engine: pre-call prospect intel, account-level pitch briefings, and daily feeds tracking exec hires, funding, AOR gaps, and marketing news — for agency new business and consulting BD teams.\",\"maker_name\":\"Glenn\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@peregrineos/avatar.png\",\"maker_social_handle\":\"peregrineos\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/peregrineos/0AE408AB-39C6-40DE-9A60-2EEAAB22BA0F.png\",\"batch_num\":202609,\"start_date\":\"2026-09-08\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5305,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18624,\"created_at\":\"2026-09-08T07:38:24.715269+00:00\",\"product_id\":19118,\"version\":\"v1\",\"url\":\"https://repairit.wondershare.com/\",\"status\":\"live\",\"description\":\"Wondershare Repairit is an AI-powered media repair and enhancement tool that quickly fixes corrupted videos, photos, audio, and documents. Beyond recovery, it brings your visuals to life with advanced AI old photo restoration, Image to Video generation, and smart One-prompt Photo Editing across all devices.\",\"maker_name\":\"Manna\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/wondersharerepairit/Shou-Ping-Jie-Tu.png\",\"batch_num\":202609,\"start_date\":\"2026-09-09\",\"is_premium\":true,\"votes\":4,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5305,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocIwkxYiLEFPk5V6NppXRVrl4l2Mlkrw1hcVNc1jkhA1YWt__Q=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz04EQ_VTRNe1ivCqZr-rPL2krNo_hkWateyAkatrQ=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18485,\"created_