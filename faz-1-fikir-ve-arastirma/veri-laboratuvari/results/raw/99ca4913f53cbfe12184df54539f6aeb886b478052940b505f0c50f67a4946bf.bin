-49c5-b0fb-8d28663b8926.png\",\"batch_num\":202606,\"start_date\":\"2026-06-03\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":34,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.470588235294118,\"score_execution\":5,\"product_points\":3149,\"product_points_week\":4049,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19013,\"created_at\":\"2026-07-29T07:22:18.48689+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"tiun Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18717,\"created_at\":\"2026-07-15T17:32:40.617846+00:00\",\"user_id\":\"842bddea-85e8-45f3-96c6-7a017a88a4ee\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocI-SJ9EVvJ12KS8Z7dnLU8H_luk4ec38kVCz6APK_uebKfUOw=s96-c\",\"feedback\":\"tiun has great potential! A few improvements could make it even better. I'd love to share my feedback and suggestions.\\n\\nWhatsApp: https://wa.me/447307349530\\nTelegram: t.me/rforrank\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18498,\"created_at\":\"2026-07-09T10:47:18.841144+00:00\",\"user_id\":\"9b5f3216-95e6-4dad-8109-45874ac1ac7f\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJqYdNFGzUwuARzutJazH7r3Dilv-gK6nEz_n6vNIHjvD5WhcM=s96-c\",\"feedback\":\"tiun has great potential! I have a few suggestions that could make it even better. Feel free to reach out for detailed feedback.\\n\\nWhatsApp: https://wa.me/447307349530\\nEmail: Contact@RforRank.com\\nTelegram: t.me/rforrank\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18211,\"created_at\":\"2026-06-29T09:30:21.011433+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"Solid backend toolkit! The \\\"4 lines\\\" pitch is compelling. Minor feedback: clearer migration guides for existing projects would help adoption. Documentation around rate limits and scaling would boost confidence for production use.\",\"is_roast\":true,\"is_feedback_by_maker\":false},{\"vote_id\":18124,\"created_at\":\"2026-06-24T14:17:15.557882+00:00\",\"user_id\":\"ffbc7dee-ef7f-46c7-b8b8-31ba26ae538d\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIuE6n1MpXL5Mc0G7DB88HT7GrwszyEAy4wWbRNEEb8U6ir4SQe1Q=s96-c\",\"feedback\":\"Excellent developer experience. Bundling auth, payments, and DB abstraction is exactly what indie hackers need to ship faster. The '4 lines' promise is compelling and differentiates you. To strengthen further: 1) Add migration guides from S\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":17753,\"created_at\":\"2026-06-05T15:56:34.717392+00:00\",\"user_id\":\"c564eaf4-31c4-43e0-a30b-82666950d9be\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLWW8BQRLuPrHcQ2PG24R31TdESm-GzGEbIMZXRQgs35YsIdhQ=s96-c\",\"feedback\":\"great way for us to get started around subscriptions, user management \u0026 event tracking and the logic that binds them together, allows us to focus on higher impact feature development\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":17712,\"created_at\":\"2026-06-04T11:14:30.212933+00:00\",\"user_id\":\"b85d7399-2402-459b-aaa2-fc322400d874\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKLe5NrKmGtrFYZ8sS24t6zYu2PodQ7nzeEuQ1yq2cqjHf0Bg7F=s96-c\",\"feedback\":\"Looks like a great solution! I am in the sandbox now testing my specific needs and seems like things will be smooth. \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_i