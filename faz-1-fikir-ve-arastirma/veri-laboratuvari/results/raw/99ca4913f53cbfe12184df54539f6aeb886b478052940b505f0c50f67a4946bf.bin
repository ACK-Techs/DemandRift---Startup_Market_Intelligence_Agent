ar.png\",\"maker_social_handle\":\"kondaevama\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/atomicmailagentic/Screenshot-2026-09-17-at-16.22.49.png\",\"batch_num\":202609,\"start_date\":\"2026-09-17\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4692,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18756,\"created_at\":\"2026-09-11T22:17:58.856231+00:00\",\"product_id\":19249,\"version\":\"v1\",\"url\":\"https://www.channelweave.com\",\"status\":\"live\",\"description\":\"Calm multichannel commerce for independent sellers. Stock, listings, orders and supported buyer messages together — with Elqori, your private AI assistant.\",\"maker_name\":\"Graham\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@ChannelWeaveHQ/avatar.png\",\"maker_social_handle\":\"ChannelWeaveHQ\",\"hero_img\":\"\",\"batch_num\":202609,\"start_date\":\"2026-09-18\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4692,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":19033,\"created_at\":\"2026-09-20T12:06:01.670348+00:00\",\"product_id\":19526,\"version\":\"v1\",\"url\":\"https://seedance3ai.ai/\",\"status\":\"live\",\"description\":\"Seedance 3.0 is an AI-driven cinematic generator that turns text, images, video, and audio references into coherent, 30-second narrative videos with synchronized sound and fine-grained control over motion, style, and.\",\"maker_name\":\"Zoe Lucia\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://seedance3ai.ai/og.png\",\"batch_num\":202609,\"start_date\":\"2026-09-20\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4692,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":19034,\"created_at\":\"2026-09-20T12:19:50.593761+00:00\",\"product_id\":19527,\"version\":\"v1\",\"url\":\"https://zinnhub.com/\",\"status\":\"live\",\"description\":\"Zinn Hub is a multilingual freelance marketplace connecting businesses and individuals with vetted global freelancers. Hire through fixed-price services, custom projects or the Freelancer Directory, with 46 languages, live language translation, $0 buyer fees and flexible payouts.\",\"maker_name\":\"Natalie Lock\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://zinnhub.com/wp-content/uploads/2026/02/zinnhub-og-homepage.png\",\"batch_num\":202609,\"start_date\":\"2026-09-21\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4692,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocKy1MDNo2-BP84RK1yCI6nrXnWDLUmAcmuO1Kk-HwSHhZqLq9M=s96-c\",\"https://