\":\"Qevra\",\"slug\":\"qevra\",\"problem_label\":\"List free. Public page. Dofollow backlink.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/qevra/logo-128.png\",\"all_kws\":[\"dofollow directory\",\"free site listing\",\"public directory\",\"backlink\",\"SaaS directory\",\"AI tools\",\"no login\",\"curl submit\",\"startup directory\",\"website directory\"],\"market\":\"directories\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false},{\"id\":18845,\"created_at\":\"2026-09-14T19:50:10.455391+00:00\",\"product_id\":19338,\"version\":\"v1\",\"url\":\"https://hermoso.ai\",\"status\":\"live\",\"description\":\"Hermoso is the marketing team you run from your own AI. Connect it to Claude, ChatGPT, Codex or Cursor and it finds the ads winning in your market, makes image and video ads and organic posts in your brand, publishes to 10 channels, runs campaigns on 11 ad platforms, answers comments and DMs, and reads the results back. 830+ tools over MCP, plus a web studio if you would rather click. Posting, scheduling and analytics are free; credits only go to AI renders and ad research.\",\"maker_name\":\"Andrew Donatello\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@HermosoAI/avatar.png\",\"maker_social_handle\":\"HermosoAI\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/hermoso/hero-2x1-1.webp\",\"batch_num\":202609,\"start_date\":\"2026-09-22\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":3,\"votes_anon_week\":0,\"score_week\":8.2,\"score_week_penalty\":0,\"score_idea\":4.666666666666667,\"score_execution\":5,\"product_points\":6937.370563888011,\"product_points_week\":6476,\"is_boosted\":false,\"voters_avatar_urls\":\"$5b7\",\"feedback_arr\":\"$5b8\",\"final_score\":\"$undefined\",\"codename\":\"Hermoso\",\"slug\":\"hermoso\",\"problem_label\":\"Your marketing on autopilot, run from your own AI\",