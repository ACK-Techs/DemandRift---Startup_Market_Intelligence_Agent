"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":17834,\"created_at\":\"2026-08-14T13:12:34.146865+00:00\",\"product_id\":18336,\"version\":\"v1\",\"url\":\"https://wzrd.to\",\"status\":\"live\",\"description\":\"WZRD is an AI workspace for creating interactive slides, documents, sheets, forms, proposals, and business experiences. Users describe an outcome in natural language, and WZRD generates structured content that can include AI guidance, voice interactions, questions, explanations, responses, signatures, file collection, and engagement tracking. It helps turn static documents and forms into conversational, guided experiences that can be published, shared, embedded, and measured without code.\",\"maker_name\":\"Ali\",\"maker_avatar_url\":\"https://pbs.twimg.com/profile_images/2069193846899310592/ApMILe2Q_normal.jpg\",\"maker_social_handle\":\"wzrdto\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/wzrd/IMG_8424.png\",\"batch_num\":202608,\"start_date\":\"2026-08-14\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":15,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.666666666666667,\"score_execution\":5,\"product_points\":5012,\"product_points_week\":4080,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":19901,\"created_at\":\"2026-08-20T16:57:01.20974+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"WZRD Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19686,\"created_at\":\"2026-08-14T22:25:30.413569+00:00\",\"user_id\":\"fe6a7a19-4b36-41e5-b83e-1401e143b26e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJbPNPzVuEtyhtz9Lp4FHO4pW2_3BOKfObmMPG9ltTugebKhQ=s96-c\",\"feedback\":\"Such an amazing product!! What I’ve been looking for where a form a pdf and different aspects  gets life and talks back to me!! This is insane\\n\\nI created a forum you should test it out!  \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19685,\"created_at\":\"2026-08-14T21:40:00.530877+00:00\",\"user_id\":\"f705ccf9-7fbe-48ef-aa96-bb72f8871a94\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocI-rwIQLgLEV7SqRfFqqzMj4ZdAzo5NmqJoSUXwsc-eQeZ5sw=s96-c\",\"feedback\":\"WZRD’s voice experience genuinely surprised me. It understands you and fills forms like a real person would, almost like having a PA. The slides are quick to create and the images are spectacular.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19678,\"created_at\":\"2026-08-14T21:06:40.592112+00:00\",\"user_id\":\"de4cc486-e64b-4700-a270-e6adf4c5857e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKHmQAdxtl8R6XCpkEnevUB-PNYxzee-WvzQDXqa5LKbkAS8Q=s96-c\",\"feedback\":\"Amazing product u needed it\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19677,\"created_at\":\"2026-08-14T21:05:36.351814+00:00\",\"user_id\":\"8683aff8-3130-48cb-9b30-e26eeee76f35\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIOv6nkLDUkYHl5JixTANMPXSOAmOazChLmZv7D4pgJGwxJHnw=s96-c\",\"feedback\":\"Great product and super easy to use \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19675,\"created_at\":\"2026-08-14T21:02:35.322362+00:00\",\"user_id\":\"c6f48d43-3b53-4adb-ae0e-429617f08a55\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/2069193846899310592/ApMILe2Q_normal.jpg\",\"feedback\":\"Will be giving out 50 free bonus sessions if you provide us with some feedback, please send DM on X!\",\"is_roast\":false,\"is_feedback_by_maker\":true}],\"final_score\":\"$undefined\"},{\"id\":17596,\"created_at\":\"2026-08-05T20:06:56.678475+00:00\",\"product_id\":18095,\"version\":\"v1\",\"url\":\"https://www.jaxsuite.com\",\"status\":\"live\",\"description\":\"JaxSuite is an AI-native cold outreach and CRM platform that helps startups land their first 100 customers without hiring an SDR team. Launch campaigns in under 15 minutes, reach 300M+ verified B2B contacts, and average 42% open rates with built-in warmup and spam testing. MCP-native: Claude and other AI agents can run your entire outbound motion. Startups get 50% off their first year.\",\"maker_name\":\"Orhan Akal\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/jaxsuite/jaxsuite-hero-center-680x340.png\",\"batch_num\":202608,\"start_date\":\"2026-08-10\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":18,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.555555555555555,\"score_execution\":5,\"product_points\":4994,\"product_points_week\":4062,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":19898,\"created_at\":\"2026-08-20T16:55:44.008452+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"JaxSuite Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19627,\"created_at\":\"2026-08-12T20:00:53.721648+00:00\",\"user_id\":\"71f9931c-04f7-479b-a1fa-2598c2ff0e76\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIoVVKirzIIC5toiE8QL5E_SCZyyy10CNjsvxb4Qk8MfYtNwQ=s96-c\",\"feedback\":\"I've used JaxSuite for targeted data and cold email campaigns for consumer products. It's helped me run highly focused campaigns efficiently, and I've been very happy with the results and response rates.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19584,\"created_at\":\"2026-08-10T12:41:21.673616+00:00\",\"user_id\":\"77638975-bfd9-4eec-a071-327f364f1c58\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIBqZWRS0TYH3pby0X6gMAHacAoMrvgGeWTSiT-3A0k1Nmijw=s96-c\",\"feedback\":\"We'd been burned by tools where the sending looked fine on the dashboard and the replies said otherwise. JaxSuite AI shows sender health per account, so we caught a domain going cold before it cost us a week of pipeline. \",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17987,\"created_at\":\"2026-08-19T14:51:44.511595+00:00\",\"product_id\":18485,\"version\":\"v1\",\"url\":\"https://hackathonhost.com/\",\"status\":\"live\",\"description\":\"HackathonHost is an all-in-one platform for running hackathons, demo days and team-based competitions — from registration to results. Organizers get one branded space to collect sign-ups, build teams, run judging against custom criteria, control the live event with timers and projector views, reveal results and rewards, and issue certificates with QR verification. Plus email broadcasts, surveys, exports and analytics. It runs white-label under your own brand and you pay $99 per event with no subscription.\",\"maker_name\":\"Ilgar Alirzayev\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/hackathonhost/hackathonhost-facebook-cover.png\",\"batch_num\":202608,\"start_date\":\"2026-08-19\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":19,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.631578947368421,\"score_execution\":4.857142857142857,\"product_points\":4972,\"product_points_week\":4040,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":19893,\"created_at\":\"2026-08-20T16:52:32.567239+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"HackathonHost Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19882,\"created_at\":\"2026-08-19T20:47:35.849021+00:00\",\"user_id\":\"09458ebd-bdd9-4ab7-b6a4-478098acdb41\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJtuUsuqpdwHl0GiAWMGYJqW1wpKBYnS5r8mh8vY2ClFYJvBg=s96-c\",\"feedback\":\"I liked the smooth experience that product gives\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19879,\"created_at\":\"2026-08-19T18:21:46.616262+00:00\",\"user_id\":\"62267e11-99f3-4d2c-a0f2-185f36d9e8af\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJSRue0YBvcfSSn3HBg_KlVGKRhjeutEDnOcfUx_LT4hHNpZCc=s96-c\",\"feedback\":\"best product\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19878,\"created_at\":\"2026-08-19T18:06:13.121827+00:00\",\"user_id\":\"d20833df-159d-4165-b991-c9eeee2260bd\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJCkBs9vk0qm6weFbf4m_Bdxa4y-M6yd7HWVjpJSZC6AuSflYUa=s96-c\",\"feedback\":\"Perfect aöö\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19877,\"created_at\":\"2026-08-19T18:01:08.602235+00:00\",\"user_id\":\"cdb17ef8-dc2b-4695-b4c9-231fd50ee88a\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocL_MUq5CezPOM8Po3z-Q1xgKU4JyMgPKUhk790IuQ2L8Ox0Bo8=s96-c\",\"feedback\":\"We organized playtest event with this app, Voting pool was very effective and easy to use\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19875,\"created_at\":\"2026-08-19T17:44:40.25886+00:00\",\"user_id\":\"5f5c33de-445c-4c67-aa92-9d3e83a3fe7e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIKEmkXPnIzq3HvuBRTtY3Up4vE2vZPs9RzbWEjsIM2trib7EM=s96-c\",\"feedback\":\"Used it as a participant, very easy to use, doesn't get in the way.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17891,\"created_at\":\"2026-08-16T10:22:47.46158+00:00\",\"product_id\":18391,\"version\":\"v1\",\"url\":\"https://faqhub.io\",\"status\":\"live\",\"description\":\"FAQ Hub turns scattered product knowledge into reliable, customer-ready support. Import PDFs, DOCX files, Markdown, or website content, then review and approve what goes live. Customers get grounded answers through AI chat, an inline help portal, or a hosted help centre. When sources cannot support an answer, FAQ Hub stops safely and hands the conversation to a human. Built for founders and lean SaaS teams, with simple, predictable monthly pricing.\",\"maker_name\":\"Dane\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@dane_hollenbach/avatar.png\",\"maker_social_handle\":\"dane_hollenbach\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/faqhub/Screenshot-2026-08-16-112007.png\",\"batch_num\":202608,\"start_date\":\"2026-08-25\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.333333333333333,\"score_execution\":5,\"product_points\":4958,\"product_points_week\":4027,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18222,\"created_at\":\"2026-08-25T23:10:46.003789+00:00\",\"product_id\":18719,\"version\":\"v1\",\"url\":\"https://streakwars.com/\",\"status\":\"live\",\"description\":\"Turn any daily goal into a last-person-standing competition. Join a War, post proof before each deadline, and keep your streak alive. Miss once and you're out; the last eligible player wins.\",\"maker_name\":\"Nirav\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/sw/streakwars-microlaunch-hero-680x340.jpg\",\"batch_num\":202608,\"start_date\":\"2026-08-26\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":6,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.166666666666667,\"score_execution\":5,\"product_points\":4932,\"product_points_week\":4000,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":20084,\"created_at\":\"2026-08-27T02:00:09.231047+00:00\",\"user_id\":\"ea168a17-2804-4638-b3e7-5e026dad4705\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocI3ao4kkkyxEfgogHf7wtmnuScb75FHFh_Mae-XmztEtgm7gTvfkQ=s96-c\",\"feedback\":\" I love how simple the idea is: choose a goal, post daily proof, and stay in the competition. The last-person-standing format creates real motivation without making it like another habit tracking app\",\"is_roast\":false,\"is_feedback_by_maker\":true}],\"final_score\":\"$undefined\"},{\"id\":18415,\"created_at\":\"2026-09-01T00:58:09.705212+00:00\",\"product_id\":18911,\"version\":\"v1\",\"url\":\"https://dataandapis.com\",\"status\":\"live\",\"description\":\"dataandapis.com is a self-serve API marketplace built for developers who'd rather ship than negotiate. One token-based subscription unlocks the entire catalog: geolocation, data validation, currency rates, HTML rendering, SSL checks, sanctions screening, device databases and more. No per-API contracts, no sales calls, no surprise invoices. Sign up, grab your key, and call your first endpoint in under a minute. Utility APIs at prices that make building it yourself the expensive option.\",\"maker_name\":\"Roy Nelson\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@DataAndApis/avatar.png\",\"maker_social_handle\":\"DataAndApis\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/dataandapis/dataandapis-hero.png\",\"batch_num\":202609,\"start_date\":\"2026-09-01\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4898.370563888011,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18449,\"created_at\":\"2026-09-02T02:13:39.489599+00:00\",\"product_id\":18944,\"version\":\"v1\",\"url\":\"https://getopenportal.com\",\"status\":\"live\",\"description\":\"Fastest way to ask AI about anything on your screen. Box anything on your screen. Get an answer, or a finished thumbnail, ad, or redesign.\",\"maker_name\":\"Kamran\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@kxmrxn29/avatar.png\",\"maker_social_handle\":\"kxmrxn29\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/openportal/ph01hero.png\",\"batch_num\":202609,\"start_date\":\"2026-09-01\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4898.370563888011,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":17976,\"created_at\":\"2026-08-19T10:42:59.533919+00:00\",\"product_id\":18474,\"version\":\"v1\",\"url\":\"https://aelivra.co/\",\"status\":\"live\",\"description\":\"Nourishment\\nPersonalised goodness recipes guiding you through all health needs.\\n\\nSymptoms\\nEffortless symptom tracking, say goodbye to manual logging.\\n\\nMovement\\nGuided movement and exercises routines that heal your soul, and your body.\\n\\nBiomarkers\\nBiomarker lab result tracking and insights across your key health markers.\\n\\nMindfulness\\nGuided meditations across breathwork, mindfulness, sleep, and relaxation.\\n\\nWearables \u0026 Records\\nYour whole health picture dynamically shaping your plan.\",\"maker_name\":\"aelívra\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/aelivra/still-f12-2-2.jpg\",\"batch_num\":202608,\"start_date\":\"2026-08-24\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":7,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.428571428571429,\"score_execution\":4.5,\"product_points\":4854,\"product_points_week\":3922,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":19990,\"created_at\":\"2026-08-24T02:25:04.033147+00:00\",\"user_id\":\"dacd22dc-92cf-4263-a51f-1f6ed4462398\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK_2q8U-udzFez0ID47k3rTx1wrEo-F_vjg0pXAVnC-h-6-tA=s96-c\",\"feedback\":\"One thing I like is that I don't have to obsessively track and log. I LOVE that this basically does it for me, and actively monitors whether what Im doing is working\\nDisclosure: Early access user\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19988,\"created_at\":\"2026-08-24T02:07:35.794113+00:00\",\"user_id\":\"f47fa796-3101-4bd0-b67f-d11690c62440\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJw8xwYUefK5_kXUl8Zqb6NN_9DN4jxSS2ddid2muuPqiYkuA=s96-c\",\"feedback\":\"This is actually pretty well done for a first launch. Relevant idea, very topical. Chat could be faster. Maybe you should go deeper on a certain ICPs rather than broad? More deeply manage my health journey\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18370,\"created_at\":\"2026-08-30T19:35:04.854093+00:00\",\"product_id\":18867,\"version\":\"v1\",\"url\":\"https://grumble.fyi\",\"status\":\"live\",\"description\":\"Grumble is a place for discovering and sharing honest, bad reviews about brands business and public services! We're all about fighting shitification \u0026 giving power back to consumers. Users can post complaints, photos, videos, and stories, and connect with others through likes, comments, and shares and see the rage visualized in real time!\",\"maker_name\":\"Tarek\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@GrumbleAboutIt/avatar.png\",\"maker_social_handle\":\"GrumbleAboutIt\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/grumble/Artboard-1-2x-100.jpg\",\"batch_num\":202609,\"start_date\":\"2026-09-11\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":1,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":5,\"score_execution\":0,\"product_points\":4827,\"product_points_week\":2933,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/2060689356575113216/kNoV6Y9d_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":20829,\"created_at\":\"2026-09-11T15:55:51.156533+00:00\",\"user_id\":\"6c1d1514-b7f0-4fff-bbe9-f1afe04501e7\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/2060689356575113216/kNoV6Y9d_normal.jpg\",\"feedback\":\"Fun way to make brands/corps get spotlighted for squeezing us for every last dime! \",\"is_roast\":false,\"is_feedback_by_maker\":true}],\"final_score\":\"$undefined\"},{\"id\":18765,\"created_at\":\"2026-09-12T07:35:29.414727+00:00\",\"product_id\":19258,\"version\":\"v1\",\"url\":\"https://rocketsender.co/\",\"status\":\"live\",\"description\":\"Rocket Sender is a free WhatsApp Sender for personalized bulk messaging directly in WhatsApp Web.\",\"maker_name\":\"aiqanobzfsej5\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/whatsappsender/screenshot_2026-09-12_15-33-56.png\",\"batch_num\":202609,\"start_date\":\"2026-09-12\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4692,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"}