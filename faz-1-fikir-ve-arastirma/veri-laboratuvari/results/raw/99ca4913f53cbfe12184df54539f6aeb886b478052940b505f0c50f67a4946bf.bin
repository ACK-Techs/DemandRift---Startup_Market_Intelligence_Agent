atar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLY9yZ29juZXZe54Ji3bq8W-10t2REGSQcmC-2Z5FTwrgbc5dkryw=s96-c\",\"user_name\":\"Alessandro Lazzarin\",\"text\":\"Thanx for your feedback!\",\"created_at\":\"2026-06-16T13:57:26.025Z\",\"edited_at\":\"2026-07-06T06:59:56.505Z\",\"depth\":1,\"children\":[]}]}},{\"vote_id\":17837,\"created_at\":\"2026-06-11T13:07:25.877965+00:00\",\"user_id\":\"7b532f2a-4bb6-4585-9a96-43c3c5b703d8\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLY9yZ29juZXZe54Ji3bq8W-10t2REGSQcmC-2Z5FTwrgbc5dkryw=s96-c\",\"feedback\":\"MapScout lets you search any business category on Google Maps, in any city, and instantly export the full results — name, address, phone, website — into a clean, structured spreadsheet. No browser extensions, no scripts, no API keys.\",\"is_roast\":false,\"is_feedback_by_maker\":true}],\"final_score\":\"$undefined\"},{\"id\":16072,\"created_at\":\"2026-06-01T06:46:18.67654+00:00\",\"product_id\":16584,\"version\":\"v1\",\"url\":\"https://crawlraven.com/\",\"status\":\"live\",\"description\":\"CrawlRaven is a professional SEO audit platform: crawl deep, fix what matters, rank higher. We crawl up to 50,000 pages and run 200+ checks across technical SEO, Core Web Vitals, structured data, links, and security — then rank every issue by ranking impact, so you know what to fix first. Agencies get white-label reports, scheduled audits, and team collaboration built in. And our MCP server plugs CrawlRaven into Claude: audit, pull the prioritized fixes, fix them with AI, and re-audit — in one loop.\",\"maker_name\":\"Aditi \",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/crawlraven/frame-2147228096.png\",\"batch_num\":202606,\"start_date\":\"2026-06-01\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":15,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.333333333333333,\"score_execut