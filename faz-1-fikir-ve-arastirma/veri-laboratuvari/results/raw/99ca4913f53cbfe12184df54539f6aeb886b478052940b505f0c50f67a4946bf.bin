pular.\",\"maker_name\":\"Lakshay Mittal\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@Onyatrips_/avatar.png\",\"maker_social_handle\":\"Onyatrips_\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/onyatrips/WhatsApp_Image_2026-09-14_at_8.05.41_PM_681x332.PNG\",\"batch_num\":202609,\"start_date\":\"2026-09-14\",\"is_premium\":true,\"votes\":39,\"votes_all_time\":39,\"votes_week\":1,\"votes_anon_week\":0,\"score_week\":3.39,\"score_week_penalty\":0,\"score_idea\":4.743589743589744,\"score_execution\":4.6923076923076925,\"product_points\":10964.741127776022,\"product_points_week\":5312,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocKgGYOh6kcYcwPUYCBJ1BHxAxOLLbK6K1sCZDaQagMtPE95Nmc=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI2hl1NCwkwYZCby6M9MCg2TWHGgnH5uailORmWoRqCLDI7Ow=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocL-YIcWJjFbkDgnsdqBV1ZQbUpwZrkFkEtd3WYj0Pncef0eDw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLmrWuQ61jbnTQBSD2RvJlUMh9uB3r6v3H-l6S1qJOgK5TbEg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJwyTEqN_pGl7XE0OO_zMRK6Er73IdXBBULIXkAfi02W3yMiA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKeL_0o7n-uB1A42h2ucOds_TDEMA5p3qCS14DqIAkAOSTTqw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI03lwHKFQVbn6rj02dWjMp1_6l8YQlxa9AEiUbdqcGBeJGASm_=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIVm1Sy32wMZ8wJ5iIv6cqXM4g_r0vRiatmydH71Ow7hgQ_Xh78=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKd2rihCXU218e6QmGGNn_nbtkxqZcg4EQR9BzpaxZp0uBAhg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocK8UUXiuGK0M5PrbbBjnFXy07RQJdzaWAati2vyy5filfbs9HiC=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIoaTM9xAw2fQkeByvmar7vjSAdVwjPqnCaNWHYtrUsnurCYM9H=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLBXAJ1bleZ_GqDeU2EFGQh23ZeHIq1Jr4aMW2aXtgpTUBC2Bw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKJuWJ584CJth0ypMC19EK8vqcREMQ-Y