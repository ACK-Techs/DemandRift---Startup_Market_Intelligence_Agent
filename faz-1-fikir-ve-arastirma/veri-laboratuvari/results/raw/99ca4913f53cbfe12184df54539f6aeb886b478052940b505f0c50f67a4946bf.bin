ium\":true,\"votes\":0,\"votes_all_time\":7,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":2373,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19336,\"created_at\":\"2026-08-04T10:08:46.414098+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Karpo Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18981,\"created_at\":\"2026-07-29T06:52:27.184693+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Karpo Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17400,\"created_at\":\"2026-07-30T20:50:29.472644+00:00\",\"product_id\":17904,\"version\":\"v1\",\"url\":\"https://highreach.ai/\",\"status\":\"live\",\"description\":\"HighReach is an AI creative studio for turning ideas into production-ready images, videos, and audio. Generate, edit, and transform content with leading AI models and specialized tools, all in one simple workspace for creators, brands, and businesses.\",\"maker_name\":\"Nikhil\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/highreach-c3d072/Screenshot_2026-07-31_at_1.09.29_AM_optimized_950.png\",\"batch_num\":202607,\"start_date\":\"2026-07-31\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":2373,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19337,\"created_at\":\"2026-08-04T10:09:14.396778+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"HighReach Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17104,\"created_at\":\"2026-07-20T00:17:36.707291+00:00\",\"product_id\":17609,\"version\":\"v1\",\"url\":\"https://presly.ai\",\"status\":\"live\",\"description\":\"Presly is an AI social media manager built for local businesses. Tell it about your business and it learns your brand voice, then writes captions, designs images, and publishes to 10 platforms on the schedule you set. Messages, comments, and reviews arrive in one inbox with replies already drafted for you to review and send. Made for restaurants, salons, dental offices, gyms, and repair shops. From $39/month.\",\"maker_name\":\"Thao Le\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/presly/presly-hero-1000x500.png\",\"batch_num\":202607,\"start_date\":\"2026-07-31\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":2,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":2373,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[],\"f