_id\":19437,\"version\":\"v1\",\"url\":\"https://submitrax.com\",\"status\":\"live\",\"description\":\"No backend, no config marathon. Copy your SubmitraX endpoint into any HTML form and you're live — submissions land in your inbox, Slack, Discord, or a webhook instantly. Static site, landing page, side project: get a real, working form up in the time it takes to grab a coffee.\",\"maker_name\":\"Thomas Vie\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@submitrax/avatar.png\",\"maker_social_handle\":\"submitrax\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/submitrax/hero-dashboard.png\",\"batch_num\":202609,\"start_date\":\"2026-09-18\",\"is_premium\":true,\"votes\":1,\"votes_all_time\":1,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":5,\"score_execution\":5,\"product_points\":5565,\"product_points_week\":4133,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLLGELajA6bAeeNa2ta7Xtiw3IpvJHoyCk9F02TTa2oc7B8t6RT=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18612,\"created_at\":\"2026-09-07T22:03:09.80584+00:00\",\"product_id\":19106,\"version\":\"v1\",\"url\":\"https://shoraapp.com\",\"status\":\"live\",\"description\":\"Check in with how you feel — one tap or a few words — and Shora composes a 2–10 minute guided session from 20 evidence-based techniques, narrated in your language, then learns what works for you. Free to start on iPhone and Android.\",\"maker_name\":\"Bogdan\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@shoraapp/avatar.png\",\"maker_social_handle\":\"shoraapp\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/shora/HERO-cta-4k.jpg\",\"batch_num\":202609,\"start_date\":\"2026-09-14\",\"is_premium\":true,\"votes\":5,\"votes_all_time\":5,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalt