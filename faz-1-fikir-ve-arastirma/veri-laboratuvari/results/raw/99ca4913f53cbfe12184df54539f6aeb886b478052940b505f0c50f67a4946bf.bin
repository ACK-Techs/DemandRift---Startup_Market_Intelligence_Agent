content.com/a/ACg8ocJYQvPbll5tTg3evQM2yrrh8tC8C0X5uQTKpCo2R-t3FG64Cg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI-FTNwJqt4txPaal7Da04y30u1dHzvLvj_J6_nd10AOMknBA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocK4G_mL2hDQaDUmQ_BJf0piVWXDQgUfCigWejGm7Z8Av56WGyzB=s96-c\",\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":21149,\"created_at\":\"2026-09-24T23:40:05.219361+00:00\",\"user_id\":\"b9fecca6-51f9-43d6-8fe2-66ebeb042669\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\",\"feedback\":\"Focusing on who to experience a place with, not just where to go, is a thoughtful angle for travel discovery.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20980,\"created_at\":\"2026-09-16T18:18:22.221524+00:00\",\"user_id\":\"9b380b43-355a-433f-98b9-e5920555485f\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK4G_mL2hDQaDUmQ_BJf0piVWXDQgUfCigWejGm7Z8Av56WGyzB=s96-c\",\"feedback\":\"Onyatrips makes travel discovery and planning feel simpler and more convenient. I love the idea of bringing travel information together in one place. With more personalization, it could become a great travel companion! ✈️\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20957,\"created_at\":\"2026-09-15T15:40:32.147323+00:00\",\"user_id\":\"25d7de25-3b44-44aa-9f87-937c3e403751\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJBDDK-kdOv-_GwVWc4t33qB-4DCLiW6GJ0cZPk0FzQPUvuU2jh=s96-c\",\"feedback\":\"Huge congratulations on the launch! 🎉 The travel space desperately needs a platform focused on meaningful connections rather than just generic itineraries. The 5.0 rating on the Idea says it all—this is exactly 'The Way Travel Should Be.' \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20922,\"created_at\":\"2026-09-15T04:44:00.78975+00:00\",\"user_id\":\"d47b4a64-cedb-40a9-b4e9-77a62a798db4\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLgRyuRk-PLW2HzKKz83Mze5R4fQzEqR01RXQcrAU6Y2ZEy2w=s96-c\",\"feedback\":\"This is giving “finally, travel made easy” ✨\\nLowkey obsessed with this concept\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20919,\"created_at\":\"2026-09-15T01:55:43.021136+00:00\",\"user_id\":\"ec95feca-c8a9-439a-b4f5-d97ae55a5ee3\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKbvI8F7WCrPuA1LNNUF46j5zC9qBUmZWaDB-hczm3KFYgNwg=s96-c\",\"feedback\":\"Very helpful \u0026 useful!!  must go for it100%\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20918,\"created_at\":\"2026-09-14T21:51:19.066349+00:00\",\"user_id\":\"8a7c7a9d-50b0-4be6-b4ee-f293b18eb8c2\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocL5b1JkruJC9M_28bOmNbZal5hF1UWDIimXmW8rDg5E6GPANXj7RA=s96-c\",\"feedback\":\"Congratulations on the launch! The overall experience feels clean, intuitive, and easy to navigate. One feature I’d be particularly excited to see in future updates is more personalized recommendations based on users’ travel preferences.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20917,\"created_at\":\"2026-09-14T21:49:58.535459+00:00\",\"user_id\":\"08802fe5-7564-4943-a1b7-bb227313916b\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLsNXa8kPYYOQ3SbYycUQCOafZAevyQ74LS24Oc6fOD13eoj6g=s96-c\",\"feedback\":\"Really love the concept behind Onyatrips! It makes travel feel more social, convenient, and exciting. The clean interface and group-travel experience make planning trips so much more fun.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20906,\"created_at\":\"2026-09-14T18:29:49.139405+00:00\",\"user_id\":\"a9d9ae16-5055-4f14-be51-14a85d49a972\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJELC3zYTBvXTXLAV4tjX86oJPBpK5tsdz1BmzZmXSx2wLwb94r=s96-c\",\"feedback\":\"Best travelling website to get socialise\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20901,\"created_at\":\"2026-09-14T17:11:12.334221+00:00\",\"user_id\":\"d8c07676-13f4-4c14-8c97-e524fb1ad645\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJevgv3srkNqfs8UOZ6jiZDTOH3rLI2NJ61y50OUjSTqm7s8Xw8lw=s96-c\",\"feedback\":\"It's not just another travel platform, there’s a lot of thought behind how the experience is put together and very user friendly. Congrats on making it to launch!\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20900,\"created_at\":\"2026-09-14T17:05:58.98019+00:00\",\"user_id\":\"40e13b98-3231-4f1d-8f9f-f4f7d4645392\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKETWOpUvTCpP9RztGXD4HlJ0McnL605dYkri2ZXG67CDmKqAyM=s96-c\",\"feedback\":\"The new way to make your travel easy and fun \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20899,\"created_at\":\"2026-09-14T16:40:44.089126+00:00\",\"user_id\":\"7cf7bcc6-d134-4fa8-8d49-3a47a0b6391b\",\"voter_avatar_url\":null,\"feedback\":\"Really nice project! The idea behind OnyaTrips looks useful for making travel planning easier and more convenient. The project looks clean and well-presented. Wishing you all the best for the launch! 🚀\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20898,\"created_at\":\"2026-09-14T16:34:37.075445+00:00\",\"user_id\":\"aba29715-9ef0-42ad-ab51-17261996fb8f\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLM8w8EvW7M_d7ddJNqZZICHTwi82MICWM9nYqu1CPWAVhq1A=s96-c\",\"feedback\":\"Congrats on launching Onyatrips!  Proud to have been part of the journey — excited to see where this goes. \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20897,\"created_at\":\"2026-09-14T16:26:39.10703+00:00\",\"user_id\":\"2dc1a9ca-c05e-4eea-ab39-aa2e05a65c8e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocInQfdkEVPSM8iWblHAiqueQWVTwrUG8o0gZAd9GJnZ7U0QJw=s96-c\",\"feedback\":\"Great work by Onyatrips..A best platform for travellers to plan along with the itinerary and best places to explore..\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20896,\"created_at\":\"2026-09-14T16:20:02.633853+00:00\",\"user_id\":\"d91cb2e5-3576-4e02-9f54-8946fe4a7481\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJfCLbBlQmPAwMMZunkKKcZSiKrVbmlThcALkK51HZusd-aw3I=s96-c\",\"feedback\":\"Love the idea behind this! Finding people who actually match your travel vibe is underrated. Excited to see where Onyatrips goes from here\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20895,\"created_at\":\"2026-09-14T16:18:44.94019+00:00\",\"user_id\":\"5665d794-1823-4ebf-91cf-1596bdfbba8d\",\"voter_avatar_url\":null,\"feedback\":\"This is very helpful \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20894,\"created_at\":\"2026-09-14T16:16:19.595777+00:00\",\"user_id\":\"4b6a5881-ade0-48e2-b373-e5341897bb91\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKxwwLtC14AShgcO05Ev1wPmYQYHlPVwZ_5E5_kkhgElw7i6A=s96-c\",\"feedback\":\"I am new to this product\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20893,\"created_at\":\"2026-09-14T16:15:23.136553+00:00\",\"user_id\":\"dff23916-950f-4b52-822f-f2d7b8aafe55\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKbtRovHeqW0IG3DLyVFXxW5ctq83xZVzCr8LZGaj5lMYHwq7jP=s96-c\",\"feedback\":\"Onyatrips has a very interesting and thoughtful concept. I really liked the idea and its approach to making travel more enjoyable and memorable.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20892,\"created_at\":\"2026-09-14T16:13:05.342397+00:00\",\"user_id\":\"f8b81aca-cf08-4986-8067-d67a80770792\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIy_k0MMe2mN8TWqRCsARvE9Y_x9V6G6YJqfhkfbXvOpoua-or0=s96-c\",\"feedback\":\"Really nice launch! The overall experience feels clean and easy to explore. One thing I’d love to see in future is more personalized recommendations based on the kind of trips a user usually takes. Excited to see this grow!\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20890,\"created_at\":\"2026-09-14T16:06:48.42206+00:00\",\"user_id\":\"7a8672cc-c1bb-4170-95d1-c086246108d0\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocL1u6o91hntfDjqFX8gpnHbYXcnKrEQednYLjiTCMbOxwQlFw=s96-c\",\"feedback\":\"Easy-to-use site that makes discovering new places and booking group trips feel completely seamless.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20889,\"created_at\":\"2026-09-14T16:03:19.464336+00:00\",\"user_id\":\"f3157aa0-8474-4e39-b5a9-e4b92c0bc4bc\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKJuWJ584CJth0ypMC19EK8vqcREMQ-YYv7hlIcY2dD7_w7qzv0=s96-c\",\"feedback\":\"the interface was really smooth and interactive, as for me it interesting and very adorable.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20887,\"created_at\":\"2026-09-14T16:02:54.120182+00:00\",\"user_id\":\"ee852ba6-cc8e-444d-9e5c-1d442622b80e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIoaTM9xAw2fQkeByvmar7vjSAdVwjPqnCaNWHYtrUsnurCYM9H=s96-c\",\"feedback\":\"Love how this makes planning trips feel less like a chore and more like an adventure.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20886,\"created_at\":\"2026-09-14T16:02:44.593067+00:00\",\"user_id\":\"8854d10b-dd41-477a-8e85-e07d6a1d5243\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK8UUXiuGK0M5PrbbBjnFXy07RQJdzaWAati2vyy5filfbs9HiC=s96-c\",\"feedback\":\"This is something the travel community definitely needed! \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20885,\"created_at\":\"2026-09-14T15:59:55.999476+00:00\",\"user_id\":\"adb13166-4304-4497-8509-9209f5e