week\":2133,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[],\"final_score\":\"$undefined\"}],\"products\":[{\"created_at\":\"2025-11-06T13:24:25.88387+00:00\",\"id\":13069,\"codename\":\"AI Video Generator\",\"slug\":\"saas-568c5d\",\"problem_label\":\"AI Video Generator for Text to Video and Image to Video\",\"solution_label\":\"Create cinematic AI videos from a prompt or animate still images into motion. GenVideo helps creators make social clips, product videos, ad creatives, and story-driven visuals in minutes.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/saas-568c5d/logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"idea\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2025-11-14T13:34:20.401276+00:00\",\"id\":13278,\"codename\":\"FeatureVoice\",\"slug\":\"featurevoice\",\"problem_label\":\"Fastest way to validate product features with customers\",\"solution_label\":\"Validate product ideas with customer voting. Get instant feedback on feature idea from your users through one-click email-based voting. Make data-driven product decisions with real customer insights in hours, not weeks.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/featurevoice/logo_q100-128px.webp\",\"niche_kws\":[\"feature voting\",\"customer feedback\",\"product validation\",\"feature requests\",\"user voting\",\"product management\",\"customer insights\",\"feature prioritization\",\"product decisions\",\"user feedback\",\"product development\",\"customer validation\",\"feature ideas\",\"email voting\",\"product roadmap\"],\"icp_kws\":[],\"market\":\"brainstorming-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-02-18T11:25:14.911756+00:00\",\"id\":14539,\"codename\":\"Nano Banana Pro\",\"slug\":\"nanobananapro-7dc0e1\",\"problem_label\":\"Stunning Visuals Nano Banana Pro\",\"solution_label\":\"Nano Banana Pro is an innovative AI tool designed for creating stunning 3D caricature portraits in a captivating Pixar style. Its advanced technology allows users to transform photos into eye-catching digital art with ease. Whether you're looking to enhance your personal projects or create unique gifts, Nano Banana Pro delivers high-quality, customizable results. Perfect for artists, designers, or anyone who loves creative expression, this tool combines simplicity and sophistication to bring your artistic visions to life. Elevate your digital art game with Nano Banana Pro and impress your audience with vibrant and playful designs.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/nanobananapro-7dc0e1/image.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-03-27T14:08:54.057438+00:00\",\"id\":15240,\"codename\":\"HaloVoice\",\"slug\":\"halovoice\",\"problem_label\":\"Real‑time voice translation for streaming, gaming, and meetings\",\"solution_label\":\"HaloVoice is an AI-powered real-time voice translator for gaming, streaming, meetings, and multilingual voice chat. It provides live voice translation and real-time speech translation across apps like Discord, OBS, Zoom, Slack, and Teams, making it easy to communicate across languages in real time.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/halovoice/74ca5e63-35b6-4bbe-a262-0128d07d59a9.jpg\",\"niche_kws\":[\"real-time voice translation; speech-to-speech AI; live translation; voice changer; voice cloning; AI voice; multiple voices; personas; multilingual communication; plug‑and‑play; low latency; gaming‑friendly; works with your tools; streaming tool; gaming tool\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-05-07T07:11:12.506748+00:00\",\"id\":16099,\"codename\":\"ASI:One\",\"slug\":\"asione\",\"problem_label\":\"A personal AI with memory that plans and acts for you\",\"solution_label\":\"ASI:One is a personal AI that remembers your preferences, collaborates with others’ AIs, and executes tasks. Plan nights out, align groups, and book the details automatically. It is connected to millions of agents through Agentverse, giving you on-demand capabilities for research, planning, and real-world tasks.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/asione/asi-one-logo.png\",\"niche_kws\":[\"Agents\",\"AI\",\"Personal AI\",\"Productivity\",\"Artificial Intelligence\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-11T09:30:42.696255+00:00\",\"id\":16177,\"codename\":\"Repolog\",\"slug\":\"repolog\",\"problem_label\":\"Website audit for SEO, performance, security \u0026 AI Readiness\",\"solution_label\":\"Repolog is a website audit built for how the web works in 2026.\\n\\nSEO score - meta tags, structured data, crawlability, internal linking\\nPerformance score - Core Web Vitals, render-blocking resources, real-world load behavior\\nAI Readiness score - how easily LLMs can parse, cite, and recommend your content\\nEvery issue comes with a plain-English explanation and a concrete fix.\\n\\nWho it's for:\\nIndie hackers, founders, and small teams who don't have an SEO agency on retainer.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/repolog/repolog.png\",\"niche_kws\":[\"ai\",\"audit\",\"ai-readiness\",\"seo\",\"seo audio\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-13T19:55:01.218008+00:00\",\"id\":16244,\"codename\":\"HIPAA Security Suite®\",\"slug\":\"hipaasecuritysuite\",\"problem_label\":\"Your Key to HIPAA Compliance®\",\"solution_label\":\"HIPAA Security Suite is an all-in-one HIPAA compliance software platform that helps healthcare organizations simplify risk assessments, employee training, policy management, documentation, remediation, and audit readiness. Built for medical practices, business associates, and healthcare service providers, it gives teams the tools they need to manage HIPAA requirements in one organized, easy-to-use system.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hipaasecuritysuite/HSS_logo_115px.jpg\",\"niche_kws\":[\"HIPAA\",\"HIPAA Compliance\",\"HIPAA Training\",\"HIPAA Risk Assessment\",\"CISA KEV\",\"Network Security Assessment\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-20T19:22:02.236352+00:00\",\"id\":16383,\"codename\":\"Aeterna\",\"slug\":\"aeterna\",\"problem_label\":\"Create an interactive AI digital twin to preserve your family's legacy.\",\"solution_label\":\"Aeterna is a secure digital vault that turns your life stories, photos, and voice notes into an interactive AI Digital Twin. Don't just leave behind a static box of photos—give future generations the ability to converse with your memories forever.\\n\\nKey Features:\\n\\n🎙️ AI Biographer: Effortless weekly storytelling prompts.\\n\\n🧠 Zero-Hallucination RAG: Stays 100% true to your actual words.\\n\\n🔒 Bank-Grade Privacy: AES-256 encrypted, never sold.\\n\\n📦 Media Vault: Add photos and letters for context.\\n\\nFree Account!\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aeterna/d6db9e0c-712c-4081-b507-13cfcad21caf__1_-removebg-preview.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-26T14:34:55.942647+00:00\",\"id\":16483,\"codename\":\"CompoundCoders\",\"slug\":\"compoundcoders\",\"problem_label\":\"Engineer your AI workflow. Ship better code.\",\"solution_label\":\"Learn how to build production software with AI — not just demos. Courses, community, and reusable workflows for engineers shipping real systems.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/compoundcoders/logo-mark-128.png\",\"niche_kws\":[\"developer-tools\",\"ai-coding\",\"education\",\"online-course\",\"programming\",\"productivity\",\"rust\",\"typescript\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Info product, Newsletters, Communities\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-28T09:15:07.321358+00:00\",\"id\":16519,\"codename\":\"LangPanda\",\"slug\":\"langpanda\",\"problem_label\":\"Learn languages watching your favorite shows\",\"solution_label\":\"LangPanda lets you learn languages watching your favorite shows on YouTube, Netflix and 20+ other video platforms\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/langpanda/icon-128.png\",\"niche_kws\":[\"language\",\"language learning\",\"netflix\",\"youtube\",\"SRS\",\"anki\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-30T07:52:46.475124+00:00\",\"id\":16553,\"codename\":\"Cerulea\",\"slug\":\"cerulea\",\"problem_label\":\"No-Code Blockchain Infrastructure Platform\",\"solution_label\":\"Cerulea is an AI-enabled, No-Code, Modular Layer 1 blockchain infrastructure platform that fundamentally transforms how organizations adopt and deploy decentralized technology.\\n\\nCerulea allows users to build, configure, deploy, and manage blockchain-backed applications and private networks through a unified, no-code platform. Users can define application logic, manage data structures, set access controls, and execute deployment settings without writing a single line of code.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/cerulea/ceruleanobg.png\",\"niche_kws\":[\"Blockchain\",\"Web3\",\"Blockchain Platform\",\"Blockchain Infrastructure\",\"Saas\",\"Paas\",\"Dapps\"],\"icp_kws\":[],\"market\":\"no-code\",\"product_type\":\"Dapp/Web3 Product\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-30T09:11:09.803568+00:00\",\"id\":16555,\"codename\":\"Coursebox AI\",\"slug\":\"courseboxai\",\"problem_label\":\"AI Course Creator \u0026 LMS\",\"solution_label\":\"The world's easiest way to create and deliver engaging online training courses.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/courseboxai/white-logomark-coursebox-gradient-background-1-.png\",\"niche_kws\":[\"AI\",\"courses\",\"education\",\"productivity\",\"SaaS\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-30T20:49:46.248483+00:00\",\"id\":16565,\"codename\":\"IMQRSCAN\",\"slug\":\"imqrscan\",\"problem_label\":\"Affordable branded QR codes with tracking\",\"solution_label\":\"IMQRScan is an affordable QR code generator for creating branded, editable, and trackable QR codes. Businesses can generate QR codes for URLs, menus, Google reviews, WiFi, vCards, business pages, social media links, WhatsApp, files, landing pages, and lead generation. Add your logo, customize colors, download in multiple formats, and track scan performance. Plans start from only $3/month.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/imqrscan/imqrscan-qr-code-generator-1-.png\",\"niche_kws\":[\"QR Code Generator\",\"Dynamic QR Codes\",\"Custom QR Codes\",\"Marketing Tool\",\"Lead Generation\",\"Google Reviews\",\"Restaurant Menu\",\"Business Page\",\"vCard QR Code\",\"Social Media Links\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-30T22:31:17.071179+00:00\",\"id\":16567,\"codename\":\"Improve My Page\",\"slug\":\"improvemypage\",\"problem_label\":\"Find what blocks your landing page from converting.\",\"solution_label\":\"Improve My Page turns any SaaS landing-page URL into a prioritized audit report. It checks conversion structure, copy, pricing clarity, SEO, speed, accessibility, security, trust signals, links, and images, then shows what to fix first. Founders, marketers, creators, and agencies can start with a free limited audit, unlock one full report, or use a monthly plan for repeated page reviews.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/improvemypage/improve-my-page-logo-128.png\",\"niche_kws\":[\"landing page audit\",\"CRO\",\"conversion optimization\",\"SEO audit\",\"website audit\",\"SaaS\",\"indie hackers\",\"growth marketing\",\"copywriting\",\"pricing\",\"accessibility\",\"startup tools\",\"marketing tools\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-31T04:37:52.841313+00:00\",\"id\":16571,\"codename\":\"ThetaRank\",\"slug\":\"thetarank\",\"problem_label\":\"Compare stock option outcomes before you place the trad\",\"solution_label\":\"Instantly see returns, assignment scenarios, premium collected, annualized yield, and S\u0026P outperformance for every call, put, and roll opportunity.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/thetarank/thetarank-logo-512.png\",\"niche_kws\":[\"Options\",\"Wheel\",\"Stocks\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-31T20:32:00.024972+00:00\",\"id\":16580,\"codename\":\"tiun\",\"slug\":\"tiun-66bd87\",\"problem_label\":\"Stripe for indie hackers: auth, payments, DB in 4 lines\",\"solution_label\":\"tiun lets indie hackers launch digital products with authentication, payments, and a database in one system from day one. We built Stripe for Indie Hackers, so instead of stitching together separate tools and maintaining fragile webhook logic, you can integrate with a single command and let the AI Agent do the work for you. tiun keeps billing, access, and customer data in sync automatically, helping developers ship faster and spend less time on setting up their backend. We’re currently accepting only 100 early-adopter developers to use tiun for free. Sign up for access.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tiun-66bd87/tiun0773b495-af19-4f36-a047-665ec262bf2b-1-.png\",\"niche_kws\":[\"SaaS Backend\",\"Authentication\",\"Payments\",\"Billing\",\"Subscriptions\",\"Customer Management\",\"Entitlements\",\"Checkout\",\"Merchant of Record\",\"Developer Tools\",\"SaaS Infrastructure\",\"Digital Products\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-05-31T22:14:51.991168+00:00\",\"id\":16581,\"codename\":\"tradingjournal\",\"slug\":\"tradingjournal\",\"problem_label\":\"AI coaching for MT4/MT5 traders.\",\"solution_label\":\"TradingJournal helps MT4/MT5 traders import or sync trades, track performance, and improve discipline with structured journaling and AI coaching. Traders can review setups, rules, checklists, daily journals, performance analytics, and the trades that deserve a second look. The free plan includes a complete journal, analytics, Review Queue, What-If preview, and weekly performance emails. Pro adds broker sync, weekly AI reviews, daily recaps, Deep Analysis, and focused What-If reports.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tradingjournal/TJ-logo.avif\",\"niche_kws\":[\"trading\",\"trading-journal\",\"forex\",\"mt4\",\"mt5\",\"ai\",\"analytics\",\"fintech\",\"saas\",\"performance-tracking\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T06:46:18.613838+00:00\",\"id\":16584,\"codename\":\"CrawlRaven\",\"slug\":\"crawlraven\",\"problem_label\":\"Crawl deep. Fix what matters. Rank higher.\",\"solution_label\":\"CrawlRaven is a professional SEO audit platform: crawl deep, fix what matters, rank higher. We crawl up to 50,000 pages and run 200+ checks across technical SEO, Core Web Vitals, structured data, links, and security — then rank every issue by ranking impact, so you know what to fix first. Agencies get white-label reports, scheduled audits, and team collaboration built in. And our MCP server plugs CrawlRaven into Claude: audit, pull the prioritized fixes, fix them with AI, and re-audit — in one loop.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/crawlraven/crawlraven-favicon-transparent-bg-.png\",\"niche_kws\":[\"SEO\",\"SEO Audit\",\"Technical SEO\",\"Marketing\",\"AI\",\"Developer Tools\",\"SaaS\",\"Web Performance\",\"MCP\",\"Agency Tools\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T08:49:59.231745+00:00\",\"id\":16590,\"codename\":\"CreatOK\",\"slug\":\"creatok\",\"problem_label\":\"Turn one winning video into hundreds\",\"solution_label\":\"CreatOK is an AI TikTok e-commerce video generator based on Soar, Wan, Seedance, VEO, Nano Banana Pro, Kling and so on. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/creatok/20260304-150210Tu-Biao-logo.jpeg\",\"niche_kws\":[\"E-commerce\",\"AI Video Generation\",\"TikTok\",\"Viral Content\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T09:10:08.6082+00:00\",\"id\":16592,\"codename\":\"EchoTik\",\"slug\":\"echotik\",\"problem_label\":\"YourData-DrivenTikTok E-Commerce Expert\",\"solution_label\":\"$38\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/echotik/Tu-Xiang-2026-5-14-18.35.jpeg\",\"niche_kws\":[\"TikTok analytics\",\"Infulencer\",\"Seller\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T09:23:51.760359+00:00\",\"id\":16594,\"codename\":\"Keyapi\",\"slug\":\"keyapi\",\"problem_label\":\"One API Key. Unlimited Social Intelligence.\",\"solution_label\":\"Keyapi.ai: The Ultimate \\\"Moat\\\" Against AI Homogenization\\nThe biggest risk in 2026 is that your AI-generated content looks exactly like your competitor's AI-generated content. Standard TikTok data analytics tools scrape the same public data. The only way to win is by injecting Private Data into your models. This is where Keyapi.ai becomes your secret weapon.\\nHow it builds your competitive advantage:\\n1. Omnichannel Aggregation: Keyapi seamlessly pulls your proprietary data from TikTok, Amazon, Instagram, YouTube, and Shopify via a single, unified API.\\n2. Direct-to-AI Integration (MCP Protocol): It is designed to feed your specific brand context, customer CRM data, and past campaign performance directly into your AI generators.\\n3. The Anti-Commodity Engine: By grounding platforms like CreatOK in your private data, the content generated is 100% unique. It speaks directly to your audience’s distinct aesthetic preferences and buying habits, making it impossible for lazy competitors to clone.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/keyapi/Tu-Xiang-2026-6-1-16.17.jpeg\",\"niche_kws\":[\"AI Agent\",\"next-generation automation\",\"LLM pipelines\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T10:14:16.356016+00:00\",\"id\":16595,\"codename\":\"QRLagoon\",\"slug\":\"qrlagoon\",\"problem_label\":\"Editable QR codes for trackable offline marketing.\",\"solution_label\":\"QRLagoon helps restaurants, small businesses, marketers, creators, and agencies create dynamic QR codes for menus, flyers, posters, business cards, packaging, events, and campaigns. Unlike static QR codes, they can be edited after printing, so you can update destination links without replacing materials. The platform also provides privacy-friendly scan analytics by city and device type, helping you understand performance and turn QR codes into reusable marketing assets across offline channels.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/qrlagoon/qrlagoon_logo.png\",\"niche_kws\":[\"dynamic qr codes\",\"qr code generator\",\"editable qr codes\",\"scan analytics\",\"offline marketing\",\"no-code\",\"small business\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T20:10:33.817949+00:00\",\"id\":16601,\"codename\":\"Evalyze\",\"slug\":\"evalyze\",\"problem_label\":\"AI fundraising platform for founders\",\"solution_label\":\"Most founders raise blind. You send your deck out, hear nothing, and never find out what went wrong. Evalyze gives you the investor's view before you hit send. Upload your deck, get a VC-grade score in about a minute, and see the exact gaps a real investor would flag. Then match with the right people from 10,000+ verified investors. Built by an ex-VC, trained on 8,000+ funded raises.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/evalyze/128logo-color.png\",\"niche_kws\":[\"AI\",\"Fundraising\",\"Startups\",\"Pitch Deck\",\"Investors\",\"Venture Capital\",\"Founders\",\"SaaS\",\"Productivity\",\"Angel Investors\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-01T21:53:51.867987+00:00\",\"id\":16602,\"codename\":\"Voxel Studio \",\"slug\":\"voxelstudiollc\",\"problem_label\":\"Every AI creator tool, one subscription, one login\",\"solution_label\":\"Voxel Studio is the all-in-one AI platform for indie game developers, streamers, and content creators. Image generation across 14+ models, image-to-3D meshes for Unity/Unreal/Godot, image-to-video, voice cloning, music + SFX, custom LoRA training, sprite sheet packing, and a full paint editor — under one subscription instead of stacking five. Outputs are commercially yours on every plan. 200 free credits at signup, no card required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/voxelstudiollc/voxel-icon-static.png\",\"niche_kws\":[\"AI image generator\",\"AI 3D model generator\",\"AI video generator\",\"Voice cloning\",\"AI tools for game developers\",\"Content creator tools\",\"Sprite sheet generator\",\"LoRA training\",\"All-in-one AI platform\",\"Subscription SaaS\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-02T15:44:26.84566+00:00\",\"id\":16612,\"codename\":\"dEssence\",\"slug\":\"dessence\",\"problem_label\":\"Save it once. Just ask later.\",\"solution_label\":\"dEssence is an AI memory for everything you save. Save links, articles, and videos from the web, Telegram, or the Chrome extension, and it all lands in one library. Later you just ask in your own words, like \\\"that sleep article I saved\\\" or \\\"what can I cook tonight from my recipes.\\\" dEssence answers from your own saved material and shows the original sources behind every answer. Group saves into boards. Free during beta.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/dessence/IMG_0442.png\",\"niche_kws\":[\"ai\",\"bookmarks\",\"knowledge management\",\"second brain\",\"save links\",\"research\",\"notes\",\"productivity\",\"chrome extension\",\"memory\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-03T00:47:38.386289+00:00\",\"id\":16621,\"codename\":\"FireLaunch\",\"slug\":\"firelaunch\",\"problem_label\":\"The indie market place for more than just launch day. \",\"solution_label\":\"Launch board for indie makers. Free tier gets a real dedicated page with dofollow backlinks. Earn Spark from votes, clicks, dwell time. Hit 250 in week one and your listing stays in The Forge forever. One-time pricing, 50% lifetime affiliate commission.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/firelaunch/icon-512.png\",\"niche_kws\":[\"launch-platform\",\"product-launch\",\"indie-hackers\",\"saas\",\"directory\",\"seo\",\"backlinks\",\"marketing\",\"affiliate-program\",\"maker-tools\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-03T08:11:55.523348+00:00\",\"id\":16627,\"codename\":\"Microinfluencer\",\"slug\":\"microinfluencer-eb59e7\",\"problem_label\":\"Discover and Analyse human UGC Creators in Minutes using AI\",\"solution_label\":\"MicroInfluencer is built for brands and agencies who need vetted TikTok and Instagram niche creators, fast. Describe your campaign in plain English, get matching creators with deep analytics.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/microinfluencer-eb59e7/newlogo.png\",\"niche_kws\":[\"ugc\",\"influencers\",\"creators\",\"data\",\"socialmedia\",\"microinfluencers\",\"influencermarketing\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-03T20:25:32.469187+00:00\",\"id\":16636,\"codename\":\"Aurum\",\"slug\":\"aurum-06abe5\",\"problem_label\":\"Privacy-first personal finance tracking. No bank login needed.\",\"solution_label\":\"Aurum is a privacy-first personal finance app that lets you track income, expenses, and net worth without ever connecting a bank account. You stay in control, manually log transactions, set budgets, and see your full financial picture in one clean dashboard. No data sold, no third-party access, no subscriptions to your banking credentials. Built for people who want financial clarity without sacrificing privacy. Free to start. Aurum Pro at $9/month.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aurum-06abe5/Aurum_logo_128x128.png\",\"niche_kws\":[\"personal finance\",\"privacy\",\"budgeting\",\"net worth\",\"expense tracking\",\"no bank login\",\"SaaS\",\"financial wellness\",\"solo founder\",\"indie maker\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-04T10:01:58.423343+00:00\",\"id\":16657,\"codename\":\"CinLink\",\"slug\":\"cinlink\",\"problem_label\":\"Your Media Shaped by What You Say\",\"solution_label\":\"Create, edit, translate, dub, and repurpose media through natural language. CinLink turns your words into images, videos, subtitles, clips, and complete media workflows across desktop, mobile, CLI, and AI agents.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cinlink/logo-dark-128.png\",\"niche_kws\":[\"ai\",\"video\",\"agent\",\"translate\",\"dub\",\"subtitle\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-04T19:00:56.688353+00:00\",\"id\":16660,\"codename\":\"Makko AI\",\"slug\":\"makkoai\",\"problem_label\":\"Make 2D Games with AI\",\"solution_label\":\"Make 2D games with AI. Start with concept art, then create characters, backgrounds, objects, and animations - all in one consistent style.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/makkoai/android-chrome-512x512.png\",\"niche_kws\":[\"AI game maker\",\"make a 2d game with ai\",\"ai 2d game maker\",\"make a game with no coding\",\"ai art generator\",\"ai game art generator\",\"ai character generator\",\"ai game development studio\"],\"icp_kws\":[],\"market\":\"no-code\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-04T19:25:49.621349+00:00\",\"id\":16661,\"codename\":\"Bidcraftr\",\"slug\":\"bidcraftr\",\"problem_label\":\"Send proposals, get them signed, collect payment, one link.\",\"solution_label\":\"Bidcraftr is the proposal to payment platform for freelancers, consultants, and agencies. Create branded proposals in minutes, add your scope, deliverables, timeline, and pricing. Bidcraftr formats everything into a professional document with e signatures, real time client tracking, and Stripe payment collection. Know when clients open your proposal. Get follow up reminders. Collect payment the moment they sign. Built in CRM and analytics. Starting at $19/month.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/bidcraftr/D111B9A8-DEB9-4339-AB18-7777E38072A9.jpeg\",\"niche_kws\":[\"Proposal software\",\"freelancer tools\",\"e-signatures\",\"CRM\",\"payment collection\",\"invoicing\",\"client management\",\"proposal tracking\",\"proposal template\",\"business\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-05T04:14:24.669413+00:00\",\"id\":16667,\"codename\":\"Relysta\",\"slug\":\"relysta\",\"problem_label\":\"One calm workspace for client-facing work.\",\"solution_label\":\"Relysta helps studios, startups, agencies, and teams manage client-facing work in one polished workspace instead of scattered tools.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/relysta/logo-transparent.png\",\"niche_kws\":[\"client workspace\",\"project workspace\",\"team collaboration\",\"client portal\",\"project management\",\"file sharing\",\"client communication\",\"workspace\",\"booking\",\"documents\",\"AI knowledge base\",\"startup tools\",\"agency software\",\"team workspace\"],\"icp_kws\":[],\"market\":\"freelancer-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-06T13:44:13.041169+00:00\",\"id\":16688,\"codename\":\"hostdroplet-tools\",\"slug\":\"hostdroplettools\",\"problem_label\":\"Free tools for DNS, SSL, SEO, and website checks\",\"solution_label\":\"HostDroplet Tools is a free collection of website diagnostic tools for checking DNS records, SSL certificates, HTTP headers, redirects, SEO basics, email authentication, sitemap issues, robots.txt files, performance signals, and common hosting problems. It is built for website owners, developers, bloggers, agencies, and small businesses that need quick technical checks without using multiple slow or cluttered tools.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hostdroplettools/hostdroplet_droplet_icon_1200_transparent.png\",\"niche_kws\":[\"DNS\",\"SSL\",\"SEO\",\"Email\",\"Website Monitoring\",\"Developer Tools\",\"Web Hosting\",\"Security\",\"Performance\",\"Sitemap\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-06T15:14:58.371755+00:00\",\"id\":16690,\"codename\":\"The Film Room NFL Trivia\",\"slug\":\"thefilmroomnfltrivia\",\"problem_label\":\"The world's first football intelligence game. Free.\",\"solution_label\":\"The Film Room is the world's first football intelligence game — a new category beyond simulation, fantasy, and betting. Eight game modes, including Survival, Higher Lower, Stat Pad, Career Path, and Connections. AI-powered Film Notes after every answer give you a coach-level breakdown of why it matters. Built by a solo founder with real NFL industry credentials. Free on iOS and Android. 4x nominated at the Mobile Games Awards 2026.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/thefilmroomnfltrivia/DarkReel_Logo_128x128_official.png\",\"niche_kws\":[\"sports\",\"football\",\"trivia\",\"sports trivia\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Mobile App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-06T16:28:24.708133+00:00\",\"id\":16692,\"codename\":\"Lumipage\",\"slug\":\"lumipage\",\"problem_label\":\"Create and launch a beautiful website in minutes\",\"solution_label\":\"Describe your idea. Lumipage builds the page.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lumipage/ChatGPT-Image-Feb-25-2026-at-10_49_40-AM-1-.png\",\"niche_kws\":[\"AI Builder\",\"Landing Pages\",\"No Code\",\"Website AI\",\"Page Builder\",\"Fast Launch\",\"Web Design\",\"Instant Sites\"],\"icp_kws\":[],\"market\":\"mvp-builders\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-08T13:48:13.261182+00:00\",\"id\":16717,\"codename\":\"IntentHunter\",\"slug\":\"intenthunter\",\"problem_label\":\"Social Listening and Brand Monitoring for High-Intent Leads\",\"solution_label\":\"People are asking for products and services like yours. IntentHunter finds those conversations, scores the intent, and sends you the threads worth replying.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/intenthunter/logo_icon_512.png\",\"niche_kws\":[\"social listening\",\"brand monitoring\",\"lead gen\",\"lead finder\",\"lead marketing\",\"content marketing\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-08T17:19:00.974476+00:00\",\"id\":16719,\"codename\":\"SkillHacker\",\"slug\":\"skillhacker\",\"problem_label\":\"Hack your coding skills. See where you actually stand.\",\"solution_label\":\"SkillHacker helps developers objectively measure their programming skills through testing. Two modes: Practice for learning, Testing for interview-like conditions. Right now it's a clean question bank with 4-option MCQs. The key feature? You don't just check yourself — you compare your results against average scores from other developers. Finally know if you're solid Junior or early Middle, and which topics you're falling behind on.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/skillhacker/icon-192.png\",\"niche_kws\":[\"developer-tools\",\"education\",\"productivity\",\"career\",\"learning\",\"quiz\",\"testing\",\"programming\",\"benchmarking\",\"interview-prep\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-08T19:49:51.228546+00:00\",\"id\":16721,\"codename\":\"WallMockup\",\"slug\":\"wallmockup\",\"problem_label\":\"Realistic wall art mockups — true scale, in minutes\",\"solution_label\":\"Place your artwork into real room scenes with accurate sizing, custom frames, and HD exports.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wallmockup/wallMockupLogo2.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-09T08:37:58.617865+00:00\",\"id\":16730,\"codename\":\"seedance 2.1\",\"slug\":\"seedance21\",\"problem_label\":\"Seedance 2.1 Video Generator | Cinematic AI Video Online\",\"solution_label\":\"Use the Seedance 2.1 video generator to plan cinematic clips, test Seedance prompts, compare runtime modes, and preview credits before creating AI video online.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedance21/logo-3-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-10T02:44:03.618027+00:00\",\"id\":16740,\"codename\":\"Floor Plan Maker\",\"slug\":\"floorplanmaker\",\"problem_label\":\"Floor Plan Maker - Create 2D \u0026 3D Layouts Online for Free\",\"solution_label\":\"Floor Plan Maker is an AI-powered platform for creating and visualizing floor plans online. Users can generate layouts, explore room arrangements, preview space ideas, and turn concepts into clear visual plans quickly and easily. Designed for homeowners, interior enthusiasts, renters, and designers, it helps simplify space planning with fast, accessible tools.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/floorplanmaker/Floor-Plan-Maker-144-.jpg\",\"niche_kws\":[\"Floor Plan Maker\",\"AI Interior Design\",\"Floor Plan Rendering\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-10T11:23:03.904323+00:00\",\"id\":16749,\"codename\":\"Typing Platform\",\"slug\":\"typingplatform\",\"problem_label\":\"Master touch typing through structured lessons\",\"solution_label\":\"TypingPlatform.com helps students, professionals, and schools improve typing speed and accuracy through structured lessons, guided practice, typing tests, and detailed progress tracking. Built on over 8 years of development and more than 1 million completed typing sessions.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/typingplatform/logo_rect.png\",\"niche_kws\":[\"touch typing\",\"typing tutor\",\"typing test\",\"keyboard skills\",\"education\",\"online learning\",\"productivity\",\"student tools\",\"teacher tools\",\"digital literacy\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-10T12:00:45.431988+00:00\",\"id\":16750,\"codename\":\"Blur It\",\"slug\":\"blurit-41c1b3\",\"problem_label\":\"Blur API keys and client data before you hit record.\",\"solution_label\":\"Recording demos shouldn't mean spending hours in the editing room. If you are a DevRel recording a tutorial or an agency owner sending a client report, you know the panic of accidentally showing a production API key or a client's ad spend on screen.\\n\\nBlur It is a Chrome extension that lets you click and blur any sensitive data on a live web page before you hit record.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/blurit-41c1b3/icon-128.png\",\"niche_kws\":[\"Screen Recording\",\"Video Editing\",\"Build In Public\",\"Privacy\",\"Security\",\"Data Protection\",\"Chrome Extension\",\"Browser Extension\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Lifetime deal\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-10T18:25:58.173731+00:00\",\"id\":16753,\"codename\":\"Sykr\",\"slug\":\"sykr\",\"problem_label\":\"Continuous AI-powered discovery of high-potential business opportunities\",\"solution_label\":\"Sykr is an AI-powered opportunity discovery platform that continuously scans live internet signals across Reddit, Hacker News, Product Hunt, Google Trends, and niche communities. It identifies emerging business opportunities, scores them based on market potential and timing, and provides actionable execution plans. Instead of spending hours researching ideas manually, founders, creators, and agencies receive a daily stream of validated opportunities, competitor insights, and market intelligence ready for execution.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sykr/1000018300.jpg\",\"niche_kws\":[\"Startup Ideas\",\"Market Research\",\"Competitive Intelligence\",\"Business Intelligence\",\"Trend Analysis\",\"Opportunity Discovery\",\"AI Agents\",\"Lead Generation\",\"Entrepreneurship\",\"SaaS\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-11T12:49:48.923776+00:00\",\"id\":16763,\"codename\":\"MapScout\",\"slug\":\"mapscout\",\"problem_label\":\"Extract Google Maps business listings into clean spreadsheets — the fastest way to build a lead list.\",\"solution_label\":\"With MapScout you get data and leads from Google Maps in one click.\\nFilter all businesses on Google Maps by keyword and extract results into easily usable spreadsheets.\\nZero time waste, zero unreliable results.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/mapscout/lowo-mapscout-big.png\",\"niche_kws\":[\"lead-extractor\",\"google-maps\",\"google-maps-scraper\",\"lead-scraper\",\"b2b\",\"crm\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-11T17:04:38.951207+00:00\",\"id\":16766,\"codename\":\"SecurePutCalls\",\"slug\":\"spc\",\"problem_label\":\"Find Your Best Wheel Trade in 60 Seconds — Free to Start.\",\"solution_label\":\"Scan 500+ stocks for the highest-ROI cash-secured puts and covered calls. Real-time Greeks, AI recommendations, and broker sync — purpose-built for income traders.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/spc/logotransparent.jpg\",\"niche_kws\":[\"Connect Your Broker Securely\",\"Link Fidelity\",\"Schwab\",\"Robinhood\",\"TD Ameritrade\",\"or Interactive Brokers with read-only access. Your credentials are never stored.\",\"SecurePutCalls pulls your open positions\",\"option chains\",\"and cost basis. Everything updates in real time.\",\"One dashboard. All brokers. Portfolio delta\",\"P\u0026L by symbol\",\"roll alerts\",\"and risk analytics — live.\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-11T22:32:43.805541+00:00\",\"id\":16773,\"codename\":\"Ldplayers\",\"slug\":\"ldplayers\",\"problem_label\":\"Turning a computer into a mobile phone\",\"solution_label\":\"LDPlayer is a free Android emulator for Windows that instantly transforms your PC into an Android gaming powerhouse. Play popular mobile games with enhanced graphics, stable FPS, customizable keyboard mapping, multi-instance support, and seamless app compatibility. Whether you want to run Android apps, enjoy mobile games on a larger screen, or boost your gaming performance, LDPlayer offers a fast, secure, and user-friendly solution for Windows users.https://ldplayers.com/\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/ldplayers/logo.webp\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-11T22:34:13.657727+00:00\",\"id\":16774,\"codename\":\"Phinite AI\",\"slug\":\"phiniteai\",\"problem_label\":\"Operating System For Multi Agentic Intelligence\",\"solution_label\":\"Most AI agents are one-off scripts. No identity. No version history. No governance. They work in a demo, then break in production. Every team rebuilds the same plumbing from scratch. Nothing reusable. Nothing composable.\\n\\nPhinite fixes this. One platform to design agents, evaluate behavior, deploy anywhere, observe every run, and govern every action. Agents as durable, reusable units of intelligence. Not disposable code.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/phiniteai/Full-logo.png\",\"niche_kws\":[\"THE AGENT LIFECYCLE\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-12T17:02:36.681317+00:00\",\"id\":16789,\"codename\":\"DigiStorms\",\"slug\":\"digistorms\",\"problem_label\":\"Turn free users into paying customers, on autopilot.\",\"solution_label\":\"DigiStorms is an AI onboarding agent that turns SaaS signups into paying customers — automatically. It watches how users behave in your product and sends the right email at the right moment, instead of blasting time-based sequences.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/digistorms/Stormi.png\",\"niche_kws\":[\"Email\",\"Onboarding\",\"Retention\"],\"icp_kws\":[],\"market\":\"crm\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-12T17:21:33.428496+00:00\",\"id\":16790,\"codename\":\"RenderLog\",\"slug\":\"renderlog\",\"problem_label\":\"Capture, test and export web pages\",\"solution_label\":\"RenderLog helps teams run browser jobs without maintaining Playwright infrastructure. Capture screenshots, export pages to PDF, Markdown or HTML, run no-code checks for pricing, signup, docs and UI flows and keep outputs, assertions, baselines, history and alerts in one workspace.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/renderlog/web-app-manifest-192x192.png\",\"niche_kws\":[\"screenshots\",\"visual testing\",\"website monitoring\",\"PDF export\",\"Markdown export\",\"Playwright\",\"no-code testing\",\"browser automation\",\"SaaS\",\"developer tools\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-12T17:34:45.338897+00:00\",\"id\":16791,\"codename\":\"Agentsmd.me\",\"slug\":\"agentsmdme\",\"problem_label\":\"Stop re-explaining yourself to AI\",\"solution_label\":\"Generate a private AGENTS.md file that captures your preferences, taste, habits, and working style, so AI tools give you better recommendations and more consistent answers without re-explaining yourself every time\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/agentsmdme/download.png\",\"niche_kws\":[\"Agents\",\"Agents.md\",\"Preferences\",\"Markdown\",\"md\",\"Free\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-13T07:53:40.227377+00:00\",\"id\":16802,\"codename\":\"GoogleReviewBoost\",\"slug\":\"googlereviewboost\",\"problem_label\":\"Free Google review link generator for local businesses\",\"solution_label\":\"GoogleReviewBoost lets local businesses generate a direct Google review link in seconds — no signup or account needed. Share the link via email, SMS, or print it as a QR code to make it easy for customers to leave a review. The tool also offers premium review packages for businesses looking to grow their Google rating faster. Built for small business owners who want more Google reviews without complex software.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/googlereviewboost/ReviewBoost-logo-no-bg-1500-x-1500-px-.png\",\"niche_kws\":[\"google reviews\",\"local seo\",\"review management\",\"small business\",\"free tool\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-13T08:24:08.793257+00:00\",\"id\":16805,\"codename\":\"MyRaxAi\",\"slug\":\"myraxai\",\"problem_label\":\"Professional AI images in seconds\",\"solution_label\":\"MyraxAI empowers creators and businesses to generate stunning AI-powered images from simple text descriptions. Produce custom visuals, creative artwork, branding materials, and digital content quickly and efficiently without requiring graphic design expertise.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/myraxai/Screenshot-2026-06-13-at-10.52.35.png\",\"niche_kws\":[\"ai image generation\",\"ai images\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-14T01:00:26.335266+00:00\",\"id\":16816,\"codename\":\"Cafe Cartographer\",\"slug\":\"cafecartographer\",\"problem_label\":\"Find the indie café that matches your vibe\",\"solution_label\":\"Maps gives you the popular café. Not the right one.\\nCafé Cartographer finds the independent spot that fits how you want to work or hang that day — quiet with outlets, or loud and social — and shows you the details before you walk in. Even the places other apps miss.\\nTwenty seconds instead of twenty minutes. I built it for my own travel; now I open it every morning. iOS with Web coming soon.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cafecartographer/EB_wave.png\",\"niche_kws\":[\"coffee · cafe discovery · independent coffee · travel · coffee shops · remote work · digital nomad · city guide · specialty coffee · work-friendly cafes\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-15T13:18:51.700919+00:00\",\"id\":16849,\"codename\":\"Modelfy 3D\",\"slug\":\"modelfy3d\",\"problem_label\":\"Turn images into 3D models instantly\",\"solution_label\":\"Modelfy 3D (https://modelfy.art/) is an AI-powered image-to-3D generator that converts 2D images into textured 3D models in seconds. Creators, game developers, designers, ecommerce teams, and 3D printing users can upload an image, preview the result in the browser, and download production-ready assets in formats like GLB, OBJ, USDZ, and STL.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/modelfy3d/modelfy-3d-logo-128.png\",\"niche_kws\":[\"AI 3D Generator\",\"Image to 3D\",\"3D Model Generator\",\"3D Printing\",\"Game Assets\",\"AR\",\"Blender\",\"Unity\",\"Product Visualization\",\"No-code 3D\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-15T13:58:32.976198+00:00\",\"id\":16852,\"codename\":\"Submitator\",\"slug\":\"submitator\",\"problem_label\":\"100+ directories, you pick which. Cheap, fast \u0026 good. From $29. \",\"solution_label\":\"Submit your startup to 100+ directories. Cheap, fast, and good.\\n\\nNot your regular \\\"we'll manually submit your startup\\\". We built real automation like back in the pre-AI era. Not \\\"AI assistants\\\". Not overseas teams clicking buttons. Just custom browser automation that actually works.\\n\\nOther services charge $200-500 because they pay humans and AI to do the work. We charge $29-79 because our robots do it better, faster, and 24/7. Simple as that.\\n\\nAnd you stay in control. You pick your directories after you pay. They're all hand-picked, with real traffic and domain authority. No spam sites. No dead links. You watch every submission in a real-time dashboard and get a full report with all your links.\\n\\nQuality backlinks. Better SEO and DR. Done in 24-48 hours. One-time payment, no subscriptions, 30-day refund.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/submitator/logo.png\",\"niche_kws\":[\"seo\",\"backlinks\",\"directory submission\",\"dofollow backlinks\",\"domain rating\",\"link building\",\"startup launch\",\"indie hackers\",\"saas marketing\",\"backlink automation\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-15T23:05:38.683356+00:00\",\"id\":16856,\"codename\":\"Highpay Ads\",\"slug\":\"highpayads\",\"problem_label\":\"IDE Ads\",\"solution_label\":\"Developers spend hours every day inside VS Code, Cursor and Windsurf, and the Explorer sidebar is almost always visible.\\n\\nHighpay Ads lets developers earn from small sponsored text cards displayed in their IDE sidebar. No banners, no popups, just simple text ads that match the editor.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/highpayads/apple-touch-icon.png\",\"niche_kws\":[\"Earn money inside your IDE\"],\"icp_kws\":[],\"market\":\"ads\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-16T18:31:23.922756+00:00\",\"id\":16870,\"codename\":\"conversion.business\",\"slug\":\"conversionbusiness\",\"problem_label\":\"Open-source gamified starter templates for React, Vue, Svelte.\",\"solution_label\":\"conversion.business provides free, open-source starter templates for React, Svelte, and Vue that replace boring CAPTCHAs with interactive, zero-telemetry mini-games. Built for developers who want to stop bots without ruining their user experience, these templates are ready to drop into your next web project. The code is completely free to clone and use, with pre-configured components and fully localized documentation to help you build faster.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/conversionbusiness/oops_games_logo_minimal.png\",\"niche_kws\":[\"React\",\"Svelte\",\"Vue\",\"Gamification\",\"Open Source\",\"Security\",\"Developer Tools\",\"Bot Protection\",\"Templates\",\"Zero Telemetry\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-17T01:22:51.478154+00:00\",\"id\":16875,\"codename\":\"Favors.dev\",\"slug\":\"favorsdev\",\"problem_label\":\"A marketing hub where founders trade verified growth actions\",\"solution_label\":\"Favors.dev is a community-driven marketing platform designed for founders to trade verified growth actions. Instead of relying on traditional ads or content grinds, founders use a point-based system to request and perform tasks like launch-day shares, product feedback, directory listings, and newsletter mentions. The platform ensures quality through a verification system where every action is checked before points are released, preventing freeloading and ensuring that marketing efforts compound over time.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/favorsdev/favors-dev-500.jpg\",\"niche_kws\":[\"GTM\",\"Marketing\",\"SaaS\",\"Founders\",\"Directories\",\"AI\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-17T10:31:38.349762+00:00\",\"id\":16885,\"codename\":\"MachinesFluent\",\"slug\":\"machinesfluent\",\"problem_label\":\"The best AI powered Dictation Tool\",\"solution_label\":\"MachinesFluent lets you write anywhere by speaking instead of typing. It works anywhere the keyboard does. \\n\\nRewrite, summarize, translate, or perform web searches, by simply using your voice. It uses AI models to transcribe and polish your speech, while you control the output style using custom prompts.\\n\\nIt also adapts the writing style to the app you're using, and supports adding your own dictionaries for tough words. \\n\\nThat is the core of it.\\n\\n\\n\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/machinesfluent/FasterOperations-Wallpaper-Copy.png\",\"niche_kws\":[\"dictation\",\"voice typing\",\"speech to text\",\"AI writing\",\"Windows productivity\",\"voice input\",\"web search\",\"email writing\",\"note taking\",\"accessibility\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-17T17:17:08.649734+00:00\",\"id\":16890,\"codename\":\"Cleanbox\",\"slug\":\"cleanbox\",\"problem_label\":\"Email aliases, AI spam filtering, and a full SMTP relay\",\"solution_label\":\"Cleanbox sits between the internet and your inbox. Every incoming email goes through spam scoring, virus scanning, AI classification, and your own rules before delivery. Create unlimited aliases that forward to your real inbox, build custom filters, and use Cleanbox as a complete SMTP relay. Works with Gmail, Outlook, iCloud, Yahoo, or any IMAP provider, no migration needed. Privacy-first: no advertising, no data selling, no user profiling.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cleanbox/app.png\",\"niche_kws\":[\"email\",\"email aliases\",\"spam filter\",\"privacy\",\"email forwarding\",\"inbox management\",\"anti-spam\",\"SMTP relay\",\"email security\",\"disposable email\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-17T17:49:59.295555+00:00\",\"id\":16891,\"codename\":\"Secureintent\",\"slug\":\"secureintent\",\"problem_label\":\"SecureIntent prevents secrets from being pasted into LLMs by removing them locally before they leave the machine, then restoring them safely when needed.\",\"solution_label\":\"Secureintent.ai is a free chrome extension that protects vibe coders and developers from pasting sensitive tokens, keys and 16-digit credit card details by alerting the user when they paste. Our unique zero retention architecture means the data is never stored or logged and it only ever resides in the local RAM.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/secureintent/SecureIntent-Icon-1-.png\",\"niche_kws\":[\"DLP\",\"Cybersecurity\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Lifetime deal\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-17T23:35:30.923476+00:00\",\"id\":16902,\"codename\":\"Zapnote\",\"slug\":\"zapnote\",\"problem_label\":\"Cold emails get ignored. Personalized pages get opened.\",\"solution_label\":\"Zapnote turns a cold prospect's domain into a personalized, co-branded microsite in under a minute. Instead of reading a wall of cold email text, your prospect opens a page built about them. Paste a domain on the homepage, watch the page generate live, and drop the link into your outreach. Built for sales teams and founders who want replies, not unsubscribes. No signup needed to try it. Be notable.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/zapnote/Type-Logomark.png\",\"niche_kws\":[\"SALES\",\"MARKETING\",\"GROWTH\",\"DISTRIBUTION\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-18T07:26:39.555627+00:00\",\"id\":16940,\"codename\":\"AI Voice Enhancer Online\",\"slug\":\"aivoiceenhanceronline\",\"problem_label\":\"voice enhancer AI，voice enhancer online，audio enhancer，video voice enhancer online，enhance audio quality online，vocal enhancer，video voice enhancer online\",\"solution_label\":\"Free AI Voice Enhancer — Enhance Voice clarity \u0026 remove background noise online.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aivoiceenhanceronline/e74dd2e8-73a6-4ee5-bbcf-abbe79619dca.png\",\"niche_kws\":[\"voice enhancer AI，voice enhancer online，audio enhancer，video voice enhancer online，enhance audio quality online，vocal enhancer，video voice enhancer online\"],\"icp_kws\":[],\"market\":\"music\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-18T13:47:56.173172+00:00\",\"id\":16949,\"codename\":\"XRL\",\"slug\":\"xrl\",\"problem_label\":\"Learn what works on X. Then repeat it.\",\"solution_label\":\"X Reach Lab turns X into a repeatable growth workflow. Connect your account, see what posts and replies create profile interest and discovery, and learn what to repeat, adjust, pause, or test next - without generic analytics, growth-hacker tactics, or AI spam.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/xrl/04706048-DF01-4598-8BB1-8CB2DE644B6A.png\",\"niche_kws\":[\"x\",\"workflow\",\"signals\",\"growth\",\"distribution\",\"marketing\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-18T17:07:47.419544+00:00\",\"id\":16950,\"codename\":\"Vulny\",\"slug\":\"vulny\",\"problem_label\":\"One scan: website security, SEO and AI-search readiness\",\"solution_label\":\"Vulny is an all-in-one cloud website scanner. One scan finds security vulnerabilities (357,755+ tests), audits your SEO for Google ranking, and checks AI-search (GEO) readiness so AI assistants cite you. It detects backdoors, exposed files and weak SSL/TLS, and ships a built-in ISMS for ISO 27001. Free 14-day trial.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vulny/vulny-logo-white.png\",\"niche_kws\":[\"security\",\"vulnerability scanner\",\"web security\",\"SEO\",\"GEO\",\"AI search\",\"ISO 27001\",\"SSL/TLS\",\"API security\",\"ISMS\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-19T11:28:28.637031+00:00\",\"id\":16963,\"codename\":\"Sidekick Pro\",\"slug\":\"sidekickpro\",\"problem_label\":\"Executive assistant for $20/month\",\"solution_label\":\"AI executive assistant watches your email and calendar, answers phone calls, joins meetings and works for you 24/7.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/sidekickpro/icon-335.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-19T13:47:53.954244+00:00\",\"id\":16969,\"codename\":\"nlh.poker\",\"slug\":\"nlhpoker\",\"problem_label\":\"Free poker practice with FastFold, GTO verification, and advanced stats\",\"solution_label\":\"Free poker practice with FastFold, GTO verification, and advanced stats\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/nlhpoker/icon.png\",\"niche_kws\":[\"poker\",\"texas hold'em\",\"fastfold\",\"nlh\"],\"icp_kws\":[],\"market\":\"community\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-19T16:54:36.051617+00:00\",\"id\":16973,\"codename\":\"AlwaysUP\",\"slug\":\"alwaysup\",\"problem_label\":\"👋 Keep an eye on your website with real-time updates \u0026 status alerts!\",\"solution_label\":\"AlwaysUp.dev provides real-time website monitoring, SSL certificate verification, keyword presence checks, and ad delivery validation. Get down-to-the-minute alerts via Slack, Discord, and Telegram.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/alwaysup/favicon.png\",\"niche_kws\":[\"Uptime Monitoring\",\"Testing Q\u0026A\",\"B2B SaaS\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-19T22:29:52.671316+00:00\",\"id\":16976,\"codename\":\"ForthWrite\",\"slug\":\"forthwrite\",\"problem_label\":\"AI email writer that learns your voice\",\"solution_label\":\"ForthWrite is an AI email writing assistant for Gmail and Outlook that learns your writing style from your real sent mail. The more you use it, the more it sounds like you. \\n\\nGet smart drafts in seconds, auto-draft replies before you open your inbox, and maintain your personal voice at scale. \\n\\nFree to start, no credit card required. Works inside Gmail and Outlook on the web.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/forthwrite/ForthWrite-F-01.png\",\"niche_kws\":[\"AI\",\"Gmail\",\"Outlook\",\"productivity\",\"writing\",\"automation\",\"chrome extension\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-20T06:24:44.257446+00:00\",\"id\":16979,\"codename\":\"Natiad\",\"slug\":\"natiad\",\"problem_label\":\"Stop Doing SEO. Start Growing Traffic.\",\"solution_label\":\"Natiad revolutionizes how busy makers approach organic growth by offering the first truly autonomous SEO GEO Agent that handles everything automatically while you focus on building your product. This groundbreaking AI-powered platform leverages advanced GPT agents to function as your dedicated search marketing team—conducting comprehensive keyword research, creating high-quality optimized content, implementing technical SEO, and driving organic traffic without requiring your time or expertise. The system's intelligent keyword analysis identifies high-opportunity, relevant terms from Google's extensive database, ensuring that every content piece targets search opportunities with maximum ROI potential.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/natiad/favicon.png\",\"niche_kws\":[\"GEO\",\"SEO\",\"Free tools\",\"topical authority\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-22T17:41:47.689799+00:00\",\"id\":17025,\"codename\":\"Sakana AI\",\"slug\":\"sakana-ai\",\"problem_label\":\"Master every task with one powerful, versatile AI model.\",\"solution_label\":\"Sakana Fugu is a research-driven multi-agent LLM orchestration model delivered through one OpenAI-compatible API. It coordinates specialized agents for coding, reasoning, and complex workflows while letting teams control model choices for performance, privacy, and compliance.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sakana-ai/logo.png\",\"niche_kws\":[\"multi-agent-orchestrator\",\"llm-coordinator\",\"agentic-model\"],\"icp_kws\":[\"ai-orchestration\",\"developer-apis\",\"machine-intelligence\",\"llm-integration\",\"research-backed\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-22T18:26:34.295979+00:00\",\"id\":17026,\"codename\":\"Maximem Synap\",\"slug\":\"maximemsynap\",\"problem_label\":\"AI Memory \u0026 Context Management for agents \",\"solution_label\":\"Maximem Synap is an AI memory and context management solution designed for developers and teams building AI agents.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/maximemsynap/logo.png\",\"niche_kws\":[\"AI Memory\",\"Context Management\",\"AI Agents\",\"Developer Tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-22T21:02:13.957065+00:00\",\"id\":17029,\"codename\":\"business ideas db\",\"slug\":\"businessideasdb\",\"problem_label\":\"Validated business ideas from real Reddit pain points, scored by AI\",\"solution_label\":\"Business Ideas Database (BID) is a research tool for indie hackers and solo founders who want to build something people already want. Instead of AI generated listicles, every idea is sourced from real demand signals: Reddit threads where people describe problems they would pay to solve, and App Store reviews exposing gaps in existing apps. Each idea is scored across opportunity, problem severity, feasibility, and timing, then enriched with monthly keyword search volume and competitor mapping.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/businessideasdb/bigdarklogo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"starter-kits\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-22T22:37:50.594923+00:00\",\"id\":17030,\"codename\":\"HiBot\",\"slug\":\"hibot\",\"problem_label\":\"See how ChatGPT and AI describe your brand\",\"solution_label\":\"HiBot is a human-run AI visibility audit. A real specialist runs the questions your customers ask across ChatGPT, Perplexity, Google AI, Claude, and Grok, scores how your brand is described and recommended from 0 to 100 on the ANSWER methodology, and delivers a report plus a CSV of every response with a prioritized plan to fix the gaps.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hibot/logo-128.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-23T06:45:12.967488+00:00\",\"id\":17036,\"codename\":\"Digital Flower Bouquet\",\"slug\":\"digitalflowerbouquet\",\"problem_label\":\"Create and send digital flower bouquets online\",\"solution_label\":\"Digital Flower Bouquet lets users create and send beautiful virtual flower gifts online. Users can personalize bouquets, add heartfelt messages, and instantly share them as a link. It is perfect for birthdays, romantic messages, long-distance relationships, and thank-you gifts. No signup required, everything works instantly in the browser.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/digitalflowerbouquet/df-logo-128.png\",\"niche_kws\":[\"virtual gifts\",\"digital gifts\",\"birthday gift ideas\",\"send flowers online\",\"virtual flowers\",\"emotional gifts\",\"long distance gift\",\"digital bouquet\",\"gift generator\",\"social sharing tool\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-23T08:38:23.91844+00:00\",\"id\":17038,\"codename\":\"aistory-video\",\"slug\":\"aistoryvideo\",\"problem_label\":\"Generate captivating story videos\",\"solution_label\":\"Effortlessly generate captivating short story videos using the power of AI\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aistoryvideo/v2-2.png\",\"niche_kws\":[\"ai\",\"video\",\"story\",\"generator\",\"youtube\",\"tiktok\",\"social\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-23T11:13:37.080101+00:00\",\"id\":17039,\"codename\":\"ProfessionalHeadshot.io\",\"slug\":\"professionalheadshotio\",\"problem_label\":\"Studio-quality headshots from your own photos.\",\"solution_label\":\"ProfessionalHeadshot.io helps job seekers, founders, teams, and creators create polished AI headshots without booking a photographer. Upload a set of casual photos, choose professional styles and backgrounds, and generate high-resolution portraits for LinkedIn, resumes, company pages, speaker bios, and personal branding. It offers fast turnaround, multiple looks per session, commercial usage rights, and a private photo workflow designed for modern professionals.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/professionalheadshotio/logo-square.png\",\"niche_kws\":[\"AI headshot generator\",\"Professional headshots\",\"LinkedIn headshot\",\"Corporate headshots\",\"Business profile photo\",\"AI portrait generator\",\"Resume photo\",\"Personal branding\",\"Remote team headshots\",\"Professional profile picture\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-23T12:36:05.406143+00:00\",\"id\":17041,\"codename\":\"DocsToAudio\",\"slug\":\"docstoaudio\",\"problem_label\":\"AI Document to Audio Converter \u0026 Voice Cloning\",\"solution_label\":\"DocsToAudio converts PDF, EPUB, DOCX, and TXT into MP3 or M4B audiobooks using AI voices—or your own cloned voice. The free tier offers 300+ voices in 30+ languages, with no account or file-size limits; documents are parsed in-browser and the original file is never uploaded. Premium is pay-as-you-go with no subscription, offering 800+ ElevenLabs voices, Gemini narration, background conversion with email alerts, 7-day re-downloads, and voice cloning from a 10–30 second recording or authorized upload.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/docstoaudio/logo.png\",\"niche_kws\":[\"text-to-speech\",\"audiobook\",\"PDF converter\",\"EPUB\",\"document converter\",\"AI voice\",\"MP3\",\"productivity\",\"free tool\",\"ElevenLabs\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-23T20:31:48.573561+00:00\",\"id\":17050,\"codename\":\"Agent-Native\",\"slug\":\"agent-native\",\"problem_label\":\"Build AI-native apps fast: shared state, open-source templates.\",\"solution_label\":\"Agent-Native is an open-source framework for building agent-native experiences where AI agents and UIs share the same SQL-backed state. Define actions once, reuse them across chat, HTTP, MCP, and coding assistants, and customize production-ready templates for content, analytics, design, and collaboration.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/agent-native/logo.png\",\"niche_kws\":[\"agent-native-framework\",\"sql-backed-agents\",\"app-agent-loop\"],\"icp_kws\":[\"agentic-framework\",\"developer-tools\",\"ai-infrastructure\",\"product-engineering\",\"open-source-framework\"],\"market\":\"oss\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-24T17:42:04.361059+00:00\",\"id\":17074,\"codename\":\"Immigranta\",\"slug\":\"immigranta\",\"problem_label\":\"UK immigration intelligence, grounded in official guidance.\",\"solution_label\":\"UK immigration rules are complex, fragmented, and constantly changing. Immigranta is an AI assistant that helps applicants, sponsors, lawyers, and recruiters get answers faster. Ask questions in plain English and receive responses grounded in official UK immigration sources, complete with citations and links you can verify. No guessing. No hallucinations. Just trusted, source-backed immigration guidance when you need it. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/immigranta/Adobe-Express-file.png\",\"niche_kws\":[\"Legal\",\"AI\",\"LegalTech\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T07:04:43.621212+00:00\",\"id\":17079,\"codename\":\"TeraBox AI\",\"slug\":\"teraboxai\",\"problem_label\":\"AI Presentation Maker\",\"solution_label\":\"TeraBox is an all-in-one AI workspace for presentations, images, videos, research, writing, and file conversions. Create and automate everything in one place.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/teraboxai/Wei-Ming-Ming-1.png\",\"niche_kws\":[\"AI Presentation Maker\",\"AI PDF Tools\",\"AI Image Generation\",\"AI Video Generation\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T15:05:37.307526+00:00\",\"id\":17090,\"codename\":\"CueCue\",\"slug\":\"cuecue\",\"problem_label\":\"Digital Business Card, Link in Bio \u0026 RSVP Card Creator | CueCue\",\"solution_label\":\"CueCue helps creators, coaches, small businesses and event hosts create interactive web cards for link in bio pages, digital business cards, RSVP links, service offers, bookings and lead capture.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cuecue/Screenshot-2026-06-18-at-09.56.40.png\",\"niche_kws\":[\"Marketing\",\"Creator Tools\",\"Link in Bio\",\"Digital Business Card\",\"RSVP\",\"Event Tools\",\"Landing Page Builder\",\"No-Code\",\"Small Business\",\"Lead Generation\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"idea\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T16:45:36.641974+00:00\",\"id\":17093,\"codename\":\"Cortex - Capconvert\",\"slug\":\"cortexcapconvert\",\"problem_label\":\"Cortex is Modern Marketing.  AI powered, expert managed\",\"solution_label\":\"AI-powered, expert-managed search marketing optimization engine spanning SEO, GEO, CRO, and PPC, trained on a 1.5M-passage corpus of platform best practices\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cortexcapconvert/cortex-logo-black-on-white.png\",\"niche_kws\":[\"search marketing\",\"AI search optimization\",\"PPC\",\"SEO\",\"GEO\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T17:53:45.527964+00:00\",\"id\":17094,\"codename\":\"Donivo\",\"slug\":\"donivo\",\"problem_label\":\"Schedule to major social networks, vote on what ships next\",\"solution_label\":\"Donivo is a simple, fairly priced social media scheduling tool for creators, founders, small businesses, and teams. Create one post, choose your channels, and schedule across Facebook, Instagram, X, LinkedIn, TikTok, YouTube, Threads, and Bluesky. Start free, no card required — and help shape the roadmap by voting on what gets built next.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/donivo/favicon-1024.png\",\"niche_kws\":[\"social media\",\"scheduling\",\"marketing\",\"productivity\",\"creator tools\",\"SaaS\",\"content marketing\",\"automation\",\"social media management\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T18:37:14.466483+00:00\",\"id\":17095,\"codename\":\"fiveminutebrief\",\"slug\":\"fiveminutebrief\",\"problem_label\":\"Turn any topic into your own daily 5-minute podcast\",\"solution_label\":\"fiveminutebrief creates personalized daily 5-minute podcasts and newsletters for any topic you want to follow.\\n\\nCreate custom topics or follow public ones for free, then listen through your favorite podcast app using a private podcast feed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fiveminutebrief/fiveminutebrief-5m-logo-2.PNG\",\"niche_kws\":[\"Productivity\",\"Podcasts\",\"AI\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Info product, Newsletters, Communities\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T19:12:32.683392+00:00\",\"id\":17096,\"codename\":\"Simile AI\",\"slug\":\"simile-ai\",\"problem_label\":\"Simulate real human behavior. Predict responses before they happen.\",\"solution_label\":\"Simile uses AI-driven simulations to predict how customers, employees, and populations will respond to change. Organizations run behavioral experiments in a safe virtual environment, uncover deep audience insights, and de-risk major decisions before real-world launches.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/simile-ai/logo.png\",\"niche_kws\":[\"behavioral-simulation\",\"generative-agents\",\"synthetic-respondents\"],\"icp_kws\":[\"insights\",\"research\",\"customer-intelligence\",\"enterprise-ai\",\"behavioral-science\"],\"market\":\"analytics\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-25T20:13:20.110209+00:00\",\"id\":17100,\"codename\":\"Zaro AI\",\"slug\":\"zaro-ai\",\"problem_label\":\"Turn your data into working apps, agents, and workflows instantly.\",\"solution_label\":\"Zaro is an AI-native workspace that turns your company’s existing data into connected agents, dashboards, and workflows. Teams describe what they need in natural language, and Zaro generates internal tools that share a unified memory layer your company fully owns.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/zaro-ai/logo.png\",\"niche_kws\":[\"context engine\",\"agent workspace\",\"knowledge graph\"],\"icp_kws\":[\"knowledge management\",\"ai workspace\",\"internal tooling\",\"workflow automation\",\"enterprise intelligence\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-26T09:53:00.854046+00:00\",\"id\":17103,\"codename\":\"Outify\",\"slug\":\"outify\",\"problem_label\":\"The AI that turns outbound into revenue.\",\"solution_label\":\"Outify is the AI that turns outbound into revenue. Trained on your product, customers, and competitors, it runs your outbound end to end - finding the signal, building the lead, drafting the campaign, and chasing the deal until you win.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/outify/logo-only-white-black-background.jpg\",\"niche_kws\":[\"AI Outbound platform\",\"Lead Generation\",\"Sales automation\",\"Signal-based prospecting\",\"Personalized outreach\",\"Deal pursuit\",\"Cold email\",\"GTM automation\",\"Prospect research\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-26T15:31:39.298804+00:00\",\"id\":17109,\"codename\":\"Investor Match\",\"slug\":\"investormatch\",\"problem_label\":\"Find your perfect VC investors\",\"solution_label\":\"Upload your pitch deck and get 20 personalized VC matches with fit scores, direct contacts, and ready-to-send outreach emails.  Get a Teardown of your deck to improve before pitching. Over $100M in verified investor commitments.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/investormatch/Screenshot-2026-06-26-at-8.27.20-AM.png\",\"niche_kws\":[\"Investor Matches\",\"Startup funding\",\"VC finder\"],\"icp_kws\":[],\"market\":\"startup-builders\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-06-26T16:38:53.777024+00:00\",\"id\":17111,\"codename\":\"VESKALD\",\"slug\":\"veskald\",\"problem_label\":\"Strategies that survive real markets. Honestly tested. Self-Hosted bot\",\"solution_label\":\"Build crypto futures strategies without code, then find out whether they actually survive — honest backtest with real funding, slippage and commissions, stress-tests, out-of-sample validation, and three AI agents that diagnose, prototype and research. Self-hosted execution: your keys never leave your machine.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/veskald/web-app-manifest-512x512.png\",\"niche_kws\":[\"Artificial Intelligence\",\"No-Code\",\"SaaS\",\"Crypto\",\"Futures\",\"Trading Tools\",\"Self-Hosted\",\"Algotrading\",\"Quant Lab\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-26T17:02:01.066458+00:00\",\"id\":17112,\"codename\":\"polotno sdk\",\"slug\":\"polotnosdk\",\"problem_label\":\"Image and video editing SDK\",\"solution_label\":\"Ship image and video editing in weeks – without the long-term maintenance burden. Interactive editor, template automation, rendering, and export. Delivered as a programmable SDK you control. Designed to run inside your architecture.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/polotnosdk/logo-square-dark.png\",\"niche_kws\":[\"image editing\",\"video editing\",\"embedded editor\",\"canvas image editor\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-27T15:35:13.996397+00:00\",\"id\":17125,\"codename\":\"Problyx\",\"slug\":\"problyx\",\"problem_label\":\"A next-gen social prediction platform.\",\"solution_label\":\"Problyx is a next-gen social prediction market platform where users forecast the outcomes of real-time events across a wide range of topics. They can join existing markets or create their own, with prices and probabilities updating dynamically based on collective user activity.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/problyx/icon-512.png\",\"niche_kws\":[\"Tech\",\"Web3\",\"Social platform\",\"Investing\",\"Sports\",\"Pop culture\",\"Prediction Markets\"],\"icp_kws\":[],\"market\":\"community\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-28T11:27:05.744408+00:00\",\"id\":17141,\"codename\":\"Round OS\",\"slug\":\"roundos\",\"problem_label\":\"AI fundraising CRM with investor dossiers, contacts and warm intro paths\",\"solution_label\":\"Round OS is an AI fundraising CRM for founders running pre-seed and seed rounds. It combines your fundraising context with a live investor database: fund profiles, partner and analyst contacts, investment focus, recent news, portfolio signals and warm intro paths. It helps founders prioritize the right investors, prepare personalized outreach, draft follow-ups and keep every investor conversation moving without losing context.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/roundos/IMG_20260618_184922_570.jpg\",\"niche_kws\":[\"Fundraising\",\"CRM\",\"Investors list\",\"Outreach\",\"Investor intelligence\"],\"icp_kws\":[],\"market\":\"startup-builders\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-28T16:41:34.826011+00:00\",\"id\":17142,\"codename\":\"Vectosolve\",\"slug\":\"vectosolve\",\"problem_label\":\"Turn any image into a clean, cut-ready vector\",\"solution_label\":\"VectoSolve turns any image into clean, cut-ready vector files. Drop a PNG, JPG or photo and get AI-traced SVG and DXF for laser cutters, Cricut, Silhouette, CNC, embroidery and print-on-demand. It removes backgrounds, upscales, and exports directly to the format your machine actually needs, not just a generic SVG. Free preview, no signup, no watermark. Also available as a public API, an MCP server, and browser extensions.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vectosolve/vectosolve_monograme_couleur.png\",\"niche_kws\":[\"image to svg\",\"AI vectorizer\",\"png to svg\",\"dxf converter\",\"laser cutting\",\"cricut\",\"svg converter\",\"cnc\",\"embroidery\",\"print on demand\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-28T18:47:11.367896+00:00\",\"id\":17143,\"codename\":\"ALCHM\",\"slug\":\"alchm\",\"problem_label\":\"A private reflection practice for the moments therapy can’t reach.\",\"solution_label\":\"Most AI products try to answer every question. ALCHM explores a different direction: a private reflection platform that helps you think through writing instead of telling you what to think.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/alchm/ChatGPT-Image-Jun-21-2026-12_44_52-PM.png\",\"niche_kws\":[\"AI Journaling\",\"Private Journaling\",\"Reflective Writing\",\"Self Reflection\",\"Writing App\",\"Personal Growth\",\"Mindfulness\",\"Digital Journal\",\"Thoughtful AI\",\"Mental Wellness\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-28T21:57:40.642999+00:00\",\"id\":17146,\"codename\":\"DailyTube\",\"slug\":\"dailytube\",\"problem_label\":\"Follow everything. Watch nothing. AI daily briefings.\",\"solution_label\":\"DailyTube monitors your YouTube channels, subreddits, X accounts, and TikTok creators overnight and delivers one AI briefing every morning to WhatsApp, email, or Telegram. No app to open, no feed to scroll — it just arrives. Each briefing goes through 14 refinement stages.\\n\\nAsk Max, the built-in AI assistant, follow-up questions with answers cited back to the exact source. Free forever, no card required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/dailytube/DailyTube-logo.png\",\"niche_kws\":[\"AI\",\"Productivity\",\"Content Aggregation\",\"Summarization\",\"YouTube\",\"Reddit\",\"WhatsApp\",\"Daily Digest\",\"AI Assistant\",\"News\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-29T09:57:02.827406+00:00\",\"id\":17154,\"codename\":\"Murmr Voice\",\"slug\":\"murmr-voice\",\"problem_label\":\"Effortless on‑device dictation, perfectly formatted, fiercely private.\",\"solution_label\":\"murmr converts natural speech into clean, tone-aware text entirely on-device for macOS and iOS, keeping audio and transcripts private. It removes filler, fixes punctuation, and offers a unified voice workspace with dictation history, listening modes, and advanced controls for focused, hands-free writing.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/murmr-voice/logo.png\",\"niche_kws\":[\"on-device dictation\",\"private transcription\",\"voice workspace\"],\"icp_kws\":[\"speech recognition\",\"voice productivity\",\"macos utilities\",\"ios keyboard\",\"privacy tech\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-29T14:59:21.836141+00:00\",\"id\":17159,\"codename\":\"framecast\",\"slug\":\"framecast\",\"problem_label\":\"Turn Claude animations into watermark-free video\",\"solution_label\":\"Claude makes beautiful HTML animations, but screen recording wrecks them with dropped frames, banded gradients, and a watermark. Framecast renders your animation frame-by-frame in a real browser engine into a clean, watermark-free MP4: YouTube 16:9, vertical 9:16, and square 1:1 from one drop. Works with CSS, GSAP, canvas, and SVG. Free preview, then $2.99 per video, no subscription.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/framecast/framecast-stripe-icon-square.png\",\"niche_kws\":[\"HTML to video\",\"Claude animations to MP4\",\"No-watermark video export\",\"Frame-by-frame render\",\"GSAP to video\",\"Social video\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-29T16:46:51.199202+00:00\",\"id\":17161,\"codename\":\"forge\",\"slug\":\"forge\",\"problem_label\":\"Get your contractor website live in 10 minutes\",\"solution_label\":\"Forge is a website builder and lead management platform built specifically for home service contractors — plumbers, HVAC techs, electricians, and roofers. Get a professional website live in under 10 minutes, capture leads automatically, and collect Google reviews after every job. No tech skills, no agency, no waiting. One dashboard for your website, leads, and reviews.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/forge/forge_profile_photo.png\",\"niche_kws\":[\"contractor\",\"website builder\",\"lead generation\",\"home services\",\"HVAC\",\"plumber\",\"electrician\",\"roofer\",\"local SEO\",\"small business\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T02:38:05.489682+00:00\",\"id\":17168,\"codename\":\"InterviewFox AI\",\"slug\":\"interviewfoxai\",\"problem_label\":\"Dual-device AI Interview Assistant for Live Interviews\",\"solution_label\":\"InterviewFox is a dual-device AI interview assistant for live and coding interviews. It detects interviewer questions in real time, generates resume-based answers, supports coding and system design help, and keeps AI responses off your shared screen by showing them privately on your phone. It works with Zoom, Google Meet, Microsoft Teams, HackerRank, LeetCode, and other interview platforms.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/interviewfoxai/Image-18-.png\",\"niche_kws\":[\"AI Interview Assistant\",\"Live Interview Copilot\",\"Coding Interview Assistant\",\"Dual-Device Mode\",\"Real-Time Answers\",\"Resume-Based Answers\",\"Interview Preparation\",\"Mock Interviews\",\"Technical Interviews\",\"Job Search\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T11:50:23.290567+00:00\",\"id\":17177,\"codename\":\"Greenlight\",\"slug\":\"greenlight\",\"problem_label\":\"Catch App Store issues early, before Apple rejects you.\",\"solution_label\":\"Greenlight is an open-source pre-submission compliance scanner for Apple App Store review that runs locally in under a second. It analyzes code, privacy manifests, binaries, and metadata against Apple’s guidelines to catch rejection risks early, with an optional runtime verification tier for flow-dependent checks.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/greenlight/logo.png\",\"niche_kws\":[\"guideline auditor\",\"policy linter\",\"review validator\"],\"icp_kws\":[\"dev-tools\",\"aso\",\"analytics\",\"oss\",\"cloud\"],\"market\":\"dev-tools\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T13:37:21.670851+00:00\",\"id\":17181,\"codename\":\"PageSifter\",\"slug\":\"pagesifter\",\"problem_label\":\"A free, human-curated tech news app\",\"solution_label\":\"PageSifter is a completely free aggregator of hand-picked tech news. A human editor sifts through the web to select the best articles. No algorithm decides what you see.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/pagesifter/pagesifter.png\",\"niche_kws\":[\"tech news\",\"news aggregator\",\"content curation\",\"productivity\",\"news reader\",\"free\",\"web app\",\"mobile app\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Mobile App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T14:33:38.440519+00:00\",\"id\":17182,\"codename\":\"Feno.co\",\"slug\":\"fenoco\",\"problem_label\":\"Tech That Will Change Your Life\",\"solution_label\":\"Feno is a health-tech company championing the movement to advance oral care as the gateway to health. It blends the precision of advanced dental technology with the simplicity of everyday use to make oral health effortless.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fenoco/favicon_1.png\",\"niche_kws\":[\"smartbrush\",\"electric toothbrush\",\"dental care app\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T19:10:33.747796+00:00\",\"id\":17187,\"codename\":\"Listo\",\"slug\":\"listo\",\"problem_label\":\"Modernize your venue’s service management\",\"solution_label\":\"Listo is the leading communication and task management platform for the deskless workforce, seamlessly connecting guests to staff and internal teams to one another with a single tap on any device. As a result, Listo helps world class stadium, venue and hotel operators function with a leaner labor force with more accountability, while simultaneously unlocking new areas of revenue and providing a gold standard of service to their patrons.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/listo/getlisto_logo.jpeg\",\"niche_kws\":[\"enterprise communication tool\"],\"icp_kws\":[],\"market\":\"team-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T19:27:03.951753+00:00\",\"id\":17188,\"codename\":\"OpenSoftware\",\"slug\":\"opensoftware\",\"problem_label\":\"All your words, captured and working for you.\",\"solution_label\":\"June is a privacy-first AI workspace for Mac that keeps chats, documents, and meeting notes local on your desktop. It combines a private agent, voice dictation, and automated meeting summaries so you can automate sensitive workflows without sending raw data to external servers.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/opensoftware/logo-placeholder.png\",\"niche_kws\":[\"desktopagent\",\"privacyaissistant\",\"localfirstworkspace\"],\"icp_kws\":[\"privacytech\",\"productivity\",\"macos\",\"knowledgework\",\"aigeneratednotes\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T21:21:26.205729+00:00\",\"id\":17190,\"codename\":\"fluorly\",\"slug\":\"fluorly\",\"problem_label\":\"Fluorly gatekeeps your attention across Gmail, Slack, and Google Chat.\",\"solution_label\":\"Fluorly is a voice-first AI communication triage platform designed for busy entrepreneurs. It tackles message overload by consolidating incoming communications across channels like email and Slack into one simple, easy-to-view dashboard. By keeping tabs on your messages and highlighting priority items, Fluorly reduces the noise so you can focus on deep work. Simply chat with your smart assistant to triage your daily communications and take back control of your time.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fluorly/icon-512.png\",\"niche_kws\":[\"AI Triage\",\"Communication Triage\",\"Email Triage\",\"Slack Triage\",\"Hangouts Triage\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-06-30T21:24:29.950393+00:00\",\"id\":17191,\"codename\":\"ApplyBtn\",\"slug\":\"applybtn\",\"problem_label\":\"AI autofill for real-world job application forms\",\"solution_label\":\"ApplyBtn is an AI Chrome extension for job application autofill. It fills real-world application forms directly on the page using your CV and the job description, generates tailored answers and cover letters, and keeps you in control before manual submission.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aoolybtn/icon-light-128.png\",\"niche_kws\":[\"jobsearch\",\"autofill\",\"chromeextension\",\"coverletters\",\"resume\",\"recruiting\",\"productivity\",\"ai\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T02:20:19.895036+00:00\",\"id\":17195,\"codename\":\"upscayl\",\"slug\":\"upscayl\",\"problem_label\":\"Upscayl AI Image Upscaler Online Free\",\"solution_label\":\"Instantly convert your photos to HD quality with the Upscayl AI Image Upscaler. This Upscayl Models enhances blurry, pixelated, or low-resolution photos to stunning 4K resolution in seconds — the Upscayl Image and Upscayl ai image upscaler you can rely on.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/upscayl/Wei-Xin-Tu-Pian_20260410222420_1067.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T08:27:37.716883+00:00\",\"id\":17199,\"codename\":\"flow ai\",\"slug\":\"flowai-b1d7d7\",\"problem_label\":\"Flow AI Video Generator Online\",\"solution_label\":\"Flow AI Video Generator Online\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/flowai-b1d7d7/flowaivideo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T15:52:10.978521+00:00\",\"id\":17213,\"codename\":\"AdsBud\",\"slug\":\"adsbud\",\"problem_label\":\"Your AI media buyer for Meta and Google Ads\",\"solution_label\":\"AdsBud is an AI marketing agent that runs your Meta and Google Search campaigns from one chat, in plain language. It reads live performance and your actual setup on a schedule, scoring every campaign against today's number, your 7-day average, and your since-launch baseline, so it catches the leaks surface metrics hide. It proposes every fix with the reasoning attached, and nothing changes without your one-click approval. Solo from $29/mo.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/adsbud/meta-app-icon-1024.png\",\"niche_kws\":[\"AI marketing agent\",\"Meta Ads\",\"Google Ads\",\"PPC\",\"paid ads\",\"ad optimization\",\"marketing automation\",\"AI agent\",\"media buyer\",\"campaign management\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T16:13:30.294605+00:00\",\"id\":17214,\"codename\":\"Seedance 2.5\",\"slug\":\"seedance25-fe7887\",\"problem_label\":\"30 seconds. Native. No seams.\",\"solution_label\":\"Seedance 2.5 is a production-grade AI video generation platform accessible at seedance25.tech. Built for creators, brands and film studios, it delivers native 30-second single-pass cinematic footage with zero stitching, supports up to 50 multi-modal references for consistent visual identity, and offers precision local editing without full re-renders. With native audio-video sync and 4K output, it turns creative concepts into publishable studio-grade video in minutes, slashing traditional production costs and timelines.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedance25-fe7887/logo.png\",\"niche_kws\":[\"Seedance 2.5\",\"seedance25.tech\",\"AI video generator\",\"cinematic AI video\",\"production-grade AI video\",\"AI video generation platform\",\"ByteDance Seed AI\",\"synthetic video engine\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T17:43:53.334122+00:00\",\"id\":17216,\"codename\":\"TBR Local\",\"slug\":\"tbrlocal\",\"problem_label\":\"SEO Done Right!\",\"solution_label\":\"Local SEO That Puts Your Business on the Map\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tbrlocal/logo.png\",\"niche_kws\":[\"local seo\",\"seo\",\"reputation management\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-01T22:31:53.222269+00:00\",\"id\":17220,\"codename\":\"IPCheckly\",\"slug\":\"ipcheckly\",\"problem_label\":\"Where IP data meets security intelligence\",\"solution_label\":\"IPCheckly delivers fast, reliable IP intelligence through a powerful API that helps identify locations, networks, VPNs, proxies, Tor nodes, and potential security risks. Designed for developers and businesses, it enables smarter fraud prevention, geolocation, access control, and analytics with accurate, real-time data and seamless integration into modern applications.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/ipcheckly/Screenshot-2026-07-02-at-00.59.49.png\",\"niche_kws\":[\"ip data\",\"ip detection\",\"fraud detection\",\"ip database\",\"ip analytics\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-02T03:09:55.494017+00:00\",\"id\":17222,\"codename\":\"SpotScribe\",\"slug\":\"spotscribe\",\"problem_label\":\"Extract Spotify Podcast Transcripts Instantly\",\"solution_label\":\"Turn any Spotify podcast into text. Extract transcripts, generate AI summaries, chat with episodes, and copy or download content effortlessly.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/spotscribe/logo-rounded.png\",\"niche_kws\":[\"Spotify Podcast\",\"Spotify\",\"AI Podcast\",\"AutomaticTranscription\",\"AI\",\"Productivity\"],\"icp_kws\":[],\"market\":\"podcast\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-02T13:15:14.206963+00:00\",\"id\":17233,\"codename\":\"Symby\",\"slug\":\"symby\",\"problem_label\":\"Understand every side of a news story across articles, social, and podcasts\",\"solution_label\":\"Symby brings together news articles, social news posts, podcasts, and searchable background knowledge, all in one place, so you’ll never miss what matters. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/symby/Symby-Logo-white-on-gradient.png\",\"niche_kws\":[\"News\",\"News Aggregator\",\"Content Discovery\",\"AI Tools\",\"Productivity\",\"Podcasts\",\"Search\",\"Apps\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Mobile App\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-02T17:44:50.418493+00:00\",\"id\":17238,\"codename\":\"Zero\",\"slug\":\"zero\",\"problem_label\":\"Zero: Open-source terminal agent, every model and tool unlocked\",\"solution_label\":\"Zero is an open-source terminal coding agent built in Go that connects to any language model and your existing development stack. It lives in your command line, enabling customizable, model-agnostic automation while keeping you in full control of your code workflows.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/zero/logo-placeholder.png\",\"niche_kws\":[\"terminal agent\",\"go-based assistant\",\"model-agnostic orchestrator\"],\"icp_kws\":[\"developer tooling\",\"command-line\",\"ai engineering\",\"open-source\",\"code automation\"],\"market\":\"oss\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-03T18:21:36.583193+00:00\",\"id\":17260,\"codename\":\"MagicShot AI\",\"slug\":\"magicshotai\",\"problem_label\":\"Your AI photographer, designer \u0026 video editor in one app.\",\"solution_label\":\"MagicShot.ai is an all-in-one AI creative suite with 84+ tools: AI image generator, AI photoshoot (headshots, dating, wedding, baby, Instagram lifestyle), AI video generator, hairstyle changer, photo enhancer, background remover, and audio tools. Used by 400K+ creators, marketers, and everyday users. No design experience needed — most tools work from a single photo upload.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/magicshotai/magicshot-logo.png\",\"niche_kws\":[\"ai-image-generator\",\"ai-headshot\",\"ai-photoshoot\",\"ai-video-generator\",\"photo-editing\",\"ai-avatar\",\"text-to-image\",\"ai-photography\",\"content-creation\",\"ai-tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-04T17:56:37.423062+00:00\",\"id\":17276,\"codename\":\"LUFS Mastering\",\"slug\":\"lufsmastering\",\"problem_label\":\"Automatic mastering to Spotify standard: -14 LUFS · True Peak -1dB\",\"solution_label\":\"Most musicians upload to Spotify without knowing tracks get turned down if they exceed -14 LUFS. LUFS Mastering fixes this in seconds. Drop your audio file — WAV, MP3, FLAC — and it masters to exactly -14 LUFS with -1 dBTP True Peak using deterministic DSP (ITU-R BS.1770-4). No upload to any server. No account required. Runs 100% locally in your browser. Built for musicians, producers, and freelancers distributing to Spotify, Apple Music, DistroKid, CD Baby, Tunecore, LANDR, etc.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lufsmastering/logo_128x128.png\",\"niche_kws\":[\"mastering\",\"LUFS\",\"Spotify\",\"loudness\",\"-14 LUFS\",\"True Peak\",\"audio mastering\",\"music mastering\",\"streaming\",\"lufs meter\"],\"icp_kws\":[],\"market\":\"music\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-04T19:31:27.653453+00:00\",\"id\":17278,\"codename\":\"Offsend Browser Extension\",\"slug\":\"offsendbrowserextension\",\"problem_label\":\"Mask secrets before you hit send.\",\"solution_label\":\"Offsend catches secrets and personal data in your prompts and masks them automatically — before they ever reach ChatGPT, Claude, or Gemini.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/offsendbrowserextension/AppIcon.png\",\"niche_kws\":[\"AI safety\",\"prompt privacy\",\"browser extension\",\"local-first\",\"open source\",\"data protection\",\"developer tools\",\"sensitive data masking\",\"ChatGPT\",\"Claude\",\"Gemini\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-05T01:40:39.830051+00:00\",\"id\":17281,\"codename\":\"goahead\",\"slug\":\"goahead\",\"problem_label\":\"Put your impossible-to-test ads, brands, designs, and products in front of a real audience before you commit\",\"solution_label\":\"goahead lets you validate creative work with real audience feedback before it goes public. Test offline ads, design directions, or product concepts and see what genuinely connects with the people you're trying to reach.\\n\\nMade for marketers, designers, and product teams who want proof, not guesswork, before greenlighting a campaign or launch.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/goahead/goahead-icon-round-01.png\",\"niche_kws\":[\"Marketing\",\"Market research\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-05T07:29:40.970308+00:00\",\"id\":17286,\"codename\":\"Producer AI\",\"slug\":\"producerai\",\"problem_label\":\"Producer AI: AI Music Generator Free By Google\",\"solution_label\":\"Producer AI: AI Music Generator Free By Google\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/producerai/gemini-world-1-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-05T16:45:40.951247+00:00\",\"id\":17294,\"codename\":\"Analyse\",\"slug\":\"analyse\",\"problem_label\":\"Analytics, AI SEO, and a data copilot in one tab.\",\"solution_label\":\"Analyse replaces your fragmented growth toolstack with one dashboard. Cookieless product analytics with Mixpanel-grade funnels and cohort heatmaps, no SQL required. An AI SEO engine that goes from research to published post automatically. And a data copilot grounded in your real events and Search Console data. It also ships an MCP server so you can query your analytics directly from Claude or Cursor.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/analyse/Profile-Picture.png\",\"niche_kws\":[\"analytics\",\"SEO\",\"AI SEO\",\"product analytics\",\"cookieless analytics\",\"MCP\",\"content marketing\",\"growth tools\",\"AI assistant\",\"dashboard\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-06T17:43:20.597104+00:00\",\"id\":17308,\"codename\":\"directree\",\"slug\":\"directree\",\"problem_label\":\"Software listings you can trust. Every fact labelled.\",\"solution_label\":\"directree is an honest software directory and launch platform. Paste any product URL and get a full structured listing in about 30 seconds. Every field is clearly labelled Verified or AI-inferred, so you always know how we know it. Founders can claim their listing and get a do-follow backlink.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/directree/directree_fig_transp_500px.png\",\"niche_kws\":[\"Paste-a-URL listing creation (~30 second enrichment)\",\"Provenance labels on every field (Verified / AI-inferred / Founder-edited)\",\"Tool listing pages (structured\",\"labelled data)\",\"Comparison pages (X vs Y)\",\"Category pages\",\"Community upvotes\",\"Community surveys\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T13:09:39.604074+00:00\",\"id\":17325,\"codename\":\"Toolport\",\"slug\":\"toolport\",\"problem_label\":\"All your MCP servers. One port.\",\"solution_label\":\"Toolport is a free, open-source, local-first MCP gateway. Set up and authenticate each MCP server once, and every AI client (Claude, Cursor, VS Code, Codex and the rest) shares it. Your agent loads a handful of meta-tools instead of hundreds, cutting tool-token overhead up to 91%. Every call is fingerprinted for tampering, your API keys stay in the OS keychain, and you get a full audit trail. No containers, no sign-up.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/toolport/toolport-icon-128.png\",\"niche_kws\":[\"MCP\",\"AI agents\",\"developer tools\",\"open source\",\"local-first\",\"gateway\",\"Claude\",\"Cursor\",\"security\",\"productivity\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Desktop App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T14:23:23.529267+00:00\",\"id\":17326,\"codename\":\"Planpoint Viewer\",\"slug\":\"planpointviewer\",\"problem_label\":\"Interactive floor plan selector for real estate: share plans and inventory.\",\"solution_label\":\"Planpoint Viewer turns static floor plans into an interactive stacking plan prospects can explore in seconds.\\n\\nEmbed it on any real estate website and let buyers and renters:\\n\\t•\\tBrowse available units at a glance\\n\\t•\\tFilter by price and availability, updated in real time\\n\\t•\\tPicture the space through images, 360° tours, and choice of finishes\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/planpointviewer/Icon.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T15:14:11.827248+00:00\",\"id\":17328,\"codename\":\"Studio by dyventech\",\"slug\":\"studiobydyventech\",\"problem_label\":\"Bring the messy idea. We’ll find the product inside it.\",\"solution_label\":\"Dyven Studio helps founders and businesses turn messy product ideas into useful shipped products. We combine product strategy, design, engineering, AI thinking, and customer learning in one team, so decisions do not get lost between handoffs.\\n\\nUnlike traditional agencies, we do not just execute feature lists. We help clarify the product bet, test risky assumptions, ship the smallest valuable version, and learn from real user signals.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/studiobydyventech/Studiobydyventech.png\",\"niche_kws\":[\"Product Studio\",\"Product Strategy\",\"Product Design\",\"Product Engineering\",\"AI Development Studio\",\"MVP Development\",\"Digital Product Development\",\"UI/UX Design\",\"Custom Software Development\",\"Startup Product Studio\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T15:29:38.933572+00:00\",\"id\":17329,\"codename\":\"purasim\",\"slug\":\"purasim\",\"problem_label\":\"PuraSIM | eSIM for travellers\",\"solution_label\":\"Travel eSIMs without roaming fees\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/purasim/impressum-legal-notice-purasim-website-purasim.com-contact-holapurasim.com-purasim-is-a-digital-project-operated-by-its-ownerresponsible-person.-responsible-for-the-content-of-this-website-and-r-2.png\",\"niche_kws\":[\"eSIM\",\"travel eSIM\",\"travel tech\",\"mobile data\",\"roaming alternative\",\"internet abroad\",\"digital SIM\",\"remote work\",\"digital nomads\",\"international travel\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T17:44:21.976294+00:00\",\"id\":17331,\"codename\":\"SocialClipper\",\"slug\":\"socialclipper\",\"problem_label\":\"Unified social media bookmarking platform for organizing and saving posts.\",\"solution_label\":\"SocialClipper is a premium social media bookmarking and organization platform that lets you clip and save posts from major platforms including Twitter/X, TikTok, Instagram, Reddit, YouTube, and LinkedIn.\\n\\nStore all your saved content in one secure, elegant dashboard instead of scattered across multiple apps. Perfect for content curators, researchers, and social media enthusiasts who need to organize and reference web content efficiently.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/socialclipper/socialclipper_20260706145911.png\",\"niche_kws\":[\"Social Media\",\"Browser Extension\",\"Twitter\",\"Linkedin\",\"Instagram\",\"Reddit\",\"Youtube\",\"Tiktok\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-07T22:31:22.236274+00:00\",\"id\":17335,\"codename\":\"AISA (aisa.to) AI Fluency Assessment\",\"slug\":\"aisa\",\"problem_label\":\"Conversational and agentic AI Fluency Assessment with free Linkedin Certificate\",\"solution_label\":\"AISA is a conversational AI fluency assessment that measures how effectively professionals use artificial intelligence — scored across 5 dimensions and 11 criteria, with a free certificate.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aisa/logo-full-orange-big.png\",\"niche_kws\":[\"ai fluency\",\"ai skills assessment\",\"ai certification\",\"ai readiness\",\"workforce ai\",\"ai literacy\",\"skills assessment\",\"ai evaluation\",\"professional development\",\"hr tech\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-08T10:17:25.701289+00:00\",\"id\":17347,\"codename\":\"LeakCheck\",\"slug\":\"leakcheck\",\"problem_label\":\"Is your password secure? Check now for free!\",\"solution_label\":\"LeakCheck compares your passwords and email addresses to millions of known data leaks – right on your PC.\\n\\nDiscover LeakCheck, the user-friendly Windows software for protecting your digital identity. With LeakCheck, you can securely check your passwords and email addresses for known data breaches – quickly, intuitively, and directly on your PC, without any sensitive data leaving your system.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/leakcheck/logo_glow.png\",\"niche_kws\":[\"security\",\"software\",\"windows\",\"leak\",\"leakcheck\",\"hibp\",\"haveibeenpwned\",\"password\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Desktop App\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-08T14:32:32.024149+00:00\",\"id\":17348,\"codename\":\"ArchyBase\",\"slug\":\"archybase\",\"problem_label\":\"AI Architecture \u0026 Interior Design Studio\",\"solution_label\":\"ArchyBase is an AI-powered platform for architecture, interior, exterior, and landscape design. Transform photos, sketches, and floor plans into photorealistic renders in seconds. Generate AI floor plans, redesign interiors, visualize exteriors, and create 3D concepts with minimal effort. Built for architects, designers, real estate professionals, and homeowners looking to speed up design workflows and explore ideas faster.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/archybase/screenshot-20260221-111824.png\",\"niche_kws\":[\"AI\",\"Architecture\",\"Interior Design\",\"Home Design\",\"Floor Plan\",\"Rendering\",\"Visualization\",\"Real Estate\",\"Landscape Design\",\"Design Tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-09T08:20:57.038342+00:00\",\"id\":17361,\"codename\":\"Larasend\",\"slug\":\"larasend\",\"problem_label\":\"Own your Laravel emails: self-hosted, SES-powered, fully logged\",\"solution_label\":\"Larasend is a self-hosted transactional email system for Laravel teams that centralizes delivery logs, events, and API keys while sending through Amazon SES or Cloudflare Email Service. It provides a dedicated mail transport, HTTP API, and dashboard fully hosted on your own infrastructure.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/larasend/logo.png\",\"niche_kws\":[\"laravel mailer\",\"ses relay\",\"email controlplane\"],\"icp_kws\":[\"devops\",\"email-infrastructure\",\"laravel\",\"transactional-mail\",\"cloud-email\"],\"market\":\"oss\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-09T09:05:23.138375+00:00\",\"id\":17363,\"codename\":\"DomRegus\",\"slug\":\"domregus\",\"problem_label\":\"Your Domain. Your Identity. Your Future.\",\"solution_label\":\"DomRegus makes domain registration simple, secure, and reliable. Search, register, transfer, and manage domain names through an intuitive platform designed for individuals, startups, and businesses looking to establish a strong online presence.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/domregus/Screenshot-2026-07-07-at-13.22.39.png\",\"niche_kws\":[\"domain registration\",\"brand domains\",\"domain names\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-10T07:12:25.435086+00:00\",\"id\":17386,\"codename\":\"Ember: Relationship Keeper\",\"slug\":\"emberrelationshipkeeper\",\"problem_label\":\"The AI Keeper for your real relationships\",\"solution_label\":\"Ember is one private place for everything you need to remember about the people in your life: birthdays, moves, hard weeks, favorite details, kids' names, and follow-ups you promised. Keeper, the AI inside Ember, understands relationships: it turns one sentence into a note, a reminder, or an answer. It works for the people you love and the people you work with. No feed, no followers, no likes.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/emberrelationshipkeeper/ember-icon-1024.png\",\"niche_kws\":[\"personal CRM\",\"relationship keeper\",\"AI assistant\",\"reminders\",\"private notes\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-10T17:54:24.073024+00:00\",\"id\":17390,\"codename\":\"ChatCut\",\"slug\":\"chatcut\",\"problem_label\":\"Turn simple prompts into fully edited, AI-powered videos.\",\"solution_label\":\"ChatCut is an AI video editor that turns natural-language prompts into complete, on-brand edits. It assembles cuts, adds motion graphics, captions, and AI-generated visuals, while letting you edit talking-head videos directly from the transcript.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/chatcut/logo.png\",\"niche_kws\":[\"prompt editor\",\"talkinghead cleaner\",\"caption generator\"],\"icp_kws\":[\"video editing\",\"creator tools\",\"content production\",\"marketing video\",\"postproduction\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-10T20:47:36.786881+00:00\",\"id\":17393,\"codename\":\"GeoPatrol\",\"slug\":\"geopatrol\",\"problem_label\":\"Know Every IP. Trust Every Connection.\",\"solution_label\":\"GeoPatrol is an advanced IP intelligence platform that provides accurate geolocation, network, ASN, proxy, VPN, and security insights. Instantly analyze IP addresses with reliable global data to improve cybersecurity, fraud prevention, traffic analysis, and business decision-making through a fast, intuitive online service.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/geopatrol/Screenshot-2026-07-04-at-12.14.46.png\",\"niche_kws\":[\"ip location\",\"ip checker\",\"geolocation detection\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-11T10:34:09.67181+00:00\",\"id\":17406,\"codename\":\"TweetBoost GIF Downloader\",\"slug\":\"tweetboostgifdownloader\",\"problem_label\":\"Save Twitter GIFs as MP4 or real .gif — free, no upload\",\"solution_label\":\"Save any Twitter (X) GIF in seconds — as MP4 or a real .gif. Free.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tweetboostgifdownloader/tweetboost-apple-touch-180.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-12T06:35:31.464853+00:00\",\"id\":17421,\"codename\":\"Luma Dream Machine\",\"slug\":\"lumadreammachine\",\"problem_label\":\"Luma Dream Machine — AI Video Generator\",\"solution_label\":\"Luma Dream Machine — AI Video Generator\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lumadreammachine/gemini-world-1-.png\",\"niche_kws\":[\"video\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-12T13:22:56.356864+00:00\",\"id\":17426,\"codename\":\"Tier\",\"slug\":\"tier\",\"problem_label\":\"The AI accountability coach that reaches out first \",\"solution_label\":\"You don't quit your projects — you slowly disappear from them. Every tool you've tried (Notion, habit trackers, accountability partners) waited for YOU to show up. Tier is an AI coach that reaches out first: it knows your goal, remembers where you left off, and tells you the one thing to do today. Daily personalized check-ins, honest weekly reviews. Built from 20+ user interviews. iOS \u0026 Android.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tier/tier-5.png\",\"niche_kws\":[\"accountability\",\"AI coach\",\"goal tracking\",\"habit tracker\",\"productivity\",\"self-improvement\",\"iOS\",\"Android\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Mobile App\",\"offer_type\":\"One-time payments\",\"stage\":\"idea\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-12T19:59:11.897149+00:00\",\"id\":17433,\"codename\":\"Filly AI\",\"slug\":\"fillyai\",\"problem_label\":\"Fill any PDF or Word form in seconds with AI\",\"solution_label\":\"Filly AI reads any PDF or Word form, extracts every field, and autofills it from a saved client profile in seconds. Review and adjust the placement, export a pixel-perfect document, share a no-login link for review, or collect an e-signature with a full audit trail. Includes built-in IRS forms (W-9, W-4, I-9), 25 ready-made templates, and an AI assistant that answers questions while you fill.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fillyai/filly-logo-512.png\",\"niche_kws\":[\"AI form filler\",\"PDF automation\",\"E-signature\",\"Document automation\",\"Client CRM\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T03:36:33.650896+00:00\",\"id\":17439,\"codename\":\"Dreamina AI\",\"slug\":\"dreaminaai\",\"problem_label\":\"Dreamina AI: Free AI Image Generator \u0026 AI Video Generator\",\"solution_label\":\"Dreamina AI: Free AI Image Generator \u0026 AI Video Generator\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/dreaminaai/gemini-world-1-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T07:46:05.067469+00:00\",\"id\":17445,\"codename\":\"KWatch\",\"slug\":\"kwatch\",\"problem_label\":\"Receive real-time alerts when things are mentioned on social media\",\"solution_label\":\"Monitor keywords on Linkedin, Reddit, X, Facebook, Youtube, and HN, and get instant alerts by email, Slack, or API webhook\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/kwatch/logo.png\",\"niche_kws\":[\"social listening\",\"social media monitoring\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T15:05:27.244+00:00\",\"id\":17454,\"codename\":\"FindyourAI\",\"slug\":\"findyourai\",\"problem_label\":\"The fastest way to find AI tools that fit.\",\"solution_label\":\"FindYourAI is a curated AI tools discovery platform built to help users find, compare and choose the right AI software for real workflows. Instead of browsing endless directories, users can explore practical categories, use cases, pricing context, strengths and limitations, making it easier to discover relevant tools faster and make better software decisions.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/findyourai/Logo.png\",\"niche_kws\":[\"AI tools\",\"AI directory\",\"AI software\",\"SaaS discovery\",\"Productivity\",\"Marketing\",\"Automation\",\"SEO tools\",\"Software discovery\",\"Startup tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T15:33:50.58467+00:00\",\"id\":17455,\"codename\":\"VibeMyWay\",\"slug\":\"vibemyway\",\"problem_label\":\"Ship a full content package. While eating your lunch.\",\"solution_label\":\"One idea in. Blog post, email sequence, landing page, lead magnet, social kit, and images out. For founders and marketing leads at SMBs who handle content without a team, VibeMyWay is the practitioner-built plug-and-play AI workflow kit that turns one idea into a full publication package because every workflow was built and refined in production before being packaged for sale.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/viebmyway/squarepng300.png\",\"niche_kws\":[\"Content\",\"Marketing\",\"Agentic workflows\",\"Pipelines\",\"Content Marketing\",\"Lead Generation\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T18:46:33.973438+00:00\",\"id\":17457,\"codename\":\"Perceptiq\",\"slug\":\"perceptiq\",\"problem_label\":\"Become The Brand AI Recommends\",\"solution_label\":\"Perceptiq helps brands become visible in AI search and shape how AI assistants perceive them. It monitors real buying moments across AI chatbots, identifies where your brand is missing, misrepresented, or losing to competitors, and turns the findings into prioritized actions. With one-click execution and ready-to-use content, lean teams can improve AI visibility and brand perception without building an in-house GEO function.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/perceptiq/Frame-2-256.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-13T20:42:06.724333+00:00\",\"id\":17462,\"codename\":\"RFPilot\",\"slug\":\"rfpilot\",\"problem_label\":\"AI-powered RFP\",\"solution_label\":\"AI-powered RFP, questionnaire and proposal responses for B2B teams.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/rfpilot/favicon-600.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-14T07:07:21.139839+00:00\",\"id\":17471,\"codename\":\"SoloUno\",\"slug\":\"solouno\",\"problem_label\":\"Take control of hair pulling, skin picking \u0026 nail biting\",\"solution_label\":\"SoloUno helps people take control of body-focused repetitive habits like hair pulling (trichotillomania), skin picking, and nail biting. Because these habits tend to come and go rather than disappear, SoloUno focuses on real progress over quick fixes - affordable, daily, built for long-term habit change. It also supports behavioral therapy \\\"homework\\\" for those in treatment.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/solouno/Logo-solouno.jpeg\",\"niche_kws\":[\"trichotillomania\",\"dermatillomania\",\"BFRB\",\"hair pulling\",\"skin picking\",\"nail biting\",\"habit tracker\",\"mental health\",\"self-help\",\"habit breaking\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-14T12:03:29.325241+00:00\",\"id\":17480,\"codename\":\"PostPlanify\",\"slug\":\"postplanify\",\"problem_label\":\"Social media management for agencies and teams\",\"solution_label\":\"PostPlanify is an all-in-one social media management platform for agencies and teams. Plan, approve, schedule, and publish content across major social networks, manage multiple brands and clients, collaborate with your team, track analytics, automate reports, and create content faster with AI, all from one dashboard.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/postplanify/logo.png\",\"niche_kws\":[\"Social Media Management\",\"Social Media Scheduling\",\"AI Content Creation\",\"Team Collaboration\",\"Agency Tools\",\"Content Calendar\",\"Social Media Analytics\",\"Approval Workflows\",\"Multi-Brand Management\",\"Automated Reporting\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-14T12:21:18.723882+00:00\",\"id\":17482,\"codename\":\"Fantastic Forms\",\"slug\":\"fantasticforms\",\"problem_label\":\"The best website form builder app. Fast, fun and 100% free. Click here!\",\"solution_label\":\"Fantastic Forms is an all-in-one form builder that gives teams enterprise-grade capabilities with the simplicity of a modern SaaS. From lead capture and order forms to intake, quizzes, and unattended kiosks, one flat Pro plan unlocks everything: multi-page logic, real-time analytics, native integrations, and enterprise-grade security including SSO, SCIM, audit logs, malware scanning, and IP allowlisting.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fantasticforms/logo.png\",\"niche_kws\":[\"forms\",\"form\",\"builder\",\"creator\",\"app\",\"saas\",\"software\",\"tool\"],\"icp_kws\":[],\"market\":\"no-code\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-14T12:30:01.574272+00:00\",\"id\":17484,\"codename\":\"Veriwasp\",\"slug\":\"veriwasp\",\"problem_label\":\"Stop Bugs Before They Bite\",\"solution_label\":\"VeriWasp is an AI-powered automated testing tool built for indie SaaS founders. Describe any user flow in plain English (signup, checkout, onboarding, etc.), and AI drives a real browser to execute it. Get a data rich report with full trace replay, and WCAG accessibility reports that adapt when your UI changes, no brittle scripts. Veriwasp also offers API testing, full-site a11y scans, Chaos mode, and CI/CD integration. Start with 10 free runs. Ship faster, break fewer things.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/veriwasp/IMG_2018.jpeg\",\"niche_kws\":[\"Testing\",\"AI\",\"QA\",\"Bug fix\",\"Social Proof\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-14T23:00:47.739573+00:00\",\"id\":17495,\"codename\":\"AgenticRank\",\"slug\":\"agenticrank\",\"problem_label\":\"Tech Assessment for Agentic\",\"solution_label\":\"Tech Assessments for Agentic Team.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/agenticrank/agenticrank-icon-300_1.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"hr-tools\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-15T15:18:39.40291+00:00\",\"id\":17510,\"codename\":\"Nugget\",\"slug\":\"nugget\",\"problem_label\":\"Stop collecting insights. Start using them.\",\"solution_label\":\"Reading self-improvement books feels productive. A month later, you remember almost none of it. Nugget puts the best ideas from those books at your fingertips — as a Duolingo-style game, not a library. Tell the AI coach what's actually happening in your life (\\\"my manager keeps dismissing my ideas\\\") and it serves the exact concept you need, as a bite-sized session you play, not read.\\n\\nThen Nugget makes it stick: three different exercise formats per concept so you truly retrieve it, a concrete if-then plan to use it in real life, and science-backed spaced repetition that resurfaces ideas right before your brain drops them.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/nugget/launch-3x.png\",\"niche_kws\":[\"Android\",\"iOS\",\"Mobile\",\"Education\",\"Personal Growth\",\"Artificial Intelligence\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-15T16:52:20.576375+00:00\",\"id\":17512,\"codename\":\"LongTerMemory - AI study tool\",\"slug\":\"longtermemoryaistudytool\",\"problem_label\":\"Study platform to pass any exam\",\"solution_label\":\"LongTerm Memory is an intelligent learning ecosystem built to help you conquer complex subjects and ensure what you learn actually sticks. By utilizing sophisticated AI, the platform converts your raw notes and resources into high-impact study assets.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/longtermemoryaistudytool/ltm-logo-128x128.png\",\"niche_kws\":[\"ai\",\"learning\",\"edutech\",\"generative engine\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-15T20:26:55.772389+00:00\",\"id\":17516,\"codename\":\"Harbor\",\"slug\":\"harbor\",\"problem_label\":\"Physician-led GLP-1 weight loss, delivered to your door\",\"solution_label\":\"Harbor is a telehealth platform for medically supervised weight loss. Board-certified U.S. physicians review your online health assessment and, when appropriate, prescribe compounded semaglutide from $99/mo or tirzepatide from $149/mo. Every plan includes 24/7 physician access, registered-dietitian support to help you keep the weight off, free discreet shipping, and a 12-month money-back results guarantee. No insurance required, HSA/FSA eligible, and you can cancel anytime.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/harbor/harbor-logo-white.webp\",\"niche_kws\":[\"GLP-1\",\"weight loss\",\"telehealth\",\"semaglutide\",\"tirzepatide\",\"compounded medication\",\"online prescription\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-16T14:40:16.828827+00:00\",\"id\":17535,\"codename\":\"RankSurf\",\"slug\":\"ranksurf\",\"problem_label\":\"The AI visibility tool that gets you cited, not just tracked\",\"solution_label\":\"ChatGPT, Perplexity \u0026 Google AI Overview recommend your competitors, not you. RankSurf pinpoints the exact buying prompts you're losing, scores the third-party pages AI cites your rivals on, drafts the outreach, then re-crawls to prove when you get cited.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/ranksurf/ranksurf_logo_1024.jpg\",\"niche_kws\":[\"SEO\",\"GEO\",\"AI visibility\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-16T21:48:41.955484+00:00\",\"id\":17544,\"codename\":\"GeniusAI\",\"slug\":\"geniusai\",\"problem_label\":\"Turn Simple Prompts Into Powerful Visuals.\",\"solution_label\":\"GeniusAI transforms your ideas into stunning, production-ready visuals in seconds. Generate unique images from simple text prompts, edit photos, upscale content, and explore creative styles - all through an intuitive platform built for creators, marketers, teams, and businesses.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/geniusai/Screenshot-2026-07-16-at-22.51.17.png\",\"niche_kws\":[\"ai generation\",\"image generation\",\"ai text to image\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-17T06:19:05.048073+00:00\",\"id\":17555,\"codename\":\"Frontpage\",\"slug\":\"frontpage\",\"problem_label\":\"The landing page that builds itself, then improves itself.\",\"solution_label\":\"Frontpage is a website builder that works by conversation: you describe the site you want in plain English, and it builds and edits it for you, no templates, code, or designer required. Ask for a homepage, a services page, or a contact form and it appears; say what to change and the update is live in about a minute. You get a fast, professional site that is genuinely yours, with mobile-friendly pages, SEO basics, contact and quote forms, a blog, and the option to take orders or bookings all built in. When you are ready, connect your own domain (or buy one right through Frontpage) so customers find you at yourbusiness.com. And because every edit is just a conversation, keeping your site current stays easy long after launch.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/frontpage/frontpage-icon-128.png\",\"niche_kws\":[\"Small business website builder\",\"SEO optimization\",\"Website A/B testing\",\"Automated website building\",\"Agentic website builder\",\"AI website builder\",\"Small business marketing\",\"Website audit\",\"Website waitlist\",\"Landing page\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-17T20:06:36.840606+00:00\",\"id\":17564,\"codename\":\"Insert Affiliate\",\"slug\":\"insertaffiliate\",\"problem_label\":\"Affiliate tracking for in-app purchases on iOS and Android\",\"solution_label\":\"Insert Affiliate lets subscription apps run affiliate and referral programs that actually work on mobile. \\n\\nWhen someone installs from a creator's link and subscribes inside your app, we tie that in-app purchase back to the affiliate who drove it, including renewals, so you can pay on real results. \\n\\nIt works on top of StoreKit, Adapty and RevenueCat, charges a flat fee rather than a cut of your revenue, and handles affiliate management and payouts in one place.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/insertaffiliate/Screenshot-2026-07-16-at-20.19.41.png\",\"niche_kws\":[\"affiliate marketing\",\"affiliate tracking\",\"referral program\",\"in-app purchases\",\"mobile SDK\",\"iOS\",\"Android\",\"RevenueCat\",\"StoreKit\",\"app monetization\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-18T19:33:51.880102+00:00\",\"id\":17584,\"codename\":\"Nuvoha\",\"slug\":\"nuvoha\",\"problem_label\":\"Travel discovery that starts with you. \",\"solution_label\":\"The hardest part of travel isn’t booking. It’s deciding where to go. Tell Nuvoha your budget and the kind of trip you’re looking for, and discover personalised Trip Cards that bring flights, accommodation and destination inspiration together into complete, bookable trips. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/nuvoha/Nuvoha_Logo_Main_1.png\",\"niche_kws\":[\"Travel\",\"AI\",\"Travel Discovery\",\"Vacation Planning\",\"iOS\",\"Flights\",\"Hotels\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-18T20:47:34.541312+00:00\",\"id\":17585,\"codename\":\"Fragment\",\"slug\":\"fragment-db72c0\",\"problem_label\":\"AI doesn't know your customers. Fragment does.\",\"solution_label\":\"Fragment connects what your customers say, what your product does, and what your company knows into structured context. Crafted to help product teams, builders, and their AI agents to ship the right things 10x faster.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fragment-db72c0/fragment-logo-mark-128.png\",\"niche_kws\":[\"product intelligence\",\"voice of customer\",\"AI for Builders\",\"continuous discovery\",\"MCP\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-19T01:48:03.976471+00:00\",\"id\":17588,\"codename\":\"Verstage\",\"slug\":\"verstage\",\"problem_label\":\"The pizza tracker for your projects.\",\"solution_label\":\"Verstage is a lightweight status tracker for your work. You know how you can watch a pizza go from the oven to out-for-delivery to your door? Verstage does that for your projects. Your clients and teammates watch progress happen, stage by stage, in real time — no more juggling status emails, calls, and “any news yet?” messages.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/verstage/verstage-logo-128.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-20T00:17:36.672925+00:00\",\"id\":17609,\"codename\":\"presly\",\"slug\":\"presly\",\"problem_label\":\"AI social media manager\",\"solution_label\":\"Presly is an AI social media manager built for local businesses. Tell it about your business and it learns your brand voice, then writes captions, designs images, and publishes to 10 platforms on the schedule you set. Messages, comments, and reviews arrive in one inbox with replies already drafted for you to review and send. Made for restaurants, salons, dental offices, gyms, and repair shops. From $39/month.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/presly/app_icon_512.png\",\"niche_kws\":[\"ai social media manager\",\"social media scheduling\",\"social media management\",\"social media automation\",\"local business marketing\",\"small business marketing\",\"marketing automation\",\"ai content generation\",\"multi-platform publishing\",\"brand voice ai\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-20T09:00:18.272612+00:00\",\"id\":17624,\"codename\":\"Improve My Ads\",\"slug\":\"improvemyads\",\"problem_label\":\"Identify barriers killing your ad conversion rates instantly today\",\"solution_label\":\"Improve My Ads provides a behavioral-science audit for your advertisements. Simply upload text, screenshots, videos, or links to receive an analysis of your ad performance. The platform evaluates your content across six expert lenses, including copywriting, visual design, and conversion optimization.\\n\\nUsers receive an overall score and initial findings for free. A full audit report is available for purchase, providing comprehensive insights, before-and-after copy rewrites, and a downloadable PDF.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/improvemyads/favicon.ico.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-20T09:37:06.963455+00:00\",\"id\":17626,\"codename\":\"CartaStudio\",\"slug\":\"cartastudio\",\"problem_label\":\"Publish your expertise as knowledge your team and agents can trust \",\"solution_label\":\"CartaStudio is a desktop workbench for creating and publishing \\\"Cartas\\\" — curated, sourced knowledge graphs in plain, portable markdown that AI agents read deterministically and that you publish as queryable MCP endpoints. Capture your org's expertise as typed, scoped, sourced decision graphs you own and version in Git — every node tied to a book, DOI, or canonical article. Not auto-extracted, not RAG guesswork: curated, sourced, deterministic.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cartastudio/carta-logo-avatar-400.png\",\"niche_kws\":[\"knowledge graph\",\"second braing\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Desktop App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-20T14:30:38.657519+00:00\",\"id\":17634,\"codename\":\"Formfolio\",\"slug\":\"formfolio\",\"problem_label\":\"Invoice form-to-pdf generator\",\"solution_label\":\"Invoice form-to-pdf generation tool currently supporting 137 countries \u0026 jurisdictions with 62 document label languages \u0026 full UI localizations for 59 languages\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/formfolio/formfolio-icon-1024.png\",\"niche_kws\":[\"Invoice\",\"Freelance\",\"Finance\",\"Personal\",\"Quote\",\"Accounting\",\"PDF\",\"Global\"],\"icp_kws\":[],\"market\":\"accounting\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-20T21:45:21.392402+00:00\",\"id\":17641,\"codename\":\"Presentation to Video\",\"slug\":\"presentationtovideo\",\"problem_label\":\"Turn slides into a fully narrated video automatically.\",\"solution_label\":\"Turn your PowerPoints or PDFs into a professional narrated video. No mic, no editing, no experience needed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/presentationtovideo/Presentation-Tool-128px.png\",\"niche_kws\":[\"PowerPoint to Video\",\"PDF to Video\",\"AI Presentation\",\"Presentation Software\",\"AI Video Generator\",\"Training Videos\",\"Sales Enablement\",\"Corporate Training\",\"AI Voiceover\",\"Education\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-21T10:48:36.094134+00:00\",\"id\":17651,\"codename\":\"FreeMake.cc\",\"slug\":\"freemakecc\",\"problem_label\":\"Free AI Image Generator — No Signup, Unlimited \u0026 Online\",\"solution_label\":\"Generate AI images free, no signup required. Unlimited daily credits, multiple models (GPT Image 2, Gemini 3, Qwen). No VPN needed. Start creating now.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/freemakecc/freemake.ccDfhnEJYlNB7h.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-21T17:50:35.251322+00:00\",\"id\":17669,\"codename\":\"PartnerUp\",\"slug\":\"partnerup\",\"problem_label\":\"Connect with co-founders and collaborators with considered profiles\",\"solution_label\":\"PartnerUp helps you find co-founders and collaborators, not just another networking contact. Browse serious builders, connect only when it's mutual, then get the tools to actually start the company. Co-founder matching plus a real founder toolkit, in one app.\\n\\nFeatures include:\\n\\nA daily curated collaborator pick each day, chosen for how you fit\\nAdvanced searching and filtering and ability to shortlist other creators\\nEasy-to-generate legal templates\\nCalculators for equity splits, dilution simulation, vesting, cap table and more\\nGuides on funding, vesting, equity splits, NDA's and more\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/partnerup/roundedlogo.png\",\"niche_kws\":[\"startup\",\"cofounder\",\"founder\",\"collaborate\",\"social\",\"network\",\"connect\",\"business\",\"launch\",\"developer\"],\"icp_kws\":[],\"market\":\"startup-builders\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-21T19:26:44.192748+00:00\",\"id\":17673,\"codename\":\"Magic Listing by InsightAgent\",\"slug\":\"magiclistingbyinsightagent\",\"problem_label\":\"Your AI copilot for reviewing and improving Etsy listings\",\"solution_label\":\"Magic Listing is an AI copilot for Etsy sellers. Audit titles, tags, descriptions, pricing, thumbnails, alt text, and infringement risks; compare recommendations with the original and refine every draft before deciding what to use.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/magiclistingbyinsightagent/insight-agent-logo.png\",\"niche_kws\":[\"AI listing Optimizer\",\"Trends Research\",\"Product Research\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-21T19:36:44.85971+00:00\",\"id\":17675,\"codename\":\"Sited\",\"slug\":\"sited\",\"problem_label\":\"See how visible your website is to AI\",\"solution_label\":\"Sited shows founders and marketing teams how visible their brand is across ChatGPT, Google AI Overviews, Gemini, Perplexity, and Bing Copilot.\\n\\nEnter your website to receive a free AI Visibility infographic, then unlock a detailed, evidence-backed audit with platform scores and prioritised fixes.\\n\\nIt’s fast, self-serve, and available for a one-off $50 payment, so no subscription, sales call, or complicated dashboard.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sited/Sited-Logo.png\",\"niche_kws\":[\"AI visibility\",\"Generative engine optimization\",\"GEO\",\"AI SEO\",\"Website audit\",\"Marketing\",\"ChatGPT\",\"Perplexity\",\"Google AI Overviews\",\"SaaS\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T02:40:32.754031+00:00\",\"id\":17683,\"codename\":\"T-Shirt Design AI\",\"slug\":\"tshirtdesignai\",\"problem_label\":\"AI-powered custom tee graphics for print on demand\",\"solution_label\":\"T-Shirt Design AI helps designers concept many directions fast. Explore styles and compositions in minutes from a single prompt, then take the best one into your own tools. Export transparent, print-ready PNGs at 300 DPI. Upload references to keep your visual language consistent, so your output stays on-brand for print-on-demand workflows.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tshirtdesignai/apple-touch-icon.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T03:18:13.008008+00:00\",\"id\":17684,\"codename\":\"Linkeddit\",\"slug\":\"linkeddit\",\"problem_label\":\"All-in-One AI Demand and Competitor Intelligence Platform\",\"solution_label\":\"Linkeddit is an AI demand and competitor intelligence platform for SaaS teams, agencies, and founder-led sales. It monitors review sites like G2, Capterra, TrustRadius, and Trustpilot plus the open web, delivering weekly graded competitor briefs covering launches, pricing changes, complaint themes, and switching signals. Its AI-powered lead pipelines find buyers actively looking to switch and draft personalized outreach for each one, while Answer Radar shows where ChatGPT, Perplexity, and Gemini recommend competitors instead of you, then helps you fix it.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/linkeddit/linkeddit-logo.png\",\"niche_kws\":[\"Competitor Intelligence\",\"Competitive Intelligence\",\"Demand Intelligence\",\"Buyer Intent\",\"Answer Engine Optimization\",\"AEO\",\"GEO\",\"AI Visibility\",\"Market Research\",\"Sales Intelligence\",\"Lead Generation\",\"SaaS\",\"GTM\",\"MCP\",\"Reddit\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T08:18:09.555343+00:00\",\"id\":17691,\"codename\":\"Free WhatsApp Sender\",\"slug\":\"freewhatsappsender\",\"problem_label\":\"Free WhatsApp Sender-WA Web Sender\",\"solution_label\":\"WhatsApp Sender for Bulk Messages\\nSend Bulk Messages on WhatsApp Web\\nUse this WhatsApp Sender to send personalized bulk messages to your contacts directly through WhatsApp Web and support your sales outreach.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/freewhatsappsender/f7289a89-7879-4015-8715-004932dd8a80.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T08:49:57.801579+00:00\",\"id\":17692,\"codename\":\"Stat Sniper\",\"slug\":\"statsniper-9c1f41\",\"problem_label\":\"Stat Sniper: AI Sports Betting Analytics, Built by Bettors for Bettors\",\"solution_label\":\"Stat Sniper is an AI sports betting app that combines real-time statistics, player prop tracking, and predictive AI analysis with a social layer for sharing insights and picks. It sits between a sports data terminal and a community platform — more than a stats app, more than a tipster service. Bettors get the numbers and the reasoning behind them, plus a place to discuss every line as games unfold.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/statsniper-9c1f41/orangestat.png\",\"niche_kws\":[\"ai\",\"ml\",\"sass\",\"sports\",\"sports betting\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T09:12:04.873118+00:00\",\"id\":17696,\"codename\":\"100 Questions\",\"slug\":\"100questions\",\"problem_label\":\"See whether AI puts your brand in the answer.\",\"solution_label\":\"Run 25 identical questions across OpenAI, Claude, Gemini, and Grok. Compare up to 100 web-grounded provider answers with sources and transparent, directional results—not a mystery score.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/100questions/logo-mark.png\",\"niche_kws\":[\"visibility\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T10:59:39.791991+00:00\",\"id\":17698,\"codename\":\"Wheesper\",\"slug\":\"wheesper\",\"problem_label\":\"Anonymous discussions for honest team and community feedback\",\"solution_label\":\"Wheesper enables private, anonymous discussions by sharing a single link with no account setup required. Participants reply under stable pseudonyms while organizers manage conversations through a separate private link. Designed for teams, communities, classrooms, and groups seeking honest perspectives without identity pressure.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wheesper/Group-6-2-1-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"team-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-22T15:53:12.661402+00:00\",\"id\":17707,\"codename\":\"AI Seedance 2.5 Video Generator\",\"slug\":\"aiseedance25videogenerator\",\"problem_label\":\"Generate 30-second 4K Cinematic AI videos with Seedance 2.5\",\"solution_label\":\"$39\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aiseedance25videogenerator/logo_Fu-Ben.png\",\"niche_kws\":[\"video-examples\",\"demo-videos\",\"seedance-comparison\",\"release-updates\",\"product-video\",\"cinematic-video\",\"prompt-examples\",\"text-to-video\",\"image-to-video\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-07-22T18:21:03.671201+00:00\",\"id\":17709,\"codename\":\"Reelyze\",\"slug\":\"reelyze\",\"problem_label\":\"Know why your videos flop before you post\",\"solution_label\":\"Reelyze is an AI video analytics tool for content creators. Paste any Reel, TikTok, or Short, and it analyzes your video frame by frame, showing your hook score, retention map, and the exact second viewers drop off. It also tracks your competitors automatically and writes your next script using your own performance data. Built for creators who want to stop guessing why their videos flop and start growing with real insights.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/reelyze/reelyze-icon-cyan-512.png\",\"niche_kws\":[\"hook analysis\",\"retention tracking\",\"video performance\",\"competitor analysis\",\"AI script generation\",\"short form video\",\"content strategy\",\"reels growth\",\"tiktok growth\",\"video optimization\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T00:09:15.335501+00:00\",\"id\":17716,\"codename\":\"TheCartoonist.Studio\",\"slug\":\"thecartoonist\",\"problem_label\":\"Upload a photo. Get a cartoon you.\",\"solution_label\":\"TheCartoonist.Studio turns portrait photos into polished AI cartoon portraits while preserving the person’s recognizable likeness. Upload a clear front-facing photo, generate a free preview, and only pay if you like the result. Built from 12 years of professional caricature experience, it creates custom-looking cartoon avatars for profiles, branding, gifts, prints, merch, and social media.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/thecartoonist/logo.png\",\"niche_kws\":[\"AI\",\"image generation\",\"cartoon portrait\",\"avatar maker\",\"profile picture\",\"caricature\",\"photo to cartoon\",\"creator tools\",\"digital art\",\"personalized gifts\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T09:01:53.74744+00:00\",\"id\":17730,\"codename\":\"HYPERFOCUS\",\"slug\":\"hyperfocus\",\"problem_label\":\"Free macOS planner that turns goals into daily progress\",\"solution_label\":\"Most productivity tools start with an inbox, helping you collect, process, and organize work. That can make you feel in control without moving your most important work forward. Hyperfocus is a goals-first planner for macOS. It helps you choose a few outcomes that matter most for the next few months, plan your weeks and days around them, and make consistent progress through focused work.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hyperfocus/logo.png\",\"niche_kws\":[\"Productivity\",\"Deep Work\",\"Planner\",\"AI Coach\",\"Pomodoro\",\"Time Management\",\"Task Management\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T15:28:33.163298+00:00\",\"id\":17740,\"codename\":\"APEIROCRAFT\",\"slug\":\"apeirocraft\",\"problem_label\":\"Proposal software that shows you when clients open it\",\"solution_label\":\"Freelancers and agencies send proposals and hear nothing for days. ApeiroCraft adds read receipts so you know exactly when clients open it — then e-signature and one-click invoice generation from the accepted proposal. Free plan, flat rate, works globally.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/apeirocraft/logo.png\",\"niche_kws\":[\"proposals\",\"e-signature\",\"invoicing\",\"crm\",\"client-management\",\"proposal-software\",\"webflow\",\"agency-tools\",\"freelance\",\"saas\",\"productivity\",\"business-software\",\"contract-management\",\"proposal-tracking\",\"read-receipts\"],\"icp_kws\":[],\"market\":\"-\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T16:52:13.924388+00:00\",\"id\":17741,\"codename\":\"JobStep\",\"slug\":\"jobstep\",\"problem_label\":\"Build your resume with AI and finally hear back\",\"solution_label\":\"JobStep is an AI resume builder that tailors your resume and application to each job so you actually get interviews.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/jobstep/Logo.jpeg\",\"niche_kws\":[\"AI Resume Builder\",\"ATS Resume Checker\",\"Resume Tailoring\",\"Resume Scoring\",\"Cover Letter Builder\",\"AI Job Matching\",\"Job Application Tracker\",\"Job Search\",\"Resume Optimization\",\"Career Tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T20:12:06.187419+00:00\",\"id\":17745,\"codename\":\"FaceSage\",\"slug\":\"facesage\",\"problem_label\":\"Upload a photo, get an honest face reading of who they are.\",\"solution_label\":\"Upload a photo and get an AI face reading grounded in real facial measurements and six face-reading traditions — character, dating style, compatibility. No horoscope filler; first reading free.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/facesage/avatar-1024.png\",\"niche_kws\":[\"face reading\",\"dating\",\"personality\",\"compatibility\",\"AI\",\"relationships\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-23T21:13:17.047117+00:00\",\"id\":17746,\"codename\":\"OpenWorker\",\"slug\":\"openworker\",\"problem_label\":\"Your on-device AI coworker, finishing real work in your tools\",\"solution_label\":\"OpenWorker is a local-first AI coworker that connects to your existing tools, turns high-level requests into finished work, and always checks in before important actions. You bring your own models and keys, keeping privacy, flexibility, and\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/openworker/logo-placeholder.png\",\"niche_kws\":[\"desktop agent\",\"workflow coworker\",\"approval-first assistant\"],\"icp_kws\":[\"productivity\",\"ai-agents\",\"workflow\",\"automation\",\"open-source\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-24T18:18:38.336542+00:00\",\"id\":17766,\"codename\":\"SeoSmart\",\"slug\":\"seosmart\",\"problem_label\":\"Write, Publish \u0026 build backlinks on Autopilot\",\"solution_label\":\"SeoSmart researches keywords, then schedules \u0026 generates up to 60 brand-tailored 5,000-word articles every month with images, internal links, and YouTube videos, publishes them automatically, and builds backlinks through our exchange network.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seosmart/logo.png\",\"niche_kws\":[\"AI Content Generation\",\"SEO Content Generation\",\"SEO Automation\",\"Content Automation\",\"Blog Automation\",\"Keyword Research\",\"AI SEO\",\"Backlink Building\",\"Content Marketing\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-25T10:34:21.119206+00:00\",\"id\":17776,\"codename\":\"OffCode TorChat\",\"slug\":\"torchat\",\"problem_label\":\"Self-hosted chat server\",\"solution_label\":\"OffCode Tor Chat is designed to make secure Tor Hidden Service hosting simple. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/torchat/LogoSome.png\",\"niche_kws\":[\"Encrypted chat\",\"Tor network\",\"Self-hosted\",\"Privacy\"],\"icp_kws\":[],\"market\":\"oss\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"Lifetime deal\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-26T13:36:41.248559+00:00\",\"id\":17798,\"codename\":\"FluentDB\",\"slug\":\"fluentdb\",\"problem_label\":\"The AI database client for macOS\",\"solution_label\":\"FluentDB is the AI database client for macOS that is fast, lightweight, and secure.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fluentdb/Frame-120-1-.png\",\"niche_kws\":[\"Developer tool\",\"AI Database Client\",\"PostgreSQL Client\",\"MySQL Client\",\"SQLite Client\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Desktop App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-27T03:44:01.770409+00:00\",\"id\":17809,\"codename\":\"Text to Speech \",\"slug\":\"texttospeech\",\"problem_label\":\"Free AI Text to Speech Online\",\"solution_label\":\"Text to Speech is an AI-powered text to speech platform that converts text into natural-sounding voices online. Generate realistic AI voiceovers in multiple languages for videos, podcasts, education, and business.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/texttospeech/text-to-speech-1.png\",\"niche_kws\":[\"AI Text to Speech\",\"Text to Voice\",\"AI Voice Generator\",\"Voice AI\",\"Speech Synthesis\",\"AI Audio Generator\",\"Voiceover Generator\",\"AI Voiceover\",\"TTS\",\"Text Reader\",\"AI Narrator\",\"Multilingual AI Voice\",\"Audio Creation\",\"Content Creator Tools\",\"YouTube Voice Generator\",\"Podcast Tools\",\"Accessibility Tools\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T06:37:24.567998+00:00\",\"id\":17826,\"codename\":\"Seed Imagine\",\"slug\":\"seedimagine\",\"problem_label\":\"AI Image Generator \u0026 AI Video Generator\",\"solution_label\":\"AI Image Generator \u0026 AI Video Generator\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedimagine/gemini-world-1-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T07:29:25.058497+00:00\",\"id\":17829,\"codename\":\"watermark remover\",\"slug\":\"watermarkremover-87781e\",\"problem_label\":\"Video Watermark Remover – Remove Watermark From Video Online in Seconds\",\"solution_label\":\"Video Watermark Remover – Remove Watermark From Video Online in Seconds\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/watermarkremover-87781e/flowaivideo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T08:44:09.245246+00:00\",\"id\":17833,\"codename\":\"Arelio API Gateway\",\"slug\":\"arelioapigateway\",\"problem_label\":\"The Only API Gateway That Goes Beyond Just the Runtime\",\"solution_label\":\"Arelio is a lightweight API gateway built to make deploying, managing, and scaling APIs simpler and faster.\\n\\nUnlike traditional gateways that operate as standalone infrastructure, Arelio is part of the wider DigitalAPI ecosystem. Your gateway, API catalogue, developer marketplace, analytics, governance, and connected API products work together as one integrated experience.\\n\\nTeams can quickly deploy APIs, apply policies, manage revisions and versions, monitor API traffic, and understand exactly what is happening across the API lifecycle without navigating complex gateway infrastructure.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/arelioapigateway/DAC-new-logo-png.png\",\"niche_kws\":[\"API Gateway\",\"API Lifecycle Management\",\"API Runtime\",\"Lightweight API gateway\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T08:46:46.087296+00:00\",\"id\":17835,\"codename\":\"Invoice Paid\",\"slug\":\"invoicepaid\",\"problem_label\":\"Free invoice generator - no signup, no watermark\",\"solution_label\":\"Create professional invoices in your browser and download a clean PDF - no account, no email gate, no watermark stamped across the page. Pick from 16 templates built for specific trades (plumber, electrician, cleaner, photographer) and tax systems (UK VAT, UAE TRN), or start blank. Add your logo, tax line, and payment terms. The web tool is free forever; the iPhone app adds saved clients, estimates, and paid/unpaid tracking.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/invoicepaid/AppIcon-1024.png\",\"niche_kws\":[\"invoice generator\",\"invoice template\",\"PDF invoice\",\"freelancer tools\",\"small business\",\"contractor invoice\",\"free tools\",\"no signup\",\"VAT invoice\",\"billing\"],\"icp_kws\":[],\"market\":\"payments\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T13:47:16.754021+00:00\",\"id\":17842,\"codename\":\"StashMyFile\",\"slug\":\"stashmyfile\",\"problem_label\":\"Clean, private file sharing without the clutter\",\"solution_label\":\"StashMyFile is a modern file-hosting service built for fast uploads, clean download pages, and straightforward sharing. Upload files without creating an account, or sign in to manage uploads, use optional browser-side encryption, access premium features, and collaborate through shared organization workspaces. Unlike cluttered file hosts filled with misleading buttons and aggressive advertising, StashMyFile emphasizes privacy, transparent limits, and a simple, trustworthy experience for both uploaders and recipients.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/stashmyfile/android-chrome-192x192.png\",\"niche_kws\":[\"File Sharing\",\"File Hosting\",\"Cloud Storage\",\"Privacy\",\"Secure File Sharing\",\"Anonymous Uploads\",\"Browser Encryption\",\"Team Collaboration\",\"Productivity\",\"SaaS\"],\"icp_kws\":[],\"market\":\"cloud\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T15:34:18.983052+00:00\",\"id\":17844,\"codename\":\"Serpverse\",\"slug\":\"serpverse\",\"problem_label\":\"Rank higher on Google with verified content placements\",\"solution_label\":\"Serpverse is a marketplace for guest post placements on real, manually vetted websites — no fake metrics, no PBNs. Buyers browse verified DA/DR listings and funds sit in escrow until content is approved, with dispute coverage even if a link disappears later. Publishers keep 100% of their price, no commission.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/serpverse/android-chrome-512x512.png\",\"niche_kws\":[\"buy guest posts\",\"guest post marketplace\",\"buy backlinks\",\"backlink marketplace\",\"link building service\",\"guest post service\",\"verified DA backlinks\",\"niche edit\",\"sponsored post marketplace\",\"white hat link building\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T17:21:01.365264+00:00\",\"id\":17846,\"codename\":\"Karpo\",\"slug\":\"karpo\",\"problem_label\":\"Karpo — a proactive AI assistant that lives in iMessage\",\"solution_label\":\"Karpo is a proactive AI assistant that brings personalized city recommendations directly to iMessage. Tell Karpo what you feel like doing, from finding a dinner spot or local event to planning a date night, group hangout, weekend, or trip. It learns from what you love and skip, making every suggestion more relevant over time. Karpo can uncover hidden gems, suggest experiences, coordinate plans in group chats, provide booking links, and help with everyday life admin. Free to start and especially knowledgeable about New York City, San Francisco, and London, Karpo easily turns vague ideas into plans worth leaving home for.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/karpo/LA-compressed.jpg\",\"niche_kws\":[\"AI Assistant\",\"Lifestyle\",\"Local Discovery\",\"Travel Planning\",\"Productivity\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Free product\",\"stage\":\"mvp-wip\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T21:52:14.720029+00:00\",\"id\":17851,\"codename\":\"Vibin\",\"slug\":\"vibin\",\"problem_label\":\"The home of AI builders.\",\"solution_label\":\"Vibin is a personalized signal feed for people building with AI. Follow the tools and creators you care about, and it finds useful updates, tutorials, and examples from across the internet, then organizes them by topic and skill level so you can understand what matters without checking a dozen feeds.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vibin/vibin-logo-128.png\",\"niche_kws\":[\"AI\",\"Content Curation\",\"News\",\"Learning\",\"Productivity\",\"Video\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-28T23:12:14.439016+00:00\",\"id\":17852,\"codename\":\"SocialPreviewing\",\"slug\":\"socialpreviewing\",\"problem_label\":\"Preview profile photos, cover images and posts across social media platforms\",\"solution_label\":\"Upload your pfp, cover image or post and instantly preview them on tablet, mobile and desktop.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/socialpreviewing/brand-logo-1-.png\",\"niche_kws\":[\"Social Media\",\"Marketing\",\"AI Tools\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-30T14:19:13.106103+00:00\",\"id\":17899,\"codename\":\"Claritrix\",\"slug\":\"claritrix\",\"problem_label\":\"Weighted decision scorecards for business teams\",\"solution_label\":\"Claritrix is a browser-based weighted decision scorecard tool for consultants, procurement managers, HR teams, and finance professionals. Pick from 18 templates across Business \u0026 Finance, HR \u0026 People, and Vendor \u0026 Risk, add your options, set weighted criteria, score, and get ranked results with a recommended winner. Export a branded PDF, live-formula Excel workbook, or plain CSV. Everything runs 100% client-side; nothing is uploaded. One-time lifetime purchase, not a subscription. Built solo, still early, shipping based on real feedback.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/claritrix/claritrix-icon-profile-picture.png\",\"niche_kws\":[\"Decision-Making\",\"Business Intelligence\",\"Productivity\",\"Vendor Management\",\"HR Tools\",\"Finance Tools\",\"SaaS\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-30T15:57:09.806701+00:00\",\"id\":17900,\"codename\":\"G Maps Extractor\",\"slug\":\"gmapsextractor\",\"problem_label\":\"Extract Google Maps business leads\",\"solution_label\":\"G Maps Extractor is a no-code Google Maps scraper for collecting local business data at scale. It extracts names, addresses, phone numbers, emails, websites, social profiles, ratings, reviews, photos, and other public listing details. Users can run jobs in the cloud or through a Chrome or Edge extension, then export structured results to CSV, Excel, or JSON for lead generation, local SEO, outreach, and market research.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/gmapsextractor/128.png\",\"niche_kws\":[\"1. Flexible Google Maps Extraction\",\"2. Rich\",\"Export-Ready Business Data\",\"3. Built for Real Business Workflows\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-30T20:50:29.432642+00:00\",\"id\":17904,\"codename\":\"HighReach\",\"slug\":\"highreach-c3d072\",\"problem_label\":\"AI Creator Studio for Video \u0026 Image\",\"solution_label\":\"HighReach is an AI creative studio for turning ideas into production-ready images, videos, and audio. Generate, edit, and transform content with leading AI models and specialized tools, all in one simple workspace for creators, brands, and businesses.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/highreach-c3d072/logo_icon_imresizer.png\",\"niche_kws\":[\"Generate images\",\"videos\",\"and audio with leading AI models\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-31T00:39:08.958323+00:00\",\"id\":17905,\"codename\":\"Adviserry\",\"slug\":\"adviserry\",\"problem_label\":\"Adviserry gives you outcomes, not just content\",\"solution_label\":\"Adviserry give you outcomes, not just content. It reads newsletters and watches YouTube videos from the experts you follow, maps them to your goals, and delivers specific moves to take each week. Adviserry isn't a second brain that just stores what you remembered to capture. Adviserry brings you the moves you should be making on your projects this week, whether you captured it or not. It auto-ingests your subscriptions, builds a searchable archive, and remembers your work to sharpen advice over time. Get proactive daily digests and alerts, chat with your archive, and even query it from Claude Desktop or ChatGPT via MCP.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/adviserry/Advissery-Logo_no-text.png\",\"niche_kws\":[\"Knowledge Base\",\"Second Brain\",\"Productivity\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-31T14:38:06.125676+00:00\",\"id\":17923,\"codename\":\"TradingPal\",\"slug\":\"tradingpal\",\"problem_label\":\"Find the setup. See the track record.\",\"solution_label\":\"TradingPal finds wedges, trendlines, and consolidation breakouts across stocks, crypto, and ETFs—the same kinds of setups successful momentum swing traders have built strategies around. Every qualifying setup comes with its historical win rate, expected R, profit factor, and drawdown.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tradingpal/company-logo-512.png\",\"niche_kws\":[\"swing trading\",\"stock screener\",\"wedge pattern\",\"consolidation breakouts\",\"charting\",\"technical analysis\",\"backtesting\",\"crypto\",\"ETFs\",\"trendlines\",\"alerts\",\"market research\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-31T16:15:11.507699+00:00\",\"id\":17926,\"codename\":\"File Changer\",\"slug\":\"filechanger\",\"problem_label\":\"Change The Format Of Your Files However You Want\",\"solution_label\":\"FileChanger is a file conversion API that actually speaks technical formats. Convert Typst, Org-mode, AsciiDoc, DocBook, Jira markup, LaTeX, reStructuredText and Markdown in any direction, plus DOCX, PDF, EPUB, images, audio and video, across 40+ formats. One POST with a from and to format returns the converted bytes, no SDK to learn. Large files run as async jobs, and a built-in MCP server lets AI agents convert files for you.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/filechanger/filechanger-logo-128.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-31T17:49:19.899424+00:00\",\"id\":17929,\"codename\":\"AutomateNow\",\"slug\":\"automatenow\",\"problem_label\":\"Automate invoice recovery with built-in human approval control.\",\"solution_label\":\"AutomateNow connects n8n directly to QuickBooks, Xero, and FreshBooks to audit past-due receivables automatically. The engine categorizes aging invoices by urgency, triggering polite nudges or firm notices. For high-dollar or sensitive accounts, an interactive Human-in-the-Loop Wait Node emails owners a tap-to-approve gate before sending follow-ups to clients. Reclaim your trapped capital, eliminate weekly collection admin, and keep 100% operational control. Purchase turnkey blueprints at AutomateNow.app.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/automatenow/automatenowlogovector.png\",\"niche_kws\":[\"n8n\",\"Accounts Receivable\",\"QuickBooks\",\"Xero\",\"Cash Flow\",\"Workflow Automation\",\"Finance\",\"Automation\",\"AI Agents\",\"B2B SaaS\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-07-31T20:49:54.733976+00:00\",\"id\":17932,\"codename\":\"morket\",\"slug\":\"morket\",\"problem_label\":\"AI-driven marketing for technical founders\",\"solution_label\":\"Automates marketing tasks for solo and small-team SaaS founders.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/morket/morket.png\",\"niche_kws\":[\"saas\",\"ai\",\"marketing automation\",\"product launch\",\"seo\",\"technical founders\",\"small teams\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-01T17:35:29.539225+00:00\",\"id\":17958,\"codename\":\"LandingBoost\",\"slug\":\"landingboost\",\"problem_label\":\"Find what stops your landing page from converting\",\"solution_label\":\"LandingBoost scans any SaaS landing page, compares clarity, relevance, trust, and action signals with revenue-backed references, and identifies the single highest-leverage edit to make first. \\n\\nFounders get page-grounded evidence, a prioritized fix, and a paste-ready prompt so they can improve the page, rescan it, and measure whether the conversion signal moved. It is built for SaaS founders, indie hackers, agencies, and small growth teams.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/landingboost/LB-logo-2.PNG\",\"niche_kws\":[\"Landing Pages\",\"Conversion Optimization\",\"CRO\",\"SaaS\",\"AI\",\"Marketing\",\"Copywriting\",\"A/B Testing\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-02T14:50:49.118179+00:00\",\"id\":17980,\"codename\":\"Fiuto\",\"slug\":\"fiuto\",\"problem_label\":\"All you need for user research. No experience required.\",\"solution_label\":\"Fiuto runs your full research loop: writes the study, runs it with AI testers and real people, and turns what happened into findings and a deck you can share.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fiuto/fiutoavatarteallight.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ui-ux\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-02T20:46:27.026581+00:00\",\"id\":17986,\"codename\":\"Seedance 2.0\",\"slug\":\"seedance20-01e6fe\",\"problem_label\":\"Seedance2.ai Has Moved to Seevio.ai\",\"solution_label\":\"Seedance2.ai has officially migrated to Seevio.ai. Continue using Seedance 2.0 to generate high-quality AI videos from text prompts, images, videos, and audio references. Existing users can access their accounts, subscriptions, credits, generation history, and support through Seevio.ai. Please update your bookmarks and use Seevio.ai for all future video creation and account management.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedance20-01e6fe/logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-04T02:00:15.515481+00:00\",\"id\":18018,\"codename\":\"OutReign\",\"slug\":\"outreign\",\"problem_label\":\"Find who to sell to. Then close them.\",\"solution_label\":\"OutReign is a comprehensive sales operations software designed to empower outbound B2B teams by streamlining the entire sales workflow, from ideal customer definition to personalized outreach. It serves as a modern, all-in-one alternative to traditional tools like Apollo, Instantly, Outreach, and Salesloft, specifically built to support founder-led sales operations and growth teams.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/outreign/outreign-logo-transparent.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-04T08:47:01.849201+00:00\",\"id\":18033,\"codename\":\"Smooth Bundle\",\"slug\":\"smoothbundle\",\"problem_label\":\"Publish assets once. Use them everywhere.\",\"solution_label\":\"Smooth Bundle is a developer-first platform for publishing, managing, optimizing, and delivering digital assets.\\n\\nUpload once, process automatically, organize versions and tags, protect sensitive files, and use the same assets across websites, mobile apps, CMS platforms, documentation, and other products.\\n\\nBuilt for solo developers, small frontend teams, and agencies that need something more reliable than a public folder, but less complicated than a full enterprise DAM.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/smoothbundle/logo.png\",\"niche_kws\":[\"Asset Management\",\"Developer Tools\",\"Image Optimization\",\"File Management\",\"CDN\",\"Cloud Storage\",\"API\",\"Media Management\",\"Digital Assets\",\"Versioning\",\"Asset Delivery\",\"Web Development\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-04T15:25:25.904456+00:00\",\"id\":18040,\"codename\":\"FindEvo\",\"slug\":\"findevo\",\"problem_label\":\"Find your first customers on Reddit without getting banned\",\"solution_label\":\"Reddit is full of founders describing the exact problem your product solves. FindEvo scans the subreddits that matter, scores every post by how close that person is to buying, and checks the rules of each community before you say anything. You get an intent score, a ban risk read, and a specific way to approach that one conversation. No generated messages. You write it in your own words.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/findevo/findevo-128x128.png\",\"niche_kws\":[\"reddit\",\"lead generation\",\"customer discovery\",\"indie hackers\",\"saas\",\"outreach\",\"intent scoring\",\"social listening\",\"founders\",\"marketing\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-04T16:10:24.13181+00:00\",\"id\":18042,\"codename\":\"Humanize Max\",\"slug\":\"humanizemax\",\"problem_label\":\"AI humanizer for natural text with best possible human-like result\",\"solution_label\":\"Humanize Max converts AI written text into humanized writing, which cannot be detected by any AI detection tools but maintains its readability and meaning. Best suited for students, marketers, bloggers, SEO experts, and organizations utilizing AI platforms such as ChatGPT, Claude, or Gemini.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/humanizemax/icon-128x128.png\",\"niche_kws\":[\"AI\",\"AI Writing\",\"Text Humanizer\",\"Humanize AI\",\"AI Detector\",\"Content Writing\",\"SEO\",\"Paraphrasing\",\"Copywriting\",\"Content Marketing\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-04T16:57:44.910503+00:00\",\"id\":18045,\"codename\":\"The Reflection\",\"slug\":\"thereflection\",\"problem_label\":\"AI roleplay training for growing teams, without enterprise cost\",\"solution_label\":\"Most corporate training platforms are built for large companies with dedicated L\u0026D teams. The Reflection brings the same AI roleplay simulations and knowledge base to teams of 3-20, without the setup time or enterprise price tag. New hires practice real sales calls, objection handling, and difficult conversations with an AI coach that gives structured feedback after every session, using a knowledge base built from your own docs and playbooks. Live within 24 hours, from €350/month.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/thereflection/TheReflection_io.png\",\"niche_kws\":[\"AI \u0026 Assistants\",\"AI Roleplay\",\"AI Coach\",\"Sales Training\",\"Leadership Development\",\"Onboarding\",\"Team Training\",\"L\u0026D\",\"Corporate Training\",\"Employee Training\"],\"icp_kws\":[],\"market\":\"hr-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-04T23:30:59.123773+00:00\",\"id\":18053,\"codename\":\"Ad Corrector\",\"slug\":\"adcorrector\",\"problem_label\":\"Test clarity and visibility of outdoor ad creative.\",\"solution_label\":\"Ad Corrector helps you review billboard and outdoor ad creative for clarity, visibility, and impact. Upload your design and get a quick visual check showing what stands out, what gets overlooked, and how your ad reads at real-world viewing distance. Built for advertisers, designers, and brands who want outdoor ads that communicate clearly and perform in fast-moving environments.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/adcorrector/IMG_4625.png\",\"niche_kws\":[\"Outdoor ad testing\",\"Billboard ad testing\",\"OOH ad testing\",\"Outdoor advertising testing\",\"Billboard readability\",\"Billboard clarity\",\"Billboard viewability\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-05T13:43:29.217734+00:00\",\"id\":18086,\"codename\":\"Minimax h3\",\"slug\":\"minimaxh3\",\"problem_label\":\"2K AI video with native sound and instruction-based editing\",\"solution_label\":\"MiniMax H3 is an AI video generator combining multimodal understanding, 2K resolution, native audio, and instruction-based editing in one model.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/minimaxh3/favicon-96x96.png\",\"niche_kws\":[\"ai video\",\"video\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-05T20:06:56.656477+00:00\",\"id\":18095,\"codename\":\"JaxSuite\",\"slug\":\"jaxsuite\",\"problem_label\":\"AI cold outreach and CRM for startups\",\"solution_label\":\"JaxSuite is an AI-native cold outreach and CRM platform that helps startups land their first 100 customers without hiring an SDR team. Launch campaigns in under 15 minutes, reach 300M+ verified B2B contacts, and average 42% open rates with built-in warmup and spam testing. MCP-native: Claude and other AI agents can run your entire outbound motion. Startups get 50% off their first year.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/jaxsuite/jaxsuite-logo-128.png\",\"niche_kws\":[\"cold email\",\"sales automation\",\"AI agents\",\"MCP\",\"CRM\",\"email deliverability\",\"B2B leads\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-05T21:39:07.281256+00:00\",\"id\":18098,\"codename\":\"Tradoshi\",\"slug\":\"tradoshi\",\"problem_label\":\"The trading journal that shows what your habits cost.\",\"solution_label\":\"Tradoshi is a trading journal that turns your trades into decisions.\\nConnect one broker account for free, forever, no card, or just drop in\\na statement. You get your real risk per trade, R-multiple, expectancy\\nand drawdown, an Oshi Score that rates your discipline, a pre-session\\ncheck-in that flags the days you shouldn't trade, and an AI coach that\\nnames the habits costing you money.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tradoshi/tradoshi-logo-128.png\",\"niche_kws\":[\"trading journal\",\"trading\",\"risk management\",\"prop firm\",\"trading psychology\",\"broker sync\",\"analytics\",\"fintech\",\"discipline\",\"AI coach\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-06T03:28:48.762496+00:00\",\"id\":18101,\"codename\":\"AIGenTools\",\"slug\":\"aigentools\",\"problem_label\":\"All-in-one AI platform for chat, image, video \u0026 audio\",\"solution_label\":\"AIGenTools is an AI platform for chat, image, video, and audio creation, powered by the latest models from the major AI labs. Chat with leading models, generate and edit images, and create video and audio — with new models added as they launch. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aigentools/logo.png\",\"niche_kws\":[\"AI Image Generator\",\"AI Video Generator\",\"AI Chat\",\"AI Audio Generator\",\"Multimodal AI Platform\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-06T12:35:17.984253+00:00\",\"id\":18115,\"codename\":\"VirtuProbe Studio\",\"slug\":\"virtuprobestudio\",\"problem_label\":\"Testing workbench with multi-protocol support, chaining, scripting and MCP Server.\",\"solution_label\":\"Cross-protocol request workbench for integration and penetration testing. 11 protocols, local-first, no account needed. Put your tests together on your own or supervise your agent helping you achieve your goals via MCP. Chain your tests or script your scenarios in JS or Groovy. Free tier covers HTTP, DNS and SMTP testing.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/virtuprobestudio/logodagger256.png\",\"niche_kws\":[\"request manager\",\"http\",\"smtp\",\"imap\",\"ldap\",\"dns\",\"smb\",\"kerberos\",\"spamd\",\"mysql\",\"spamassassin\",\"mongodb\",\"postgresql\",\"testing\",\"qa\",\"automation\",\"mcp\",\"integration\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-06T13:37:37.366927+00:00\",\"id\":18117,\"codename\":\"GoldMine\",\"slug\":\"goldmine\",\"problem_label\":\"Autonomous AI marketing agent for solopreneurs and small teams\",\"solution_label\":\"GoldMine AI is an autonomous online marketing agent designed for solopreneurs and small teams. It acts as a dedicated business brain—your \\\"Cortex\\\"—that learns and adapts to your marketing needs over time.\\n\\nRather than managing every detail manually, you focus on high-level decisions: approving recommendations, providing feedback, and making strategic choices. The AI handles the execution of campaigns, optimization, and ongoing learning from results.\\n\\nIdeal for founders and lean teams looking to scale their marketing without hiring a full in-house team.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/goldmine/goldmyne-logo-light.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-06T14:11:24.474659+00:00\",\"id\":18119,\"codename\":\"MenuForma \",\"slug\":\"menuforma\",\"problem_label\":\"QR Menu \u0026 Online Ordering\",\"solution_label\":\"Turn any menu into a QR ordering system with multilingual support and Google review collection\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/menuforma/logo_square_640.png\",\"niche_kws\":[\"AI\",\"Restaurant Technology\",\"SaaS\",\"Digital Menu\",\"QR Code Menu\",\"Online Ordering\",\"Food Tech\",\"No-Code\",\"Automation\",\"Multilingual\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-08T08:47:26.460346+00:00\",\"id\":18158,\"codename\":\"Gambling_Degen\",\"slug\":\"gamblingdegen\",\"problem_label\":\"Sports predictions from 10,000 simulations, not gut feel\",\"solution_label\":\"NexGame Lite runs 10,000 Monte Carlo simulations per game to generate win probabilities and player prop projections across MLB, WNBA, and CS2. Built-in NexBet compares model output against de-vigged Kalshi market pricing to surface real edges. Every prediction is publicly tracked and verified on Veri.bet — no cherry-picked results. Free daily pick via newsletter, paid tiers unlock full slates and player props.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/gamblingdegen/nexgame_lite_icon.png\",\"niche_kws\":[\"sports analytics\",\"sports betting\",\"prediction markets\",\"monte carlo simulation\",\"mlb\",\"wnba\",\"csgo\",\"kalshi\",\"sports predictions\",\"data analytics\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-08T15:30:43.894068+00:00\",\"id\":18164,\"codename\":\"LightningApply\",\"slug\":\"lightningapply\",\"problem_label\":\"Land more interviews, in a flash.\",\"solution_label\":\"Applying to 20 jobs shouldn't mean writing 20 resumes. Paste any job posting and LightningApply gives you a tailored resume and cover letter in minutes, formatted, polished, and ready to send.\\n\\nIt works from your real experience, so nothing gets invented and no job title you never held ends up on the page. Pick from different layouts and color themes, edit anything, and restyle without starting over.\\n\\nAny industry, any role.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lightningapply/favicon-no-bg.png\",\"niche_kws\":[\"Resume Builder\",\"Cover Letter\",\"Job Search\",\"Job Application\",\"Career\",\"Job Hunting\",\"AI\",\"Productivity\",\"Resume\",\"SaaS\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-08T17:37:48.125627+00:00\",\"id\":18169,\"codename\":\"DobroDesk\",\"slug\":\"dobrodesk\",\"problem_label\":\"Support inbox with AI replies and no seat fees\",\"solution_label\":\"Email and website chat in one support inbox. DobroDesk uses a project's FAQ and help docs to draft replies or automatically handle simple repeated questions. People take over when a conversation needs context or judgment.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/dobrodesk/logo-mark.png\",\"niche_kws\":[\"AI\",\"Customer support\",\"Knowledge base\",\"Cloudflare\",\"Shared inbox\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-08T17:39:48.416572+00:00\",\"id\":18170,\"codename\":\"Invent\",\"slug\":\"invent\",\"problem_label\":\"Every channel, one AI brain, a tenth of the price.\",\"solution_label\":\"Invent turns your customer operation into one AI brain. Build a no-code assistant that answers from your data, then put it on WhatsApp, Instagram, web chat, SMS, and every channel you use, all flowing into one inbox. It remembers every customer, hands tricky conversations to your team, and sends broadcasts that sell. Pick your AI model and swap anytime. Setup takes minutes, plans start free, and pricing runs a tenth of Intercom's.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/invent/frame-375434.png\",\"niche_kws\":[\"AI Assistant\",\"AI Agent\",\"Chatbot\",\"Customer Support\",\"No-Code\",\"Automation\",\"WhatsApp\",\"Customer Service\",\"SaaS\",\"Omnichannel\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-09T13:30:21.716212+00:00\",\"id\":18196,\"codename\":\"SEObeast\",\"slug\":\"seobeast\",\"problem_label\":\"Your 24/7 AI SEO content team\",\"solution_label\":\"SEOBeast automates your SEO from keyword research to published, search optimized articles. Create and publish content consistently, discover backlink exchange opportunities, and connect Google Search Console to track performance and uncover new growth opportunities. Built for startups and businesses that want to grow organic traffic without spending hours managing SEO.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seobeast/logo-icon.png\",\"niche_kws\":[\"SEO\",\"Content Marketing\",\"Blogging\",\"SEO Automation\",\"Keyword Research\",\"Backlinks\",\"Google Search Console\",\"Organic Traffic\",\"Content Creation\",\"Marketing Automation\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-10T08:10:46.807067+00:00\",\"id\":18211,\"codename\":\"MInimax H3\",\"slug\":\"minimaxh3-b4a6b7\",\"problem_label\":\"Create cinematic AI videos from text and media\",\"solution_label\":\"Minimax H3 AI Video Generator helps creators, marketers, designers, and ecommerce teams generate short 2K AI videos from text prompts, images, video clips, audio, and first or last frame references.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/minimaxh3-b4a6b7/logo_h3.png\",\"niche_kws\":[\"AI video\",\"text to video\",\"image to video\",\"video generator\",\"creator tools\",\"marketing videos\",\"social media content\",\"ecommerce video\",\"cinematic AI\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-10T08:13:29.504884+00:00\",\"id\":18212,\"codename\":\"LumiMusic\",\"slug\":\"lumimusic\",\"problem_label\":\"Create any music you can imagine.\",\"solution_label\":\"LumiMusic is an all-in-one AI music creation platform that transforms your ideas, text prompts, or lyrics into complete vocal and instrumental tracks—no production experience required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lumimusic/logo.png\",\"niche_kws\":[\"AI Music Generator\",\"AI Song Maker\",\"AI Music Remixer\",\"AI Song Cover\",\"AI Vocal Remover\",\"AI Stem Splitter\",\"AI Lyrics Generator\"],\"icp_kws\":[],\"market\":\"music\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-10T18:28:35.816669+00:00\",\"id\":18229,\"codename\":\"Storage Donut\",\"slug\":\"storagedonut\",\"problem_label\":\"One app. Any S3 storage.\",\"solution_label\":\"Your files belong to you. Not your storage provider.\\n\\nStorage Donut brings Cloudflare R2, Amazon S3 and more into one cloud drive. \\n\\nBrowse every bucket in one place, move files between providers, share them with anyone, stream audio and video, edit Markdown, view spreadsheets and manage your storage from anywhere.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/storagedonut/Donut-white-background.webp\",\"niche_kws\":[\"S3\",\"Cloud Storage\"],\"icp_kws\":[],\"market\":\"cloud\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-11T21:39:03.852161+00:00\",\"id\":18259,\"codename\":\"Statable\",\"slug\":\"statable\",\"problem_label\":\"Cookieless web analytics hosted in the EU\",\"solution_label\":\"Statable is cookieless web analytics for people who want clear numbers without the compliance overhead. No cookies means no consent banner, so you count every visitor instead of only those who click Accept. The tracker is about 2.1 KB, with a 471-byte build. Data is processed in the EU by a Dutch company. Plans start at $9/month for 10,000 pageviews, pooled across unlimited websites rather than charged per site.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/statable/logo-128.png\",\"niche_kws\":[\"analytics\",\"web analytics\",\"privacy\",\"gdpr\",\"cookieless\",\"saas\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-12T16:46:37.944321+00:00\",\"id\":18276,\"codename\":\"Clatree\",\"slug\":\"clatree\",\"problem_label\":\"Know the moment your checkout breaks.\",\"solution_label\":\"Clatree provides continuous, automated testing of your entire e-commerce checkout process, simulating real customer behavior around the clock. This ensures that every step, from adding items to the cart through to the final place-order button, is functioning correctly.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/clatree/clatree_logo_main_bg.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-12T16:47:42.573134+00:00\",\"id\":18277,\"codename\":\"find-right-plugin\",\"slug\":\"findrightplugin\",\"problem_label\":\"Find the right plugin in 60 seconds\",\"solution_label\":\"Find Right Plugin is a free quiz that matches you to WordPress and Jira plugins based on your actual problem and role — not a generic top 10 list. Answer a few quick questions and get a ranked shortlist across 9 WordPress categories and 66 plugins, with honest free-tool picks shown alongside paid ones, and every affiliate link disclosed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/findrightplugin/findrightplugin-icon-512.png\",\"niche_kws\":[\"\\\"WordPress\\\"\",\"\\\"WordPress Plugin Finder\\\"\",\"\\\"Jira Plugin Finder\\\"\",\"\\\"Quiz Based Plugin Finder\\\"\",\"\\\"WordPress Plugin Recommendations\\\"\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-13T01:48:22.341171+00:00\",\"id\":18287,\"codename\":\"witspeak\",\"slug\":\"witspeak\",\"problem_label\":\"AI English speaking coach with instant feedback\",\"solution_label\":\"WitSpeak is an AI English speaking coach for iPhone and Android that helps learners build real spoken fluency. You answer everyday conversation and IELTS-style prompts out loud, then get instant AI feedback on fluency, vocabulary, grammar, and pronunciation, plus a stronger example answer to study. With 70+ roleplay scenarios, live AI speaking sessions, pronunciation coaching, and a personalized practice plan, WitSpeak makes daily speaking practice possible anytime, anywhere. Built by ZenithNexus AI.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/witspeak/ChatGPT-Image-Jul-24-2026-05_21_07-PM.png\",\"niche_kws\":[\"English speaking practice\",\"IELTS speaking\",\"AI feedback\",\"Pronunciation coaching\",\"Language learning\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-13T15:35:02.428827+00:00\",\"id\":18302,\"codename\":\"CrawlPanel\",\"slug\":\"crawlpanel\",\"problem_label\":\"Know if your website works, not just if it’s online.\",\"solution_label\":\"CrawlPanel monitors more than whether your website is online. Track uptime and APIs, then run real browser journeys through critical flows like forms, logins, carts and checkout. When something breaks, CrawlPanel shows you the exact failed step, screenshot and technical context you need to investigate quickly. Built for developers, freelancers and agencies managing websites where “up” doesn’t always mean “working.”\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/crawlpanel/763018604_122105681589416267_8943064168006143257_n.jpg\",\"niche_kws\":[\"website monitoring\",\"uptime monitoring\",\"synthetic monitoring\",\"API monitoring\",\"browser monitoring\",\"website testing\",\"checkout monitoring\",\"form monitoring\",\"developer tools\",\"agency tools\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-13T22:36:46.562923+00:00\",\"id\":18311,\"codename\":\"LemonSugar Ai\",\"slug\":\"lemonsugarai\",\"problem_label\":\"Your AI tutor that remembers your weak spots\",\"solution_label\":\"LemonSugar Ai is a personalized AI tutor for students. Snap a homework problem, type a question, or ask by voice to get step-by-step explanations in your language and preferred learning style. It then creates custom quizzes, tracks weak spots, schedules review before exams, and supports test prep. Students can start free, with a paid plan for higher limits and advanced study features.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/lemonsugarai/lemonsugar-icon-128.png\",\"niche_kws\":[\"AI tutor\",\"Education\",\"Study assistant\",\"Homework help\",\"Exam prep\",\"Personalized learning\",\"Flashcards\",\"Multilingual\",\"Students\",\"EdTech\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-14T07:33:29.05155+00:00\",\"id\":18325,\"codename\":\"Chartsy\",\"slug\":\"chartsy\",\"problem_label\":\"Find out which marketing channels drive your revenue\",\"solution_label\":\"Chartsy helps you see which marketing channels impact your MRR, churn and more.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/chartsy/Chartsy-Logo-Square.png\",\"niche_kws\":[\"revenue analytics\",\"subscription analytics\",\"mrr breakdown\",\"AI-powered charts\",\"daily business briefing\",\"track churn rate\",\"subscription analytics\",\"custom dashboard\",\"custom reports\",\"mrr goals\",\"marketing channels\",\"Stripe and Paddle integrations\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-14T10:35:40.433351+00:00\",\"id\":18333,\"codename\":\"Tailero\",\"slug\":\"tailero\",\"problem_label\":\"Everything you need to get back to work.\",\"solution_label\":\"Tailero is a free career toolkit designed to help people move from job loss to their next opportunity. Create professional CVs, cover letters and career documents, follow practical Restart guidance after losing a job, and get country-specific resources for your job search. Tailero brings the essential tools and next steps into one place, helping you understand what to do next and get back to work faster.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tailero/LogoTailero3.png\",\"niche_kws\":[\"Job Search\",\"Career\",\"Resume Builder\",\"CV Builder\",\"Cover Letter\",\"Career Tools\",\"Job Loss\",\"Career Restart\",\"Resume Templates\",\"AI Career Tools\"],\"icp_kws\":[],\"market\":\"hr-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-14T12:08:42.823748+00:00\",\"id\":18334,\"codename\":\"Qwelto\",\"slug\":\"qwelto\",\"problem_label\":\"Pick what you like. Qwelto builds the rest.\",\"solution_label\":\"Qwelto helps you make a logo and matching brand assets without writing design prompts. Start with a set of visual options and pick the ones that feel closest to what you want. Qwelto learns from those choices and uses the same direction for banners, website cards and social posts. Logos are free to create and download. The $29 Founder Pass unlocks the rest of the brand kit.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/qwelto/qwelto-logo-128.png\",\"niche_kws\":[\"logo maker\",\"brand identity\",\"visual design\",\"AI design\",\"branding\",\"banner maker\",\"social media design\",\"no prompt\",\"founder tools\",\"small business\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-14T13:12:34.112757+00:00\",\"id\":18336,\"codename\":\"WZRD\",\"slug\":\"wzrd\",\"problem_label\":\"AI workspace for creating interactive, voice-enabled documents, forms, slides, and business experiences\",\"solution_label\":\"WZRD is an AI workspace for creating interactive slides, documents, sheets, forms, proposals, and business experiences. Users describe an outcome in natural language, and WZRD generates structured content that can include AI guidance, voice interactions, questions, explanations, responses, signatures, file collection, and engagement tracking. It helps turn static documents and forms into conversational, guided experiences that can be published, shared, embedded, and measured without code.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wzrd/IMG_8423.png\",\"niche_kws\":[\"AI Presentation Generator\",\"AI Documents Generator\",\"AI Forms\",\"AI Voice Assistants\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-14T19:51:39.192385+00:00\",\"id\":18348,\"codename\":\"Mora\",\"slug\":\"mora\",\"problem_label\":\"Your 1:1s, prepped and remembered — automatically\",\"solution_label\":\"Mora drafts your 1:1 agenda before every meeting, keeps private notes during, and writes the recap after — so nothing gets lost between one conversation and the next. No account needed for your reports. Opening access Sept 2026.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/mora/Logo.png\",\"niche_kws\":[\"people management\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-15T02:18:26.01663+00:00\",\"id\":18355,\"codename\":\"Custodian Labs Python SDK\",\"slug\":\"custodian-labs-python-sdk\",\"problem_label\":\"Deploy secure AI-agents in minutes.\",\"solution_label\":\"Fastest way to deploy AI-agents, securely.\\n\\nCustodian Labs makes it easy to connect leading AI models, add your own data, and launch single or multi-agent workflow, without complex infrastructure or compromising sensitive data.\\n\\n⚡ Go from prototype to deployment in minutes\\n🤖 Connect different AI models without vendor lock-in\\n🔒 Protect private data with our proprietary Guardian Layer algorithm without compromising AI effectiveness\\n🇳🇿 Supported by New Zealand Government funding\\n\\nBuild faster. Protect sensitive data. Deploy AI with confidence.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/custodianlabspythonsdk/Custodian-Webclip.png\",\"niche_kws\":[\"AI-agents\",\"Security\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-15T17:57:04.201679+00:00\",\"id\":18374,\"codename\":\"TickClip: Buyer-First AI Shopping Assistant | Buy, Wait or Skip\",\"slug\":\"projectfiduciary\",\"problem_label\":\"TickClip is the buyer-first AI shopping assistant that checks price history, product signals, and seller risk before you spend.\",\"solution_label\":\"TickClip is an AI-powered shopping decision platform designed to protect consumers rather than push them toward a purchase. Instead of simply recommending products, TickClip analyzes factors such as price history, deal quality, product value, seller credibility, reviews, alternatives, and market signals to deliver a clear Tick, Clip, Skip\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/projectfiduciary/IMG_7309.png\",\"niche_kws\":[\"AI\",\"Artificial Intelligence\",\"e-commerce\",\"shopping assistant\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-16T08:17:03.332344+00:00\",\"id\":18386,\"codename\":\"Omphalis\",\"slug\":\"omphalis-3db412\",\"problem_label\":\"The center of your understanding\",\"solution_label\":\"Articles, podcasts, videos and PDFs come in messy. They come out as one calm page with the structure made visible.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/omphalis-3db412/omphalis-logo-512.png\",\"niche_kws\":[\"reading\",\"podcasts\",\"research\",\"knowledge-management\",\"pocket-alternative\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-16T10:22:47.430434+00:00\",\"id\":18391,\"codename\":\"FAQ Hub\",\"slug\":\"faqhub\",\"problem_label\":\"Turn your docs into grounded AI customer support.\",\"solution_label\":\"FAQ Hub turns scattered product knowledge into reliable, customer-ready support. Import PDFs, DOCX files, Markdown, or website content, then review and approve what goes live. Customers get grounded answers through AI chat, an inline help portal, or a hosted help centre. When sources cannot support an answer, FAQ Hub stops safely and hands the conversation to a human. Built for founders and lean SaaS teams, with simple, predictable monthly pricing.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/faqhub/Square_Logo_240.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-16T10:58:24.045251+00:00\",\"id\":18392,\"codename\":\"ShieldLabs\",\"slug\":\"shieldlabs\",\"problem_label\":\"Fraud detection and prevention with traffic quality scoring\",\"solution_label\":\"Fraud detection and prevention with traffic quality scoring, using visitor identification and anonymity detection with up to 99% accuracy. Stops multi-accounting, account sharing, fake signups and ad fraud.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/shieldlabs/ShieldLabs-logo-128.png\",\"niche_kws\":[\"fraud prevention\",\"visitor identification\",\"anonymity detection\",\"vpn detection\",\"proxy detection\",\"Bot detection\",\"Ai agent detection\",\"anti-detect browser detection\",\"traffic analytics\",\"api\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-17T01:02:42.752047+00:00\",\"id\":18410,\"codename\":\"Image to 3D AI\",\"slug\":\"imageto3dai\",\"problem_label\":\"Convert Text \u0026 Images to High-Quality 3D Models in Seconds.\",\"solution_label\":\"Image to 3D AI lets you generate high-quality 3D models from images or text in seconds. Free, fast, and perfect for dev, model designer.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/imageto3dai/logo.png\",\"niche_kws\":[\"image to 3d model\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-18T08:32:07.747108+00:00\",\"id\":18442,\"codename\":\"Telvio\",\"slug\":\"telvio\",\"problem_label\":\"Cheap international calls, no roaming, no sign-up\",\"solution_label\":\"Calling an ordinary phone number in another country is still a rip-off. Telvio is a small iPhone app for cheap international calls to real landlines and mobiles over WiFi or data - the other side just answers their normal phone, no app needed. There is no sign-up at all: no email, no password. You buy minutes once, they never expire, billing is per second, and the first minute is free.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/telvio/android.png\",\"niche_kws\":[\"voip\",\"international-calls\",\"calling-app\",\"no-signup\",\"ios-app\",\"expats\",\"travel\",\"roaming\",\"prepaid\",\"telephony\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Mobile App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-18T08:47:11.72071+00:00\",\"id\":18443,\"codename\":\"Fanout\",\"slug\":\"fanout\",\"problem_label\":\"Fanout: Daily-mapped AI learning, from theory to practical labs\",\"solution_label\":\"Fanout organizes advanced learning across AI research, system design, and ML math into clear, connected roadmaps. It combines daily papers, labs, and explanations to help engineers turn complex theory into practical, production-ready skills\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/fanout/logo.png\",\"niche_kws\":[\"ai-learning-roadmap\",\"ml-math-curriculum\",\"systems-research-hub\"],\"icp_kws\":[\"ai-education\",\"ml-engineering\",\"systems-architecture\",\"robotics-learning\",\"technical-upskilling\"],\"market\":\"edtech\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-18T11:20:11.341783+00:00\",\"id\":18447,\"codename\":\"Structura\",\"slug\":\"structura-e4187d\",\"problem_label\":\"Publish 3 SEO-optimized blog posts a day, hands-off \",\"solution_label\":\"Structura runs the whole publishing lifecycle unattended: research, strategy, writing, authority links, images, a 20+ point SEO protocol, and publishing. Output is real Gutenberg blocks, not pasted HTML. Publishes to WordPress natively or to any stack via a Content API.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/structura-e4187d/b1c66b81-b4eb-4437-877c-149202ac244e.jpg\",\"niche_kws\":[\"Publish 3 SEO-optimized blog posts a day\",\"hands-off\"],\"icp_kws\":[],\"market\":\"no-code\",\"product_type\":\"Saas\",\"offer_type\":\"Lifetime deal\",\"stage\":\"idea\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-18T18:40:04.387752+00:00\",\"id\":18452,\"codename\":\"Codag AI\",\"slug\":\"codag-ai\",\"problem_label\":\"Slash coding-agent costs—one command, same dev workflow.\",\"solution_label\":\"Codag reduces coding-agent token costs by compacting noisy tool output into only the critical lines your AI needs. It attaches to Claude Code and Codex with one command, preserving existing workflows while delivering around 75% context comp\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/codag-ai/logo.png\",\"niche_kws\":[\"context-compressor\",\"coding-agent-middleware\",\"token-spend-optimizer\"],\"icp_kws\":[\"dev-tools\",\"ai-ops\",\"developer-productivity\",\"llm-engineering\",\"cost-optimization\"],\"market\":\"dev-tools\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-18T18:41:15.414903+00:00\",\"id\":18453,\"codename\":\"Straitly AI\",\"slug\":\"straitly-ai\",\"problem_label\":\"143 models, zero markup—plus 30% off starting now.\",\"solution_label\":\"Straitly unifies access to 140+ LLMs behind one OpenAI-compatible API with zero token markup. It automatically routes requests for better uptime, latency, and cost while enforcing zero data retention and SOC 2 Type II controls for productio\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/straitly-ai/logo.png\",\"niche_kws\":[\"llm aggregation\",\"multi-provider api\",\"ai inference gateway\"],\"icp_kws\":[\"developer apis\",\"ai infrastructure\",\"llm routing\",\"enterprise security\",\"cost optimization\"],\"market\":\"dev-tools\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-19T10:42:59.511985+00:00\",\"id\":18474,\"codename\":\"aelívra\",\"slug\":\"aelivra\",\"problem_label\":\"A personal wellbeing platform that guides you on your path to feeling better, for people whose health problems don't have an easy answer - one that moves with your life, notices which parts are actually helping, and helps you feel better faster.\",\"solution_label\":\"Nourishment\\nPersonalised goodness recipes guiding you through all health needs.\\n\\nSymptoms\\nEffortless symptom tracking, say goodbye to manual logging.\\n\\nMovement\\nGuided movement and exercises routines that heal your soul, and your body.\\n\\nBiomarkers\\nBiomarker lab result tracking and insights across your key health markers.\\n\\nMindfulness\\nGuided meditations across breathwork, mindfulness, sleep, and relaxation.\\n\\nWearables \u0026 Records\\nYour whole health picture dynamically shaping your plan.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aelivra/48adc0f2-c6d5-455d-ae56-6ee5d8b355a9.jpg\",\"niche_kws\":[\"A personal wellbeing platform that guides you on your path to feeling better.\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-19T13:19:58.480023+00:00\",\"id\":18478,\"codename\":\"KleoKlaw\",\"slug\":\"kleoklaw\",\"problem_label\":\"Your iMessage AI that finds jobs and customizes resumes\",\"solution_label\":\"KleoKlaw is an AI job search agent that works entirely through iMessage, finding matching roles, tailoring your resume, and submitting applications you approve. It discovers positions on supported employer systems, manages accounts securely\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/kleoklaw/logo-placeholder.png\",\"niche_kws\":[\"imessage job assistant\",\"ai job hunter\",\"automated job applier\"],\"icp_kws\":[\"job search\",\"career automation\",\"job hunting\",\"resume optimization\",\"recruiting tech\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-19T13:22:03.469611+00:00\",\"id\":18479,\"codename\":\"Monid AI\",\"slug\":\"monid-ai\",\"problem_label\":\"Live social insight, four feeds, one ultra‑cheap AI call\",\"solution_label\":\"Monid lets AI agents read TikTok, Instagram, Reddit, and YouTube live through one skill, bypassing login walls and captchas. It delivers structured social data on a per-look basis for a fraction of subscription listening costs, enabling con\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/monid-ai/logo.png\",\"niche_kws\":[\"agent connector\",\"social feed aggregator\",\"loginwall bypass\"],\"icp_kws\":[\"social listening\",\"api integrations\",\"growth marketing\",\"creator analytics\",\"agent infrastructure\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-19T14:51:44.483613+00:00\",\"id\":18485,\"codename\":\"HackathonHost\",\"slug\":\"hackathonhost\",\"problem_label\":\"Run your whole hackathon under your own brand — registration to certificates — for one flat price per event.\",\"solution_label\":\"HackathonHost is an all-in-one platform for running hackathons, demo days and team-based competitions — from registration to results. Organizers get one branded space to collect sign-ups, build teams, run judging against custom criteria, control the live event with timers and projector views, reveal results and rewards, and issue certificates with QR verification. Plus email broadcasts, surveys, exports and analytics. It runs white-label under your own brand and you pay $99 per event with no subscription.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hackathonhost/hackathonhost-app-icon-1024.png\",\"niche_kws\":[\"hackathon management\",\"event management\",\"hackathon platform\",\"team formation\",\"jury scoring\",\"participant registration\",\"submissions\",\"leaderboard\",\"certificates\",\"white label\",\"live-events\",\"mentoring\",\"check-in\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-20T10:05:47.961717+00:00\",\"id\":18519,\"codename\":\"Tuya AI Coding\",\"slug\":\"tuyaaicoding\",\"problem_label\":\"Build apps from ideas, with AI\",\"solution_label\":\"Tuya AI Coding is an AI-powered platform that turns natural language into fully functional, cloud-hosted apps. Simply describe what you want to build, and it generates working code in real time — supporting Web, H5, Mobile App, and Tuya Applet. With multiple leading AI models, production-ready templates, and conversational iteration, go from idea to live preview in minutes and refine through natural dialogue.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/tuyaaicoding/tuya-coding-logo.png\",\"niche_kws\":[\"AI App Builder\",\"No-Code\",\"Low-Code\",\"Prompt to App\",\"Cloud Development\",\"AI Code Generation\",\"Smart Home\",\"Rapid Prototyping\",\"Conversational Development\",\"Web App Builder\"],\"icp_kws\":[],\"market\":\"mvp-builders\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-20T10:57:48.132467+00:00\",\"id\":18520,\"codename\":\"LaunchPact\",\"slug\":\"launchpact\",\"problem_label\":\"Find support for your Product Hunt launch from fellow founders\",\"solution_label\":\"Match with founders who commit to supporting your launch — and actually follow through.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/launchpact/launchpact-logo-1200-white.png\",\"niche_kws\":[\"product-hunt\",\"launch\",\"founders\",\"indie-hackers\",\"accountability\",\"community\",\"growth\",\"marketing\",\"saas\",\"networking\",\"launch-day\",\"startup-tools\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-20T12:46:54.806615+00:00\",\"id\":18526,\"codename\":\"Simple Virtual Tour\",\"slug\":\"simplevirtualtour\",\"problem_label\":\"Unlimited 360° virtual tours: Self-hosted or Cloud.\",\"solution_label\":\"Create professional virtual tours with full flexibility and no limits 🚀 Choose Self-Hosted 🗄️ with a one-time payment for complete ownership and control, or Cloud hosting ☁️ for a ready-to-use managed solution. Build unlimited immersive tours through an intuitive backend designed for speed and simplicity. Extend your platform with AI tools, Google Street View export, and SaaS plugins to scale into a real virtual tour business.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/simplevirtualtour/logo.jpg\",\"niche_kws\":[\"Virtual Tour\",\"360°\",\"Panorama\",\"Real Estate\",\"Interactive\",\"Self-Hosted\",\"Cloud\",\"SaaS\",\"AI\",\"Photography\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-20T14:57:37.732548+00:00\",\"id\":18530,\"codename\":\"Kling 4 video generator\",\"slug\":\"kling4videogenerator\",\"problem_label\":\"Create Cinematic Video from Text \u0026 Images\",\"solution_label\":\"Turn text or images into multi-shot, cinematic video — with director-grade control, physically real motion, native audio, and consistent characters across shots. Powered by the newest Kling AI model. Free to try, no account needed.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/kling4videogenerator/180x180.png\",\"niche_kws\":[\"Kling 4.0\",\"Kling 4.0 AI Video Generator\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-20T15:06:40.792192+00:00\",\"id\":18531,\"codename\":\"Legal Templates\",\"slug\":\"legal-templates\",\"problem_label\":\"Free, attorney-crafted legal templates you can use anywhere.\",\"solution_label\":\"General Legal’s GitHub repository provides attorney-drafted legal templates for startups and tech companies, in Markdown and .docx, under a CC0 license. It covers core contracts like NDAs, DPAs, privacy policies, and MSAs so teams can launc\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/legal-templates/logo.png\",\"niche_kws\":[\"startup contracts\",\"privacy agreements\",\"hipaa documentation\"],\"icp_kws\":[\"legaltech\",\"startups\",\"compliance\",\"contracts\",\"opensource\"],\"market\":\"oss\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-20T16:58:23.315058+00:00\",\"id\":18535,\"codename\":\"ReplyHey\",\"slug\":\"replyhey\",\"problem_label\":\"Get Customers from Reddit on Autopilot\",\"solution_label\":\"Automate your Reddit, X and LinkedIn Marketing\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/replyhey/icon.png\",\"niche_kws\":[\"Marketing automation\",\"outreach automation\",\"lead generation\",\"social selling\",\"AI agent\",\"Reddit marketing\",\"social listening\",\"growth automation\",\"customer acquisition\",\"MCP\",\"browser extension\",\"brand monitoring\",\"LinkedIn automation\",\"X automation\",\"founder tools\",\"SaaS marketing\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-20T17:20:21.646779+00:00\",\"id\":18537,\"codename\":\"Recoura\",\"slug\":\"recoura\",\"problem_label\":\"Recover the revenue your payment processor gave up on\",\"solution_label\":\"Recoura offers manual and automatic recovery of failed payments for revenue that Stripe and Square give up on. It includes custom email templates, multi-currency support, custom recovery sequences, an AI recovery assistant (optional AI generated recovery emails, tailored to your business), and analytics to help with recovery campaigns. It supports failed payments across invoices, subscriptions, and one-off payments, and is one of the few recovery tools supporting Square.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/recoura/icon-512.png\",\"niche_kws\":[\"Revenue recovery\",\"Failed payment recovery\",\"AI recovery assistant\",\"Stripe\",\"Square\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-21T05:04:12.834471+00:00\",\"id\":18545,\"codename\":\"Ripn\",\"slug\":\"ripn\",\"problem_label\":\"Track grocery spending and food waste from receipts\",\"solution_label\":\"Ripn is a grocery tracking app that turns receipts into spending data. Take a photo of your receipt and Ripn automatically reads the items, prices, categories, and dates. See where your grocery money goes, keep track of what may expire, and record what you throw away. It helps you understand both how much you spend on groceries and how much of that money ends up wasted.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/ripn/Ripn-1024-x-2000-px-.png\",\"niche_kws\":[\"Grocery Tracking\",\"Receipt Scanner\",\"Expense Tracking\",\"Personal Finance\",\"Grocery Budget\",\"Food Waste\",\"Spending Tracker\",\"Receipt Scanning\",\"Grocery Spending\",\"Food Management\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-22T11:06:31.847118+00:00\",\"id\":18597,\"codename\":\"GoRules\",\"slug\":\"gorules\",\"problem_label\":\"Business logic humans can read and machines can run\",\"solution_label\":\"Every company keeps two copies of its business logic: a document people read and code that runs. They drift. GoRules keeps one copy. Rules read like sentences, live in visual graphs or policy documents, and ship with reviews, releases, and tests. The open-source ZEN engine (MIT, Rust) answers your API, your agents, and your batch jobs in about 10 microseconds. An AI copilot builds and explains rules; people release. Cloud, self-hosted, or embedded.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/gorules/web-app-manifest-512x512.png\",\"niche_kws\":[\"business rules engine\",\"rules engine\",\"expression language\",\"saas\",\"automation\",\"natural language\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-24T06:15:45.937551+00:00\",\"id\":18647,\"codename\":\"Viraldrop \",\"slug\":\"viraldrop\",\"problem_label\":\"Turn every viral video into your unfair advantage\",\"solution_label\":\"Converts a link to any public TikTok, Reels, or YouTube Shorts video into a transcript, an explanation of why the video went viral, and a rewritten script adapted to a different brand's voice.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/viraldrop/ViralDrop_Logo_1.jpg\",\"niche_kws\":[\"ai\",\"content\",\"transcription tool\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-24T09:48:56.358031+00:00\",\"id\":18656,\"codename\":\"Hushscript\",\"slug\":\"hushscript\",\"problem_label\":\"Privacy-first, pay-as-you-go transcription\",\"solution_label\":\"Hushscript is privacy-first, audio and video transcription service without a subscription. Video stays on your device, audio isn't kept after processing, and transcripts are stored encrypted. Free speaker identification with labels, AI insights, and transcript cleanup. Transcribe in 99 languages with top-tier accuracy, and handle specialist recordings with dictionaries, keyterms, custom prompts, medical mode, and multichannel support. Translate the result and export it in 21 formats.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hushscript/avatar-512.png\",\"niche_kws\":[\"audio transcription\",\"video transcription\",\"transcription\",\"speech to text\",\"video to text\",\"audio to text\",\"pay-as-you-go\",\"speaker diarization\",\"speaker identification\",\"productivity\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-24T10:23:58.758635+00:00\",\"id\":18660,\"codename\":\"Strew Home Ed Tracking App\",\"slug\":\"strewhomeedtrackingapp\",\"problem_label\":\"The easy way to document home education.\",\"solution_label\":\"Strew is a simple home education app that helps parents capture learning without the paperwork. Quickly log activities, projects, books, trips and everyday moments, while optional AI identifies learning outcomes and helps organise your records. Over time, Strew builds a clear picture of your child’s education and turns it into professional, ready-to-share PDF reports in minutes, leaving you more time for the learning itself.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/strewhomeedtrackingapp/strew-home-ed-logging-app-white-500.png\",\"niche_kws\":[\"education\",\"home ed\",\"home education\",\"homeschool\",\"home ed tracker\",\"home education tracker app\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-24T21:25:38.702229+00:00\",\"id\":18684,\"codename\":\"VoiceCursor AI\",\"slug\":\"voicecursor-ai\",\"problem_label\":\"Speak naturally, watch flawless text appear everywhere you write.\",\"solution_label\":\"Voice Cursor turns natural speech into polished writing across your favorite tools, with context-aware transcription, intelligent voice editing, and automatic formatting. It lets you rewrite, translate, and adjust tone by voice, so you can \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/voicecursor-ai/logo.png\",\"niche_kws\":[\"voice dictation\",\"speech transcription\",\"voice editing\"],\"icp_kws\":[\"productivity\",\"voicetech\",\"writing\",\"multilingual\",\"knowledgework\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-08-25T18:40:00.130031+00:00\",\"id\":18711,\"codename\":\"Twinly Lab\",\"slug\":\"twinlylab\",\"problem_label\":\"You can't be everywhere. Your AI twin can.\",\"solution_label\":\"Twinly Lab is a live-video AI twin marketplace. Creators, coaches, and influencers deploy an AI version of themselves — face, voice, and knowledge — that fans can book for paid 1:1 video consultations. These are real video calls, not chatbots, and they run 24/7 without the creator needing to be present.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/twinlylab/Generated-Image-June-09-2026-1_30AM.jpg\",\"niche_kws\":[\"AI\",\"video calls\",\"AI avatars\",\"creator economy\",\"SaaS\",\"marketplace\",\"live video\",\"coaching\",\"monetization\",\"AI twin\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-25T19:00:04.914435+00:00\",\"id\":18712,\"codename\":\"YouTube Transcript AI\",\"slug\":\"youtubetranscriptai\",\"problem_label\":\"Free YouTube transcript generator — extract, copy, download\",\"solution_label\":\"YouTube Transcript AI extracts the complete transcript from any YouTube video in seconds. Paste a URL and get clean, readable text — no sign-up, no limits. Download as TXT or SRT, copy with one click, translate to 100+ languages, or ask AI questions about the video. Works with auto-generated and manual captions, and handles videos without captions through AI transcription. Also available as an MCP server for AI agents.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/youtubetranscriptai/logo-128.png\",\"niche_kws\":[\"youtube transcript\",\"transcript generator\",\"youtube to text\",\"video to text\",\"subtitles\",\"srt download\",\"captions\",\"transcription\",\"mcp server\",\"ai summary\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-25T23:10:45.904691+00:00\",\"id\":18719,\"codename\":\"StreakWars\",\"slug\":\"sw\",\"problem_label\":\"Daily proof challenges. Last streak standing wins.\",\"solution_label\":\"Turn any daily goal into a last-person-standing competition. Join a War, post proof before each deadline, and keep your streak alive. Miss once and you're out; the last eligible player wins.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sw/streakwars-logo-128.png\",\"niche_kws\":[\"Gamification\",\"Habit Tracking\",\"Accountability\",\"Social\",\"Challenges\",\"Creator Economy\",\"Community\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-26T10:22:58.853897+00:00\",\"id\":18731,\"codename\":\"PIGPR\",\"slug\":\"pigpr\",\"problem_label\":\"Reputation on Radar\",\"solution_label\":\"\\\"PigPR watches your brand's reputation across reviews, news, social and AI answers — weekly reports, backlink tracking and competitor ad alerts. Start free.\\\"\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/pigpr/pigpr-logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-26T14:16:49.36976+00:00\",\"id\":18737,\"codename\":\"Sitely iPad AI+Visual Website Builder\",\"slug\":\"sitelyipadaivisualwebsitebuilder\",\"problem_label\":\"The power and simplicity of Sitely is now available on iPad!\",\"solution_label\":\"It seemed impossible but we did it: Sitely AI+Visual Website Builder is now on the iPad!\\n\\nIf you already use Sitely on your Mac, you’ll feel right at home. If you’re new to Sitely, you’ll enjoy its power and simplicity, and its seamless integration with iPadOS features and UI. Everything you could do on a Mac, you can now do on your iPad—and more, with Apple Pencil and touch.\\n\\nFrom your first idea to a published website, you can now take Sitely with you wherever you go.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sitelyipadaivisualwebsitebuilder/icon_1024-light.png\",\"niche_kws\":[\"Website Builder\",\"Visual Web Design\",\"No Code Website Builder\",\"iPad Native App\"],\"icp_kws\":[],\"market\":\"mvp-builders\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-26T20:32:43.235974+00:00\",\"id\":18748,\"codename\":\"CleanVector\",\"slug\":\"cleanvector\",\"problem_label\":\"Create professional illustrations, logos, and reusable mascots\",\"solution_label\":\"CleanVector is an AI design workspace for creating professional illustrations, logos, icons, and complete visual systems from a prompt. Create a mascot once, then reuse the same character across new scenes, poses, and visual styles while keeping it recognizable. Refine colors and shapes in a focused editor, build complete logo kits, and export production-ready SVG or transparent PNG assets for websites, apps, campaigns, and products. API and MCP access are available for automated workflows.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cleanvector/cleanvector-logo-128.png\",\"niche_kws\":[\"AI design\",\"vector graphics\",\"SVG generator\",\"logo maker\",\"illustration\",\"mascot creator\",\"background removal\",\"image vectorizer\",\"API\",\"MCP\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-27T12:55:14.956317+00:00\",\"id\":18778,\"codename\":\"voiceslab\",\"slug\":\"voiceslab\",\"problem_label\":\"Free AI Voice Cloning\",\"solution_label\":\"Clone your voice from a short audio sample while preserving your natural tone, accent, and speaking style. Create realistic voiceovers, podcasts, videos, and more in your own voice\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/voiceslab/logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-28T00:21:34.38184+00:00\",\"id\":18790,\"codename\":\"Macless\",\"slug\":\"macless\",\"problem_label\":\"$$99 once. No Mac, ever.\",\"solution_label\":\"Macless walks you through connecting your GitHub repo, then handles code signing, building, and uploading your iOS or Android app to TestFlight or Google Play automatically. No Mac required, no Xcode, no terminal, no monthly CI subscription. One-time $99, or use the free Signing Doctor tool to diagnose signing errors on its own.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/macless/maclessfavicon.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-28T02:18:57.642264+00:00\",\"id\":18793,\"codename\":\"Free Google Maps Extractor \u0026 Scraper with Email | GMPlus\",\"slug\":\"freegooglemapsextractorscraperwithemailgmplus\",\"problem_label\":\"Extract Google Maps Business Data with Emails\",\"solution_label\":\"Free Google Maps Extractor \u0026 Scraper to collect business names, phones, websites, available emails, ratings and more, then export results to CSV, XLSX, or JSON. No code, no extension required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/freegooglemapsextractorscraperwithemailgmplus/Dan-logo.png\",\"niche_kws\":[\"1.Data Extraction / Data Scraping\",\"2.Web Scraping\",\"3.Google Maps Tools / Maps Tools\",\"4.Business Data / Data Collection\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-28T11:28:02.177563+00:00\",\"id\":18807,\"codename\":\"TapVid\",\"slug\":\"tapvid-49ead3\",\"problem_label\":\"TapVid \",\"solution_label\":\"TapVid turns the materials you already have into a video that explains things clearly and accurately, with shot-level editing, batch production, REST API, and MCP access.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/tapvid-49ead3/tapvid-logo.png\",\"niche_kws\":[\"AI Video generator\",\"Explainer video\",\"motion graphics\",\"ai video maker\",\"talking head video editor\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-29T05:54:01.050408+00:00\",\"id\":18830,\"codename\":\"Felix Trade\",\"slug\":\"felixtrade\",\"problem_label\":\"Run your own quant trading desk, built on Arc\",\"solution_label\":\"Felix is a quant trading platform for developing, backtesting, and running systematic strategies. Research markets, test performance and drawdowns, set capital and risk limits, and monitor automated execution from one workspace. Felix Trade launches September 22 on Arc.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/felixtrade/felix-trade-microlaunch-logo-128.png\",\"niche_kws\":[\"Quant trading\",\"Automated trading\",\"Backtesting\",\"Risk management\",\"Market research\",\"Trading infrastructure\",\"Fintech\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-29T10:37:09.146543+00:00\",\"id\":18838,\"codename\":\"PolyDraft\",\"slug\":\"polydraft\",\"problem_label\":\"AI website builder with continuous SEO and GEO\",\"solution_label\":\"PolyDraft is an AI website builder that turns a business brief or existing URL into a researched, responsive, production-ready site. After launch, it keeps finding SEO, GEO, internal-linking, content, and localization opportunities, prepares improvements in context, and lets you review every change before publishing. Build and preview for free, deploy to your own domain and cloud, and grow across up to 100 languages without juggling separate website, SEO, and localization tools.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/polydraft/polydraft-logo.png\",\"niche_kws\":[\"AI Website Builder\",\"SEO Automation\",\"GEO\",\"AI Visibility\",\"No Code\",\"Website Localization\",\"International SEO\",\"Multilingual Website\",\"Own Cloud Deployment\",\"Agency Tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-29T20:11:52.58202+00:00\",\"id\":18852,\"codename\":\"Talkthrough\",\"slug\":\"talkthrough\",\"problem_label\":\"Turn recordings into searchable evidence for coding agents\",\"solution_label\":\"Talkthrough is a local-first MCP server that turns screen recordings, audio, and long multi-speaker meetings into searchable evidence for coding agents. It indexes transcripts, exact frames, OCR, wall-clock timestamps, and optional speaker diarization, so agents can triage bugs, analyze incidents, extract specifications, decisions, and action items, and answer who said what with timestamped proof. Recordings stay on your machine, with no runtime telemetry.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/talkthrough/talkthrough-logo.png\",\"niche_kws\":[\"MCP Server\",\"Developer Tools\",\"AI Agents\",\"Screen Recording\",\"Audio\",\"Diarization\",\"Meetings\",\"OCR\",\"Local-First\",\"Open Source\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-30T19:35:04.824686+00:00\",\"id\":18867,\"codename\":\"Grumble\",\"slug\":\"grumble\",\"problem_label\":\"The Bad Reviews App\",\"solution_label\":\"Grumble is a place for discovering and sharing honest, bad reviews about brands business and public services! We're all about fighting shitification \u0026 giving power back to consumers. Users can post complaints, photos, videos, and stories, and connect with others through likes, comments, and shares and see the rage visualized in real time!\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/grumble/grumble_gradiant.png\",\"niche_kws\":[\"Reviews\",\"Companies\",\"Brands\",\"Complaints\",\"Funny\",\"Restaurants\",\"Shops\",\"Sentiment\",\"Bad\",\"Rage\",\"Vent\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-31T08:53:11.708286+00:00\",\"id\":18878,\"codename\":\"CiteGraph\",\"slug\":\"citegraph\",\"problem_label\":\"Get your product mentioned by AI assistants\",\"solution_label\":\"CiteGraph measures which products AI assistants actually recommend. It asks the real questions buyers type into AI across four engines (ChatGPT family, Claude, Gemini, Perplexity), repeatedly, and reports how often you are named, who wins instead, and which pages the engines cite. Every rate carries a margin of error. Each scan ends with the specific missing sentence that would put you in the answer, drafted and ready to edit.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/citegraph/microlaunch-logo-128.png\",\"niche_kws\":[\"aeo\",\"ai-seo\",\"geo\",\"ai-visibility\",\"llm-monitoring\",\"brand-monitoring\",\"chatgpt\",\"competitor-analysis\",\"marketing-analytics\",\"seo-tools\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-31T12:03:50.383086+00:00\",\"id\":18893,\"codename\":\"PixoMonitor\",\"slug\":\"pixomonitor\",\"problem_label\":\"Multi-location uptime monitoring, cron tracking, and server agents.\",\"solution_label\":\"An all-in-one developer infrastructure suite. PixoMonitor handles 1-minute uptime checks across global locations, custom status pages, cron heartbeats, and background server agents. To celebrate our launch week, we are giving away 10 permanently free Pro Accounts to our first 10 qualified Discord testers who deploy a monitor and provide raw technical feedback. Head to our site to join the launch group!\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/pixomonitor/product-hunt-thumbnail-240.png\",\"niche_kws\":[\"Developer Tools\",\"SaaS\",\"DevOps\",\"Analytics\",\"Infrastructure\",\"Web Development\",\"Sysadmin\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-31T12:33:00.437199+00:00\",\"id\":18894,\"codename\":\"spytrend\",\"slug\":\"spytrend\",\"problem_label\":\"Competitor ad intelligence for Facebook and TikTok\",\"solution_label\":\"SpyTrend is ad intelligence for Facebook and TikTok. Instead of reviewing ads one at a time, it links the accounts, pages and landing domains behind a single advertiser into one profile, so you research a whole competitor at once: the creatives in rotation, the countries they target, and how long each ad has run. Over 1.1B ads are auto-sorted into 33 categories and 343 subcategories. Connect Claude, ChatGPT, Codex or VS Code over MCP and research in plain language\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/spytrend/spytrend-logo-128.png\",\"niche_kws\":[\"ad intelligence\",\"competitor research\",\"facebook ads\",\"tiktok ads\",\"ad spy\",\"ad library\",\"marketing analytics\",\"competitive intelligence\",\"mcp\",\"ai agent\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-08-31T20:57:33.324846+00:00\",\"id\":18906,\"codename\":\"AI Website Hosting for Marketers and Business Owners\",\"slug\":\"aiwebsitehostingformarketersandbusinessowners\",\"problem_label\":\"AI website hosting built for marketers, not engineers.\",\"solution_label\":\"Builderall AI Site Hosting is free hosting for websites built with ChatGPT, Claude, Gemini, or Meta AI. Where Vercel and Cloudflare Pages are built for developers who deploy from Git, Builderall is built for marketers and small business owners who just want more leads and sales. Upload it and it's on a free Builderall subdomain in minutes, no github, no command line, no APIs. Builderall also offers a host of integrated marketing tools within the platform.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aiwebsitehostingformarketersandbusinessowners/logo_icon.png\",\"niche_kws\":[\"AI website hosting\",\"free website hosting\",\"ChatGPT website\",\"Claude website\",\"Gemini website\",\"small business website\",\"no-code hosting\",\"marketing tools\",\"landing page hosting\",\"website conversion\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T00:58:09.654998+00:00\",\"id\":18911,\"codename\":\"dataandapis\",\"slug\":\"dataandapis\",\"problem_label\":\"One subscription. Every API.\",\"solution_label\":\"dataandapis.com is a self-serve API marketplace built for developers who'd rather ship than negotiate. One token-based subscription unlocks the entire catalog: geolocation, data validation, currency rates, HTML rendering, SSL checks, sanctions screening, device databases and more. No per-API contracts, no sales calls, no surprise invoices. Sign up, grab your key, and call your first endpoint in under a minute. Utility APIs at prices that make building it yourself the expensive option.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/dataandapis/Twitter-profile-photo-2-1-.jpg\",\"niche_kws\":[\"api\",\"developer-tools\",\"saas\",\"marketplace\",\"data\",\"backend\",\"integration\",\"automation\",\"no-code\",\"geolocation\",\"validation\",\"currency\",\"web-scraping\",\"compliance\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T03:56:58.08115+00:00\",\"id\":18914,\"codename\":\"Ergofect\",\"slug\":\"ergofect\",\"problem_label\":\"Automate Smarter. Grow Faster.\",\"solution_label\":\"Ergofect builds the automation layer that sits on top of the CRM, helpdesk, and spreadsheets you already run. No new platform, no migration, no long contract.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/ergofect/ergofect-avatar.png\",\"niche_kws\":[\"AI Workflow Automation\",\"Artificial Intelligence\",\"AI Agents\",\"Productivity\",\"Business Intelligence\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"AI Assistant\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T09:20:10.501052+00:00\",\"id\":18920,\"codename\":\"reTrek\",\"slug\":\"retrek\",\"problem_label\":\"Turn your everyday walks into adventures\",\"solution_label\":\"reTrek is a mobile app that turns your everyday walking into a journey along a famous trail. Pick the Camino de Santiago, Everest Base Camp, the Inca Trail or a story-driven quest, then walk in real life. Every step moves you along the route, and each milestone unlocks a short film about the place you have reached. Walk solo, team up, or race your friends.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/retrek/favicon-192.png\",\"niche_kws\":[\"fitness\",\"gamification\",\"walking\",\"motivation\",\"habit\",\"fun\",\"engaging\",\"social\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T19:38:56.327992+00:00\",\"id\":18935,\"codename\":\"MeridianOS\",\"slug\":\"meridianos\",\"problem_label\":\"free no-code website builder that makes your site look like a retro OS\",\"solution_label\":\"MeridianOS is a free, no code portfolio website builder that makes your site look and work like a vintage computer’s operating system. Visitors boot into a desktop with a nested file system, image galleries, blog posts, audio/video files, password protected folders, built-in Applications and more.. All showcasing your work.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/meridianos/globe-badge-1-.png\",\"niche_kws\":[\"website-builder\",\"opensource\",\"free\",\"no-code\"],\"icp_kws\":[],\"market\":\"no-code\",\"product_type\":\"Self-Hosted\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T19:55:50.750687+00:00\",\"id\":18936,\"codename\":\"Nodlume\",\"slug\":\"nodlume\",\"problem_label\":\"System design for cross-platform React apps\",\"solution_label\":\"Design the full system of a React app — pages, data models, API routes, agents — for Web, desktop, mobile, CLI, and browser extensions.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/nodlume/Screenshot-2026-08-31-141312.png\",\"niche_kws\":[\"Developer Tools\",\"SaaS\",\"AI\",\"Productivity\",\"Design Tools\",\"react\",\"system design\",\"code-generation\",\"mcp\",\"ai-agents\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-wip\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-01T23:58:47.749272+00:00\",\"id\":18940,\"codename\":\"Posts Design\",\"slug\":\"postsdesign\",\"problem_label\":\"Mobbin for social media post designs\",\"solution_label\":\"posts.design is a hand-picked gallery of real social post visuals from leading companies and their designers. See all the biggest and new announcements but also dive into historical content - announcements, opengraph images, hiring, launches and more feed-native references.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/postsdesign/posts.design.png\",\"niche_kws\":[\"social media design\",\"design inspiration\",\"swipe file\",\"launch visuals\",\"product marketing\",\"visual references\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-02T02:05:11.0768+00:00\",\"id\":18943,\"codename\":\"SEOAgent\",\"slug\":\"seoagent\",\"problem_label\":\"Turn your Grok Bot into a full-time SEO engineer\",\"solution_label\":\"Turn your Grok Bot, Claude Code, Codex, or Cursor agent into a full-time SEO engineer.\\n\\nSEOAgent lives in your repo. It audits your site and search results, researches competitors and keywords, writes articles and landing pages, and does outreach for backlinks. You review every change before it ships.\\n\\nFree Skill forever. Autopilot is $49/site/month after a $1 7-day trial.\\n\\nInstall: npm install -g @seoagent-official/seoagent \u0026\u0026 seoagent init\\nWebsite: https://seoagent.com\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/seoagent/microlaunch-logo.jpg\",\"niche_kws\":[\"SEO\",\"AI\",\"Developer Tools\",\"Claude Skills\",\"CLI\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-02T02:13:39.460648+00:00\",\"id\":18944,\"codename\":\"Open Portal\",\"slug\":\"openportal\",\"problem_label\":\"Screenshots that answer back.\",\"solution_label\":\"Fastest way to ask AI about anything on your screen. Box anything on your screen. Get an answer, or a finished thumbnail, ad, or redesign.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/openportal/stripeopenportalpremium.png\",\"niche_kws\":[\"Productivity\",\"AI\",\"AI Tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-02T09:44:59.611074+00:00\",\"id\":18953,\"codename\":\"IndieTools\",\"slug\":\"indietools\",\"problem_label\":\"Discover products. Follow founders. Keep building.\",\"solution_label\":\"IndieTools is a discovery platform for independent products and the founders behind them. Makers can list their products for free, build founder profiles, share product updates, follow other builders, connect through direct messages, and stay discoverable beyond launch day. Products live in an organically ranked directory, while optional paid features provide additional exposure without changing organic rankings.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/indietools/favicon.png\",\"niche_kws\":[\"Indie Makers\",\"Product Discovery\",\"Startup Directory\",\"Founder Community\",\"Build in Public\",\"SaaS\",\"Indie Hackers\",\"Startup Tools\",\"Founder Networking\",\"Product Marketing\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-02T09:53:56.298139+00:00\",\"id\":18955,\"codename\":\"WIPI\",\"slug\":\"wipi\",\"problem_label\":\"Your Voice-Powered Home Inventory \u0026  Asset Tracker\",\"solution_label\":\"The only AI-powered inventory and asset assistant that uses vision and voice to track your home, workspace, or job site in seconds.\\nNever lose anything again.\\n\\nSay It \\n\\nSnap It \\n\\nFind It\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wipi/New-WIPI-Logo_Color.jpeg\",\"niche_kws\":[\"home inventory app\",\"home inventory for insurance\",\"how to document belongings for wildfire\",\"home inventory app California\",\"wildfire preparedness home inventory\",\"how to create a home inventory list\",\"home inventory app for insurance claims\",\"best home inventory app 2026\",\"home inventory app for renters\",\"Sortly alternative\",\"Sortly pricing alternative\",\"home inventory checklist for insurance claim\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Lifetime deal\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-02T21:51:10.346612+00:00\",\"id\":18964,\"codename\":\"Add Car Widgets\",\"slug\":\"addcarwidgets\",\"problem_label\":\"Widgets, startup sounds \u0026 synced lyrics for CarPlay\",\"solution_label\":\"Add Car Widgets makes Apple CarPlay yours. Add eleven home-screen widgets — photos, weather, music, a GPS speedometer and more — swap the default connection chime for a custom startup sound, and see time-synced lyrics from Apple Music and Spotify. No CarPlay in your car? Mount Mode turns your iPhone into a big-tile driving dashboard. Built for iOS 16.2+, tuned for iOS 26. Free to try; on the App Store as Car Play Connect: Auto Sync.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/addcarwidgets/Frame-25.jpg\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T02:05:31.043612+00:00\",\"id\":18965,\"codename\":\"BudgetPixel AI\",\"slug\":\"budgetpixelai\",\"problem_label\":\"Create images, videos, audio, and designs with AI\",\"solution_label\":\"BudgetPixel AI is an all-in-one creative workspace for generating and editing images, videos, music, speech, and design assets. It gives creators, marketers, agencies, and developers access to leading AI models through one shared credit balance. Users can compare models, upscale results, remove backgrounds, train custom LoRAs, build designs on a visual canvas, and connect automated workflows through its API and MCP integration.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/budgetpixelai/logo-square.jpg\",\"niche_kws\":[\"AI image generator\",\"AI video generator\",\"generative AI\",\"content creation\",\"design tools\",\"text to image\",\"image to video\",\"AI music\",\"AI speech\",\"developer API\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T03:03:10.77414+00:00\",\"id\":18967,\"codename\":\"Teamsly\",\"slug\":\"teamsly\",\"problem_label\":\"AI workforce management: scheduling, time tracking, tasks, frontline teams\",\"solution_label\":\"Teamsly is AI-powered, all-in-one workforce management software for hourly, shift-based, frontline, deskless, and field teams. Build schedules, track time and attendance with GPS and geofencing, manage timesheets, PTO, jobs and crews, assign recurring tasks with photo proof, collect forms and audits, train employees, and keep teams connected through chat and announcements. Replace spreadsheets, paper timecards, group texts, and disconnected workforce apps with one web and mobile platform.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/teamsly/Teamsly_square_White.png\",\"niche_kws\":[\"Workforce Management\",\"Employee Scheduling\",\"Time Tracking\",\"Time and Attendance\",\"Employee Time Clock\",\"GPS Time Tracking\",\"Task Management\",\"HR Software\",\"Frontline Workforce\",\"Deskless Workforce\"],\"icp_kws\":[],\"market\":\"hr-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T10:11:30.493866+00:00\",\"id\":18977,\"codename\":\"ToolScope\",\"slug\":\"toolscope\",\"problem_label\":\"Discover AI tools and create unique AI characters\",\"solution_label\":\"ToolScope is an AI discovery platform that helps users find, evaluate and review useful AI tools across a wide range of categories. Visitors can explore detailed listings, follow products and discover new solutions, while founders can submit tools, claim their pages and verify ownership. ToolScope also features interactive AI characters that users can chat with or create and customise, bringing software discovery and AI interaction together in one platform.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/toolscope/Screenshot-2026-09-03-102536.png\",\"niche_kws\":[\"AI tools\",\"AI directory\",\"Software discovery\",\"Artificial intelligence\",\"AI characters\",\"Chatbots\",\"SaaS\",\"Product discovery\",\"Startup tools\",\"Developer tools\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T11:36:39.47903+00:00\",\"id\":18980,\"codename\":\"Vulpie.AI\",\"slug\":\"vulpieai\",\"problem_label\":\"Vulpie plans your day, times every task, and tells you the truth about where your hours went\",\"solution_label\":\"VulpieAI is an AI-powered scheduling assistant designed to help you plan your day more effectively. It automatically times every task you add, providing detailed insights into where your hours actually go.\\n\\nThe tool helps you:\\n\\n🦊Plan and organize your daily tasks;\\n\\n🦊Get automatic time estimates for each task;\\n\\n🦊Understand your time allocation patterns;\\n\\n🦊Optimize your daily schedule\\n\\nPerfect for anyone looking to improve productivity and gain visibility into how they spend their time throughout the day.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vulpieai/cofd.png\",\"niche_kws\":[\"AI Assistant\",\"Productivity\",\"Task Management\",\"Time Tracking\",\"Focus\",\"To-Do List\",\"Time Management\",\"Procrastination\",\"Personal Productivity\",\"Desktop App\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T11:59:23.865111+00:00\",\"id\":18981,\"codename\":\"Pixo\",\"slug\":\"pixo-3aa4d7\",\"problem_label\":\"AI agents that create and edit complete videos\",\"solution_label\":\"Pixo is an agent-driven AI video platform for creators and teams. Chat with an AI director that researches, scripts, storyboards, generates consistent scenes with leading video models, adds voiceover, and edits the final cut in one collaborative browser workspace.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/pixo-3aa4d7/pixo-icon-black-256.png\",\"niche_kws\":[\"ai video generator\",\"ai video agent\",\"text to video\",\"image to video\",\"script to video\",\"storyboard\",\"video editing\",\"content creation\",\"character consistency\",\"team collaboration\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T14:07:29.632615+00:00\",\"id\":18984,\"codename\":\"Vastavik\",\"slug\":\"vastavik\",\"problem_label\":\"If it's not on VASTAVIK, it could be fake.\",\"solution_label\":\"Vastavik is a blockchain-backed media authentication platform. Every photo, video, or audio file gets a unique ID and QR watermark at creation--letting anyone independently verify it's real. Built for journalists, creators, and brands to fight deepfakes and prove authenticity in the AI era.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vastavik/Untitled-design-3-.png\",\"niche_kws\":[\"content-authenticity\",\"deepfake-detection\",\"media-verification\",\"blockchain\",\"digital-trust\",\"content-provenance\",\"fact-checking\",\"watermarking\",\"ai-detection\",\"journalism-tools\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T14:14:03.661357+00:00\",\"id\":18985,\"codename\":\"Seedance 3.0\",\"slug\":\"seedance30\",\"problem_label\":\"Create cinematic AI videos with full reference control\",\"solution_label\":\"Seedance 3.0 is a reference-controlled AI video creation workspace for creators, marketers, educators, filmmakers, and product teams. Generate cinematic videos from text, images, video, and audio references with up to 4K output, clips up to 30 seconds, and up to 50 multimedia inputs in one workflow. Create product demos, ads, explainers, storyboards, social videos, and concept films with precise creative direction.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedance30/logo_s3.png\",\"niche_kws\":[\"AI Video\",\"Text to Video\",\"Image to Video\",\"Video Generation\",\"Generative AI\",\"Reference Control\",\"Marketing\",\"Storytelling\",\"Product Demos\",\"4K Video\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T14:37:30.708101+00:00\",\"id\":18986,\"codename\":\"InfoLobby\",\"slug\":\"infolobby\",\"problem_label\":\"Everything a custom internal app does. Nothing you have to maintain.\",\"solution_label\":\"InfoLobby gives you one place to run the work: tables with real field types and relationships, grid, kanban, calendar and gallery views, tasks, comments, files and full history on every record. Visual flows automate the busywork, web forms and inbound email bring work in, and a public REST API takes it anywhere else. Unlimited users on every plan.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/infolobby/logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"team-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-03T18:28:21.625637+00:00\",\"id\":18994,\"codename\":\"X-Radio.FM\",\"slug\":\"xradiofm\",\"problem_label\":\"Radio for Founders Building in Public\",\"solution_label\":\"The stories founders post on X — launches, first dollars, hard weeks — read out loud by a host on one station that never goes off the air. Stop scrolling and listen. One day it is your name.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/xradiofm/xradiologo-1-.png\",\"niche_kws\":[\"indie hackers\",\"build in public\",\"internet radio\",\"founder news\",\"live radio\",\"AI\",\"SaaS\",\"makers\"],\"icp_kws\":[],\"market\":\"podcast\",\"product_type\":\"Info product, Newsletters, Communities\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-04T06:29:05.089567+00:00\",\"id\":19003,\"codename\":\"video2text\",\"slug\":\"video2text\",\"problem_label\":\"Turn any video or audio into clean text in minutes.\",\"solution_label\":\"video to text is an ai-powered transcription service that converts video and audio files, as well as video links, into clean, exportable text. the product is designed for creators, teams, and individuals who need fast, accurate speech-to-text conversion without setting up their own transcription pipeline.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/video2text/logo.png\",\"niche_kws\":[\"transcription\",\"speech-to-text\",\"video transcription\",\"audio transcription\",\"ai transcription\",\"speaker diarization\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-04T07:17:36.459225+00:00\",\"id\":19007,\"codename\":\"Facet Cloud\",\"slug\":\"facetcloud\",\"problem_label\":\"Your site, courses, and audience, together.\",\"solution_label\":\"Facet is the creator platform that replaces your website builder, course host, newsletter tool, community app and checkout. It runs on your domain and connects to your Stripe account.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/facetcloud/icon.png\",\"niche_kws\":[\"Creator platform\",\"courses\",\"monetization\",\"newsletter\",\"blog\",\"resume builder\",\"portfolio\",\"content sales\"],\"icp_kws\":[],\"market\":\"cloud\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-04T07:46:29.677313+00:00\",\"id\":19008,\"codename\":\"meelang\",\"slug\":\"meelang1\",\"problem_label\":\"MeeLang is a real-time AI translator for Google Meet\",\"solution_label\":\"MeeLang is a real-time AI translator for Google Meet. It is a chrome extension that translates what everyone says into your own language and puts it on screen as live subtitles.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/meelang1/logo.png\",\"niche_kws\":[\"Live subtitles and real-time translation for every meeting\",\"Live AI Translation with Real-time Subtitles\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-05T05:50:09.181217+00:00\",\"id\":19033,\"codename\":\"AI Agents Listing\",\"slug\":\"aiagentslisting\",\"problem_label\":\"​​AI agents, MCP servers and skills. One directory.​\",\"solution_label\":\"A directory of AI agents, MCP servers and agent skills, cross-linked so you can see what works with what. Free to list.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aiagentslisting/favicon.png\",\"niche_kws\":[\"ai agents\",\"mcp servers\",\"agent skills\",\"mcp\",\"model context protocol\",\"agentic ai\",\"ai directory\",\"ai tools directory\",\"llm agents\",\"autonomous agents\",\"ai automation\",\"developer tools\",\"agent tools\",\"claude code\",\"mcp registry\",\"ai marketplace\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-05T13:52:51.814033+00:00\",\"id\":19044,\"codename\":\"Radar\",\"slug\":\"radar\",\"problem_label\":\"Get customers from Reddit without ads or getting banned\",\"solution_label\":\"Radar finds Reddit threads where someone is describing the exact problem your product solves, scores them, and drafts the reply. You review, tweak a word, paste. Nothing is ever auto-posted. Built-in anti-ban guardrails do the boring part: it audits each subreddit's real rules, caps mentions at one per sub, enforces cooldowns, and a simulated moderator reads every pitched draft before you see it. Built by a founder who got banned learning why this matters.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/radar/radar-lockup-512.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-06T03:47:15.385366+00:00\",\"id\":19058,\"codename\":\"Peregrine OS\",\"slug\":\"peregrineos\",\"problem_label\":\"Pre-call intel and daily signal feeds for agency new business.\",\"solution_label\":\"Peregrine OS is a suite of B2B intelligence tools built on the Flightpath.AI engine: pre-call prospect intel, account-level pitch briefings, and daily feeds tracking exec hires, funding, AOR gaps, and marketing news — for agency new business and consulting BD teams.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/peregrineos/IMG_1685.png\",\"niche_kws\":[\"Sales\",\"marketing\",\"advertising\",\"intelligence\",\"research\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-06T18:37:32.066116+00:00\",\"id\":19069,\"codename\":\"Qevra\",\"slug\":\"qevra\",\"problem_label\":\"List free. Public page. Dofollow backlink.\",\"solution_label\":\"Qevra is a free public directory. Paste a URL. We publish a page and a dofollow outbound link. No login. No queue. Ads are optional and labeled Ad. A homepage ad is $39.99 every 30 days. A listing-page ad is $49.99 on a specific site page, including a competitor's. Card ads renew every 30 days until you cancel. We do not promise rankings or traffic. Over 300 sites are listed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/qevra/logo-128.png\",\"niche_kws\":[\"dofollow directory\",\"free site listing\",\"public directory\",\"backlink\",\"SaaS directory\",\"AI tools\",\"no login\",\"curl submit\",\"startup directory\",\"website directory\"],\"icp_kws\":[],\"market\":\"directories\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-06T21:15:33.369924+00:00\",\"id\":19078,\"codename\":\"Itemlist\",\"slug\":\"itemlist\",\"problem_label\":\"Inventory tracker that maps every room and box\",\"solution_label\":\"The stuff you own ends up in boxes inside boxes, at home and at work. Itemlist tracks it the way your spaces work: a location for each property, rooms inside, and containers nested to any depth, shared with your household or team on PRO, with insurance-ready records and CSV export. Free to start with 100 items.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/itemlist/microlaunch-logo-512.png\",\"niche_kws\":[\"home inventory\",\"inventory app\",\"home organization\",\"household\",\"ios\",\"ipad\",\"moving\",\"insurance\",\"declutter\",\"productivity\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-06T21:21:44.507937+00:00\",\"id\":19079,\"codename\":\"Reflect\",\"slug\":\"reflect\",\"problem_label\":\"See your life in ways you never could before.\",\"solution_label\":\"An intelligent journal that turns your memories into insight.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/reflect/Reflect-Logo.png\",\"niche_kws\":[\"AI Journal\",\"Personal Growth\",\"Self Reflection\",\"Journaling\",\"Life Mapping\",\"Memory\",\"Personal Insights\",\"Mental Wellness\",\"Life Story\",\"Self Discovery\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T08:42:20.674293+00:00\",\"id\":19089,\"codename\":\"SocialCrawl\",\"slug\":\"socialcrawl\",\"problem_label\":\"One unified API for all social media data.\",\"solution_label\":\"SocialCrawl is a unified social media data API that gives developers and AI agents access to clean, structured data through a single API key. We power AI agents by providing the API to search, scrape, and interact with social media at scale. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/socialcrawl/Socialcrawl-2-.png\",\"niche_kws\":[\"API\",\"Dev Tool\",\"AI Agent\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T12:12:23.671442+00:00\",\"id\":19093,\"codename\":\"Labrynth \",\"slug\":\"labrynth\",\"problem_label\":\"AI regulatory intelligence platform that turns complex requirements into cited, audit-ready outputs.\",\"solution_label\":\"The platform maps obligations, validates documents and evidence, and helps teams move faster through complex compliance, licensing, permitting, and approval workflows while keeping experts in control.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/labrynth/LABRYNTH-BLACK.png\",\"niche_kws\":[\"AI\",\"compliance\",\"regulation\",\"execution layer\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T15:43:43.727682+00:00\",\"id\":19100,\"codename\":\"bubble markets\",\"slug\":\"bubblemarkets\",\"problem_label\":\"See global financial markets move on one interactive bubble map.\",\"solution_label\":\"BubbleMarkets is a multi-asset financial market visualization platform that transforms stocks, ETFs, cryptocurrencies, forex, commodities, bonds and global indices into interactive bubble maps. Users can quickly identify market leaders, laggards, price movements and trading activity through an intuitive visual interface. With flexible filters, multiple timeframes, watchlists, charts, market data and news, BubbleMarkets helps traders, investors and analysts understand what is moving across global markets without switching between multiple financial platforms.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/bubblemarkets/WhatsApp-Image-2026-09-07-at-20.15.13.jpeg\",\"niche_kws\":[\"Financial Markets\",\"Market Visualization\",\"Stock Market\",\"Cryptocurrency\",\"Forex\",\"ETFs\",\"Market Analytics\",\"Trading Tools\",\"Investment Research\",\"Bubble Charts\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T21:48:28.19483+00:00\",\"id\":19105,\"codename\":\"SanityCheck\",\"slug\":\"sanitycheck\",\"problem_label\":\"AI Agents test your application like real users.\",\"solution_label\":\"Describe your test. That's it. AI agents open real cloud browsers and test your app like actual users. Watch live, replay every click, trigger on every GitHub, GitLab, or Vercel deploy. Free tier. No card needed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sanitycheck/directory-logo-1024.png\",\"niche_kws\":[\"ui/ux testing\",\"automated browser testing\",\"ai agents\",\"ai testing\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T22:03:09.781817+00:00\",\"id\":19106,\"codename\":\"Shora\",\"slug\":\"shora\",\"problem_label\":\"Meditation for how you feel right now.\",\"solution_label\":\"Check in with how you feel — one tap or a few words — and Shora composes a 2–10 minute guided session from 20 evidence-based techniques, narrated in your language, then learns what works for you. Free to start on iPhone and Android.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/shora/store-icon.png\",\"niche_kws\":[\"#meditation\",\"#calm\",\"#focus\",\"#reset\",\"#personalised\"],\"icp_kws\":[],\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-07T23:30:23.621207+00:00\",\"id\":19108,\"codename\":\"IRPForge\",\"slug\":\"irpforge\",\"problem_label\":\"Audit-ready incident response plans, without the consultant price tag\",\"solution_label\":\"IRPForge generates branded, audit-ready incident response plans for nonprofits and small organizations. Answer a few questions about your team and systems, and get a Master IRP, Incident Report Form, and Emergency Contact One-Pager, built on NIST and CIS frameworks. No security background needed. Consultants charge $5,000-$15,000+ for this. IRPForge starts at $199, one-time.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/irpforge/irpforge_logo_128x128.png\",\"niche_kws\":[\"incident response\",\"cybersecurity\",\"nonprofit\",\"compliance\",\"SaaS\",\"audit-ready\",\"NIST\",\"CIS controls\",\"small business\",\"security planning\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-08T07:38:24.691231+00:00\",\"id\":19118,\"codename\":\"Wondershare Repairit\",\"slug\":\"wondersharerepairit\",\"problem_label\":\"AI-powered data repair for videos, photos, audio, and files in minutes.\",\"solution_label\":\"Wondershare Repairit is an AI-powered media repair and enhancement tool that quickly fixes corrupted videos, photos, audio, and documents. Beyond recovery, it brings your visuals to life with advanced AI old photo restoration, Image to Video generation, and smart One-prompt Photo Editing across all devices.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wondersharerepairit/Wondershare-Repairit.png\",\"niche_kws\":[\"AI repair\",\"file repair\",\"video repair\",\"photo repair\",\"audio repair\",\"document repair\",\"AI enhancement\",\"photo eraser\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-08T16:41:14.435808+00:00\",\"id\":19136,\"codename\":\"TrustGrowth\",\"slug\":\"trustgrowth\",\"problem_label\":\"Your Growth Engine. Verified SEO Scores. Open SEO Playbook. Public SEO Proof\",\"solution_label\":\"TrustGrowth is a continuous growth engine that turns evidence across 8 growth pillars into priorities, plans and approval-gated actions. It measures, diagnoses, learns from outcomes and repeats. The public TrustGrowth Score is supporting proof, not the product.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/trustgrowth/tg-logo.jpeg\",\"niche_kws\":[\"Marketing\",\"Growth\",\"AI-Visibility\",\"Keyword Research\",\"Competitor Analysis\",\"Brand Monitoring\"],\"icp_kws\":[],\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-08T19:57:17.209172+00:00\",\"id\":19142,\"codename\":\"Chart Drill\",\"slug\":\"chartdrill\",\"problem_label\":\"Learn to read candlestick charts in short lessons.\",\"solution_label\":\"Most people learn trading by watching endless videos and never touching a chart. Chart Drill flips that. Short, Duolingo-style lessons introduce one price action concept, quiz you on real candles, then bring it back later so it sticks. Built by a trader who taught himself the same way. In beta now, free to start, with more units coming.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/chartdrill/avatar-mark.png\",\"niche_kws\":[\"Candlesticks\",\"Trading\",\"Learning\",\"Educational\",\"Charts\"],\"icp_kws\":[],\"market\":\"edtech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-09T04:46:07.021814+00:00\",\"id\":19150,\"codename\":\"scanr.ai\",\"slug\":\"scanrai\",\"problem_label\":\"Automate trade ideas to suit your trading personality\",\"solution_label\":\"Scanr.ai is an AI-powered US-equity scanner that turns natural-language and technical/fundamental filters into continuously running realtime watchlists with alerts to help traders automate trade idea discovery, plus ticker research via charts, fundamentals, news, and market data.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/scanrai/scanrai-512.png\",\"niche_kws\":[\"stock scanner\",\"screener\",\"trade ideas\"],\"icp_kws\":[],\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-09T09:19:40.891031+00:00\",\"id\":19163,\"codename\":\"Wondershare Recoverit\",\"slug\":\"wondersharerecoverit\",\"problem_label\":\"AI-powered data recovery and 4K/8K video restoration tool.\",\"solution_label\":\"Wondershare Recoverit is an AI-powered data recovery software designed to restore lost, deleted, or corrupted files across 2,000+ storage devices with a 99.5% success rate. Featuring patented Enhanced Video Recovery technology, it automatically auto-stitches fragmented 4K/8K video clips from camera SD cards, repairs corrupted media, and extracts critical files from crashed computers, formatted drives, and NAS servers in 3 simple steps.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wondersharerecoverit/DR-LOGO.png\",\"niche_kws\":[\"data recovery\",\"AI search\",\"video recovery\",\"image recovery\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-10T01:44:56.778876+00:00\",\"id\":19180,\"codename\":\"Svellyo\",\"slug\":\"svellyo\",\"problem_label\":\"Sales and support chat with an AI agent trained on your docs.\",\"solution_label\":\"Sales and support chat with an AI agent trained on your docs. Install it on every site you run, answer from a single inbox, and pay for chats instead of seats. Set up in minutes, not a sprint.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/svellyo/icon-512.png\",\"niche_kws\":[\"customer support\",\"chat bot\",\"ai chatbot\",\"customer support chat\",\"sales chatbot\",\"website chat widget\",\"live chat\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-10T08:12:29.499314+00:00\",\"id\":19193,\"codename\":\"Sociavault\",\"slug\":\"sociavault\",\"problem_label\":\"Best social media scraping API\",\"solution_label\":\"SociaVault is a unified REST API that extracts real-time data from 25+ social media platforms, including TikTok, Instagram, YouTube, LinkedIn, and Twitter/X.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sociavault/logo.png\",\"niche_kws\":[\"API\",\"Developer Tools\",\"AI Agent\",\"Scrape\",\"Social media\",\"scraper API\",\"scraping API\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-10T13:04:13.528453+00:00\",\"id\":19203,\"codename\":\"Hyvor Blogs\",\"slug\":\"hyvorblogs\",\"problem_label\":\"You Publish. We handle the rest.\",\"solution_label\":\"An open-source, bloat-free blogging platform designed for total simplicity. Hyvor Blogs includes everything natively, including comments, newsletters, zero-config SEO, and automated link analysis. You can publish on a custom domain, run as a sub-directory, or go fully headless. Built on the AGPL-3.0 license, it eliminates plugin maintenance and vendor lock-in and offers one-click data exports, real-time team collaboration, live cursors, and AI features out of the box.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/hyvorblogs/hyvor-blog-social-media.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"oss\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-11T12:02:31.274406+00:00\",\"id\":19236,\"codename\":\"CheaperInference\",\"slug\":\"cheaperinference\",\"problem_label\":\"Slash inference costs with one OpenAI-compatible API.\",\"solution_label\":\"Cheaper Inference is an OpenAI-compatible API marketplace that routes your existing AI workloads to discounted models from multiple providers, cutting inference costs while preserving data controls and detailed usage visibility.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/cheaperinference/logo.png\",\"niche_kws\":[\"inference marketplace\",\"llm cost-router\",\"openai-compatible api\"],\"icp_kws\":[\"ai infrastructure\",\"developer apis\",\"mlops\",\"cloud cost-optimization\",\"llm marketplaces\"],\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-09-11T16:36:47.042064+00:00\",\"id\":19241,\"codename\":\"Mokko\",\"slug\":\"mokko\",\"problem_label\":\"AI ads every week. Built around what works.\",\"solution_label\":\"Mokko creates fresh AI ads every week, guided by your brand’s performance data. We analyze existing creatives, identify what to test next, and deliver new concepts and variations tailored to your business. Your team or agency keeps control of campaigns and media budgets. No fixed monthly fee: our compensation is a percentage of revenue generated and ad spend on Mokko ads, with terms agreed before we start.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/mokko/download-1-.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-11T22:17:58.833305+00:00\",\"id\":19249,\"codename\":\"ChannelWeave\",\"slug\":\"channelweave\",\"problem_label\":\"Multichannel commerce, minus the chaos.\",\"solution_label\":\"Calm multichannel commerce for independent sellers. Stock, listings, orders and supported buyer messages together — with Elqori, your private AI assistant.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/channelweave/logo.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"marketplaces\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-12T06:37:15.923897+00:00\",\"id\":19255,\"codename\":\"One Guy Consulting\",\"slug\":\"oneguyconsultinghipaacompliancesolutions\",\"problem_label\":\"Keeping HIPAA Auditors Out of YOUR Business\",\"solution_label\":\"OneGuyConsulting.com is the passion project of HIPAA compliance expert and founder Chuck Weiselberg. For eight years Chuck watched healthcare SaaS companies fall behind by refusing to use the technology in front of them. HIPAA is complex, every attempt to simplify it only makes it more confusing. Chuck knew a better way. He automated his methodology, crushed the repetitive work, and built a program that small practices can actually finish.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/oneguyconsultinghipaacompliancesolutions/oneguyconsulting-logo-128.png\",\"niche_kws\":[\"Healthcare SaaS\",\"AI Compliance\",\"HIPAA Compliance Platform that Automates Repetitive Tasks\",\"Automated Gap Analysis\",\"Auto-Generating Remediation Plans\",\"AI-Tailored Policies and Procedures\",\"HIPAA Compliance Training Software\",\"RegTech\",\"Streamlined Vendor and Contract workflows\",\"Built-In Incident Management\"],\"icp_kws\":[],\"market\":\"startup-builders\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-12T07:35:29.394691+00:00\",\"id\":19258,\"codename\":\"WhatsApp Sender\",\"slug\":\"whatsappsender\",\"problem_label\":\"WhatsApp Sender - Rocket Sender\",\"solution_label\":\"Rocket Sender is a free WhatsApp Sender for personalized bulk messaging directly in WhatsApp Web.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/whatsappsender/unnamed-4-.png\",\"niche_kws\":[\"WhatsApp Sender\",\"Rocket Sender\",\"WhatsApp Bulk Message Sender\",\"WhatsApp Bulk Sender\",\"WhatsApp Web Sender\",\"WhatsApp Sender Extension\",\"WhatsApp Sender Chrome Extension\",\"Bulk Message Sender\",\"Free WhatsApp Sender\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-12T22:41:21.689778+00:00\",\"id\":19275,\"codename\":\"Sealed Rose\",\"slug\":\"sealedrose\",\"problem_label\":\"Free in-browser AI deepfake and synthetic video detector.\",\"solution_label\":\"Sealed Rose Deepfake Video Detector is a free, privacy-first forensic tool that exposes AI-generated videos and facial face-swaps. Frame-by-frame temporal inspection analyzes Sora, Kling, Veo, and Runway artifacts directly in your browser without uploading to external servers. Built for buyers, creators, and platforms to verify genuine human media.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sealedrose/seal-wax.png\",\"niche_kws\":[\"AI Detector\",\"Deepfake\",\"Cybersecurity\",\"Video\",\"Privacy\",\"Verification\",\"Artificial Intelligence\",\"Creator Economy\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-12T23:14:41.973934+00:00\",\"id\":19276,\"codename\":\"ScrollCheckpoint \",\"slug\":\"scrollcheckpoint\",\"problem_label\":\"Add checkpoints to your scrolling \",\"solution_label\":\"ScrollCheckpoint steps in when you try to open a social app, so you don't have to remember to use it first. Set a short Scroll Alarm, start scrolling, and when time's up, complete a quick checkpoint before deciding whether to continue. Turn an automatic scroll into a moment to pause, learn and reset.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/scrollcheckpoint/ScrollCheckPoint-icon-yellow.png\",\"niche_kws\":[\"Screen Time\",\"Digital Wellbeing\",\"Productivity\",\"Mindful Scrolling\",\"Social Media\",\"Focus\",\"Microlearning\",\"Habit Building\",\"Students\",\"Self Improvement\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-13T16:30:45.464851+00:00\",\"id\":19288,\"codename\":\"GPT Image 2.5 Online\",\"slug\":\"gptimage25online\",\"problem_label\":\"Generate AI images by GPT Image 2.5 free daily, no sign-up required\",\"solution_label\":\"Image25 is a browser-based AI image generator and editor with daily free credits, no registration required. Create ads, product visuals, posters, and social content from text prompts or reference photos using supported models including GPT Image 2 and Nano Banana. Refine images, choose flexible aspect ratios, and export up to 4K with supported models. Daily free usage is limited; credit packs and subscriptions are available for higher-volume work.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/gptimage25online/image25-logo-128x128.png\",\"niche_kws\":[\"AI image generator\",\"AI image editor\",\"Text to image\",\"Image to image\",\"Graphic design\",\"Content creation\",\"Ecommerce\",\"Marketing\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-14T07:56:23.563273+00:00\",\"id\":19300,\"codename\":\"RoomAI\",\"slug\":\"roomai\",\"problem_label\":\"Redesign your room from one photo, same walls\",\"solution_label\":\"RoomAI turns a real photo of your room into AI-generated design options in under a minute, while keeping the walls, windows, and camera angle exactly as photographed. It covers 20+ room-specific presets — living room, bedroom, bathroom, house exterior, staging, decluttering — drawing on a shared library of 300+ styles, so each room type gets presets tuned to it instead of one generic style list. Free to try, no card required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/roomai/PureLogo.webp\",\"niche_kws\":[\"AI Interior Design\",\"Room Design\",\"Home Renovation\",\"Virtual Staging\",\"Interior AI\",\"Home Decor\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-14T10:11:39.318453+00:00\",\"id\":19306,\"codename\":\"Transcribe Audio to Text\",\"slug\":\"transcribeaudiototext\",\"problem_label\":\"Transcribe Audio to Text\",\"solution_label\":\"Transcribe Audio to Text online with Audio Converter AI. Convert audio, video, YouTube links, and recordings into accurate, editable transcripts. Enjoy 200+ languages, speaker recognition, timestamps, AI summaries, and files up to 10GB. Perfect for meetings, lectures, interviews, podcasts, research, and content creation. Upload your media, let AI transcribe it, then review, download, share, or repurpose your text.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/transcribeaudiototext/audioconverterai-logo-1.png\",\"niche_kws\":[\"Transcription\",\"Audio to Text\",\"Speech to Text\",\"AI Transcription\",\"Video to Text\",\"YouTube Transcript\",\"Meeting Notes\",\"Podcast Tools\",\"Subtitle Generator\",\"Productivity Tools\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-14T15:42:28.935042+00:00\",\"id\":19326,\"codename\":\"Onyatrips\",\"slug\":\"onyatrips\",\"problem_label\":\"Discover What’s Worth Experiencing, and Who to Experience It With.\",\"solution_label\":\"Onyatrips is a meaningful travel discovery network that helps you discover remarkable places, experiences, people, and communities worth experiencing. Instead of endless search results and popularity-based rankings, Onyatrips focuses on relevance, context, curation, and trust. Explore travel experiences through the Onya Standard, connect discovery with people and communities, and find what is actually worth experiencing - not just what is already popular.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/onyatrips/final-1-box.png\",\"niche_kws\":[\"Travel Discovery\",\"Meaningful Travel\",\"Travel Experiences\",\"Destination Discovery\",\"Travel Community\",\"Travel Companions\",\"Hidden Gems\",\"Social Travel\",\"Travel Recommendations\",\"Travel Network\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-14T17:31:58.499768+00:00\",\"id\":19335,\"codename\":\"Koboyo\",\"slug\":\"koboyo\",\"problem_label\":\"Bring pages alive with a playful, custom cursor-following mascot\",\"solution_label\":\"page-mascot is a React-based interactive mascot that sits at the top of your page, follows the reader’s cursor, and reacts to pokes, giving your site a memorable, character-driven experience.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/koboyo/logo.png\",\"niche_kws\":[\"react mascot\",\"interactive header\",\"cursor follower\"],\"icp_kws\":[\"web animation\",\"react components\",\"ui personalization\",\"web branding\",\"frontend design\"],\"market\":\"ui-ux\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false},{\"created_at\":\"2026-09-14T19:47:56.243249+00:00\",\"id\":19337,\"codename\":\"Rival Shark\",\"slug\":\"rivalshark\",\"problem_label\":\"Intelligence Beneath the Surface\",\"solution_label\":\"Know your competitor's next move before it costs you.\\n\\nRival Shark is AI-powered competitive intelligence that monitors your competitors, industry, and local market, surfaces what changed, explains why it matters, and recommends your next move. In minutes, not weeks.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/rivalshark/Rival-Shark-Mark-Dark-BG-4x.png\",\"niche_kws\":[\"Competitive intelligence\",\"Market intelligence\",\"Local Intelligence\",\"Founder Tools\",\"Entrepreneurs\"],\"icp_kws\":[],\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-14T19:50:10.404844+00:00\",\"id\":19338,\"codename\":\"Hermoso\",\"slug\":\"hermoso\",\"problem_label\":\"Your marketing on autopilot, run from your own AI\",\"solution_label\":\"Hermoso is the marketing team you run from your own AI. Connect it to Claude, ChatGPT, Codex or Cursor and it finds the ads winning in your market, makes image and video ads and organic posts in your brand, publishes to 10 channels, runs campaigns on 11 ad platforms, answers comments and DMs, and reads the results back. 830+ tools over MCP, plus a web studio if you would rather click. Posting, scheduling and analytics are free; credits only go to AI renders and ad research.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hermoso/hermoso-logo-128.png\",\"niche_kws\":[\"AI agents\",\"Marketing\",\"Advertising\",\"MCP\",\"Social media\",\"Video ads\",\"Automation\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-15T06:28:47.778988+00:00\",\"id\":19352,\"codename\":\"Vestra\",\"slug\":\"vestra\",\"problem_label\":\"Your Self-Building AI Agent Office\",\"solution_label\":\"Vestra is your AI Agent Office: agents that take over real tasks, routines, and whole responsibilities and come back to work done. Each agent works in its own cloud computer, browsing, using your tools, and running tasks in parallel while you watch, redirect, or approve. Reach them via web, desktop, WhatsApp, Telegram, or iMessage. Delegate once; it's handled.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vestra/vestra-logo-2048.png\",\"niche_kws\":[\"Omnipresent · Works Where You Work\",\"Omniscient · Knows What Matters\",\"Omnipotent · Intent to Outcome\",\"Come Back to Done\",\"Give It the Work\",\"Not the Task\",\"Your AI Agent Office\",\"Delegation with Control\",\"AI Employee\",\"WhatsApp Your Agent\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-15T13:49:08.903631+00:00\",\"id\":19362,\"codename\":\"OctoVault\",\"slug\":\"octovault\",\"problem_label\":\"Find your equipment records.\",\"solution_label\":\"OctoVault helps small business owners find their equipment records. Start with an equipment label photo. Review the details before saving. Keep equipment photos, manuals and repair notes together. Keep invoices and service notes with the equipment. Not a CMMS. No setup project. Free 30-day self-serve trial, full access, no card.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/octovault/00-thumbnail.png\",\"niche_kws\":[\"equipment records\",\"small business\",\"AI\",\"manuals\",\"repair notes\"],\"icp_kws\":[],\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-15T21:56:22.583693+00:00\",\"id\":19378,\"codename\":\"instancescheduler\",\"slug\":\"instancescheduler\",\"problem_label\":\"Automatically turn on and off your AWS EC2 instances\",\"solution_label\":\"Instance Scheduler is a tool for automatically scheduling and managing AWS EC2 instances. It helps reduce cloud infrastructure costs by automatically starting and stopping instances based on defined schedules, rather than running them continuously.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/instancescheduler/is128x128.png\",\"niche_kws\":[],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-15T22:45:17.466997+00:00\",\"id\":19380,\"codename\":\"Statiko\",\"slug\":\"statiko\",\"problem_label\":\"Real-time Telegram analytics with an MCP connector\",\"solution_label\":\"Statiko tracks public Telegram channels in real time: every post, edit and deletion, reach, engagement, subscriber growth, and what's trending across the network. Anyone can add a public channel and browse for free. \\n\\nNew: a remote MCP server so Claude, ChatGPT or Cursor can ask \\\"what's trending in Telegram today\\\" or \\\"which channels reposted this first\\\" — every answer links back to the source post. Plus AI Recaps: scheduled digests of the channels you pick.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/statiko/logo.png\",\"niche_kws\":[\"Telegram\",\"MCP\",\"Analytics\",\"OSINT\",\"AI Agents\",\"Social Media Monitoring\",\"News\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-16T03:31:34.474719+00:00\",\"id\":19386,\"codename\":\"Video Face Swap AI\",\"slug\":\"videofaceswapai-bc28a6\",\"problem_label\":\"Swap Faces in Videos Free \u0026 Unlimited\",\"solution_label\":\"Video Face Swap AI is an advanced AI-powered online face-swapping tool. In just a few simple steps, seamlessly swap single or multiple faces in videos, photos, and GIFs.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/videofaceswapai-bc28a6/nav-logo.png\",\"niche_kws\":[\"AI video editor\",\"face swap AI\",\"deepfake tool\",\"video editing software\",\"content creation tool\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-16T08:50:10.367134+00:00\",\"id\":19399,\"codename\":\"Spectry\",\"slug\":\"spectry\",\"problem_label\":\"Understand why visitors leave. Spectry finds the fix and tests it automatically.\",\"solution_label\":\"Most analytics tools tell you what happened, then leave the fixing to you. Spectry closes the loop. Analytics, session replays, heatmaps, funnels, surveys, error logs, and A/B tests all run from one script. Every 12 hours, AI scans your data, identifies what’s costing you conversions, and turns each finding into a ready-to-run A/B test. Approve the fix, send it to real traffic, and see whether it actually works. EU-hosted and GDPR-first.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/spectry/icon-128x128.png\",\"niche_kws\":[\"analytics\",\"conversion optimization\",\"AI insights\",\"conversion funnels\",\"feedback\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-17T13:38:10.327795+00:00\",\"id\":19434,\"codename\":\"Atomic Mail Agentic\",\"slug\":\"atomicmailagentic\",\"problem_label\":\"Give AI agents a real email inbox they run themselves\",\"solution_label\":\"Atomic Mail Agentic gives AI agents a full email inbox they can create and operate on their own — no domain, no credit card, no human. Built on JMAP (RFC 8620/8621), not send-only like Resend or SendGrid, so agents can read, search, reply, and thread email, not just send it. Connect via MCP, LangChain, n8n, or Dify. Built by the team behind Atomic Mail, encrypted email already used by 6M+ people.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/atomicmailagentic/AM-agentic-logo-1.png\",\"niche_kws\":[\"email api\",\"ai agents\",\"mcp\",\"jmap\",\"developer tools\",\"automation\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-17T14:15:06.676214+00:00\",\"id\":19437,\"codename\":\"Submitrax\",\"slug\":\"submitrax\",\"problem_label\":\"Add a working form to your site in 2 minutes\",\"solution_label\":\"No backend, no config marathon. Copy your SubmitraX endpoint into any HTML form and you're live — submissions land in your inbox, Slack, Discord, or a webhook instantly. Static site, landing page, side project: get a real, working form up in the time it takes to grab a coffee.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/submitrax/logomark.png\",\"niche_kws\":[\"form backend\",\"forms\",\"developer tools\",\"no-code\",\"API\",\"SaaS\",\"webhooks\",\"static site\"],\"icp_kws\":[],\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-18T08:40:18.605556+00:00\",\"id\":19455,\"codename\":\"Decloak - Web security intelligence\",\"slug\":\"decloakwebsecurityintelligence\",\"problem_label\":\"Security intelligence for teams from vibe coders to enterprise\",\"solution_label\":\"Decloak scans any live URL across 8 layers, catching exposed API keys, misconfigured databases, and vulnerable libraries, including the specific failures common to apps built with Lovable, Supabase, and Base44. Paid tiers deploy an AI agent that investigates a whole site, run AI-powered penetration testing, and map findings to SOC2, ISO 27001, NIS2, and DORA controls, all for a fraction of what tools like AppCheck or Qualys cost.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/decloakwebsecurityintelligence/decloak-app-icon.png\",\"niche_kws\":[\"security\",\"devtools\",\"AI\",\"compliance\",\"web-security\",\"pentesting\",\"SaaS\"],\"icp_kws\":[],\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-18T14:57:07.762034+00:00\",\"id\":19467,\"codename\":\"CrabTap\",\"slug\":\"crabtap\",\"problem_label\":\"Digital loyalty cards for local businesses, no app required\",\"solution_label\":\"CrabTap is a digital loyalty platform for small local businesses like cafés, barbershops, and ice cream shops. Instead of building a native app or paying for infrastructure meant for big chains, venues get an affordable way to run stamps and points programs. Customers use one account and one QR code across every participating business, earning rewards they can redeem for real perks each venue sets. Owners get a simple scan-and-reward flow at checkout, plus tools to send promotions.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/crabtap/CrabTap-Logo-Icon.png\",\"niche_kws\":[\"loyalty program\",\"digital wallet\",\"QR code\",\"small business\",\"customer retention\",\"stamp card\",\"points program\",\"progressive web app\",\"digital punch card\",\"customer rewards\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-18T18:20:36.321958+00:00\",\"id\":19471,\"codename\":\"My Recomy\",\"slug\":\"myrecomy\",\"problem_label\":\"Get paid for recommending places you love\",\"solution_label\":\"$3a\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/myrecomy/my_recomy_logo_vertical_fondo_blanco.png\",\"niche_kws\":[\"referral marketing\",\"affiliate marketing\",\"loyalty\",\"marketplace\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-19T14:56:05.590689+00:00\",\"id\":19497,\"codename\":\"FLIPWORTH\",\"slug\":\"flipworth\",\"problem_label\":\"SNAP IT. CHECK IT. FLIP IT.\",\"solution_label\":\"FlipWorth is an AI-powered resale tool that identifies items from photos, estimates their resale value, and calculates potential profit and ROI to help resellers decide what’s worth flipping.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/flipworth/flipworth-logo-optically-centered.png\",\"niche_kws\":[\"AI Resale Valuation\",\"Reselling Tools\",\"eBay Price Research\",\"Product Valuation\",\"Resale Price Estimator\",\"Flipping Tools\",\"Marketplace Research\",\"Profit Calculator\",\"Secondhand Selling\",\"Reseller Software\"],\"icp_kws\":[],\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-19T15:27:23.522034+00:00\",\"id\":19498,\"codename\":\"Builder Battles\",\"slug\":\"builderbattles\",\"problem_label\":\"Head to head app showdowns from builders brave enough\",\"solution_label\":\"A daily 1v1 for indie apps. Enter to join the fighter pool. Two apps fight each day. Spectators vote with X or Google. Yesterday’s winner stays pinned. Built for makers who want a public fight, not another silent launch.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/builderbattles/builder-battles-logo-1024.png\",\"niche_kws\":[\"Social media\",\"builders\",\"indie hacking\",\"launch\"],\"icp_kws\":[],\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true},{\"created_at\":\"2026-09-19T18:04:53.792607+00:00\",\"id\":19504,\"codename\":\"Upnext\",\"slug\":\"upnext\",\"problem_label\":\"Publish, distribute and track traffic across Facebook Pages\",\"solution_label\":\"Upnext is a Facebook-first publishing and traffic platform built for publishers, media teams and businesses managing multiple Facebook Pages. Schedule and distribute content across Pages, organize Pages into groups, customize and rotate branded domains, control publishing intervals, track clicks with automatic UTM parameters, analyze traffic and engagement, discover trending content, use AI-assisted content creation, and safely manage or clean up published content — all from one workspace.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/upnext/Upnext-logo.png\",\"niche_kws\":[\"Facebook\",\"Facebook Marketing\",\"Social Media Management\",\"Social Media Scheduling\",\"Facebook Publishing\",\"Marketing Automation\",\"Social Media Analytics\",\"Traffic Analytics\",\"Content Scheduling\",\"Content Marketing\"],\"icp_kws\":[],\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"fi