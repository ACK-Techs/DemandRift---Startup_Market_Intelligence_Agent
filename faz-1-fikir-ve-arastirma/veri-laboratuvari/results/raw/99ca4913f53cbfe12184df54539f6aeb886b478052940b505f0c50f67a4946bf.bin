aker\":false},{\"vote_id\":18898,\"created_at\":\"2026-07-27T06:10:16.393534+00:00\",\"user_id\":\"67726ed5-0c74-42ff-bd6d-da08fccb042a\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJU59PUAVuSGLoXnfvBVn2jQo-A6s8OlNYBDsY3rjywFg4MSQ=s96-c\",\"feedback\":\"It's very useful; I rely on it for all my podcast voiceovers.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":16705,\"created_at\":\"2026-07-01T15:52:11.365164+00:00\",\"product_id\":17213,\"version\":\"v1\",\"url\":\"https://adsbud.ai/\",\"status\":\"live\",\"description\":\"AdsBud is an AI marketing agent that runs your Meta and Google Search campaigns from one chat, in plain language. It reads live performance and your actual setup on a schedule, scoring every campaign against today's number, your 7-day average, and your since-launch baseline, so it catches the leaks surface metrics hide. It proposes every fix with the reasoning attached, and nothing changes without your one-click approval. Solo from $29/mo.\",\"maker_name\":\"Andrey Teologov\",\"maker_avatar_url\":\"https://pbs.twimg.com/profile_images/1971250298858409984/Y5Jk5Ff5_normal.jpg\",\"maker_social_handle\":\"\",\"hero_img\":\"\",\"batch_num\":202607,\"start_date\":\"2026-07-03\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":11,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.090909090909091,\"score_execution\":4.5,\"product_points\":3468,\"product_points_week\":3868,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19436,\"created_at\":\"2026-08-06T07:55:28.871408+00:00\",\"user_id\":\"e186ec02-0cfa-4cd0-aad6-d86ced7adc4e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLLOrHZBYj-4KrFvKQkPAVKBJcdYIbiYsrJAP6p6KeoUd78hA=s96-c\",\"feedback\":\"An AI media buyer lives or dies on guardrails - does it cap daily spend autonomously or ask before scaling a winner? That answer belongs on the landing page, it's the first thing a founder worries about.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19294,\"created_at\":\"2026-08-04T08:32:09.510847+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"AdsBud Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18967,\"created_at\":\"2026-07-28T14:29:55.300536+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"AdsBud Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18346,\"created_at\":\"2026-07-04T12:36:37.479536+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"AI chat for campaign management is brilliant - natural language interface removes friction. Love the baseline scoring. Consider: multi-account dashboard, budget alerts, competitor benchmark integration, A/B test templates, Slack notificatio\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17004,\"created_at\":\"2026-07-15T15:18:39.439483+00:00\",\"product_id\":17510,\"version\":\"v1\",\"url\":\"https://nugget.coach\",\"status\":\"live\",\"description\":\"Reading self-improvement books feels productive. A month later, you remember almost none of it. Nugget puts the best ideas from those books at your fingertips — as a Duolingo-style game, not a library. Tell the AI coach what's actually happening in your life (\\\"my manager keeps dismissing my ideas\\\") and it serves the exact concept you need, as a bite-sized session you play, not read.\\n\\nThen Nugget makes it stick: three different exercise formats per concept so you truly retrieve it, a concrete if-then plan to use it in real life, and science-backed spaced repetition that resurfaces ideas right before your brain drops them.\",\"maker_name\":\"Saumye Srivastava\",\"maker_avatar_url\":\"https://pbs.twimg.com/profile_images/1991281869384822784/NT_p-vIu_normal.jpg\",\"maker_social_handle\":\"saumyesrivastav\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/nugget/Screenshot-2026-07-15-at-20.43.33.png\",\"batch_num\":202607,\"start_date\":\"2026-07-20\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":8,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":4.5,\"product_points\":3453,\"product_points_week\":3853,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19316,\"created_at\":\"2026-08-04T09:36:15.920388+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Nugget Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18994,\"created_at\":\"2026-07-29T07:13:05.750671+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Nugget Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":16886,\"created_at\":\"2026-07-10T20:47:36.825634+00:00\",\"product_id\":17393,\"version\":\"v1\",\"url\":\"https://geopatrol.net/\",\"status\":\"live\",\"description\":\"GeoPatrol is an advanced IP intelligence platform that provides accurate geolocation, network, ASN, proxy, VPN, and security insights. Instantly analyze IP addresses with reliable global data to improve cybersecurity, fraud prevention, traffic analysis, and business decision-making through a fast, intuitive online service.\",\"maker_name\":\"Softech Tools Ltd\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/geopatrol/Screenshot-2026-07-04-at-17.12.06.png\",\"batch_num\":202607,\"start_date\":\"2026-07-11\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":15,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.133333333333334,\"score_execution\":4.333333333333333,\"product_points\":3435,\"product_points_week\":3835,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19305,\"created_at\":\"2026-08-04T09:29:40.934952+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"GeoPatrol Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18951,\"created_at\":\"2026-07-28T14:01:36.721791+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"vote