sZlO4WBYf6fanjkFgLPeg2A8WqNA4AxD_A=s96-c\",\"maker_social_handle\":\"\",\"hero_img\":\"\",\"batch_num\":202607,\"start_date\":\"2026-07-14\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":8,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.25,\"score_execution\":5,\"product_points\":3613,\"product_points_week\":4013,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19301,\"created_at\":\"2026-08-04T09:27:27.651471+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"FindyourAI Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18968,\"created_at\":\"2026-07-28T14:30:41.700024+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"FindyourAI Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18665,\"created_at\":\"2026-07-15T15:45:54.314562+00:00\",\"user_id\":\"842bddea-85e8-45f3-96c6-7a017a88a4ee\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocI-SJ9EVvJ12KS8Z7dnLU8H_luk4ec38kVCz6APK_uebKfUOw=s96-c\",\"feedback\":\"FindyourAI has great potential! A few improvements could make it even better. I'd love to share my feedback and suggestions.\\n\\nWhatsApp: https://wa.me/447307349530\\nTelegram: t.me/rforrank\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18582,\"created_at\":\"2026-07-14T10:03:38.574366+00:00\",\"user_id\":\"e0406dda-4ae0-47b0-8322-3bb2d2610380\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKYwQz4FYgo-47IewBFfJJQ9Y3okVrD4LVnBodZ67nge3DEmg=s96-c\",\"feedback\":\"I like how FindYourAI makes it easier to discover useful AI tools without feeling overwhelmed. It is simple to browse, clearly organized, and helps me compare options much faster than searching manually.\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":16818,\"created_at\":\"2026-07-07T13:09:39.657923+00:00\",\"product_id\":17325,\"version\":\"v1\",\"url\":\"https://toolport.app\",\"status\":\"live\",\"description\":\"Toolport is a free, open-source, local-first MCP gateway. Set up and authenticate each MCP server once, and every AI client (Claude, Cursor, VS Code, Codex and the rest) shares it. Your agent loads a handful of meta-tools instead of hundreds, cutting tool-token overhead up to 91%. Every call is fingerprinted for tampering, your API keys stay in the OS keychain, and you get a full audit trail. No containers, no sign-up.\",\"maker_name\":\"Tyler\",\"maker_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJ_KUDTsR8I_b9oMugZM7pyEehoGyKfnjZxScKRadzIMEXmoPPscA=s96-c\",\"maker_social_handle\":\"btsouth\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/toolport/toolport-microlaunch-hero-safe.png\",\"batch_num\":202607,\"start_date\":\"2026-07-07\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":16,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.1875,\"score_execution\":5,\"product_points\":3603,\"product_points_week\":4003,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19444,\"created_at\":\"2026-08-06T07:58:39.280971+00:00\",\"user_id\":\"e186ec02-0cfa-4cd0-aad6-d86ced7adc4e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLLOrHZBYj-4KrFvKQkPAVKBJcdYIbiYsrJAP6p6KeoUd78hA=s96-c\",\"feedback\":\"Consolidating MCP servers behind one port solves a real config-sprawl problem. How does auth work - one token for all servers or per-server scoping? Per-server would be my requirement.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19302,\"created_at\":\"2026-08-04T09:28:01.80272+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Toolport Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18954,\"created_at\":\"2026-07-28T14:05:52.415862+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Toolport Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18465,\"created_at\":\"2026-07-09T08:57:49.63687+00:00\",\"user_id\":\"9b5f3216-95e6-4dad-8109-45874ac1ac7f\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJqYdNFGzUwuARzutJazH7r3Dilv-gK6nEz_n6vNIHjvD5WhcM=s96-c\",\"feedback\":\"Toolpo has great potential and offers some useful features, but I encountered a few issues that could be improved. Please contact me so I can share detailed feedback and suggest the changes I'd like to see.\\n\\nWhatsApp: https://wa.me/44730734\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18455,\"created_at\":\"2026-07-08T19:44:31.743644+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"Smart MCP server consolidation - solves real DevOps pain. Consider: server monitoring dashboard, auto-discovery, deployment scripts, API docs, free indie tier. Infrastructure-as-code approach wins adoption. Strong product-market fit.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18436,\"created_at\":\"2026-07-07T19:27:13.298099+00:00\",\"user_id\":\"a29fcd20-ca76-4d6e-acdb-428b0bb3ccdf\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIOSBiWfPltuiYExan94jeQBjN9ZE3JmQJTNaNCMkmY9trpNdJ2gA=s96-c\",\"feedback\":\"Made it very easy to connect all of my mcp servers \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18433,\"created_at\":\"2026-07-07T13:18:22.194521+00:00\",\"user_id\":\"0dde6914-858f-4660-acb2-748edd8f5ddc\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJ_KUDTsR8I_b9oMugZM7pyEehoGyKfnjZxScKRadzIMEXmoPPscA=s96-c\",\"feedback\":\"Toolport is a must-have for anyone using MCP servers with AI agents. It makes it easy to manage every server in one place and connect them to your agents with ease. The additional security features are icing on the cake.\",\"is_roast\":false,\"is_feedback_by_maker\":true}],\"final_score\":\"$undefined\"},{\"id\":16978,\"created_at\":\"2026-07-14T12:30:01.619528+00:00\",\"product_id\":17484,\"version\":\"v1\",\"url\":\"https://veriwasp.com\",\"status\":\"live\",\"description\":\"VeriWasp is an AI-powered automated testing tool built for indie SaaS founders. Describe any user flow in plain English (signup, checkout, onboarding, etc.), and AI drives a real browser to execute it. Get a data rich report with full trace replay, and WCAG accessibility reports that adapt when your UI changes, no brittle scripts. Veriwasp also offers API testing, full-site a11y scans, Chaos mode, and CI/CD integration. Start with 10 free runs. 