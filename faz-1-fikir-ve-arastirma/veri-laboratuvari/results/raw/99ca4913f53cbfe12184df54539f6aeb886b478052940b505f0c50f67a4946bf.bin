_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":2873,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19275,\"created_at\":\"2026-08-04T08:25:34.518318+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"PartnerUp Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19218,\"created_at\":\"2026-08-02T04:28:41.061254+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"Great concept solving real founder pain point. Profile vetting approach is smart. Suggestion: add skill badges and past project track records visible on profiles to help founders assess compatibility faster and reduce early collaboration mi\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17241,\"created_at\":\"2026-07-23T20:12:06.216003+00:00\",\"product_id\":17745,\"version\":\"v1\",\"url\":\"https://facesage.app/\",\"status\":\"live\",\"description\":\"Upload a photo and get an AI face reading grounded in real facial measurements and six face-reading traditions — character, dating style, compatibility. No horoscope filler; first reading free.\",\"maker_name\":\"FaceSage\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@FaceSageApp/avatar.png\",\"maker_social_handle\":\"FaceSageApp\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/facesage/facebook-cover-1640x624.png\",\"batch_num\":20260