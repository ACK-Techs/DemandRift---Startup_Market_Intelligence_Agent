-06-10\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":15,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.2,\"score_execution\":4.333333333333333,\"product_points\":2945,\"product_points_week\":3845,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19065,\"created_at\":\"2026-07-29T07:45:45.930389+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Blur It Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18666,\"created_at\":\"2026-07-15T15:46:20.899843+00:00\",\"user_id\":\"842bddea-85e8-45f3-96c6-7a017a88a4ee\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocI-SJ9EVvJ12KS8Z7dnLU8H_luk4ec38kVCz6APK_uebKfUOw=s96-c\",\"feedback\":\"Blur It has great potential! A few improvements could make it even better. I'd love to share my feedback and suggestions.\\n\\nWhatsApp: https://wa.me/447307349530\\nTelegram: t.me/rforrank\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":18192,\"created_at\":\"2026-06-27T06:26:18.832801+00:00\",\"user_id\":\"ffbc7dee-ef7f-46c7-b8b8-31ba26ae538d\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIuE6n1MpXL5Mc0G7DB88HT7GrwszyEAy4wWbRNEEb8U6ir4SQe1Q=s96-c\",\"feedback\":\"Smart solution for a real pain point - screen recording. Solves the API key exposure issue elegantly. To scale: 1) Preset blur patterns for common fields (emails, IPs), 2) Team/enterprise licensing, 3) Integration with Slack/Discord to shar\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18048,\"created_at\":\"2026-08-21T05:04:12.857462+00:00\",\"product_id\":18545,\"version\":\"v1\",\"url\":\"https://ripn.app\",\"status\":\"live\",\"description\":\"Ripn is a grocery tracking app that turns receipts into spending data. Take a photo of your receipt and Ripn automatically reads the items, prices, categories, and dates. See where your grocery money goes, keep track of what may expire, and record what you throw away. It helps you understand both how much you spend on groceries and how much of that money ends up wasted.\",\"maker_name\":\"Kailoh Metellus\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/ripn/Know-what-you-spend-on-groceries.png\",\"batch_num\":202608,\"start_date\":\"2026-08-21\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":5,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.4,\"score_execution\":0,\"product_points\":2937,\"product_points_week\":2837,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":17541,\"created_at\":\"2026-08-04T15:25:26.000858+00:00\",\"product_id\":18040,\"version\":\"v1\",\"url\":\"https://gofindevo.com\",\"status\":\"live\",\"description\":\"Reddit is full of founders describing the exact problem your product solves. FindEvo scans the subreddits that matter, scores every post by how close that person is to buying, and checks the rules of each community before you say anything. You get an intent score, a ban risk read, and a specific way to approach that one conversation. No generated messages. You write it in your own words.\",\"maker_name\":\"Akın\",\"maker_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJSIGyPRWetXmOcvtNQ0JcG2NSJS377Mb8sjyWtQa_bSD-Niz8=s96-c\",\"maker_social_handle\":\"akinkep\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/findevo/findevo-hero-680x340.png\",\"batch_num\":202608,\"start_date\":\"2026-08-04\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":12,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.25,\"score_execution\":0,\"product_points\":2913,\"product_points_week\":2813,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19904,\"created_at\":\"2026-08-20T16:57:58.496098+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"FindEvo Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19469,\"created_at\":\"2026-08-06T09:38:13.150261+00:00\",\"user_id\":\"e186ec02-0cfa-4cd0-aad6-d86ced7adc4e\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLLOrHZBYj-4KrFvKQkPAVKBJcdYIbiYsrJAP6p6KeoUd78hA=s96-c\",\"feedback\":\"Nearly clean launch - HSTS is in place. One gap: no Content-Security-Policy. For a tool rendering external Reddit content, CSP is the difference between a stored-XSS annoyance and an account takeover. next.config.js headers(), report-only first.\",\"is_roast\":true,\"is_feedback_by_maker\":false},{\"vote_id\":19397,\"created_at\":\"2026-08-04T17:28:52.01268+00:00\",\"user_id\":\"d5c60f0b-af8d-497f-8fa1-1f7e945c5555\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKW-JrXrkEes0CD7HZaMjGV7ta_EvYuZa59aSukAcBMf1K4Kg=s96-c\",\"feedback\":\"been a while\\n\\ni finally shipped my own product, it's on microlaunch today. if you take a look, leave a line about who you think it's for. i keep getting that part wrong and an outside read helps more than my own guess\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19394,\"created_at\":\"2026-08-04T16:09:02.17675+00:00\",\"user_id\":\"7dcbd62d-bade-40ae-9914-f41595183d24\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKIR_EALZVgBNhJpXFn0s4xf8xcjNL0TbgggDTxeZoQOXmq4Q=s96-c\",\"feedback\":\"findevo is live on microlaunch today\\n\\nyou don't need to know the space for this. read the page and drop a comment saying what you think it does. if it isn't clear, say that instead. that's more useful to me than a congrats\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19393,\"created_at\":\"2026-08-04T15:53:55.902961+00:00\",\"user_id\":\"d2e5a4fd-41f4-46ba-b573-05dd59eb5aad\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocImJT2JNHcpuKOWQKdUuW5hOt3JNRbLrRfvK2F-ltGUqTK1z8h9=s96-c\",\"feedback\":\"Beta aşamasından beri kullanıyorum, ürünüm için çok iyi bir platform oldu. Tebrikler.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17599,\"created_at\":\"2026-08-05T21:39:07.353672+00:00\",\"product_id\":18098,\"version\":\"v1\",\"url\":\"https://tradoshi.com/en/\",\"status\":\"live\",\"description\":\"Tradoshi is a trading journal that turns your trades into decisions.\\nConnect one broker account for free, forever, no card, or just drop in\\na statement. You get your real risk per trade, R-multiple, expectancy\\nand drawdown, an Oshi Score that rates your discipline, a pre-session\\ncheck-in that flags the days you shouldn't trade, and an AI coach that\\nnames the habits costing you money.\\n\",\"maker_name\":\"Benjamin\",\"maker_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIyGH9saYEFGtrtrUbS8H5zOM9Pl-k1fcNRTFdeAVzovQhpTg=s96-c\",\"maker_social_handle\":\"TradoshiHQ\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/tradoshi/tradoshi-hero-680x340.png\",\"batch_num\":202608,\"start_date\":\"2026-08-08\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":10,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.2,\"score_execution\":0,\"product_points\":2905,\"product_points_week\":2805,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19908,\"created_at\":\"2026-08-20T16:59:12.410815+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Tradoshi Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17832,\"created_at\":\"2026-08-14T12:08:42.848947+00:00\",\"product_id\":18334,\"version\":\"v1\",\"url\":\"https://www.qwelto.online/?utm_source=microlaunch\u0026utm_medium=launch_directory\u0026utm_campaign=qwelto_launch_2026\",\"status\":\"live\",\"description\":\"Qwelto helps you make a logo and matching brand assets without writing design prompts. Start with a set of visual options and pick the ones that feel closest to what you want. Qwelto learns from those choices and uses the same direction for banners, website cards and social posts. Logos are free to create and download. The $29 Founder Pass unlocks the rest of the brand kit.\",\"maker_name\":\"Yazid\",\"maker_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJpGXNgg9ND4SsiDjn06HxU2cfq1RN7Dcn8inceGo1-za_f7g=s96-c\",\"maker_social_handle\":\"iwndixuebdu\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/qwelto/qwelto-hero-680x340.png\",\"batch_num\":202608,\"start_date\":\"2026-08-17\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":7,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.142857142857143,\"score_execution\":0,\"product_points\":2896,\"product_points_week\":2796,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[{\"vote_id\":19912,\"created_at\":\"2026-08-20T17: