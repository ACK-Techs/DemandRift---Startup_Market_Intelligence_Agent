rection.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/seedance30/logo_s3.png\",\"niche_kws\":\"$3cc\",\"icp_kws\":\"$3cd\",\"market\":\"ai\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3cf:[]\n3d0:[]\n3ce:{\"created_at\":\"2026-09-03T14:37:30.708101+00:00\",\"id\":18986,\"codename\":\"InfoLobby\",\"slug\":\"infolobby\",\"problem_label\":\"Everything a custom internal app does. Nothing you have to maintain.\",\"solution_label\":\"InfoLobby gives you one place to run the work: tables with real field types and relationships, grid, kanban, calendar and gallery views, tasks, comments, files and full history on every record. Visual flows automate the busywork, web forms and inbound email bring work in, and a public REST API takes it anywhere else. Unlimited users on every plan.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/infolobby/logo.png\",\"niche_kws\":\"$3cf\",\"icp_kws\":\"$3d0\",\"market\":\"team-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3d2:[\"indie hackers\",\"build in public\",\"internet radio\",\"founder news\",\"live radio\",\"AI\",\"SaaS\",\"makers\"]\n3d3:[]\n3d1:{\"created_at\":\"2026-09-03T18:28:21.625637+00:00\",\"id\":18994,\"codename\":\"X-Radio.FM\",\"slug\":\"xradiofm\",\"problem_label\":\"Radio for Founders Building in Public\",\"solution_label\":\"The stories founders post on X — launches, first dollars, hard weeks — read out loud by a host on one station that never goes off the air. Stop scrolling and listen. One day it is your name.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/xradiofm/xradiologo-1-.png\",\"niche_kws\":\"$3d2\",\"icp_kws\":\"$3d3\",\"market\":\"podcast\",\"product_type\":\"Info product, Newsletters, Communities\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3d5:[\"transcription\",\"speech-to-text\",\"video transcription\",\"audio transcription\",\"ai transcription"])</script><script>self.__next_f.push([1,"\",\"speaker diarization\"]\n3d6:[]\n3d4:{\"created_at\":\"2026-09-04T06:29:05.089567+00:00\",\"id\":19003,\"codename\":\"video2text\",\"slug\":\"video2text\",\"problem_label\":\"Turn any video or audio into clean text in minutes.\",\"solution_label\":\"video to text is an ai-powered transcription service that converts video and audio files, as well as video links, into clean, exportable text. the product is designed for creators, teams, and individuals who need fast, accurate speech-to-text conversion without setting up their own transcription pipeline.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/video2text/logo.png\",\"niche_kws\":\"$3d5\",\"icp_kws\":\"$3d6\",\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3d8:[\"Creator platform\",\"courses\",\"monetization\",\"newsletter\",\"blog\",\"resume builder\",\"portfolio\",\"content sales\"]\n3d9:[]\n3d7:{\"created_at\":\"2026-09-04T07:17:36.459225+00:00\",\"id\":19007,\"codename\":\"Facet Cloud\",\"slug\":\"facetcloud\",\"problem_label\":\"Your site, courses, and audience, together.\",\"solution_label\":\"Facet is the creator platform that replaces your website builder, course host, newsletter tool, community app and checkout. It runs on your domain and connects to your Stripe account.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/facetcloud/icon.png\",\"niche_kws\":\"$3d8\",\"icp_kws\":\"$3d9\",\"market\":\"cloud\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3db:[\"Live subtitles and real-time translation for every meeting\",\"Live AI Translation with Real-time Subtitles\"]\n3dc:[]\n3da:{\"created_at\":\"2026-09-04T07:46:29.677313+00:00\",\"id\":19008,\"codename\":\"meelang\",\"slug\":\"meelang1\",\"problem_label\":\"MeeLang is a real-time AI translator for Google Meet\",\"solution_label\":\"MeeLang is a real-time AI translator for Google Meet. It is a chrome extension that translates what everyone says into your own language and puts it on screen as live "])</script><script>self.__next_f.push([1,"subtitles.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/meelang1/logo.png\",\"niche_kws\":\"$3db\",\"icp_kws\":\"$3dc\",\"market\":\"ai\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3de:[\"ai agents\",\"mcp servers\",\"agent skills\",\"mcp\",\"model context protocol\",\"agentic ai\",\"ai directory\",\"ai tools directory\",\"llm agents\",\"autonomous agents\",\"ai automation\",\"developer tools\",\"agent tools\",\"claude code\",\"mcp registry\",\"ai marketplace\"]\n3df:[]\n3dd:{\"created_at\":\"2026-09-05T05:50:09.181217+00:00\",\"id\":19033,\"codename\":\"AI Agents Listing\",\"slug\":\"aiagentslisting\",\"problem_label\":\"​​AI agents, MCP servers and skills. One directory.​\",\"solution_label\":\"A directory of AI agents, MCP servers and agent skills, cross-linked so you can see what works with what. Free to list.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/aiagentslisting/favicon.png\",\"niche_kws\":\"$3de\",\"icp_kws\":\"$3df\",\"market\":\"ai\",\"product_type\":\"Directory, Store or Marketplace\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3e1:[]\n3e2:[]\n3e0:{\"created_at\":\"2026-09-05T13:52:51.814033+00:00\",\"id\":19044,\"codename\":\"Radar\",\"slug\":\"radar\",\"problem_label\":\"Get customers from Reddit without ads or getting banned\",\"solution_label\":\"Radar finds Reddit threads where someone is describing the exact problem your product solves, scores them, and drafts the reply. You review, tweak a word, paste. Nothing is ever auto-posted. Built-in anti-ban guardrails do the boring part: it audits each subreddit's real rules, caps mentions at one per sub, enforces cooldowns, and a simulated moderator reads every pitched draft before you see it. Built by a founder who got banned learning why this matters.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/radar/radar-lockup-512.png\",\"niche_kws\":\"$3e1\",\"icp_kws\":\"$3e2\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favo"])</script><script>self.__next_f.push([1,"rite\":false,\"is_premium\":true}\n3e4:[\"Sales\",\"marketing\",\"advertising\",\"intelligence\",\"research\"]\n3e5:[]\n3e3:{\"created_at\":\"2026-09-06T03:47:15.385366+00:00\",\"id\":19058,\"codename\":\"Peregrine OS\",\"slug\":\"peregrineos\",\"problem_label\":\"Pre-call intel and daily signal feeds for agency new business.\",\"solution_label\":\"Peregrine OS is a suite of B2B intelligence tools built on the Flightpath.AI engine: pre-call prospect intel, account-level pitch briefings, and daily feeds tracking exec hires, funding, AOR gaps, and marketing news — for agency new business and consulting BD teams.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/peregrineos/IMG_1685.png\",\"niche_kws\":\"$3e4\",\"icp_kws\":\"$3e5\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3e7:[\"dofollow directory\",\"free site listing\",\"public directory\",\"backlink\",\"SaaS directory\",\"AI tools\",\"no login\",\"curl submit\",\"startup directory\",\"website directory\"]\n3e8:[]\n3e6:{\"created_at\":\"2026-09-06T18:37:32.066116+00:00\",\"id\":19069,\"codename\":\"Qevra\",\"slug\":\"qevra\",\"problem_label\":\"List free. Public page. Dofollow backlink.\",\"solution_label\":\"Qevra is a free public directory. Paste a URL. We publish a page and a dofollow outbound link. No login. No queue. Ads are optional and labeled Ad. A homepage ad is $39.99 every 30 days. A listing-page ad is $49.99 on a specific site page, including a competitor's. Card ads renew every 30 days until you cancel. We do not promise rankings or traffic. Over 300 sites are listed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/qevra/logo-128.png\",\"niche_kws\":\"$3e7\",\"icp_kws\":\"$3e8\",\"market\":\"directories\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3ea:[\"home inventory\",\"inventory app\",\"home organization\",\"household\",\"ios\",\"ipad\",\"moving\",\"insurance\",\"declutter\",\"productivity\"]\n3eb:[]\n3e9:{\"created_at\":\"2026-09-06T21:15:33.369924+00:00\",\"id\":190"])</script><script>self.__next_f.push([1,"78,\"codename\":\"Itemlist\",\"slug\":\"itemlist\",\"problem_label\":\"Inventory tracker that maps every room and box\",\"solution_label\":\"The stuff you own ends up in boxes inside boxes, at home and at work. Itemlist tracks it the way your spaces work: a location for each property, rooms inside, and containers nested to any depth, shared with your household or team on PRO, with insurance-ready records and CSV export. Free to start with 100 items.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/itemlist/microlaunch-logo-512.png\",\"niche_kws\":\"$3ea\",\"icp_kws\":\"$3eb\",\"market\":\"productivity\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3ed:[\"AI Journal\",\"Personal Growth\",\"Self Reflection\",\"Journaling\",\"Life Mapping\",\"Memory\",\"Personal Insights\",\"Mental Wellness\",\"Life Story\",\"Self Discovery\"]\n3ee:[]\n3ec:{\"created_at\":\"2026-09-06T21:21:44.507937+00:00\",\"id\":19079,\"codename\":\"Reflect\",\"slug\":\"reflect\",\"problem_label\":\"See your life in ways you never could before.\",\"solution_label\":\"An intelligent journal that turns your memories into insight.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/reflect/Reflect-Logo.png\",\"niche_kws\":\"$3ed\",\"icp_kws\":\"$3ee\",\"market\":\"lifestyle\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3f0:[\"API\",\"Dev Tool\",\"AI Agent\"]\n3f1:[]\n3ef:{\"created_at\":\"2026-09-07T08:42:20.674293+00:00\",\"id\":19089,\"codename\":\"SocialCrawl\",\"slug\":\"socialcrawl\",\"problem_label\":\"One unified API for all social media data.\",\"solution_label\":\"SocialCrawl is a unified social media data API that gives developers and AI agents access to clean, structured data through a single API key. We power AI agents by providing the API to search, scrape, and interact with social media at scale. \",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/socialcrawl/Socialcrawl-2-.png\",\"niche_kws\":\"$3f0\",\"icp_kws\":\"$3f1\",\"market\":\"dev-tools\",\"product_t"])</script><script>self.__next_f.push([1,"ype\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3f3:[\"AI\",\"compliance\",\"regulation\",\"execution layer\"]\n3f4:[]\n3f2:{\"created_at\":\"2026-09-07T12:12:23.671442+00:00\",\"id\":19093,\"codename\":\"Labrynth \",\"slug\":\"labrynth\",\"problem_label\":\"AI regulatory intelligence platform that turns complex requirements into cited, audit-ready outputs.\",\"solution_label\":\"The platform maps obligations, validates documents and evidence, and helps teams move faster through complex compliance, licensing, permitting, and approval workflows while keeping experts in control.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/labrynth/LABRYNTH-BLACK.png\",\"niche_kws\":\"$3f3\",\"icp_kws\":\"$3f4\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n3f6:[\"Financial Markets\",\"Market Visualization\",\"Stock Market\",\"Cryptocurrency\",\"Forex\",\"ETFs\",\"Market Analytics\",\"Trading Tools\",\"Investment Research\",\"Bubble Charts\"]\n3f7:[]\n3f5:{\"created_at\":\"2026-09-07T15:43:43.727682+00:00\",\"id\":19100,\"codename\":\"bubble markets\",\"slug\":\"bubblemarkets\",\"problem_label\":\"See global financial markets move on one interactive bubble map.\",\"solution_label\":\"BubbleMarkets is a multi-asset financial market visualization platform that transforms stocks, ETFs, cryptocurrencies, forex, commodities, bonds and global indices into interactive bubble maps. Users can quickly identify market leaders, laggards, price movements and trading activity through an intuitive visual interface. With flexible filters, multiple timeframes, watchlists, charts, market data and news, BubbleMarkets helps traders, investors and analysts understand what is moving across global markets without switching between multiple financial platforms.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/bubblemarkets/WhatsApp-Image-2026-09-07-at-20.15.13.jpeg\",\"niche_kws\":\"$3f6\",\"icp_kws\":\"$3f7\",\"market\":\"fintech\",\"product_type\":\"Web Tool/App\",\"offer"])</script><script>self.__next_f.push([1,"_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n3f9:[\"ui/ux testing\",\"automated browser testing\",\"ai agents\",\"ai testing\"]\n3fa:[]\n3f8:{\"created_at\":\"2026-09-07T21:48:28.19483+00:00\",\"id\":19105,\"codename\":\"SanityCheck\",\"slug\":\"sanitycheck\",\"problem_label\":\"AI Agents test your application like real users.\",\"solution_label\":\"Describe your test. That's it. AI agents open real cloud browsers and test your app like actual users. Watch live, replay every click, trigger on every GitHub, GitLab, or Vercel deploy. Free tier. No card needed.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sanitycheck/directory-logo-1024.png\",\"niche_kws\":\"$3f9\",\"icp_kws\":\"$3fa\",\"market\":\"dev-tools\",\"product_type\":\"AI Assistant\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3fc:[\"#meditation\",\"#calm\",\"#focus\",\"#reset\",\"#personalised\"]\n3fd:[]\n3fb:{\"created_at\":\"2026-09-07T22:03:09.781817+00:00\",\"id\":19106,\"codename\":\"Shora\",\"slug\":\"shora\",\"problem_label\":\"Meditation for how you feel right now.\",\"solution_label\":\"Check in with how you feel — one tap or a few words — and Shora composes a 2–10 minute guided session from 20 evidence-based techniques, narrated in your language, then learns what works for you. Free to start on iPhone and Android.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/shora/store-icon.png\",\"niche_kws\":\"$3fc\",\"icp_kws\":\"$3fd\",\"market\":\"lifestyle\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n3ff:[\"incident response\",\"cybersecurity\",\"nonprofit\",\"compliance\",\"SaaS\",\"audit-ready\",\"NIST\",\"CIS controls\",\"small business\",\"security planning\"]\n400:[]\n3fe:{\"created_at\":\"2026-09-07T23:30:23.621207+00:00\",\"id\":19108,\"codename\":\"IRPForge\",\"slug\":\"irpforge\",\"problem_label\":\"Audit-ready incident response plans, without the consultant price tag\",\"solution_label\":\"IRPForge generates branded, audit-ready incident response plans for nonprofits"])</script><script>self.__next_f.push([1," and small organizations. Answer a few questions about your team and systems, and get a Master IRP, Incident Report Form, and Emergency Contact One-Pager, built on NIST and CIS frameworks. No security background needed. Consultants charge $5,000-$15,000+ for this. IRPForge starts at $199, one-time.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/irpforge/irpforge_logo_128x128.png\",\"niche_kws\":\"$3ff\",\"icp_kws\":\"$400\",\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n402:[\"AI repair\",\"file repair\",\"video repair\",\"photo repair\",\"audio repair\",\"document repair\",\"AI enhancement\",\"photo eraser\"]\n403:[]\n401:{\"created_at\":\"2026-09-08T07:38:24.691231+00:00\",\"id\":19118,\"codename\":\"Wondershare Repairit\",\"slug\":\"wondersharerepairit\",\"problem_label\":\"AI-powered data repair for videos, photos, audio, and files in minutes.\",\"solution_label\":\"Wondershare Repairit is an AI-powered media repair and enhancement tool that quickly fixes corrupted videos, photos, audio, and documents. Beyond recovery, it brings your visuals to life with advanced AI old photo restoration, Image to Video generation, and smart One-prompt Photo Editing across all devices.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wondersharerepairit/Wondershare-Repairit.png\",\"niche_kws\":\"$402\",\"icp_kws\":\"$403\",\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n405:[\"Marketing\",\"Growth\",\"AI-Visibility\",\"Keyword Research\",\"Competitor Analysis\",\"Brand Monitoring\"]\n406:[]\n404:{\"created_at\":\"2026-09-08T16:41:14.435808+00:00\",\"id\":19136,\"codename\":\"TrustGrowth\",\"slug\":\"trustgrowth\",\"problem_label\":\"Your Growth Engine. Verified SEO Scores. Open SEO Playbook. Public SEO Proof\",\"solution_label\":\"TrustGrowth is a continuous growth engine that turns evidence across 8 growth pillars into priorities, plans and approval-gated actions. It measures, diagnos"])</script><script>self.__next_f.push([1,"es, learns from outcomes and repeats. The public TrustGrowth Score is supporting proof, not the product.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/trustgrowth/tg-logo.jpeg\",\"niche_kws\":\"$405\",\"icp_kws\":\"$406\",\"market\":\"seo\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n408:[\"Candlesticks\",\"Trading\",\"Learning\",\"Educational\",\"Charts\"]\n409:[]\n407:{\"created_at\":\"2026-09-08T19:57:17.209172+00:00\",\"id\":19142,\"codename\":\"Chart Drill\",\"slug\":\"chartdrill\",\"problem_label\":\"Learn to read candlestick charts in short lessons.\",\"solution_label\":\"Most people learn trading by watching endless videos and never touching a chart. Chart Drill flips that. Short, Duolingo-style lessons introduce one price action concept, quiz you on real candles, then bring it back later so it sticks. Built by a trader who taught himself the same way. In beta now, free to start, with more units coming.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/chartdrill/avatar-mark.png\",\"niche_kws\":\"$408\",\"icp_kws\":\"$409\",\"market\":\"edtech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true}\n40b:[\"stock scanner\",\"screener\",\"trade ideas\"]\n40c:[]\n40a:{\"created_at\":\"2026-09-09T04:46:07.021814+00:00\",\"id\":19150,\"codename\":\"scanr.ai\",\"slug\":\"scanrai\",\"problem_label\":\"Automate trade ideas to suit your trading personality\",\"solution_label\":\"Scanr.ai is an AI-powered US-equity scanner that turns natural-language and technical/fundamental filters into continuously running realtime watchlists with alerts to help traders automate trade idea discovery, plus ticker research via charts, fundamentals, news, and market data.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/scanrai/scanrai-512.png\",\"niche_kws\":\"$40b\",\"icp_kws\":\"$40c\",\"market\":\"fintech\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n40e:[\"data re"])</script><script>self.__next_f.push([1,"covery\",\"AI search\",\"video recovery\",\"image recovery\"]\n40f:[]\n40d:{\"created_at\":\"2026-09-09T09:19:40.891031+00:00\",\"id\":19163,\"codename\":\"Wondershare Recoverit\",\"slug\":\"wondersharerecoverit\",\"problem_label\":\"AI-powered data recovery and 4K/8K video restoration tool.\",\"solution_label\":\"Wondershare Recoverit is an AI-powered data recovery software designed to restore lost, deleted, or corrupted files across 2,000+ storage devices with a 99.5% success rate. Featuring patented Enhanced Video Recovery technology, it automatically auto-stitches fragmented 4K/8K video clips from camera SD cards, repairs corrupted media, and extracts critical files from crashed computers, formatted drives, and NAS servers in 3 simple steps.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/wondersharerecoverit/DR-LOGO.png\",\"niche_kws\":\"$40e\",\"icp_kws\":\"$40f\",\"market\":\"productivity\",\"product_type\":\"Desktop App\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n411:[\"customer support\",\"chat bot\",\"ai chatbot\",\"customer support chat\",\"sales chatbot\",\"website chat widget\",\"live chat\"]\n412:[]\n410:{\"created_at\":\"2026-09-10T01:44:56.778876+00:00\",\"id\":19180,\"codename\":\"Svellyo\",\"slug\":\"svellyo\",\"problem_label\":\"Sales and support chat with an AI agent trained on your docs.\",\"solution_label\":\"Sales and support chat with an AI agent trained on your docs. Install it on every site you run, answer from a single inbox, and pay for chats instead of seats. Set up in minutes, not a sprint.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/svellyo/icon-512.png\",\"niche_kws\":\"$411\",\"icp_kws\":\"$412\",\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n414:[\"API\",\"Developer Tools\",\"AI Agent\",\"Scrape\",\"Social media\",\"scraper API\",\"scraping API\"]\n415:[]\n413:{\"created_at\":\"2026-09-10T08:12:29.499314+00:00\",\"id\":19193,\"codename\":\"Sociavault\",\"slug\":\"sociavault\",\"problem_label\":\"Best social media s"])</script><script>self.__next_f.push([1,"craping API\",\"solution_label\":\"SociaVault is a unified REST API that extracts real-time data from 25+ social media platforms, including TikTok, Instagram, YouTube, LinkedIn, and Twitter/X.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sociavault/logo.png\",\"niche_kws\":\"$414\",\"icp_kws\":\"$415\",\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n417:[]\n418:[]\n416:{\"created_at\":\"2026-09-10T13:04:13.528453+00:00\",\"id\":19203,\"codename\":\"Hyvor Blogs\",\"slug\":\"hyvorblogs\",\"problem_label\":\"You Publish. We handle the rest.\",\"solution_label\":\"An open-source, bloat-free blogging platform designed for total simplicity. Hyvor Blogs includes everything natively, including comments, newsletters, zero-config SEO, and automated link analysis. You can publish on a custom domain, run as a sub-directory, or go fully headless. Built on the AGPL-3.0 license, it eliminates plugin maintenance and vendor lock-in and offers one-click data exports, real-time team collaboration, live cursors, and AI features out of the box.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logo-001/hyvorblogs/hyvor-blog-social-media.png\",\"niche_kws\":\"$417\",\"icp_kws\":\"$418\",\"market\":\"oss\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n41a:[\"inference marketplace\",\"llm cost-router\",\"openai-compatible api\"]\n41b:[\"ai infrastructure\",\"developer apis\",\"mlops\",\"cloud cost-optimization\",\"llm marketplaces\"]\n419:{\"created_at\":\"2026-09-11T12:02:31.274406+00:00\",\"id\":19236,\"codename\":\"CheaperInference\",\"slug\":\"cheaperinference\",\"problem_label\":\"Slash inference costs with one OpenAI-compatible API.\",\"solution_label\":\"Cheaper Inference is an OpenAI-compatible API marketplace that routes your existing AI workloads to discounted models from multiple providers, cutting inference costs while preserving data controls and detailed usage visibility.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.de"])</script><script>self.__next_f.push([1,"v/logos-001/cheaperinference/logo.png\",\"niche_kws\":\"$41a\",\"icp_kws\":\"$41b\",\"market\":\"ai\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false}\n41d:[]\n41e:[]\n41c:{\"created_at\":\"2026-09-11T16:36:47.042064+00:00\",\"id\":19241,\"codename\":\"Mokko\",\"slug\":\"mokko\",\"problem_label\":\"AI ads every week. Built around what works.\",\"solution_label\":\"Mokko creates fresh AI ads every week, guided by your brand’s performance data. We analyze existing creatives, identify what to test next, and deliver new concepts and variations tailored to your business. Your team or agency keeps control of campaigns and media budgets. No fixed monthly fee: our compensation is a percentage of revenue generated and ad spend on Mokko ads, with terms agreed before we start.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/mokko/download-1-.png\",\"niche_kws\":\"$41d\",\"icp_kws\":\"$41e\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n420:[]\n421:[]\n41f:{\"created_at\":\"2026-09-11T22:17:58.833305+00:00\",\"id\":19249,\"codename\":\"ChannelWeave\",\"slug\":\"channelweave\",\"problem_label\":\"Multichannel commerce, minus the chaos.\",\"solution_label\":\"Calm multichannel commerce for independent sellers. Stock, listings, orders and supported buyer messages together — with Elqori, your private AI assistant.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/channelweave/logo.png\",\"niche_kws\":\"$420\",\"icp_kws\":\"$421\",\"market\":\"marketplaces\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n423:[\"Healthcare SaaS\",\"AI Compliance\",\"HIPAA Compliance Platform that Automates Repetitive Tasks\",\"Automated Gap Analysis\",\"Auto-Generating Remediation Plans\",\"AI-Tailored Policies and Procedures\",\"HIPAA Compliance Training Software\",\"RegTech\",\"Streamlined Vendor and Contract workflows\",\"Built-In Incident Management\"]\n424:[]\n422:{\"created_at\":\"2026-09-12T06:37:15.9238"])</script><script>self.__next_f.push([1,"97+00:00\",\"id\":19255,\"codename\":\"One Guy Consulting\",\"slug\":\"oneguyconsultinghipaacompliancesolutions\",\"problem_label\":\"Keeping HIPAA Auditors Out of YOUR Business\",\"solution_label\":\"OneGuyConsulting.com is the passion project of HIPAA compliance expert and founder Chuck Weiselberg. For eight years Chuck watched healthcare SaaS companies fall behind by refusing to use the technology in front of them. HIPAA is complex, every attempt to simplify it only makes it more confusing. Chuck knew a better way. He automated his methodology, crushed the repetitive work, and built a program that small practices can actually finish.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/oneguyconsultinghipaacompliancesolutions/oneguyconsulting-logo-128.png\",\"niche_kws\":\"$423\",\"icp_kws\":\"$424\",\"market\":\"startup-builders\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n426:[\"WhatsApp Sender\",\"Rocket Sender\",\"WhatsApp Bulk Message Sender\",\"WhatsApp Bulk Sender\",\"WhatsApp Web Sender\",\"WhatsApp Sender Extension\",\"WhatsApp Sender Chrome Extension\",\"Bulk Message Sender\",\"Free WhatsApp Sender\"]\n427:[]\n425:{\"created_at\":\"2026-09-12T07:35:29.394691+00:00\",\"id\":19258,\"codename\":\"WhatsApp Sender\",\"slug\":\"whatsappsender\",\"problem_label\":\"WhatsApp Sender - Rocket Sender\",\"solution_label\":\"Rocket Sender is a free WhatsApp Sender for personalized bulk messaging directly in WhatsApp Web.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/whatsappsender/unnamed-4-.png\",\"niche_kws\":\"$426\",\"icp_kws\":\"$427\",\"market\":\"marketing\",\"product_type\":\"Browser Extension\",\"offer_type\":\"Free product\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n429:[\"AI Detector\",\"Deepfake\",\"Cybersecurity\",\"Video\",\"Privacy\",\"Verification\",\"Artificial Intelligence\",\"Creator Economy\"]\n42a:[]\n428:{\"created_at\":\"2026-09-12T22:41:21.689778+00:00\",\"id\":19275,\"codename\":\"Sealed Rose\",\"slug\":\"sealedrose\",\"problem_label\":\"Free in-browser AI deepfake and synthetic video"])</script><script>self.__next_f.push([1," detector.\",\"solution_label\":\"Sealed Rose Deepfake Video Detector is a free, privacy-first forensic tool that exposes AI-generated videos and facial face-swaps. Frame-by-frame temporal inspection analyzes Sora, Kling, Veo, and Runway artifacts directly in your browser without uploading to external servers. Built for buyers, creators, and platforms to verify genuine human media.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/sealedrose/seal-wax.png\",\"niche_kws\":\"$429\",\"icp_kws\":\"$42a\",\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n42c:[\"Screen Time\",\"Digital Wellbeing\",\"Productivity\",\"Mindful Scrolling\",\"Social Media\",\"Focus\",\"Microlearning\",\"Habit Building\",\"Students\",\"Self Improvement\"]\n42d:[]\n42b:{\"created_at\":\"2026-09-12T23:14:41.973934+00:00\",\"id\":19276,\"codename\":\"ScrollCheckpoint \",\"slug\":\"scrollcheckpoint\",\"problem_label\":\"Add checkpoints to your scrolling \",\"solution_label\":\"ScrollCheckpoint steps in when you try to open a social app, so you don't have to remember to use it first. Set a short Scroll Alarm, start scrolling, and when time's up, complete a quick checkpoint before deciding whether to continue. Turn an automatic scroll into a moment to pause, learn and reset.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/scrollcheckpoint/ScrollCheckPoint-icon-yellow.png\",\"niche_kws\":\"$42c\",\"icp_kws\":\"$42d\",\"market\":\"productivity\",\"product_type\":\"Mobile App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n42f:[\"AI image generator\",\"AI image editor\",\"Text to image\",\"Image to image\",\"Graphic design\",\"Content creation\",\"Ecommerce\",\"Marketing\"]\n430:[]\n42e:{\"created_at\":\"2026-09-13T16:30:45.464851+00:00\",\"id\":19288,\"codename\":\"GPT Image 2.5 Online\",\"slug\":\"gptimage25online\",\"problem_label\":\"Generate AI images by GPT Image 2.5 free daily, no sign-up required\",\"solution_label\":\"Image25 is a browser-based AI image generator and editor with daily "])</script><script>self.__next_f.push([1,"free credits, no registration required. Create ads, product visuals, posters, and social content from text prompts or reference photos using supported models including GPT Image 2 and Nano Banana. Refine images, choose flexible aspect ratios, and export up to 4K with supported models. Daily free usage is limited; credit packs and subscriptions are available for higher-volume work.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/gptimage25online/image25-logo-128x128.png\",\"niche_kws\":\"$42f\",\"icp_kws\":\"$430\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n432:[\"AI Interior Design\",\"Room Design\",\"Home Renovation\",\"Virtual Staging\",\"Interior AI\",\"Home Decor\"]\n433:[]\n431:{\"created_at\":\"2026-09-14T07:56:23.563273+00:00\",\"id\":19300,\"codename\":\"RoomAI\",\"slug\":\"roomai\",\"problem_label\":\"Redesign your room from one photo, same walls\",\"solution_label\":\"RoomAI turns a real photo of your room into AI-generated design options in under a minute, while keeping the walls, windows, and camera angle exactly as photographed. It covers 20+ room-specific presets — living room, bedroom, bathroom, house exterior, staging, decluttering — drawing on a shared library of 300+ styles, so each room type gets presets tuned to it instead of one generic style list. Free to try, no card required.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/roomai/PureLogo.webp\",\"niche_kws\":\"$432\",\"icp_kws\":\"$433\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"established\",\"is_favorite\":false,\"is_premium\":true}\n435:[\"Transcription\",\"Audio to Text\",\"Speech to Text\",\"AI Transcription\",\"Video to Text\",\"YouTube Transcript\",\"Meeting Notes\",\"Podcast Tools\",\"Subtitle Generator\",\"Productivity Tools\"]\n436:[]\n434:{\"created_at\":\"2026-09-14T10:11:39.318453+00:00\",\"id\":19306,\"codename\":\"Transcribe Audio to Text\",\"slug\":\"transcribeaudiototext\",\"problem_label\":\"Transcribe Audio to Text\",\"solution_label\":\"Transcribe Audio to Text onl"])</script><script>self.__next_f.push([1,"ine with Audio Converter AI. Convert audio, video, YouTube links, and recordings into accurate, editable transcripts. Enjoy 200+ languages, speaker recognition, timestamps, AI summaries, and files up to 10GB. Perfect for meetings, lectures, interviews, podcasts, research, and content creation. Upload your media, let AI transcribe it, then review, download, share, or repurpose your text.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/transcribeaudiototext/audioconverterai-logo-1.png\",\"niche_kws\":\"$435\",\"icp_kws\":\"$436\",\"market\":\"productivity\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n438:[\"Travel Discovery\",\"Meaningful Travel\",\"Travel Experiences\",\"Destination Discovery\",\"Travel Community\",\"Travel Companions\",\"Hidden Gems\",\"Social Travel\",\"Travel Recommendations\",\"Travel Network\"]\n439:[]\n437:{\"created_at\":\"2026-09-14T15:42:28.935042+00:00\",\"id\":19326,\"codename\":\"Onyatrips\",\"slug\":\"onyatrips\",\"problem_label\":\"Discover What’s Worth Experiencing, and Who to Experience It With.\",\"solution_label\":\"Onyatrips is a meaningful travel discovery network that helps you discover remarkable places, experiences, people, and communities worth experiencing. Instead of endless search results and popularity-based rankings, Onyatrips focuses on relevance, context, curation, and trust. Explore travel experiences through the Onya Standard, connect discovery with people and communities, and find what is actually worth experiencing - not just what is already popular.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/onyatrips/final-1-box.png\",\"niche_kws\":\"$438\",\"icp_kws\":\"$439\",\"market\":\"tech\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n43b:[\"react mascot\",\"interactive header\",\"cursor follower\"]\n43c:[\"web animation\",\"react components\",\"ui personalization\",\"web branding\",\"frontend design\"]\n43a:{\"created_at\":\"2026-09-14T17:31:58.499768+00:00\",\"id\":19335,"])</script><script>self.__next_f.push([1,"\"codename\":\"Koboyo\",\"slug\":\"koboyo\",\"problem_label\":\"Bring pages alive with a playful, custom cursor-following mascot\",\"solution_label\":\"page-mascot is a React-based interactive mascot that sits at the top of your page, follows the reader’s cursor, and reacts to pokes, giving your site a memorable, character-driven experience.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/koboyo/logo.png\",\"niche_kws\":\"$43b\",\"icp_kws\":\"$43c\",\"market\":\"ui-ux\",\"product_type\":\"other\",\"offer_type\":\"\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":false}\n43e:[\"Competitive intelligence\",\"Market intelligence\",\"Local Intelligence\",\"Founder Tools\",\"Entrepreneurs\"]\n43f:[]\n43d:{\"created_at\":\"2026-09-14T19:47:56.243249+00:00\",\"id\":19337,\"codename\":\"Rival Shark\",\"slug\":\"rivalshark\",\"problem_label\":\"Intelligence Beneath the Surface\",\"solution_label\":\"Know your competitor's next move before it costs you.\\n\\nRival Shark is AI-powered competitive intelligence that monitors your competitors, industry, and local market, surfaces what changed, explains why it matters, and recommends your next move. In minutes, not weeks.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/rivalshark/Rival-Shark-Mark-Dark-BG-4x.png\",\"niche_kws\":\"$43e\",\"icp_kws\":\"$43f\",\"market\":\"tech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n441:[\"AI agents\",\"Marketing\",\"Advertising\",\"MCP\",\"Social media\",\"Video ads\",\"Automation\"]\n442:[]\n440:{\"created_at\":\"2026-09-14T19:50:10.404844+00:00\",\"id\":19338,\"codename\":\"Hermoso\",\"slug\":\"hermoso\",\"problem_label\":\"Your marketing on autopilot, run from your own AI\",\"solution_label\":\"Hermoso is the marketing team you run from your own AI. Connect it to Claude, ChatGPT, Codex or Cursor and it finds the ads winning in your market, makes image and video ads and organic posts in your brand, publishes to 10 channels, runs campaigns on 11 ad platforms, answers comments and DMs, and reads the results back. 830+ tools over MCP, plus a"])</script><script>self.__next_f.push([1," web studio if you would rather click. Posting, scheduling and analytics are free; credits only go to AI renders and ad research.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/hermoso/hermoso-logo-128.png\",\"niche_kws\":\"$441\",\"icp_kws\":\"$442\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n444:[\"Omnipresent · Works Where You Work\",\"Omniscient · Knows What Matters\",\"Omnipotent · Intent to Outcome\",\"Come Back to Done\",\"Give It the Work\",\"Not the Task\",\"Your AI Agent Office\",\"Delegation with Control\",\"AI Employee\",\"WhatsApp Your Agent\"]\n445:[]\n443:{\"created_at\":\"2026-09-15T06:28:47.778988+00:00\",\"id\":19352,\"codename\":\"Vestra\",\"slug\":\"vestra\",\"problem_label\":\"Your Self-Building AI Agent Office\",\"solution_label\":\"Vestra is your AI Agent Office: agents that take over real tasks, routines, and whole responsibilities and come back to work done. Each agent works in its own cloud computer, browsing, using your tools, and running tasks in parallel while you watch, redirect, or approve. Reach them via web, desktop, WhatsApp, Telegram, or iMessage. Delegate once; it's handled.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/vestra/vestra-logo-2048.png\",\"niche_kws\":\"$444\",\"icp_kws\":\"$445\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n447:[\"equipment records\",\"small business\",\"AI\",\"manuals\",\"repair notes\"]\n448:[]\n446:{\"created_at\":\"2026-09-15T13:49:08.903631+00:00\",\"id\":19362,\"codename\":\"OctoVault\",\"slug\":\"octovault\",\"problem_label\":\"Find your equipment records.\",\"solution_label\":\"OctoVault helps small business owners find their equipment records. Start with an equipment label photo. Review the details before saving. Keep equipment photos, manuals and repair notes together. Keep invoices and service notes with the equipment. Not a CMMS. No setup project. Free 30-day self-serve trial, full access, no card.\",\"logo_"])</script><script>self.__next_f.push([1,"src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/octovault/00-thumbnail.png\",\"niche_kws\":\"$447\",\"icp_kws\":\"$448\",\"market\":\"productivity\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n44a:[]\n44b:[]\n449:{\"created_at\":\"2026-09-15T21:56:22.583693+00:00\",\"id\":19378,\"codename\":\"instancescheduler\",\"slug\":\"instancescheduler\",\"problem_label\":\"Automatically turn on and off your AWS EC2 instances\",\"solution_label\":\"Instance Scheduler is a tool for automatically scheduling and managing AWS EC2 instances. It helps reduce cloud infrastructure costs by automatically starting and stopping instances based on defined schedules, rather than running them continuously.\\n\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/instancescheduler/is128x128.png\",\"niche_kws\":\"$44a\",\"icp_kws\":\"$44b\",\"market\":\"dev-tools\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n44d:[\"Telegram\",\"MCP\",\"Analytics\",\"OSINT\",\"AI Agents\",\"Social Media Monitoring\",\"News\"]\n44e:[]\n44c:{\"created_at\":\"2026-09-15T22:45:17.466997+00:00\",\"id\":19380,\"codename\":\"Statiko\",\"slug\":\"statiko\",\"problem_label\":\"Real-time Telegram analytics with an MCP connector\",\"solution_label\":\"Statiko tracks public Telegram channels in real time: every post, edit and deletion, reach, engagement, subscriber growth, and what's trending across the network. Anyone can add a public channel and browse for free. \\n\\nNew: a remote MCP server so Claude, ChatGPT or Cursor can ask \\\"what's trending in Telegram today\\\" or \\\"which channels reposted this first\\\" — every answer links back to the source post. Plus AI Recaps: scheduled digests of the channels you pick.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/statiko/logo.png\",\"niche_kws\":\"$44d\",\"icp_kws\":\"$44e\",\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n450:[\"A"])</script><script>self.__next_f.push([1,"I video editor\",\"face swap AI\",\"deepfake tool\",\"video editing software\",\"content creation tool\"]\n451:[]\n44f:{\"created_at\":\"2026-09-16T03:31:34.474719+00:00\",\"id\":19386,\"codename\":\"Video Face Swap AI\",\"slug\":\"videofaceswapai-bc28a6\",\"problem_label\":\"Swap Faces in Videos Free \u0026 Unlimited\",\"solution_label\":\"Video Face Swap AI is an advanced AI-powered online face-swapping tool. In just a few simple steps, seamlessly swap single or multiple faces in videos, photos, and GIFs.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/videofaceswapai-bc28a6/nav-logo.png\",\"niche_kws\":\"$450\",\"icp_kws\":\"$451\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n453:[\"analytics\",\"conversion optimization\",\"AI insights\",\"conversion funnels\",\"feedback\"]\n454:[]\n452:{\"created_at\":\"2026-09-16T08:50:10.367134+00:00\",\"id\":19399,\"codename\":\"Spectry\",\"slug\":\"spectry\",\"problem_label\":\"Understand why visitors leave. Spectry finds the fix and tests it automatically.\",\"solution_label\":\"Most analytics tools tell you what happened, then leave the fixing to you. Spectry closes the loop. Analytics, session replays, heatmaps, funnels, surveys, error logs, and A/B tests all run from one script. Every 12 hours, AI scans your data, identifies what’s costing you conversions, and turns each finding into a ready-to-run A/B test. Approve the fix, send it to real traffic, and see whether it actually works. EU-hosted and GDPR-first.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/spectry/icon-128x128.png\",\"niche_kws\":\"$453\",\"icp_kws\":\"$454\",\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n456:[\"email api\",\"ai agents\",\"mcp\",\"jmap\",\"developer tools\",\"automation\"]\n457:[]\n455:{\"created_at\":\"2026-09-17T13:38:10.327795+00:00\",\"id\":19434,\"codename\":\"Atomic Mail Agentic\",\"slug\":\"atomicmailagentic\",\"problem_label\":\"Give AI agents a real email inbox they run themselves\",\"so"])</script><script>self.__next_f.push([1,"lution_label\":\"Atomic Mail Agentic gives AI agents a full email inbox they can create and operate on their own — no domain, no credit card, no human. Built on JMAP (RFC 8620/8621), not send-only like Resend or SendGrid, so agents can read, search, reply, and thread email, not just send it. Connect via MCP, LangChain, n8n, or Dify. Built by the team behind Atomic Mail, encrypted email already used by 6M+ people.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/atomicmailagentic/AM-agentic-logo-1.png\",\"niche_kws\":\"$456\",\"icp_kws\":\"$457\",\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Free product\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n459:[\"form backend\",\"forms\",\"developer tools\",\"no-code\",\"API\",\"SaaS\",\"webhooks\",\"static site\"]\n45a:[]\n458:{\"created_at\":\"2026-09-17T14:15:06.676214+00:00\",\"id\":19437,\"codename\":\"Submitrax\",\"slug\":\"submitrax\",\"problem_label\":\"Add a working form to your site in 2 minutes\",\"solution_label\":\"No backend, no config marathon. Copy your SubmitraX endpoint into any HTML form and you're live — submissions land in your inbox, Slack, Discord, or a webhook instantly. Static site, landing page, side project: get a real, working form up in the time it takes to grab a coffee.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/submitrax/logomark.png\",\"niche_kws\":\"$459\",\"icp_kws\":\"$45a\",\"market\":\"dev-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n45c:[\"security\",\"devtools\",\"AI\",\"compliance\",\"web-security\",\"pentesting\",\"SaaS\"]\n45d:[]\n45b:{\"created_at\":\"2026-09-18T08:40:18.605556+00:00\",\"id\":19455,\"codename\":\"Decloak - Web security intelligence\",\"slug\":\"decloakwebsecurityintelligence\",\"problem_label\":\"Security intelligence for teams from vibe coders to enterprise\",\"solution_label\":\"Decloak scans any live URL across 8 layers, catching exposed API keys, misconfigured databases, and vulnerable libraries, including the specific failures common to apps built with L"])</script><script>self.__next_f.push([1,"ovable, Supabase, and Base44. Paid tiers deploy an AI agent that investigates a whole site, run AI-powered penetration testing, and map findings to SOC2, ISO 27001, NIS2, and DORA controls, all for a fraction of what tools like AppCheck or Qualys cost.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/decloakwebsecurityintelligence/decloak-app-icon.png\",\"niche_kws\":\"$45c\",\"icp_kws\":\"$45d\",\"market\":\"ai\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false,\"is_premium\":true}\n45f:[\"loyalty program\",\"digital wallet\",\"QR code\",\"small business\",\"customer retention\",\"stamp card\",\"points program\",\"progressive web app\",\"digital punch card\",\"customer rewards\"]\n460:[]\n45e:{\"created_at\":\"2026-09-18T14:57:07.762034+00:00\",\"id\":19467,\"codename\":\"CrabTap\",\"slug\":\"crabtap\",\"problem_label\":\"Digital loyalty cards for local businesses, no app required\",\"solution_label\":\"CrabTap is a digital loyalty platform for small local businesses like cafés, barbershops, and ice cream shops. Instead of building a native app or paying for infrastructure meant for big chains, venues get an affordable way to run stamps and points programs. Customers use one account and one QR code across every participating business, earning rewards they can redeem for real perks each venue sets. Owners get a simple scan-and-reward flow at checkout, plus tools to send promotions.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/crabtap/CrabTap-Logo-Icon.png\",\"niche_kws\":\"$45f\",\"icp_kws\":\"$460\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n462:T40b,My Recomy turns word-of-mouth into income. You recommend a place you trust, someone books through your link and spends there, and you get paid. When that same customer comes back, you get paid again — the model rewards retention, not just the first visit.\n\nBusinesses gain a performance-based acquisition channel: they pay a commission only on real, validat"])</script><script>self.__next_f.push([1,"ed consumption, decide the commission they offer, and can start on a free plan. From one panel they manage collaborations with ambassadors, traceable bookings, challenges with rewards, their own loyalty program, invoicing, daily closings, team access and reports.\n\nAmbassadors work from their phone: they choose the businesses they trust, share their link or QR, track every booking and commission in real time, and get paid automatically every week through Stripe Connect.\n\nCustomers book through someone they trust, can pay from the app — including splitting the bill — and earn loyalty points redeemable at each business.\n\nOperating across Europe and the United States.463:[\"referral marketing\",\"affiliate marketing\",\"loyalty\",\"marketplace\"]\n464:[]\n461:{\"created_at\":\"2026-09-18T18:20:36.321958+00:00\",\"id\":19471,\"codename\":\"My Recomy\",\"slug\":\"myrecomy\",\"problem_label\":\"Get paid for recommending places you love\",\"solution_label\":\"$462\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/myrecomy/my_recomy_logo_vertical_fondo_blanco.png\",\"niche_kws\":\"$463\",\"icp_kws\":\"$464\",\"market\":\"marketing\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"mvp-ready\",\"is_favorite\":false,\"is_premium\":true}\n466:[\"AI Resale Valuation\",\"Reselling Tools\",\"eBay Price Research\",\"Product Valuation\",\"Resale Price Estimator\",\"Flipping Tools\",\"Marketplace Research\",\"Profit Calculator\",\"Secondhand Selling\",\"Reseller Software\"]\n467:[]\n465:{\"created_at\":\"2026-09-19T14:56:05.590689+00:00\",\"id\":19497,\"codename\":\"FLIPWORTH\",\"slug\":\"flipworth\",\"problem_label\":\"SNAP IT. CHECK IT. FLIP IT.\",\"solution_label\":\"FlipWorth is an AI-powered resale tool that identifies items from photos, estimates their resale value, and calculates potential profit and ROI to help resellers decide what’s worth flipping.\\n\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/flipworth/flipworth-logo-optically-centered.png\",\"niche_kws\":\"$466\",\"icp_kws\":\"$467\",\"market\":\"analytics\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"sta"])</script><script>self.__next_f.push([1,"ge\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n469:[\"Social media\",\"builders\",\"indie hacking\",\"launch\"]\n46a:[]\n468:{\"created_at\":\"2026-09-19T15:27:23.522034+00:00\",\"id\":19498,\"codename\":\"Builder Battles\",\"slug\":\"builderbattles\",\"problem_label\":\"Head to head app showdowns from builders brave enough\",\"solution_label\":\"A daily 1v1 for indie apps. Enter to join the fighter pool. Two apps fight each day. Spectators vote with X or Google. Yesterday’s winner stays pinned. Built for makers who want a public fight, not another silent launch.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/builderbattles/builder-battles-logo-1024.png\",\"niche_kws\":\"$469\",\"icp_kws\":\"$46a\",\"market\":\"marketing\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"One-time payments\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n46c:[\"Facebook\",\"Facebook Marketing\",\"Social Media Management\",\"Social Media Scheduling\",\"Facebook Publishing\",\"Marketing Automation\",\"Social Media Analytics\",\"Traffic Analytics\",\"Content Scheduling\",\"Content Marketing\"]\n46d:[]\n46b:{\"created_at\":\"2026-09-19T18:04:53.792607+00:00\",\"id\":19504,\"codename\":\"Upnext\",\"slug\":\"upnext\",\"problem_label\":\"Publish, distribute and track traffic across Facebook Pages\",\"solution_label\":\"Upnext is a Facebook-first publishing and traffic platform built for publishers, media teams and businesses managing multiple Facebook Pages. Schedule and distribute content across Pages, organize Pages into groups, customize and rotate branded domains, control publishing intervals, track clicks with automatic UTM parameters, analyze traffic and engagement, discover trending content, use AI-assisted content creation, and safely manage or clean up published content — all from one workspace.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/upnext/Upnext-logo.png\",\"niche_kws\":\"$46c\",\"icp_kws\":\"$46d\",\"market\":\"social-tools\",\"product_type\":\"Saas\",\"offer_type\":\"Subscription\",\"stage\":\"first-customers\",\"is_favorite\":false,\"is_premium\":true}\n46"])</script><script>self.__next_f.push([1,"f:[\"AI product photography\",\"ecommerce\",\"product image generator\",\"AI photo editor\",\"AI ads\",\"product mockups\",\"virtual try-on\",\"background remover\",\