4/xCnXj0kl_normal.jpg\",\"https://pbs.twimg.com/profile_images/1993744339365670912/hMnDFPr6_normal.jpg\",\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":21148,\"created_at\":\"2026-09-24T23:39:40.400358+00:00\",\"user_id\":\"b9fecca6-51f9-43d6-8fe2-66ebeb042669\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\",\"feedback\":\"Going from a photo to resale value and profit in one step saves resellers a lot of guesswork.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":21115,\"created_at\":\"2026-09-23T09:22:13.24221+00:00\",\"user_id\":\"f0331b13-7e75-4458-b134-99acd6da8cff\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/2088759233068068864/xCnXj0kl_normal.jpg\",\"feedback\":\"Brilliant idea and execution! Well done and congratulations on the launch 🚀 \",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":21076,\"created_at\":\"2026-09-21T19:10:18.865026+00:00\",\"user_id\":\"689cce1b-7b47-4d51-9dc4-1695b07798f7\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/2056022842014060544/WILw0QFk_normal.jpg\",\"feedback\":\"Super cool product!  I can definitely see how this would be very useful to thrift store shoppers!\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":19063,\"created_at\":\"2026-09-22T15:56:38.401359+00:00\",\"product_id\":19556,\"version\":\"v1\",\"url\":\"https://sendheron.com/\",\"status\":\"live\",\"description\":\"SendHeron is lifecycle and transactional email for software products. Paste your website URL: it proposes the tags your app should emit, then drafts the full lifecycle suite in your brand voice (welcome, trial, win-back, cancel-save). You read every draft and activate what you want. Visual sequences, templates as blocks or HTML, a REST API with an SDK written for AI agents, several products on one subscription. From €19/month, 7-day trial, card required. EU company, data stored in Europe.\",\"maker_name\":\"Petar Georgiev\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@peturgeorgievv/avatar.png\",\"maker_social_handle\":\"peturgeorgievv\",\"hero_img\":\"https://sendheron.com/images/og-default.png\",\"batch_num\":202609,\"start_date\":\"2026-09-23\",\"is_premium\":true,\"votes\":7,\"votes_all_time\":7,\"votes_week\":7,\"votes_anon_week\":0,\"score_week\":15.39,\"score_week_penalty\":0,\"score_idea\":4.142857142857143,\"score_execution\":4.5,\"product_points\":7434,\"product_points_week\":6834,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIxlq-589DURHqwPjITawEp7ygNijRowQqjtp7s3sj2ijTvO9U=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKQxNlx8wxxMZtoX5zgdHDPzgtfPWiV52WVCXMYi9DceA4F6fo=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocId7apiS66cEoC6E_F1CSo7Uv6wxhlCioDftxK4ZolydRNxMQ=s96-c\"],\"feedback_arr\":[{\"vote_id\":21161,\"created_at\":\"2026-09-26T15:44:46.296714+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"SendHeron's email automation is solid, but the UI could be more intuitive for first-time users. The template builder is powerful, but adding more guided onboarding or video tutorials would reduce the learning curve. Consider highlighting th\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18410,\"created_at\":\"2026-08-31T20:57:33.673766+00:00\",\"product_id\":18906,\"version\":\"v1\",\"url\":\"https://host.builderall.com/\",\"status\":\"live\",\"description\":\"Builderall AI Site Hosting is free hosting for websites built with ChatGPT, Claude, Gemini, or Meta AI. Where Vercel and Cloudflare Pages are built for developers who deploy from Git, Builderall is built for marketers and small business owners who just want more leads and sales. Upload it and it's on a free Builderall subdomain in minutes, no github, no command line, no APIs. Builderall also offers a host of integrated marketing tools within the platform.\",\"maker_name\":\"Pedro Sostre\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@builderall/avatar.png\",\"maker_social_handle\":\"builderall\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/aiwebsitehostingformarketersandbusinessowners/Greenshot-2026-08-26-19.45.39.png\",\"batch_num\":202609,\"start_date\":\"2026-09-01\",\"is_premium\":true,\"votes\":10,\"votes_all_time\":10,\"votes_week\":1,\"votes_anon_week\":0,\"score_week\":2,\"score_week_penalty\":0,\"score_idea\":4.1,\"score_execution\":5,\"product_points\":7328.370563888011,\"product_points_week\":4821,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocKvr7-Nzo2C5fMSvfLJaSvdHnUe6UB9HAuPjIjFY2NbwIzcf-2O0w=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJqX3Ua_qkB51NJ8b61uWIGI11Zkpx0cfgsvP93rJzMdkHRdv0=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",null,\"https://lh3.googleusercontent.com/a/ACg8ocKpaMaWX33Zdtj0LrI3L-gEvWnaIgNj4-UeRlVL76ThBvch4Q=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/