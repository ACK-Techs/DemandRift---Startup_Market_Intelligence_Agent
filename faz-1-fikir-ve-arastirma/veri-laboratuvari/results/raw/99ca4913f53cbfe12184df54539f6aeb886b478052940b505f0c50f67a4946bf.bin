re_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5523,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1276802179261579264/TlAghZv__normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz04EQ_VTRNe1ivCqZr-rPL2krNo_hkWateyAkatrQ=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1100343953747005440/gT-fT6Hf_normal.png\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18748,\"created_at\":\"2026-09-11T16:36:47.072549+00:00\",\"product_id\":19241,\"version\":\"v1\",\"url\":\"https://getmokko.com\",\"status\":\"live\",\"description\":\"Mokko creates fresh AI ads every week, guided by your brand’s performance data. We analyze existing creatives, identify what to test next, and deliver new concepts and variations tailored to your business. Your team or agency keeps control of campaigns and media budgets. No fixed monthly fee: our compensation is a percentage of revenue generated and ad spend on Mokko ads, with terms agreed before we start.\",\"maker_name\":\"Giovanni Brando Dalla Rizza\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@GBDallaRizza/avatar.png\",\"maker_social_handle\":\"GBDallaRizza\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/mokko/download.png\",\"batch_num\":202609,\"start_date\":\"2026-09-11\",\"is_premium\":true,\"votes\":5,\"votes_all_time\":5,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5523,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocIaIila8nqqvTOA7bkA2kZDti54D_hIQfR_3Xo62NOL6NMt74mo=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":17671,\"created_at\":\"2026-08-08T17:39:48.513651+00:00\",\"product_id\":18170,\"version\":\"v1\",\"url\":\"https://www.useinvent.com/\",\"status\":\"live\",\"description\":\"Invent turns your customer operation into one AI brain. Build a no-code assistant that answers from your data, then put it on WhatsApp, Instagram, web chat, SMS, and every channel you use, all flowing into one inbox. It remembers every customer, hands tricky conversations to your team, and sends broadcasts that sell. Pick your AI model and swap anytime. Setup takes minutes, plans start free, and pricing runs a tenth of Intercom's.\\n\\n\",\"maker_name\":\"Alix\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@agnamihira/avatar.png\",\"maker_social_handle\":\"agnamihira\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/invent/heromicrolaunch.png\",\"batch_num\":202608,\"start_date\":\"2026-08-11\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":16,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.4375,\"score_execution\":5,\"product_points\":5462,\"product_points_week\":4043,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":20109,\"created_at\":\"2026-08-27T12:24:54.239379+00:00\",\"user_id\":\"ece4fa88-c886-4f51-93f2-3935996cd898\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIjA00732ABCM7ULvVnNRx2yKvMGdP6UNKPqvDo-ByqyOfUd8qxkg=s96-c\",\"feedback\":\"Invent excels at delivering a great experience for both you and your end market as it facilitates the automation of customer service with great flexibility. Frontier models, built in no time, backend connections... A gem.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19902,\"created_at\":\"2026-08-20T16:57:22.468465+00:00\",\"user_id\":\"e62d98cb-8eb7-4a5a-b02c-24a510711aea\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKr71PiMn4tP75tEjlBMyuo9Hffw7nxKEnf8vZIBCwB9PJ0hA=s96-c\",\"feedback\":\"Invent Your product has strong potential, but I found a few key improvements that could make it even better.\\n\\nI'd love to share my feedback and suggestions—please contact me at contact@rforrank.com.\\n\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19639,\"created_at\":\"2026-08-13T14:13:08.790196+00:00\",\"user_id\":\"cf097fcd-502f-4652-80fa-47b2874817a4\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK_z4-l7ua3lYTxw-wICEhLDnckDSBJkWQdjpJZMEVO0A5r4g=s96-c\",\"feedback\":\"I’ve been using it for 20 days, and I’ve seen a big improvement in both my sales and the way I communicate with my customers. I like the platform because it’s very easy to set up.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19626,\"created_at\":\"2026-08-12T18:58:34.706109+00:00\",\"user_id\":\"23ad42cc-7ba0-41e7-af11-9926903fd9e0\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK2rnP9TzWkldE0lG5p45h8Dw98QduyqUXcf8G-KFpX8A634BL5=s96-c\",\"feedback\":\"As a doctor, I need AI agents to help generate and manage patient appointments efficiently. Invent is useful for creating agents that can streamline scheduling, reduce administrative workload, and help my practice provide a faster, more org\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19592,\"created_at\":\"2026-08-11T03:09:09.265274+00:00\",\"user_id\":\"064688ce-ec93-44a8-a4a7-1468980916bc\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJDgmgst1BeDM6OqeIX3z3f51U6PiZh7hCzF-0NNcj-RkpGSQ0=s96-c\",\"feedback\":\"Great platform. Easy to connect with the company’s social media accounts\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":19591,\"created_at\":\"2026-08-11T03:07:32.795236+00:00\",\"user_id\":\"6f90ec2f-9c28-40d2-ba1d-f981f6fef7ca\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocInaNt93eqv8Kzrz2cYZxvEK3R4tBcNmGpgW8Oblrga3PY2VA=s96-c\",\"feedback\":\"Nice product!\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18150,\"created_at\":\"2026-08-24T06:15:45.959257+00:00\",\"product_id\":18647,\"version\":\"v1\",\"url\":\"https://www.viraldrop.ai/\",\"status\":\"live\",\"description\":\"Converts a link to any public TikTok, Reels, or YouTube Shorts video into a transcript, an explanation of why the video went viral, and a rewritten script adapted to a different brand's voice.\",\"maker_name\":\"Mariia\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/viraldrop/Znimok-ekrana-2026-08-20-o-18.17.20.png\",\"batch_num\":202608,\"start_date\":\"2026-08-24\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.5,\"score_execution\":4,\"product_points\":5438.370563888011,\"product_points_week\":3813,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLrpbAvINiKpGJVUk1A72ZznnQj50tu_rbeH8d2xtL5CwFMnHA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz04EQ_VTRNe1ivCqZr-rPL2krNo_hkWateyAkatrQ=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"