nshot-2026-09-07-at-8.23.33-PM.png\",\"batch_num\":202610,\"start_date\":\"2026-09-16\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":4537,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":\"$518\",\"feedback_arr\":\"$519\",\"final_score\":\"$undefined\",\"codename\":\"bubble markets\",\"slug\":\"bubblemarkets\",\"problem_label\":\"See global financial markets move on one interactive bubble map.\",\"logo_src\":\"https://wild-dust-0517.microlaunch.workers.dev/logos-001/bubblemarkets/WhatsApp-Image-2026-09-07-at-20.15.13.jpeg\",\"all_kws\":[\"Financial Markets\",\"Market Visualization\",\"Stock Market\",\"Cryptocurrency\",\"Forex\",\"ETFs\",\"Market Analytics\",\"Trading Tools\",\"Investment Research\",\"Bubble Charts\"],\"market\":\"fintech\",\"product_type\":\"Web Tool/App\",\"offer_type\":\"Subscription\",\"stage\":\"growing\",\"is_favorite\":false},{\"id\":18040,\"created_at\":\"2026-08-20T17:20:21.688212+00:00\",\"product_id\":18537,\"version\":\"v1\",\"url\":\"https://recoura.io\",\"status\":\"live\",\"description\":\"Recoura offers manual and automatic recovery of failed payments for revenue that Stripe and Square give up on. It includes custom email templates, multi-currency support, custom recovery sequences, an AI recovery assistant (optional AI generated recovery emails, tailored to your business), and analytics to help with recovery campaigns. It supports failed payments across invoices, subscriptions, and one-off payments, and is one of the few recovery tools supporting Square.\",\"maker_name\":\"Recoura\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@recoura_io/avatar.png\",\"maker_social_handle\":\"recoura_io\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/recoura/screen-shot-2026-08-20-at-10.37.53.png\",\"batch_num\":202