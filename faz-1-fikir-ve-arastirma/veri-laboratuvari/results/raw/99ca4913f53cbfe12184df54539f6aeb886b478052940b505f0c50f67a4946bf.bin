oduct_id\":19380,\"version\":\"v1\",\"url\":\"https://statiko.io\",\"status\":\"live\",\"description\":\"Statiko tracks public Telegram channels in real time: every post, edit and deletion, reach, engagement, subscriber growth, and what's trending across the network. Anyone can add a public channel and browse for free. \\n\\nNew: a remote MCP server so Claude, ChatGPT or Cursor can ask \\\"what's trending in Telegram today\\\" or \\\"which channels reposted this first\\\" — every answer links back to the source post. Plus AI Recaps: scheduled digests of the channels you pick.\",\"maker_name\":\"Amar\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@statiko_io/avatar.png\",\"maker_social_handle\":\"statiko_io\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/statiko/hero-680x340-2x.png\",\"batch_num\":202609,\"start_date\":\"2026-09-22\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":0,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":0,\"score_execution\":0,\"product_points\":2733,\"product_points_week\":2133,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":19106,\"created_at\":\"2026-09-26T05:31:37.767196+00:00\",\"product_id\":19599,\"version\":\"v1\",\"url\":\"https://tikklip.com/\",\"status\":\"live\",\"description\":\"Pull TikTok data and assets at scale.\",\"maker_name\":\"Robert Williams\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"\",\"batch_num\":202609,\"start_date\":\"2026-09-27\",\"is_premium\":true,\"votes\":0,\"votes_all_time\":0,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":0,\"score_execution\":0,\"product_points\":2733,\"product_points_week\":2133,\"is_boosted\":false,\"voters_avatar_urls\":[],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":19082,\"created_at\":\"2026-09-24T07:04:52.708317+00:0