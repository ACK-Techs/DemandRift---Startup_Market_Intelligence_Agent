2608,\"start_date\":\"2026-08-31\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":4,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18538,\"created_at\":\"2026-09-05T05:50:09.202259+00:00\",\"product_id\":19033,\"version\":\"v1\",\"url\":\"https://aiagentslisting.com/\",\"status\":\"live\",\"description\":\"A directory of AI agents, MCP servers and agent skills, cross-linked so you can see what works with what. Free to list.\",\"maker_name\":\"Nick Launches\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@nicklaunchesai/avatar.png\",\"maker_social_handle\":\"nicklaunchesai\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/aiagentslisting/01-home.png\",\"batch_num\":202609,\"start_date\":\"2026-09-05\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18550,\"created_at\":\"2026-09-05T13:52:51.918397+00:00\",\"product_id\":19044,\"version\":\"v1\",\"url\":\"https://getredditradar.com\",\"status\":\"live\",\"description\":\"Radar finds Reddit threads where someone is describing the exact problem your product solves, scores them, and drafts the reply. You review, tweak a word, paste. Nothing is ever auto-posted. Built-in anti-ban guardrails do the boring part: it audits each subreddit's real rules, caps mentions at one per sub, enforces cooldowns, and a simulated moderator reads every pitched draft before you see it. Built by a founder who got banned learning why this matters.\",\"maker_name\":\"Roberto\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@robsannazzaro/avatar.png\",\"maker_social_handle\":\"robsannazzaro\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/radar/microlaunch-radar-hero.png\",\"batch_num\":202609,\"start_date\":\"2026-09-08\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18599,\"created_at\":\"2026-09-07T12:12:23.69827+00:00\",\"product_id\":19093,\"version\":\"v1\",\"url\":\"https://www.labrynth.ai/\",\"status\":\"live\",\"description\":\"The platform maps obligations, validates documents and evidence, and helps teams move faster through complex compliance, licensing, permitting, and approval workflows while keeping experts in control.\",\"maker_name\":\"Labrynth AI\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@labrynth_ai/avatar.png\",\"maker_social_handle\":\"labrynth_ai\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/labrynth/7.jpg\",\"batch_num\":202609,\"start_date\":\"2026-09-07\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18398,\"created_at\":\"2026-08-31T12:33:00.471759+00:00\",\"product_id\":18894,\"version\":\"v1\",\"url\":\"https://spytrend.com/?utm_source=microlaunch\u0026utm_medium=listing\",\"status\":\"live\",\"description\":\"SpyTrend is ad intelligence for Facebook and TikTok. Instead of reviewing ads one at a time, it links the accounts, pages and landing domains behind a single advertiser into one profile, so you research a whole competitor at once: the creatives in rotation, the countries they target, and how long each ad has run. Over 1.1B ads are auto-sorted into 33 categories and 343 subcategories. Connect Claude, ChatGPT, Codex or VS Code over MCP and research in plain language\",\"maker_name\":\"Govard\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@spytrendcom/avatar.png\",\"maker_social_handle\":\"spytrendcom\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/spytrend/spytrend-hero-680x340.png\",\"batch_num\":202609,\"start_date\":\"2026-09-10\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJPMzcW9eIql2BCLLKd1R3Gi0lHThipzIAvkw_75gWMcsJrEw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18795,\"created_at\":\"2026-09-13T16:30:45.508038+00:00\",\"product_id\":19288,\"version\":\"v1\",\"url\":\"https://image25.app\",\"status\":\"live\",\"description\":\"Image25 is a browser-based AI image generator and editor with daily free credits, no registration required. Create ads, product visuals, posters, and social content from text prompts or reference photos using supported models including GPT Image 2 and Nano Banana. Refine images, choose flexible aspect ratios, and export up to 4K with supported models. Daily free usage is limited; credit packs and subscriptions are available for higher-volume work.\",\"maker_name\":\"Mhhya\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/gptimage25online/image25-hero-680x340.png\",\"batch_num\":202609,\"start_date\":\"2026-09-14\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18893,\"created_at\":\"2026-09-16T03:31:34.578544+00:00\",\"product_id\":19386,\"version\":\"v1\",\"url\":\"https://videoswapface.com/\",\"status\":\"live\",\"description\":\"Video Face Swap AI is an advanced AI-powered online face-swapping tool. In just a few simple steps, seamlessly swap single or multiple faces in videos, photos, and GIFs.\",\"maker_name\":\"Video Face Swap AI\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/videofaceswapai-bc28a6/Wei-Xin-Tu-Pian_2026-08-28_120122_952.png\",\"batch_num\":202609,\"start_date\":\"2026-09-18\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":5037,\"product_points_week\":2773,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18906,\"created_at\":\"2026-09-16T08:50:10.391643+00:00\",\"product_id\":19399,\"version\":\"v1\",\"url\":\"https://spectry.io\",\"status\":\"live\",\"description\":\"Most analytics tools tell you what happened, then leave the fixing to you. Spectry closes the loop. Analytics, session replays, heatmaps, funnels, surveys, error logs, and A/B tests all run from one script. Every 12 hours, AI scans your data, identifies what’s costing you conversions, and turns each finding into a ready-to-run A/B test. Approve the fix, send it to real traffic, and see whether it actually works. EU-hosted and GDPR-first.\",\"maker_name\":\"Niko Tikkanen\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@spectry_io/avatar.png\",\"maker_social_handle\":\"spectry_i