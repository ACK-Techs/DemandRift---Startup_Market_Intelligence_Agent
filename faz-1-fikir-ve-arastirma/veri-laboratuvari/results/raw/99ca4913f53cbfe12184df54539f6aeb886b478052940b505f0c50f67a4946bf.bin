.googleusercontent.com/a/ACg8ocIwkxYiLEFPk5V6NppXRVrl4l2Mlkrw1hcVNc1jkhA1YWt__Q=s96-c\",\"feedback\":\"nice application \",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":17618,\"created_at\":\"2026-08-06T13:37:37.389636+00:00\",\"product_id\":18117,\"version\":\"v1\",\"url\":\"https://www.goldmineai.io\",\"status\":\"live\",\"description\":\"GoldMine AI is an autonomous online marketing agent designed for solopreneurs and small teams. It acts as a dedicated business brain—your \\\"Cortex\\\"—that learns and adapts to your marketing needs over time.\\n\\nRather than managing every detail manually, you focus on high-level decisions: approving recommendations, providing feedback, and making strategic choices. The AI handles the execution of campaigns, optimization, and ongoing learning from results.\\n\\nIdeal for founders and lean teams looking to scale their marketing without hiring a full in-house team.\",\"maker_name\":\"Rygel Louv\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@Rygellouv/avatar.png\",\"maker_social_handle\":\"Rygellouv\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/goldmine/Screenshot-2026-08-06-at-1.33.23-PM.png\",\"batch_num\":202608,\"start_date\":\"2026-08-07\",\"is_premium\":true,\"votes\":2,\"votes_all_time\":7,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.142857142857143,\"score_execution\":5,\"product_points\":5877,\"product_points_week\":3996,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz04EQ_VTRNe1ivCqZr-rPL2krNo_hkWateyAkatrQ=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":20418,\"created_at\":\"2026-09-01T10:51:29.45132+00:00\",\"user_id\":\"de5fa7b5-0cb6-4823-8f9a-119aff97c72c\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz