ogleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocIggjkihpQIZ0jnH8Maa-oXIXMbG8J87D1uYYhAZvjnWr-zr_8=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIwkxYiLEFPk5V6NppXRVrl4l2Mlkrw1hcVNc1jkhA1YWt__Q=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJBbrLeP1Oh909xBXTYROBrqSi5IynpwX-DFE2vn84CjA5o-Q=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJYmsR3U70FzKZ1SXxJsdxqOQ4Jx4mVH4RyLEJOLEvh2o5FNQ=s96-c\"],\"feedback_arr\":[{\"vote_id\":20703,\"created_at\":\"2026-09-08T18:26:27.312968+00:00\",\"user_id\":\"277b9f69-2907-4590-82e5-82310def4f95\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocIggjkihpQIZ0jnH8Maa-oXIXMbG8J87D1uYYhAZvjnWr-zr_8=s96-c\",\"feedback\":\"The nested desktop is the useful part: walking a portfolio beats judging it from a screenshot of three comments. I keep public threads in time order with https://toktoolset.com/tiktok-comment-viewer when a preview hides replies.\",\"is_roast\":false,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18585,\"created_at\":\"2026-09-06T21:21:44.555188+00:00\",\"product_id\":19079,\"version\":\"v1\",\"url\":\"https://reflectjournals.com\",\"status\":\"live\",\"description\":\"An intelligent journal that turns your memories into insight.\",\"maker_name\":\"Jeff\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/reflect/life-map-v1-jpeg.jpg\",\"batch_num\":202609,\"start_date\":\"2026-09-06\",\"is_premium\":true,\"votes\":6,\"votes_all_time\":6,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.166666666666667,\"score_execution\":4,\"product_points\":6556.370563888011,\"product_points_week\":3760,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocInnQAbnYPM8ltbMwAjFmCCYB5gNA2gRFIPPCaoR6hST5IiJXQ=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://pbs.twimg.com/profile_images/1743967690945871872/_1Hy_sJR_normal.jpg\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":14727,\"created_at\":\"2026-03-27T14:08:54.11966+00:00\",\"product_id\":15240,\"version\":\"v1\",\"url\":\"https://www.halovoice.app/\",\"status\":\"live\",\"description\":\"HaloVoice is an AI-powered real-time voice translator for gaming, streaming, meetings, and multilingual voice chat. It provides live voice translation and real-time speech translation across apps like Discord, OBS, Zoom, Slack, and Teams, making it easy to communicate across languages in real time.\",\"maker_name\":\"Shensheng Chen\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@haloailabs/avatar.png\",\"maker_social_handle\":\"haloailabs\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/halovoice/5cb57e83-d2bb-454b-85f4-f3b65741bcb6.png\",\"batch_num\":202609,\"start_date\":\"2026-09-11\",\"is_premium\":true,\"votes\":6,\"votes_all_time\":6,\"votes_week\":1,\"votes_anon_week\":0,\"score_week\":3.39,\"score_week_penalty\":0,\"score_idea\":4,\"score_execution\":0,\"product_points\":6355,\"product_points_week\":4067,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJ-Y-A7yz04EQ_VTRNe1ivCqZr-rPL2krNo_hkWateyAkatrQ=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\"],\"feedback_arr\":[{\"vote_id\":21145,\"created_at\":\"2026-09-24T23:38:16.225768+00:00\",\"user_id\":\"b9fecca6-51f9-43d6-8fe2-66ebeb042669\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\",\"feedback\":\"Real-time voice translation that works inside Discord, OBS and Zoom makes playing and streaming across languages much easier.\",\"is_roast\":false,\"is_feedback_by_maker\":false},{\"vote_id\":20815,\"created_at\":\"2026-09-11T05:57:45.581552+00:00\",\"user_id\":\"3ba25be2-1faa-48a1-8e57-8f08aa4f0c27\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKRbHKlkrnkJ4KAHwhENO_4w9oiOTGCCKbJ3GBnB1p1lgk-Ig=s96-c\",\"feedback\":\"Strong idea in a competitive space. To stand out from Google/Zoom: (1) Focus deeply on one vertical (gaming looks most promising) before spreading thin. (2) Lead with latency benchmarks - gamers care more about speed than accuracy. (3) Show\",\"is_roast\":true,\"is_feedback_by_maker\":false}],\"final_score\":\"$undefined\"},{\"id\":18669,\"created_at\":\"2026-09-09T09:19:40.911343+00:00\",\"product_id\":19163,\"version\":\"v1\",\"url\":\"https://recoverit.wondershare.com/\",\"status\":\"live\",\"description\":\"Wondershare Recoverit is an AI-powered data recovery software designed to restore lost, deleted, or corrupted files across 2,000+ storage devices with a 99.5% success rate. Featuring patented Enhanced Video Recovery technology, it automatically auto-stitches fragmented 4K/8K video clips from camera SD cards, repairs corrupted media, and extracts critical files from crashed computers, formatted drives, and NAS servers in 3 simple steps.\",\"maker_name\":\"Ygritte Liu\",\"maker_avatar_url\":\"https://wild-dust-0517.microlaunch.workers.dev/user-avatars-002/@WS_Recoverit/avatar.png\",\"maker_social_handle\":\"WS_Recoverit\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/wondersharerecoverit/mac-data-recovery.png\",\"batch_num\":202609,\"start_date\":\"2026-09-09\",\"is_premium\":true,\"votes\":3,\"votes_all_time\":3,\"votes_week\":0,\"votes_anon_week\":0,\"score_week\":0,\"score_week_penalty\":0,\"score_idea\":4.333333333333333,\"score_execution\":5,\"product_points\":6290,\"product_points_week\":4027,\"is_boosted\":false,\"voters_avatar_urls\":[\"https://lh3.googleusercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\"],\"feedback_arr\":[],\"final_score\":\"$undefined\"},{\"id\":18448,\"created_at\":\"2026-09-02T02:05:11.119624+00:00\",\"product_id\":18943,\"version\":\"v1\",\"url\":\"https://seoagent.com\",\"status\":\"live\",\"description\":\"Turn your Grok Bot, Claude Code, Codex, or Cursor agent into a full-time SEO engineer.\\n\\nSEOAgent lives in your repo. It audits your site and search results, researches competitors and keywords, writes articles and landing pages, and does outreach for backlinks. You review every change before it ships.\\n\\nFree Skill forever. Autopilot is $49/site/month after a $1 7-day trial.\\n\\nInstall: npm install -g @seoagent-official/seoagent \u0026\u0026 seoagent init\\nWebsite: https://seoagent.com\",\"maker_name\":\"Alexander Lindsay\",\"maker_avatar_url\":\"\",\"maker_social_handle\":\"\",\"hero_img\":\"https://wild-dust-0517.microlaunch.workers.dev/hero-001/seoagent/microlaunch-hero.jpg\",\"batch_num\":202609,\"start_date\":\"2026-09-02\",\"is_premium\":true,\"votes\":10,\"votes_all_tim