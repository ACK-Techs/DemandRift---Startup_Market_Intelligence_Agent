Avqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.google"])</script><script>self.__next_f.push([1,"usercontent.com/a/ACg8ocLbb0alMZZ7OMbFdn819cVPFxtfNEpv6ikPojhGBn52JAzZ2_R-=s96-c\",null,\"https://lh3.googleusercontent.com/a/ACg8ocLsnlMyhp1eaGwIhJNvGc8GsKQLqo6VeYiL1FOXbUAyggGjng=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\"]\n56c:{\"vote_id\":21147,\"created_at\":\"2026-09-24T23:39:12.085005+00:00\",\"user_id\":\"b9fecca6-51f9-43d6-8fe2-66ebeb042669\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\",\"feedback\":\"Stepping in when the app opens, instead of relying on willpower, is the right design. A pause before continuing is a gentle nudge.\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n571:[]\n570:{\"id\":\"5fa660af-286f-4c14-a0ab-e55a4e41cb46\",\"user_id\":\"e3337257-8c07-40b7-823e-568a6a53448b\",\"user_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKMYGmGiN7AkoaSkxQhgPaUlGYTTxBfy3A43FjpwOWdNUYIkQ=s96-c\",\"user_name\":\"Scroll Checkpoint\",\"text\":\"Thank you very much for your feedback. We'll consider your suggestion in the next update\",\"created_at\":\"2026-09-19T19:10:03.318Z\",\"edited_at\":null,\"depth\":1,\"children\":\"$571\"}\n56f:[\"$570\"]\n56e:{\"replies\":\"$56f\"}\n56d:{\"vote_id\":20995,\"created_at\":\"2026-09-18T01:26:49.885792+00:00\",\"user_id\":\"ebe74b1c-7bfe-43f2-8778-efd607cc84d6\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLsnlMyhp1eaGwIhJNvGc8GsKQLqo6VeYiL1FOXbUAyggGjng=s96-c\",\"feedback\":\"Tested ScrollCheckpoint and love the approach! The gentle pause screens break doomscrolling far better than aggressive app blockers. Offline journal saving is a great bonus. A home screen widget would make toggling sessions even smoother!\",\"is_roast\":false,\"is_feedback_by_maker\":false,\"event_value\":\"$56e\"}\n56b:[\"$56c\",\"$56d\"]\n"])</script><script>self.__next_f.push([1,"572:[\"https://lh3.googleusercontent.com/a/ACg8ocKgGYOh6kcYcwPUYCBJ1BHxAxOLLbK6K1sCZDaQagMtPE95Nmc=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI2hl1NCwkwYZCby6M9MCg2TWHGgnH5uailORmWoRqCLDI7Ow=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocL-YIcWJjFbkDgnsdqBV1ZQbUpwZrkFkEtd3WYj0Pncef0eDw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLmrWuQ61jbnTQBSD2RvJlUMh9uB3r6v3H-l6S1qJOgK5TbEg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJwyTEqN_pGl7XE0OO_zMRK6Er73IdXBBULIXkAfi02W3yMiA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKeL_0o7n-uB1A42h2ucOds_TDEMA5p3qCS14DqIAkAOSTTqw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI03lwHKFQVbn6rj02dWjMp1_6l8YQlxa9AEiUbdqcGBeJGASm_=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIVm1Sy32wMZ8wJ5iIv6cqXM4g_r0vRiatmydH71Ow7hgQ_Xh78=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKd2rihCXU218e6QmGGNn_nbtkxqZcg4EQR9BzpaxZp0uBAhg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocK8UUXiuGK0M5PrbbBjnFXy07RQJdzaWAati2vyy5filfbs9HiC=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIoaTM9xAw2fQkeByvmar7vjSAdVwjPqnCaNWHYtrUsnurCYM9H=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLBXAJ1bleZ_GqDeU2EFGQh23ZeHIq1Jr4aMW2aXtgpTUBC2Bw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKJuWJ584CJth0ypMC19EK8vqcREMQ-YYv7hlIcY2dD7_w7qzv0=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocL1u6o91hntfDjqFX8gpnHbYXcnKrEQednYLjiTCMbOxwQlFw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIFgJxtrbfZruSGBYUdtjrIJlCZJleExKZVzuy-xsi-y071aA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIy_k0MMe2mN8TWqRCsARvE9Y_x9V6G6YJqfhkfbXvOpoua-or0=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKbtRovHeqW0IG3DLyVFXxW5ctq83xZVzCr8LZGaj5lMYHwq7jP=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKxwwLtC14AShgcO05Ev1wPmYQYHlPVwZ_5E5_kkhgElw7i6A=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJfCLbBlQmPAwMMZunkKKcZSiKrVbmlThcALkK51HZusd-aw3I=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocInQfdkEVPSM8iWblHAiqueQWVTwrUG8o0gZAd9GJnZ7U0QJw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLM8w8EvW7M_d7ddJNqZZICHTwi82MICWM9nYqu1CPWAVhq1A=s96-c\",null,\"https://lh3.googleusercontent.com/a/ACg8ocKETWOpUvTCpP9RztGXD4HlJ0McnL605dYkri2ZXG67CDmKqAyM=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJevgv3srkNqfs8UOZ6jiZDTOH3rLI2NJ61y50OUjSTqm7s8Xw8lw=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJELC3zYTBvXTXLAV4tjX86oJPBpK5tsdz1BmzZmXSx2wLwb94r=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIVCL49WwLIWhWhYzraLVtanflY1pKEyEs5hX9cekRVJCb4LA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLsNXa8kPYYOQ3SbYycUQCOafZAevyQ74LS24Oc6fOD13eoj6g=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocL5b1JkruJC9M_28bOmNbZal5hF1UWDIimXmW8rDg5E6GPANXj7RA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocKbvI8F7WCrPuA1LNNUF46j5zC9qBUmZWaDB-hczm3KFYgNwg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocLgRyuRk-PLW2HzKKz83Mze5R4fQzEqR01RXQcrAU6Y2ZEy2w=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocIIuBfjpw0prqCMbMQBpxUnLnq2CgAcGA30g7xTSxGHJrEaL-Sl=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJp4Z49IeByLRz22epHlCf7CWSoAvqls-JIQRu4Egqe9NGODgsA=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJBDDK-kdOv-_GwVWc4t33qB-4DCLiW6GJ0cZPk0FzQPUvuU2jh=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocJYQvPbll5tTg3evQM2yrrh8tC8C0X5uQTKpCo2R-t3FG64Cg=s96-c\",\"https://lh3.googleusercontent.com/a/ACg8ocI-FTNwJqt4txPaal7Da04y30u1dHzvLvj_J6_nd10AOMknBA=s96-c\",\"https://pbs.twimg.com/profile_images/1891564978177454080/YzRSDzkw_normal.jpg\",\"https://lh3.googleusercontent.com/a/ACg8ocK4G_mL2hDQaDUmQ_BJf0piVWXDQgUfCigWejGm7Z8Av56WGyzB=s96-c\",\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\"]\n"])</script><script>self.__next_f.push([1,"574:{\"vote_id\":21149,\"created_at\":\"2026-09-24T23:40:05.219361+00:00\",\"user_id\":\"b9fecca6-51f9-43d6-8fe2-66ebeb042669\",\"voter_avatar_url\":\"https://pbs.twimg.com/profile_images/1912674739900018689/1et7uuSX_normal.jpg\",\"feedback\":\"Focusing on who to experience a place with, not just where to go, is a thoughtful angle for travel discovery.\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n575:{\"vote_id\":20980,\"created_at\":\"2026-09-16T18:18:22.221524+00:00\",\"user_id\":\"9b380b43-355a-433f-98b9-e5920555485f\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocK4G_mL2hDQaDUmQ_BJf0piVWXDQgUfCigWejGm7Z8Av56WGyzB=s96-c\",\"feedback\":\"Onyatrips makes travel discovery and planning feel simpler and more convenient. I love the idea of bringing travel information together in one place. With more personalization, it could become a great travel companion! ✈️\\n\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n576:{\"vote_id\":20957,\"created_at\":\"2026-09-15T15:40:32.147323+00:00\",\"user_id\":\"25d7de25-3b44-44aa-9f87-937c3e403751\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJBDDK-kdOv-_GwVWc4t33qB-4DCLiW6GJ0cZPk0FzQPUvuU2jh=s96-c\",\"feedback\":\"Huge congratulations on the launch! 🎉 The travel space desperately needs a platform focused on meaningful connections rather than just generic itineraries. The 5.0 rating on the Idea says it all—this is exactly 'The Way Travel Should Be.' \",\"is_roast\":false,\"is_feedback_by_maker\":false}\n577:{\"vote_id\":20922,\"created_at\":\"2026-09-15T04:44:00.78975+00:00\",\"user_id\":\"d47b4a64-cedb-40a9-b4e9-77a62a798db4\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLgRyuRk-PLW2HzKKz83Mze5R4fQzEqR01RXQcrAU6Y2ZEy2w=s96-c\",\"feedback\":\"This is giving “finally, travel made easy” ✨\\nLowkey obsessed with this concept\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n578:{\"vote_id\":20919,\"created_at\":\"2026-09-15T01:55:43.021136+00:00\",\"user_id\":\"ec95feca-c8a9-439a-b4f5-d97ae55a5ee3\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocKbvI8F7WCrPuA1LNNUF46j5zC9qBUmZW"])</script><script>self.__next_f.push([1,"aDB-hczm3KFYgNwg=s96-c\",\"feedback\":\"Very helpful \u0026 useful!!  must go for it100%\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n579:{\"vote_id\":20918,\"created_at\":\"2026-09-14T21:51:19.066349+00:00\",\"user_id\":\"8a7c7a9d-50b0-4be6-b4ee-f293b18eb8c2\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocL5b1JkruJC9M_28bOmNbZal5hF1UWDIimXmW8rDg5E6GPANXj7RA=s96-c\",\"feedback\":\"Congratulations on the launch! The overall experience feels clean, intuitive, and easy to navigate. One feature I’d be particularly excited to see in future updates is more personalized recommendations based on users’ travel preferences.\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n57a:{\"vote_id\":20917,\"created_at\":\"2026-09-14T21:49:58.535459+00:00\",\"user_id\":\"08802fe5-7564-4943-a1b7-bb227313916b\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocLsNXa8kPYYOQ3SbYycUQCOafZAevyQ74LS24Oc6fOD13eoj6g=s96-c\",\"feedback\":\"Really love the concept behind Onyatrips! It makes travel feel more social, convenient, and exciting. The clean interface and group-travel experience make planning trips so much more fun.\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n57b:{\"vote_id\":20906,\"created_at\":\"2026-09-14T18:29:49.139405+00:00\",\"user_id\":\"a9d9ae16-5055-4f14-be51-14a85d49a972\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJELC3zYTBvXTXLAV4tjX86oJPBpK5tsdz1BmzZmXSx2wLwb94r=s96-c\",\"feedback\":\"Best travelling website to get socialise\",\"is_roast\":false,\"is_feedback_by_maker\":false}\n57c:{\"vote_id\":20901,\"created_at\":\"2026-09-14T17:11:12.334221+00:00\",\"user_id\":\"d8c07676-13f4-4c14-8c97-e524fb1ad645\",\"voter_avatar_url\":\"https://lh3.googleusercontent.com/a/ACg8ocJevgv3srkNqfs8UOZ6jiZDTOH3rLI2NJ61y50OUjSTqm7s8Xw8lw=s96-c\",\"feedback\":\"It's not just another travel platfo