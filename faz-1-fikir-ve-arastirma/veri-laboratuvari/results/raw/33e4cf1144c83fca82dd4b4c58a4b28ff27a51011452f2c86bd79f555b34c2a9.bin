<script>
    (function (){
        let i, t;

        const s = document.createElement('style');
        s.innerHTML = 'html body iframe#LeadboosterContainer { display: none !important; }';
        document.head.append(s);

        const showChat = () => s.remove();

        window.LeadBooster.on('initialized', () => {
            i = performance.now();
            
            
            t = setTimeout(showChat, 1000);
        });

        
        
        
        window.LeadBooster.on('greetingOpened', () => {
            clearTimeout(t);
            if ( performance.now() - i < 1000 ) return showChat();
            if ( ! s.isConnected ) document.head.append(s);
        });
    })();
</script>

