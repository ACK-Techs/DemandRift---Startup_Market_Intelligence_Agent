    <script nonce="S48PdmWESPsYcKI2l4ViAA&#x3D;&#x3D;" type="text/javascript">
    (function () {
      // Source a pristine native cookie setter. A prototype-level wrapper that
      // another actor (for example fides.js or a document-start extension)
      // installed before us must not leak in. We read the setter from a
      // throwaway same-origin iframe, whose Document.prototype no top-level
      // actor has touched. If that path cannot yield a native setter, we fall
      // back to the top-level descriptor.
      //
      // A native accessor stringifies with a "[native code]" body. A foreign
      // wrapper is ordinary JavaScript and fails this test, so we never accept
      // a wrapped setter as if it were pristine.
      function isNativeSetter(fn) {
          try {
              return typeof fn === "function" &&
                  /\{\s*\[native code\]\s*\}/.test(Function.prototype.toString.call(fn));
          } catch (e) {
              return false;
          }
      }

      function getPristineCookieDescriptor() {
          let frame;
          try {
              frame = document.createElement("iframe");
              frame.style.display = "none";
              (document.head || document.documentElement).appendChild(frame);

              // A connected same-origin iframe exposes contentWindow and its
              // Document synchronously. Guard the dereference explicitly so a
              // null contentWindow does not throw and mask the failure.
              const win = frame.contentWindow;
              if (win && win.Document && win.Document.prototype) {
                  const descriptor = Object.getOwnPropertyDescriptor(win.Document.prototype, "cookie");
                  // Only accept the iframe descriptor if its setter is native.
                  // If it is not, do not silently return it.
                  if (descriptor && isNativeSetter(descriptor.set)) {
                      return descriptor;
                  }
              }
          } catch (e) {
              // Fall through to the top-level capture below.
          } finally {
              if (frame && frame.parentNode) {
                  frame.parentNode.removeChild(frame);
              }
          }

          // Best-effort fallback. The top-level descriptor may itself be wrapped;
          // this only runs when the iframe path could not yield a native setter.
          return Object.getOwnPropertyDescriptor(Document.prototype, "cookie");
      }

      // Closure constants. Nothing outside this IIFE can reassign them, so
      // setCookie can never delegate back into itself.
      const nativeCookieDescriptor = getPristineCookieDescriptor();
      // A missing descriptor means the cookie accessor is not on Document.prototype
      // in this environment. We cannot wrap document.cookie without a native setter,
      // so bail cleanly instead of throwing an uncaught TypeError that could break
      // other head scripts. Consent enforcement is inert either way in this case.
      if (!nativeCookieDescriptor || typeof nativeCookieDescriptor.set !== "function") {
          return;
      }
      const nativeCookieSetter = nativeCookieDescriptor.set;
      const nativeCookieGetter = nativeCookieDescriptor.get;

      // Write once through the pristine native setter. The native setter never
      // re-enters the document.cookie property accessor, so this cannot recurse.
      function writeCookieNative(cookie) {
          nativeCookieSetter.call(document, cookie);
      }

      // Keep the public property for backward compatibility with any code that
      // reads document.cookieSetter, but never use it internally.
      document.cookieSetter = nativeCookieSetter;

      // Announce that a consent setter wrapper is coming, so other actors
      // (for example Splunk RUM) can wait and wrap after us. See smConsentEnforcementReady.
      window.__smConsentEnforcementPending = true;

      var cookiesByNoticeKey = {};
      var previousConsent = {};
      var settingCookie = false;

      function deleteCookie(cookieName) {
          const paths = ["/"];
          paths.forEach(path => {
              // Delete the cookie through the pristine native setter.
              writeCookieNative(`${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=${path}`);
          });
      }

      function updateConsentSettings() {
          // Ensure Fides.consent exists
          if (!Fides.consent) {
              return;
          }

          // Get current cookies from document.cookie
          const currentCookies = new Set(document.cookie.split("; ").map(cookie => cookie.split("=")[0]));

          // Detect revoked consents (categories that were previously `true` but now `false`)
          for (const [noticeKey, wasConsented] of Object.entries(previousConsent)) {
              if (wasConsented && !Fides.consent[noticeKey]) {
                  // Find and delete only cookies that are currently present
                  (cookiesByNoticeKey[noticeKey] || []).forEach(cookieName => {
                    if (currentCookies.has(cookieName)) {
                      deleteCookie(cookieName);
                    }
                  });
              }
          }

          // Save the latest consent state
          previousConsent = { ...Fides.consent };
      }

      function isCookieAllowed(cookieName) {
          // Ensure Fides.consent exists
          if (!Fides.consent) {
              return false;
          }

          // Headless mode: Check if all notice groups are allowed
          if (!Fides.experience?.privacy_notices) {
            return Object.values(Fides.consent).every(value => value === true);
          }

          // Check if the cookie belongs to a consented notice_key
          for (const [noticeKey, isConsented] of Object.entries(Fides.consent)) {
              if (isConsented && cookiesByNoticeKey[noticeKey]?.has(cookieName)) {
                return true;
              }
          }

          return false;
      }

      function setCookie(cookie) {
        if (!cookie) {
          return;
        }

        const cookieArr = cookie.split("=");
        if (!cookieArr.length) {
          return;
        }

        const cookieName = cookieArr[0].trim();

        // Check consent before setting the cookie
        if (!isCookieAllowed(cookieName)) {
          return;
        }

        if (settingCookie) {
          // A foreign wrapper re-entered us mid-write. Write once via the
          // pristine native setter and stop, so a wrapper cycle cannot overflow
          // the stack.
          writeCookieNative(cookie);

          return;
        }

        settingCookie = true;
        try {
          // Set the cookie through the pristine native setter.
          writeCookieNative(cookie);
        } finally {
          settingCookie = false;
        }
      }
      setCookie.__smConsentWrapper = true;

      function enforceCookieSetter() {
        // Do not re-wrap if our setter is already installed.
        const current = Object.getOwnPropertyDescriptor(document, "cookie");
        if (current && current.set && current.set.__smConsentWrapper) {
          return;
        }

        Object.defineProperty(document, "cookie", {
          get: nativeCookieGetter,
          set: setCookie,
          configurable: nativeCookieDescriptor.configurable,
          enumerable: nativeCookieDescriptor.enumerable,
        });
      }

      function addFidesExperienceNameToBody() {
        const experienceConfigName = Fides?.experience?.experience_config?.name;
        if (experienceConfigName) {
          document.body.classList.add(experienceConfigName);
        }
      }

      // Listen for Fides consent updates
      window.addEventListener("FidesUpdated", (evt) => {
          // Update consent settings when preferences change
          updateConsentSettings();
      });

      // Listen for when Fides is fully initialized
      window.addEventListener("FidesInitialized", () => {
        Fides.gtm();

        if (document.readyState === "loading") {
          window.addEventListener("DOMContentLoaded", () => {
            addFidesExperienceNameToBody();
          });
        } else {
          addFidesExperienceNameToBody();
        }
        // Create a mapping of cookies grouped by notice_key
        // Headless mode does not have privacy_notices
        if (Fides.experience?.privacy_notices) {
            cookiesByNoticeKey = Object.fromEntries(
                Fides.experience.privacy_notices.map(notice => [
                    notice.notice_key,
                    new Set(notice.cookies.map(cookie => cookie.name)) // Store cookies in a Set for quick lookup
                ])
            );
        }

        enforceCookieSetter();
        updateConsentSettings();

        // Signal that our consent setter wrapper is installed, so deferred actors
        // (for example Splunk RUM) can now wrap on top of us in a stable order.
        window.__smConsentEnforcementReady = true;
        window.dispatchEvent(new Event("smConsentEnforcementReady"));
      });
