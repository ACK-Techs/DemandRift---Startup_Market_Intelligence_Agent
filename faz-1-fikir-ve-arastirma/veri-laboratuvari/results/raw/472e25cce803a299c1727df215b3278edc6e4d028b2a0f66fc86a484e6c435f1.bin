<script>
    var dd_loaded = false;
    var dd_data = document.querySelector("#software_cat_header_dd").innerHTML;
    document.querySelector(".ajax_header_cat_dropddown").onclick = function() {
        if (!dd_loaded && $.trim(dd_data) === '') {
            var dd_ajax = new XMLHttpRequest();
            dd_ajax.onreadystatechange = function() {
                if (this.readyState == 4 && this.status == 200) {
                    document.querySelector("#software_cat_header_dd").innerHTML = this.responseText;
                    dd_loaded = true;
                    setTimeout(() => {
                        tab_change();
                    }, 100); 
                                    }
            };
            dd_ajax.open("POST", "https://www.softwaresuggest.com/headerfooter/headercategory", true);
            dd_ajax.send();
        } else {
            tab_change();
        }
        function tab_change() {
            $(document).on("click", ".tab_in_drop_down a", function(e) {
                $(".drop_down_tab_panel").removeClass("active");
                $(".tab_in_drop_down a").removeClass('active');					
                $(this).addClass("active");					
                var selected_tab = $(this).attr("data-tab");
                $("#" + selected_tab).stop().addClass("active");
                return false;
            });
        }
    }
    </script>
