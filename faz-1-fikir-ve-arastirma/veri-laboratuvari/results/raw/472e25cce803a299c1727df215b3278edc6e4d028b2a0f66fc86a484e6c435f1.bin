<script>
    function setCompIdCookie(compId) {
        let existingCompIds = getCookie('compIds');
        existingCompIds = existingCompIds ? existingCompIds.split(',') : [];
        if (!existingCompIds.includes(compId)) {
            existingCompIds.push(compId);
        }
        const expires = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);
        document.cookie = `compIds=${existingCompIds.join(',')}; expires=${expires.toUTCString()}; path=/; domain=.softwaresuggest.com; SameSite=None; Secure=None`;
    }

    function getCookie(cname) {
        const name = cname + "=";
        const decodedCookie = decodeURIComponent(document.cookie);
        const ca = decodedCookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) === 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }

    var buttons = document.querySelectorAll('[data-comp-id]');
    function foreachbutton(element) {
        element.forEach(button => {
            button.addEventListener('click', () => {
                const compId = button.dataset.compId;
                setCompIdCookie(btoa(compId));
            });
        });
    };
    foreachbutton(buttons)
    const observer = new MutationObserver((mutations) => {
        buttons = document.querySelectorAll('[data-comp-id]');
        foreachbutton(buttons)
    });observer.observe(document.body, { childList: true });

</script>    </main>
