tps%3A%2F%2Fcdn.sanity.io%2Fimages%2Fq8bht0jl%2Fproduction%2F74289545e0a25123747106427f4992a1443e87ad-600x800.jpg%3Ffit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fq8bht0jl%2Fproduction%2F74289545e0a25123747106427f4992a1443e87ad-600x800.jpg%3Ffit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fq8bht0jl%2Fproduction%2F74289545e0a25123747106427f4992a1443e87ad-600x800.jpg%3Ffit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75"/></div></div></div></div></div></div></div></div></section></div><div><section class="scroll-m-header text-surface-text-primary relative bg-surface" data-theme="white"><div class="mx-auto w-full px-5 sm:px-9 md:px-10 xl:px-12 max-w-[1536px] grid gap-8 md:grid-cols-12 relative pt-12 md:pt-20 pb-12 md:pb-20"><div class="col-span-full min-w-0"><div class="flex flex-col gap-0"><div class="relative isolate overflow-hidden rounded-lg bg-card-primary px-5 py-32 text-surface-text-primary xs:px-12 md:rounded-xl" style="opacity:0;transform:translateY(40px)" data-theme="white"><div class="absolute inset-0 linear-gradient-1"></div><div class="relative mx-auto w-full max-w-[660px] flex flex-col gap-4 items-center text-center"><h2 class="w-full text-headline-400">Lock in fund admin costs for 10 years</h2><p class="w-full ">Launch, run, and scale your venture fund without worrying about increasing fund admin fees. We&#x27;ll help you choose the ideal offering for your needs.</p><div class="block w-full h-0"></div><div class="flex flex-wrap items-center gap-2"><a class="[&amp;_svg]:[stroke-width-2] inline-flex items-center justify-center gap-2 rounded-sm font-sans text-[1rem] cursor-pointer leading-normal tracking-[-0.002em] no-underline transition-colors duration-200 not-disabled:hover:no-underline focus-visible:outline-1 focus-visible:ring-1 disabled:cursor-not-allowed disabled:opacity-60 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-5 [&amp;_svg]:shrink-0 h-12 px-4 bg-cta-primary-bg text-cta-primary-text not-disabled:hover:bg-cta-primary-hover-alt-bg not-disabled:hover:text-cta-primary-text focus-visible:bg-cta-primary-active-bg focus-visible:text-cta-primary-active-text not-disabled:active:bg-cta-primary-active-bg not-disabled:active:text-cta-primary-active-text" href="/contact">Talk to an expert</a></div></div></div></div></div></div></section></div><div><section class="scroll-m-header text-surface-text-primary relative bg-surface" data-theme="white"><div class="mx-auto w-full px-5 sm:px-9 md:px-10 xl:px-12 max-w-[1536px] grid gap-8 md:grid-cols-12 relative pt-8 md:pt-12 pb-12 md:pb-20"><div class="col-span-full lg:col-span-2"><h3 class="flex items-center gap-2.5 text-body-500 text-surface-text-section-label sticky top-header-spaced-8"><span class="block size-[0.66em] rounded-full bg-current"></span>FAQs</h3></div><div class="col-span-full min-w-0 lg:col-[3/-1]"><div class="flex flex-col gap-10 md:gap-16 xl:gap-20"><div style="opacity:0;transform:translateY(40px)"><div class="flex flex-col gap-4 w-full" style="max-width:100%"><h2 class="w-full text-headline-400">Common pricing questions</h2></div></div><div class="w-full border-t border-surface-stroke-primary"><div class="w-full border-b border-surface-stroke-primary" style="opacity:0;transform:translateY(40px)"><button class="group flex w-full items-start justify-between gap-8 py-6 pr-6 text-left text-body-500"><span class="block">Does AngelList support fund migrations from other fund administrators?</span><span class="mt-1 size-5 shrink-0 group-hover:text-surface-text-hover"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssm _1q1e6zs2a8 _1q1e6zs2fn _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3ts"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></span></button><div class="overflow-hidden" style="opacity:0;height:0px;transform:translateY(-10px)"><div class="flex max-w-[70ch] flex-col gap-6 pb-6 text-surface-text-secondary"><p class="w-full ">Yes. Learn more about fund migrations <a class="hover:opacity-85 underline underline-offset-4" href="https://www.angellist.com/fund-migrations"><span>here</span></a>.</p></div></div></div><div class="w-full border-b border-surface-stroke-primary" style="opacity:0;transform:translateY(40px)"><button class="group flex w-full items-start justify-between gap-8 py-6 pr-6 text-left text-body-500"><span class="block">Is there a setup fee for launching a Venture Fund?</span><span class="mt-1 size-5 shrink-0 group-hover:text-surface-text-hover"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssm _1q1e6zs2a8 _1q1e6zs2fn _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3ts"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></span></button><div class="overflow-hidden" style="opacity:0;height:0px;transform:translateY(-10px)"><div class="flex max-w-[70ch] flex-col gap-6 pb-6 text-surface-text-secondary"><p class="w-full ">Yes. There’s a one-time implementation fee to cover the fund launch, which will be billed at the first close. After that, annual costs for Venture Funds are the same for years 1-10, billed quarterly.</p></div></div></div><div class="w-full border-b border-surface-stroke-primary" style="opacity:0;transform:translateY(40px)"><button class="group flex w-full items-start justify-between gap-8 py-6 pr-6 text-left text-body-500"><span class="block">Is there a charge based on the fund size?</span><span class="mt-1 size-5 shrink-0 group-hover:text-surface-text-hover"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssm _1q1e6zs2a8 _1q1e6zs2fn _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3ts"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></span></button><div class="overflow-hidden" style="opacity:0;height:0px;transform:translateY(-10px)"><div class="flex max-w-[70ch] flex-col gap-6 pb-6 text-surface-text-secondary"><p class="w-full ">Yes. For Venture Funds, two components make up annual fees: an annual flat fee and an annual percent of fund size. The first is a flat administrative fee corresponding to your Institutional or Full Service offering. The second is a fee based on a percent of the fund’s committed capital, which will be a fixed cost for years 1-10. Together, these make up your annual fund administration pricing.</p></div></div></div><div class="w-full border-b border-surface-stroke-primary" style="opacity:0;transform:translateY(40px)"><button class="group flex w-full items-start justify-between gap-8 py-6 pr-6 text-left text-body-500"><span class="block">What add-on services are available for Venture Funds?</span><span class="mt-1 size-5 shrink-0 group-hover:text-surface-text-hover"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssm _1q1e6zs2a8 _1q1e6zs2fn _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3ts"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></span></button><div class="overflow-hidden" style="opacity:0;height:0px;transform:translateY(-10px)"><div class="flex max-w-[70ch] flex-col gap-6 pb-6 text-surface-text-secondary"><p class="w-full ">AngelList offers a range of add-ons for Venture Funds, as outlined below. Availability of these add-ons varies by plan type, as some services may already be included in your plan.</p><ul class="list-disc pl-[calc(1em+0.5rem)]"><li>Quarterly financial statements</li><li>Audit support</li><li>Fund taxes </li><li>Blocker setup</li><li>3(c)(7) Parallel fund</li><li>Warehoused investments</li><li>Indian investments</li><li>Non-standard investments</li><li>Crypto investments</li><li>Management Company support</li><li>GP Entity support</li><li>Networked banking</li></ul><p class="w-full ">For a complete list of add-ons or additional custom features for your fund, please <a class="hover:opacity-85 underline underline-offset-4" href="https://www.angellist.com/contact"><span>speak to our team</span></a>.</p></div></div></div><div class="w-full border-b border-surface-stroke-primary" style="opacity:0;transform:translateY(40px)"><button class="group flex w-full items-start justify-between gap-8 py-6 pr-6 text-left text-body-500"><span class="block">What other fund structures does AngelList support?</span><span class="mt-1 size-5 shrink-0 group-hover:text-surface-text-hover"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssm _1q1e6zs2a8 _1q1e6zs2fn _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3ts"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></span></button><div class="overflow-hidden" style="opacity:0;height:0px;transform:translateY(-10px)"><div class="flex max-w-[70ch] flex-col gap-6 pb-6 text-surface-text-secondary"><p class="w-full ">Our scalable <a class="hover:opacity-85 underline underline-offset-4" href="/fund-administration"><span>fund administration</span></a> solutions support other investment vehicles like Rolling Funds, Scout Funds, and SPVs. For Venture Funds, AngelList supports standard, self-advised fund structures and the proprietary platform-advised fund model, which helps managers launch funds with minimal operational overhead.<br/><br/>For more on these fund structures and pricing, please <a class="hover:opacity-85 underline underline-offset-4" href="/contact"><span>contact our team</span></a>.</p></div></div></div></div></div></div></div></section></div><!--$--><!--/$--></main></div><script>$RC("B:1","S:1")</script><div hidden id="S:2"><div><footer class="bg-surface text-surface-text-primary" data-theme="white" style="opacity:0;transform:translateY(20px)"><div class="mx-auto w-full px-5 sm:px-9 md:px-10 xl:px-12 max-w-[1536px] relative grid gap-8 pb-4 pt-12 sm:grid-cols-12 md:py-20"><div class="col-span-12 pb-6 mdlg:col-span-3 mdlg:pb-0 xl:col-span-4"><a href="/" aria-label="AngelList" class="block mb-8 w-38 md:hidden"><svg fill="none" viewBox="0 0 82 24" xmlns="http://www.w3.org/2000/svg" class="w-full"><path d="m5.08978 4.67345-5.08978 14.19485h2.21088l1.47392-4.1769h5.53196l1.46914 4.1769h2.2894l-5.09458-14.19485zm-.71319 8.04955 2.07776-5.87671 2.06824 5.88141zm18.06741-3.03109c.3353.62529.4993 1.32819.4755 2.03739v7.1318h-2.1776v-6.761c0-.756-.1973-1.3075-.5872-1.6522-.4317-.3591-.982-.54396-1.5429-.51826-.378-.00006-.7525.07256-1.103.21396-.3584.1437-.6655.3912-.882.7108-.2473.3862-.3678.84-.3447 1.298v6.7325h-2.2204v-10.64551h2.2109v1.25996c.1246-.18383.2706-.35222.435-.50161.3554-.31468.7689-.55694 1.2172-.71318.4641-.16808.9541-.25338 1.4477-.252.6245-.01015 1.2415.13614 1.7949.42554.5388.28155.9859.7113 1.2885 1.23857zm9.1645-2.63404c-.4319.27191-.7459.69616-.8796 1.18865-.5057-.16088-1.0336-.2411-1.5643-.23773-.7474-.01145-1.4873.15134-2.1609.47546-.6099.29537-1.1283.75051-1.5001 1.31702-.3817.60613-.5753 1.31173-.5563 2.02783-.0202.7009.1667 1.3922.5373 1.9874.1881.2919.4198.5532.687.775l-.0998.0452c-.3596.1839-.6664.4563-.8915.7916-.2112.324-.3328.6982-.3524 1.0844-.0196.3863.0634.7709.2406 1.1146.1696.329.4337.5998.7584.7774-.344.0742-.6681.2209-.9509.4303-.2319.171-.4182.3964-.5425.6563-.1244.2599-.183.5464-.1707.8342 0 .8622.4255 1.5239 1.2766 1.9851s1.9795.691 3.3853.6894c1.6102 0 2.8915-.3003 3.844-.901.4519-.2663.8231-.6501 1.0742-1.1106.2512-.4604.3729-.9803.3522-1.5044.0172-.3585-.0438-.7165-.1789-1.049-.135-.3325-.3409-.6317-.6032-.8766-.576-.4946-1.3195-.7498-2.