ren\":[[\"$\",\"div\",null,{\"className\":\"col-span-full lg:col-span-2\",\"children\":[\"$\",\"h3\",null,{\"className\":\"flex items-center gap-2.5 text-body-500 text-surface-text-section-label sticky top-header-spaced-8\",\"children\":[[\"$\",\"span\",null,{\"className\":\"block size-[0.66em] rounded-full bg-current\"}],\"FAQs\"]}]}],[\"$\",\"div\",null,{\"className\":\"col-span-full min-w-0 lg:col-[3/-1]\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-10 md:gap-16 xl:gap-20\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$L1f\",\"9dd6f1abfa7d\",{\"children\":[\"$\",\"$L1d\",null,{\"_type\":\"richText\",\"content\":[{\"_key\":\"f0ec6f10f9c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"09bf2d7f0655\",\"_type\":\"span\",\"marks\":[],\"text\":\"Common pricing questions\"}],\"markDefs\":[],\"style\":\"headline-400\"}],\"gap\":\"100\"}]}],[\"$\",\"$L36\",\"0bd6d9165fe8\",{\"data\":{\"_key\":\"0bd6d9165fe8\",\"_type\":\"faqSubmodule\",\"collapseOtherQuestions\":false,\"hideModule\":false,\"questions\":[{\"_key\":\"26aa83327f6b\",\"_type\":\"question\",\"answerNew\":[{\"_key\":\"8808fd91c0cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"f88b385295ee\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. Learn more about fund migrations \"},{\"_key\":\"fa8515998723\",\"_type\":\"span\",\"marks\":[\"7e1e943c57ee\"],\"text\":\"here\"},{\"_key\":\"24d91f8913d7\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"7e1e943c57ee\",\"_type\":\"link\",\"href\":\"https://www.angellist.com/fund-migrations\",\"newTab\":false}],\"style\":\"normal\"}],\"question\":\"Does AngelList support fund migrations from other fund administrators?\"},{\"_key\":\"101cc6de5742\",\"_type\":\"question\",\"answerNew\":[{\"_key\":\"e4a7eeb0b6d5\",\"_type\":\"block\",\"children\":[{\"_key\":\"83d698a92ddb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. There’s a one-time implementation fee to cover the fund launch, which will be billed at the first close. After that, annual costs for Venture Funds are the same for years 1-10, billed quarterly.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Is there a setup fee for launching a Venture Fund?\"},{\"_key\":\"098f95d77d8c\",\"_type\":\"question\",\"answerNew\":[{\"_key\":\"ed562797c72a\",\"_type\":\"block\",\"children\":[{\"_key\":\"74aed8f99826\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. For Venture Funds, two components make up annual fees: an annual flat fee and an annual percent of fund size. The first is a flat administrative fee corresponding to your Institutional or Full Service offering. The second is a fee based on a percent of the fund’s committed capital, which will be a fixed cost for years 1-10. Together, these make up your annual fund administration pricing.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Is there a charge based on the fund size?\"},{\"_key\":\"879baeb639aa\",\"_type\":\"question\",\"answerNew\":[{\"_key\":\"c1a6f482d305\",\"_type\":\"block\",\"children\":[{\"_key\":\"c108f94c5d96\",\"_type\":\"span\",\"marks\":[],\"text\":\"AngelList offers a range of add-ons for Venture Funds, as outlined below. Availability of these add-ons varies by plan type, as some services may already be included in your plan.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"94c660d445f3\",\"_type\":\"block\",\"children\":[{\"_key\":\"c2413492b4dc\",\"_type\":\"span\",\"marks\":[],\"text\":\"Quarterly financial statements\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c036d69a471\",\"_type\":\"block\",\"children\":[{\"_key\":\"1cd21c2bf045\",\"_type\":\"span\",\"marks\":[],\"text\":\"Audit support\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7a8d42c04565\",\"_type\":\"block\",\"children\":[{\"_key\":\"f47837cc66b7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Fund taxes \"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9a11443794de\",\"_type\":\"block\",\"children\":[{\"_key\":\"d30e1a3574b1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Blocker setup\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"14f25608a2c0\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e182a8edfdc\",\"_type\":\"span\",\"marks\":[],\"text\":\"3(c)(7) Parallel fund\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d2b5ff3a2413\",\"_type\":\"block\",\"children\":[{\"_key\":\"2041a28ce742\",\"_type\":\"span\",\"marks\":[],\"text\":\"Warehoused investments\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9fd3098b8d4e\",\"_type\":\"block\",\"children\":[{\"_key\":\"920324e9dce3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Indian investments\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5b2332ca376d\",\"_type\":\"block\",\"children\":[{\"_key\":\"0fdc2f5b03ea\",\"_type\":\"span\",\"marks\":[],\"text\":\"Non-standard investments\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f1612aa934e8\",\"_type\":\"block\",\"children\":[{\"_key\":\"11655761eddd\",\"_type\":\"span\",\"marks\":[],\"text\":\"Crypto investments\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e632f7d00930\",\"_type\":\"block\",\"children\":[{\"_key\":\"d3d6ad5eee91\",\"_type\":\"span\",\"marks\":[],\"text\":\"Management Company support\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ce3382013240\",\"_type\":\"block\",\"children\":[{\"_key\":\"9460b2b5d99e\",\"_type\":\"span\",\"marks\":[],\"text\":\"GP Entity support\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fdf02a2b99db\",\"_type\":\"block\",\"children\":[{\"_key\":\"9e13e5a04cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Networked banking\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"da9fb0d124c6\",\"_type\":\"block\",\"children\":[{\"_key\":\"9e13e5a04cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For a complete list of add-ons or additional custom features for your fund, please \"},{\"_key\":\"96389697131b\",\"_type\":\"span\",\"marks\":[\"73549b532933\"],\"text\":\"speak to our team\"},{\"_key\":\"1d5cd9dad0b5\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"73549b532933\",\"_type\":\"link\",\"href\":\"https://www.angellist.com/contact\"}],\"style\":\"normal\"}],\"question\":\"What add-on services are available for Venture Funds?\"},{\"_key\":\"43f0980450e4\",\"_type\":\"question\",\"answerNew\":[{\"_key\":\"4bda86742581\",\"_type\":\"block\",\"children\":[{\"_key\":\"8193883cfaa4\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our scalable \"},{\"_key\":\"2de4b62a7536\",\"_type\":\"span\",\"marks\":[\"ed7f0b0eaa56\"],\"text\":\"fund administration\"},{\"_key\":\"74ef8e54f067\",\"_type\":\"span\",\"marks\":[],\"text\":\" solutions support other investment vehicles like Rolling Funds, Scout Funds, and SPVs. For Venture Funds, AngelList supports standard, self-advised fund structures and the proprietary platform-advised fund model, which helps managers launch funds with minimal operational overhead.\\n\\nFor more on these fund structures and pricing, please \"},{\"_key\":\"4ab33b19c85b\",\"_type\":\"span\",\"marks\":[\"ec8192077e93\"],\"text\":\"contact our team\"},{\"_key\":\"dc6402d75e7f\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"ed7f0b0eaa56\",\"_type\":\"link\",\"href\":\"/fund-administration\"},{\"_key\":\"ec8192077e93\",\"_type\":\"link\",\"href\":\"/contact\"}],\"style\":\"normal\"}],\"question\":\"What other fund structures does AngelList support?\"}]}}]]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"37:I[894786,[\"/_next/static/chunks/277t3stwbtk2t.js\",\"/_next/static/chunks/2k-zqw5d-k-88