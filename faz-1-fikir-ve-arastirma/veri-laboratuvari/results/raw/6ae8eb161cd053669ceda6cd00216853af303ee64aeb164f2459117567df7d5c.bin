0px)"><div class="mb-4 text-surface-text-section-label [&amp;_svg]:shrink-0"><svg fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" shape-rendering="geometricPrecision" viewBox="0 0 20 20" class="isrg1b0 isrg1b1 _1q1e6zsh3 _1q1e6zssw _1q1e6zs2ai _1q1e6zs2fx _1q1e6zs2mq _1q1e6zs3l6 _1q1e6zs3u2"><path d="M2 10h8m0 0h8m-8 0V2m0 8v8" stroke="currentColor" vector-effect="non-scaling-stroke"></path></svg></div><div class="mb-1 block text-subtitle-200">Advanced add-ons</div><div class="block max-w-prose text-body-300 text-surface-text-secondary">Blocker entities, parallel funds, and various add-ons available. Inquire for a full list.</div></div></div></div></div></div></section></div><div><section class="scroll-m-header text-surface-text-primary relative bg-surface overflow-hidden" data-theme="ink"><div class="mx-auto w-full px-5 sm:px-9 md:px-10 xl:px-12 max-w-[1536px] grid gap-8 md:grid-cols-12 relative pt-12 md:pt-20 pb-12 md:pb-20"><div class="col-span-full min-w-0"><div class="flex flex-col gap-10 md:gap-16 xl:gap-20"><div style="opacity:0;transform:translateY(40px)"><div class="flex flex-col gap-4 items-center text-center mx-auto w-full" style="max-width:100%"><h3 class="w-full text-headline-300">Trusted by 25k funds &amp; syndicates and 72k investors</h3></div></div><div class="mx-auto grid max-w-76 grid-flow-row grid-cols-2 gap-x-11 gap-y-6 md:max-w-252 md:gap-11 md:grid-cols-6" style="opacity:0;transform:translateY(40px)"><div class="relative grid before:absolute before:-left-6 before:h-full before:border-l before:border-surface-stroke-primary odd:before:hidden md:odd:not-first:before:block after:absolute after:-top-3 after:left-0 after:border-b after:border-surface-stroke-primary even:after:-left-5 md:after:hidden nth-[-n+2]:after:hidden after:w-[calc(100%+24px)]"><div class="col-start-1 row-start-1 size-full max-w-32 [&amp;_svg]:w-full [&amp;_svg]:h-auto text-surface-text-muted" style="opacity:0;transform:scale(0.97)"><svg xmlns="http://www.w3.org