,{\"_id\":\"mp-lever-verified-first\",\"name\":\"Verified First\",\"slug\":\"verified-first\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/31e3d95e596c9c0a1121bf2048814f8ffc1094fa-1547x287.png?w=400\u0026fit=max\",\"shortDescription\":\"Verified First is known for delivering streamlined background screening solutions backed by user-friendly technology and a 98% client satisfaction support team. Compatible with over 100 hiring platforms, including Lever, Verified First’s patented screening integration provides us\",\"categories\":[\"background-checks\"],\"tier\":\"preferred\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-ai-screened\",\"name\":\"AI Screened\",\"slug\":\"ai-screened\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/39d8517c09acd587ec4a6f4c9556e131d9b3d262-938x216.png?w=400\u0026fit=max\",\"shortDescription\":\"AI recruiter that screens resumes and interviews your candidates for you\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-acquireroi\",\"name\":\"AcquireROI\",\"slug\":\"acquireroi\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/4f75257d23fcf43f64c1c0546f1b926011fbf9fe-700x200.svg?w=400\u0026fit=max\",\"shortDescription\":\"AcquireROI makes job advertising easy.\",\"categories\":[\"analytics-automation\",\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-adway\",\"name\":\"Adway\",\"slug\":\"adway\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/559dfb509d9738cf8262b820fce985e30de03218-256x256.png?w=400\u0026fit=max\",\"shortDescription\":\"Boosts Your Quality of Hire\",\"categories\":[\"employer-branding\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-agora\",\"name\":\"Agora\",\"slug\":\"agora\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b08d0e3a1518f75dc6b276d24b363323e7fb0c78-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automatically create an Agora offer when a candidate is at the offer stage\",\"categories\":[\"offers\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-apriora\",\"name\":\"Alex AI\",\"slug\":\"alexai\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/0201b4fe1dd58f4d15859e7b7c2f44e629f13185-1200x1020.png?w=400\u0026fit=max\",\"shortDescription\":\"Interview everyone. Hire the best. Elevate your recruiters' impact where it matters most: the human connection.\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-alliance2020\",\"name\":\"Alliance 2020\",\"slug\":\"alliance2020\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/bf2ae34ccca55615a6234d2b438377ff0e4145da-8464x1652.png?w=400\u0026fit=max\",\"shortDescription\":\"We offer a robust suite of services that can be tailored to meet your company’s needs.\",\"categories\":[\"background-checks\",\"reference-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-alltourage\",\"name\":\"Alltourage\",\"slug\":\"alltourage\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/afd861748f75911eb45b023e532a187dfb3c707c-196x59.webp?w=400\u0026fit=max\",\"shortDescription\":\"Alltourage simplifies your hiring process and helps you retain top talent, from entry-level through the executive with the power of SMS referrals\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-appcast\",\"name\":\"Appcast\",\"slug\":\"appcast\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5e1d122a4090b26dab25c0b6c47c3549b382824c-196x83.webp?w=400\u0026fit=max\",\"shortDescription\":\"Optimize recruitment marketing using data, technology and our world-class expertise\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-aquera\",\"name\":\"Aquera\",\"slug\":\"aquera\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/27929ceade3a1e9bd7b3d06324dc64d35d4ad283-196x57.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automate Candidate Onboarding into your choice of HCM, Identity Directory, and ITSM for Day One Employee Productivity\",\"categories\":[\"onboarding\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-asendia\",\"name\":\"Asendia\",\"slug\":\"asendia\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/006c2e20def9f29b5331842684cc1fbc57c4a047-512x512.png?w=400\u0026fit=max\",\"shortDescription\":\"Redefining the Future of Interviews with AI\",\"categories\":[\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-assessfirst\",\"name\":\"AssessFirst\",\"slug\":\"assessfirst\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/bffc737e9d6c0ce62d78943f5c803c20bed9089f-1001x1001.png?w=400\u0026fit=max\",\"shortDescription\":\"Behavioural assessments powered by psychology and AI to predict the success of candidates in your organisation.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-asurint\",\"name\":\"Asurint\",\"slug\":\"asurint\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/15e562407af422384f267a816ef9980b273f24f9-196x51.webp?w=400\u0026fit=max\",\"shortDescription\":\"A Sure Way to Streamlined Background Screening\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-attesto\",\"name\":\"Attesto\",\"slug\":\"attesto\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5db37720c20b2e820e3418eb1f28614503897a4b-244x52.avif?w=400\u0026fit=max\",\"shortDescription\":\"Save time and money by hiring Attesto AI agents to get the tasks done. Leave the human aspects of hiring to humans.\",\"categories\":[\"analytics-automation\",\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-bandana\",\"name\":\"Bandana\",\"slug\":\"bandana\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/1ba8016d4153af77fa2fff864574f31ea85dbf5f-700x120.png?w=400\u0026fit=max\",\"shortDescription\":\"Bandana is the fastest growing and most trusted job board in the US built for modern recruiting.\",\"categories\":[\"employer-branding\",\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-barraiser\",\"name\":\"BarRaiser\",\"slug\":\"barraiser\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e24727643ed3df502a6de7d482d2ab99c8f7565b-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"BarRaiser is on a mission to help companies hire exceptional talent faster while conducting structured and fair interviews.\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-basqo\",\"name\":\"Basqo\",\"slug\":\"basqo\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f9aa4362355d558c1fbfe1b96e4fd100da3f117f-14544x4290.png?w=400\u0026fit=max\",\"shortDescription\":\"Basqo is a Workforce Planning platform for SMBs (70-1000 employees), offering native integrations to your core People systems.\",\"categories\":[\"analytics-automation\",\"hcm\",\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-bindbee\",\"name\":\"Bindbee\",\"slug\":\"bindbee\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/4f28bdb8782e7866bfeab51fc110b63150a9e25b-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"$undefined\",\"categories\":[\"app-connectors\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-boostie\",\"name\":\"Boostie\",\"slug\":\"boostie\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/6f855c5c2d6fd51ac12434c909ce36f691a18555-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"A talent marketing platform that makes it easy for hiring teams to promote, capture and convert more quality applicants.\",\"categories\":[\"employer-branding\",\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-brainner\",\"name\":\"Brainner\",\"slug\":\"brainner\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/cb6d55142dd9ac29e68fab08d4e55a9c02b1593c-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"10x Faster and Smarter Resume Screening with AI: Define your hiring criteria and analyse thousands of resumes in minutes.\",\"categories\":[\"analytics-automation\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-branch-and-bound\",\"name\":\"Branch and Bound\",\"slug\":\"branch-and-bound\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/9c1bd757f10aeb1e77467cc6e0cf3b4077d5fd84-3600x2928.png?w=400\u0026fit=max\",\"shortDescription\":\"Building the Infrastructure for the Next Generation of Technical Talent.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-bravado\",\"name\":\"Bravado\",\"slug\":\"bravado\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a7972291dea856fed864662756d33f0d36b50efd-1400x1400.png?w=400\u0026fit=max\",\"shortDescription\":\"Scale your sales team with Bravado — the hiring platform built for revenue growth. Seamlessly integrate with Lever to deliver top-tier sales talent, streamline your pipeline, and make data-driven hiring decisions faster.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-brighthire\",\"name\":\"BrightHire\",\"slug\":\"brighthire\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/48af94f3d93a9c6ec5a34a6ef6c009901e66a672-196x41.webp?w=400\u0026fit=max\",\"shortDescription\":\"BrightHire effortlessly records and transcribes interviews, transforming the way teams rally around hiring.\",\"categories\":[\"diversity-inclusion\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-cichecked\",\"name\":\"CIChecked\",\"slug\":\"cichecked\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/604cdc640730dcdd0f134951e5a57ddaf6b97e53-400x100.png?w=400\u0026fit=max\",\"shortDescription\":\"Innovating Screening Standards\",\"categories\":[\"background-checks\",\"reference-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-clara\",\"name\":\"CLARA\",\"slug\":\"clara\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/11d00a8d948484b48a03d98067bbcff4cfc1192b-616x90.png?w=400\u0026fit=max\",\"shortDescription\":\"Filtering talent IN, not out.\",\"categories\":[\"assessments\",\"diversity-inclusion\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-cangrade\",\"name\":\"Cangrade\",\"slug\":\"cangrade\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/bcdd7a953a32fce534fda4cf46287b17e4a4a841-186x186.svg?w=400\u0026fit=max\",\"shortDescription\":\"\u003cdiv id=\\\"block-63a086e8f3003adfef3b4977\\\" class=\\\"sqs-block html-block sqs-block-html\\\" data-blend-mode=\\\"NORMAL\\\" data-block-type=\\\"2\\\" data-border-radii=\\\"{\\\"topLeft\\\":{\\\"unit\\\":\\\"px\\\",\\\"value\\\":0.0},\\\"topRight\u0026qu\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-canvass\",\"name\":\"Canvass\",\"slug\":\"canvass\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/86e0ceadfa3dc6e73f5811b0cbedf5bee0f3dad6-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Pre-record your interview questions and invite candidates to respond in their own time.\",\"categories\":[\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-ceridian-dayforce\",\"name\":\"Ceridian Dayforce\",\"slug\":\"ceridian-dayforce\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a968dcfd7ac0b60db6ec3a059d8ebaae3f6ec901-196x61.webp?w=400\u0026fit=max\",\"shortDescription\":\"The Lever – Ceridian Dayforce business process automation allows your teams to work together and provide an exceptional candidate and employee experience that spans systems.\",\"categories\":[\"hcm\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-cezanne-hr\",\"name\":\"Cezanne HR\",\"slug\":\"cezanne-hr\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d1ba3cd6095d3ad65a71c2342ed441b1e6a82d51-801x206.png?w=400\u0026fit=max\",\"shortDescription\":\"HR Software \u0026 Payroll that works your way. Modern HR software and payroll that puts you in control and connects your people, wherever they are.\",\"categories\":[\"hcm\",\"hris-payroll\",\"onboarding\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-ciivsoft\",\"name\":\"CiiVSOFT\",\"slug\":\"ciivsoft\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/751dd34f15e80b8853619aca501a08c50aab4444-350x100.svg?w=400\u0026fit=max\",\"shortDescription\":\"\u003csection class=\\\"elementor-section elementor-top-section elementor-element elementor-element-86b8a0b elementor-section-boxed elementor-section-height-default elementor-section-height-default\\\" data-id=\\\"86b8a0b\\\" data-element_type=\\\"section\\\" data-settings=\\\"{\\\"background_background\\\":\\\"cl\",\"categories\":[\"analytics-automation\",\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-classet\",\"name\":\"Classet\",\"slug\":\"classet\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ca61c810518ba8a633409d7fb6fe87bbe18544f2-1724x907.png?w=400\u0026fit=max\",\"shortDescription\":\"Automate outreach and screening with instant phone interviews triggered right from Lever. Hire faster without the back and forth.\",\"categories\":[\"assessments\",\"communication\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-clearstar\",\"name\":\"ClearStar\",\"slug\":\"clearstar\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/047b4f68f32486d74339defaa2db6526b2203684-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Background Testing, Drug, Clinical, and Occupation Health screening solutions that are the Better, Easier, Faster, and Safer solution for your customers.\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-clevry\",\"name\":\"Clevry\",\"slug\":\"clevry\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/cc8984a870a39dcd5dfb3c8cbae448678c121acf-5912x2294.jpg?w=400\u0026fit=max\",\"shortDescription\":\"Science-driven assessments for smarter, fairer hiring decisions.\",\"categories\":[\"analytics-automation\",\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-codesubmit\",\"name\":\"CodeSubmit\",\"slug\":\"codesubmit\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/dc6a629643b9b89341c22a1b6130b8d88273fbff-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"CodeSubmit provides a library of real-world tasks, natural candidate experience, and insightful reports.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-coderpad\",\"name\":\"CoderPad\",\"slug\":\"coderpad\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/dc46f1a43dc5b9ed3d161914ec161b9b7c8e1f86-196x28.webp?w=400\u0026fit=max\",\"shortDescription\":\"CoderPad is a technical interview platform for leading development teams. It enables a quick, accurate read on a candidate’s skills.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-coderbyte\",\"name\":\"Coderbyte\",\"slug\":\"coderbyte\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e91f3ef0e4932a83014b37c7dfbdbb357218c92b-196x54.webp?w=400\u0026fit=max\",\"shortDescription\":\"Coderbyte is a code assessment platform for screening, interviews, and take-home projects. Integration with Coderbyte is done via Growhire – our recruiting automation platform.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-contactout\",\"name\":\"ContactOut\",\"slug\":\"contactout\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e0a3d82ea83045dca36e4c2c4d15995d1132945d-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Find anyone’s email address \u0026 phone number\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-covey\",\"name\":\"Covey\",\"slug\":\"covey\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e1f23e0745a46ce850663e013ec371675566c549-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Recruiting platform with the world’s most intelligent AI outbound sourcing and inbound candidate screening assistant\",\"categories\":[\"resume-screening\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-cronofy\",\"name\":\"Cronofy\",\"slug\":\"cronofy\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5c2f0281526f5e5d52593007ee77d79eea480b2e-196x238.webp?w=400\u0026fit=max\",\"shortDescription\":\"Flexible, scalable interview scheduling with the power to support any recruitment process\",\"categories\":[\"calendars-scheduling\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-datapeople\",\"name\":\"Datapeople\",\"slug\":\"datapeople\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d024f56050a51efe5181c1026c5fbe4e3f84ca35-196x40.webp?w=400\u0026fit=max\",\"shortDescription\":\"Double recruiting productivity by writing incredible, inclusive, and compliant job ads without all the back-and-forth\",\"categories\":[\"analytics-automation\",\"employer-branding\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-deel\",\"name\":\"Deel\",\"slug\":\"deel\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/892505534fa65214a67daed2e3032ea8c704b3c5-2881x1463.png?w=400\u0026fit=max\",\"shortDescription\":\"Global Payroll, HRIS, compliance and Hiring via EOR and Contractor services.\",\"categories\":[\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-deeper-signals\",\"name\":\"Deeper Signals\",\"slug\":\"deeper-signals\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/52e629e579b9242f6c35bee77bc1dd696e188387-400x262.png?w=400\u0026fit=max\",\"shortDescription\":\"Find and grow your top talent faster\",\"categories\":[\"assessments\",\"talent-management\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-docusign\",\"name\":\"DocuSign\",\"slug\":\"docusign\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/0ab58e3fa3db8faa9404d4eae320cf67c94da44d-196x76.webp?w=400\u0026fit=max\",\"shortDescription\":\"DocuSign is a global standard for e-signature, and enables organizations of any size to securely send, sign, track, and store business critical documents directly from the applications they use every day.\",\"categories\":[\"e-signature\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-dover\",\"name\":\"Dover\",\"slug\":\"dover\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/c4d0c75bbb734b8c2f79f49a82004c9cf6bf9a66-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Dover makes hiring better at every step: find the best talent, manage candidate outreach, and automate interview scheduling with Dover.\",\"categories\":[\"calendars-scheduling\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-dweet\",\"name\":\"Dweet\",\"slug\":\"dweet\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/2a0b09e4db3231b990b3ca2edf49867837042d1f-196x198.webp?w=400\u0026fit=max\",\"shortDescription\":\"Nova, an AI assistant for recruitment tasks on top of your existing workflow.\",\"categories\":[\"analytics-automation\",\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-earnbetter\",\"name\":\"EarnBetter\",\"slug\":\"earnbetter\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5e337eac1ec525d871c1d3d8d4e6592dc035ec2a-2147x1627.png?w=400\u0026fit=max\",\"shortDescription\":\"EarnBetter AI Agents review apps and conduct phone screens to identify qualified \u0026 interested candidates\",\"categories\":[\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-elpha\",\"name\":\"Elpha\",\"slug\":\"elpha\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d1090b4d7ad5efdc84948444a0ac035c9cf217db-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Candid, insider conversations with women behind the scenes in tech.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-feenyx\",\"name\":\"Feenyx\",\"slug\":\"feenyx\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/24489aaf79bef5f2e1f8fc0cd0c7d94fe8fe1dff-1080x378.png?w=400\u0026fit=max\",\"shortDescription\":\"‍Elevate Hiring With Feenyx\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-fireflies-ai\",\"name\":\"Fireflies.ai\",\"slug\":\"fireflies-ai\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/0b1318ccb962bedade94138084e41c46d28840f6-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automate meeting notes, summaries, and action items directly in Lever candidate profiles using Fireflies.ai\",\"categories\":[\"analytics-automation\",\"communication\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-first-advantage\",\"name\":\"First Advantage\",\"slug\":\"first-advantage\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b0d1caf58583b38f14eeb76239e580d8bf972d42-2456x513.png?w=400\u0026fit=max\",\"shortDescription\":\"Know your people™ using First Advantage’s pre-built background screening integration with Lever.\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-flatly\",\"name\":\"Flatly\",\"slug\":\"flatly\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5dd282afdb7fb58e9d706e5a62942b7006ce19b9-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automatically Export \u0026 Sync Lever Data to CSV, Excel XLSX and Google Sheets in over 10 Cloud Storage destinations. Connect to Business Intelligence apps like PowerBI and Google Data Studio.\",\"categories\":[\"analytics-automation\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-gem\",\"name\":\"Gem\",\"slug\":\"gem\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5be45becb13fc5cdd985cf160523ac75b6e9a053-906x360.svg?w=400\u0026fit=max\",\"shortDescription\":\"Engage your entire talent network, optimize sourcing efforts, and uncover full-funnel insights that guide smarter decisions\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-give-a-grad-a-go\",\"name\":\"Give a Grad a Go\",\"slug\":\"give-a-grad-a-go\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/854ddc9e02b3841a5216cbb255fd1fed16797704-196x105.webp?w=400\u0026fit=max\",\"shortDescription\":\"Advertise your jobs to millions of diverse graduates in the UK, Australia \u0026 beyond. Target grads in the early stages of their career, as well as candidates looking for their 2nd and 3rd jobs. Promote your brand and scale your teams accurately.\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-goodtime\",\"name\":\"GoodTime\",\"slug\":\"goodtime\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/7ec7e81457ec622fcb97988235ab6992a8fe76e1-196x131.webp?w=400\u0026fit=max\",\"shortDescription\":\"The leader in complex interview scheduling for Lever.\",\"categories\":[\"analytics-automation\",\"communication\",\"resume-screening\",\"calendars-scheduling\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-gusto\",\"name\":\"Gusto\",\"slug\":\"gusto\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ecf18647c42ab41ede2bff1dd56ecd9a38abd3bb-300x115.png?w=400\u0026fit=max\",\"shortDescription\":\"Gusto makes it easy to onboard, pay, insure, and support your hardworking team.\",\"categories\":[\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hackajob\",\"name\":\"Hackajob\",\"slug\":\"hackajob\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/4bba381179896e82f3a3372aeba23f7992a9b63a-196x194.webp?w=400\u0026fit=max\",\"shortDescription\":\"Hackajob helps make hiring process fairer, faster, and based on skills rather than backgrounds, so people can get the job they deserve and earn what they’re worth.\",\"categories\":[\"calendars-scheduling\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hackerearth\",\"name\":\"HackerEarth\",\"slug\":\"hackerearth\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/43278ad2f1aeb7220623b5de2a24f68d8d59a5ab-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"The most advanced coding assessments out there\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hallo\",\"name\":\"Hallo\",\"slug\":\"hallo\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/2611647412aff2c003755645a3cadbf04a74ee98-1080x500.png?w=400\u0026fit=max\",\"shortDescription\":\"Hallo is an AI-powered language assessments for global hiring across 60+ languages.\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-handshake\",\"name\":\"Handshake\",\"slug\":\"handshake\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/cecbad0d89761ee16a505c68aa453010396bbb19-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Recruit smarter, not harder. Need to hire now? Place your job in front of qualified candidates where they are already browsing.\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-heymilo\",\"name\":\"HeyMilo\",\"slug\":\"heymilo\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/2a2e03e25bcd8862382febc78b22cab903993e77-666x174.png?w=400\u0026fit=max\",\"shortDescription\":\"Leading Conversational AI Interviewer that your candidates actually want to interview with\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hibob\",\"name\":\"Hibob\",\"slug\":\"hibob\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/cdda79607f6b4641fbe790c3d38252c0356ca84e-888x357.png?w=400\u0026fit=max\",\"shortDescription\":\"The HR platform that turns people strategies into business success.\",\"categories\":[\"hcm\",\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hirematch\",\"name\":\"Hire Match\",\"slug\":\"hirematch\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/6a7f9e22c5d7e93419621f5e503bea845231757e-456x462.avif?w=400\u0026fit=max\",\"shortDescription\":\"Undoing the hiring black box\",\"categories\":[\"analytics-automation\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hire2retire\",\"name\":\"Hire2Retire\",\"slug\":\"hire2retire\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/6af3a4dde17b9e1a75e361d0521d46f0c773d868-1000x1000.png?w=400\u0026fit=max\",\"shortDescription\":\"Hire2Retire integrates Lever with Identity Providers (IdP), automating profile creation and onboarding workflows to provide a superior “First Day at Work” experience that drives employee retention.\",\"categories\":[\"analytics-automation\",\"onboarding\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hiresweet\",\"name\":\"HireSweet\",\"slug\":\"hiresweet\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/7594d612055c3ea487a49520d79598439c42bbbd-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Get access to highly-targeted passive candidates, and recruit them at the click of a button.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hiretrue\",\"name\":\"HireTrue\",\"slug\":\"hiretrue\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/204423dc41236c37acf5a242e0488cde8a396ace-150x39.png?w=400\u0026fit=max\",\"shortDescription\":\"Hire Better. Hire Faster. Hire Smarter\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hireflix\",\"name\":\"Hireflix\",\"slug\":\"hireflix\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5affc03473dcc290419f9ecc5056529e485b0ed4-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"One-Way Video Interviews\",\"categories\":[\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hireflow\",\"name\":\"Hireflow\",\"slug\":\"hireflow\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/c258fc4981e0cd2a95233c837e6a2913c46e043d-196x39.webp?w=400\u0026fit=max\",\"shortDescription\":\"Obliterate everyday recruiting tasks with the AI sourcing sidekick that builds candidate pipelines for you.\",\"categories\":[\"analytics-automation\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hiringkit\",\"name\":\"HiringKit\",\"slug\":\"hiringkit\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f108dc6298edb555970d275d043e117379ef10ff-200x200.jpg?w=400\u0026fit=max\",\"shortDescription\":\"AI voice screening that calls \u0026 qualifies 200 candidates in 2 hours, not 2 weeks\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hubspot\",\"name\":\"HubSpot\",\"slug\":\"hubspot\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ec56689d23d55a8e726275d3ea6925f09cc4d918-196x194.webp?w=400\u0026fit=max\",\"shortDescription\":\"Sync Candidates between Lever and HubSpot.\",\"categories\":[\"communication\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-humaans\",\"name\":\"Humaans\",\"slug\":\"humaans\",\"logoUrl\":\"$undefined\",\"shortDescription\":\"Humaans is an HRIS built to be the foundation layer of the organisation’s HR tech stack. It helps teams onboard and manage their employees through fast workflows, automation and quick access to data.\",\"categories\":[\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hypersift\",\"name\":\"Hypersift\",\"slug\":\"hypersift\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/8c933dd7486bee47f979a4893cc9f3511726f50e-1847x402.png?w=400\u0026fit=max\",\"shortDescription\":\"Automate your screening with Hypersift’s AI interviewer, handling everything from behavioral to technical and even coding assessments.\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-join\",\"name\":\"JOIN\",\"slug\":\"join\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/dd79ff5447fef6899e167b4ec1b6517b438e4791-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"$undefined\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-jobbytime\",\"name\":\"Jobbytime\",\"slug\":\"jobbytime\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d7a8abbc68b6669e337db0ca7747a07fc97772bd-142x34.svg?w=400\u0026fit=max\",\"shortDescription\":\"An AI-Powered Job Board with AI Auto Apply option to source relevant candidates to matching jobs and integrates with Lever in one click.\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-jobzyn\",\"name\":\"Jobzyn\",\"slug\":\"jobzyn\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/4520376c47eae7c6566717b89115c6c6d2ed7544-200x200.jpg?w=400\u0026fit=max\",\"shortDescription\":\"Land Your Dream Job\",\"categories\":[\"employer-branding\",\"job-boards-aggregators\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-jopwell\",\"name\":\"Jopwell\",\"slug\":\"jopwell\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/8e8ba8bf635a7a362d1b5b4e1344973505d2adb9-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"$undefined\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-joveo\",\"name\":\"Joveo\",\"slug\":\"joveo\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/835e0f2a23bce89152714cd91c56050521a7a895-196x76.webp?w=400\u0026fit=max\",\"shortDescription\":\"The Joveo End-to-end platform connects the dots between programmatic distribution, career sites/candidate journey, and building talent communities for candidate re-engagement.\",\"categories\":[\"analytics-automation\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-keeyora\",\"name\":\"Keeyora\",\"slug\":\"keeyora\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/31dd66775cf8cac9b2cd4eddfb63dfa76b7865c5-196x44.webp?w=400\u0026fit=max\",\"shortDescription\":\"Simple, powerful candidate texting\",\"categories\":[\"communication\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-kombo\",\"name\":\"Kombo\",\"slug\":\"kombo\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a551b984297a57a69f12bb7cf537913ae3d82e02-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Easily integrate Lever to the rest of your HR stack\",\"categories\":[\"analytics-automation\",\"app-connectors\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-lattice\",\"name\":\"Lattice\",\"slug\":\"lattice\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/00d84e66ebede263940c8b8007129b860bc9122b-196x50.webp?w=400\u0026fit=max\",\"shortDescription\":\"Lattice’s integration with Lever allows for mutual Lattice and Lever customers to seamlessly transfer hired candidates from Lever to Lattice.\",\"categories\":[\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-leoforce\",\"name\":\"Leoforce\",\"slug\":\"leoforce\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/590428b1d357e0f537e6a80c92b5c5ecfaec5900-2000x1604.png?w=400\u0026fit=max\",\"shortDescription\":\"Leoforce provides talent acquisition teams with outcome-based recruiting solutions.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-linkedin-recruiter\",\"name\":\"LinkedIn Recruiter\",\"slug\":\"linkedin-recruiter\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/237825de374855093df5ad7fbfa6e0a26f5175a5-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Lever’s integration with LinkedIn Recruiter lets you export candidates directly from LinkedIn to Lever, so you can spend less time on data entry, and more time sourcing!\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-mega-hr-inc\",\"name\":\"Mega HR, Inc.\",\"slug\":\"mega-hr-inc\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a7957431ed021388ae69e4567c5277df503c26f0-1596x342.svg?w=400\u0026fit=max\",\"shortDescription\":\"10x your Lever productivity, without adding headcount.\",\"categories\":[\"assessments\",\"communication\",\"resume-screening\",\"calendars-scheduling\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-metaview\",\"name\":\"Metaview\",\"slug\":\"metaview\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ac4a3bfa00ff3287a0520c3f535c7a8d46575c6e-196x29.webp?w=400\u0026fit=max\",\"shortDescription\":\"Metaview writes your recruiting notes for you so you can save time and focus on high-quality interactions with candidates and hiring teams.\",\"categories\":[\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-modernloop\",\"name\":\"ModernLoop\",\"slug\":\"modernloop\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/3ed873da8ee457cddfb8093989c3f728aea17b97-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Best in class interview scheduling and logistics platform\",\"categories\":[\"calendars-scheduling\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"3a683b11-31ab-4ab5-a520-66df65b47d1b\",\"name\":\"Mokka\",\"slug\":\"mokka\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f4d86f205f441e2f435760590c854fff5339c762-2627x690.png?w=400\u0026fit=max\",\"shortDescription\":\"AI agents for sourcing, screening, and integrity verification\",\"categories\":[\"ai-tools\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-mr-simon\",\"name\":\"Mr. Simon\",\"slug\":\"mr-simon\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/98ab6a750849bfb04ccf6442a3ecb9dd0828c8bf-223x30.svg?w=400\u0026fit=max\",\"shortDescription\":\"Screen candidates quickly and effectively with AI resume and interview tools that go beyond the obvious to find your best job applicants.\",\"categories\":[\"assessments\",\"resume-screening\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-namely\",\"name\":\"Namely\",\"slug\":\"namely\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a342bc86d97cb6b565e1e594351e99f97e1e0ea0-3335x1417.png?w=400\u0026fit=max\",\"shortDescription\":\"Namely is a simple, flexible, and intuitive HR solution designed for mid-sized businesses.\",\"categories\":[\"hris-payroll\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-paraform\",\"name\":\"Paraform\",\"slug\":\"paraform\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b523c0adbd3e31c6b82c43ae911789ab4020deae-196x57.webp?w=400\u0026fit=max\",\"shortDescription\":\"Supercharge your startup hiring with referral bounties and access anyone’s network. Hire candidates you couldn’t before.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-pave\",\"name\":\"Pave\",\"slug\":\"pave\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/9b6e83691b1783211decb2d5f0dbcd915a58ba8e-196x192.webp?w=400\u0026fit=max\",\"shortDescription\":\"The leading data-driven compensation platform.\",\"categories\":[\"offers\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-peoplecheck-ltd\",\"name\":\"PeopleCheck LTD\",\"slug\":\"peoplecheck-ltd\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ffc94437ed2443de97349295643572b5fee9bb90-171x28.png?w=400\u0026fit=max\",\"shortDescription\":\"PeopleCheck’s real-time background check platform is used by employers and organisations of all sizes to reduce hiring risk and protect their brand reputation.\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"874f13d0-a6b2-4758-b45c-d0d6e07ed6ec\",\"name\":\"Persona\",\"slug\":\"persona\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b334a578d40d338c6feb2df29e4e8da0f2b96c95-1194x364.png?w=400\u0026fit=max\",\"shortDescription\":\"Protect your hiring pipeline with identity verification. Verify that candidates are real\\npeople before you extend an offer\",\"categories\":[\"ai-tools\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"e05acbc1-8d83-45b6-b4ba-a1ef35e422d9\",\"name\":\"Pickle\",\"slug\":\"pickle\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ecf239142826197a3d80a7781661c55f8e4d1d4d-1152x1152.png?w=400\u0026fit=max\",\"shortDescription\":\"Source from 99% of licensed clinicians - most not on LinkedIn or job boards - and push candidates straight into your Lever postings \",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-pin\",\"name\":\"Pin\",\"slug\":\"pin\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/38609aad1803ee1923f92d4959e12af06de46438-2560x1036.png?w=400\u0026fit=max\",\"shortDescription\":\"Find and hire top talent faster with AI-powered recruiting\",\"categories\":[\"analytics-automation\",\"communication\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-popp-ai\",\"name\":\"Popp AI\",\"slug\":\"popp-ai\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5da6b04b76ebc73a1def910c4296cc62aa38e61d-196x110.webp?w=400\u0026fit=max\",\"shortDescription\":\"Deeply analyze, engage and schedule interviews with applicants on autopilot with Popp AI.\",\"categories\":[\"analytics-automation\",\"communication\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"45d121be-698f-4502-9316-6bb7b917d968\",\"name\":\"Proof\",\"slug\":\"proof\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/32fa057d691c23fa3a6bd1a303c2b6f9b4c3024e-150x150.svg?w=400\u0026fit=max\",\"shortDescription\":\"Flag fraudulent candidates and verify identity inside your Lever hiring workflow. This integration runs a passive screening and prompts applicants to complete identity verification, syncing results back to Lever.\",\"categories\":[\"ai-tools\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-purpose-jobs\",\"name\":\"Purpose Jobs\",\"slug\":\"purpose-jobs\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/49db114206e21eb6fe9de84e735ada8cca82e454-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"The #1 destination to recruit talent in the Midwest\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-qualifyme\",\"name\":\"QualifyMe\",\"slug\":\"qualifyme\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e79ba7bc8b0ad295c32a5d1c1c1f969264a4332d-512x512.png?w=400\u0026fit=max\",\"shortDescription\":\"AI-powered candidate assessments and interviews\",\"categories\":[\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-ravio\",\"name\":\"Ravio\",\"slug\":\"ravio\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/6ab2c87c2cf8004526653779f4f5ddfed0e4c8d4-1820x656.png?w=400\u0026fit=max\",\"shortDescription\":\"Ravio is a compensation platform for global tech companies offering real-time market data and tools to help them effectively manage and communicate compensation.\",\"categories\":[\"analytics-automation\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-recruitbot\",\"name\":\"RecruitBot\",\"slug\":\"recruitbot\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/42d9e8e3efe51e53341d6b0a33a14fd65fce1d7e-196x139.webp?w=400\u0026fit=max\",\"shortDescription\":\"Source Smarter to Hire Faster\",\"categories\":[\"analytics-automation\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-reczee-screeno\",\"name\":\"Reczee Screeno\",\"slug\":\"reczee-screeno\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/64c9b67208e67d08c3197bacb7a8d096d3dfe48b-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automatically tag inbound applicants to discover top candidates!\",\"categories\":[\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-refer-io\",\"name\":\"Refer.io\",\"slug\":\"refer-io\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f85468fea2be7cc5f30e7b5bc998ad1c945af023-196x78.webp?w=400\u0026fit=max\",\"shortDescription\":\"Refer.io transforms job alerts into dynamic branding tools, helping employers build a direct talent pool, engage candidates, and showcase their unique culture—all seamlessly integrated with Lever.\",\"categories\":[\"employer-branding\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-rekap\",\"name\":\"Rekap\",\"slug\":\"rekap\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/16cd7823e76604d8ecb337819a64a117b1a1f5da-2000x820.svg?w=400\u0026fit=max\",\"shortDescription\":\"AI that transforms hiring: from first touch to final offer – with insight, speed, and precision.\",\"categories\":[\"analytics-automation\",\"assessments\",\"onboarding\",\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-relay\",\"name\":\"Relay\",\"slug\":\"relay\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d10cd6fc6027bffeef2eee990e57b48c3f8f18bc-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Workflow automation beyond triggers and actions\",\"categories\":[\"analytics-automation\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-sap-successfactors\",\"name\":\"SAP SuccessFactors\",\"slug\":\"sap-successfactors\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/a70f822bb9ea872bd9dc26c8329c059e43bdf53b-196x96.webp?w=400\u0026fit=max\",\"shortDescription\":\"The SAP SuccessFactors Human Experience Management (HXM) Suite provides powerful, cloud-based solutions for core HR and payroll, talent management, employee experience management, and people analytics.\",\"categories\":[\"hcm\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-sra-screening\",\"name\":\"SRA Screening\",\"slug\":\"sra-screening\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5fa2ad7baddef80025ec200446235067f5ff4edb-236x101.png?w=400\u0026fit=max\",\"shortDescription\":\"Speedy. Reliable. Accommodating. A screening company you actually enjoy working with.\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-screenify\",\"name\":\"Screenify\",\"slug\":\"screenify\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/62914151b6e140e715ff78592ca36f291f0cf373-1588x320.png?w=400\u0026fit=max\",\"shortDescription\":\"AI agent that conducts interviews 24/7 to qualify applicants\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-searchlight\",\"name\":\"Searchlight\",\"slug\":\"searchlight\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/aa8adb451d869090dba960b1acdcb240aa616052-196x37.webp?w=400\u0026fit=max\",\"shortDescription\":\"Automate, streamline, and standardize your reference checks to hire more accurately\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-seekout\",\"name\":\"SeekOut\",\"slug\":\"seekout\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/69bacff40c1b78df35b05fa42cf65d0ef8314fd5-3840x1408.png?w=400\u0026fit=max\",\"shortDescription\":\"10x your recruiting impact with agentic AI\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-sensiply\",\"name\":\"Sensiply\",\"slug\":\"sensiply\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/0828b66b1c486f7f7794c70108d76df1b89b6c68-591x202.png?w=400\u0026fit=max\",\"shortDescription\":\"Sensiply is a modern hiring platform that helps employers connect with the right candidates faster.\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-sequoia\",\"name\":\"Sequoia\",\"slug\":\"sequoia\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/68b5965939fe096e1a41f0ff10316c0345bc6552-196x47.webp?w=400\u0026fit=max\",\"shortDescription\":\"Invest in your people, smartly.\",\"categories\":[\"hcm\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-skima-ai\",\"name\":\"Skima AI\",\"slug\":\"skima-ai\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/4a74bf8e63996f35ade6c28bcbc3cda77a48ab37-4500x1948.jpg?w=400\u0026fit=max\",\"shortDescription\":\"Skima AI provides explainable AI match scores, evidence, and feedback loops directly into Lever. No extra logins, no workflow disruption.\",\"categories\":[\"assessments\",\"resume-screening\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-speak_\",\"name\":\"Speak_\",\"slug\":\"speak_\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ca95382b57a4d836eed02d54123ae810e96935b4-196x72.webp?w=400\u0026fit=max\",\"shortDescription\":\"Use AI to streamline recruitment by evaluating resumes against job descriptions, generating alignment scores, and identifying top candidates quickly and efficiently.\",\"categories\":[\"analytics-automation\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-squarepeg\",\"name\":\"SquarePeg\",\"slug\":\"squarepeg\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/379d43de6430ce5b776c04e3e43fea4fb39ecaf3-196x89.webp?w=400\u0026fit=max\",\"shortDescription\":\"SquarePeg is an all-in-one smart recruitment platform that allows companies to source, screen and hire top quality candidates.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-swiftlynx\",\"name\":\"SwiftLynx AI\",\"slug\":\"swiftlynx\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/d79c480f4434c89ea4fd76a97b55c20d00e4772d-200x200.jpg?w=400\u0026fit=max\",\"shortDescription\":\"AI-powered resume screening and analysis copilot that syncs insights directly to Lever.\",\"categories\":[\"analytics-automation\",\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-sync2hire\",\"name\":\"Sync2Hire\",\"slug\":\"sync2hire\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b995817e65f0578cfd426a32f9483a3d9806f9ce-196x46.webp?w=400\u0026fit=max\",\"shortDescription\":\"What Slack did for email, we do for your ATS.\",\"categories\":[\"analytics-automation\",\"communication\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-talent-llama\",\"name\":\"Talent Llama\",\"slug\":\"talent-llama\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ba393891358dcca587e9358d8068fbae69f730b2-196x229.webp?w=400\u0026fit=max\",\"shortDescription\":\"Faster, smarter talent screening through conversational AI. Go beyond the resume and gain a complete understanding of qualified candidates in a fraction of the time.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-talent-io\",\"name\":\"Talent.io\",\"slug\":\"talent-io\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/9e5be80419ca6d75f046b6132b816e5ecbeda3e1-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"The simplest way to hire tech talent\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-talentwall\",\"name\":\"TalentWall\",\"slug\":\"talentwall\",\"logoUrl\":\"$undefined\",\"shortDescription\":\"TalentWall’s Hiring Management Platform utilizes your ATS data to make your team more collaborative, data-driven, efficient, and predictive.\",\"categories\":[\"analytics-automation\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-teen\",\"name\":\"Teen\",\"slug\":\"teen\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/dfb90a2e943dc9678cd73940a9400e11455180a6-762x762.png?w=400\u0026fit=max\",\"shortDescription\":\"Get relevant, pre-briefed and interested candidates delivered straight to the first stage of your hiring process.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-testtrick\",\"name\":\"TestTrick\",\"slug\":\"testtrick\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/3610fd64b057060a42e9e33119e269c870cba75b-847x176.png?w=400\u0026fit=max\",\"shortDescription\":\"A pre-screening candidate assessments tool that supports Video Interviews, Coding Assessments, Psychometric Assessments, etc and helps you filter out the top candidates earlier in the process so you save time and energy!\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-testlify\",\"name\":\"Testlify\",\"slug\":\"testlify\",\"logoUrl\":\"$undefined\",\"shortDescription\":\"Testlify helps a hiring team to better estimate how well a candidate will perform in the role.\",\"categories\":[\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-textmetrics\",\"name\":\"Textmetrics\",\"slug\":\"textmetrics\