wrap items-center gap-1.5 pt-4"><span class="bg-primary-50 text-primary-600 rounded-full px-2.5 py-1 text-xs font-medium">Background Checks &amp; I9s</span></div></article></a><a class="group block h-full" href="/marketplace/providers/flatly"><article class="hover-lift border-primary-200 flex h-full flex-col rounded-3xl border bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md"><div class="flex items-start justify-between gap-3"><div class="flex h-12 items-center"><img src="https://cdn.sanity.io/images/jc916lw4/production/5dd282afdb7fb58e9d706e5a62942b7006ce19b9-196x196.webp?w=400&amp;fit=max" alt="Flatly" class="h-10 w-auto max-w-[150px] object-contain"/></div><span class="bg-primary-100 text-primary-700 rounded-full px-2.5 py-1 text-xs font-semibold whitespace-nowrap">Integrated</span></div><h3 class="text-primary-900 group-hover:text-primary-700 mt-4 text-lg font-bold transition-colors">Flatly</h3><p class="text-primary-600 mt-2 line-clamp-3 text-sm">Automatically Export &amp; Sync Lever Data to CSV, Excel XLSX and Google Sheets in over 10 Cloud Storage destinations. Connect to Business Intelligence apps like PowerBI and Google Data Studio.</p><div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4"><span class="bg-primary-50 text-primary-600 rounded-full px-2.5 py-1 text-xs font-medium">Analytics &amp; Automation</span></div></article></a><a class="group block h-full" href="/marketplace/providers/gem"><article class="hover-lift border-primary-200 flex h-full flex-col rounded-3xl border bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md"><div class="flex items-start justify-between gap-3"><div class="flex h-12 items-center"><img src="https://cdn.sanity.io/images/jc916lw4/production/5be45becb13fc5cdd985cf160523ac75b6e9a053-906x360.svg?w=400&amp;fit=max" alt="Gem" class="h-10 w-auto max-w-[150px] object-contain"/></div><span class="bg-primary-100 text-primary-700 rounded-full px-2.5 py-1 text-xs font-semibold whitespace-nowrap">Integrated</span></div><h3 class="text-primary-900 group-hover:text-primary-700 mt-4 text-lg font-bold transition-colors">Gem</h3><p class="text-primary-600 mt-2 line-clamp-3 text-sm">Engage your entire talent network, optimize sourcing efforts, and uncover full-funnel insights that guide smarter decisions</p><div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4"><span class="bg-primary-50 text-primary-600 rounded-full px-2.5 py-1 text-xs font-medium">Sourcing</span></div></article></a><a class="group block h-full" href="/marketplace/providers/give-a-grad-a-go"><article class="hover-lift border-primary-200 flex h-full flex-col rounded-3xl border bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md"><div class="flex items-start justify-between gap-3"><div class="flex h-12 items-center"><img src="https://cdn.sanity.io/images/jc916lw4/production/854ddc9e02b3841a5216cbb255fd1fed16797704-196x105.webp?w=400&amp;fit=max" alt="Give a Grad a Go" class="h-10 w-auto max-w-[150px] object-contain"/></div><span class="bg-primary-100 text-primary-700 rounded-full px-2.5 py-1 text-xs font-semibold whitespace-nowrap">Integrated</span></div><h3 class="text-primary-900 group-hover:text-primary-700 mt-4 text-lg font-bold transition-colors">Give a Grad a Go</h3><p class="text-primary-600 mt-2 line-clamp-3 text-sm">Advertise your jobs to millions of diverse graduates in the UK, Australia &amp; beyond. Target grads in the early stages of their career, as well as candidates looking for their 2nd and 3rd jobs. Promote your brand and scale your teams accurately.</p><div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4"><span class="bg-primary-50 text-primary-600 rounded-full px-2.5 py-1 text-xs font-medium">Job Boards &amp; Aggregators</span></div></article></a><a class="group block h-full" href="/marketplace/providers/goodtime"><article class="hover-lift border-primary-200 flex h-full flex-col rounded-3xl border bg-white p-6 shadow-sm transition-shadow d