dstick\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/2dc6fe3ecb523bcd06ec018a6e93649c0db62593-196x41.webp?w=400\u0026fit=max\",\"shortDescription\":\"The fastest way to build an inclusive interview process with structured interviews, behavioral interview questions, and scorecards.\",\"categories\":[],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-zythr\",\"name\":\"ZYTHR\",\"slug\":\"zythr\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b8b13afb8e088b5198f1887ce898d8397c9862d0-200x75.png?w=400\u0026fit=max\",\"shortDescription\":\"The Applicant Prioritization Tool for a Better, Faster \u0026 Fairer Process\",\"categories\":[\"analytics-automation\",\"assessments\",\"resume-screening\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-zinc\",\"name\":\"Zinc\",\"slug\":\"zinc\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/31cb4366e64969883cb39911429f94404703ae98-196x224.webp?w=400\u0026fit=max\",\"shortDescription\":\"Zinc is your essential element for hiring at scale. Request fast background checks in 190 countries.\",\"categories\":[\"background-checks\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-rtw\",\"name\":\"[rtw] Remote Tech Work\",\"slug\":\"rtw\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/082f031ccd40424ebfd82a0a947ab31073346841-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Streamline remote hiring and talent management with [rtw] Remote Tech Work. Integrate seamlessly with Lever to enhance candidate tracking, optimize workflows, and manage recruitment efficiently.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-avua\",\"name\":\"avua\",\"slug\":\"avua\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/7c3d9fd2e5204af20f01272ec4f7b30ab5c5b2ea-300x300.png?w=400\u0026fit=max\",\"shortDescription\":\"Your AI Hiring Platform\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-casuro\",\"name\":\"casuro.ai\",\"slug\":\"casuro\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/fd89997b6f7f27298c7a02f1d04c5dc4a4edecc4-1200x630.png?w=400\u0026fit=max\",\"shortDescription\":\"Fair, unbiased AI hiring co-worker that measures how candidates really work with AI and scores them against objective rubrics – so your team moves faster and hires with confidence, not gut feel.\",\"categories\":[\"analytics-automation\",\"assessments\",\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-cord\",\"name\":\"cord\",\"slug\":\"cord\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/0a52e1b9ffd19b10e05303e6a834b39ee47f52e6-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"cord is a direct messaging tool for hiring teams to source engineers who are actively looking for work.\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-jobworx-ai\",\"name\":\"jobworX.AI\",\"slug\":\"jobworx-ai\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/c668be32082b96ede227aba0cde65371e2e98fa1-196x50.webp?w=400\u0026fit=max\",\"shortDescription\":\"A New Way To Hire\",\"categories\":[\"analytics-automation\",\"assessments\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-myinterview\",\"name\":\"myInterview\",\"slug\":\"myinterview\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b0440c094a3a5a73f57b1d2b877164d607ab0a52-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Your AI hiring assistant, streamlining recruitment from sourcing to hire.\",\"categories\":[\"video-interviews\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-tofu\",\"name\":\"tofu\",\"slug\":\"tofu\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/6d76866efc189edae7ad5dd4674df493edc553aa-196x78.webp?w=400\u0026fit=max\",\"shortDescription\":\"Hire top-talent other companies couldn’t\",\"categories\":[\"sourcing\"],\"tier\":\"integrated\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-atlantic-employee-screening\",\"name\":\"Atlantic Employee Screening\",\"slug\":\"atlantic-employee-screening\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/8c087744401cd82e149fd8742e9dbb138e3edbb4-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"The Atlantic difference: quick, compliant reports with accurate results, and a trusted support team. Did we mention the free integration?\",\"categories\":[\"background-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-backgroundchecks-com\",\"name\":\"BackgroundChecks.com\",\"slug\":\"backgroundchecks-com\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/b8d34c5c73940e6d6ab1e7e7a3eb1a7db12388f4-413x66.svg?w=400\u0026fit=max\",\"shortDescription\":\"No contracts, no minimums, and world-class support for fast background screening results.\",\"categories\":[\"background-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-bryq\",\"name\":\"Bryq\",\"slug\":\"bryq\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f4bd717d713f5aba027a1528d3aa4486e9ca9397-2500x1296.png?w=400\u0026fit=max\",\"shortDescription\":\"Talent Intelligence platform that transforms HR decision making in hiring, growing and retaining talent based on objective data.\",\"categories\":[\"assessments\",\"diversity-inclusion\",\"talent-management\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-canditech\",\"name\":\"Canditech\",\"slug\":\"canditech\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/1dea1b9b25e66323a0638dcb2a814ec6ba4c0c3a-2200x2200.png?w=400\u0026fit=max\",\"shortDescription\":\"The #1 AI-powered skills assessment platform to evaluate soft, hard, and AI skills across roles.\",\"categories\":[\"assessments\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-career-place\",\"name\":\"Career.place\",\"slug\":\"career-place\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/87467e3f0cc879780e7c3bf622b7800f8efeb1f0-3516x837.jpg?w=400\u0026fit=max\",\"shortDescription\":\"Anonymous candidate screening for inclusive, equitable and efficient hiring.\",\"categories\":[\"assessments\",\"diversity-inclusion\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-checkr\",\"name\":\"Checkr\",\"slug\":\"checkr\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e5572b8d94ad052b94721ffe904d72f983c551b4-1110x261.png?w=400\u0026fit=max\",\"shortDescription\":\"Checkr is the fastest, most accurate background check solution on the market today.\",\"categories\":[\"background-checks\",\"diversity-inclusion\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"Q7cQNPIZHkdfPsOjdnmczH\",\"name\":\"Creative Services, Inc.\",\"slug\":\"creative-services-inc\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/df42564fe27531ae1a4627cd9eca71e4197ae384-290x200.jpg?w=400\u0026fit=max\",\"shortDescription\":\"For more than 50 years, Creative Services, Inc. (CSI) has helped organizations make confident hiring decisions through comprehensive background screening solutions, unmatched quality, and exceptional client and applicant support.\",\"categories\":[\"ai-tools\",\"background-checks\",\"identity-verification\",\"reference-checks\",\"resume-screening\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-criteria\",\"name\":\"Criteria\",\"slug\":\"criteria\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/730a77558f86f2ac8a0c46a12322e43e580164b3-474x162.png?w=400\u0026fit=max\",\"shortDescription\":\"Make better talent decisions with evidence-based assessments.\",\"categories\":[\"assessments\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-crosschq\",\"name\":\"Crosschq\",\"slug\":\"crosschq\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/fbe0b71858669768784d062ff132a296c40ca598-256x256.png?w=400\u0026fit=max\",\"shortDescription\":\"Crosschq helps you hire diverse, winning teams through fast, bias-free reference checks.\",\"categories\":[\"assessments\",\"diversity-inclusion\",\"talent-management\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-direct-employers\",\"name\":\"DirectEmployers\",\"slug\":\"direct-employers\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/04557645e2a9e70cc8060f56157374175d5643dc-648x216.png?w=400\u0026fit=max\",\"shortDescription\":\"Driving Compliance. Powering Partnerships. Elevating Recruitment.\",\"categories\":[\"sourcing\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-ducknowl\",\"name\":\"Ducknowl\",\"slug\":\"ducknowl\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/95536446fb9569dc4ab6e65b1ba970c160e53125-196x168.webp?w=400\u0026fit=max\",\"shortDescription\":\"A video interviewing and assessment platform.\",\"categories\":[\"assessments\",\"video-interviews\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-hr-performance-solutions\",\"name\":\"HR Performance Solutions\",\"slug\":\"hr-performance-solutions\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/ae2a6f6f120eee90a8a76eca9566a618ba6b2e94-1024x289.png?w=400\u0026fit=max\",\"shortDescription\":\"HRPS helps organizations master areas of performance, learning and compensation management.\",\"categories\":[\"talent-management\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"QGxHPXHFgKeZjQ8KE29XZz\",\"name\":\"Incruiter\",\"slug\":\"incruiter\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/c9ef368553d9e936c33b0f707122d7e067e11e4e-512x512.png?w=400\u0026fit=max\",\"shortDescription\":\"InCruiter offers AI video interviews, AI phone screening, interview scheduling software, and interview-as-a-service. We want to build a native integration so Lever users can schedule interviews, run automated screenings, and receive candidate assessment reports inside Lever.\",\"categories\":[\"assessments\",\"calendars-scheduling\",\"onboarding\",\"resume-screening\",\"video-interviews\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-jdp\",\"name\":\"JDP\",\"slug\":\"jdp\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/7d03845e1d63c381ab736fa986f71da0ef890518-1300x600.jpg?w=400\u0026fit=max\",\"shortDescription\":\"Prevent Not Safe For Work moments with accurate and timely background checks.\",\"categories\":[\"background-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-mevitae\",\"name\":\"MeVitae\",\"slug\":\"mevitae\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/9480cc7769f73823f214454e5400e1da157d7b81-2396x2698.png?w=400\u0026fit=max\",\"shortDescription\":\"Screen CVs, cover letters, certificates and more with speed and precision, helping you shortlist faster while staying fully compliant with global standards.\",\"categories\":[\"analytics-automation\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-oysterhr\",\"name\":\"Oyster HR\",\"slug\":\"oysterhr\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5ea97051ff916d3df851b802ac2f0c7958cdc566-600x158.avif?w=400\u0026fit=max\",\"shortDescription\":\"Hire, pay, manage \u0026 care for full-timers and contractors in 180+ countries\",\"categories\":[\"hris-payroll\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-paylocity\",\"name\":\"Paylocity\",\"slug\":\"paylocity\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/e0ea60b0d0e47e8a7fb14edd104e1df3453b8fda-1482x401.png?w=400\u0026fit=max\",\"shortDescription\":\"Paylocity is the most complete platform for the modern workforce.\",\"categories\":[\"hris-payroll\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-puck\",\"name\":\"Puck\",\"slug\":\"puck\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/00c789b2a95e0608839721bab84e665dd4e17e80-790x273.png?w=400\u0026fit=max\",\"shortDescription\":\"Drive candidate quality through employer branding, candidate matching \u0026 Talent CRM.\",\"categories\":[\"analytics-automation\",\"employer-branding\",\"sourcing\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-refapp\",\"name\":\"Refapp\",\"slug\":\"refapp\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/168720261ffee9a3091a463f53abab07379dbeff-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Seamlessly perform informative and accurate reference checks on every candidate\",\"categories\":[\"reference-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"2c921bdd-ba60-40e6-8fad-e72111b7b300\",\"name\":\"SmartHRCheqs\",\"slug\":\"smarthrcheqs\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/f117e913a8d040a59a8df0ffce04c0a19dff2f7a-1822x448.webp?w=400\u0026fit=max\",\"shortDescription\":\"Comprehensive Background and Drug Screening Solutions\",\"categories\":[\"background-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-spark-hire\",\"name\":\"Spark Hire\",\"slug\":\"spark-hire\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/614e1e4732f54bbf5ad4a9320af47f54016a80a4-2842x406.png?w=400\u0026fit=max\",\"shortDescription\":\"Improve your hiring efficiency by 5-7x with Spark Hire’s video interviewing platform.\",\"categories\":[\"video-interviews\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-tavio\",\"name\":\"Tavio\",\"slug\":\"tavio\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/eb4321bac9bf025d9d1ee4746c4c94770b6fbb92-997x284.png?w=400\u0026fit=max\",\"shortDescription\":\"Choose the right applications for you, and tavio will integrate with Lever.\",\"categories\":[\"system-integrators\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-the-encompass-group\",\"name\":\"The Encompass Group\",\"slug\":\"the-encompass-group\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/758276158737bb4bd275337f18e0a71bb8ec122f-2351x538.png?w=400\u0026fit=max\",\"shortDescription\":\"Optimizing Organizational Performance Through People \u0026 Technology\",\"categories\":[\"hcm\",\"system-integrators\",\"hr-consultant\",\"recruiting-staffing\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-trinet\",\"name\":\"TriNet\",\"slug\":\"trinet\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/89ce7232dc54c9c552b7680f384f7cdb3810cd75-600x173.avif?w=400\u0026fit=max\",\"shortDescription\":\"Delivers the most comprehensive and modern mobile HR experience.\",\"categories\":[\"hris-payroll\",\"rpo-peo\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-vonq\",\"name\":\"VONQ\",\"slug\":\"vonq\",\"logoUrl\":\"$undefined\",\"shortDescription\":\"VONQ offers end-to-end recruitment marketing solutions including job distribution tools.\",\"categories\":[\"job-boards-aggregators\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-voice-by-change-state\",\"name\":\"Voice by Change State\",\"slug\":\"voice-by-change-state\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/5ba523e126b067b9f806b47f8eced2e4b736e7e6-1200x543.png?w=400\u0026fit=max\",\"shortDescription\":\"Want to know what candidates really think? Send automated experience surveys with Voice.\",\"categories\":[\"employer-branding\",\"sourcing\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-wotc-com\",\"name\":\"WOTC.com\",\"slug\":\"wotc-com\",\"logoUrl\":\"$undefined\",\"shortDescription\":\"WOTC.com is proud to partner with Lever as a leading vendor of the Work Opportunity Tax Credit.\",\"categories\":[\"tax-credits-wotc\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-wedge\",\"name\":\"Wedge\",\"slug\":\"wedge\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/74d23a652e544f80bfd904ab55fcf1236f9ec2fb-12262x2577.png?w=400\u0026fit=max\",\"shortDescription\":\"Authentic one-way video interviewing.\",\"categories\":[\"video-interviews\"],\"tier\":\"standard\",\"providerType\":\"technology\"},{\"_id\":\"mp-lever-yardstik\",\"name\":\"Yardstik\",\"slug\":\"yardstik\",\"logoUrl\":\"https://cdn.sanity.io/images/jc916lw4/production/af74c8904faae59f7cbaa0e1e840b14eac29b1f8-196x196.webp?w=400\u0026fit=max\",\"shortDescription\":\"Yardstik makes it possible for businesses to make safer, more comprehensive human security part of any successful operating model\",\"categories\":[\"background-checks\"],\"tier\":\"standard\",\"providerType\":\"technology\"}]}]}]}]]}]]\n"])</script></body></html>