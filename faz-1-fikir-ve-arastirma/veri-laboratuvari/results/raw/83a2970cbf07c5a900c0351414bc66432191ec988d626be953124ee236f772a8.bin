   $(".related-posts").has(".w-dyn-empty").css("display", "none");
</script>

<script>
//Video slider
  document.addEventListener('DOMContentLoaded', function() {
    const gallerySlider = new Swiper(".swiper.is-gallery", {
      slidesPerView: 1,
      centeredSlides: false,
      speed: 1200,
      autoplay: {
        delay: 13000,
      },
      grabCursor: true,
      navigation: {
        nextEl: ".swiper-next",
        prevEl: ".swiper-prev",
      },
      pagination: {
        el: '.swiper-pagination.home-video',
        clickable: true
      },
      breakpoints: {
        480: {
          slidesPerView: 1
        },
        768: {
          slidesPerView: 1
        },
        992: {
          slidesPerView: 2
        }
      },
      on: {
        slideChange: function() {
          updateProgressBar(this);
        }
      }
    });

    const bars = document.querySelectorAll(".swiper-pagination-bullet");

    function updateProgressBar(swiper) {
      for (let i = 0; i < bars.length; i++) {
        const bar = bars[i];
        if (i < swiper.activeIndex) {
          bar.classList.add("complete");
        } else {
          bar.classList.remove("complete");
        }
      }
    }
    updateProgressBar(gallerySlider);
  });
  
var vendorSwiper = new Swiper(".swiper-community", {
  slidesPerView: "auto",
  spaceBetween: 16,
  a11y: {
    enabled: true,
    slideRole: "listitem",  // Correct placement inside the a11y object
  },
  navigation: {
        nextEl: ".vendor-button-next",
        prevEl: ".vendor-button-prev",
      },
});

var communitySwiper = new Swiper(".swiper.is-community", {
  slidesPerView: "auto",
  spaceBetween: 16,
  loop: true,
  a11y: {
    enabled: true,
    slideRole: "listitem",  // Correct placement inside the a11y object
  },
  navigation: {
        nextEl: ".community_slide-next",
        prevEl: ".community_slide-prev",
      },
});

</script>
