<script type="text/javascript">
!function(){
  var u=window.UnicornStudio;

  if(u&&u.init){
    if(document.readyState==="loading"){
      document.addEventListener("DOMContentLoaded",function(){
        u.init()
      })
    } else {
      u.init()
    }
  } else {
    window.UnicornStudio={isInitialized:false};

    var i=document.createElement("script");

    i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.2.0/dist/unicornStudio.umd.js";

    i.onload=function(){
      if(document.readyState==="loading"){
        document.addEventListener("DOMContentLoaded",function(){
          UnicornStudio.init()
        })
      } else {
        UnicornStudio.init()
      }
    };

    (document.head||document.body).appendChild(i)
  }
}();
</script>
<script>
  gsap.registerPlugin(ScrollTrigger);

function initScrollAnimations() {
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const riveFitMap = {
    contain: "Contain",
    cover: "Cover",
    fill: "Fill",
    fitwidth: "FitWidth",
    fitheight: "FitHeight",
    none: "None",
    scaledown: "ScaleDown"
  };

  const dotFitMap = {
    contain: "contain",
    cover: "cover",
    fill: "fill",
    fitwidth: "fit-width",
    fitheight: "fit-height",
    none: "none"
  };

  document.querySelectorAll("[data-anim]").forEach(target => {
    const src = target.getAttribute("data-anim-src");
    if (!src) return;

    // Decide the player from the file extension
    const path = src.split("?")[0].toLowerCase();
    const isRive = path.endsWith(".riv");
    const isDotLottie = path.endsWith(".lottie");

    let anim;   // lottie player, dotlottie player or rive instance
    let canvas; // canvas players only
    let ro;     // canvas players only

    ScrollTrigger.create({
      trigger: target,
      start: "top bottom+=50%", // Load once it's half a viewport away from entering
      end: "bottom top-=25%",
      onEnter: handleEnter,
      onEnterBack: handleEnter,
      onLeave: handleLeave,
      onLeaveBack: handleLeave,
    });

    function handleEnter() {
      // Handle first enter: create the player
      if (!target.hasAttribute("data-anim-fired")) {
        target.setAttribute("data-anim-fired", "true");
        if (isRive) {
          createRive();
        } else if (isDotLottie) {
          createDotLottie();
        } else {
          createLottie();
        }
      } else if (anim && !reduceMotion) {
        // Already created, simply play it
        anim.play();
      }
    }

    function handleLeave() {
      if (anim && !reduceMotion) {
        anim.pause();
      }
    }

    function getFitKey() {
      return (target.getAttribute("data-anim-fit") || "contain").toLowerCase();
    }

    // With Contain the artwork is letterboxed, so any radius on the canvas
    // lands in empty space. Matching the canvas to the artwork ratio removes
    // that empty space and lets border-radius clip the artwork itself.
    function applyRatio(w, h) {
      if (getFitKey() !== "contain") return;
      if (!w || !h) return;
      canvas.style.aspectRatio = w + " / " + h;
      canvas.style.width = "100%";
      canvas.style.height = "auto";
      canvas.style.margin = "auto";
    }

    function createLottie() {
      anim = lottie.loadAnimation({
        container: target,
        renderer: "svg",
        loop: true,
        autoplay: !reduceMotion,
        path: src,
      });

      // If reduced motion is ON, load a single frame as a static SVG image
      anim.addEventListener("DOMLoaded", () => {
        if (reduceMotion) {
          const frame = parseInt(target.getAttribute("data-anim-frame") || "0", 10);
          anim.goToAndStop(frame, true);
        }
      });
    }

    async function createDotLottie() {
      canvas = document.createElement("canvas");
      target.appendChild(canvas);

      let DotLottie;
      try {
        // Loaded on demand, only for .lottie files
        ({ DotLottie } = await import("https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-web@0/+esm"));
      } catch (e) {
        console.warn("dotLottie runtime failed to load", e);
        return;
      }

      anim = new DotLottie({
        canvas: canvas,
        src: src,
        loop: true,
        autoplay: !reduceMotion,
        renderConfig: { autoResize: true },
      });

      anim.addEventListener("load", () => {
        anim.setLayout({
          fit: dotFitMap[getFitKey()] || "contain",
          align: [0.5, 0.5]
        });

        const size = anim.animationSize();
        if (size) applyRatio(size.width, size.height);

        // If reduced motion is ON, draw a single static frame and stop
        if (reduceMotion) {
          const frame = parseInt(target.getAttribute("data-anim-frame") || "0", 10);
          anim.setFrame(frame);
        }
      });
    }

    function createRive() {
      canvas = document.createElement("canvas");
      target.appendChild(canvas);

      const artboard = target.getAttribute("data-anim-artboard") || undefined;
      const stateMachines = target.getAttribute("data-anim-statemachine") || undefined;

      // Only resize once the element actually has a measurable box
      function resizeSurface() {
        if (!anim) return;
        if (!target.clientWidth || !target.clientHeight) return;
        anim.resizeDrawingSurfaceToCanvas();
      }

      anim = new rive.Rive({
        src: src,
        canvas: canvas,
        artboard: artboard,
        stateMachines: stateMachines,
        autoplay: !reduceMotion,
        layout: new rive.Layout({
          fit: rive.Fit[riveFitMap[getFitKey()] || "Contain"],
          alignment: rive.Alignment.Center
        }),
        onLoad: () => {
          const b = anim.bounds;
          if (b) applyRatio(b.maxX - b.minX, b.maxY - b.minY);

          // Wait a frame so layout has settled before measuring
          requestAnimationFrame(resizeSurface);

          // If reduced motion is ON, draw a single static frame and stop
          if (reduceMotion) {
            anim.play();
            requestAnimationFrame(() => anim.pause());
          }
        },
      });

      // Keep the drawing surface in sync with the box
      ro = new ResizeObserver(() => resizeSurface());
      ro.observe(target);
    }
  });
}

// Initialize
document.addEventListener("DOMContentLoaded", () => {
  initScrollAnimations();
});
</script><script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@srexi/purecounterjs/dist/purecounter_vanilla.js"></script>

<script>
(function() {
  const lightbox = document.getElementById('vimeoLightbox');
  const content = lightbox.querySelector('.vimeo-lightbox-content');
  const backdrop = lightbox.querySelector('.vimeo-lightbox-backdrop');
  const closeBtn = lightbox.querySelector('.vimeo-lightbox-close');
  let currentIframe = null;

  function openLightbox(vimeoId) {
    currentIframe = document.createElement('iframe');
    currentIframe.src = `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=0&title=0&byline=0&portrait=0`;
    currentIframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
    currentIframe.setAttribute('allowfullscreen', '');
    content.appendChild(currentIframe);
    lightbox.classList.add('is-open');
    document.body.classList.add('vimeo-lightbox-active');
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    document.body.classList.remove('vimeo-lightbox-active');
    setTimeout(() => {
      if (currentIframe) {
        currentIframe.remove();
        currentIframe = null;
      }
    }, 300);
  }

  document.querySelectorAll('.vimeo-lightbox-trigger').forEach(trigger => {
    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      const vimeoId = this.dataset.vimeoId;
      if (vimeoId) openLightbox(vimeoId);
    });
  });

  backdrop.addEventListener('click', closeLightbox);
  closeBtn.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeLightbox();
  });
})();
</script>

