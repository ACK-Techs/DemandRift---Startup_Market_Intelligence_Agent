/*HS Form styling*/
.hs-form-wrapper fieldset,
.hs-form-wrapper-contact fieldset {
max-width: none;
}

.hs-form-field ul,
.hs-form-field .hs-form-checkbox {
padding-left: 0px !important;
margin-left: 0px !important;
}

.hs-form-field li {
list-style: none !important;
}

.hs-form-field input,
.hs-form-field select {
    width: 100% !important;
    background: rgb(15, 23, 41) !important;
    border: none!important;
    color: rgb(148, 163, 185)!important;
    padding: 0.7rem 1rem!important;
    margin-bottom: 1em;
    border-radius: 0.5em;
    -webkit-appearance: none;
    }

.hs-form-field label {
color: rgb(148, 163, 185) !important;
}

.hs-form-wrapper .hs-error-msg,
.hs-form-wrapper-contact .hs-error-msg {
font-size: 0.75em !important;
color: #FABDC6 !important;
margin-bottom: 0px !important;
margin-top: 0px !important;
}

.hs-form-wrapper ul,
.hs-form-wrapper-contact ul {
margin-top: 0px !important;
}

.hs-form-wrapper .submitted-message {
text-align: center;
}

.hs-form-wrapper .submitted-message span {
color: #fff !important;
}

.hs-form-field textarea {
    width: 100% !important;
    background: rgb(15, 23, 41);
    border: none;
    color: rgb(148, 163, 185);
    padding: 0.7rem 1rem;
    border-radius: 0.5em;
    }
    
.hs-form-wrapper .hs-form-checkbox input {
width: 16px !important;
height: 16px !important;
padding: 0rem !important;
background-color: transparent !important;
border: 2px #C6D2E1 solid !important;
-webkit-appearance: none !important;
margin-right: 1em !important;
border-radius: 4px !important;
margin-bottom: 0em !important;
}

.hs-form-wrapper .hs-form-checkbox input:checked {
width: 16px !important;
height: 16px !important;
border: 2px #C6D2E1 solid !important;
-webkit-appearance: auto !important;
margin-right: 1em !important;
border-radius: 9px !important;
margin-bottom: 0em !important;
}

.hs-form-wrapper .hs-richtext {
font-size: 0.625em !important;
margin-bottom: 1em;
margin-top: 0em;
font-weight: 400 !important;
line-height: 140% !important;
}

.hs-form-wrapper-contact .hs-richtext {
font-size: 0.625em !important;
margin-bottom: 1em;
opacity: 0.6;
font-weight: 400 !important;
line-height: 140% !important;
}

.legal-consent-container a {
color: #94A3B8 !important;
}

.hs-form-wrapper input[type=submit],
.hs-form-wrapper-contact input[type=submit] {
background-color: var(--light--primary-2);
    color: var(--light--text-button);
    border-style: solid;
    grid-column-gap: .5em;
    grid-row-gap: .5em;
    border: 1px none var(--transparency--white-20);
    letter-spacing: -.01em;
    cursor: pointer;
    border-radius: 1em;
    justify-content: center;
    align-items: center;
    padding: 0.875em 1.125em;
    font-weight: 600;
    line-height: 100%;
    text-decoration: none;
    transition: background-color .2s;
    display: flex;
    position: relative;
}
.hs-form-wrapper input[type=submit]:hover,
.hs-form-wrapper-contact input[type=submit]:hover {
background-color: var(--light--primary-2-hover);
}

/* Light theme styling for HS Forms */
.hs-form-wrapper.light .hs-form-field input,
.hs-form-wrapper.light .hs-form-field select {
    background: transparent !important;
}

.hs-form-wrapper.light.background_white .hs-form-field input {
    background: #fff !important;
}

.hs-form-wrapper.light.pale-light .hs-form-field input {
    background: #f8fafc !important;
    border: 1px solid #E3E1DF !important;
}

.hs-form-field textarea {
      border: 1px solid #E3E1DF !important;
}

.hs-form-wrapper-contact.bg-white .hs-form-field input {
background: #fff !important;
}

.hs-form-wrapper.light .hs-form-field label {
    color: #0F1729 !important;
    font-weight: 400 !important;
}

.hs-form-wrapper.light .hs-form-field textarea {
    background: transparent !important;
}

.hs-form-wrapper.light .hs-form-field input,
.hs-form-wrapper.light .hs-form-field select {
 border: 1px #E3E1DF solid !important;
 color: #0F1729 !important;
 }
 
.hs-form-wrapper.light .legal-consent-container a {
color: #0F1729 !important;
}


#hs_show_banner_button {
width: 100%;
text-align: center !important;
border: none !important;
border-radius: 0px !important;
background-color: #0f1729 !important;
color: #94a3b8 !important;
}

/* Set color style to inherit */
.inherit-color * {
    color: inherit;
}

/* Focus state style for keyboard navigation for the focusable elements */
*[tabindex]:focus-visible,
  input[type="file"]:focus-visible {
   outline: 0.125rem solid #4d65ff;
   outline-offset: 0.125rem;
}

/* Get rid of top margin on first element in any rich text element */
.w-richtext > :not(div):first-child, .w-richtext > div:first-child > :first-child {
  margin-top: 0 !important;
}

/* Get rid of bottom margin on last element in any rich text element */
.w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
	margin-bottom: 0 !important;
}

/* Prevent all click and hover interaction with an element */
.pointer-events-off {
	pointer-events: none;
}

/* Enables all click and hover interaction with an element */
.pointer-events-on {
  pointer-events: auto;
}

/* Create a class of .div-square which maintains a 1:1 dimension of a div */
.div-square::after {
	content: "";
	display: block;
	padding-bottom: 100%;
}

/* Make sure containers never lose their center alignment */
.container-medium,.container-small, .container-large {
	margin-right: auto !important;
  margin-left: auto !important;
}

/* Apply "..." after 3 lines of text */
.text-style-3lines {
	display: -webkit-box;
	overflow: hidden;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
}

/* Apply "..." after 2 lines of text */
.text-style-2lines {
	display: -webkit-box;
	overflow: hidden;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
}

/* Adds inline flex display */
.display-inlineflex {
  display: inline-flex;
}

/* These classes are never overwritten */
.hide {
  display: none !important;
}

@media screen and (max-width: 991px) {
    .hide, .hide-tablet {
        display: none !important;
    }
}
  @media screen and (max-width: 767px) {
    .hide-mobile-landscape{
      display: none !important;
    }
}
  @media screen and (max-width: 479px) {
    .hide-mobile{
      display: none !important;
    }
}
 
