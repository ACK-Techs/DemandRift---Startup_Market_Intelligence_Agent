<style>
.community-video_card:hover .customer_arrow {
    opacity: 1;
}

.event-card_wrap:hover .customer_arrow {
    opacity: 1;
}

.swiper-community {
width: 100%;
overflow: visible;
}

.swiper-pagination-bullet {
    width: 100px !important;
    height: 3px;
    border-radius: 2px !important;
    background-color: #D5D9DF !important;
    position: relative;
    overflow: hidden;
    opacity: 1 !important;
  }

.swiper-pagination-bullet::before {
    content: "";
    display: block;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

.swiper-pagination-bullet-active {
    background: #D5D9DF;
  }

.swiper-pagination.home-video .swiper-pagination-bullet-active::before {
    background-color: #48566A;
    animation: slide-progress 13s linear forwards;
  }
  
.swiper-pagination.home-video .swiper-pagination-bullet.complete {
    background-color: #48566A !important;
  }
 

@keyframes slide-progress {
    0% {
      transform: translateX(-100%);
    }

    100% {
      transform: translateX(0);
    }
  }

.swiper-pagination {
      position: static !important;
      display: flex !important;
      justify-content: center !important;
      flex-direction: row !important;
      align-items: center !important;
    }

</style>

<style>
.vimeo-lightbox-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.vimeo-lightbox-overlay.is-open {
  opacity: 1;
  visibility: visible;
}
.vimeo-lightbox-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.9);
  cursor: pointer;
}
.vimeo-lightbox-content {
  position: relative;
  width: 85vw;
  max-width: 400px;
  aspect-ratio: 9 / 16;
  transform: scale(0.95);
  transition: transform 0.3s ease;
}
.vimeo-lightbox-overlay.is-open .vimeo-lightbox-content {
  transform: scale(1);
}
.vimeo-lightbox-content iframe {
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 16px;
}
.vimeo-lightbox-close {
  position: absolute;
  top: -50px;
  right: 0;
  width: 40px;
  height: 40px;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}
.vimeo-lightbox-close:hover {
  transform: scale(1.1);
}
.vimeo-lightbox-close svg {
  width: 24px;
  height: 24px;
  stroke: white;
  stroke-width: 2;
}
body.vimeo-lightbox-active {
  overflow: hidden;
}
</style></head><body><div class="global-styles w-embed w-iframe"><!-- Google Tag Manager (noscript) -->
