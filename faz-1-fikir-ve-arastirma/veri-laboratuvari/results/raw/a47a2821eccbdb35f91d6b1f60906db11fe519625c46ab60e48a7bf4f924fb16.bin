        <script>(function(){
            function init() {
                var svcMeta = document.getElementById('awsmp-panorama-service');
                var svc = (svcMeta && svcMeta.getAttribute('value')) || 'aws-mp-website';
                var domainMeta = document.getElementById('awsmp-panorama-domain');
                var dom = (domainMeta && domainMeta.getAttribute('value')) || 'Prod';
                var s = document.createElement('script');
                s.id = 'awsc-panorama-bundle';
                s.type = 'text/javascript';
                s.src = 'https://prod.pa.cdn.uis.awsstatic.com/panorama-nav-init.js';
                s.setAttribute('data-config', "{'appEntity':'aws-marketplace','region':'us-east-1','service':'" + svc + "','domain':'" + dom + "'}");
                s.onload = function() {
                    var meta = document.getElementById('awsmp-panorama-service-page');
                    if (!meta) return;
                    var page = meta.getAttribute('value');
                    if (!page) return;
                    if (window.panorama) {
                        window.panorama('updateCommonAttribute', 'serviceConsolePage', page);
                    }
                };
                document.head.appendChild(s);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();</script>
