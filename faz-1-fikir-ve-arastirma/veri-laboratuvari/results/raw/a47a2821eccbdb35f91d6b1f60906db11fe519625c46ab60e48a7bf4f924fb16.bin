        <script>
(function(){
    var q = window.__awsmpueQueue = [];
    function makeProxy(steps) {
        return new Proxy(function(){}, {
            get: function(_t, prop) {
                if (window.awsmpue !== proxy) {
                    var value = window.awsmpue[prop];
                    return typeof value === 'function' ? value.bind(window.awsmpue) : value;
                }
                var call = steps || [];
                if (!steps) q.push(call);
                call.push({ type: 'get', prop: prop });
                return makeProxy(call);
            },
            apply: function(_t, _this, args) {
                steps.push({ type: 'apply', args: args });
                return makeProxy(steps);
            }
        });
    }
    var proxy = window.awsmpue = makeProxy();
})();
</script>
