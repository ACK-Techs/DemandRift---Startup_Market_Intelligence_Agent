<script type="text/javascript">

$(function () {
    const bottomSheet = document.querySelector(".form-popup");
    const accessibilityButton = document.getElementById('accessibilityButton');

    if(localStorage.getItem("CookieConsentSetting") == undefined){       
       bottomSheet.style.display = "block";
       accessibilityButton.style.bottom = "300px";
    }else{
       bottomSheet.style.display = "none";
    }
    $("#consentAccept").click(function(){
        cookieConsentAccept();
        bottomSheet.style.display = "none";
    }); 
    $("#consentDecline").click(function(){
        cookieConsentDecline();
        bottomSheet.style.display = "none";
    }); 
});
</script>

    <script type="text/javascript">
      Chart.register(ChartDataLabels);
      const ctx = document.getElementById('myChart');

      const data = [31.53,30.87,32.37,32.61,32.11,31.75];
      const greyColor = 'rgb(102, 119, 136)';
      const redColor = 'rgb(213, 0, 50)';

      // Son değer kırmızı, diğerleri gri
      const backgroundColors = data.map((_, index) =>
        index === data.length - 1 ? redColor : greyColor
      );

      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['02-26','03-26','04-26','05-26','06-26','07-26'],
          datasets: [{
            label: '',
            data: data,
            backgroundColor: backgroundColors,
            borderColor: backgroundColors,
            borderRadius: {
              topLeft: 3,
              topRight: 3
            }
          }]
        },
        options: {
          maintainAspectRatio: false,
          responsive: true,
            datasets: {
                bar: {
                barPercentage: 0.5
                }
          },
          scales: {
            x: {
              display: true,
                grid: {
                display: false,
              },
              border: {
                color: '#333',
                width: 2
              },
              ticks: {
                color: '#000',
              }
            },
            y: {
              beginAtZero: false,
              max: 80,
              grid: {
                display: true
              },
            border: {
                display: false
              },
              ticks: {
                stepSize: 20,
                callback: function(value) {
                  if ([20, 40, 60, 80].includes(value)) {
                    return value;
                  }
                  return '';
                },
                color: '#333'
              }
            }
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              enabled: true,
              backgroundColor: 'white',
              titleColor: '#333',
              bodyColor: '#333',
              borderColor: '#ddd',
              borderWidth: 1,
              callbacks: {
                label: function(context) {
                  return ' ' + context.parsed.y;
                }
              }
            },
            datalabels: {
                anchor: 'end',
                align: 'top',
                color: '#333',
                font: {
                    weight: 600,
                },
                display: function(context) {
                    return context.dataIndex === data.length - 1;
                },
                formatter: function(value) {
                    return value;
                }
            }
          }
        }
      });
    </script>
</html>