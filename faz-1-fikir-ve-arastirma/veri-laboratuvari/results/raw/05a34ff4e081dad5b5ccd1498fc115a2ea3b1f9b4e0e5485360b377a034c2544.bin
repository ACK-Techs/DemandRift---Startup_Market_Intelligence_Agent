pe\":\"font/woff2\"}]\n:HL[\"/_next/static/css/cedac9d38cb85a3a.css\",\"style\"]\n:HL[\"/_next/static/css/d2d7baca3d27f8d4.css\",\"style\"]\nd:T876,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I upgrade from Researcher to List Builder or Power at any time?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, you can upgrade to any higher tier at any time. We will pro-rate and refund the remainder of the current billing period to your original form of payment.\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between Researcher and List Builder?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Researcher is free and lets you open any company profile, with a limited view of PrivCo's insight on each — the most recent year's revenue, employee count, news coverage, and funding events. List Builder unlocks the full profile: full historical financials, all available employee counts, key executive contact information, unlimited watchlists with alerts, and up to 1,000 company exports per month — everything you need to build and track an active acquisition list.\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between List Builder and Power?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"List Builder gives you full company data, unlimited watchlists, key executives contact data and up to 1,000 company exports per month. Power adds all available employee contact information, 3,000 exports per month, API and MCP credits, a dedicated account manager, and access to PrivCo's research team. Power also supports group pricing and AP invoicing for teams.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer a free trial?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, on the List Builder plan. Your card is charged for the first month when you start and the 7 trial days are added on top, so your next bill is one month and 7 days later. Cancel within 7 days for a full refund. The trial includes 5 company profiles, 100 AI searches and 125 contact views; exports and the classic search tools are not included.\"}},{\"@type\":\"Question\",\"name\":\"What payment methods do you accept?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We accept all major credit cards (Visa, Mastercard, American Express) and can arrange wire transfers or AP invoicing for Power plans.\"}}]}"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"b\":\"7hpHrU4lqYyUFnpj0rDyi\",\"p\":\"\",\"c\":[\"\",\"pricing\"],\"i\":false,\"f\":[[[\"\",{\"children\":[\"pricing\",{\"children\":[\"__PAGE__\",{}]}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/cedac9d38cb85a3a.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/d2d7baca3d27f8d4.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"__variable_246ccd __variable_c29908 __variable_09454f\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"$L2\",null,{\"id\":\"gtm\",\"strategy\":\"afterInteractive\",\"dangerouslySetInnerHTML\":{\"__html\":\"\\n                window.dataLayer = window.dataLayer || [];\\n                function gtag(){dataLayer.push(arguments);}\\n                // Initialize GTM without blocking consent for analytics\\n                (function(w,d,s,l,i){\\n                  w[l]=w[l]||[];\\n                  w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});\\n                  var f=d.getElementsByTagName(s)[0],\\n                      j=d.createElement(s), dl=l!='dataLayer'?'\u0026l='+l:'';\\n                  j.async=true;\\n                  j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;\\n              