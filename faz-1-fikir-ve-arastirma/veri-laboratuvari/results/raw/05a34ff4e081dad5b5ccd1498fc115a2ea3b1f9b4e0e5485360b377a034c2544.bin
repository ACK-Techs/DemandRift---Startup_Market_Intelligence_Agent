l rounded-md border border-input bg-transparent py-1 transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground focus-visible:outline-none focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 border-none text-sm md:text-base focus-visible:ring-0 focus-visible:ring-offset-0 placeholder:text-[#99A1AF] shadow-none z-10 text-white px-1" placeholder="Search" value=""/></form></div></div></div></div></div><div class="lg:hidden flex items-center space-x-3"><a target="_blank" href="https://system.privco.com/ai-search"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-white"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></a><button class="text-white hover:bg-white/40 rounded-xl p-1 transition-colors duration-150 relative z-50" aria-label="Toggle menu"><div style="opacity:0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu size-8"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></div></button></div></div></div></nav></div><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><main id="main-content"><nav aria-label="breadcrumb" class="mt-[75px] px-5 py-3"><ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5 md:max-w-[1350px] max-w-[450px] md:mx-auto md:px-16 px-0"><li class="inline-flex items-center gap-1.5"><a class="transition-colors hover:text-foreground text-base font-semibold" href="https://system.privco.com">PrivCo</a></li><li role="presentation" aria-hidden="true" class="[&amp;&gt;svg]:w-3.5 [&amp;&gt;svg]:h-3.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"></path></svg></li><li class="inline-flex items-center gap-1.5"><a class="transition-colors hover:text-foreground" href="/pricing">Pricing</a></li></ol></nav><div class="relative bg-gradient-to-br from-slate-800 via-slate-900 to-blue-900 py-8 px-5 text-white flex flex-col gap-2 text-center"><div class="absolute inset-0 opacity-5" style="background-image:url(/images/logo-icon.png);background-repeat:repeat;background-size:60px"></div><div class="z-10"><h1 class="md:text-5xl text-2xl mb-3">Choose Your Plan</h1><h2 class="md:text-lg text-base">Access private company intelligence at a price that works for you</h2></div></div><section class="relative overflow-hidden bg-gray-50"><div class="relative md:max-w-[1350px] max-w-[450px] mx-auto md:py-16 py-12 md:px-16 px-5 gap-12"><div style="opacity:0;transform:translateY(5px)"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><div class="h-96 flex items-center justify-center">Loading plans...</div><!--/$--></div></div></section><section class="relative overflow-hidden"><div class="relative md:max-w-[1350px] max-w-[450px] mx-auto md:py-16 py-12 md:px-16 px-5 gap-12"><div style="opacity:0;transform:translateY(5px)"><div class="flex flex-col gap-6 max-w-[1300px] mx-auto w-full"><div style="opacity:0;transform:translateY(5px)"><h1 class="md:text-4xl text-3xl text-balance text-center" style="font-size:auto;line-height:1.1">Need more information?</h1></div><div class="text-[16px] font-[400] leading-[150%] flex flex-col gap-6"></div></div><h3 class="text-center text-lg">Our team can walk you through the platform and help you choose the right plan for your needs</h3><button class="bg-blue-600 border-2 border-[#6B90F4] text-white text-base px-5 py-3 rounded-lg mx-auto self-center block mt-5">Request a Demo</button></div></div></section><section class="relative overflow-hidden bg-gray-50"><div class="relative md:max-w-[1350px] max-w-[450px] mx-auto md:py-16 py-12 md:px-16 px-5 gap-12"><div style="opacity:0;transform:translateY(5px)"><div class="flex flex-col gap-6 max-w-[1300px] mx-auto w-full"><div style="opacity:0;transform:translateY(5px)"><h1 class="md:text-4xl text-3xl text-balance text-center" style="font-size:auto;line-height:1.1">Frequently Asked Questions</h1></div><div class="text-[16px] font-[400] leading-[150%] flex flex-col gap-6"></div></div><div class="bg-white rounded-lg p-5 mb-5 border border-gray-200 shadow-sm max-w-[850px] mx-auto"><h3 class="text-xl mb-2">Can I upgrade from Researcher to List Builder or Power at any time?</h3><p class="text-gray-600">Yes, you can upgrade to any higher tier at any time. We will pro-rate and refund the remainder of the current billing period to your original form of payment.</p></div><div class="bg-white rounded-lg p-5 mb-5 border border-gray-200 shadow-sm max-w-[850px] mx-auto"><h3 class="text-xl mb-2">What is the difference between Researcher and List Builder?</h3><p class="text-gray-600">Researcher is free and lets you open any company profile, with a limited view of PrivCo&#x27;s insight on each — the most recent year&#x27;s revenue, employee count, news coverage, and funding events. List Builder unlocks the full profile: full historical financials, all available employee counts, key executive contact information, unlimited watchlists with alerts, and up to 1,000 company exports per month — everything you need to build and track an active acquisition list.</p></div><div class="bg-white rounded-lg p-5 mb-5 border border-gray-200 shadow-sm max-w-[850px] mx-auto"><h3 class="text-xl mb-2">What is the difference between List Builder and Power?</h3><p class="text-gray-600">List Builder gives you full company data, unlimited watchlists, key executives contact data and up to 1,000 company exports per month. Power adds all available employee contact information, 3,000 exports per month, API and MCP credits, a dedicated account manager, and access to PrivCo&#x27;s research team. Power also supports group pricing and AP invoicing for teams.</p></div><div class="bg-white rounded-lg p-5 mb-5 border border-gray-200 shadow-sm max-w-[850px] mx-auto"><h3 class="text-xl mb-2">Do you offer a free trial?</h3><p class="text-gray-600">Yes, on the List Builder plan. Your card is charged for the first month when you start and the 7 trial days are added on top, so your next bill is one month and 7 days later. Cancel within 7 days for a full refund. The trial includes 5 company profiles, 100 AI searches and 125 contact views; exports and the classic search tools are not included.</p></div><div class="bg-white rounded-lg p-5 mb-5 border border-gray-200 shadow-sm max-w-[850px] mx-auto"><h3 class="text-xl mb-2">What payment methods do you accept?</h3><p class="text-gray-600">We accept all major credit cards (Visa, Mastercard, American Express) and can arrange wire transfers or AP invoicing for Power plans.</p></div></div></div></section><section class="relative overflow-hidden bg-blue-700 text-white"><div class="relative md:max-w-[1350px] max-w-[450px] mx-auto md:py-16 py-12 md:px-16 px-5 gap-12"><div style="opacity:0;transform:translateY(5px)"><div class="flex flex-col gap-6 max-w-[1300px] mx-auto w-full"><div style="opacity:0;transform:translateY(5px)"><h1 class="md:text-4xl text-3xl text-balance text-center" style="font-size:auto;line-height:1.1">Still have questions?</h1></div><div class="text-[16px] font-[400] leading-[150%] flex flex-col gap-6"></div></div><h3 class="text-center">Our team is here to help you find the perfect plan for your needs</h3><button class="bg-blue-600 border-2 border-[#6B90F4] text-base px-5 py-3 rounded-lg mx-auto self-center block mt-5">Contact Sales</button></div></div></section><!--$--><!--/$--></main><section aria-label="Notifications alt+T" tabindex="-1" aria-live="polite" aria-relevant="additions text" aria-atomic="false"></section><footer class="bg-[#1a1a1a] text-gray-400 py-16 relative"><div style="opacity:0;transform:translateY(5px)"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12"><div class="lg:col-span-2"><div class="flex items-center gap-2 mb-4"><a class="inline-block" href="/"><img alt="PrivCo logo" width="200" height="100" decoding="async" data-nimg="1" class="object-contain w-[100px] md:w-[150px]" style="color:transparent" src="/images/logo.svg"/></a></div><p class="text-sm leading-relaxed mb-6">The leading private company database for contacts and financial intelligence. Trusted by professionals worldwide.</p><div class="flex gap-4"><a target="_blank" rel="noopener noreferrer" class="h-10 w-10 bg-gray-800 hover:bg-gray-700 rounded-lg flex items-center justify-center transition-colors" aria-label="Visit our Facebook page" href="https://facebook.com/privco"><img alt="Facebook icon" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" class="h-5 w-5" style="color:transparent" src="/images/svgs/facebook.svg"/></a><a target="_blank" rel="noopener noreferrer" class="h-10 w-10 bg-gray-800 hover:bg-gray-700 rounded-lg flex items-center justify-center transition-colors" aria-label="Visit our X / Twitter page" href="https://x.com/privco"><img alt="X / Twitter icon" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" class="h-5 w-5" style="color:transparent" src="/images/svgs/x.svg"/></a><a target="_blank" rel="noopener noreferrer" class="h-10 w-10 bg-gray-800 hover:bg-gray-700 rounded-lg flex items-center justify-center transition-colors" aria-label="Visit our LinkedIn page" href="https://linkedin.com/company/privco-media-llc/"><img alt="LinkedIn icon" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" class="h-5 w-5" style="color:transparent" src="/images/svgs/linkedi