<!-- Sticky Ads -->
<script type="text/javascript">
var topBannerViewed = false;
function initSticky(){
    if (SD?.Ads?.acceptable_ads_active) {
        return;
    }
        
    if($('#div-gpt-ad-728x90_a').length > 0 && $('#div-gpt-ad-300x250_a').length > 0 && window.outerWidth >= 1070 && !sdAdBlockActive){
        $(window).scroll(function(){
			var y = $(document).scrollTop();
			var z =  y + window.outerHeight;
			var navOffset = 0;
			var offset = [
				$('.nav-wrap').outerHeight(true),
				$('.nav-secondary-wrap').outerHeight(true)
			];
			for(row in offset){
				if(offset[row]) navOffset = navOffset + parseInt(offset[row]);
			}
			$('.adwrap-unviewed').each(function(){
				var cls = 'adwrap-sticky';
				var toggleCls = 'adwrap';
				
				if($(this).hasClass('railad')) {
					if(topBannerViewed){
						var topPixels = $(this).offset().top;
						navOffset += $('.adwrap').outerHeight();
						if(y >= topPixels && y >= navOffset){
							$('#slashboxes').css('top', 0).css('position','sticky').css('right',13);
						} else {
							$('#slashboxes').removeAttr('style');
						}
					}
					return;
				}
				var topPixels = $(this).offset().top;
				if(y >= topPixels && y >= navOffset){
					$(this).addClass(cls);
					$(this).removeClass('adwrap');
					if(cls == 'adwrap-sticky') { //top banner
						topBannerViewed = false;
						$('#slashboxes').css('top',$(this).outerHeight() || 0).css('position','sticky').css('right',13);
					}
					if(topBannerViewed) {
						
						$('#slashboxes').css('top', 0).css('position','sticky').css('right',13);
					}
				}else{
					
					$(this).removeClass(cls);
					$(this).addClass(toggleCls);
					$('#slashboxes').removeAttr('style');
				}
			});
			if($('.adwrap-viewed-banner').length > 0){
				
				topBannerViewed = true;
				$('.adwrap-viewed-banner').removeClass('adwrap-unviewed').removeClass('adwrap-sticky').addClass('adwrap');
			}
			if($('.adwrap-viewed-railad').length > 0){
				
            	$('.adwrap-viewed-railad').removeClass('adwrap-unviewed').removeClass('adwrap-railad-sticky');
                $('#slashboxes').removeAttr('style');
            }
        });
    }
}
bizx.cmp.ifConsent({purposes: 'all', vendors: 'google-ads'}, function () {
	if (!sdAdBlockActive) {
		initSticky();
	}
	if (SD?.Ads?.acceptable_ads_active) {
		// similar to remove* code above in initSticky
		$('.adwrap-unviewed').removeClass('adwrap-unviewed').removeClass('adwrap-sticky').addClass('adwrap').removeClass('adwrap-railad-sticky');
		$('#slashboxes').removeAttr('style');
	}
});
</script>

<style>
#slashboxes .ntv-preview-img-wrapper {
    display: block;
    margin: 0 auto !important;
    width: 100%;
    float: none;
    text-align: center;
}
#slashboxes strong {
    margin-bottom: -5px;
    display: block;
}
#slashboxes .ntv-preview-img-wrapper {background: #F7F7F7;}
#slashboxes .nel-image {
    float: none;
    margin-top: 10px;
}
#slashboxes .p.ntv-body {
    text-align: left;
    border-top: 1px solid #CCCCCC;
}

#slashboxes .p.ntv-body strong {
    display: block;
}

#slashboxes .p.ntv-body .nel-button {
    width: 100%;
    text-align: center;
    margin: 15px 0;
    padding: 8px;
}

#slashboxes .p.ntv-body {
    background: #fff;
    margin: 0;
    padding: 10px 10px 1px 10px;
}
#slashboxes article:first-child {
    border-radius: 0px !important;
    padding-top: 1;
}
#slashboxes article:first-child header {
    border-radius: 0px !important;
}
#slashboxes article:first-child h2.story {
    padding-left: 10px;
    background: #6D4634;
}

#slashboxes .details {
    display: none;
}
#slashboxes .ntv-sponsored-disclaimer {
    position: relative;
    top: 0;
    background: #6D4634;
    padding-left: 10px;
    padding-top: 10px;
    margin-left: 0;
}
#slashboxes .ntv-sponsored-disclaimer:before {
    display: none;
}
#slashboxes .ntv-sponsored-question {
    display: none;
}
#slashboxes .ntv-sponsored-disclaimer a {
    float: none;
    text-transform: uppercase;
}
</style>
<!-- Piwik -->
<script type="text/javascript">
  var _paq = _paq || [];
  _paq.push(["setCookieDomain", "*.slashdot.org"]);
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
function initPiwik() {
  (function() {
    var u="//analytics.slashdotmedia.com/";
    _paq.push(['setTrackerUrl', u+'sd.php']);
    _paq.push(['setSiteId', 40]);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.type='text/javascript'; g.async=true; g.defer=true; g.src=u+'sd.js'; s.parentNode.insertBefore(g,s);
  })();
}

function initNels() {

    if(window.location.pathname == '/'){
        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];
        var url = '/ajax.pl?op=nel';
        if(nelId){
            url += '&nel_id='+nelId;
        }
        $.ajax({
            url: url,
            type: 'POST',
            success: function(html){
                $('#firehoselist article').eq(1).after(html);
            }
        });
    }

    function showVerticalNEL() {
        let res = false;
        if(window.location.pathname.indexOf('/story/') >= 0){ // story
            res = true;
        }
        if(window.location.pathname.indexOf('/recent') >= 0 ||
            window.location.pathname.indexOf('/popular') >= 0 ||
            window.location.pathname.indexOf('/submission/') >= 0){ // submissions
            res = true;
        }
        if(window.location.pathname === '/'){ // home
            res = true;
        }
        return res;
    }
    if (showVerticalNEL()) {
        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];
        var url = '/ajax.pl?op=nel';
        if(nelId){
            url += '&nel_id='+nelId;
        }
        $.ajax({
            url: url,
            type: 'POST',
            success: function(html){
                $('#slashboxes').eq(0).prepend(html);
                $('#slashboxes .ntv-sponsored-disclaimer a span:first-child').html('Featured Content');
            }
        });
    }
    //announcement NEL
    if(document.getElementById('announcementText')){
      $('#announcementText').hide();
      var hlUrl = '/ajax.pl?op=hl_nel';
      if(nelId){
        hlUrl += '&nel_id='+nelId;
      }
      $.ajax({
        url: hlUrl,
        type: 'POST',
        success: function(html){
          if(html.length < 10){
            $('#announcementText').show();
            return;
          }
          $('#announcementText').html(html).show();
        },
        error: function () {
          $('#announcementText').show();
        }
      });
    }
    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-dest]');
      if (!el) return;
      e.preventDefault();
      e.stopPropagation();
      const url = el.dataset.dest;
      const target = el.dataset.target || '_self';
      if (target === '_blank') {
        window.open(url, '_blank', 'noopener,noreferrer');
      }
    });
}
let tracking = false;
bizx.cmp.ifConsent({purposes: ['storage', 'measurement'], vendors: 'sdm'}, initPiwik);
initNels();
function trackNelImpressions() {
  const nelimps = document.querySelectorAll('img[data-name="nel-impression"]:not([data-nel-processed])');
  nelimps.forEach((imp) => {
    imp.setAttribute('data-nel-processed', '1'); // prevent re-processing
    const imp_url = imp.getAttribute('data-source');
    if (!imp_url) {
        return;
    }
    imp.src = imp_url;
  });
}
function startTracking(){
    if (tracking) return;
    tracking = true;
    trackNelImpressions();
}
const observer = new MutationObserver(function(mutations) {
  if (!tracking) return;
  for (const m of mutations) {
    for (const node of m.addedNodes) {
      if (node.nodeType !== 1) continue; // element only
      trackNelImpressions(node);
    }
  }
});
observer.observe(document.body, { childList: true, subtree: true });

bizx.cmp.ifConsent({purposes: ['storage', 'measurement', 'ads'], vendors: 'sdm'}, function(){
    startTracking();
});

