<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('mobile-menu-btn');
    var closeBtn = document.getElementById('mobile-menu-close');
    var menu = document.getElementById('mobile-menu');
    var menuContent = document.getElementById('mobile-menu-content');
    if (!btn || !menu) return;

    function openMenu() {
      var scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + scrollY + 'px';
      document.body.style.width = '100%';

      menu.style.opacity = '0';
      menu.classList.remove('hidden');
      menuContent.style.transform = 'translateY(-80px)';
      menuContent.style.opacity = '0';

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          menu.style.transition = 'opacity 0.22s ease';
          menu.style.opacity = '1';
          menuContent.style.transition = 'transform 0.45s cubic-bezier(0.22,1,0.36,1), opacity 0.35s ease';
          menuContent.style.transform = 'translateY(0)';
          menuContent.style.opacity = '1';
        });
      });
    }

    function closeMenu() {
      var scrollY = parseInt(document.body.style.top || '0') * -1;

      menu.style.transition = 'opacity 0.35s ease';
      menu.style.opacity = '0';
      menuContent.style.transition = 'transform 0.45s cubic-bezier(0.22,1,0.36,1), opacity 0.35s ease';
      menuContent.style.transform = 'translateY(-80px)';
      menuContent.style.opacity = '0';

      setTimeout(function () {
        menu.classList.add('hidden');
        menu.style.opacity = '';
        menu.style.transition = '';
        menuContent.style.transform = '';
        menuContent.style.opacity = '';
        menuContent.style.transition = '';
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        window.scrollTo(0, scrollY);
      }, 450);
    }

    var menuTouchHandled = false;
    btn.addEventListener('touchstart', function (e) {
      e.preventDefault();
      menuTouchHandled = true;
      menu.classList.contains('hidden') ? openMenu() : closeMenu();
    }, { passive: false });
    btn.addEventListener('click', function () {
      if (menuTouchHandled) { menuTouchHandled = false; return; }
      menu.classList.contains('hidden') ? openMenu() : closeMenu();
    });
    if (closeBtn) {
      var closeTouchHandled = false;
      closeBtn.addEventListener('touchstart', function (e) {
        e.preventDefault();
        closeTouchHandled = true;
        closeMenu();
      }, { passive: false });
      closeBtn.addEventListener('click', function () {
        if (closeTouchHandled) { closeTouchHandled = false; return; }
        closeMenu();
      });
    }

    // Mobile dropdowns
    var caretDown = '/static/public/assets/images/icon/caret_down.svg';
    var caretUp   = '/static/public/assets/images/icon/caret_up.svg';

    // Resources dropdown: prevent right-side overflow (relevant 1024–1080px)
    function adjustResourcesDropdown() {
      var resourcesGroup = document.getElementById('resources-nav-group');
      if (!resourcesGroup) return;
      var resourcesDrop = resourcesGroup.querySelector('.nav-drop');
      if (!resourcesDrop) return;
      var groupLeft = resourcesGroup.getBoundingClientRect().left;
      var dropWidth = 680;
      var vw = window.innerWidth;
      var buffer = (vw >= 1024 && vw <= 1180) ? 40 : 16;
      var overflow = (groupLeft + dropWidth) - (vw - buffer);
      resourcesDrop.style.left = overflow > 0 ? (-overflow) + 'px' : '';
      resourcesDrop.style.setProperty('--resources-arrow-offset', overflow > 0 ? overflow + 'px' : '0px');
    }
    adjustResourcesDropdown();
    window.addEventListener('resize', adjustResourcesDropdown);

    // Ersten Dropdown (Software) beim Laden geöffnet anzeigen
    var firstDropdown = document.querySelector('.mobile-dropdown');
    if (firstDropdown) {
      firstDropdown.querySelector('.mobile-dropdown-content').classList.remove('hidden');
      firstDropdown.querySelector('.mobile-caret').src = caretUp;
    }

    document.querySelectorAll('.mobile-dropdown').forEach(function (dropdown) {
      var trigger = dropdown.querySelector('.mobile-dropdown-trigger');
      var content = dropdown.querySelector('.mobile-dropdown-content');
      var caret   = dropdown.querySelector('.mobile-caret');

      trigger.addEventListener('click', function (e) {
        // Klick auf den Link selbst nicht abfangen
        if (e.target.tagName === 'A') return;

        var isOpen = !content.classList.contains('hidden');

        // Alle anderen schließen
        document.querySelectorAll('.mobile-dropdown').forEach(function (other) {
          if (other !== dropdown) {
            other.querySelector('.mobile-dropdown-content').classList.add('hidden');
            other.querySelector('.mobile-caret').src = caretDown;
          }
        });

        // Diesen togglen
        content.classList.toggle('hidden', isOpen);
        caret.src = isOpen ? caretDown : caretUp;
      });
    });
  });
</script>

<div class="flex-grow">
    
