<style>

    /* Weiche Kanten der Logo-Animation: Maske statt farbigem Overlay, damit der Verlauf
       unabhängig vom Hero-Hintergrund funktioniert (google.css blendet gegen #00285a aus). */
    #heroSection .logo-marquee{
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
                mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    }
    #heroSection .logo-marquee::before,
    #heroSection .logo-marquee::after{content:none}

    /* google.css setzt html,body{overflow-x:hidden} -> bricht position:sticky (Preistabelle). clip erlaubt Sticky + vertikalen Scroll, clippt weiter horizontal */
    html, body { overflow-x: clip; }

    @media(max-width:1080px){
        .card.pop{transform:none;translate:none}
        .card.pop:hover{transform:none;translate:0 -4px}
    }

    #faq-list .faq-item:last-child{border-bottom:0}
</style>

