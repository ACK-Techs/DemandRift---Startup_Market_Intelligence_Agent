                <tbody id="cmp-body"><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Account</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">User Accounts<span class="info">?<span class="tip">Every SISTRIX user has their own personalised user account. Accounts for persons in the same company can be enabled and managed. <a href='/support/profiles'>More information</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">1</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">3</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">6</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">12</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional User Accounts<span class="info">?<span class="tip">Starting with the Plus package, users numbers can be increased by adding accounts. The Start package can not be upgraded.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€24.90</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€24.90</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€24.90</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Roles and Rights Management<span class="info">?<span class="tip">With Roles and Rights Management from SISTRIX you can adjust each users' access levels. It means users can access only the things they need to do their job.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><span class="dash text-dark-3 text-base">—</span></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Audit Log<span class="info">?<span class="tip">The Audit Log will show you, in detail, which users performed which action. It brings transparency to the way teams are using SISTRIX.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><span class="dash text-dark-3 text-base">—</span></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Domain &amp; Competitor Analysis</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">SISTRIX Visibility Index<span class="info">?<span class="tip">The SISTRIX Visibility Index is the gold standard for measuring success on the Internet. You'll get access to the Visibility Index of over 100 Million Domains in 30+ countries. <a href='/support/sistrix-visibility-index-explanation-background-and-calculation'>More information</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Keyword Research<span class="info">?<span class="tip">Use extensive Keyword Research function such as Keyword Discovery, which brings you detailed information for billions of keywords. <a href='/google/keyword-discovery'>More Information</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Domain Analysis<span class="info">?<span class="tip">You enter a domain and we'll show you how this domain would be seen in Google. Data from over 100 million domains is analysed and presented in fractions of a second. <a href='/google/seo_competitors'>More Information</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Backlink-Index<span class="info">?<span class="tip">Uncover the Link Sources of your competitors and monitor your own backlinks. Includes data from SISTRIX, Majestic and other link partners. <a href='/google/backlink-check'>More Information</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Results per Analysis<span class="info">?<span class="tip">Maximum number of results you can view and export for each analysis.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">10,000</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">50,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Unlimited</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Data History<span class="info">?<span class="tip">SISTRIX is your Google Time-Machine. Here are the historical data-sets that you have access to.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">3 Months</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">5 Years</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Full (11 Years)</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Full (11 Years)</td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Projects</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Projects<span class="info">?<span class="tip">Projects enable you to perform on-page analysis as well as keyword tracking, performance monitoring and more.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">3</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">15</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">40</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional Projects</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€9.90</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€8.49</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€5.99</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Total URLs crawled<span class="info">?<span class="tip">The total number of pages, across projects, that can be crawled in a month.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">30,000</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">500,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">2,000,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">4,000,000</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional page crawls (per 1000 pages)</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€0.21</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€0.16</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€0.14</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Javascript &amp; Mobile Crawling<span class="info">?<span class="tip">Our on-page crawler is based on the same technology as the official Googlebot. We can asses Javascript on pages and can, if desired, set the viewport to smartphone.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">SERP Updates<span class="info">?<span class="tip">SERP Updates: Create your own keywords, update individual keywords, entire lists or filtered keyword tables at the push of a button, in seconds and ready to use directly in the live index.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">2,500</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">15,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">40,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100,000</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional SERP updates</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€0.04</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€0.03</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€0.02</td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Content Marketing</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Content Projects per Month<span class="info">?<span class="tip">Number of content marketing projects (text projects) that you can perform every month. Projects created in the previous month are preserved.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">10</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">25</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional Content Projects</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€7.99</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€4.99</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€3.99</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Plagiarism Checks<span class="info">?<span class="tip">Automatically check content to see if it already exists somewhere else on the Internet, in either exact, or a similar form. Reduce the possibility of duplicate content.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">20</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">500</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Content Discovery<span class="info">?<span class="tip">The Content Discovery search machine from SISTRIX: Search through over one billion content examples and find the perfect template.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Content Planner<span class="info">?<span class="tip">Topic clusters are an established way to achieve top rankings, even for competitive search terms. The new SISTRIX Content Planner helps you to plan topic clusters, based on data, at the push of a button.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Planner-Usage per Month</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">50</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">125</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">500</td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Marketplace analysis</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Product Research<span class="info">?<span class="tip">Use our product research features across five countries, with historical data on many millions of ASINs.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Brand &amp; Retailer Analysis<span class="info">?<span class="tip">Enter a brand or a retailer and we'll show you their secrets to success on Amazon. Data on millions of brands and retailers in fractions of a second.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Category Check<span class="info">?<span class="tip">Analyse every category on Amazon: which brands and retailers hold which market shares, and which keywords and products are successful?</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Workflow</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Reports<span class="info">?<span class="tip">You can add almost every element from SISTRIX into a report. These can be be updated daily or weekly and automatically sent out to any available email adress as PDFs.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">3</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">25</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">500</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">White Label Reports<span class="info">?<span class="tip">With the White Label Reports service from SISTRIX you can style your PDFs with your logo and match your company colours and identity.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><span class="dash text-dark-3 text-base">—</span></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Dashboards</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">3</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">25</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">500</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Lists</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">3</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">25</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">500</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional Reports, Dashboards &amp; Lists<span class="info">?<span class="tip">If you need more lists, dashboards &amp; reports than your plan includes, you can add more combinations of list, dashboard and report from 2,49 € each.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€3.90</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€2.90</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€2.49</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Connection to Google Search Console &amp; Analytics</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">API<span class="info">?<span class="tip">With the SISTRIX API you can connect your systems directly to ours. The limited API access level includes only the Visibility Index data. Full access opens up all data and features. <a href='/api/'>More about the API</a></span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">Limited</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Full</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Full</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Export &amp; API-Credits per Week</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">1,000</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">10,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">30,000</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">100,000</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Additional Credits (10k per Week)</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]"><span class="dash text-dark-3 text-base">—</span></td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">€75.00</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€75.00</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">€75.00</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Alerts<span class="info">?<span class="tip">With the Alerts system you can get notifications by email or Slack connector for important changes and KPIs, for any domain.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">5</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">10</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">20</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">50</td></tr><tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">Support &amp; Training</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Support Channels</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Chat</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">Chat</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Chat, Telephone</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Chat, Telephone, Premium</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Support Level<span class="info">?<span class="tip">Normally we answer all support inquiries received during working hours in less than 10 minutes. Requests with Premium priority are processed before those with the Standard priority.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Standard</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">Standard</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Premium</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Premium</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Seminar Format</div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Online</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">Online, in-person</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Online, in-person</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">Online, in-person</td></tr><tr class="row"><td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">Seminar Attendees per Year<span class="info">?<span class="tip">In our SISTRIX seminars you will get to know both the software and the relevant SEO workflows. A maximum of 10 SISTRIX users take part in the seminars. In the Enterprise offer, we can also create exclusive seminars.</span></span></div></td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">1</td><td class="val pop-cell text-center text-dark-1 font-medium border-l border-[#E8ECF1] bg-[#F6F7FB]">2</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">4</td><td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]">12</td></tr></tbody>
            </table>
        </div>

            <!-- ===== MOBILE COMPARISON (<768px) — plan tabs instead of table ===== -->
                        <script>var MOB_BTNS = ["<a class=\"btn btn-success btn-sm btn-shine btn-shine-green\" target=\"_blank\" href=\"https://app.sistrix.com/order\">Book now</a>","<a class=\"btn btn-success btn-sm btn-shine btn-shine-green\" target=\"_blank\" href=\"https://app.sistrix.com/order\">Book now</a>","<a class=\"btn btn-success btn-sm btn-shine btn-shine-green\" target=\"_blank\" href=\"https://app.sistrix.com/order\">Book now</a>","<a class=\"btn btn-success btn-sm btn-shine btn-shine-green\" target=\"_blank\" href=\"https://app.sistrix.com/order\">Book now</a>"];</script>
            <div class="phone-body">
                <div class="plan-tabs" id="mtabs"></div>
                <div class="plan-head" id="mhead"></div>
                <div id="v1-list"></div>
            </div>
            <p class="text-xs text-dark-3 mt-4 max-[767.98px]:hidden">* Monthly price plus taxes</p>

    </div>
</section>

<!-- ===== FAQ ===== -->
<section class="section-card section-card-gradient" id="faq" data-screen-label="04 FAQ">
    <div class="max-w-3xl mx-auto px-0">
        <div class="text-center mb-5">
            <h2 class="text-3xl lg:text-4xl font-bold text-secondary mb-3">Frequently Asked Questions</h2>
        </div>
        <div id="faq-list" class="border-t border-[#d8dde8]">

            <!-- FAQ 1 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="true">
                <button class="faq-trigger" aria-expanded="true">
                    <span class="font-medium text-secondary text-lg">How much does SISTRIX cost?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body pb-6">
                    <p class="text-dark-2 text-base font-medium">SISTRIX is available from 119 € per month with the START package. Our most popular package is PLUS at 239 € per month. There are also the PROFESSIONAL and PREMIUM packages with even more scope and features. For special requirements, we also offer individual Enterprise solutions.</p>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Is SISTRIX free?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">SISTRIX is a paid tool. However, you can <a class="cta-text font-bold text-primary border-b border-primary hover:border-b-transparent" target="_blank" href="https://app.sistrix.com/account/create/en/?ssxt=k32x15&ssx=strx6aad0264a191a5d982f&ssxl=en&ssxr=https://www.sistrix.com/pricing/">try SISTRIX free for 14 days</a>. Alternatively, we offer a range of free tools that you can use permanently without an account.</p>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">What is the difference between START and PLUS?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">The <b>START package</b> opens up an inexpensive way to learn most of the features of SISTRIX for Google: access to the domain and keyword databases to analyze your site and your competitors' in over 40 countries, research keywords and discover opportunities.</p>
                    <p class="text-dark-2 text-base font-medium mt-3">With the <b>PLUS package</b>, three users work at the same time, you get flexible upgrade options and an extended history of 5 years. On top come the content tools:</p>
                    <ul class="list-disc pl-5 mt-3 space-y-1 text-dark-2 text-base font-medium">
                        <li>Content Assistant for optimizing texts</li>
                        <li>Content Planner for meaningful keyword clusters</li>
                        <li>Content Discovery to search for popular content</li>
                    </ul>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Can I also book a custom package?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">No problem! If the standard packages are not enough for your company, we put together a custom package tailored to you as part of our <a href="/support/account/enterprise-accounts/" class="text-primary border-b border-primary hover:border-b-transparent"><b>enterprise offer</b></a>.</p>
                </div>
            </div>

            <!-- FAQ 5 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Is there a limit to the number of projects?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">Yes, the number depends on your SISTRIX package: START includes 3 projects, PLUS 15, PROFESSIONAL 40 and PREMIUM 100. Additional projects can be booked individually if needed.</p>
                </div>
            </div>

            <!-- FAQ 6 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Do you also offer discounts or reductions?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">With us, every customer gets the best price. Our goal is to make the best possible software affordable for everyone. You pay the same price for the same service as every other customer.</p>
                    <p class="text-dark-2 text-base font-medium mt-3">However, you can subscribe to SISTRIX with an <a href="/pricing/?y" class="text-primary border-b border-primary hover:border-b-transparent"><b>annual contract</b></a>. The contract can be cancelled at the end of each year of use and the monthly costs are reduced compared to monthly cancellation.</p>
                </div>
            </div>

            <!-- FAQ 7 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Which payment methods do you offer?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">You can pay the invoice with all common credit cards or via SEPA direct debit. As part of a 12-month subscription, we also offer payment by invoice in advance.</p>
                    <p class="text-dark-2 text-base font-medium mt-3">Custom invoicing, for example every three months, is possible as part of our enterprise offer.</p>
                </div>
            </div>

            <!-- FAQ 8 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Which currency are invoices issued in?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">As a company based in Germany, all invoices are issued in euros (€). Invoicing in other currencies (US dollar, British pound, Swiss franc and Japanese yen) is possible as part of our <a href="/support/account/enterprise-accounts/" class="text-primary border-b border-primary hover:border-b-transparent"><b>enterprise offer</b></a>.</p>
                </div>
            </div>

            <!-- FAQ 9 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">Can SISTRIX be cancelled monthly?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">Yes, you can cancel SISTRIX any time on a monthly basis, so you're not tied in long-term.</p>
                </div>
            </div>

            <!-- FAQ 10 -->
            <div class="faq-item border-b border-[#d8dde8]" data-open="false">
                <button class="faq-trigger" aria-expanded="false">
                    <span class="font-medium text-secondary text-lg">How can I change my package?</span>
                    <svg class="faq-icon flex-shrink-0" width="20" height="20" viewBox="0 0 22 22" fill="none"><line class="faq-icon-h" x1="3" y1="11" x2="19" y2="11" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line><line class="faq-icon-v" x1="11" y1="3" x2="11" y2="19" stroke="#1269D3" stroke-width="1.75" stroke-linecap="round"></line></svg>
                </button>
                <div class="faq-body hidden pb-6">
                    <p class="text-dark-2 text-base font-medium">You can change your package at any time. When switching to a higher package, the change takes effect immediately. From then on we charge the higher price and refund the unused period of the old package pro rata.</p>
                    <p class="text-dark-2 text-base font-medium mt-3">If you switch to a smaller package, the change takes effect at the next billing period.</p>
                </div>
            </div>

        </div>
    </div>
</section>

</main>
<script>
    /* ---------- FAQ accordion toggle ---------- */
    (function(){
        var items = document.querySelectorAll('#faq-list .faq-item');
        items.forEach(function(item){
            var btn = item.querySelector('.faq-trigger');
            var body = item.querySelector('.faq-body');
            if(!btn || !body) return;
            btn.addEventListener('click', function(){
                var isOpen = item.dataset.open === 'true';
                items.forEach(function(other){
                    other.dataset.open = 'false';
                    var ob = other.querySelector('.faq-body');
                    var obtn = other.querySelector('.faq-trigger');
                    if(ob) ob.classList.add('hidden');
                    if(obtn) obtn.setAttribute('aria-expanded','false');
                });
                if(!isOpen){
                    item.dataset.open = 'true';
                    body.classList.remove('hidden');
                    btn.setAttribute('aria-expanded','true');
                }
            });
        });
    })();

    /* ---------- Comparison table data ---------- */
    var CK = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 rounded-full inline-block align-middle" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--color-primary)"></circle><path d="M8 12L11 15L16 9" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
    var DS = '<span class="dash text-dark-3 text-base">—</span>';

    var GROUPS = [
        {title:"Account", rows:[
                {f:"User Accounts", d:"Every SISTRIX user has their own personalised user account. Accounts for persons in the same company can be enabled and managed. <a href='/support/profiles'>More information</a>", v:["1","3","6","12"]},
                {f:"Additional User Accounts", d:"Starting with the Plus package, users numbers can be increased by adding accounts. The Start package can not be upgraded.", v:[DS,"€24.90","€24.90","€24.90"]},
                {f:"Roles and Rights Management", d:"With Roles and Rights Management from SISTRIX you can adjust each users' access levels. It means users can access only the things they need to do their job.", v:[DS,DS,DS,CK]},
                {f:"Audit Log", d:"The Audit Log will show you, in detail, which users performed which action. It brings transparency to the way teams are using SISTRIX.", v:[DS,DS,DS,CK]},
            ]},
        {title:"Domain & Competitor Analysis", rows:[
                {f:"SISTRIX Visibility Index", d:"The SISTRIX Visibility Index is the gold standard for measuring success on the Internet. You'll get access to the Visibility Index of over 100 Million Domains in 30+ countries. <a href='/support/sistrix-visibility-index-explanation-background-and-calculation'>More information</a>", v:[CK,CK,CK,CK]},
                {f:"Keyword Research", d:"Use extensive Keyword Research function such as Keyword Discovery, which brings you detailed information for billions of keywords. <a href='/google/keyword-discovery'>More Information</a>", v:[CK,CK,CK,CK]},
                {f:"Domain Analysis", d:"You enter a domain and we'll show you how this domain would be seen in Google. Data from over 100 million domains is analysed and presented in fractions of a second. <a href='/google/seo_competitors'>More Information</a>", v:[CK,CK,CK,CK]},
                {f:"Backlink-Index", d:"Uncover the Link Sources of your competitors and monitor your own backlinks. Includes data from SISTRIX, Majestic and other link partners. <a href='/google/backlink-check'>More Information</a>", v:[CK,CK,CK,CK]},
                {f:"Results per Analysis", d:"Maximum number of results you can view and export for each analysis.", v:["10,000","50,000","100,000","Unlimited"]},
                {f:"Data History", d:"SISTRIX is your Google Time-Machine. Here are the historical data-sets that you have access to.", v:["3 Months","5 Years","Full (11 Years)","Full (11 Years)"]},
            ]},
        {title:"Projects", rows:[
                {f:"Projects", d:"Projects enable you to perform on-page analysis as well as keyword tracking, performance monitoring and more.", v:["3","15","40","100"]},
                {f:"Additional Projects", d:"", v:[DS,"€9.90","€8.49","€5.99"]},
                {f:"Total URLs crawled", d:"The total number of pages, across projects, that can be crawled in a month.", v:["30,000","500,000","2,000,000","4,000,000"]},
                {f:"Additional page crawls (per 1000 pages)", d:"", v:[DS,"€0.21","€0.16","€0.14"]},
                {f:"Javascript & Mobile Crawling", d:"Our on-page crawler is based on the same technology as the official Googlebot. We can asses Javascript on pages and can, if desired, set the viewport to smartphone.", v:[CK,CK,CK,CK]},
                {f:"SERP Updates", d:"SERP Updates: Create your own keywords, update individual keywords, entire lists or filtered keyword tables at the push of a button, in seconds and ready to use directly in the live index.", v:["2,500","15,000","40,000","100,000"]},
                {f:"Additional SERP updates", d:"", v:[DS,"€0.04","€0.03","€0.02"]},
            ]},

        {title:"Content Marketing", rows:[
                {f:"Content Projects per Month", d:"Number of content marketing projects (text projects) that you can perform every month. Projects created in the previous month are preserved.", v:[DS,"10","25","100"]},
                {f:"Additional Content Projects", d:"", v:[DS,"€7.99","€4.99","€3.99"]},
                {f:"Plagiarism Checks", d:"Automatically check content to see if it already exists somewhere else on the Internet, in either exact, or a similar form. Reduce the possibility of duplicate content.", v:[DS,"20","100","500"]},
                {f:"Content Discovery", d:"The Content Discovery search machine from SISTRIX: Search through over one billion content examples and find the perfect template.", v:[DS,CK,CK,CK]},
                {f:"Content Planner", d:"Topic clusters are an established way to achieve top rankings, even for competitive search terms. The new SISTRIX Content Planner helps you to plan topic clusters, based on data, at the push of a button.", v:[DS,CK,CK,CK]},
                {f:"Planner-Usage per Month", d:"", v:[DS,"50","125","500"]},
            ]},
        {title:"Marketplace analysis", rows:[
                {f:"Product Research", d:"Use our product research features across five countries, with historical data on many millions of ASINs.", v:[CK,CK,CK,CK]},
                {f:"Brand & Retailer Analysis", d:"Enter a brand or a retailer and we'll show you their secrets to success on Amazon. Data on millions of brands and retailers in fractions of a second.", v:[CK,CK,CK,CK]},
                {f:"Category Check", d:"Analyse every category on Amazon: which brands and retailers hold which market shares, and which keywords and products are successful?", v:[CK,CK,CK,CK]},            ]},
        {title:"Workflow", rows:[
                {f:"Reports", d:"You can add almost every element from SISTRIX into a report. These can be be updated daily or weekly and automatically sent out to any available email adress as PDFs.", v:["3","25","100","500"]},
                {f:"White Label Reports", d:"With the White Label Reports service from SISTRIX you can style your PDFs with your logo and match your company colours and identity.", v:[DS,DS,CK,CK]},
                {f:"Dashboards", d:"", v:["3","25","100","500"]},
                {f:"Lists", d:"", v:["3","25","100","500"]},
                {f:"Additional Reports, Dashboards & Lists", d:"If you need more lists, dashboards &amp; reports than your plan includes, you can add more combinations of list, dashboard and report from 2,49 € each.", v:[DS,"€3.90","€2.90","€2.49"]},
                {f:"Connection to Google Search Console & Analytics", d:"", v:[CK,CK,CK,CK]},
                {f:"API", d:"With the SISTRIX API you can connect your systems directly to ours. The limited API access level includes only the Visibility Index data. Full access opens up all data and features. <a href='/api/'>More about the API</a>", v:[DS,"Limited","Full","Full"]},
                {f:"Export & API-Credits per Week", d:"", v:["1,000","10,000","30,000","100,000"]},
                {f:"Additional Credits (10k per Week)", d:"", v:[DS,"€75.00","€75.00","€75.00"]},
                {f:"Alerts", d:"With the Alerts system you can get notifications by email or Slack connector for important changes and KPIs, for any domain.", v:["5","10","20","50"]},
            ]},
        {title:"Support & Training", rows:[
                {f:"Support Channels", d:"", v:["Chat","Chat","Chat, Telephone","Chat, Telephone, Premium"]},
                {f:"Support Level", d:"Normally we answer all support inquiries received during working hours in less than 10 minutes. Requests with Premium priority are processed before those with the Standard priority.", v:["Standard","Standard","Premium","Premium"]},
                {f:"Seminar Format", d:"", v:["Online","Online, in-person","Online, in-person","Online, in-person"]},
                {f:"Seminar Attendees per Year", d:"In our SISTRIX seminars you will get to know both the software and the relevant SEO workflows. A maximum of 10 SISTRIX users take part in the seminars. In the Enterprise offer, we can also create exclusive seminars.", v:["1","2","4","12"]},
            ]},
    ];

    (function renderTable(){
        var html = "";
        GROUPS.forEach(function(g){
            html += '<tr class="headline"><td colspan="5" class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">'+g.title+'</td></tr>';
            g.rows.forEach(function(r){
                if(r.hl){
                    html += '<tr class="headline">';
                    html += '<td class="bg-[#ECF4FF] font-semibold text-sm tracking-[.07em] uppercase text-secondary py-3 px-4 border-b border-[#E8ECF1]">'+r.f+'</td>';
                    r.v.forEach(function(val){
                        html += '<td class="bg-[#ECF4FF] text-center font-semibold text-secondary text-sm py-3 px-4 border-b border-l border-[#E8ECF1]">'+val+'</td>';
                    });
                    html += '</tr>';
                    html += '<tr class="spacer"><td colspan="5" style="height:14px"></td></tr>';
                    return;
                }
                html += '<tr class="row">';
                html += '<td class="feat-cell text-left max-w-[340px]"><div class="fname font-medium text-text-body text-sm">'+r.f+(r.d?'<span class="info">?<span class="tip">'+r.d+'</span></span>':'')+'</div></td>';
                r.v.forEach(function(val,i){
                    var pop = i===1 ? ' pop-cell bg-[#F6F7FB]' : '';
                    html += '<td class="val text-center text-dark-1 font-medium border-l border-[#E8ECF1]'+pop+'">'+val+'</td>';
                });
                html += '</tr>';
            });
        });
        document.getElementById('cmp-body').innerHTML = html;
    })();

    /* ---------- Sticky-Abdeckbalken nur beim Andocken zeigen ---------- */
    (function(){
        var table=document.querySelector('table.cmp');
        if(!table) return;
        function upd(){ table.classList.toggle('cmp-stuck', table.getBoundingClientRect().top <= 16); }
        window.addEventListener('scroll', upd, {passive:true});
        window.addEventListener('resize', upd);
        upd();
    })();

    /* ---------- Mobile-Vergleich (<768px): eine Paket-Spalte pro Tab ---------- */
    (function(){
        var tabsEl = document.getElementById('mtabs');
        var headEl = document.getElementById('mhead');
        var listEl = document.getElementById('v1-list');
        if(!tabsEl || !headEl || !listEl || typeof GROUPS === 'undefined') return;

        var PLANS = [
            {name:"Start",        price:"€119", tab:"Start"},
            {name:"Plus",         price:"€239", tab:"Plus", badge:"Most Popular"},
            {name:"Professional", price:"€419", tab:"Professional"},
            {name:"Premium",      price:"€799", tab:"Premium"}
        ];
        var MDASH = '<span class="dash-m">—</span>';
        var active = 1; // Plus als Standard-Auswahl

        function mval(v){
            if(v === DS) return MDASH;
            return v; // Checkmark (CK) 1:1 wie Desktop, Textwerte unverändert
        }
        function renderTabs(){
            tabsEl.innerHTML = PLANS.map(function(p, i){
                var badge = p.badge ? '<span class="pt-badge">'+p.badge+'</span>' : '';
                return '<div class="plan-tab'+(i===active?' on':'')+'" data-i="'+i+'">'+badge+'<span class="pt-name">'+p.tab+'</span><span class="pt-price">'+p.price+'</span></div>';
            }).join('');
        }
        function renderHead(){
            var p = PLANS[active];
            var btn = (typeof MOB_BTNS !== 'undefined' && MOB_BTNS[active]) ? MOB_BTNS[active] : '';
            headEl.innerHTML = '<div><div class="pn">'+p.name+'</div><div class="pp">'+p.price+' <small>/month plus taxes</small></div></div>'+
                '<div class="th-cta-m">'+btn+'</div>';
        }
        function renderList(){
            var h = '';
            GROUPS.forEach(function(g){
                h += '<div class="headline">'+g.title+'</div><div class="rows">';
                g.rows.forEach(function(r){
                    if(r.hl){
                        h += '<div class="headline" style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px"><span>'+r.f+'</span><span style="text-transform:none;font-weight:700;color:var(--color-secondary)">'+mval(r.v[active])+'</span></div>';
                        return;
                    }
                    h += '<div class="row"><span class="fn fname font-medium text-text-body text-sm">'+r.f+(r.d?'<span class="info">?<span class="tip">'+r.d+'</span></span>':'')+'</span><span class="fv">'+mval(r.v[active])+'</span></div>';
                });
                h += '</div>';
            });
            listEl.innerHTML = h;
        }
        function renderAll(){ renderTabs(); renderHead(); renderList(); }

        tabsEl.addEventListener('click', function(e){
            var t = e.target.closest('.plan-tab');
            if(!t) return;
            active = parseInt(t.dataset.i, 10) || 0;
            renderAll();
        });

        renderAll();
    })();
    /* ---------- Tooltip dynamisch im Tabellenrahmen platzieren (5px Rand) ---------- */
    (function(){
        var section = document.getElementById('vergleich');
        if(!section) return;
        var M = 5;
        function place(info){
            var tip = info.querySelector('.tip');
            if(!tip) return;
            var cont = info.closest('.table-scroll') || info.closest('.phone-body') || document.documentElement;
            var c = cont.getBoundingClientRect();
            var i = info.getBoundingClientRect();
            var w = tip.offsetWidth;
            var iconC = i.left + i.width / 2;
            var left = Math.max(c.left + M, Math.min(iconC - w / 2, c.right - M - w));
            tip.style.left = (left - i.left) + 'px';
            tip.style.right = 'auto';
            var arrow = Math.max(10, Math.min(iconC - left, w - 10));
            tip.style.setProperty('--arrow-left', arrow + 'px');
        }
        section.addEventListener('mouseover', function(e){
            var info = e.target && e.target.closest ? e.target.closest('.info') : null;
            if(info) place(info);
        });
    })();

</script></div>

