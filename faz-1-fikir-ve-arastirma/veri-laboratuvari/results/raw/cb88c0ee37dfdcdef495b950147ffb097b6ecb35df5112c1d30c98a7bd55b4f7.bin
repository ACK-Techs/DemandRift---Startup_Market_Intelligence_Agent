immutable/chunks/0u0mipo4ip4xj.js\",\"/_next/static/immutable/chunks/0mbytp_vlt3k4.js\",\"/_next/static/immutable/chunks/2bb1s_37n-qza.js\",\"/_next/static/immutable/chunks/32vzd7p3b4-yy.js\"],\"NotFoundFooter\"]\n4:[\"$\",\"$L1f\",null,{\"enableI18n\":true,\"locale\":\"en-US\",\"region\":\"$undefined\",\"translations\":{\"en-US\":{}},\"dictionaries\":{\"en-US\":{}},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex w-full flex-1 items-center justify-center min-h-[calc(100dvh-64px)] lg:min-h-[calc(100dvh-84px)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"flex w-96 max-w-full items-center justify-between gap-2 px-4\",\"children\":[[\"$\",\"$L20\",null,{\"ref\":\"$undefined\",\"aria-hidden\":true,\"role\":\"none\",\"aria-orientation\":\"$undefined\",\"className\":\"bg-border h-[1px] w-full flex-1 bg-gradient-to-r from-background via-background to-border\"}],[\"$\",\"span\",null,{\"children\":\"$L21\"}],[\"$\",\"$L20\",null,{\"ref\":\"$undefined\",\"aria-hidden\":true,\"role\":\"none\",\"aria-orientation\":\"$undefined\",\"className\":\"bg-border h-[1px] w-full flex-1 bg-gradient-to-l from-background via-background to-border\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-8 md:flex-row\",\"children\":[[\"$\",\"$L22\",null,{\"href\":\"/\",\"className\":\"self-start\",\"children\":[\"$\",\"$L23\",null,{\"size\":\"sm\",\"variant\":\"outline\",\"className\":\"group flex gap-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":1.5,\"stroke\":\"currentColor\",\"aria-hidden\":\"true\",\"data-slot\":\"icon\",\"ref\":\"$undefined\",\"aria-labelledby\":\"$undefined\",\"className\":\"size-4 transition-transform group-hover:-translate-x-1\",\"children\":[null,[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18\"}]]}],\"$L24\"]}]}],[\"$\",\"$L22\",null,{\"href\":\"/models\",\"className\":\"self-end\",\"children\":[\"$\",\"$L23\",null,{\"size\":\"sm\",\"variant\":\"outline\",\"className\":\"group flex gap-2\",\"children\":[\"$L25\",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":1.5,\"stroke\":\"currentColor\",\"aria-hidden\":\"true\",\"data-slot\":\"icon\",\"ref\":\"$undefined\",\"aria-labelledby\":\"$undefined\",\"className\":\"size-4 transition-transform group-hover:translate-x-1\",\"children\":[null,[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3\"}]]}]]}]}]]}]]}]}],[\"$\",\"$L26\",null,{\"newsletterAuthMode\":\"anonymous\"}]]}]\n27:T1fa3,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How are tokens billed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Input and output tokens are billed per model at posted rates.\"}},{\"@type\":\"Question\",\"name\":\"Do you mark up provider pricing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Inference is billed at the provider's list price on every plan. OpenRouter's fee is charged when you buy credits, 5.5% on Standard and 8% on Business, never on individual requests.\"}},{\"@type\":\"Question\",\"name\":\"How is billing structured for Standard, Business, Enterprise and BYOK?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Standard and Business: you buy credits, manually or with auto top-up, and each request deducts its cost from your balance. The only billing difference between the two is the fee on credit purchases, 5.5% on Standard and 8% on Business. Enterprise: pricing is set by contract and based on volume, prepaid credits and annual commitments, with invoicing. BYOK: the provider bills you for inference directly. Standard and Business include $25,000 of list-price inference per month through BYOK with no OpenRouter fee; Enterprise includes $200,000. Above the allowance, OpenRouter charges 5% of what the same request would cost at list price on OpenRouter, deducted from your credits.\"}},{\"@type\":\"Question\",\"name\":\"Are failed or fallback attempts billed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. An attempt that errors is not charged for its model tokens, so with fallback you pay only for the run that answers. Under Zero Completion Insurance the same holds for a response that returns nothing and no finish reason; auxiliary services that already ran, such as web search or file parsing, may still be billed. Routing through openrouter/auto adds no fee; you pay the rate of whichever model serves the request.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer volume discounts or annual plans?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We offer discounted OpenRouter fees in our enterprise plan. We do not discount inference.\"}},{\"@type\":\"Question\",\"name\":\"Are streaming responses billed differently?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Pricing is per token whether or not you stream.\"}},{\"@type\":\"Question\",\"name\":\"What payment methods do you accept?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Standard and Business: credit and debit cards, AliPay, and crypto (USDC). Enterprise: invoicing and purchase orders through sales.\"}},{\"@type\":\"Question\",\"name\":\"Are taxes (VAT/GST) included in prices?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Prices are exclusive of applicable taxes. Where required, VAT/GST may be added on invoices.\"}},{\"@type\":\"Question\",\"name\":\"Is there a minimum spend or lock-in on Standard?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Standard and Business have no minimums and no lock-in. You pay only for what you use.\"}},{\"@type\":\"Question\",\"name\":\"What does the Business plan fee apply to?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 8% Business platform fee applies to credit purchases. It is charged when you buy credits, not on individual API requests, and model token prices are the same as on every other plan.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to talk to sales to upgrade to Business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Upgrade from the settings of the account or organization you want on Business. There is no contract, no minimum spend, and no sales conversation. You can downgrade 30 days after the upgrade, from the same place.\"}},{\"@type\":\"Question\",\"name\":\"Do you enforce rate limits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OpenRouter sets no plan-based rate limit on paid models. A limit you hit there normally comes from the provider, and fallback routing retries other providers automatically; only very high burst traffic is rejected by OpenRouter's own DDoS protection with a 429. Free models are capped at 20 requests per minute and 50 per day, rising to 1,000 per day once your account has bought at least $10 of credits. Failed attempts count toward that daily cap, and a negative balance blocks free models until you add credits. Details are in the rate limits documentation.\"}},{\"@type\":\"Question\",\"name\":\"Can I separate environments (dev/staging/production)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Workspaces give each environment its own keys, limits and activity: 5 workspaces on Free and Standard, 1,000 on Business. Within a workspace, each API key can carry its own credit cap.\"}},{\"@type\":\"Question\",\"name\":\"Do you enforce platform rate limits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No plan-based ones. On Standard, Business and Enterprise, limits on paid models come from the provider, not from your plan; only OpenRouter's DDoS protection can reject very high burst traffic. Free models carry the caps in the answer above.\"}},{\"@type\":\"Question\",\"name\":\"Can I make sure to send API requests in specific regions?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. In-region routing is included on Business and Enterprise plans. Send requests to eu.openrouter.ai to keep inference with providers in the EU, or to us.openrouter.ai to keep it in the US. Upgrade to Business from your settings; for Enterprise, contact sales.\"}},{\"@type\":\"Question\",\"name\":\"Does routing affect latency?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Routing improves reliability; latency varies by model, provider and region. For consistent latency, pin a specific model and provider.\"}},{\"@type\":\"Question\",\"name\":\"What happens if a model is deprecated or pricing changes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If a model is deprecated, you will receive a 404 when you request it, with an error message like \\\"no endpoints for this model found.\\\" If the pricing changes, we will continue to route to the model and it will serve your requests. But, you will be charged at the new rate and your credits will deduct accordingly. This will be reflected in your billing.\"}},{\"@type\":\"Question\",\"name\":\"Can I pin specific model versions?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Choose an explicit model ID/version to avoid unexpected changes. You can also switch models without changing your integration.\"}},{\"@type\":\"Question\",\"name\":\"Do you train on customer data?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. We do not train on your data. Provider-side retention can be disabled for the account or per request, and Zero Data Retention routing is available on every plan.\"}},{\"@type\":\"Question\",\"name\":\"Do you support SSO?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"SSO (SAML) and SCIM are available on Enterprise plans; contact sales to enable them.\"}},{\"@type\":\"Question\",\"name\":\"How do I migrate from OpenAI/Anthropic?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our API is OpenAI‑compatible. Update the base URL and model names; see Quickstart.\"}},{\"@type\":\"Question\",\"name\":\"Do you support function calling/tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If the underlying model supports tools/function calling, you can use it through the same API. See the API reference for examples.\"}},{\"@type\":\"Question\",\"name\":\"What happens if a provider is down or a model errors?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Routing/fallback can automatically try alternative models, and an attempt that errors is not charged for its model tokens under Zero Completion Insurance.\"}},{\"@type\":\"Question\",\"name\":\"Where can I check uptime and incidents?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Visit the status page for real‑time uptime and incident history.\"}},{\"@type\":\"Question\",\"name\":\"What does the Enterprise dedicated support team include?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Enterprise accounts get a support SLA with committed response times, a dedicated Slack channel with the OpenRouter team, a customer success manager who owns the account, and a forward-deployed engineer for integration, routing and rollout work. Standard and Business use email support, and every plan can use the community Discord.\"}}]}14:[\"$\",\"div\",null,{\"className\":\"flex w-full flex-col\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$27\"}}],\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\"]}]\n2d:I[824620,[\"/_next/static/immutable/chunks/0si3i3ige4vkp.js\",\"/_next/static/immutable/chunks/3csh9fh06_zat.js\",\"/_next/static/immutable/chunks/3epkr69hegc-s.js\",\"/_next/static/immutable/chunks/23_e2o-fte5n-.js\",\"/_next/static/immutable/chunks/0k2ghkgxramtp.js\",\"/_next/static/immutable/chunks/2ap7ilhcxgh98.js\",\"/_next/static/immutable/chunks/30fhbowwt7p-f.js\",\"/_next/static/immutable/chunks/3t9y3akd4j