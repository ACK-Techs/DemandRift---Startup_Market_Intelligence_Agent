\"Usage and Rate Limits\"}],[\"$\",\"$L42\",null,{\"type\":\"multiple\",\"children\":[[\"$\",\"$L43\",\"0\",{\"value\":\"Usage and Rate Limits-0\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Do you enforce rate limits?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"$L72\"}]}]]}],[\"$\",\"$L43\",\"1\",{\"value\":\"Usage and Rate Limits-1\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Can I separate environments (dev/staging/production)?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"Yes. Workspaces give each environment its own keys, limits and activity: 5 workspaces on Free and Standard, 1,000 on Business. Within a workspace, each API key can carry its own credit cap.\"}]}]]}],[\"$\",\"$L43\",\"2\",{\"value\":\"Usage and Rate Limits-2\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Do you enforce platform rate limits?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"No plan-based ones. On Standard, Business and Enterprise, limits on paid models come from the provider, not from your plan; only OpenRouter's DDoS protection can reject very high burst traffic. Free models carry the caps in the answer above.\"}]}]]}]]}]]}]\n4a:[\"$\",\"$L41\",\"Routing and Latency\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"mb-4 font-brand text-[length:var(--text-title)] font-semibold tracking-tight text-foreground\",\"children\":\"Routing and Latency\"}],[\"$\",\"$L42\",null,{\"type\":\"multiple\",\"children\":[[\"$\",\"$L43\",\"0\",{\"value\":\"Routing and Latency-0\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Can I make sure to send API requests in specific regions?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"Yes. In-region routing is included on Business and Enterprise plans. Send requests to eu.openrouter.ai to keep inference with providers in the EU, or to us.openrouter.ai to keep it in the US. Upgrade to Business from your settings; for Enterprise, contact sales.\"}]}]]}],[\"$\",\"$L43\",\"1\",{\"value\":\"Routing and Latency-1\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Does routing affect latency?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"Routing improves reliability; latency varies by model, provider and region. For consistent latency, pin a specific model and provider.\"}]}]]}],[\"$\",\"$L43\",\"2\",{\"value\":\"Routing and Latency-2\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"What happens if a model is deprecated or pricing changes?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"$L73\"}]}]]}],[\"$\",\"$L43\",\"3\",{\"value\":\"Routing and Latency-3\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Can I pin specific model versions?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"Yes. Choose an explicit model ID/version to avoid unexpected changes. You can also switch models without changing your integration.\"}]}]]}]]}]]}]\n4b:[\"$\",\"$L41\",\"Privacy and Security\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"mb-4 font-brand text-[length:var(--text-title)] font-semibold tracking-tight text-foreground\",\"children\":\"Privacy and Security\"}],[\"$\",\"$L42\",null,{\"type\":\"multiple\",\"children\":[[\"$\",\"$L43\",\"0\",{\"value\":\"Privacy and Security-0\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Do you train on customer data?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"No. We do not train on your data. Provider-side retention can be disabled for the account or per request, and Zero Data Retention routing is available on every plan.\"}]}]]}],[\"$\",\"$L43\",\"1\",{\"value\":\"Privacy and Security-1\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Do you support SSO?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"SSO (SAML) and SCIM are available on Enterprise plans; contact sales to enable them.\"}]}]]}]]}]]}]\n4c:[\"$\",\"$L41\",\"Models and Features\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"mb-4 font-brand text-[length:var(--text-title)] font-semibold tracking-tight text-foreground\",\"children\":\"Models and Features\"}],[\"$\",\"$L42\",null,{\"type\":\"multiple\",\"children\":[[\"$\",\"$L43\",\"0\",{\"value\":\"Models and Features-0\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"How do I migrate from OpenAI/Anthropic?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"$L74\"}]}]]}],[\"$\",\"$L43\",\"1\",{\"value\":\"Models and Features-1\",\"children\":[[\"$\",\"$L44\",null,{\"className\":\"text-left text-base\",\"children\":\"Do you support function calling/tools?\"}],[\"$\",\"$L45\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"$\",\"div\",null,{\"children\":\"If the underlying model supports tools/function calling, you can use it through the same API. See the API reference for examples.\"}]}]]}]]}]]}]\n4d:[\"$\",\"$L41\",\"Reliability and Uptime\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"mb-4 font-brand text-[length:var(--text-title)] font-semibold tracking-tight text-foreground\",\"children\":\"Reliability and Uptime\"}],[\"$\