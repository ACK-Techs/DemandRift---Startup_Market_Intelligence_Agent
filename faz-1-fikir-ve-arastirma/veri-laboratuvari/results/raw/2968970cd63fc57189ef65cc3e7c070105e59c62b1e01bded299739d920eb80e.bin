t-m-body-s whitespace-pre-line">Card sorting</p></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td></tr><tr class="bg-neutral-06"><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><p class="font-mint lg:text-body-s text-m-body-s whitespace-pre-line">Conditional logic</p></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td></tr><tr><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><p class="font-mint lg:text-body-s text-m-body-s whitespace-pre-line">First click testing</p></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td></tr><tr class="bg-neutral-06"><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><p class="font-mint lg:text-body-s text-m-body-s whitespace-pre-line">Five second testing</p></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#green-tick"></use></svg></div></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" aria-label="Not included" class="fill-none h-7 w-7"><use href="/_astro/symbols.Rv3yHajH.svg#red-cross"></use></svg></div></div></td></tr><tr><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><p class="font-mint lg:text-body-s text-m-body-s whitespace-pre-line">Live website testing</p></div></td><td class="px-[14px] py-[14px] lg:px-6 lg:py-4.5 "><div class="flex gap-2 items-start"><div class="relative aspect-square inline-flex items-center justify-center w-6 lg:w-7"><svg stroke-width="1.5" viewBox="0 0 29 28" role="img" ar