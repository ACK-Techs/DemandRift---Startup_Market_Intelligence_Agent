nochrome":true,"clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"select","actionDetails":{"position":5},"location":[{"locationPosition":15,"locationType":"badge","name":"","idType":"sequential","id":"size"}],"eventType":"click","targetType":"badge","targetId":"size","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"ShelfBasedPageScrollAction","actionClass":"ShelfBasedPageScrollAction","shelfId":"information","notPurchasedShelfId":null,"purchasedShelfId":null,"index":1,"clicksOnScroll":true}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"informationRibbon"},"productRatings":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"18","name":"Ratings & Reviews","impressionType":"ratingsOverview","idType":"sequential","impressionIndex":2}},"contentType":"productRatings","marker":null,"items":[{"$kind":"Ratings","productId":"1095569891","ratingAverage":4.6,"totalNumberOfRatings":841686,"context":"productPage","ratingCounts":[653315,98835,43789,15184.000000000002,30562.999999999996]}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"See All","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/1095569891?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"SeeAllReviews"}],"eventType":"click","targetType":"button","targetId":"SeeAllReviews","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageUrl":"https://apps.apple.com/us/app/1095569891?see-all=reviews&platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","platform":"iphone","id":"1095569891","see-all":"reviews","$kind":"SeeAllPageIntent"}},"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"productRatings"},"allProductReviews":{"$kind":"Shelf","impressionMetrics":null,"contentType":"productReview","marker":null,"items":[{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"12742386505","title":"My vocabulary","date":"2025-06-06T12:28:17.000Z","dateText":"* null *","contents":"It all started when I was in the 3rd grade . I was glued to a thesaurus. My glasses -the size of magnifying glasses, my efficiency - that of a snail. My homework - late. My sanity - all but gone. And then I graduated elementary school and got into middle school, met who I thought was the love of my life. We made a life together we went to theatre , the scene called for us , the lights drawn to us as our audience’ eyes , our eyes locked , as did our lips. Only to have our quiet candid life ripped from us because of graduation. The cruel advances of time and knowledge thrust us into different schools and not into each other. And yet again I who thought would never love again found it yet again. In the arms of my then lover. He made my flaws my perfections. My pride into his pride. My feelings , heard. He opened me to the life of lavishness and simplicity. The contrast or riches and poverty. Highs and lows. Happiness and  depravity. Hate and love. Truly establishing that all things have an equal and opposite. For our love ended with hate. As I opened a new chapter to my life. I went to college and entered the work force. Becoming a productive member of society, I strived for greatness and improve those around me. Learning from and  teaching those around me. Allowing for what is meant for me and achieving that what I set out for. Only to be ensnared by the hooked claws of a game such as wordle. The allure of which made me want to throw my phone but also clutch it for the need of wanting to clear each word with less than 3 attempts. Only to be be rewarded the word genius , some electronic confetti and the satisfaction of finishing a word only to face another word.\nTLDR: wordle is aight.","rating":5,"reviewerName":"The story of wordle","dateAuthorText":"* null * · The story of wordle","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"12742386505","title":"My vocabulary","date":"2025-06-06T12:28:17.000Z","dateText":"* null *","contents":"It all started when I was in the 3rd grade . I was glued to a thesaurus. My glasses -the size of magnifying glasses, my efficiency - that of a snail. My homework - late. My sanity - all but gone. And then I graduated elementary school and got into middle school, met who I thought was the love of my life. We made a life together we went to theatre , the scene called for us , the lights drawn to us as our audience’ eyes , our eyes locked , as did our lips. Only to have our quiet candid life ripped from us because of graduation. The cruel advances of time and knowledge thrust us into different schools and not into each other. And yet again I who thought would never love again found it yet again. In the arms of my then lover. He made my flaws my perfections. My pride into his pride. My feelings , heard. He opened me to the life of lavishness and simplicity. The contrast or riches and poverty. Highs and lows. Happiness and  depravity. Hate and love. Truly establishing that all things have an equal and opposite. For our love ended with hate. As I opened a new chapter to my life. I went to college and entered the work force. Becoming a productive member of society, I strived for greatness and improve those around me. Learning from and  teaching those around me. Allowing for what is meant for me and achieving that what I set out for. Only to be ensnared by the hooked claws of a game such as wordle. The allure of which made me want to throw my phone but also clutch it for the need of wanting to clear each word with less than 3 attempts. Only to be be rewarded the word genius , some electronic confetti and the satisfaction of finishing a word only to face another word.\nTLDR: wordle is aight.","rating":5,"reviewerName":"The story of wordle","dateAuthorText":"* null * · The story of wordle"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"12742386505"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":0}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"9296412806","title":"“Ad Free” is a RIP OFF!!!","date":"2022-11-16T19:56:15.000Z","dateText":"* null *","contents":"Okay so first of all it’s $6 for the ad free version of the game, but I’d been playing it every single day and I’d been going back to do daily puzzles from previous months, before I’d started playing. In order to do this, I was watching an ad to access the game, which was fine, but since ad free was so expensive compared to other apps, I figured purchasing would give me access to previous months puzzles without watching the apps— like other apps I’ve played have done. WRONG. Now I can’t watch an ad to access anything, AND it costs 150 coins PER PUZZLE. That means if I want to do the daily puzzle and the daily plus puzzle for a day I missed, it costs me 300 coins PER DAY!!! I messaged support because this seems really unfair and I would not have purchased the ad free version if I had known, and got no response. Deleted the app hoping I could reset the ads (a desperate attempt, I know) and instead it just erased all my progress and sent me back to the very start. No coins, no master league, not even all features unlocked. There was no way to restore my progress. Even my messages to support were gone. \n\nAnd also, in case you’re thinking you can just pay coins to do old puzzles and that it’ll let you watch an ad to to the next one when you run out of coins, it doesn’t. It tries to force you to buy coins. So you spend $6 for what you think will be a better version of the game, and instead you get slapped with a horrible pay to play system. \n\nDeleted the app.","rating":1,"reviewerName":"SarahSarah0920","dateAuthorText":"* null * · SarahSarah0920","response":{"$kind":"Response","id":"33242546","contents":"Hello! Thank you for the review! Would you mind sending your feedback to our support team? We'd love to hear from you! You can contact support in the game by tapping Gear Icon on the Main Menu, then tapping Help and Support>Get in touch.\r\n","date":"2022-11-18T17:03:58.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"9296412806","title":"“Ad Free” is a RIP OFF!!!","date":"2022-11-16T19:56:15.000Z","dateText":"* null *","contents":"Okay so first of all it’s $6 for the ad free version of the game, but I’d been playing it every single day and I’d been going back to do daily puzzles from previous months, before I’d started playing. In order to do this, I was watching an ad to access the game, which was fine, but since ad free was so expensive compared to other apps, I figured purchasing would give me access to previous months puzzles without watching the apps— like other apps I’ve played have done. WRONG. Now I can’t watch an ad to access anything, AND it costs 150 coins PER PUZZLE. That means if I want to do the daily puzzle and the daily plus puzzle for a day I missed, it costs me 300 coins PER DAY!!! I messaged support because this seems really unfair and I would not have purchased the ad free version if I had known, and got no response. Deleted the app hoping I could reset the ads (a desperate attempt, I know) and instead it just erased all my progress and sent me back to the very start. No coins, no master league, not even all features unlocked. There was no way to restore my progress. Even my messages to support were gone. \n\nAnd also, in case you’re thinking you can just pay coins to do old puzzles and that it’ll let you watch an ad to to the next one when you run out of coins, it doesn’t. It tries to force you to buy coins. So you spend $6 for what you think will be a better version of the game, and instead you get slapped with a horrible pay to play system. \n\nDeleted the app.","rating":1,"reviewerName":"SarahSarah0920","dateAuthorText":"* null * · SarahSarah0920","response":{"$kind":"Response","id":"33242546","contents":"Hello! Thank you for the review! Would you mind sending your feedback to our support team? We'd love to hear from you! You can contact support in the game by tapping Gear Icon on the Main Menu, then tapping Help and Support>Get in touch.\r\n","date":"2022-11-18T17:03:58.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"9296412806"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"1","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":1}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"10525010032","title":"Very good app","date":"2023-10-28T16:23:57.000Z","dateText":"* null *","contents":"This app keeps me entertained for hours. It is an amazing app and I really hope you will except this because it is one of the best apps that I’ve ever use that keeps me entertained for a very long time. I see all the reviews it’s perfect for someone who has patience if you don’t have patience please don’t get this because you will not like this, so if you really want this game it’s a very wonderful game you do not have to pay anything there’s a daily wordle a spelling bee and more it is a bunch of fun and you can do it with as many people as you like it is free to download and it is a perfect game for people who have a lot of smartness and patience and anyway I love this game I had it before and I deleted it but then I got it back because I’m like I am bored. How about we try this game again so I think that you should definitely and if you’re like on a long car ride, this is perfect to entertain you and maybe your family to have a lot of fun car ride and it depends. Where are you going? You can like get a bunch of different like categories so like you can get a tropical category if you’re going to like Hawaii and If you are  like going to like a tropical area. You can get the tropical vibes thing and go into like a Halloween parade. Very far away you can get the Halloween mode it has a bunch of features. and someone who loves anything or any words are any will love this game and say you’re on the road this game has gotten you covered. I mean it does have some payments if you want to like get more coins but you can also get like 50 coins by watching an ad and if you don’t want any, and you have to buy that sorry i connot control that I’m sorry I can’t control it but I just tried to give you guys are gonna love you you guys can get this game whoever only owns this game kissing noises dead perfect.","rating":5,"reviewerName":"Adalyn Welliver","dateAuthorText":"* null * · Adalyn Welliver","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"10525010032","title":"Very good app","date":"2023-10-28T16:23:57.000Z","dateText":"* null *","contents":"This app keeps me entertained for hours. It is an amazing app and I really hope you will except this because it is one of the best apps that I’ve ever use that keeps me entertained for a very long time. I see all the reviews it’s perfect for someone who has patience if you don’t have patience please don’t get this because you will not like this, so if you really want this game it’s a very wonderful game you do not have to pay anything there’s a daily wordle a spelling bee and more it is a bunch of fun and you can do it with as many people as you like it is free to download and it is a perfect game for people who have a lot of smartness and patience and anyway I love this game I had it before and I deleted it but then I got it back because I’m like I am bored. How about we try this game again so I think that you should definitely and if you’re like on a long car ride, this is perfect to entertain you and maybe your family to have a lot of fun car ride and it depends. Where are you going? You can like get a bunch of different like categories so like you can get a tropical category if you’re going to like Hawaii and If you are  like going to like a tropical area. You can get the tropical vibes thing and go into like a Halloween parade. Very far away you can get the Halloween mode it has a bunch of features. and someone who loves anything or any words are any will love this game and say you’re on the road this game has gotten you covered. I mean it does have some payments if you want to like get more coins but you can also get like 50 coins by watching an ad and if you don’t want any, and you have to buy that sorry i connot control that I’m sorry I can’t control it but I just tried to give you guys are gonna love you you guys can get this game whoever only owns this game kissing noises dead perfect.","rating":5,"reviewerName":"Adalyn Welliver","dateAuthorText":"* null * · Adalyn Welliver"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"10525010032"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":2}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8424392658","title":"So many ads and alarming amount of background activity","date":"2022-03-05T21:59:41.000Z","dateText":"* null *","contents":"Very little of your time can be spent trying to play the actual game, with all the ads that pop up. And they’re timed ads, so there’s no way to click through them, even if you aren’t at all interested in what they’re selling or EVEN IF YOU ALREADY HAVE WHAT THEY'RE SELLING. I would urge even the most patient and tolerant person not to download this ap, since, even if you don’t mind walking away for a bit while these constant ads play, it seems like there’s a lot of background activity taking place, even while playing the game, causing delays when you’re trying to type your guesses, with huge lags between letters, sometimes even seeming to freeze entirely. I’m not a developer, but I do wonder what is occupying so much of the app’s attention, after signing off on their user agreement and giving permission to god knows what information is being accessed. It’s so bad that it comes to a complete halt at times and crashes entirely. So bad, that I recommend deleting any app that appears to be associated with it, like the ones it advertises, one of which I had considered buying, but now most certainly will not. It the sign of a developer who lacks anything of value to offer, so survives on the sole project of extracting value from others by whatever means is necessary and however possible. \n\ntl/dr: this app is way too expensive — especially the free version. Don’t do it.","rating":1,"reviewerName":"Pletched","dateAuthorText":"* null * · Pletched","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8424392658","title":"So many ads and alarming amount of background activity","date":"2022-03-05T21:59:41.000Z","dateText":"* null *","contents":"Very little of your time can be spent trying to play the actual game, with all the ads that pop up. And they’re timed ads, so there’s no way to click through them, even if you aren’t at all interested in what they’re selling or EVEN IF YOU ALREADY HAVE WHAT THEY'RE SELLING. I would urge even the most patient and tolerant person not to download this ap, since, even if you don’t mind walking away for a bit while these constant ads play, it seems like there’s a lot of background activity taking place, even while playing the game, causing delays when you’re trying to type your guesses, with huge lags between letters, sometimes even seeming to freeze entirely. I’m not a developer, but I do wonder what is occupying so much of the app’s attention, after signing off on their user agreement and giving permission to god knows what information is being accessed. It’s so bad that it comes to a complete halt at times and crashes entirely. So bad, that I recommend deleting any app that appears to be associated with it, like the ones it advertises, one of which I had considered buying, but now most certainly will not. It the sign of a developer who lacks anything of value to offer, so survives on the sole project of extracting value from others by whatever means is necessary and however possible. \n\ntl/dr: this app is way too expensive — especially the free version. Don’t do it.","rating":1,"reviewerName":"Pletched","dateAuthorText":"* null * · Pletched"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"8424392658"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":3}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"10501010515","title":"Game play is very fun.  Frequency and length of ads is maddening","date":"2023-10-21T22:22:58.000Z","dateText":"* null *","contents":"The good:  I absolutely love the challenging game play.  If I could suggest a change, it would be to show in classic mode  how you compare to other players.  Currently, they only show your results compared to the average in the daily/calendar play.\n\nThe really bad:  Players have to watch way, way too many ads.  You watch ads after one or two guesses—not just after a puzzle is solved.  Also, some of those ads are too long.  For example, the Royal Match ads that play are multi-phased.  You wait for the ad to time out, only to find that you have to wait through another phase of the ad.  Usually , the first phase is quite long.  The second phase is shorter, but together, they make for what seems like a never-ending ad.\n\nI understand that app developers need to get paid, just like the rest of us.  When I get a free app, I expect to watch ads—which serves as payment.  Still, the frequency with which ads appear as well as their length make me feel like we don’t have a reasonable exchange of ad time for plays happening.  I am going to delete the app.  I’m sure I can find something else out there that will challenge my brain without taxing my sanity.","rating":3,"reviewerName":"Sillo Whet","dateAuthorText":"* null * · Sillo Whet","response":{"$kind":"Response","id":"39741825","contents":"\r\nThank you for sharing your thoughts about the ads in the game. We are working to find the right balance between offering a free gaming experience and including ads. Your feedback helps us improve, and we're considering ways to make the ad experience less intrusive. We appreciate your support as we continue to enhance your gaming enjoyment.\r\n","date":"2023-10-25T23:44:58.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"10501010515","title":"Game play is very fun.  Frequency and length of ads is maddening","date":"2023-10-21T22:22:58.000Z","dateText":"* null *","contents":"The good:  I absolutely love the challenging game play.  If I could suggest a change, it would be to show in classic mode  how you compare to other players.  Currently, they only show your results compared to the average in the daily/calendar play.\n\nThe really bad:  Players have to watch way, way too many ads.  You watch ads after one or two guesses—not just after a puzzle is solved.  Also, some of those ads are too long.  For example, the Royal Match ads that play are multi-phased.  You wait for the ad to time out, only to find that you have to wait through another phase of the ad.  Usually , the first phase is quite long.  The second phase is shorter, but together, they make for what seems like a never-ending ad.\n\nI understand that app developers need to get paid, just like the rest of us.  When I get a free app, I expect to watch ads—which serves as payment.  Still, the frequency with which ads appear as well as their length make me feel like we don’t have a reasonable exchange of ad time for plays happening.  I am going to delete the app.  I’m sure I can find something else out there that will challenge my brain without taxing my sanity.","rating":3,"reviewerName":"Sillo Whet","dateAuthorText":"* null * · Sillo Whet","response":{"$kind":"Response","id":"39741825","contents":"\r\nThank you for sharing your thoughts about the ads in the game. We are working to find the right balance between offering a free gaming experience and including ads. Your feedback helps us improve, and we're considering ways to make the ad experience less intrusive. We appreciate your support as we continue to enhance your gaming enjoyment.\r\n","date":"2023-10-25T23:44:58.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"10501010515"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":4}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"13842174168","title":"Pop up ads make this game unplayable without turning on airplane mode","date":"2026-03-13T01:49:11.000Z","dateText":"* null *","contents":"Picture this; your hard at work guessing words in a tense Wordle battle, but out of nowhere, an obnoxious pop-up interrupts your guessing. You fumble around looking for the “X” button that could live in anywhere of the four corners of the screen. Eventually, the mind numbing ad’s timer runs out, but you can’t get back to guessing without first clicking out of 4 different pages trying to get you do download the low quality app/game. By the time you’re back to the Wordle game, you’re completely out of your element and might as well start from scratch. But don’t get too comfortable, because another advert is waiting just around the corner. \n\nAnd I get it, gotta pay for the game somehow, but seriously, the number of ads is unbelievably high and it makes me not want to click on the app when I normally would.\nI already hear what you’re gonna say, just spend $3 on the ad free version… but that’s not how it works. You don’t bully a customer into spending money on your game via a bombardment of ads that make it close to unplayable without further purchases. Instead, you make a game so dang good people can’t help but want to pay you. Just my thoughts…","rating":2,"reviewerName":"): Sad User #22471 :(","dateAuthorText":"* null * · ): Sad User #22471 :(","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"13842174168","title":"Pop up ads make this game unplayable without turning on airplane mode","date":"2026-03-13T01:49:11.000Z","dateText":"* null *","contents":"Picture this; your hard at work guessing words in a tense Wordle battle, but out of nowhere, an obnoxious pop-up interrupts your guessing. You fumble around looking for the “X” button that could live in anywhere of the four corners of the screen. Eventually, the mind numbing ad’s timer runs out, but you can’t get back to guessing without first clicking out of 4 different pages trying to get you do download the low quality app/game. By the time you’re back to the Wordle game, you’re completely out of your element and might as well start from scratch. But don’t get too comfortable, because another advert is waiting just around the corner. \n\nAnd I get it, gotta pay for the game somehow, but seriously, the number of ads is unbelievably high and it makes me not want to click on the app when I normally would.\nI already hear what you’re gonna say, just spend $3 on the ad free version… but that’s not how it works. You don’t bully a customer into spending money on your game via a bombardment of ads that make it close to unplayable without further purchases. Instead, you make a game so dang good people can’t help but want to pay you. Just my thoughts…","rating":2,"reviewerName":"): Sad User #22471 :(","dateAuthorText":"* null * · ): Sad User #22471 :("}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"13842174168"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":5}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"12227824200","title":"Beyond Greedy App Developers","date":"2025-01-25T06:44:56.000Z","dateText":"* null *","contents":"this is one of the most blatantly ridiculous greedy apps i’ve ever downloaded. every single review is complaining about the ads. it’s been like that for years. they do not address this in the slightest\n\nthe people rating this highly are doing so on the merit of the game itself. wordle is one of the best word games created in the 21st century. but these app developers are the not the original creators of this game. they’re just people trying to take advantage of how popular and successful the game is. it’s insane how many ads this app bombards you with. it literally feels like every click hits you with an ad. it’d be understandable if it was maybe once after every game but instead it feels like the all developers are focusing on making ad revenue rather than letting people enjoy the actual gameplay. it’s ridiculous how much you have to pay to get rid of ads too. 6 dollars for just one month ad free? nobody is trying to pay for another monthly subscription service. especially for an app that should be free to enjoy\n\nplus what were they thinking with these prizes. the way they have prizes set up, it’s near impossible to actually earn anything. you can spend money to just unlock things but what’s the point on this app. they’re literally just trying to get people to throw as much money as they can on this app without a care in the world for our experience. i’m deleting this app on the sole principal that these developers don’t deserve any sort of money with how they’re taking advantage of people. in the current state of this app, it’s near unplayable because of the ads and it’s not worth supporting such blatantly greedy behavior","rating":1,"reviewerName":"RayJulesVero","dateAuthorText":"* null * · RayJulesVero","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"8","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"12227824200","title":"Beyond Greedy App Developers","date":"2025-01-25T06:44:56.000Z","dateText":"* null *","contents":"this is one of the most blatantly ridiculous greedy apps i’ve ever downloaded. every single review is complaining about the ads. it’s been like that for years. they do not address this in the slightest\n\nthe people rating this highly are doing so on the merit of the game itself. wordle is one of the best word games created in the 21st century. but these app developers are the not the original creators of this game. they’re just people trying to take advantage of how popular and successful the game is. it’s insane how many ads this app bombards you with. it literally feels like every click hits you with an ad. it’d be understandable if it was maybe once after every game but instead it feels like the all developers are focusing on making ad revenue rather than letting people enjoy the actual gameplay. it’s ridiculous how much you have to pay to get rid of ads too. 6 dollars for just one month ad free? nobody is trying to pay for another monthly subscription service. especially for an app that should be free to enjoy\n\nplus what were they thinking with these prizes. the way they have prizes set up, it’s near impossible to actually earn anything. you can spend money to just unlock things but what’s the point on this app. they’re literally just trying to get people to throw as much money as they can on this app without a care in the world for our experience. i’m deleting this app on the sole principal that these developers don’t deserve any sort of money with how they’re taking advantage of people. in the current state of this app, it’s near unplayable because of the ads and it’s not worth supporting such blatantly greedy behavior","rating":1,"reviewerName":"RayJulesVero","dateAuthorText":"* null * · RayJulesVero"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"12227824200"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":6}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"13644431365","title":"Customer Support? 😂😂😂😂😂😂😂😂😂","date":"2026-01-17T16:46:02.000Z","dateText":"* null *","contents":"I’ve played this game for ages and bought coins several times but never again. I have been very committed to following a routine since Nov 1. I have not  strayed from that path yet and I’m not going to! However, this game showed that I did not play on two days. I will swear on my mother’s wedding ring that I did play those days. I contacted customer support. They say I didn’t play those days. My word against theirs but they are basically calling me a liar but coached in better words. If you’re looking for any type of “support” may I suggest the Flying Spaghetti Monster because I believe you’ll get better support.\nAlso the ads. I understand that ads are a source of revenue but the average person will know within 15-20 seconds if the ad is for something they’re interested in. The ads that go on f.o.r.e.v.e.r…….are as annoying as a mosquito and a cricket in your bedroom at 2:00am. Long ads are irritating and a turnoff for attracting attention.\nIt’s now the following February and they are stealing the days I’ve played. I even sent in a photo and they had a male bovine effluvia excuse that had holes in it that were so big you could have pushed the national debt through it with room to spare. Please don’t give money to these unabashed, unapologetic, asinine thieves.","rating":1,"reviewerName":"Linneybeans Mom","dateAuthorText":"* null * · Linneybeans Mom","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"9","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"13644431365","title":"Customer Support? 😂😂😂😂😂😂😂😂😂","date":"2026-01-17T16:46:02.000Z","dateText":"* null *","contents":"I’ve played this game for ages and bought coins several times but never again. I have been very committed to following a routine since Nov 1. I have not  strayed from that path yet and I’m not going to! However, this game showed that I did not play on two days. I will swear on my mother’s wedding ring that I did play those days. I contacted customer support. They say I didn’t play those days. My word against theirs but they are basically calling me a liar but coached in better words. If you’re looking for any type of “support” may I suggest the Flying Spaghetti Monster because I believe you’ll get better support.\nAlso the ads. I understand that ads are a source of revenue but the average person will know within 15-20 seconds if the ad is for something they’re interested in. The ads that go on f.o.r.e.v.e.r…….are as annoying as a mosquito and a cricket in your bedroom at 2:00am. Long ads are irritating and a turnoff for attracting attention.\nIt’s now the following February and they are stealing the days I’ve played. I even sent in a photo and they had a male bovine effluvia excuse that had holes in it that were so big you could have pushed the national debt through it with room to spare. Please don’t give money to these unabashed, unapologetic, asinine thieves.","rating":1,"reviewerName":"Linneybeans Mom","dateAuthorText":"* null * · Linneybeans Mom"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1095569891","targetReviewId":"13644431365"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":7}}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"allProductReviews"},"mostRecentVersion":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"20","name":"What’s New","impressionType":"versionHistory","idType":"sequential","impressionIndex":2}},"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"We’ve made several optimizations and fixes to improve your WORDLE! experience. Thanks as always for playing WORDLE!","style":"overview","wantsCollapsedNewlines":true,"primarySubtitle":"Version 3.1.5","secondarySubtitle":"Wed Sep 09 2026 00:06:04 GMT+0000 (Coordinated Universal Time)"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"Version History","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"location":[{"locationPosition":2,"locationType":"button","name":"Version History"}],"actionType":"navigate","target":"button_See All","eventType":"click","targetType":"button","targetId":"See All","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingField