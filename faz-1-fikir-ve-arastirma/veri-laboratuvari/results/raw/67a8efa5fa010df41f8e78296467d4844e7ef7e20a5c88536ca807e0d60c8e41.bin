https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/26/6a/92/266a92d6-3d0b-9536-8a7a-a27824be3748/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Profile Perfect","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Logic Grid & Detective Puzzles","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Logic Grid & Detective Puzzles","ageRating":"13+","productDescription":"This game is a clever and immersive investigation puzzle where every clue matters, designed for fans of brain and IQ challenges. Your goal is simple: discover the truth behind every file, find the hidden secrets, and master the art of the digital search in this fun game.\n\nGuess the identity of the person behind the screen and uncover the story through social media deep-dives and digital sleuthing. Tap through profiles, identify suspicious activity, and find the perfect cross-reference as you solve each crime using pure logic and sharp observation. Smooth mechanics and ASMR-inspired interactions make every investigation feel precise and satisfying.\n\nWith easy-to-learn mechanics and gradually increasing difficulty, this game stands among the best brain games for sharpening your detective skills. Each level works like a digital crossword of information, pushing you to recognize patterns and discover what’s hidden in plain sight. Whether you are looking for a missing cat or solving a high-stakes mystery, this free game offers a unique merge of investigative logic and storytelling.\n\nGame Features\n• Investigation-based logic puzzles that are fun and easy to learn\n• Relaxing yet challenging IQ training experience\n• Thoughtful level design that blends crossword logic with detective mechanics\n• Offline-friendly play with no wifi games for free\n• Precision controls and a clever strategy for every digital file\n\nThis game blends brain games, mystery stories, and smart interaction into a polished puzzle experience that rewards patience and sharp thinking.\n\nCan you find out who is lying — or will the truth stay hidden in the file?\n\nVisit https://lionstudios.cc/contact-us/ if you have any feedback, need help beating a level, or have any awesome ideas you would like to see in the game!\n\nFrom the studio that brought you Wordle!, Match 3D, Happy Glass, Hexa Sort, and many, many more!\n\nFollow us to get news and updates on our other award-winning titles:\nhttps://lionstudios.cc/\nFacebook.com/LionStudios.cc\nInstagram.com/LionStudioscc\nTwitter.com/LionStudiosCC\nYoutube.com/c/LionStudiosCC","rating":4.8,"ratingCount":"11K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6759077038&pricingParameters=STDQ&pg=default&appExtVrsId=890878126"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"6759077038"},{"locationPosition":12,"locationType":"lockup","name":"Profile Perfect","idType":"its_id","id":"6759077038"},{"locationPosition":11,"locationType":"swoosh","name":"More by Lion Studios Plus","idType":"sequential","id":"25"}],"jet_adamId":"6759077038","eventType":"click","targetType":"button","targetId":"6759077038","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6759077038"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"6759077038","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=6759077038&pricingParameters=STDQ&pg=default&appExtVrsId=890878126","vendor":"Lion Studios Plus","appName":"Profil