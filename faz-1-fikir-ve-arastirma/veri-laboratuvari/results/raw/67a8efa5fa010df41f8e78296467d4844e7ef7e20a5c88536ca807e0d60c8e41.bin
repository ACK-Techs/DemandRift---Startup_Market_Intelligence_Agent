0&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"6608973267","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"6608973267","name":"Clue Master - Logic Puzzles","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":10,"contentRating":313,"bundleId":"com.regulusstudio.lexicard"}}},{"$kind":"Lockup","adamId":"6754839783","bundleId":"com.AppFore.BubbleWordJam","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.8196078431372549,"green":0.8392156862745098,"blue":0.8117647058823529,"type":"rgb"},"textColor":{"red":0.058823529411764705,"green":0.14901960784313725,"blue":0.26666666666666666,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/56/d2/43/56d24331-804a-f2ed-449f-f2c7ac3bd05c/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Bubble Word Jam","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Connect words & pop bubbles!","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Connect words & pop bubbles!","ageRating":"13+","productDescription":"This game is a clever and calm word puzzle where every connection matters, designed for fans of brain and mind challenges. Your goal is simple: match the bubble words to their correct categories and clear the board in this smart sorting experience.\n\nTap bubbles, identify themes, and find the perfect flow as you sort words into groups using pure logic and vocabulary. Smooth mechanics and responsive controls make every play feel precise and satisfying.\n\nWith gradually increasing difficulty and thousands of handcrafted levels, this game stands among the best games for iq improvement, training, and problem solving. Each level works like a compact jam session for your mind, pushing you to recognize patterns and adapt. This free game offers a unique merge of category sorting and word hunting.\n\nWhen a level gets tricky, helpful boosters are there to support you:\nUse the Booster Magnifying Glass to reveal a hidden category connection, the Booster Magnet to automatically pull matching bubbles together, and Add Bubble to give yourself more space and opportunities to clear the board.\n\nGame Features\n• Category-based logic puzzles that are fun and easy to learn\n• Relaxing yet challenging brain training game experience\n• Thoughtful level design that blends crossword themes with sorting mechanics\n• Offline-friendly play with no wifi games for free\n• Precision controls, helpful boosters, and a scrabble-like strategy for extended sessions\n\nThis game blends brain games, mind games, and smart interaction into a polished puzzle experience that rewards patience and clever thinking.\n\nCan you sort them all — or will your words end up in a jam?\n\nVisit https://lionstudios.cc/contact-us/ if you have any feedback, need help beating a level, or have any awesome ideas you would like to see in the game!\n\nFrom the studio that brought you Wordle!, Match 3D, Happy Glass, Hexa Sort, and many, many more!\n\nFollow us to get news and updates on our other award-winning titles:\nhttps://lionstudios.cc/\nFacebook.com/LionStudios.cc\nInstagram.com/LionStudioscc\nTwitter.com/LionStudiosCC\nYoutube.com/c/LionStudiosCC","rating":4.7,"ratingCount":"62K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6754839783&pricingParameters=STDQ&pg=default&appExtVrsId=891536772"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"6754839783","