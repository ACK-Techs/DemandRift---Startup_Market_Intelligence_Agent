p_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"http://lionstudios.cc","isSensitive":false},"systemImageName":"safari"},{"$kind":"ProductPageLink","text":"Privacy Policy","clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://lionstudios.cc/privacy/","location":[{"locationPosition":11,"locationType":"lockup","name":"","idType":"its_id","id":"LinkToPrivacyPolicy"}],"eventType":"click","targetType":"link","targetId":"LinkToPrivacyPolicy","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://lionstudios.cc/privacy/","isSensitive":false},"systemImageName":"hand.raised.fill"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"purchasedLinks"},"textLinksShelf":null,"moreByDeveloper":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"25","name":"More by Lion Studios Plus","impressionType":"developer","idType":"sequential","impressionIndex":11}},"contentType":"smallLockup","marker":null,"items":[{"$kind":"Lockup","adamId":"1502447854","bundleId":"com.loop.match3d","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.26666666666666666,"green":0.49411764705882355,"blue":0.9882352941176471,"type":"rgb"},"textColor":{"red":0.027450980392156862,"green":0.0196078431372549,"blue":0.011764705882352941,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/92/44/c0/9244c0ea-d0b2-10d7-ab33-b6b86fce83f3/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Match 3D","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Solve Hidden Objects Puzzle","tertiaryTitle":"Designed for iPad","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Solve Hidden Objects Puzzle","ageRating":"13+","productDescription":"Get ready for a new, challenging and original matching pairs game.\r\nYou need to match 3D objects on the ground and pop them all! When you clear a level, you will find new objects to pair.\r\n\r\nFeatures\r\n\r\nShiny 3D visual effects and objects:\r\nEvery level of Match 3D will give you an enjoyable fun experience of matching 3D objects on the screen, every move you make will give you a satisfying 3D effect that will elevate your game experience.\r\n\r\nWell-designed brain trainer levels\r\nWe are happy to tell you that our game will make it easier for you to memorize objects and small details by playing our brain trainer levels, you will start to notice your that memorizing abilities getting better with time.\r\n\r\nPause it whenever you want\r\nBecause we know that you are a busy person, and we value your time, we implemented the pause feature where you are able to pause whenever you want, so you can get back to matching 3D objects anytime you want.\r\n\r\n Cute animals, sweet yummy food, cool toys, exciting emojis, and much more stuff to puzzle out.\r\nAuto-save game to continue from where you left off.\r\n\r\nMatch 3D is easy to play for everyone!\r\n\r\nShiny pairs of animals, food, school items, household objects, emojis, and many more exciting type levels to unlock by simply matching the pairs!\r\n\r\nHow To Play 3D Match:\r\n- Pick the 1st 3d object it can be (a shiny 3D object, animal, or an emoji)\r\n- Then pick up the 2nd 3d object & move both of them to the circle in the middle of the screen.\r\n- Keep doing that until you clear the whole screen & win the level.\r\n- Then keep having fun & start a new level \r\n\r\nOffering tons of cute combinations, this free game will power up your brain and increase your memory speed.\r\n\r\nAll you need to do is play this connection-based game with various 3D levels that set it apart from all other games. This matching pairs game is so easy that anyone can play it.\r\n\r\nFollow us to get news and updates on our other Award Winning titles;\r\nhttps://lionstudios.cc/\r\nFacebook.com/LionStudios.cc\r\nInstagram.com/LionStudioscc\r\nTwitter.com/LionStudiosCC\r\nYoutube.com/c/LionStudiosCC","rating":4.8,"ratingCount":"971K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1502447854&pricingParameters=STDQ&pg=default&appExtVrsId=891601351"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1502447854"},{"locationPosition":0,"locationType":"lockup","name":"Match 3D","idType":"its_id","id":"1502447854"},{"locationPosition":11,"locationType":"swoosh","name":"More by Lion Studios Plus","idType":"sequential","id":"25"}],"jet_adamId":"1502447854","eventType":"click","targetType":"button","targetId":"1502447854","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1502447854"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1502447854","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price