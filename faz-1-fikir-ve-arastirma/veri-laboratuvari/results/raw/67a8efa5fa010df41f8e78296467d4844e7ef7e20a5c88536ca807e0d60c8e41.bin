t-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"6446354191","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"6446354191","name":"Coin Sort","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":8,"contentRating":313,"bundleId":"com.MoodGames.CoinSort"}}},{"$kind":"Lockup","adamId":"6745272388","bundleId":"com.block.buster","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.8509803921568627,"green":0.5137254901960784,"blue":0.20784313725490197,"type":"rgb"},"textColor":{"red":0.050980392156862744,"green":0.011764705882352941,"blue":0.00784313725490196,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/28/af/69/28af69ad-17f8-f014-616d-54591f9b418e/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Block Buster - No Timer","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Slide & Sort Blocks","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Slide & Sort Blocks","ageRating":"13+","productDescription":"Block Buster - No Timer is a clever, colorful block puzzle where every move matters, designed for fans of brain and mind challenges. Your goal is simple: fit the right brick through the grid and reach the top in this smart blockblast experience.\n\nSlide blocks, sort cube shapes, and plan ahead using pure logic and spatial thinking. Smooth jam flow and responsive controls make every decision feel precise and satisfying. Whether you’re creating a rainbow blast or solving a hard level, the easy mechanics keep the fun moving.\n\nWith gradually increasing difficulty and thousands of handcrafted levels, Block Buster stands among the best games for IQ improvement, training, and problem-solving. Each puzzle works like a compact teaser, pushing you to think ahead and adapt your myblock strategy to crush every challenge.\n\nWhen a level gets tricky, helpful boosters are there to support you:\nUse the magnet to clear all the blocks of the same color, and the powerful punch to remove blocks and obstacles\n\nGame Features\n\n- Block-based logic puzzles with evolving mechanics and a new advanced game design\n- Relaxing yet challenging brain training games experience\n- Thoughtful puzzles and colorful level design\n- Offline-friendly play with no wifi\n- Precision controls, helpful boosters, and a comfortable black mode for extended play\n\nBlock Buster - No Timer blends brain games, mind games, and smart interaction into a polished experience that rewards patience and clever logic.\n\nCan you find the way out — or will your blocks reach the top?\n\nVisit https://lionstudios.cc/contact-us/ if you have any feedback, need help beating a level, or have any awesome ideas you would like to see in the game!\n\nFrom the studio that brought you Wordle!, Match 3D, Happy Glass, Hexa Sort, and many, many more!\n\nFollow us to get news and updates on our other award-winning titles:\nhttps://lionstudios.cc/\nFacebook.com/LionStudios.cc\nInstagram.com/LionStudioscc\nTwitter.com/LionStudiosCC\nYoutube.com/c/LionStudiosCC","rating":4.7,"ratingCount":"35K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6745272388&pricingParameters=STDQ&pg=default&appExtVrsId=891478511"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"6745272388"},{"locationPosition":9,"locationType":"lockup","name":"Block Buster - No Timer","idType":"