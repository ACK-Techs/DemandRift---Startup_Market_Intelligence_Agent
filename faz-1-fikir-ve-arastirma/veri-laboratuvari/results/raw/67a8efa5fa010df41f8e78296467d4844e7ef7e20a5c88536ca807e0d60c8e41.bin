ue":0,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/75/49/03/75490314-fe96-a8f5-4c70-568013a67067/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Merge Life","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Merge to Raise Your Baby!","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Merge to Raise Your Baby!","ageRating":"13+","productDescription":"In Merge Life, you will decorate your child’s room as they age from baby to adult! Become obsessed with endless interior design projects, but don’t forget about the child's needs, as he’ll start crying and misbehaving. Your goal is to merge items to complete “orders” for your child, like a bottle for the hungry baby or a toy. And as you complete orders you’ll get golden stars (for being a good parent!) that you will use to upgrade your babies bedroom and accessories!\r\n\r\nOnce you’re finished the babies bedroom, baby will grow up, and it’ll be time to make the toddlers room! And then the tweens room, then the teens room, all they way up to their first apartment. Remember, kids look different at different ages, so make sure the room's interior design matches the age, and the child is happy!\r\n\r\nThere are millions of items to merge and unlock, exploration will lead to game changing discoveries. As you level up through the game, the child has to choose a life path option - astronaut, athlete, or rockstar. Help him in these important decision-making process!\r\n\r\nDecorate the Child’s Room: Decorate the child’s room as they age from baby to adult! \r\nMerge Items to Complete Item Orders: Merge items together to complete your tasks for a specific item that the baby needs. \r\nUnlock New Items: As you level up through the game and age up the kid, you can unlock new mergeable items.\r\n\r\nMerge Life is so much fun. Join and see for yourself today!\r\n\r\nVisit https://lionstudios.cc/contact-us/ if have any feedback, need help on beating a level or have any awesome ideas you would like to see in the game!\r\n\r\nFrom the Studio that brought you Mr. Bullet, Happy Glass, Ink Inc and Love Balls!\r\n\r\nFollow us to get news and updates on our other Award Winning titles;\r\nhttps://lionstudios.cc/\r\nFacebook.com/LionStudios.cc\r\nInstagram.com/LionStudioscc\r\nTwitter.com/LionStudiosCC\r\nYoutube.com/c/LionStudiosCC\r","rating":4.6,"ratingCount":"8.7K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1556497052&pricingParameters=STDQ&pg=default&appExtVrsId=868935723"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1556497052"},{"locationPosition":14,"locationType":"lockup","name":"Merge Life","idType":"its_id","id":"1556497052"},{"locationPosition":11,"locationType":"swoosh","name":"More by Lion Studios Plus","idType":"sequential","id":"25"}],"jet_adamId":"1556497052","eventType":"click","targetType":"button","targetId":"1556497052","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1556497052"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1556497052","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1556497052&pricingParameters=STDQ&pg=default&appExtVrsId=868935723","vendor":"Lion Studios Plus","appName":"Merge Life","bundleId":"cc.lionstudios.mergelife","appPlatforms":["p