ption%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1545206038","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1545206038","name":"Dingbats - Word Games & Trivia","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":5,"contentRating":313,"bundleId":"com.beanstargames.dingbats"}}},{"$kind":"Lockup","adamId":"6453159988","bundleId":"com.regulusstudio.familytree","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.21568627450980393,"green":0.21568627450980393,"blue":0.21568627450980393,"type":"rgb"},"textColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/63/c6/e7/63c6e757-70ef-105d-660a-c1b8204041fc/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Family Tree! - Logic Puzzles","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Solve the Family Tree!","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Solve the Family Tree!","ageRating":"18+","productDescription":"Play the ultimate brain puzzle game and boost your IQ! \n\nFamily Tree is a logic puzzle game where you can flex your brain, train your focus, and elevate your memory. Unlock the intricate branches of different families with the help of clues and build big towns. Family Tree word puzzle game will challenge your IQ, logic, and word-solving skills while immersing you in an engaging story. \n\nLogic puzzles and challenges of Family Tree provide mental stimulation, encouraging critical thinking, problem-solving, and logic skills, which is especially beneficial for cognitive health. Family Tree logic game combines the excitement of solving puzzles, building towns, and unlocking various family stories. Family Tree IQ game allows users to collect clues related to their ancestors or historical events. These clues are used to unlock new branches of the family tree and reveal hidden secrets.\n\nGame Features: \n\n► Family Tree Exploration: Embark on a captivating journey through generations of a family tree, solving word puzzles that reveal the hidden tales and secrets of ancestors. As you progress, the story unfolds, offering the entire family a unique and enriching experience.\n\n► Word Puzzle Challenges: Test your brain with an array of challenging word puzzles that require logical thinking and creativity to solve. Each level presents a new riddle to crack, making every moment an opportunity to learn and think critically.\n\n► Nonogram Artistry: Immerse yourself in the world of nonogram puzzles, where clues guide your path to uncover stunning family portraits and historical artifacts. It's not just a game; it's a creative journey.\n\n► Clue Collection: Dive deep into the enigmatic past of a family tree as you gather clues to unlock its mysteries. Pay close attention to every detail, as each clue is a piece of the larger puzzle waiting to be solved.\n\n► Level Up Your IQ: Watch your IQ soar to new heights as you progress through the game's challenging levels. Family Tree is designed to entertain and enrich your mind with each passing level.\n\nAre you ready to embark on a word puzzle adventure that will challenge your intellect, sharpen your logic, and reveal the captivating story of a family's past? Family Tree is not just a game; it's an educational journey that brings family history to life, one puzzle at a time. \n\nPlay now and get ready to think, learn, and solve your way through the generations!","rating":4.6,"ratingCount":"47K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6453159988&pricingParameters=STDQ&pg=default&appExtVrsId=891742821"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"6453159988"},{"locationPosition":6,"locationType":"lockup","name":"Family Tree! - Logic Puzzles","idType":"its_id","id":"6453159988"},{"locationPosition":11,"locationType":"swoosh","name":"More by Lion Studios Plus","idType":"sequential","id":"25"}],"jet_adamId":"6453159988","eventType":"click","targetType":"button","targetId":"6453159988","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6453159988"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"6453159988","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&s