<script>
try {
window._customJS = function (_root) {
  var root = _root || document;
  var bar = root.querySelector('[data-region]');
  if (!bar) return;

  var toggle = root.querySelector('#custom-expand');
  /* ---- 1. keep aria-expanded truthful ----
     floating-unit.js owns open/closed via .expanded on the bar, and already flips
     aria-expanded when the toggle is pressed -- but not when it collapses on
     click-outside. So mirror the class onto the attribute rather than toggling it
     here: a second toggle would cancel the platform's out and the caret would never
     move. The caret and panel are driven from .expanded in _jetbrains.scss. */
  if (toggle) {
    var syncAria = function () {
      toggle.setAttribute('aria-expanded', String(bar.classList.contains('expanded')));
    };
    new MutationObserver(syncAria).observe(bar, {attributes: true, attributeFilter: ['class']});
    syncAria();
  }

  /* ---- 2. Esc closes the panel -- floating-unit has click-outside but no key handling ---- */
  root.addEventListener('keydown', function (e) {
    if ((e.key === 'Escape' || e.key === 'Esc') && toggle && bar.classList.contains('expanded')) {
      toggle.dispatchEvent(new MouseEvent('mousedown', {bubbles: true}));
    }
  });
};

(function() {
    window._customJS(null);
})();
}catch(e){ console.log("err", e)};
</script>




    

            
    
