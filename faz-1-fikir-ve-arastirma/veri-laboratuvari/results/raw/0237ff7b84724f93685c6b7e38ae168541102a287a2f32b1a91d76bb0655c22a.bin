ll,"hasAnalytics":null,"analyticsElementName":null,"analyticsElementTitle":null,"analyticsUiElementType":null,"icon":null,"media":null,"file":null,"hasAmplitude":null,"sys":{"__typename":"Sys","id":"tHDSONVhPSmaOIiOxb8b6","publishedAt":"2026-08-29T10:17:38.396Z","firstPublishedAt":"2025-05-28T02:58:00.894Z"}},{"__typename":"Link","target":null,"title":"Company Search","url":"https://www.zoominfo.com/companies-search","hidden":null,"hasAnalytics":null,"analyticsElementName":null,"analyticsElementTitle":null,"analyticsUiElementType":null,"icon":null,"media":null,"file":null,"hasAmplitude":null,"sys":{"__typename":"Sys","id":"YBXad304q143NQUVLIq8G","publishedAt":"2026-08-29T10:17:42.764Z","firstPublishedAt":"2025-05-28T02:58:01.254Z"}}]},"button":null,"image":{"__typename":"Asset","title":"directories-illlo-1","description":"","contentType":"image/svg+xml","fileName":"directories-illlo-1.svg","size":188258,"url":"https://images.ctfassets.net/kyld7105l6mt/eO2bupyD5TkACzUW10hTQ/781bc8f57a0c5e91b743e56651c2d337/directories-illlo-1.svg","width":920,"height":314,"sys":{"__typename":"Sys","id":"eO2bupyD5TkACzUW10hTQ","publishedAt":"2025-05-28T02:56:43.293Z","firstPublishedAt":"2025-05-28T02:56:43.293Z"}},"padding":"page-pt-pb","sys":{"__typename":"Sys","id":"Ka8NWMy7OUju15WSbwbcW","publishedAt":"2026-08-29T03:19:19.428Z","firstPublishedAt":"2025-05-28T03:02:30.651Z"}},{"__typename":"SectionFaqAccordion","title":"FAQs","label":null,"subtitle":null,"view":"centered","titleLeftAligned":null,"links":{"__typename":"SectionFaqAccordionLinksCollection","total":0,"items":[]},"faqs":{"__typename":"SectionFaqAccordionFaqsCollection","total":9,"items":[{"__typename":"Faq","question":"What is Zoominfo?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://pipeline.zoominfo.com/sales/what-is-zoominfo"},"content":[{"data":{},"marks":[],"value":"ZoomInfo","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" is a go-to-market platform that helps B2B companies identify, connect with, and close their ideal customers through access to business contact data, intent signals, and sales automation tools.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"7JYArCYd5dnP3JXjLFlhd6","publishedAt":"2026-08-29T18:57:44.519Z","firstPublishedAt":"2025-08-08T15:44:50.910Z"}},{"__typename":"Faq","question":"Who uses ZoomInfo?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Sales, marketing, recruiting, and RevOps teams at companies of all sizes use ZoomInfo to accelerate pipeline generation and revenue growth.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"2e23yjdPzRXhR5KDVqCnEF","publishedAt":"2026-08-29T18:57:50.107Z","firstPublishedAt":"2025-08-08T15:45:32.478Z"}},{"__typename":"Faq","question":"Is ZoomInfo an AI-powered platform?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Absolutely. ZoomInfo is not just a contact database - it is an ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"AI-powered Go-to-Market (GTM) Intelligence Platform","nodeType":"text"},{"data":{},"marks":[],"value":" that brings together company and contact data, buying intent signals, and workflow automation. \nWith innovations like ZoomInfo Copilot and GTM Studio, we apply generative AI and machine learning to every stage of the customer journey. This means your teams can uncover hidden opportunities, prioritize accounts more effectively, and personalize outreach at scale - all from one integrated platform.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"7cUsnoV8WgPTgadcThbgOZ","publishedAt":"2026-08-29T18:57:56.078Z","firstPublishedAt":"2025-09-08T10:04:16.721Z"}},{"__typename":"Faq","question":"How does ZoomInfo get its data?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo gathers ","nodeType":"text"},{"data":{"uri":"https://pipeline.zoominfo.com/sales/how-does-zoominfo-get-data"},"content":[{"data":{},"marks":[],"value":"data","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" through proprietary technology, machine learning, public sources, and a contributory network to ensure accuracy and freshness.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"55JBqw13iKQMggXbCBMtLU","publishedAt":"2026-08-29T18:58:01.639Z","firstPublishedAt":"2025-08-08T15:45:56.723Z"}},{"__typename":"Faq","question":"How is ZoomInfo different from other GTM or AI tools?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Many AI tools are point solutions - they focus on one slice of the workflow, like writing emails or analyzing intent data. ZoomInfo is different: it combines the ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"world’s most accurate and comprehensive B2B data","nodeType":"text"},{"data":{},"marks":[],"value":" with ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"AI-driven intelligence and automation","nodeType":"text"},{"data":{},"marks":[],"value":". That means you get:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Unmatched depth of data","nodeType":"text"},{"data":{},"marks":[],"value":": Millions of verified contacts, companies, and technologies tracked globally.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Real-time insights","nodeType":"text"},{"data":{},"marks":[],"value":": AI monitors signals such as buying intent, executive moves, and market activity.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Seamless execution","nodeType":"text"},{"data":{},"marks":[],"value":": Our AI doesn’t just analyze - it automates workflows inside your CRM, sales engagement tools, and marketing platforms.\n The result? One unified GTM system that drives pipeline growth faster than disconnected point solutions.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"6LDIGHd5QuLYYDiR9QnxL","publishedAt":"2026-08-29T18:58:07.521Z","firstPublishedAt":"2025-09-08T10:04:26.801Z"}},{"__typename":"Faq","question":"Can I try ZoomInfo before buying?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Yes, ZoomInfo offers product demos and ","nodeType":"text"},{"data":{"uri":"https://www.zoominfo.com/free-trial?camp_id=7014y000001e1p9AAA"},"content":[{"data":{},"marks":[],"value":"trial","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" options so you can explore the platform before committing.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"4MhEQ1TGleDiaJnLXpXpcc","publishedAt":"2026-08-29T18:58:13.128Z","firstPublishedAt":"2026-07-08T18:27:04.100Z"}},{"__typename":"Faq","question":"Is ZoomInfo GDPR and CCPA compliant?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Yes, ZoomInfo complies with applicable data privacy regulations, including ","nodeType":"text"},{"data":{"uri":"https://pipeline.zoominfo.com/sales/gdpr-compliance-guide"},"content":[{"data":{},"marks":[],"value":"GDPR and CCPA","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", and provides tools for users to manage their data preferences.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"x17GwkqefD9oAe7xKEdPV","publishedAt":"2026-08-29T18:58:18.897Z","firstPublishedAt":"2026-07-08T18:27:28.646Z"}},{"__typename":"Faq","question":"How does ZoomInfo’s AI solutions helps GTM teams every day?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo’s AI solutions are designed to work in the background so your teams can focus on closing deals. Every day, our AI tools:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Prioritize high-value accounts","nodeType":"text"},{"data":{},"marks":[],"value":" by analyzing intent signals, funding events, technology adoption, and market activity.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Uncover buying committees","nodeType":"text"},{"data":{},"marks":[],"value":" so you know exactly who is involved in purchase decisions, not just a single contact.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Generate insights instantly","nodeType":"text"},{"data":{},"marks":[],"value":", such as account summaries, competitor landscapes, or industry trends.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Automate personalization","nodeType":"text"},{"data":{},"marks":[],"value":" by drafting outreach emails, meeting prep notes, and playbook-based recommendations in seconds.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Alert you in real time","nodeType":"text"},{"data":{},"marks":[],"value":" when prospects change jobs, raise funding, or show intent to purchase — so your team never misses the right moment to engage.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"3h2HAgjSy3zzkvNv653nNc","publishedAt":"2026-08-29T18:58:24.702Z","firstPublishedAt":"2026-07-08T18:27:48.495Z"}},{"__typename":"Faq","question":"Can the AI solutions in ZoomInfo integrate with our existing CRM and sales tools?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Yes. ZoomInfo’s AI solutions are built to work seamlessly with the tools your teams already use every day. \nWhether it’s Salesforce, HubSpot, Outreach, Salesloft, Marketo, or dozens of other CRM and marketing platforms, our AI solutions plug directly into your existing workflows. That means AI-powered recommendations, prospect alerts, automated enrichment, and personalized outreach appear right where your sales and marketing teams are already working - no extra logins, no steep learning curve. ZoomInfo makes it easy for GTM teams to scale smarter, move faster, and get measurable results without changing the way they work.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"3BBiKsie5TQ5430VhEuggG","publishedAt":"2026-08-29T18:58:30.424Z","firstPublishedAt":"2026-07-08T18:28:07.228Z"}}]},"padding":"page-pt-pb","backgroundColorOptions":{"__typename":"BackgroundColor","backgroundColor":"neutral-0-bg"},"sys":{"__typename":"Sys","id":"7eRqHjJ6QuYRiZRgwxQ3U","publishedAt":"2026-08-29T03:18:24.296Z","firstPublishedAt":"2025-08-08T15:47:09.625Z"}}]},"seo":{"__typename":"Seo","proSchemasManual":{"@graph":[{"@id":"https://www.zoominfo.com/#website","url":"https://www.zoominfo.com/","name":"ZoomInfo: The GTM Platform","@type":"WebSite","publisher":{"@id":"https://www.zoominfo.com/#organization"},"alternateName":["ZoomInfo Technologies","ZoomInfo Technologies Inc","ZoomInfo LLC"]},{"@id":"https://www.zoominfo.com/#organization","url":"https://www.zoominfo.com/","logo":"https://www.zoominfo.com/_next/static/media/zoominfo-red-logomark.253353d3.svg","name":"ZoomInfo Inc","@type":"Organization","sameAs":["https://www.linkedin.com/company/zoominfo/","https://www.instagram.com/zoominfo/","https://www.facebook.com/ZoomInformation/","https://www.youtube.com/c/zoominformation"],"address":{"@type":"PostalAddress","addressRegion":"Washington","addressCoun