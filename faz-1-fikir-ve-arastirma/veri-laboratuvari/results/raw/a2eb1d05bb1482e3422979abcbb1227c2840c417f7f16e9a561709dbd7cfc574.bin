llection\":\"DHMM88JNh\",\"name\":\"rex1cX_Tv\",\"type\":\"Identifier\"},{\"collection\":\"DHMM88JNh\",\"name\":\"yqsyB4Tls\",\"type\":\"Identifier\"},{\"collection\":\"DHMM88JNh\",\"name\":\"id\",\"type\":\"Identifier\"}]}default",[44],{"dFlboghD8":45,"BGapa39Lt":48,"OzHIXT6SH":50,"ZjU3G1zag":52,"rex1cX_Tv":54,"yqsyB4Tls":56,"id":58},{"type":6,"value":46},{"src":47,"pixelWidth":9,"pixelHeight":9},"https://framerusercontent.com/images/9tKKWHoWpyfjoeteW0yYHEHlVTE.jpeg?width=200&height=200",{"type":12,"value":49},"Infracost FinOps policies are a no-brainer as they put the right level of information into the hands of the right people at the right time. This enables our engineers and FinOps practitioners to focus on delivering higher value to the business instead of spending time on re-work and toil.",{"type":12,"value":51},"Guil Dametto",{"type":12,"value":53},"Director of Cloud Engineering",{"type":12,"value":55},"SafeFleet",{"type":12,"value":57},"priya-naik",{"type":12,"value":59},"GZr_GO0uD","{\"from\":\"fe8ed84f-0709-4916-8a58-3f71772ea231\",\"limit\":{\"type\":\"LiteralValue\",\"value\":1},\"select\":[{\"collection\":\"zejLlOeLn\",\"name\":\"dFlboghD8\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"BGapa39Lt\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"OzHIXT6SH\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"ZjU3G1zag\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"rex1cX_Tv\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"yqsyB4Tls\",\"type\":\"Identifier\"},{\"collection\":\"zejLlOeLn\",\"name\":\"id\",\"type\":\"Identifier\"}]}default",[62],{"dFlboghD8":45,"BGapa39Lt":48,"OzHIXT6SH":50,"ZjU3G1zag":52,"rex1cX_Tv":54,"yqsyB4Tls":56,"id":58},"{\"from\":\"fe8ed84f-0709-4916-8a58-3f71772ea231\",\"limit\":{\"type\":\"LiteralValue\",\"value\":1},\"offset\":{\"type\":\"LiteralValue\",\"value\":1},\"select\":[{\"collection\":\"RD9yaflyd\",\"name\":\"dFlboghD8\",\"type