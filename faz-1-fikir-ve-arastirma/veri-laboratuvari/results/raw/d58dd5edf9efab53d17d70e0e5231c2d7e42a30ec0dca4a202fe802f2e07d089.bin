<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YXQPCCLXHM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YXQPCCLXHM');
  </script>

  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="Toolify.io gives Microsoft clients & consultants a defensible view of Windows Server, SQL Server & M365 licensing, before renewal, in a matter of hours."/>
  <meta name="keywords" content="Microsoft licensing assessment, Windows Server licensing, SQL Server licensing, Microsoft 365 licensing, M365 license optimization, EA renewal, CSP, NCE, license compliance"/>
  <meta name="robots" content="index, follow"/>
  <link rel="canonical" href="https://toolify.io"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="https://toolify.io"/>
  <meta property="og:title" content="Toolify: Microsoft Licensing Intelligence"/>
  <meta property="og:description" content="A complete, defensible view of every Microsoft license. Server. Cloud. M365. Before the renewal conversation starts."/>
  <meta property="og:site_name" content="Toolify.io"/>
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:title" content="Toolify: Microsoft Licensing Intelligence"/>
  <meta name="twitter:description" content="A complete, defensible view of every Microsoft license. Server. Cloud. M365."/>
<link rel="icon" type="image/png" href="https://toolify.io/icon-toolify.png"/>
<link rel="apple-touch-icon" href="https://toolify.io/icon-toolify.png"/>
  <title>Toolify.io: Microsoft Licensing Intelligence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    :root {
      --bg:        #0f1a1b;
      --surface:   #141f20;
      --surface-2: rgba(255,255,255,0.03);
      --border:    rgba(61,122,128,0.18);
      --border-2:  rgba(61,122,128,0.4);
      --teal:      #3D7A80;
      --teal-light:#86CCE0;
      --text:      #f0f5f5;
      --text-m:    rgba(240,245,245,0.65);
      --text-f:    rgba(240,245,245,0.4);
      --amber:     #F4A825;
      --purple:    #7B5EA7;
      --purple-l:  #C4A8F0;
      --linen:     #f2ebe1;
    }

    body {
      font-family: 'DM Sans', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── NAV ───────────────────────────────────────────────────────────────── */
    nav {
      position: sticky; top: 0; z-index: 100;
      backdrop-filter: blur(14px);
      background: rgba(15,26,27,0.88);
      border-bottom: 0.5px solid var(--border);
    }
    .nav-inner {
      max-width: 1140px; margin: 0 auto;
      padding: 0 2rem; height: 62px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }

    /* ── MODULE SWITCHER ───────────────────────────────────────────────────── */
    .module-switcher { position: relative; }
    .module-switcher-trigger {
      display: flex; align-items: center; gap: 8px;
      background: none; border: none; padding: 0; margin: 0;
      cursor: pointer; font: inherit; color: inherit;
    }
    .module-switcher-chevron-wrap {
      width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
      background: rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.15s;
    }
    .module-switcher.open .module-switcher-chevron-wrap { transform: rotate(180deg); }
    .module-switcher-panel {
      display: none;
      position: absolute; top: calc(100% + 12px); left: 0;
      width: 300px;
      background: rgba(17,26,27,0.98);
      backdrop-filter: blur(14px);
      border: 0.5px solid rgba(255,255,255,0.12);
      border-radius: 12px;
      z-index: 200;
      box-shadow: 0 16px 40px rgba(0,0,0,0.5);
      padding: 6px;
    }
    .module-switcher.open .module-switcher-panel { display: block; }
    .module-switcher-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 10px; border-radius: 8px;
      text-decoration: none; cursor: pointer;
      transition: background 0.12s;
    }
    a.module-switcher-row:hover { background: rgba(255,255,255,0.06); }
    .module-switcher-row.is-current { background: rgba(61,122,128,0.16); cursor: default; }
    .module-switcher-row-icon { flex-shrink: 0; display: flex; }
    .module-switcher-row-text { flex: 1; min-width: 0; line-height: 1.5; }
    .module-switcher-row-name { font-size: 13px; font-weight: 500; color: rgba(240,245,245,0.92); }
    .module-switcher-row-sep { color: rgba(240,245,245,0.4); font-size: 11px; margin: 0 6px; }
    .module-switcher-row-tag { font-size: 11px; color: rgba(240,245,245,0.6); line-height: 1.3; }
    .module-switcher-row-check { flex-shrink: 0; font-size: 11px; color: #86CCE0; }
    .module-switcher-row-arrow { flex-shrink: 0; font-size: 11px; color: rgba(240,245,245,0.4); }
    .module-switcher-divider { height: 0.5px; background: rgba(255,255,255,0.1); margin: 5px 6px; }
    .module-switcher-row.is-soon { opacity: 0.4; cursor: default; }
    .module-switcher-row-soon {
      flex-shrink: 0; font-size: 9px; font-weight: 600; padding: 2px 7px; border-radius: 4px;
      background: rgba(255,255,255,0.07); color: rgba(240,245,245,0.4);
      letter-spacing: 0.03em; text-transform: uppercase;
    }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .nav-link {
      font-size: 13px; font-weight: 400;
      color: rgba(240,245,245,0.95); text-decoration: none;
      padding: 7px 14px; border-radius: 8px;
      transition: color 0.15s, background 0.15s;
    }
    .nav-link:hover { color: rgba(240,245,245,0.95); background: rgba(255,255,255,0.04); }
    .nav-login {
      font-size: 13px; font-weight: 500;
      color: rgba(240,245,245,0.95); text-decoration: none;
      padding: 8px 18px; border-radius: 9px;
      border: 0.5px solid rgba(61,122,128,0.45);
      transition: background 0.15s, border-color 0.15s;
    }
    .nav-login:hover { background: rgba(61,122,128,0.1); border-color: rgba(61,122,128,0.7); }
    .nav-demo {
      font-size: 13px; font-weight: 600;
      color: #fff; text-decoration: none;
      padding: 9px 20px; border-radius: 9px;
      background: var(--teal);
      border: none;
      box-shadow: 0 4px 16px rgba(61,122,128,0.4);
      transition: background 0.15s, transform 0.1s;
    }
    .nav-demo:hover { background: #2d5f65; transform: translateY(-1px); }

    /* ── BURGER + MOBILE PANEL ─────────────────────────────────────────────── */
    .nav-burger {
      display: none; flex-direction: column; gap: 4px;
      background: none; border: none; cursor: pointer; padding: 6px;
    }
    .nav-burger span {
      display: block; width: 20px; height: 1.5px;
      background: rgba(240,245,245,0.85); border-radius: 2px; transition: all .2s;
    }
    .nav-burger.open span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
    .nav-burger.open span:nth-child(2) { opacity: 0; }
    .nav-burger.open span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

    .nav-mob-panel {
      display: none;
      position: fixed; top: 62px; left: 0; right: 0;
      background: rgba(15,26,27,0.98);
      backdrop-filter: blur(12px);
      flex-direction: column;
      padding: 20px 1.25rem 28px;
      border-bottom: 0.5px solid var(--border);
      z-index: 99;
      max-height: calc(100vh - 62px);
      overflow-y: auto;
    }
    .nav-mob-panel.open { display: flex; }
    .nav-mob-panel a.nav-link {
      width: 100%; padding: 13px 0;
      border-bottom: 0.5px solid var(--border);
      font-size: 15px; color: var(--text);
    }
    .nav-mob-products-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: rgba(240,245,245,0.45);
      padding: 16px 0 6px; width: 100%;
    }
    .nav-mob-product-link {
      display: flex; align-items: center; gap: 10px;
      font-size: 14px; color: var(--text);
      padding: 9px 0; width: 100%; text-decoration: none;
    }
    .nav-mob-product-icon {
      width: 22px; height: 22px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .nav-mob-product-sep { color: rgba(240,245,245,0.4); font-style: normal; }
    .nav-mob-product-sub {
      font-style: italic; font-size: 13px;
      color: rgba(134,204,224,0.6);
    }
    .nav-mob-cta {
      background: var(--teal); color: #fff; border-radius: 8px;
      padding: 11px 0; font-size: 14px; font-weight: 600;
      font-family: 'DM Sans', sans-serif; text-decoration: none;
      margin-top: 16px; display: flex; justify-content: center; align-items: center;
      transition: background 0.15s;
    }
    .nav-mob-cta:hover { background: #2d5f65; }
    .nav-mob-snapshot {
      background: transparent; color: #C4A8F0;
      border: 0.5px solid rgba(123,94,167,0.5); border-radius: 8px;
      padding: 11px 0; font-size: 14px; font-weight: 600;
      font-family: 'DM Sans', sans-serif; text-decoration: none;
      margin-top: 8px; display: flex; justify-content: center; align-items: center;
      transition: background 0.15s, border-color 0.15s;
    }
    .nav-mob-snapshot:hover { background: rgba(123,94,167,0.1); border-color: rgba(123,94,167,0.8); }

    /* ── HERO ──────────────────────────────────────────────────────────────── */
    .hero-wrap {
      position: relative; overflow: hidden;
      padding: 0 1.25rem;
    }
    .hero-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(61,122,128,0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(61,122,128,0.07) 1px, transparent 1px);
      background-size: 52px 52px;
      pointer-events: none;
    }
    .hero-glow {
      position: absolute;
      width: 900px; height: 600px;
      background: radial-gradient(ellipse, rgba(61,122,128,0.13) 0%, transparent 68%);
      top: -120px; left: 50%; transform: translateX(-50%);
      pointer-events: none;
    }
    .hero-inner {
      position: relative; z-index: 1;
      max-width: 1140px; margin: 0 auto;
      padding: 62px 0 80px;
      display: grid; grid-template-columns: 3fr 2fr;
      gap: 40px; align-items: center;
      text-align: left;
    }
    .hero-left { text-align: left; }
    .hero-right {
      position: relative;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(61,122,128,0.3);
      border-radius: 14px;
      padding: 32px 32px 64px;
      min-height: 400px;
      text-align: left;
    }
    .hero-right-tag { position: absolute; top: 16px; right: 16px; }
    .hero-right-more {
      font-size: 14px; color: rgba(240,245,245,0.65);
      text-align: left;
      position: absolute; left: 32px; right: 32px; bottom: 24px;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(61,122,128,0.15);
      border: 1px solid rgba(61,122,128,0.3);
      border-radius: 100px; padding: 5px 14px;
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--teal-light);
      margin-bottom: 28px;
    }
    .badge-dot {
      width: 6px; height: 6px;
      background: var(--teal-light); border-radius: 50%;
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }

    .hero-inner h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(34px, 4vw, 44px);
      font-weight: 300; line-height: 1.28;
      letter-spacing: -0.02em;
      color: #f0f5f5;
      margin-bottom: 24px;
    }
    .hero-inner h1 em { font-style: italic; color: var(--teal-light); }

    .hero-sub {
      font-size: 17px; font-weight: 300;
      color: var(--text-m); line-height: 1.75;
      max-width: 560px; margin: 0 0 44px;
    }

    .hero-cta {
      display: flex; align-items: center; justify-content: flex-start;
      gap: 14px; flex-wrap: wrap;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 15px; font-weight: 600;
      background: var(--teal); color: #fff;
      padding: 14px 28px; border-radius: 10px;
      border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 8px 32px rgba(61,122,128,0.4);
      transition: background 0.15s, transform 0.12s;
    }
    .btn-primary:hover { background: #2d5f65; transform: translateY(-2px); }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 15px; font-weight: 500;
      color: rgba(240,245,245,0.75); text-decoration: none;
      padding: 14px 22px; border-radius: 10px;
      border: 0.5px solid rgba(255,255,255,0.1);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .btn-ghost:hover { color: var(--text); border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.04); }

    .hero-trust {
      margin-top: 28px;
      font-size: 12px; color: var(--text-f);
      display: flex; align-items: center; justify-content: center; gap: 18px;
      flex-wrap: wrap;
    }
    .hero-trust-sep { width: 1px; height: 12px; background: rgba(255,255,255,0.12); }

    /* ── DIVIDER ───────────────────────────────────────────────────────────── */
    .divider {
      height: 0.5px;
      background: linear-gradient(90deg, transparent, var(--border-2), transparent);
      max-width: 1140px; margin: 0 auto;
    }


    /* ── SECTION COMMON ────────────────────────────────────────────────────── */
    .section { padding: 96px 2rem; }
    .section-inner { max-width: 1140px; margin: 0 auto; }

    .section-label {
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--teal); margin-bottom: 16px;
    }
    .section-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(32px, 3.5vw, 36px);
      font-weight: 300; line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--text); margin-bottom: 16px;
    }
    .section-title em { font-style: italic; color: var(--teal-light); }
    .section-sub {
      font-size: 16px; font-weight: 300;
      color: var(--text-m); line-height: 1.75;
      max-width: 615px;
    }

    /* ── PROBLEM ───────────────────────────────────────────────────────────── */
    .problem { background: #f5ede3; }
    .problem .section-label { color: #5a4030; }
    .problem .section-title { color: #1a1208; }
    .problem .section-title em { color: #8B6914; font-style: italic; }
    .problem .section-sub { color: rgba(30,18,6,0.65); }

    /* ── TEAM / ABOUT (light, SOLAR-style card treatment) ────────────────────── */
    .team { background: #F2F5F2; }
    .team .section-label { color: #3D7A80; }
    .team .section-title { color: #1A2B2C; }
    .team .section-title em { color: #3D7A80; font-style: italic; }
    .team .section-sub { color: #4a6a6a; }
    .team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .team-founders {
      background: #fff; border: 0.5px solid rgba(61,122,128,0.18);
      border-radius: 16px; overflow: hidden;
      display: flex; flex-direction: column;
    }
    .team-founder { padding: 28px 32px; display: flex; gap: 16px; align-items: flex-start; }
    .team-founder + .team-founder { border-top: 0.5px solid rgba(61,122,128,0.15); }
    .team-avatar {
      width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
      background: rgba(61,122,128,0.12); border: 0.5px solid rgba(61,122,128,0.4);
      display: flex; align-items: center; justify-content: center;
      font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600; color: #3D7A80;
    }
    .team-name { font-size: 15px; font-weight: 600; color: #1A2B2C; margin-bottom: 2px; }
    .team-linkedin {
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      margin-left: auto; opacity: 0.85; transition: opacity 0.15s;
    }
    .team-linkedin:hover { opacity: 1; }
    .team-quote {
      border-left: 2px solid #3D7A80; border-radius: 0;
      padding: 4px 0 4px 18px; margin-top: 20px;
    }
    .team-quote-text {
      font-family: 'Fraunces', serif; font-style: italic; font-weight: 300;
      font-size: 19px; line-height: 1.4; color: #1A2B2C;
    }
    .team-role { font-size: 12px; color: #7a9a9a; margin-bottom: 10px; }
    .team-bio { font-size: 14px; color: #4a6a6a; line-height: 1.65; }

    .problem-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: start;
    }

    .problem-points { margin-top: 36px; display: flex; flex-direction: column; gap: 0; }
    .problem-point {
      display: flex; gap: 20px;
      padding: 20px 22px;
      border-bottom: 0.5px solid rgba(30,18,6,0.08);
    }
    .problem-point:first-child { border-top: 0.5px solid rgba(30,18,6,0.08); }
    .pp-num {
      font-family: 'DM Mono', monospace;
      font-size: 20px; color: rgba(30,18,6,0.4);
      margin-top: 2px; flex-shrink: 0; width: 32px;
    }
    .pp-text { flex: 1; }
    .pp-title { font-size: 16px; font-weight: 500; color: #1a1208; margin-bottom: 4px; }
    .pp-body { font-size: 14px; color: rgba(30,18,6,0.6); line-height: 1.6; }

    .problem-right { padding-top: 4px; }
    .insight-cards { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
    .insight-card {
      background: #fff;
      border: 0.5px solid rgba(30,18,6,0.1);
      border-radius: 12px; padding: 20px 22px;
    }
    .insight-card-num {
      font-family: 'Fraunces', serif;
      font-size: 28px; font-weight: 300;
      color: #8B6914; line-height: 1; margin-bottom: 4px;
    }
    .pstat-cell { padding: 16px 12px 0 12px; text-align: center; }
    .pstat-cell:first-child { padding-left: 0; }
    .pstat-cell:last-child { padding-right: 0; }
    .pstat-label { font-size: 11px; color: rgba(30,18,6,0.5); line-height: 1.5; margin-top: 4px; }
    .insight-card-label { font-size: 13px; color: rgba(30,18,6,0.6); line-height: 1.5; }
    .insight-footnote {
      font-size: 11px; color: rgba(30,18,6,0.4);
      margin-top: 20px; line-height: 1.6;
    }

    /* ── PRODUCTS ──────────────────────────────────────────────────────────── */
    .products { background: var(--bg); }
    .products-header { margin-bottom: 56px; }

    .product-row {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 48px; align-items: center;
      padding: 56px 0;
      border-top: 0.5px solid var(--border);
    }
    .product-row:last-of-type { border-bottom: 0.5px solid var(--border); }
    .product-row.reverse { direction: rtl; }
    .product-row.reverse > * { direction: ltr; }

    .product-text { display: flex; flex-direction: column; gap: 0; }
    .product-icon-row {
      display: flex; align-items: center; gap: 14px;
      margin-bottom: 20px;
    }
    .product-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .product-icon.solar { background: #F4A825; }
    .product-icon.t365  { background: var(--purple); }
    .product-name {
      font-family: 'Fraunces', serif;
      font-size: 22px; font-weight: 300;
      color: var(--text); letter-spacing: -0.01em;
    }
    .product-tagline {
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--teal); margin-top: 2px;
    }

    .product-text h3 {
      font-family: 'Fraunces', serif;
      font-size: clamp(26px, 2.2vw, 32px);
      font-weight: 300; line-height: 1.25;
      letter-spacing: -0.02em;
      color: var(--text); margin-bottom: 16px;
    }
    .product-text h3 em { font-style: italic; color: var(--teal-light); }
    .product-desc {
      font-size: 15px; font-weight: 300;
      color: var(--text-m); line-height: 1.75;
      margin-bottom: 24px;
    }

    .product-features { display: flex; flex-direction: column; gap: 9px; margin-bottom: 28px; }
    .product-feature {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 14px; color: var(--text-m); line-height: 1.5;
    }
    .feature-check {
      width: 16px; height: 16px; border-radius: 50%;
      background: rgba(61,122,128,0.15);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .feature-check svg { display: block; }

    .product-link {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 13px; font-weight: 500; text-decoration: none;
      transition: gap 0.15s;
    }
    .product-link.solar { color: var(--amber); }
    .product-link.t365  { color: var(--purple-l); }
    .product-link:hover { gap: 11px; }

    /* Product visual panel */
    .product-visual {
      background: rgba(255,255,255,0.02);
      border: 0.5px solid var(--border-2);
      border-radius: 16px; overflow: hidden;
      box-shadow: 0 24px 64px rgba(0,0,0,0.4);
    }
    .pv-bar {
      background: rgba(255,255,255,0.025);
      border-bottom: 0.5px solid var(--border);
      padding: 10px 14px; display: flex; align-items: center; gap: 7px;
    }
    .pv-dot { width: 9px; height: 9px; border-radius: 50%; }
    .pv-body { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
    .pv-row { display: flex; justify-content: space-between; align-items: center; }
    .pv-label { font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: var(--text-f); }
    .pv-val { font-family: 'DM Mono', monospace; font-size: 13px; font-weight: 500; }
    .pv-bar-row { display: flex; gap: 8px; align-items: center; }
    .pv-track { flex: 1; height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; }
    .pv-fill { height: 100%; border-radius: 2px; }
    .pv-pct { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--text-f); width: 28px; text-align: right; }
    .pv-divider { height: 0.5px; background: var(--border); margin: 4px 0; }
    .pv-metric { background: rgba(255,255,255,0.02); border: 0.5px solid var(--border); border-radius: 8px; padding: 12px 14px; }
    .pv-metric-num { font-family: 'DM Mono', monospace; font-size: 22px; font-weight: 500; line-height: 1; margin-bottom: 3px; }
    .pv-metric-lbl { font-size: 10px; color: var(--text-f); }
    .pv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pv-tag {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 10px; font-weight: 600;
      padding: 3px 8px; border-radius: 4px;
    }

    /* ── ROADMAP ───────────────────────────────────────────────────────────── */
    .roadmap {
      background: var(--surface);
      border-top: 0.5px solid var(--border);
      border-bottom: 0.5px solid var(--border);
    }
    .roadmap-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 16px; margin-top: 48px;
    }
    .roadmap-card {
      background: rgba(255,255,255,0.02);
      border: 0.5px solid var(--border);
      border-radius: 14px; padding: 28px;
      display: flex; flex-direction: column; gap: 14px;
      opacity: 0.6;
    }
    .roadmap-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .roadmap-icon.arcus { background: rgba(0,120,212,0.2); }
    .roadmap-icon.bom   { background: rgba(196,92,58,0.2); }
    .roadmap-name { font-size: 17px; font-weight: 500; color: var(--text); }
    .roadmap-desc { font-size: 14px; color: var(--text-m); line-height: 1.65; }
    .roadmap-soon {
      display: inline-flex; align-self: flex-start;
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 3px 10px; border-radius: 4px;
      background: rgba(255,255,255,0.06);
      color: var(--text-f);
    }

    /* ── BLOG ──────────────────────────────────────────────────────────────── */
    .blog-section { background: #f5ede3; padding: 100px 2rem; }
    .blog-section .section-label { color: #5a4030; }
    .blog-section .section-title { color: #1a1208; }
    .blog-section .section-title em { color: #8B6914; font-style: italic; }
    .blog-card {
      display: flex; gap: 36px; align-items: stretch;
      border: 0.5px solid rgba(30,18,6,0.1); border-radius: 14px;
      overflow: hidden; background: #fff;
      margin-top: 48px;
      text-decoration: none; color: inherit;
      transition: border-color 0.15s, background 0.15s;
    }
    .blog-card:hover { border-color: rgba(30,18,6,0.2); background: #fdfaf6; }
    .blog-card-visual {
      flex: 0 0 260px; width: 260px;
      background: url('/images/Blog_Windows_Server_ESU_update_400x400.webp') center/cover no-repeat;
      position: relative;
    }
    .blog-card-visual::before {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(30,18,6,0.1), rgba(30,18,6,0));
    }
    .blog-card-body { flex: 1; padding: 36px 40px 36px 0; display: flex; flex-direction: column; justify-content: center; }
    .blog-tag {
      display: inline-flex; align-self: flex-start;
      font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: #a33d1d; background: rgba(163,61,29,0.1);
      padding: 4px 10px; border-radius: 5px; margin-bottom: 14px;
    }
    .blog-title { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 400; color: #1a1208; margin: 0 0 10px; line-height: 1.3; }
    .blog-excerpt { font-size: 14px; color: rgba(30,18,6,0.7); line-height: 1.65; margin: 0 0 18px; }
    .blog-meta-row { display: flex; align-items: center; gap: 16px; }
    .blog-read-link { font-size: 14px; font-weight: 600; color: #8B6914; text-decoration: none; }
    .blog-meta { font-size: 12px; color: rgba(30,18,6,0.6); }
    @media (max-width: 768px) {
      .blog-card { flex-direction: column; }
      .blog-card-visual { width: 100%; height: 170px; flex-basis: auto; }
      .blog-card-body { padding: 24px; }
    }

    /* ── CTA ───────────────────────────────────────────────────────────────── */
    .cta-section {
      position: relative; overflow: hidden;
      padding: 100px 2rem; background: #12181a; border-top: 0.5px solid var(--border);
    }
    .cta-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(61,122,128,0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(61,122,128,0.07) 1px, transparent 1px);
      background-size: 52px 52px;
      pointer-events: none;
    }
    .cta-glow {
      position: absolute;
      width: 900px; height: 600px;
      background: radial-gradient(ellipse, rgba(61,122,128,0.13) 0%, transparent 68%);
      top: -120px; left: 50%; transform: translateX(-50%);
      pointer-events: none;
    }
    .cta-inner {
      max-width: 780px; margin: 0 auto;
      text-align: center;
    }
    .cta-inner h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(30px, 4vw, 44px);
      font-weight: 300; line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--text); margin-bottom: 20px;
    }
    .cta-inner h2 em { font-style: italic; color: var(--teal-light); }
    .cta-sub {
      font-size: 16px; font-weight: 300;
      color: var(--text-m); line-height: 1.7;
      margin-bottom: 40px;
    }
    .cta-note { font-size: 12px; color: var(--text-f); margin-top: 16px; }

    /* ── FOOTER ────────────────────────────────────────────────────────────── */
    footer {
      border-top: 0.5px solid var(--border);
      padding: 28px 2rem;
    }
    @media (min-width: 769px) {
      footer { padding-right: 150px; }
    }
    .footer-inner {
      max-width: 1140px; margin: 0 auto;
      display: flex; align-items: center;
      justify-content: space-between; flex-wrap: wrap; gap: 12px;
    }
    .footer-inner p { font-size: 12px; color: var(--text-f); }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a {
      font-size: 12px; color: var(--text-f);
      text-decoration: none; transition: color 0.15s;
    }
    .footer-links a:hover { color: var(--text-m); }

    /* ── RESPONSIVE ────────────────────────────────────────────────────────── */

    .nowrap-title { white-space: nowrap; }
    .desktop-br { display: inline; }
    @media (max-width: 768px) { .desktop-br { display: none; } }
    .mobile-only-br { display: none; }
    @media (max-width: 640px) { .mobile-only-br { display: inline; } }

    /* ── TABLET 640–1024px ─────────────────────────────────────────────────── */
    @media (max-width: 1024px) {
      .problem-grid { gap: 48px; }
      .product-row { gap: 32px; }
    }

    /* ── SMALL TABLET / LARGE MOBILE 768px ─────────────────────────────────── */
    @media (max-width: 768px) {
      .problem-grid { grid-template-columns: 1fr; }
      .team-grid { grid-template-columns: 1fr; gap: 32px; }
      .product-row { grid-template-columns: 1fr; gap: 36px; }
      .product-row.reverse { direction: ltr; }
      .roadmap-grid { grid-template-columns: 1fr; }
      .nav-right .nav-link { display: none; }
      .hero-inner { grid-template-columns: 1fr; text-align: center; }
      .hero-left { text-align: center; }
      .hero-sub { margin: 0 auto 44px; }
      .hero-cta { justify-content: center; }
      .hero-inner h1 { font-size: clamp(32px, 6vw, 48px); }
      .section-title { font-size: clamp(24px, 4vw, 32px); }
      .product-text h3 { font-size: clamp(20px, 3.5vw, 26px); }
      .nowrap-title { white-space: normal !important; }
      .cta-inner h2 { font-size: clamp(28px, 5vw, 38px); }
    }

    /* ── MOBILE < 640px ─────────────────────────────────────────────────────── */
    @media (max-width: 640px) {
      /* Nav */
      .nav-inner { padding: 0 1.25rem; }
      .nav-right { display: none; }
      .nav-burger { display: flex; }

      /* Hero */
      .hero-inner { padding: 36px 0 44px; }
      .hero-right { padding-top: 52px; }
      .hero-inner h1 { font-size: 29px; letter-spacing: -0.01em; }
      .hero-sub { font-size: 14px; max-width: 100% !important; }
      .hero-badge { margin-bottom: 18px; }
      .hero-cta { flex-direction: column; align-items: stretch; }
      .hero-cta .btn-primary,
      .hero-cta .btn-ghost { justify-content: center; }
      .hero-trust { display: none; }
      .hero-trust-sep { display: none; }

      /* Sections */
      .section { padding: 64px 1.25rem; }
      .section-inner { padding: 0; }
      .section-title { font-size: 28px; }
      .product-text h3 { font-size: 28px; }
      .audience-title { font-size: 28px !important; }
      .section-sub { font-size: 14px; }

      /* Problem */
      .problem { padding: 64px 1.25rem; }
      .team-founder { padding: 22px; }

      /* Products */
      .product-row { padding: 40px 0; }
      .product-desc { font-size: 14px; }
      .product-features { gap: 7px; }
      .product-feature { font-size: 13px; }
      .product-visual { display: none; }

      /* Audience */
      .audience-3col { grid-template-columns: 1fr !important; }

      /* CTA */
      .cta-section { padding: 64px 1.25rem; }
      .cta-inner { max-width: 100% !important; }
      .cta-inner h2 { font-size: 28px; white-space: normal !important; }
      .cta-sub { font-size: 14px; }
      .cta-buttons { flex-direction: column; align-items: stretch !important; }
      .cta-buttons a { justify-content: center; }

      /* Problem section stats */
      .problem-stats-grid { grid-template-columns: 1fr 1fr 1fr !important; }
      .pstat-cell { padding: 12px 6px 0 6px !important; }
      .pstat-cell:first-child { padding-left: 0 !important; }
      .pstat-cell:last-child { padding-right: 0 !important; }
      .insight-card-num { font-size: 22px; white-space: nowrap; }
      .pstat-label { font-size: 12px; }

      /* Footer */
      .footer-inner { flex-direction: column; align-items: center; text-align: center; gap: 12px; }
    }

    /* SOLAR icon slow spin — applied via inline style on g element */
    @keyframes solar-spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }
    /* Early access badge shimmer */
    @keyframes shimmer {
      0%   { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    .early-access-badge {
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 4px 12px; border-radius: 100px;
      background: linear-gradient(90deg, rgba(134,204,224,0.15), rgba(61,122,128,0.4), rgba(134,204,224,0.15));
      background-size: 200% auto;
      color: #86CCE0;
      border: 0.5px solid rgba(134,204,224,0.4);
      animation: shimmer 3s linear infinite;
      display: inline-flex; align-items: center; gap: 6px;
    }
  </style>
  <script defer data-domain="toolify.io" src="https://analytics.toolify.io/js/script.js"></script>
</head>
