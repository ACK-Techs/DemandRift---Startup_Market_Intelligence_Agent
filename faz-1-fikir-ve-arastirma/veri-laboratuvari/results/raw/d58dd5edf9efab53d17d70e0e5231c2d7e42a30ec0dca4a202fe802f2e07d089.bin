<style>
.fab-wrap {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 95px;
  height: 52px;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s ease;
}
.fab-wrap.visible {
  opacity: 1;
  pointer-events: all;
}
.fab-circle {
  width: 52px; height: 52px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: absolute;
  outline: 2.5px solid #fff;
  border: none;
  cursor: pointer;
  transition: transform .15s;
  text-decoration: none;
}
.fab-circle:hover { transform: scale(1.08); }
.fab-wa  { background: #25D366; left: 0;  z-index: 2; }
.fab-up  { background: #3D7A80; right: 0; z-index: 1; }
</style>

<script>
(function() {
  var wrap = document.getElementById('fabWrap');
  window.addEventListener('scroll', function() {
    wrap.classList.toggle('visible', window.scrollY > 300);
  });
})();
</script>

<script>
  (function () {
    var burger = document.getElementById('navBurger');
    var panel  = document.getElementById('navMobPanel');
    if (!burger || !panel) return;
    burger.addEventListener('click', function () {
      burger.classList.toggle('open');
      panel.classList.toggle('open');
    });
    panel.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        burger.classList.remove('open');
        panel.classList.remove('open');
      });
    });
  })();
</script>

<script>
  (function () {
    var sw  = document.getElementById('moduleSwitcher');
    var btn = document.getElementById('moduleSwitcherBtn');
    if (!sw || !btn) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      sw.classList.toggle('open');
    });
    document.addEventListener('click', function (e) {
      if (!sw.contains(e.target)) sw.classList.remove('open');
    });
  })();
</script>
</body>
</html>
