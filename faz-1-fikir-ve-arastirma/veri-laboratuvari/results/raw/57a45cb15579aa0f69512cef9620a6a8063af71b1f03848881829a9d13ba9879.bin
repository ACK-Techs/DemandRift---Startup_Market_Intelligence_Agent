        </div>
      </div>

      <h2 id="InstallOptionsHeading" class="tw-text-heading-xl tw-text-center tw-mb-2" data-template="Install __APP_NAME__">Install </h2>
      <p class="tw-mb-6 tw-text-center tw-text-fg-secondary">To install this app you need to create a Shopify account or log in to an existing one and then select a store.</p>
      <div class="tw-flex tw-flex-col tw-gap-4 tw-px-4 md:tw-px-16">
        <a id="InstallOptionsCreateAccountLink" class="tw-block tw-w-full" data-component-name="create-account-to-install-button" href="https://admin.shopify.com/signup?install_app=&amp;locale=en">
