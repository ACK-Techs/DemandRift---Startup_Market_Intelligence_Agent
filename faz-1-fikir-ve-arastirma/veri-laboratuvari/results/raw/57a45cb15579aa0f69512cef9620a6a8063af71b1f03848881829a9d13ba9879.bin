            Create a Shopify account

</button></a>
        <form id="InstallOptionsLoginForm" data-component-name="log-in-install-button" action="/login/initiate_shopify_auth_without_shop" accept-charset="UTF-8" method="post"><input type="hidden" name="authenticity_token" value="fzjowyjdRDtlUUme7McJWavp0jUMw4gjqLB90Qxt9EyJXbfAVBI4VGySIgPLRB89k_fOh1tpSB8pQfZHs0cO7A" autocomplete="off" />
          <input type="hidden" name="redirect_uri" id="redirect_uri" value="/categories/finding-products?show_store_picker=1" autocomplete="off" />
          <input type="hidden" name="auth_intent" id="auth_intent" value="install" autocomplete="off" />
          <input type="hidden" name="id" id="id" value="" autocomplete="off" />
          <input type="hidden" name="return_to" id="return_to" value="/categories/finding-products" autocomplete="off" />
          <input type="hidden" name="locale" id="locale" value="en" autocomplete="off" />
          <button name="button" type="submit" class="tw-rounded-full tw-cursor-pointer tw-no-underline tw-appearance-none tw-inline-block tw-text-center tw-border disabled:tw-cursor-not-allowed tw-outline-3 tw-outline-button-outline-focus focus-visible:tw-outline tw-button-secondary tw-w-full tw-whitespace-nowrap tw-px-7 tw-py-md sm:tw-px-8 sm:tw-py-lg tw-text-link-lg">
  
            Log in to an existing account

</button></form>      </div>

      <p class="tw-text-body-sm tw-text-fg-secondary tw-text-center tw-mt-6">
