<!-- Amplitude Web Experiment x OneTrust bootstrap starts -->
<script>
    (function amplitudeOneTrustBootstrap() {
        var AMPLITUDE_KEY = window.isStaging
            ? "06a7d90fcb11e0c4de91acba2dfa39e9"
            : "1050a4fd3e4fd9cd51b69d3f053b4da0";

        var AMPLITUDE_EXPERIMENT_SRC =
            "https://cdn.amplitude.com/script/" +
            AMPLITUDE_KEY +
            ".experiment.js?integration=segment";
        var ANALYTICS_GROUP_IDS = ["2", "C0002"];

        var amplitudeLoaded = false;
        var currentConsentStatus = "pending";

        function getActiveGroups(event) {
            if (event && Array.isArray(event.detail)) {
                return event.detail.map(String);
            }

            if (event && typeof event.detail === "string") {
                return event.detail
                    .split(",")
                    .map(function (group) {
                        return group.trim();
                    })
                    .filter(Boolean);
            }

            return String(window.OnetrustActiveGroups || "")
                .split(",")
                .map(function (group) {
                    return group.trim();
                })
                .filter(Boolean);
        }

        function hasAnalyticsConsent(event) {
            var activeGroups = getActiveGroups(event);

            return ANALYTICS_GROUP_IDS.some(function (groupId) {
                return activeGroups.indexOf(groupId) !== -1;
            });
        }

        function loadAmplitudeExperiment() {
            if (amplitudeLoaded) {
                return;
            }

            amplitudeLoaded = true;

            window.experimentConfig = window.experimentConfig || {};
            window.experimentConfig.consentOptions = {
                consentRequired: true,
                consentStatus: currentConsentStatus,
            };

            var script = document.createElement("script");
            script.src = AMPLITUDE_EXPERIMENT_SRC;
            script.async = false;
            script.onload = function () {
                if (
                    window.webExperiment &&
                    typeof window.webExperiment.setConsentStatus === "function"
                ) {
                    window.webExperiment.setConsentStatus(currentConsentStatus);
                }
            };
            script.onerror = function () {
                amplitudeLoaded = false;
            };

            document.head.appendChild(script);
        }

        function setAmplitudeConsentStatus(status) {
            currentConsentStatus = status;

            if (
                amplitudeLoaded &&
                window.webExperiment &&
                typeof window.webExperiment.setConsentStatus === "function"
            ) {
                window.webExperiment.setConsentStatus(status);
            }
        }

        function handleOneTrustGroupsUpdated(event) {
            if (hasAnalyticsConsent(event)) {
                setAmplitudeConsentStatus("granted");
                loadAmplitudeExperiment();
                return;
            }

            setAmplitudeConsentStatus("denied");
        }

        window.addEventListener(
            "OneTrustGroupsUpdated",
            handleOneTrustGroupsUpdated,
        );
    })();
</script>
<!-- Amplitude Web Experiment x OneTrust bootstrap ends -->

<!-- Dev scripts swapper starts -->
<script>
    function updateScriptDomain() {
        const params = new URLSearchParams(window.location.search);
        const isDev = params.get("dev") === "true";
        const scriptDomain = "https://www.typeform-scripts.local:8080/";

        // Find all matching scripts
        const scripts = document.querySelectorAll(
            'script[type="cc-ext-hosted-script"]',
        );

        scripts.forEach((script) => {
            const srcPath = script.getAttribute("src");
            if (!srcPath) {
                return;
            }

            // Create new script element
            const newScript = document.createElement("script");
            newScript.type = "text/javascript";

            // Handle src based on dev mode
            if (isDev) {
                // Extract the file path for GitHub URLs
                const parts = srcPath.split("/typeform@");
                if (parts.length < 2) {
                    return;
                }

                // Get everything after the version number and remove .min from .min.js files
                let pathAfterVersion = parts[1].split("/").slice(1).join("/");
                pathAfterVersion = pathAfterVersion.replace(".min.js", ".js");
                newScript.src = `${scriptDomain}${pathAfterVersion}`;
            } else {
                // Keep original src if not in dev mode
                newScript.src = srcPath;
            }

            // Copy over other attributes except type and src
            Array.from(script.attributes).forEach((attr) => {
                if (attr.name !== "type" && attr.name !== "src") {
                    newScript.setAttribute(attr.name, attr.value);
                }
            });

            // Add load/error handlers
            //newScript.onload = () => console.log(`Script loaded: ${newScript.src}`);
            //newScript.onerror = (error) => console.error(`Script failed to load: ${newScript.src}`, error);

            // Replace the old script with the new one
            script.parentNode.replaceChild(newScript, script);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", updateScriptDomain);
    } else {
        updateScriptDomain();
    }
</script>
<!-- Dev scripts swapper ends -->

