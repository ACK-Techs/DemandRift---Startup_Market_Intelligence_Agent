// on each select change
$('.hack44-select-monthly').change(function(){
  // declare & initialize sum at 0
  let sum = 1;
  // for each select
  $('.hack44-select-monthly').each((i, select)=>{
    // sum is equal to sum + the select's value
    sum *= (Number($(select).attr($(select).val())) || 0);
  });
  
  // format sum e.g. 3500 to 3,500
  const formattedSum = new Intl.NumberFormat('en-US').format(sum);
  
  // display the sum
  // NB: use sum directly if not interested in formatting
  // $('.hack44-added-value-monthly').text(sum);
  $('.hack44-added-value-monthly').text(formattedSum);
  // add the value to the hidden input
  $('.hack44-send-value-monthly').val(formattedSum);
  
  $('.hack44-added-value-monthly-credits-small').text(formattedSum);
  // add the value to the hidden input
  $('.hack44-send-value-monthly-credits-small').val(formattedSum);
  
});
</script>

