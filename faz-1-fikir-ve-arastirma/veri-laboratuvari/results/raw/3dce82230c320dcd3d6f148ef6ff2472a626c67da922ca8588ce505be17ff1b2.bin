false}}]}]}}}]},{"blockName":"canva-cse-keyed/KeyedObject","attrs":{"key":"Question-Answer pairs","objectId":"Question-Answer pairs"},"innerBlocks":[{"blockName":"canva-cse-keyed/KeyedMessage","attrs":{"key":"Question","message":"Who can connect Canva and Constant Contact?"}},{"blockName":"canva-cse-keyed/KeyedParagraphWithHtml","attrs":{"key":"Answer","paragraph":{"blockName":"canva-cse-keyed/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Anyone with a Canva and Constant Contact account can connect the two.","bold":false,"italic":false}}]}]}}}]},{"blockName":"canva-cse-keyed/KeyedObject","attrs":{"key":"Question-Answer pairs","objectId":"Question-Answer pairs"},"innerBlocks":[{"blockName":"canva-cse-keyed/KeyedMessage","attrs":{"key":"Question","message":"Is it free to connect Canva and Constant Contact?"}},{"blockName":"canva-cse-keyed/KeyedParagraphWithHtml","attrs":{"key":"Answer","paragraph":{"blockName":"canva-cse-keyed/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Yes, connecting Canva and Constant Contact is free. Access to advanced features depends on your Canva or Constant Contact plan.","bold":false,"italic":false}}]}]}}}]},{"blockName":"canva-cse-keyed/KeyedObject","attrs":{"key":"Question-Answer pairs","objectId":"Question-Answer pairs"},"innerBlocks":[{"blockName":"canva-cse-keyed/KeyedMessage","attrs":{"key":"Question","message":"How do I set up Canva with Constant Contact?"}},{"blockName":"canva-cse-keyed/KeyedParagraphWithHtml","attrs":{"key":"Answer","paragraph":{"blockName":"canva-cse-keyed/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"In Constant Contact, go to your Integrations page, search for Canva, select Connect, and follow the prompts to complete setup.","bold":fal