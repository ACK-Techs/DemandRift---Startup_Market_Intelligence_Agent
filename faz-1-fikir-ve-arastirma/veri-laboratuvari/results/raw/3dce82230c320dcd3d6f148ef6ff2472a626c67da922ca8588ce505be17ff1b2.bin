ent-management-files.canva.com/a78024ed-b115-42a3-83ac-21d892df6f6a/Constantcontact_Hero_1260x707.png?resize-format=avif&amp;resize-width=1200" type="image/avif" media="(min-width: 0px) and (max-width: 599px) and (min-resolution: 1.001dppx)" data-next-head=""/><link data-next-font="size-adjust" rel="preconnect" href="/" crossorigin="anonymous"/><link rel="preload" href="https://static-cse.canva.com/_next/static/media/canva-sans-latin.cb8040b8.woff2" type="font/woff2" as="font" crossorigin="anonymous" referrerPolicy="strict-origin-when-cross-origin"/><script data-quick-page-version="V2" data-quick-page-slug="integrations-constantcontact" data-next-head=""></script><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.canva.com/"},{"@type":"ListItem","position":2,"name":"Apps","item":"https://www.canva.com/apps/"},{"@type":"ListItem","position":3,"name":"Constant Contact","item":"https://www.canva.com/apps/"}]}</script><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","mainEntity":[{"@type":"Question","name":"What is the Canva for Constant Contact app?","acceptedAnswer":{"@type":"Answer","text":"<p><span>The Canva for Constant Contact app integrates your Canva and Constant Contact accounts, so you can bring your designs directly into your email and social campaigns without downloading or reformatting files.</span></p>"}},{"@type":"Question","name":"What can I do with the Canva for Constant Contact app?","acceptedAnswer":{"@type":"Answer","text":"<p><span>Create designs in Canva and instantly sync them to Constant Contact. Use your polished designs in emails, social posts, landing pages, and ads. Publish and track performance in one place.</span></p>"}},{"@type":"Question","name":"Who can connect Canva and Constant Contact?","acceptedAnswer":{"@type":"Answer","text":"<p><span>Anyone with a Canva and Constant Contact account can connect the two.</span></p>"}},{"@type":"Question","name":"Is it free to connect Canva and Constant Contact?","acceptedAnswer":{"@type":"Answer","text":"<p><span>Yes, connecting Canva and Constant Contact is free. Access to advanced features depends on your Canva or Constant Contact plan.</span></p>"}},{"@type":"Question","name":"How do I set up Canva with Constant Contact?","acceptedAnswer":{"@type":"Answer","text":"<p><span>In Constant Contact, go to your Integrations page, search for Canva, select Connect, and follow the prompts to complete setup.</span></p>"}},{"@type":"Question","name":"Where can I view your privacy policy?","acceptedAnswer":{"@type":"Answer","text":"<p><span>View Canva’s </span><a class=\"Ej7lEg WkdUeQ _3bC2IQ\" href=\"https://www.canva.com/policies/privacy-policy/\" draggable=\"false\" target=\"_blank\" rel=\"noopener\">privacy policy<span id=\"_R_t_\" class=\"V5YmAg\">⁠<span class=\"_pFsfA\">(opens in a new tab or window)</span></span></a><span>.</span></p>"}}],"@type":"FAQPage"}</script><script>document.documentElement.classList.remove('nojs');</script><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/pages/_app.11ae0758.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/hoisted.31243d92.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/34062.9f21b89f.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/27464.13a72a3e.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/25067.bd9c77d3.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/36214.e1b91b8a.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/97914.210205c7.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static/chunks/52274.58f65300.css"/><link rel="stylesheet" href="https://static-cse.canva.com/_next/static