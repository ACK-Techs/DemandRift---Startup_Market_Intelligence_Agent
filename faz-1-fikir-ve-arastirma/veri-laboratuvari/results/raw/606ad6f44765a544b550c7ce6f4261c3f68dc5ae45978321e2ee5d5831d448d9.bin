    </div>

        <aside id="cookie-banner" class="spk-cookie-banner" role="region" aria-labelledby="cookie-banner-title" >
            <button type="button" class="spk-cookie-banner__close" data-cookie-banner-close aria-label="Kapat">&times;</button>
            <div class="spk-cookie-banner__content">
                <div>
                    <h2 id="cookie-banner-title">&#199;erez tercihleriniz</h2>
                    <p>
                        Sitenin &#231;alışması i&#231;in zorunlu &#231;erezler kullanılır. Analitik &#231;erezler ve Google Haritalar yalnız izninizle etkinleştirilir.
                        <span class="spk-cookie-banner__links">
                            <a href="/CerezPolitikasi">&#199;erez Politikası</a>
                            <span aria-hidden="true">·</span>
                            <button type="button" class="cookie-preferences-link" data-cookie-preferences>Tercihleri y&#246;net</button>
                        </span>
                    </p>
                </div>
                <div class="spk-cookie-actions">
                    <button type="button" data-cookie-choice="analytics">&#199;erezleri kabul et</button>
                    <button type="button" data-cookie-choice="necessary">&#199;erezleri reddet</button>
                </div>
            </div>
        </aside>
        <dialog id="cookie-preferences" class="spk-cookie-dialog" aria-labelledby="cookie-preferences-title">
            <button type="button" class="spk-cookie-dialog__close" data-cookie-close aria-label="Kapat">&times;</button>
            <h2 id="cookie-preferences-title">&#199;erez tercihleri</h2>
            <p>Analitik &#231;erezleri ve Google Haritalar gibi harici i&#231;erikleri kabul edebilir veya reddedebilirsiniz. Tercihinizi daha sonra sayfanın altındaki bağlantıdan değiştirebilirsiniz.</p>
            <div class="spk-cookie-option">
                <div>
                    <strong>Zorunlu &#231;erezler</strong>
                    <p>G&#252;venlik, form doğrulama ve tercih kaydı i&#231;in gereklidir.</p>
                </div>
                <span>Her zaman etkin</span>
            </div>
            <label class="spk-cookie-option" for="cookie-analytics-toggle">
                <span>
                    <strong>Analitik ve harici i&#231;erik</strong>
                    <span>Site kullanımını anlamamıza yardımcı olur ve Google Haritalar gibi harici i&#231;erikleri etkinleştirir.</span>
                </span>
                <input id="cookie-analytics-toggle" type="checkbox" >
            </label>
            <div class="spk-cookie-dialog__actions">
                <button type="button" data-cookie-save>Tercihi kaydet</button>
                <button type="button" data-cookie-choice="necessary">&#199;erezleri reddet</button>
            </div>
        </dialog>

    <button id="gotoTop" type="button" class="uil uil-angle-up" aria-label="Sayfa başına d&#246;n"></button>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="/bundles/scripts?v=0eng-WSzZpUJBBkeg1X0sN8n80qF3JRwS_JSrTMDYjE1" defer></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var header = document.getElementById('header');
            var hamburger = header.querySelector('.cnvs-hamburger');
            var menuItems = header.querySelectorAll('#primary-navigation .menu-item:has(> .sub-menu-container)');
            var languageMenu = header.querySelector('.spk-language-menu');

            if (languageMenu) {
                languageMenu.addEventListener('pointerenter', function (event) {
                    if (event.pointerType === 'mouse') languageMenu.open = true;
                });
                languageMenu.addEventListener('pointerleave', function (event) {
                    if (event.pointerType === 'mouse' && !languageMenu.contains(document.activeElement)) languageMenu.open = false;
                });
                languageMenu.addEventListener('focusout', function (event) {
                    if (!languageMenu.contains(event.relatedTarget) && !languageMenu.matches(':hover')) languageMenu.open = false;
                });
            }

            function syncMenus() {
                hamburger.setAttribute('aria-expanded', header.querySelector('.primary-menu-trigger').classList.contains('primary-menu-trigger-active'));
                menuItems.forEach(function (item) {
                    var expanded = document.body.classList.contains('is-expanded-menu')
                        ? item.classList.contains('menu-item-hover')
                        : !item.querySelector('.sub-menu-container').classList.contains('d-none');
                    item.querySelector('.sub-menu-trigger').setAttribute('aria-expanded', expanded);
                });
            }

            menuItems.forEach(function (item) {
                var trigger = item.querySelector('.sub-menu-trigger');
                item.addEventListener('focusin', function () {
                    if (document.body.classList.contains('is-expanded-menu')) item.classList.add('menu-item-hover');
                });
                item.addEventListener('focusout', function (event) {
                    if (!item.contains(event.relatedTarget)) item.classList.remove('menu-item-hover');
                });
                trigger.addEventListener('click', function (event) {
                    if (!document.body.classList.contains('is-expanded-menu')) return;
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    item.classList.toggle('menu-item-hover');
                }, true);
                item.addEventListener('keydown', function (event) {
                    if (event.key !== 'Escape' || trigger.getAttribute('aria-expanded') !== 'true') return;
                    event.stopPropagation();
                    trigger.focus();
                    item.classList.remove('menu-item-hover');
                    if (!document.body.classList.contains('is-expanded-menu')) item.querySelector('.sub-menu-container').classList.add('d-none');
                });
            });
            document.addEventListener('keydown', function (event) {
                if (event.key !== 'Escape') return;
                if (languageMenu && languageMenu.open) {
                    var languageHadFocus = languageMenu.contains(document.activeElement);
                    languageMenu.open = false;
                    if (languageHadFocus) languageMenu.querySelector('summary').focus();
                } else if (header.contains(event.target) && hamburger.getAttribute('aria-expanded') === 'true') {
                    hamburger.click();
                    hamburger.focus();
                }
            });
            document.addEventListener('click', function (event) {
                if (languageMenu && !languageMenu.contains(event.target)) languageMenu.open = false;
            });
            new MutationObserver(syncMenus).observe(header, { attributes: true, attributeFilter: ['class'], subtree: true });
            syncMenus();
            document.getElementById('gotoTop').addEventListener('click', function () {
                document.querySelector('.skip-link').focus({ preventScroll: true });
            });
        });
    </script>

        <script>
            (function () {
                var cookieName = 'spk_cookie_consent_v1';
                var bannerDismissedKey = 'spk_cookie_banner_dismissed';
                var banner = document.getElementById('cookie-banner');
                var dialog = document.getElementById('cookie-preferences');
                var analyticsToggle = document.getElementById('cookie-analytics-toggle');
                var preferencesTrigger;

                new ResizeObserver(function () {
                    document.documentElement.style.setProperty('--spk-cookie-banner-height', banner.hidden ? '0px' : (banner.offsetHeight + 24) + 'px');
                }).observe(banner);

                function hideBanner() {
                    var bannerHadFocus = banner.contains(document.activeElement);
                    banner.hidden = true;
                    if (bannerHadFocus) document.getElementById('main-content').focus({ preventScroll: true });
                }

                dialog.addEventListener('close', function () {
                    if (preferencesTrigger && preferencesTrigger.getClientRects().length) preferencesTrigger.focus();
                    else document.getElementById('main-content').focus({ preventScroll: true });
                });

                try {
                    if (sessionStorage.getItem(bannerDismissedKey) === '1') banner.hidden = true;
                } catch (error) { }

                function storeChoice(value) {
                    var secure = window.location.protocol === 'https:' ? '; Secure' : '';
                    document.cookie = cookieName + '=' + value + '; Max-Age=15552000; Path=/; SameSite=Lax' + secure;
                }

                function removeAnalyticsCookies() {
                    document.cookie.split(';').forEach(function (cookie) {
                        var name = cookie.split('=')[0].trim();
                        if (!/^(_ga|_gid|_gat)/.test(name)) return;
                        ['', '; Domain=' + window.location.hostname, '; Domain=.spk.com.tr'].forEach(function (domain) {
                            document.cookie = name + '=; Max-Age=0; Path=/' + domain + '; SameSite=Lax';
                        });
                    });
                }

                function closePreferences() {
                    if (dialog.open) dialog.close();
                }

                function setChoice(analyticsAllowed) {
                    storeChoice(analyticsAllowed ? 'analytics' : 'necessary');
                    window.spkAnalyticsConsent = analyticsAllowed;
                    if (analyticsAllowed) loadAnalytics();
                    gtag('consent', 'update', {
                        analytics_storage: analyticsAllowed ? 'granted' : 'denied',
                        ad_storage: 'denied',
                        ad_user_data: 'denied',
                        ad_personalization: 'denied'
                    });
                    if (!analyticsAllowed) removeAnalyticsCookies();
                    analyticsToggle.checked = analyticsAllowed;
                    hideBanner();
                    closePreferences();
                    document.dispatchEvent(new CustomEvent('spk:analytics-consent-changed', {
                        detail: { allowed: analyticsAllowed }
                    }));
                }

                document.querySelectorAll('[data-cookie-choice]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        setChoice(button.getAttribute('data-cookie-choice') === 'analytics');
                    });
                });

                document.querySelectorAll('[data-cookie-preferences]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        preferencesTrigger = button;
                        analyticsToggle.checked = window.spkAnalyticsConsent;
                        dialog.showModal();
                    });
                });

                document.querySelector('[data-cookie-save]').addEventListener('click', function () {
                    setChoice(analyticsToggle.checked);
                });
                document.querySelector('[data-cookie-banner-close]').addEventListener('click', function () {
                    try {
                        sessionStorage.setItem(bannerDismissedKey, '1');
                    } catch (error) { }
                    hideBanner();
                });
                document.querySelector('[data-cookie-close]').addEventListener('click', closePreferences);
            }());
        </script>

    <!-- Section Scripts -->
    





<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"b9af47c520244f7eb689524de3edf2b3","r":1,"spa":2}' crossorigin="anonymous"></script>
