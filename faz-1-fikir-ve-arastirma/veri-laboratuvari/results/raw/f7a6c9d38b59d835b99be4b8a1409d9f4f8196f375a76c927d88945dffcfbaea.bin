":{"industryType":["Agencies","Brand","ConsumerPackagingGoods","eCommerce","Educational","Entertainment","Franchises","InternalComms","Marketing","MediaAndPublishing","Newsroom","Nonprofit","Print","RealEstate","Retail","Sales","Sports","Technology"],"region":["Americas","AsiaPacific","Europe","Global","MiddleEastAndAfrica"],"useCase":["HumanResourcesUseCase","InternalCommsUseCase","MarketingUseCase","SalesUseCase"]},"Teams":{"industryType":["Agencies","Brand","ConsumerPackagingGoods","eCommerce","Educational","Entertainment","Franchises","InternalComms","Marketing","MediaAndPublishing","Newsroom","Nonprofit","Print","RealEstate","Retail","Sales","Sports","Technology"],"region":["Americas","AsiaPacific","Europe","Global","MiddleEastAndAfrica"],"useCase":["HumanResourcesUseCase","InternalCommsUseCase","MarketingUseCase","SalesUseCase"]}}},"defaultFilters":{},"pageIndexRange":{"from":1,"to":13},"featuredPost":{"locale":"EN","title":"Keller Williams saves 300,000 hours for real estate agents — unlocking more time to close deals 🔥","slug":"keller-williams","solution":"Enterprise","useCase":null,"region":"Global","industryType":"RealEstate","logo":{"alt":"","url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png","images":[{"minWidth":0,"height":89,"width":196,"format":"AVIF","set":[{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-format=avif\u0026resize-width=196","pixelDensity":1},{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-format=avif\u0026resize-width=294","pixelDensity":1.5},{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-format=avif\u0026resize-width=392","pixelDensity":2}]},{"minWidth":0,"height":89,"width":196,"set":[{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-width=196","pixelDensity":1},{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-width=294","pixelDensity":1.5},{"url":"https://content-management-files.canva.com/985b9854-ead7-4fa1-ba5e-7e127bfc3737/KellerWilliams_Prim_Logo_RGB.png?resize-width=392","pixelDensity":2}]}]},"bannerHeader":{"blockName":"canva-community-casestudies/banner-header","attrs":{"title":"Keller Williams saves 300,000 hours for real estate agents — unlocking more time to close deals 🔥","preheading":" CANVA ENTERPRISE","asset":{"url":"https://content-management-files.canva.com/628e0574-db24-4684-bf3e-3e8256223e87/KellerWilliams-WCSBanner.png","alt":null,"title":null,"isCms":true,"width":2632,"height":800,"transforms":null,"transformsV2":null},"assetPreview":{"url":"https://content-management-files.canva.com/ae3fffc7-1c67-44b4-92c8-ddc53e59c554/KellerWilliams-WCSThumbnail.png.png","alt":null,"title":null,"isCms":true,"width":824,"height":708,"transforms":null,"transformsV2":null},"video":null}},"content":{"blockName":"canva-community-casestudies/content","innerBlocks":[{"blockName":"canva-community-casestudies/video","attrs":{"video":{"blockName":"canva-cse-video/video-selection-block","innerBlocks":[{"blockName":"canva-cse-video/external-video-block","attrs":{"videoId":"xxGupPGFr_8","player":"youtube","enableControls":false}}]},"placeholderImage":{"url":"https://content-management-files.canva.com/234ffc1d-6ace-4380-a00c-8eba70148fd8/KellerWilliamsApprovedcustomerproofStrategicRealEstateGlobalEnterpriseSKU3.png","alt":null,"title":null,"isCms":true,"width":1920,"height":1080,"transforms":null,"transformsV2":null}}},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/title-medium","attrs":{"tagName":"h3","color":"colorBlack"},"innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"About Keller Williams","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Keller Williams is the world's largest real estate franchise by agent count, with over 150,000 agents across 65+ countries. KW invests more in teaching, training, and coaching than any other real estate company on the planet.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/title-medium","attrs":{"tagName":"h3","color":"colorBlack"},"innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Success story snapshot","bold":true,"italic":false}}]},{"blockName":"canva-cse-list/unordered-list","innerBlocks":[{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"300,000 hours of agent time saved in Y1","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brand compliance with 150,000 agents in 65+ countries","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"8 hours → 15 minutes for agent marketing content creation","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"62% year-over-year sales volume increase at one KW market center","bold":false,"italic":false}}]}]},{"blockName":"canva-cse-text/title-medium","attrs":{"tagName":"h3","color":"colorBlack"},"innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Before Canva","bold":true,"italic":false}}]},{"blockName":"canva-cse-list/unordered-list","innerBlocks":[{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Tool sprawl:","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" Agents juggled 5–6 disconnected platforms with no unified workflow.","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brand fragmentation:","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" Every agent interpreted the brand their own way, eroding consumer confidence.","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Lost selling time:","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" Marketing tasks consumed hours that agents should have spent on lead generation and client relationships","bold":false,"italic":false}}]}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"In real estate, time is the inventory. And before Canva, agents were spending too much of it fighting different tools.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Across KW's global network, agents were using multiple disconnected platforms — one for graphic design, another for email, another for lead forms. Some agents blocked out entire days to get their marketing done — or outsourced, adding to huge costs. ","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“My team was spending $2,000 per month amongst freelancers for our marketing — and that cost added up for my business,” ","authorName":"Gabby Davis","authorRole":"Operating Principal, Keller Williams Atlanta."}}]},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"The cost of that friction went beyond lost time. Brand fragmentation was spreading.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"With 150,000 agents across 65 countries, each sourcing their own design help from freelancers and local agencies, brand inconsistency crept in, and costs added up. From one neighborhood to the next, the KW brand looked different. They needed to build consistency and trust in a way that their agents could easily adopt.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“When you're not comfortable doing something on your own, you find a way for someone else to get it done — and that starts the fragmentation of the brand right from the start.” ","authorName":"Sandra Howard","authorRole":"CMO, Keller Williams"}}]},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/title-medium","attrs":{"tagName":"h3","color":"colorBlack"},"innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"The solution","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"With Canva Enterprise, Keller Williams:","bold":true,"italic":false}}]},{"blockName":"canva-cse-list/unordered-list","innerBlocks":[{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brought all their tools to one place: ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Fragmented tools were replaced with one secure platform across KW’s entire agent network.","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Sped up production time: ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Agents create professional, on-brand content in minutes — not days.","bold":false,"italic":false}}]},{"blockName":"canva-cse-list/list-item","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Reinvested their time savings: ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Agents were free to focus on what drives business: client relationships and closing deals.","bold":false,"italic":false}}]}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"One platform, one workflow","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"When Keller Williams launched Canva Enterprise across its network, agents didn't just get a new design tool. They unlocked a secure platform to handle every content need and the confidence to do it themselves.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"KW's ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brand Kit","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" brought the company's visual identity directly into Canva. Fonts, colors, and logos were locked and ready to go. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"And with ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brand Controls","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":", standards are enforced at the network level — agents can customize freely within guardrails, but the brand stays intact across every market, every franchise, and in every country.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“Canva took our ecosystem — varying degrees of experience, varying degrees of capability — and allowed us to level up in a way that delivered our brand consistently while elevating agents’ professional brand at the same time.” ","authorName":"Sandra Howard","authorRole":"CMO, Keller Williams"}}]},{"blockName":"canva-community-casestudies/internal-video","attrs":{"video":{"url":"https://content-management-files.canva.com/7a4d3f6a-6901-4b30-949e-775056e49503/LandingPage_MLSFlow1.mp4"},"autoplay":false,"loop":false,"enableControls":false}},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Time back to sell homes","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"The shift in productivity was immediate. Marketing that once consumed a full day now takes 15 minutes. Listing presentations built in an afternoon. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"And with ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Canva's MLS integration,","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" property marketing assets are created in minutes — agents enter an address, and listing photos populate automatically.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“Something that used to take eight hours now takes 15 minutes.”","authorName":"Jannel Gonzalez","authorRole":"South Texas Regional Tech Trainer, Keller Williams"}}]},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"For ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Gabby Davis","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":", Operating Principal at one of KW's fastest-growing market centers in Atlanta, the time savings translated directly into business growth.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Gabby’s franchise grew from 1 agent to nearly 450 in just 3.5 years — the fastest net-growing market center in all of KW International.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"With Canva, Gaby’s team reclaimed roughly","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" 20 hours a week (over 1,000 hours per year) ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"previously lost to downloading and organizing listing photos alone.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"“Now we can focus on growing the business,” Gabby says.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“We had a 62% increase year over year in sales volume, and I strongly think it's because we advocate for our agents to utilize Canva and all the marketing tools that KWRI provides to us to advertise their business.”","authorName":"Gabby Davis","authorRole":"Operating Principal, Keller Williams Atlanta"}}]},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Marketing that wins listings","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"KW built a full lifecycle marketing system on Canva, from first lead to just-sold. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Every agent now shows up to sellers with the same professional polish. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"New agents get print-ready, brand-consistent collateral from their first open house. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Brand Templates ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"covers every stage of the transaction lifecycle — lead generation, listing presentations, open houses, just listed, under contract, just sold, and client follow-up — so nothing falls through the cracks.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“People judge your ability to market and brand yourself online as your ability to market and brand their home when it comes to the market.”","authorName":"Gabby Davis","authorRole":"Operating Principal, Keller Williams Atlanta"}}]},{"blockName":"canva-community-casestudies/internal-video","attrs":{"video":{"url":"https://content-management-files.canva.com/2ca298e7-0ba2-4b17-bf0c-08d5421277a8/LandingPage_CanvaCodeFlow1.mp4"},"autoplay":false,"loop":false,"enableControls":false}},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"AI turns agents into lead generators","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Canva's impact at KW extends beyond design. Agents are now using ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Canva Code","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" to instantly build interactive lead generation tools like quizzes, forms, and city guides that capture prospect data directly into Canva Sheets, feeding a live database for follow-up campaigns.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"A \"What kind of home are you?\" quiz generates leads while answering buyer questions. Neighborhood guides position agents as local experts. ","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Commercial real estate agents use AI-generated business analysis to go deeper with clients — content that would have required a copywriter or a specialist to produce.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/testimonial","innerBlocks":[{"blockName":"canva-community-casestudies/testimonial-entry","attrs":{"quoteText":"“Canva made it so easy for agents and reduced the chaos — it wasn’t use this tool, use that tool. It's now one tool, and it's very simple, and it empowered them with the confidence to effectively market themselves.”","authorName":"Jannel Gonzalez","authorRole":"South Texas Regional Tech Trainer, Keller Williams"}}]},{"blockName":"canva-community-casestudies/image","attrs":{"image":{"url":"https://content-management-files.canva.com/6bfb5898-20b3-4d87-a47d-51fc17c44d84/KellerWilliams-WCSIn-pagevisual-3.png","alt":null,"title":null,"isCms":true,"width":3840,"height":2160,"transforms":null,"transformsV2":null},"caption":null,"isFullWidth":false}},{"blockName":"canva-community-casestudies/content-wysiwyg","attrs":{"wysiwyg":{"blockName":"canva-community-casestudies/wysiwyg","innerBlocks":[{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Adoption that set a new benchmark","bold":true,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"Six months after launch, KW has reached +","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"50% adoption rate ","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"— more than ","bold":false,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"2x higher","bold":true,"italic":false}},{"blockName":"canva-cse-text/text-fragment","attrs":{"text":" than the SaaS industry benchmark. The numbers keep climbing week by week.","bold":false,"italic":false}}]},{"blockName":"canva-cse-text/paragraph","innerBlocks":[{"blockName":"canva-cse-text/text-fragment","attrs":{"text":"And for Sandra Howard, 300,000 hours saved is not the finish line. It's the starting point.","bold":false,"italic":false}}]}]}}},{"blockName":"canva-community-casestudies/image","attrs":{"image":{"url":"https://content-management-files.canva.com/5c5b7347-ddf4-4ef5-8d93-f16ef2b0d06e/CMOquoteKellerWilliams.png","alt":null,"title":null,"isCms":true,"width":1920,"height":1080,"transforms":null,"transformsV2":null},"caption":null,"isFullWidth":false}}]}},"routingInfo":{"currentPage":"CommunityCaseStudies.home","currentUrl":"https://www.canva.com/case-studies/","currentTemplateName":"/community/case_studies/home","currentTemplateId":"community-case-studies-home","currentTemplateOwner":"mau","alternateUrls":{"EN":"https://www.canva.com/case-studies/","DA_DK":"https://www.canva.com/da_dk/referencer/","DE_DE":"https://www.canva.com/de_de/fallstudien/","EN_IN":"https://www.canva.com/en_in/case-studies/","ES_AR":"https://www.canva.com/es_ar/caso-practico/","ES_CO":"https://www.canva.com/es_co/caso-de-estudio/","ES_MX":"https://www.canva.com/es_mx/caso-practico/","ES_US":"https://www.canva.com/es_us/caso-practico/","FR_FR":"https://www.canva.com/fr_fr/etudes-cas/","ID_ID":"https://www.canva.com/id_id/studi-kasus/","IT_IT":"https://www.canva.com/it_it/casi-di-studio/","JA_JP":"https://www.canva.com/ja_jp/case-studies/","MS_MY":"https://www.canva.com/ms_my/kajian-kes/","NB_NO":"https://www.canva.com/nb_no/referanser/","PL_PL":"https://www.canva.com/pl_pl/analiza-przypadkow/","PT_BR":"https://www.canva.com/pt_br/casos-de-sucesso/","PT_PT":"https://www.canva.com/pt_pt/casos-de-sucesso/","RU_RU":"https://www.canva.com/ru_ru/kejsy/","SV_SE":"https://www.canva.com/sv_se/cases/"},"locale":"EN","queryParams":{},"apiBaseUrl":"https://www.canva.com","baseUrl":"https://www.canva.com","webpackAssetsHavePrefix":true,"linke