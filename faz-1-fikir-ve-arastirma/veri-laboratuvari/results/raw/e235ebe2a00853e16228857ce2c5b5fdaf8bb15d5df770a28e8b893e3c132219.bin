.glasrand-outer { backdrop-filter: blur(12px); }

/* Bento-Grid: ganze Karte klickbar (stretched link) + Hover-Effekte auf Karten-Ebene */
.bento-card { position: relative; }
.bento-card .bento-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
.bento-card .bento-link { cursor: pointer; }
.bento-card .btn-arrow { transition: transform .2s ease, opacity .2s ease; }
.bento-card:hover .btn-arrow { opacity: 0; transform: translateX(0.5rem); }
.bento-card .btn-tertiary:hover img.btn-arrow { translate: none; }
.bento-card:hover h3 { text-decoration-line: underline; text-decoration-color: var(--color-primary); text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
.bento-card .bento-arrow-white { filter: brightness(0) invert(1); }
</style>
