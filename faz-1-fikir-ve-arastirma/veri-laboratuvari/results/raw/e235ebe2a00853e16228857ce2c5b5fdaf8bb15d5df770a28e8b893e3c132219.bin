<script>
(function() {
    var nav = document.getElementById('main-nav');
    var target = document.getElementById('nav-wrap-target');
    if (nav && target) {
        target.appendChild(nav);
    }

    (function() {
        var wrap = document.getElementById('rezensionen-hero-wrap');
        if (!wrap) return;
        var hRaf = null, hLastE = null;
        wrap.addEventListener('mousemove', function(e) {
            hLastE = e;
            if (hRaf) return;
            hRaf = requestAnimationFrame(function() {
                hRaf = null;
                if (!hLastE) return;
                var r = wrap.getBoundingClientRect();
                var dx = (hLastE.clientX - (r.left + r.width  / 2)) / (r.width  / 2);
                var dy = (hLastE.clientY - (r.top  + r.height / 2)) / (r.height / 2);
                wrap.style.transition = 'transform 0.08s ease-out';
                wrap.style.transform  = 'perspective(700px) rotateX(' + (-dy * 6) + 'deg) rotateY(' + (dx * 6) + 'deg) scale(1.02)';
            });
        });
        wrap.addEventListener('mouseleave', function() {
            hLastE = null;
            wrap.style.transition = 'transform 0.45s cubic-bezier(0.23,1,0.32,1)';
            wrap.style.transform  = '';
        });
    })();

    document.addEventListener('DOMContentLoaded', function() {
        var items = document.querySelectorAll('#faq-list .faq-item');
        items.forEach(function(item) {
            var btn = item.querySelector('.faq-trigger');
            var body = item.querySelector('.faq-body');
            if (!btn || !body) return;
            btn.addEventListener('click', function() {
                var isOpen = item.dataset.open === 'true';
                items.forEach(function(other) {
                    other.dataset.open = 'false';
                    var ob = other.querySelector('.faq-body');
                    var obtn = other.querySelector('.faq-trigger');
                    if (ob) ob.classList.add('hidden');
                    if (obtn) obtn.setAttribute('aria-expanded', 'false');
                });
                if (!isOpen) {
                    item.dataset.open = 'true';
                    body.classList.remove('hidden');
                    btn.setAttribute('aria-expanded', 'true');
                }
            });
        });
    });
})();
</script>
