te search volume?",[925],{"type":890},{},{"nodeType":668,"value":928,"marks":929,"data":930}," ",[],{},{"nodeType":664,"data":932,"content":933},{},[934,938,946],{"nodeType":668,"value":935,"marks":936,"data":937},"Yes, Glimpse provides ",[],{},{"nodeType":715,"data":939,"content":941},{"uri":940},"https://meetglimpse.com/google-trends/search-volume/",[942],{"nodeType":668,"value":943,"marks":944,"data":945},"real-time absolute search volume",[],{},{"nodeType":668,"value":947,"marks":948,"data":949}," data for any keyword over 20+ years. ",[],{},{"nodeType":664,"data":951,"content":952},{},[953],{"nodeType":668,"value":954,"marks":955,"data":957},"Does it aid trend discovery?",[956],{"type":890},{},{"nodeType":664,"data":959,"content":960},{},[961,965,973],{"nodeType":668,"value":962,"marks":963,"data":964},"Yes, Glimpse has functionality to ",[],{},{"nodeType":715,"data":966,"content":968},{"uri":967},"https://meetglimpse.com/software-guides/find-trends/",[969],{"nodeType":668,"value":970,"marks":971,"data":972},"spot emerging search trends",[],{},{"nodeType":668,"value":974,"marks":975,"data":976}," in any category (that aren’t just long-tails). ",[],{},{"nodeType":876,"data":978,"content":979},{},[980,983,991],{"nodeType":668,"value":15,"marks":981,"data":982},[],{},{"nodeType":715,"data":984,"content":986},{"uri":985},"https://meetglimpse.com/google-trends/advantages-disadvantages/#overcoming-limitations",[987],{"nodeType":668,"value":988,"marks":989,"data":990},"Additional features",[],{},{"nodeType":668,"value":15,"marks":992,"data":993},[],{},{"nodeType":995,"data":996,"content":997},"unordered-list",{},[998,1013,1028,1043,1058,1073,1088],{"nodeType":705,"data":999,"content":1000},{},[1001],{"nodeType":664,"data":1002,"content":1003},{},[1004,1009],{"nodeType":668,"value":1005,"marks":1006,"data":1008},"Growth rate:",[1007],{"type":890},{},{"nodeType":668,"value":1010,"marks":1011,"data":1012}," Instant insight into how much a trend has grown or declined. ",[],{},{"nodeType":705,"data":1014,"content":1015},{},[1016],{"nodeType":664,"data":1017,"content":1018},{},[1019,1024],{"nodeType":668,"value":1020,"marks":1021,"data":1023},"Seasonality:",[1022],{"type":890},{},{"nodeType":668,"value":1025,"marks":1026,"data":1027}," Dedicated panel to visualize seasonal patterns and understand what drives them.",[],{},{"nodeType":705,"data":1029,"content":1030},{},[1031],{"nodeType":664,"data":1032,"content":1033},{},[1034,1039],{"nodeType":668,"value":1035,"marks":1036,"data":1038},"Forecast:",[1037],{"type":890},{},{"nodeType":668,"value":1040,"marks":1041,"data":1042}," Predict the next 12 months’ search demand with 87% accuracy.",[],{},{"nodeType":705,"data":1044,"content":1045},{},[1046],{"nodeType":664,"data":1047,"content":1048},{},[1049,1054],{"nodeType":668,"value":1050,"marks":1051,"data":1053},"Long-tails:",[1052],{"type":890},{},{"nodeType":668,"value":1055,"marks":1056,"data":1057}," View what people also search alongside any term.",[],{},{"nodeType":705,"data":1059,"content":1060},{},[1061],{"nodeType":664,"data":1062,"content":1063},{},[1064,1069],{"nodeType":668,"value":1065,"marks":1066,"data":1068},"Channel:",[1067],{"type":890},{},{"nodeType":668,"value":1070,"marks":1071,"data":1072}," View which social platforms a topic is most discussed on.",[],{},{"nodeType":705,"data":1074,"content":1075},{},[1076],{"nodeType":664,"data":1077,"content":1078},{},[1079,1084],{"nodeType":668,"value":1080,"marks":1081,"data":1083},"Topic map:",[1082],{"type":890},{},{"nodeType":668,"value":1085,"marks":1086,"data":1087}," Visually explore related keywords.",[],{},{"nodeType":705,"data":1089,"content":1090},{},[1091],{"nodeType":664,"data":1092,"content":1093},{},[1094,1099],{"nodeType":668,"value":1095,"marks":1096,"data":1098},"Tracking & alerts:",[1097],{"type":890},{},{"nodeType":668,"value":1100,"marks":1101,"data":1102}," Monitor keywords and get alerted when a keyword surges or falls in popularity.",[],{},{"nodeType":876,"data":1104,"content":1105},{},[1106],{"nodeType":668,"value":1107,"marks":1108,"data":1109},"Pros",[],{},{"nodeType":701,"data":1111,"content":1112},{},[1113,1138,1153,1168],{"nodeType":705,"data":1114,"content":1115},{},[1116],{"nodeType":664,"data":1117,"content":1118},{},[1119,1124,1128,1134],{"nodeType":668,"value":1120,"marks":1121,"data":1123},"Accurate:",[1122],{"type":890},{},{"nodeType":668,"value":1125,"marks":1126,"data":1127}," Glimpse is built directly on top of Google Trends and will ",[],{},{"nodeType":668,"value":1129,"marks":1130,"data":1133},"always",[1131],{"type":1132},"italic",{},{"nodeType":668,"value":1135,"marks":1136,"data":1137}," match Google’s data. ",[],{},{"nodeType":705,"data":1139,"content":1140},{},[1141],{"nodeType":664,"data":1142,"content":1143},{},[1144,1149],{"nodeType":668,"value":1145,"marks":1146,"data":1148},"Real-time:",[1147],{"type":890},{},{"nodeType":668,"value":1150,"marks":1151,"data":1152}," Updates minute-by-minute, equivalent to Google Trends. ",[],{},{"nodeType":705,"data":1154,"content":1155},{},[1156],{"nodeType":664,"data":1157,"content":1158},{},[1159,1164],{"nodeType":668,"value":1160,"marks":1161,"data":1163},"Historical:",[1162],{"type":890},{},{"nodeType":668,"value":1165,"marks":1166,"data":1167}," Data goes all the way back to 2004, equivalent to Google Trends. ",[],{},{"nodeType":705,"data":1169,"content":1170},{},[1171],{"nodeType":664,"data":1172,"content":1173},{},[1174,1179],{"nodeType":668,"value":1175,"marks":1176,"data":1178},"Easy to use:",[1177],{"type":890},{},{"nodeType":668,"value":1180,"marks":1181,"data":1182}," The UI is simple and similar to the Google Trends layout, therefore taking little time to learn or train.",[],{},{"nodeType":876,"data":1184,"content":1185},{},[1186],{"nodeType":668,"value":1187,"marks":1188,"data":1189},"Cons",[],{},{"nodeType":701,"data":1191,"content":1192},{},[1193,1208,1223],{"nodeType":705,"data":1194,"content":1195},{},[1196],{"nodeType":664,"data":1197,"content":1198},{},[1199,1204],{"nodeType":668,"value":1200,"marks":1201,"data":1203},"Limited browser support:",[1202],{"type":890},{},{"nodeType":668,"value":1205,"marks":1206,"data":1207}," Glimpse is only available on Google Chrome, Microsoft Edge, Opera, Brave, and Vivaldi.",[],{},{"nodeType":705,"data":1209,"content":1210},{},[1211],{"nodeType":664,"data":1212,"content":1213},{},[1214,1219],{"nodeType":668,"value":1215,"marks":1216,"data":1218},"Trends, not “trending”:",[1217],{"type":890},{},{"nodeType":668,"value":1220,"marks":1221,"data":1222}," Glimpse won't help you much in detecting fleeting, \"trending\" news or celebrity events. Rather, it's built to identify and pull insights on emerging, sustainable trends. ",[],{},{"nodeType":705,"data":1224,"content":1225},{},[1226],{"nodeType":664,"data":1227,"content":1228},{},[1229,1234],{"nodeType":668,"value":1230,"marks":1231,"data":1233},"No site or technical analysis:",[1232],{"type":890},{},{"nodeType":668,"value":1235,"marks":1236,"data":1237}," Doesn't allow you to input your website and get customized recommendations on how to improve performance.",[],{},{"nodeType":876,"data":1239,"content":1240},{},[1241],{"nodeType":668,"value":1242,"marks":1243,"data":1244},"Price",[],{},{"nodeType":664,"data":1246,"content":1247},{},[1248],{"nodeType":668,"value":1249,"marks":1250,"data":1251},"Free plan provides up to 10 free searches per month, with additional access starting at $99/mo.",[],{},{"nodeType":876,"data":1253,"content":1254},{},[1255],{"nodeType":668,"value":1256,"marks":1257,"data":1258},"Who should use Glimpse?",[],{},{"nodeType":664,"data":1260,"content":1261},{},[1262],{"nodeType":668,"value":1263,"marks":1264,"data":1265},"Glimpse is the best Google Trends alternative for someone who wants to identify emerging search trends and pull rich keyword insights. ",[],{},{"nodeType":664,"data":1267,"content":1268},{},[1269,1272,1280],{"nodeType":668,"value":15,"marks":1270,"data":1271},[],{},{"nodeType":715,"data":1273,"content":1275},{"uri":1274},"https://chrome.google.com/webstore/detail/google-trends-supercharge/ocmojhiloccgbpjnkeiooioedaklapap?ref=glimpse.ghost.io",[1276],{"nodeType":668,"value":1277,"marks":1278,"data":1279},"Get started with Glimpse",[],{},{"nodeType":668,"value":1281,"marks":1282,"data":1283}," for free.",[],{},{"nodeType":822,"data":1285,"content":1286},{},[],{"nodeType":680,"data":1288,"content":1289},{},[1290],{"nodeType":668,"value":1291,"marks":1292,"data":1293},"Google Trends vs Semrush [Semrush]",[],{},{"nodeType":664,"data":1295,"content":1296},{},[1297,1300,1307],{"nodeType":668,"value":15,"marks":1298,"data":1299},[],{},{"nodeType":715,"data":1301,"content":1303},{"uri":1302},"https://semrush.com/",[1304],{"nodeType":668,"value":416,"marks":1305,"data":1306},[],{},{"nodeType":668,"value":1308,"marks":1309,"data":1310}," is a comprehensive SEO toolkit that provides keyword research functionality via its “Keyword Overview” tool. ",[],{},{"nodeType":876,"data":1312,"content":1313},{},[1314],{"nodeType":668,"value":1315,"marks":1316,"data":1317},"Comparison to Google Trends ",[],{},{"nodeType":664,"data":1319,"content":1320},{},[1321,1325,1329,1334],{"nodeType":668,"value":887,"marks":1322,"data":1324},[1323],{"type":890},{},{"nodeType":668,"value":1326,"marks":1327,"data":1328}," Semrush ",[],{},{"nodeType":668,"value":1330,"marks":1331,"data":1333},"doesn’t match",[1332],{"type":890},{},{"nodeType":668,"value":1335,"marks":1336,"data":1337}," Google Trends: it didn’t catch the January/September spikes and shows a surge mid-year that didn’t happen.  ",[],{},{"nodeType":687,"data":1339,"content":1351},{"target":1340},{"id":1341,"title":1342,"description":15,"file":1343},"5kWfxEeW2lo5WEJ0XZwaeZ","semrush keto trend",{"url":1344,"details":1345,"fileName":1350,"contentType":23},"//images.ctfassets.net/k13vf0bl293r/5kWfxEeW2lo5WEJ0XZwaeZ/37bcdcfabbf57d802ef487bf2351797c/semrush_keto_trend.png",{"size":1346,"image":1347},28627,{"width":1348,"height":1349},2100,800,"semrush keto trend.png",[],{"nodeType":664,"data":1353,"content":1354},{},[1355,1359],{"nodeType":668,"value":923,"marks":1356,"data":1358},[1357],{"type":890},{},{"nodeType":668,"value":928,"marks":1360,"data":1361},[],{},{"nodeType":664,"data":1363,"content":1364},{},[1365],{"nodeType":668,"value":1366,"marks":1367,"data":1368},"Yes, Semrush provides absolute search volume for any given month since 2012, though not in one graph.",[],{},{"nodeType":664,"data":1370,"content":1371},{},[1372],{"nodeType":668,"value":954,"marks":1373,"data":1375},[1374],{"type":890},{},{"nodeType":664,"data":1377,"content":1378},{},[1379],{"nodeType":668,"value":1380,"marks":1381,"data":1382},"No, Semrush provides extensive long-tail results, but doesn’t recommend semantically-related trends, limiting true trend discovery. ",[],{},{"nodeType":876,"data":1384,"content":1385},{},[1386],{"nodeType":668,"value":988,"marks":1387,"data":1388},[],{},{"nodeType":995,"data":1390,"content":1391},{},[1392,1407,1422,1437,1452],{"nodeType":705,"data":1393,"content":1394},{},[1395],{"nodeType":664,"data":1396,"content":1397},{},[1398,1403],{"nodeType":668,"value":1399,"marks":1400,"data":1402},"Difficulty ranking: ",[1401],{"type":890},{},{"nodeType":668,"value":1404,"marks":1405,"data":1406},"How difficult it would be for a website to rank organically in the Google top 10. ",[],{},{"nodeType":705,"data":1408,"content":1409},{},[1410],{"nodeType":664,"data":1411,"content":1412},{},[1413,1418],{"nodeType":668,"value":1414,"marks":1415,"data":1417},"Intent categorization: ",[1416],{"type":890},{},{"nodeType":668,"value":1419,"marks":1420,"data":1421},"Understand the intent behind searches. ",[],{},{"nodeType":705,"data":1423,"content":1424},{},[1425],{"nodeType":664,"data":1426,"content":1427},{},[1428,1433],{"nodeType":668,"value":1429,"marks":1430,"data":1432},"CPC:",[1431],{"type":890},{},{"nodeType":668,"value":1434,"marks":1435,"data":1436}," Average price advertisers pay for a user’s click on an ad triggered by the chosen keyword. ",[],{},{"nodeType":705,"data":1438,"content":1439},{},[1440],{"nodeType":664,"data":1441,"content":1442},{},[1443,1448],{"nodeType":668,"value":1444,"marks":1445,"data":1447},"Long-tails",[1446],{"type":890},{},{"nodeType":668,"value":1449,"marks":1450,"data":1451},": Variations of the seed keyword or keyword phrase in any order. ",[],{},{"nodeType":705,"data":1453,"content":1454},{},[1455],{"nodeType":664,"data":1456,"content":1457},{},[1458,1463],{"nodeType":668,"value":1459,"marks":1460,"data":1462},"SERP analysis:",[1461],{"type":890},{},{"nodeType":668,"value":1464,"marks":1465,"data":1466}," Top 100 Google results that appear for the keyword.",[],{},{"nodeType":876,"data":1468,"content":1469},{},[1470],{"nodeType":668,"value":1471,"marks":1472,"data":1473},"Pros: ",[],{},{"nodeType":995,"data":1475,"content":1476},{},[1477,1492,1507],{"nodeType":705,"data":1478,"content":1479},{},[1480],{"nodeType":664,"data":1481,"content":1482},{},[1483,1488],{"nodeType":668,"value":1484,"marks":1485,"data":1487},"Accurate monthly volumes:",[1486],{"type":890},{},{"nodeType":668,"value":1489,"marks":1490,"data":1491}," Provides generally accurate search volumes for the past month on most keywords, including long-tails. ",[],{},{"nodeType":705,"data":1493,"content":1494},{},[1495],{"nodeType":664,"data":1496,"content":1497},{},[1498,1503],{"nodeType":668,"value":1499,"marks":1500,"data":1502},"Extensive long-tails:",[1501],{"type":890},{},{"nodeType":668,"value":1504,"marks":1505,"data":1506}," “Keyword Magic” tool to find an abundance of long-tail variations. ",[],{},{"nodeType":705,"data":1508,"content":1509},{},[1510],{"nodeType":664,"data":1511,"content":1512},{},[1513,1518],{"nodeType":668,"value":1514,"marks":1515,"data":1517},"Geographic:",[1516],{"type":890},{},{"nodeType":668,"value":1519,"marks":1520,"data":1521}," Local and global keyword data with high degree of precision, useful for local SEO purposes. ",[],{},{"nodeType":876,"data":1523,"content":1524},{},[1525],{"nodeType":668,"value":1526,"marks":1527,"data":1528},"Cons:",[],{},{"nodeType":995,"data":1530,"content":1531},{},[1532,1568,1583,1598],{"nodeType":705,"data":1533,"content":1534},{},[1535],{"nodeType":664,"data":1536,"content":1537},{},[1538,1543,1547,1555,1559,1564],{"nodeType":668,"value":1539,"marks":1540,"data":1542},"Not real-time:",[1541],{"type":890},{},{"nodeType":668,"value":1544,"marks":1545,"data":1546}," Search volumes are updated infrequently. For example, ",[],{},{"nodeType":715,"data":1548,"content":1550},{"uri":1549},"https://www.sara-taher.com/case-study-seo-for-trending-topics/",[1551],{"nodeType":668,"value":1552,"marks":1553,"data":1554},"this third-party case study",[],{},{"nodeType":668,"value":1556,"marks":1557,"data":1558}," shows how SEMRush showed ",[],{},{"nodeType":668,"value":1560,"marks":1561,"data":1563},"zero search volume for ChatGPT",[1562],{"type":890},{},{"nodeType":668,"value":1565,"marks":1566,"data":1567}," for more than six weeks after it went viral. ",[],{},{"nodeType":705,"data":1569,"content":1570},{},[1571],{"nodeType":664,"data":1572,"content":1573},{},[1574,1579],{"nodeType":668,"value":1575,"marks":1576,"data":1578},"Poor trend discovery:",[1577],{"type":890},{},{"nodeType":668,"value":1580,"marks":1581,"data":1582}," Only provides long-tail data, limiting true trend discovery. ",[],{},{"nodeType":705,"data":1584,"content":1585},{},[1586],{"nodeType":664,"data":1587,"content":1588},{},[1589,1594],{"nodeType":668,"value":1590,"marks":1591,"data":1593},"No growth metrics:",[1592],{"type":890},{},{"nodeType":668,"value":1595,"marks":1596,"data":1597}," Difficult to tell how a topic has grown over time, especially with an inaccurate trend graph. ",[],{},{"nodeType":705,"data":1599,"content":1600},{},[1601],{"nodeType":664,"data":1602,"content":1603},{},[1604,1609],{"nodeType":668,"value":1605,"marks":1606,"data":1608},"Inaccurate trend graph:",[1607],{"type":890},{},{"nodeType":668,"value":1610,"marks":1611,"data":1612}," As seen with the comparison to Google Trends, Semrush shows inaccurate search interest over time. ",[],{},{"nodeType":876,"data":1614,"content":1615},{},[1616],{"nodeType":668,"value":1242,"marks":1617,"data":1618},[],{},{"nodeType":664,"data":1620,"content":1621},{},[1622],{"nodeType":668,"value":1623,"marks":1624,"data":1625},"Starts at $140/mo.",[],{},{"nodeType":876,"data":1627,"content":1628},{},[1629],{"nodeType":668,"value":1630,"marks":1631,"data":1632},"Who should use Semrush’s Keyword Overview?",[],{},{"nodeType":664,"data":1634,"content":1635},{},[1636],{"nodeType":668,"value":1637,"marks":1638,"data":1639},"Ideal for someone that wants a larger SEO toolkit with extensive long-tail data, geographic precision, and competitor analysis features, though not the interest over time nor real-time functionality of Google Trends. ",[],{},{"nodeType":822,"data":1641,"content":1642},{},[],{"nodeType":680,"data":1644,"content":1645},{},[1646],{"nodeType":668,"value":1647,"marks":1648,"data":1649},"Google Trends vs Ahrefs [Ahrefs]",[],{},{"nodeType":664,"data":1651,"content":1652},{},[1653,1656,1663],{"nodeType":668,"value":15,"marks":1654,"data":1655},[],{},{"nodeType":715,"data":1657,"content":1659},{"uri":1658},"https://ahrefs.com/",[1660],{"nodeType":668,"value":419,"marks":1661,"data":1662},[],{},{"nodeType":668,"value":1664,"marks":1665,"data":1666}," is an SEO tool that provides keyword research functionality via its “Keyword Explorer.” ",[],{},{"nodeType":876,"data":1668,"content":1669},{},[1670],{"nodeType":668,"value":1315,"marks":1671,"data":1672},[],{},{"nodeType":664,"data":1674,"content":1675},{},[1676,1680,1684,1689],{"nodeType":668,"value":887,"marks":1677,"data":1679},[1678],{"type":890},{},{"nodeType":668,"value":1681,"marks":1682,"data":1683}," Ahrefs ",[],{},{"nodeType":668,"value":1685,"marks":1686,"data":1688},"generally matches",[1687],{"type":890},{},{"nodeType":668,"value":1690,"marks":1691,"data":1692}," Google Trends, catching both the January and September spikes, though the latter shows as much greater. ",[],{},{"nodeType":687,"data":1694,"content":1706},{"target":1695},{"id":1696,"title":1697,"description":15,"file":1698},"2wtpK6FHmqOJyiEhY0iQDg","ahrefs keto trend",{"url":1699,"details":1700,"fileName":1705,"contentType":23},"//images.ctfassets.net/k13vf0bl293r/2wtpK6FHmqOJyiEhY0iQDg/571eccbe986a1cc38d7c82d7e877811b/ahrefs_keto_trend.png",{"size":1701,"image":1702},84503,{"width":1703,"height":1704},2072,891,"ahrefs keto trend.png",[],{"nodeType":664,"data":1708,"content":1709},{},[1710,1714],{"nodeType":668,"value":923,"marks":1711,"data":1713},[1712],{"type":890},{},{"nodeType":668,"value":928,"marks":1715,"data":1716},[],{},{"nodeType":664,"data":1718,"content":1719},{},[1720],{"nodeType":668,"value":1721,"marks":1722,"data":1723},"Yes, Ahrefs provides absolute search volume on a monthly basis as far back as 2015. ",[],{},{"nodeType":664,"data":1725,"content":1726},{},[1727],{"nodeType":668,"value":1728,"marks":1729,"data":1731},"Does it aid trend discovery? ",[1730],{"type":890},{},{"nodeType":664,"data":1733,"content":1734},{},[1735],{"nodeType":668,"value":1736,"marks":1737,"data":1738},"Somewhat. Ahrefs provides a “Related terms” feature that shows topics related to your seed phrase. However, growth rates are only available on the Advanced plan ($449/mo). ",[],{},{"nodeType":876,"data":1740,"content":1741},{},[1742],{"nodeType":668,"value":988,"marks":1743,"data":1744},[],{},{"nodeType":995,"data":1746,"content":1747},{},[1748,1762,1777,1791,1804],{"nodeType":705,"data":1749,"content":1750},{},[1751],{"nodeType":664,"data":1752,"content":1753},{},[1754,1758],{"nodeType":668,"value":1399,"marks":1755,"data":1757},[1756],{"type":890},{},{"nodeType":668,"value":1759,"marks":1760,"data":1761},"How difficult it would be for a website to rank organically in the Google top 10. ",[],{},{"nodeType":705,"data":1763,"content":1764},{},[1765],{"nodeType":664,"data":1766,"content":1767},{},[1768,1773],{"nodeType":668,"value":1769,"marks":1770,"data":1772},"Traffic potential:",[1771],{"type":890},{},{"nodeType":668,"value":1774,"marks":1775,"data":1776}," Amount of organic traffic that the #1 ranking page for a target keyword gets from all the keywords it ranks for.",[],{},{"nodeType":705,"data":1778,"content":1779},{},[1780],{"nodeType":664,"data":1781,"content":1782},{},[1783,1787],{"nodeType":668,"value":1429,"marks":1784,"data":1786},[1785],{"type":890},{},{"nodeType":668,"value":1788,"marks":1789,"data":1790}," Average price advertisers pay for a user’s click on an ad triggered by the target keyword. ",[],{},{"nodeType":705,"data":1792,"content":1793},{},[1794],{"nodeType":664,"data":1795,"content":1796},{},[1797,1801],{"nodeType":668,"value":1444,"marks":1798,"data":1800},[1799],{"type":890},{},{"nodeType":668,"value":1449,"marks":1802,"data":1803},[],{},{"nodeType":705,"data":1805,"content":1806},{},[1807],{"nodeType":664,"data":1808,"content":1809},{},[1810,1815],{"nodeType":668,"value":1811,"marks":1812,"data":1814},"SERP analysis + position history:",[1813],{"type":890},{},{"nodeType":668,"value":1816,"marks":1817,"data":1818}," The top Google results that appear for the keyword and their rankings over time. ",[],{},{"nodeType":876,"data":1820,"content":1821},{},[1822],{"nodeType":668,"value":1107,"marks":1823,"data":1824},[],{},{"nodeType":995,"data":1826,"content":1827},{},[1828,1842,1856],{"nodeType":705,"data":1829,"content":1830},{},[1831],{"nodeType":664,"data":1832,"content":1833},{},[1834,1838],{"nodeType":668,"value":1160,"marks":1835,"data":1837},[1836],{"type":890},{},{"nodeType":668,"value":1839,"marks":1840,"data":1841}," Data extends as far back as 2015. ",[],{},{"nodeType":705,"data":1843,"content":1844},{},[1845],{"nodeType":664,"data":1846,"content":1847},{},[1848,1852],{"nodeType":668,"value":1120,"marks":1849,"data":1851},[1850],{"type":890},{},{"nodeType":668,"value":1853,"