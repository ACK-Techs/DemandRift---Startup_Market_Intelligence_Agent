"]}]\n14:null\n20:[\"$\",\"div\",null,{\"className\":\"nice-group skin-gray max-width-1440\",\"id\":\"catalog-hero\",\"style\":{},\"children\":[\"$@28\"]}]\n29:T1297,\u003cscript type=\"application/ld+json\"\u003e{  \"@context\": \"https://schema.org\",  \"@graph\": [    {      \"@type\": \"Product\",      \"@id\": \"https://www.nice.com/products#product\",      \"name\": \"NiCE CX AI platform\",      \"url\": \"https://www.nice.com/products\",      \"brand\": {        \"@type\": \"Brand\",        \"name\": \"NiCE\"      },      \"category\": \"Contact Center Software\",      \"sameAs\": [        \"https://www.trustradius.com/products/nice-cxone/reviews\"      ],      \"aggregateRating\": {        \"@type\": \"AggregateRating\",        \"ratingValue\": 8.6,        \"bestRating\": 10,        \"worstRating\": 1,        \"ratingCount\": 951,        \"reviewCount\": 951      }    },    {      \"@type\": \"FAQPage\",      \"@id\": \"https://www.nice.com/products#faq\",      \"mainEntity\": [        {          \"@type\": \"Question\",          \"name\": \"What is the NiCE CX AI platform?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"The NiCE CX AI platform is a customer experience platform designed to orchestrate human and AI agents, automate customer interactions, empower the workforce, and improve experiences across every point of engagement.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What does Agentic Experience Automation do?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Agentic Experience Automation goes beyond answering questions by automating customer intent through fulfillment, helping organizations resolve needs faster and more completely.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What are AI Agents for Self-Service?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"AI Agents for Self-Service let organizations create no-code AI agents powered by their own data, making it possible to build once and deploy across multiple channels.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"How do AI Agents for Proactive Engagement help businesses?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"AI Agents for Proactive Engagement help businesses keep customers engaged in conversation across onboarding, installation, service, and retention, reducing friction and improving continuity.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What is the role of Knowledge Management in customer experience?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Knowledge Management activates AI-powered enterprise knowledge so organizations can increase self-service resolution rates, improve consistency, and strengthen customer loyalty.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What is Engagement Orchestration?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Engagement Orchestration helps organizations move beyond interaction management to coordinate workflows across the enterprise, connecting systems, people, and processes from intent to fulfillment.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"How does Omnichannel Routing improve customer service?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Omnichannel Routing improves customer service by matching customers to the right agents more intelligently, helping reduce wait times and increase conversions.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What does Workforce Management help organizations achieve?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Workforce Management uses AI-based forecasting and scheduling to help organizations maintain service levels, optimize staffing, and control operational costs.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"How does Interaction Analytics support continuous improvement?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Interaction Analytics provides AI-powered insights from 100 percent of interactions, helping organizations uncover trends, identify opportunities, and continuously improve customer experience and agent performance.\"          }        },        {          \"@type\": \"Question\",          \"name\": \"What do Copilot for Agents and Copilot for Supervisors do?\",          \"acceptedAnswer\": {            \"@type\": \"Answer\",            \"text\": \"Copilot for Agents helps customer service agents improve productivity and engagement with AI assistance, while Copilot for Supervisors helps supervisors drive focus, productivity, and performance across teams.\"          }        }      ]    }  ]}\u003c/script\u003e21:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$29\"}}]\n22:[\"$\",\"div\",null,{\"style\":{},\"className\":\" if-pattern \",\"children\":[\"$@2a\"]}]\n23:[\"$\",\"div\",null,{\"className\":\"nice-group skin-default max-width-1440\",\"id\":\"\",\"style\":{},\"children\":[\"$@2b\"]}]\n24:[\"$\",\"div\",null,{\"className\":\"nice-group skin-default max-width-none\",\"id\":\"\",\"style\":{},\"children\":[\"$@2c\",\"$@2d\"]}]\n25:[\"$\",\"div\",null,{\"className\":\"nice-group skin-default max-width-none\",\"id\":\"analyst-perspective\",\"style\":{},\"children\":[\"$@2e\"]}]\n26:[\"$\",\"div\",null,{\"className\":\"nice-group skin-default max-width-none\",\"id\":\"\",\"style\":{},\"children\":false}]\n27:[\"$\",\"div\",null,{\"className\":\"nice-group skin-black max-width-none\",\"