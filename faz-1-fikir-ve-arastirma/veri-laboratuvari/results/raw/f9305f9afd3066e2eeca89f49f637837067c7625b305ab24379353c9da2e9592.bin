box;}#pillars {  color: var(--black);  background: #F2F0EB;  line-height: 1.5;  -webkit-font-smoothing: antialiased;  padding: 64px 0;}#pillars a {  color: inherit;  text-decoration: none;}#pillars .frame {  max-width: 1320px;  margin: 0 auto;  padding: 0 32px;}#pillars .pillars-intro {  text-align: left;  margin: 0 0 45px;}#pillars .eyebrow {  font-weight: 500;  font-size: 16px;  text-transform: uppercase;  color: var(--black);  line-height: 1.2;  margin: 0 0 16px;}#pillars .display {  font-weight: 500;  font-size: 54px;  line-height: 1.2;  letter-spacing: -1.62px;  margin: 0 0 24px;  color: var(--black);}#pillars .lead {  font-weight: 400;  font-size: 26px;  line-height: 1.5;  color: var(--black);  margin: 30px 0 0 0;  max-width: 880px;}#pillars .pillar-cards {  display: grid;  grid-template-columns: repeat(3, minmax(0, 1fr));  gap: 22px;  width: 100%;}#pillars .pcard {  background: #fff;  border-radius: 32px;  overflow: hidden;  display: flex;  flex-direction: column;  min-height: 475px;  padding: 0;  border: 0;  transition: transform 220ms ease, box-shadow 220ms ease;}#pillars .pcard:hover {  transform: translateY(-3px);  box-shadow: 0 18px 45px rgba(0,0,0,.08);}#pillars .pcard-image {  width: 100%;  height: 245px;  overflow: hidden;  background: #dbeafe;  border-radius: 32px;}#pillars .pcard-image img {  width: 100%;  height: 100%;  object-fit: cover;  object-position: center center;  display: block;}#pillars .pcard-body {  padding: 26px 30px 32px;  display: flex;  flex-direction: column;  flex: 1;}#pillars .pcard h3 {  font-weight: 500;  font-size: 25px;  line-height: 1.20;  letter-spacing: -0.4px;  margin: 0 0 15px;  color: var(--black);}#pillars .pcard .blurb {  font-size: 16px;  line-height: 1.45;  color: var(--black);  opacity: 0.68;  margin: 0 0 24px;}#pillars .pcard-foot {  margin-top: auto;}#pillars .pcard-foot a {  color: #fff;}@media (min-width: 1185px) and (max-width: 1250px) {  #pillars .pcard-image {  height: 210px;}#pillars .display {    font-size: 50px;}#pillars .lead {    font-weight: 400;    font-size: 24px;    margin: 0;}#pillars .pcard h3 {    font-size: 24px;    line-height: 1.3;}}/*end of 1185-1250px*/@media (min-width: 1025px) and (max-width: 1184px) {  #pillars .pcard-image {  height: 172px;}#pillars .display {    font-size: 42px;}#pillars .lead {    font-weight: 400;    font-size: 20px;    margin: 0;}#pillars .pcard h3 {    font-size: 20px;}#pillars .pcard .blurb {    font-size: 14px;}#pillars .pcard {    min-height: 445px;}}/*end of 1025-1184px*/@media (max-width: 1024px) {  #pillars {    padding: 56px 0;  }  #pillars .pillar-cards {    grid-template-columns: repeat(2, 1fr);    gap: 20px;  }  #pillars .lead {    font-size: 19px;  }  #pillars .pcard {    min-height: 500px;  }  #pillars .pcard-image {    height: 240px;  }  #pillars .pcard-body {    padding: 24px;  }  #pillars .pcard h3 {    font-size: 20px;  }  #catalog-hero {    padding-top: 80px;  }}@media (max-width: 767px){  #catalog-hero {    margin-top: 80px;  }}@media (min-width: 721px) and (max-width: 800px){#pillars .pcard-image {  height: 195px;}#pillars .display {    font-size: 42px;}#pillars .lead {    font-weight: 400;    font-size: 20px;    margin: 0;}}@media (min-width: 600px) and (max-width: 720px){#pillars .pillar-cards {    grid-template-columns: repeat(2, 1fr);    gap: 20px;  }#pillars .pcard-image {  height: 170px;}#pillars .display {    font-size: 36px;}#pillars .lead {    font-weight: 400;    font-size: 19px;    margin: 0;}}@media (max-width: 599px) {  #pillars {    padding-top: 110px;    padding-bottom: 44px;  }  #pillars .frame {    padding: 0 24px;  }  #pillars .display,  #pillars .pillars-intro h2 {    font-size: 36px;    letter-spacing: -0.8px;  }  #pillars .pillars-intro {    margin-bottom: 38px;  }  #pillars .pillar-cards {    grid-template-columns: 1fr;    gap: 20px;  }  #pillars .pcard {    min-height: 480px;    border-radius: 28px;  }  #pillars .pcard-image {    height: 240px;  }  #pillars .pcard h3 {    font-size: 20px;    line-height: 1.2;  }}@media (min-width: 500px) and (max-width: 599px){#pillars .pcard-image {  height: 285px;}}@media (min-width: 451px) and (max-width: 499px){#pillars .pcard-image {  height: 240px;}}@media (min-width: 360px) and (max-width: 450px){#pillars .pcard-image {  height: 200px;}}@media (max-width: 359px){#pillars .pcard-image {  height: 160px;}}\u003c/style\u003e\u003csection class=\"pillars\" id=\"pillars\"\u003e  \u003cdiv class=\"frame\"\u003e    \u003cdiv class=\"pillars-intro\"\u003e      \u003ch1 class=\"eyebrow\"\u003eAI Customer Experience Solutions\u003c/h1\u003e      \u003ch2 class=\"display\"\u003eAll Products\u003c/h2\u003e      \u003ch3 class=\"lead\"\u003e        Automate experiences, orchestrate engagement across channels, and empower the workforce on a shared AI platform foundation.      \u003c/h3\u003e    \u003c/div\u003e    \u003cdiv class=\"pillar-cards\"\u003e      \u003carticle class=\"pcard pcard--auto\"\u003e        \u003cdiv class=\"pcard-image\"\u003e          \u003cimg src=\"https://resources.nice.com/wp-content/uploads/2026/06/agentic-experience-automation-thumbnail-v4-white-with-logo.jpg\" alt=\"Agentic Experience Automation\"\u003e        \u003c/div\u003e        \u003cdiv class=\"pcard-body\"\u003e          \u003ch3\u003eAgentic Experience Automation\u003c/h3\u003e          \u003cp class=\"blurb\"\u003e            Go beyond answering questions to fully automate customer intent through fulfillment.          \u003c/p\u003e          \u003cdiv class=\"pcard-foot\"\u003e            \u003ca class=\"button-nice button-black button-arrow\" href=\"https://www.nice.com/products/agentic-experience-automation\"\u003e              Explore            \u003c/a\u003e          \u003c/div\u003e        \u003c/div\u003e      \u003c/article\u003e      \u003carticle class=\"pcard pcard--orch\"\u003e        \u003cdiv class=\"pcard-image\"\u003e          \u003cimg src=\"https://resources.nice.com/wp-content/uploads/2026/06/engagement-orchestration-thumbnail-v5-white-with-logo.jpg\" alt=\"Engagement Orchestration\"\u003e        \u003c/div\u003e        \u003cdiv class=\"pcard-body\"\u003e          \u003ch3\u003eEngagement Orchestration\u003c/h3\u003e          \u003cp class=\"blurb\"\u003e            Evolve from interaction management to workflow orchestration across the entire organization.          \u003c/p\u003e          \u003cdiv class=\"pcard-foot\"\u003e            \u003ca class=\"button-nice button-black button-arrow\" href=\"https://www.nice.com/products/engagement-orchestration\"\u003e              Explore            \u003c/a\u003e          \u003c/div\u003e        \u003c/div\u003e      \u003c/article\u003e      \u003carticle class=\"pcard pcard--empw\"\u003e        \u003cdiv class=\"pcard-image\"\u003e          \u003cimg src=\"https://resources.nice.com/wp-content/uploads/2026/06/workforce-empowerment-thumbnail-v4-white-with-logo.jpg\" alt=\"Workforce Empowerment\"\u003e        \u003c/div\u003e        \u003cdiv class=\"pcard-body\"\u003e          \u003ch3\u003eWorkforce Empowerment\u003c/h3\u003e          \u003cp class=\"blurb\"\u003e            Move beyond tools to empower employees with real-time, actionable intelligence that elevates performance.          \u003c/p\u003e          \u003cdiv class=\"pcard-foot\"\u003e            \u003ca class=\"button-nice button-black button-arrow\" href=\"https://www.nice.com/products/workforce-empowerment\"\u003e              Explore            \u003c/a\u003e          \u003c/div\u003e        \u003c/div\u003e      \u003c/article\u003e    \u003c/div\u003e  \u003c/div\u003e\u003c/section\u003e30:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$37\"}}]\n31:[\"$\",\"div\",null,{\"className\":\"nice-group skin-gray-gradient max-width-none\",\"id\":\"\",\"style\":{},\"children\":[\"$@38\",\"$@39\"]}]\n3a:T4106,\u003cstyle\u003e#cat,#cat * {  box-sizing: border-box;}#cat {  color: var(--black);  line-height: 1.5;  -webkit-font-smoothing: antialiased;}#cat a {  color: inherit;  text-decoration: none;}#cat .frame {  max-width: 1320px;  margin: 0 auto;  padding: 0 32px;}#cat .eyebrow {  font-weight: 600;  font-size: 14px;  text-transform: uppercase;  color: var(--black);  line-height: 1.2;  margin: 0 0 12px;}#cat .heading {  font-weight: 500;  font-size: 40px;  line-height: 1.15;  letter-spacing: -1px;  margin: 0;  color: var(--black);}#cat .catalog-head {  display: flex;  align-items: flex-end;  justify-content: space-between;  gap: 32px;  margin-bottom: 40px;  flex-wrap: wrap;}#cat .catalog-head .left {  max-width: 720px;}#cat .search-wrap {  position: relative;  width: 320px;  flex-shrink: 0;}#cat .search-wrap svg {  position: absolute;  left: 16px;  top: 50%;  transform: translateY(-50%);  color: var(--black);  pointer-events: none;}#cat .catalog-search {  width: 100%;  height: 48px;  padding: 0 16px 0 44px;  border-radius: 2rem;  border: 1px solid var(--gray);  background: #fff;  font-size: 16px;  color: var(--black);}#cat .filter-row {  display: flex;  gap: 8px;  flex-wrap: wrap;  align-items: center;  margin-bottom: 32px;}#cat .chip {  display: inline-flex;  align-items: center;  height: 38px;  padding: 0 16px;  border-radius: 38px;  background: #fff;  border: 1px solid var(--gray);  color: var(--black);  font-size: 14px;  font-weight: 500;  cursor: pointer;}#cat .chip.is-active {  background: var(--black);  color: #fff;  border-color: var(--black);}/* CARD GRID */#cat .product-grid {  display: grid;  grid-template-columns: repeat(3, minmax(0, 1fr));  gap: 24px;}/* PRODUCT CARD */#cat .product-card {  background: #fff;  border: 1px solid #d9d9d9;  border-radius: 34px;  overflow: hidden;  display: flex;  flex-direction: column;  padding: 0;  min-height: 540px;  transition: transform 180ms ease, box-shadow 180ms ease;  position: relative;}#cat .product-card:hover,#cat .product-card:focus-visible {  transform: translateY(-3px);  box-shadow: 0 16px 40px rgba(0,0,0,.08);  outline: none;}/* CARD IMAGE */#cat .product-image {  width: 100%;  height: 245px;  overflow: hidden;  background: #f3f4f6;}#cat .product-image img {  width: 100%;  height: 100%;  object-fit: cover;  display: block;}/* CARD CONTENT */#cat .product-card-content {  position: relative;  flex: 1;  padding: 28px 32px 100px;  background: #fff;  display: flex;  flex-direction: column;}#cat .product-card .tag {  display: inline-flex;  align-items: center;  align-self: flex-start;  padding: 7px 15px;  border-radius: 38px;  font-size: 13px;  font-weight: 500;  background: #f2f0eb;  color: #6D6D72;  text-transform: none;  letter-spacing: 0;}#cat .product-card .name {  margin-top: 18px;  font-weight: 500;  font-size: 22px;  line-height: 1.25;  color: #22212B;  letter-spacing: -0.3px;}#cat .product-card .desc {  margin-top: 14px;  font-size: 15px;  line-height: 1.55;  color: #4b5563;  /*margin-top: 14px;  font-size: 15px;  line-height: 1.55;  color: #4b5563;  display: -webkit-box;  -webkit-line-clamp: 3;  -webkit-box-orient: vertical;  overflow: hidden;*/}/* ROUND ARROW */#cat .product-card .more {  position: absolute;  right: 30px;  bottom: 30px;  width: 54px;  height: 54px;  border-radius: 50%;  background: #22212B;  color: #fff;  display: flex;  align-items: center;  justify-content: center;  font-size: 0;  transition: background-color .25s ease;}#cat .product-card .more svg {  width: 22px;  height: 22px;}/*HOVER*/#cat .product-card:hover .more {  background: #6D6D72;}/* EMPTY STATE */#cat .empty-state {  grid-column: 1 / -1;  padding: 64px 24px;  text-align: center;  color: var(--black);  opacity: 0.7;  font-size: 16px;}/* EXISTING PAGE FIXES */#final-cta h4 {  font-size: 16px;  font-weight: 400;  letter-spacing: 0;}.nice-group.skin-black .section-heading p \u003e a {  margin: 0 0.5rem;}#analyst-perspective {  padding-top: 0 !important;  padding-bottom: 0 !important;}#analyst-perspective .button-large,.nice-group.skin-black .section-heading p \u003e a.button-blue {  color: #fff;}.features.grid-5-col \u003e div,.nice-group .features.grid-5-col {  margin-bottom: 0 !important;}/*LAPTOP*/@media (min-width: 1185px) and (max-width: 1250px){#cat .product-card .name {    font-weight: 500;    font-size: 20px;}}/*end of 1185px-1250px*/@media (min-width: 1025px) and (max-width: 1184px){#cat .product-card .name {    font-weight: 500;    font-size: 20px;}}/*end of 1025-1185px*//* TABLET */@media (max-width: 1024px) {  #cat .frame {    padding: 0 28px;  }  #cat .product-grid {    grid-template-columns: repeat(2, 1fr);  }  #cat .product-card {    min-height: 500px;  }}@media (min-width: 600px) and (max-width: 720px) {  #cat .product-grid {    grid-template-columns: repeat(2, 1fr);    gap: 20px;  }#cat .product-image {    height: 160px;}#cat .product-card .name {    font-size: 19px;}}/* MOBILE */@media (min-width: 549px) and (max-width: 599px){#cat .product-image {    height: 320px;}}@media (min-width: 500px) and (max-width: 548px){#cat .product-image {    height: 290px;}}@media (max-width: 599px) {  #cat {    padding: 72px 0;  }  #cat .frame {    padding: 0 20px;  }  #cat .catalog-head {    flex-direction: column;    align-items: stretch;  }  #cat .search-wrap {    width: 100%;  }  #cat .heading {    font-size: 32px;    letter-spacing: -0.7px;  }  #cat .product-grid {    grid-template-columns: 1fr;  }  #cat .product-card {    min-height: 540px;    border-radius: 28px;  }  #cat .product-card-content {    padding: 24px 26px 86px;  }  #cat .product-card .name {    font-size: 20px;  }  #cat .product-card .more {    right: 26px;    bottom: 26px;  }}@media (min-width: 431px) and (max-width: 499px){#cat .product-image {    height: 255px;}}@media (max-width: 430px){#cat .product-image {    height: 215px;}}\u003c/style\u003e\u003csection class=\"catalog\" id=\"cat\"\u003e  \u003cdiv class=\"frame\"\u003e    \u003cdiv class=\"catalog-head\"\u003e      \u003cdiv class=\"left\"\u003e        \u003cdiv class=\"eyebrow\"\u003eBrowse all products\u003c/div\u003e        \u003ch2 class=\"heading\"\u003eThe NiCE CXone catalog\u003c/h2\u003e      \u003c/div\u003e      \u003cdiv class=\"search-wrap\"\u003e        \u003csvg fill=\"none\" height=\"16\" viewBox=\"0 0 16 16\" width=\"16\" aria-hidden=\"true\"\u003e          \u003ccircle cx=\"7\" cy=\"7\" r=\"5\" stroke=\"currentColor\" stroke-width=\"1.5\"\u003e\u003c/circle\u003e          \u003cpath d=\"M11 11l3 3\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.5\"\u003e\u003c/path\u003e        \u003c/svg\u003e        \u003cinput class=\"catalog-search\" id=\"catalog-search\" placeholder=\"Search products…\" type=\"text\"\u003e      \u003c/div\u003e    \u003c/div\u003e    \u003cdiv class=\"filter-row\" id=\"filter-row\"\u003e      \u003cbutton class=\"chip is-active\" data-filter=\"all\" type=\"button\"\u003eAll\u003c/button\u003e      \u003cbutton class=\"chip\" data-filter=\"auto\" type=\"button\"\u003eAutomate\u003c/button\u003e      \u003cbutton class=\"chip\" data-filter=\"orch\" type=\"button\"\u003eOrchestrate\u003c/button\u003e      \u003cbutton class=\"chip\" data-filter=\"wfe\" type=\"button\"\u003eEmpower\u003c/button\u003e    \u003c/div\u003e    \u003cdiv class=\"product-grid\" id=\"product-catalog\"\u003e\u003c/div\u003e  \u003c/div\u003e\u003c/section\u003e\u003cscript\u003e(function() {  const cat = document.getElementById('cat');  if (!cat) return;  const products = [    {      name: \"AI Agents for Self-Service\",      desc: \"Instantly create no-code AI agents powered by your data—build once, deploy everywhere.\",      href: \"/products/ai-agents-for-self-service\",      pillar: \"auto\",      label: \"Automate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/03/Agentic-Experience-Automation-product-feature-thumbnail.png\",      tags: [\"ai-agents\"]    },    {      name: \"AI Agents for Sales and Marketing\",      desc: \"Turn every touchpoint into a chance to win new business and build loyalty.\",      href: \"/products/ai-agents-for-sales-and-marketing\",      pillar: \"auto\",      label: \"Automate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/ai-agents-for-sales-and-marketing-thumbnail-image-v2.jpg\",      tags: [\"ai-agents\"]    },    {      name: \"AI Agents for Proactive Engagement\",      desc: \"Keep customers engaged in conversation from onboarding to installation, service, and retention.\",      href: \"/products/ai-agents-for-proactive-engagement\",      pillar: \"auto\",      label: \"Automate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/proactive_ai_agent-thumbnail-v1.jpg\",      tags: [\"ai-agents\"]    },    {      name: \"AI Agents for Process Automation\",      desc: \"AI agents that act instantly, work across systems, and help your business run smarter.\",      href: \"/products/ai-agents-for-process-automation\",      pillar: \"auto\",      label: \"Automate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/agentic-ai-for-process-automation-thumbnail-v1.jpg\",      tags: [\"ai-agents\"]    },    {      name: \"Knowledge Management\",      desc: \"Activate AI-powered enterprise knowledge to increase self-resolution rates and loyalty.\",      href: \"/products/knowledge-management\",      pillar: \"auto\",      label: \"Automate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/knowledge-management-fg-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Digital Experience\",      desc: \"Deliver effortless, consistent, cross-channel customer conversations at scale.\",      href: \"https://www.nice.com/products/digital-customer-experience\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/enligten_ai-thumbnail-v2.jpg\",      tags: []    },    {      name: \"Interactive Voice Response (IVR)\",      desc: \"Let customers quickly get the help they need with easy, automated phone self-service and smarter call routing.\",      href: \"/products/interactive-voice-response-ivr\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/interactive-voice-response-thumbnail-v1.jpg\",      tags: [\"voice\"]    },    {      name: \"Omnichannel Routing\",      desc: \"Reduce wait times and boost conversions with smart customer-agent matching.\",      href: \"/products/omnichannel-routing\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/omnichannel-routing-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Outbound Engagement\",      desc: \"Generate more revenue, minimize hang-ups, and proactively connect to reduce friction.\",      href: \"/products/proactive-outbound-engagement\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/outbound-engagement-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Orchestration\",      desc: \"Unify and optimize every customer service workflow from intent to fulfillment.\",      href: \"/products/orchestration\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/03/Engagement-Orchestration-product-feature-thumbnail.png\",      tags: []    },    {      name: \"Voice Services\",      desc: \"Connect front and back office teams with data, conversations, and workflows together in one place.\",      href: \"/products/voice-services\",      pillar: \"orch\",      label: \"Orchestrate\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/voice-services-thumbnail-v1.jpg\",      tags: [\"voice\"]    },    {      name: \"Workforce Management\",      desc: \"Powerful AI-based forecasting and scheduling to keep SLAs up and costs down.\",      href: \"/products/workforce-management\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/03/Workforce-Empowerment-product-feature-thumbnail_v3.png\",      tags: []    },    {      name: \"Performance Management\",      desc: \"Meet your goals while engaging employees through personal coaching and gamification.\",      href: \"/products/performance-management\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/performance-management-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Recording Management\",      desc: \"Capture 100% of interactions, meet regulatory needs, and drive better performance.\",      href: \"/products/recording-management\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/recording-management-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Quality Management\",      desc: \"Evaluate 100% of interactions with AI and deliver effective coaching to agents.\",      href: \"/products/quality-management\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/quality-management-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Interaction Analytics\",      desc: \"Gain AI-powered insights from 100% of interactions to drive continuous improvement.\",      href: \"/products/interaction-analytics\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/interaction-analytics-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Feedback Management\",      desc: \"Unlock Voice of the Customer insights to enhance experiences, drive loyalty, and boost business growth.\",      href: \"/products/voice-of-the-customer\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/feedback-management-thumbnail-v1.jpg\",      tags: []    },    {      name: \"Copilot for Agents\",      desc: \"Empower customer service agents with an AI companion to drive productivity and engagement.\",      href: \"/products/copilot-for-agents\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/copilot-for-agents-thumbnail-v1.jpg\",      tags: [\"copilot\"]    },    {      name: \"Copilot for Supervisors\",      desc: \"Empower all customer service supervisors to drive focus, productivity, and engagement.\",      href: \"/products/copilot-for-supervisors\",      pillar: \"wfe\",      label: \"Empower\",      image: \"https://resources.nice.com/wp-content/uploads/2026/06/copilot-for-supervisors-thumbnail-v1.jpg\",      tags: [\"copilot\"]    }  ];  const grid = cat.querySelector('#product-catalog');  const search = cat.querySelector('#catalog-search');  const chips = cat.querySelectorAll('#filter-row .chip');  let activeFilter = 'all';  let activeSearch = '';  function escapeHtml(value) {    return String(value).replace(/[\u0026\u003c\u003e\"]/g, function(ch) {      return {        '\u0026': '\u0026amp;',        '\u003c': '\u0026lt;',        '\u003e': '\u0026gt;',        '\"': '\u0026quot;'      }[ch];    });  }  function render() {    const query = activeSearch.toLowerCase();    const filtered = products.filter(function(product) {      const matchFilter =        activeFilter === 'all' ||        product.pillar === activeFilter ||        product.tags.includes(activeFilter);      const matchSearch =        query === '' ||        product.name.toLowerCase().includes(query) ||        product.desc.toLowerCase().includes(query);      return matchFilter \u0026\u0026 matchSearch;    });    if (!filtered.length) {      grid.innerHTML = '\u003cdiv class=\"empty-state\"\u003eNo products match. Try clearing filters.\u003c/div\u003e';      return;    }    grid.innerHTML = filtered.map(function(product) {      return `        \u003ca href=\"${escapeHtml(product.href)}\" class=\"product-card tag-${escapeHtml(product.pillar)}\"\u003e          \u003cdiv class=\"product-image\"\u003e            \u003cimg src=\"${escapeHtml(product.image)}\" alt=\"${escapeHtml(product.name)}\"\u003e          \u003c/div\u003e          \u003cdiv class=\"product-card-content\"\u003e            \u003cspan class=\"tag\"\u003e${escapeHtml(product.label)}\u003c/span\u003e            \u003cdiv class=\"name\"\u003e${escapeHtml(product.name)}\u003c/div\u003e            \u003cdiv class=\"desc\"\u003e${escapeHtml(product.desc)}\u003c/div\u003e            \u003cdiv class=\"more\" aria-hidden=\"true\"\u003e              \u003csvg width=\"22\" height=\"22\" viewBox=\"0 0 12 12\" fill=\"none\"\u003e                \u003cpath d=\"M2.5 6h7M6 2.5L9.5 6 6 9.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003c/path\u003e              \u003c/svg\u003e            \u003c/div\u003e          \u003c/div\u003e        \u003c/a\u003e      `;    }).join('');    if (typeof grid.animate === 'function') {      grid.animate(        [{ opacity: 0.3 }, { opacity: 1 }],        { duration: 220, easing: 'cubic-bezier(.22,.61,.36,1)' }      );    }  }  chips.forEach(function(chip) {    chip.addEventListener('click', function() {      activeFilter = chip.dataset.filter;      chips.forEach(function(item) {        item.classList.toggle('is-active', item === chip);      });      render();    });  });  search.addEventListener('input', function(event) {    activeSearch = event.target.value.trim();    render();  });  render();})();\u003c/script\u003e32:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$3a\"}}]\n33:[\"$\",\"section\",null,{\"className\":\"section-heading max-width-793 skin-default page-products\",\"children\":[[[\"$\",\"$L1f\",null,{\"moduleIds\":[\"10333528928722250504\"]}],[\"$\",\"$L3b\",null,{}]],[\"$\",\"div\",null,{\"className\":\"mx-auto my-[30px] text-center px-6\",\"children\":[\"$@3c\",\"$@3d\"]}]]}]\n34:[\"$\",\"div\",null,{\"style\":{},\"className\":\" if-pattern \",\"children\