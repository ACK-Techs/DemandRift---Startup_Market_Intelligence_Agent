          background-repeat: no-repeat;
          cursor: pointer;
        }

        header.mobile-menu-shown .mobile-menu::after {
          background-image: url(/wp-content/themes/smartrecruiters/img/2023/close-icon.svg);
          width: 20px;
          height: 20px;
          right: 10px;
        }
