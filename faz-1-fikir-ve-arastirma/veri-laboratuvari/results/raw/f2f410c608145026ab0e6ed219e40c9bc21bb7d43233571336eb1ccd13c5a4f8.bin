                display: block;
                max-width: 80%;
                margin: 20px auto;
            }

            .bodyContent.wForm .chat-box-text h6 {
                text-align: left;
            }

            .chat-box-text {
                display: block;
                max-width: 90%;
                padding: 20px 0;
                margin: 0 auto;
            }
        }
