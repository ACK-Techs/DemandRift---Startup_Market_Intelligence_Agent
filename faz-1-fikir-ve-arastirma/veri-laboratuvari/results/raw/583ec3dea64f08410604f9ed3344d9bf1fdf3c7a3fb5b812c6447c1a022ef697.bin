<script>
(function() {
    var googleClientId = "649254735434-ps1kpun36vvn6t0pb0obmuc63d5t9bus.apps.googleusercontent.com";
    var verifyUrl = "https:\/\/www.softwaresuggest.com\/social_login\/GooglePlus\/verify_credential.php";

    function handleGoogleOneTap(response) {
        if (!response || !response.credential) {
            return;
        }

        fetch(verifyUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({
                credential: response.credential
            })
        })
        .then(function(res) {
            return res.json();
        })
        .then(function(data) {
            if (data.success && data.redirect) {
                window.location.href = data.redirect;
            }
        })
        .catch(function() {});
    }

    function initGoogleOneTap() {
        if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) {
            setTimeout(initGoogleOneTap, 100);
            return;
        }

        google.accounts.id.initialize({
            client_id: googleClientId,
            callback: handleGoogleOneTap,
            auto_select: false,
            cancel_on_tap_outside: true,
            context: 'signin',
            itp_support: true
        });

        google.accounts.id.prompt();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGoogleOneTap);
    } else {
        initGoogleOneTap();
    }
})();
</script>
