__cwVo7a__copyright">© 2026 Notion Labs, Inc.</p></div></div></footer></div></div></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"faqGroup":{"metadata":{"tags":[{"sys":{"type":"Link","linkType":"Tag","id":"newLanguageLaunch"}},{"sys":{"type":"Link","linkType":"Tag","id":"requestTranslation"}}],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"4hal3qTg6H49kn247PRRE9","type":"Entry","createdAt":"2022-10-24T16:43:41.485Z","updatedAt":"2026-05-18T09:31:04.846Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":87,"revision":12,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faqGroup"}},"locale":"en-US"},"fields":{"name":"Pricing Page FAQs","cta":"guides","faqs":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"1I2uOGgrFxSCGIoIriWxNg","type":"Entry","createdAt":"2023-02-13T18:49:39.354Z","updatedAt":"2026-05-18T09:31:05.016Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":1659,"revision":455,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How does Notion AI use my data?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"We follow our standard ","nodeType":"text"},{"data":{"uri":"https://notion.so/security"},"content":[{"data":{},"marks":[],"value":"data protection practices","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" to keep your data encrypted and private. Notion AI will not use your data to train our models unless you opt in to a request to share your data.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Any information used to power Notion AI will be shared with AI subprocessors for the sole purpose of providing you with the Notion AI features. We specifically have contractual agreements in place with our AI subprocessors that prohibit the use of customer data to train their models. ","nodeType":"text"},{"data":{"uri":"https://www.notion.so/help/notion-ai-security-practices"},"content":[{"data":{},"marks":[],"value":"Learn more about Notion AI security and privacy practices here","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"toggle":true}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"4CQJklxY3fi5jQtZkLusS0","type":"Entry","createdAt":"2022-11-04T18:07:43.974Z","updatedAt":"2026-05-18T09:31:05.130Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":121,"revision":39,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"Where can I find my invoices?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Workspace admins can access, view, and download your workspace's invoices by going to ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Settings \u0026 members","nodeType":"text"},{"data":{},"marks":[],"value":" → ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Billing","nodeType":"text"},{"data":{},"marks":[],"value":", then scrolling to ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Invoices","nodeType":"text"},{"data":{},"marks":[],"value":". There you can click on \"View invoice\" to see the invoice PDF.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"74gyrC8QUPyRP8VpnCieXs","type":"Entry","createdAt":"2022-11-04T17:59:38.552Z","updatedAt":"2026-05-18T09:31:05.319Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":98,"revision":31,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What are your accepted payment methods?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"We currently accept all major credit and debit card brands.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"toggle":true}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"3H5UG7OqEFJ1aF5tHVUBXs","type":"Entry","createdAt":"2021-06-08T20:37:44.301Z","updatedAt":"2026-09-17T04:51:59.922Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3225,"revision":629,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What is a block?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"A block is any single piece of content you add to your page, like a paragraph of text, a to-do item, an image, a code block, an embedded file, etc. Think of your page as being made up of these building blocks. Learn more about blocks ","nodeType":"text"},{"data":{"uri":"https://www.notion.com/help/what-is-a-block"},"content":[{"data":{},"marks":[],"value":"here →","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"618A4SKOageKbSLr3VVXNr","type":"Entry","createdAt":"2021-06-08T20:38:16.844Z","updatedAt":"2026-05-18T09:31:05.430Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":135,"revision":33,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What happens when I go over the block storage limit on a Free Plan?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"If you’re using a Free Plan workspace by yourself, you’ll be able to add as many pages and blocks as you like.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"If you’re using a Free Plan workspace with multiple members, you’ll be able to add a limited number of blocks before you have to upgrade. ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"When you reach the limit, you can still read, edit, and organize existing content blocks as usual, but you won’t be able to add new content blocks.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"5cHk2HGnIyEl1JiVsjtMae","type":"Entry","createdAt":"2021-06-08T20:37:44.238Z","updatedAt":"2026-09-17T04:52:02.742Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3306,"revision":638,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"Do you offer student discounts?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"The Plus Plan (with a 1-member limit) is free for students and educators. Compared to the Free Plan, you’ll be able to add more guests, have access to more version history, and upload larger files.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Just sign up with your school email address and you’ll immediately gain access to these features. Thousands of school email domains are eligible, not just .edu!","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"For more info \u0026 FAQs, ","nodeType":"text"},{"data":{"uri":"https://www.notion.so/help/notion-for-education"},"content":[{"data":{},"marks":[],"value":"visit the Notion for Education page","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"2D8JSHNWMJMQ2kMR9XmhYo","type":"Entry","createdAt":"2023-05-12T17:59:01.932Z","updatedAt":"2026-05-18T09:31:05.476Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":168,"revision":47,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What do the different analytics tiers mean?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Basic page analytics (Free and Plus Plans): ","nodeType":"text"},{"data":{},"marks":[],"value":"Includes a list of page viewers as well as a chart displaying views over time.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Advanced page analytics","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"(Business Plan): ","nodeType":"text"},{"data":{},"marks":[],"value":"Includes everything above as well as a list of page editors.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Workspace analytics (Enterprise Plan):","nodeType":"text"},{"data":{},"marks":[],"value":" Includes everything above as well as user level analytics, analytics on all pages in your workspace, and search analytics for content in your workspace.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"5J9NwL24JTj9ZIyeuvnY7l","type":"Entry","createdAt":"2021-06-08T20:37:43.244Z","updatedAt":"2026-09-17T04:52:04.066Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3265,"revision":657,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How is pricing calculated for the paid plans?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"If you upgrade your workspace to one of the paid plans, you will be charged a fee per member.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Guests are free of charge – but they can only access individual pages they are invited to. In other words, guests won’t be able to see all the team pages under the ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Teamspaces","nodeType":"text"},{"data":{},"marks":[],"value":" section in the left sidebar.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"4pF2ikC7dcPGccPCH9Kk1k","type":"Entry","createdAt":"2022-11-04T18:09:36.185Z","updatedAt":"2026-05-18T09:31:05.575Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":129,"revision":45,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How do I get charged when I add members to my workspace?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"When you add a new member to your workspace, they will use an existing paid seat if you have any available in your workspace. If you do not have any existing available paid seats, your count of paid seats will increase by 1. Changes in membership that occur mid-month will create prorated charges based on the amount of time remaining in the billing cycle when the paid seat was added.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"For every member you delete from your workspace, you will open up 1 available paid seat. This means you have the option to exchange members in your workspace without paying any additional costs, as long as your total billable seat count remains the same.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"You’ll receive an invoice for any charges accrued by changes in membership on your selected payment method, on the day of the month you initially signed up for your subscription.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Each time your billing period starts (monthly or annual), your count of paid seats will be synchronized so it exactly matches the amount of members present in your workspace.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"toggle":true}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"2yZaVAxFTGNmm8BvMbIgte","type":"Entry","createdAt":"2021-06-08T20:37:42.262Z","updatedAt":"2026-09-17T04:52:06.416Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3233,"revision":643,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How does adding and removing members work?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Whether you're on a monthly or yearly billing schedule, your account may be charged on a monthly basis if you make changes in membership. If you added members, your account will be charged a prorated amount based on the percentage of the billing cycle left when a user was added. If you removed members, you will not receive credit but instead will still have use of that seat for a different user for the remainder of the billing period.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"3WQ2fC5kRq0fRGois9oLjN","type":"Entry","createdAt":"2024-09-16T00:00:02.479Z","updatedAt":"2026-05-18T09:31:05.647Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":55,"revision":11,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How are paid seats counted?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"A paid seat can be thought of as a license for one member to use your Notion workspace. Workspace owners can view the total paid seat count for their workspace by going to ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Settings \u0026 members","nodeType":"text"},{"data":{},"marks":[],"value":" \u003e ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Billing","nodeType":"text"},{"data":{},"marks":[],"value":". Once you have added a paid seat, you will keep it for the duration of your billing period.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"When your billing cycle renews, either monthly or annually, you will be charged for your plan amount multiplied by the number of members in your workspace, plus any prorated charges for new paid seats added in the past month. Your number of paid seats will be recalculated at each renewal to match the number of members present in the workspace.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"3ghtrYWQEVogAZBfYpVtpW","type":"Entry","createdAt":"2021-06-08T20:37:42.467Z","updatedAt":"2026-09-17T04:52:07.726Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3212,"revision":595,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What happens when I change plans?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Upgrading your plan:","nodeType":"text"},{"data":{},"marks":[],"value":" Your account will be upgraded and charged immediately. The amount due will be reduced based on the percentage of the billing cycle left at the time the plan was changed.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Downgrading your plan: ","nodeType":"text"},{"data":{},"marks":[],"value":"Your account will be downgraded at the end of your billing cycle. Learn about how your features may be impacted after a downgrade ","nodeType":"text"},{"data":{"uri":"https://notion.com/help/plan-downgrade"},"content":[{"data":{},"marks":[],"value":"here →","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"1J8zZ0IXbNRUVq5JYVU6yC","type":"Entry","createdAt":"2021-06-08T20:37:42.285Z","updatedAt":"2026-09-17T04:52:08.997Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3223,"revision":678,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How do I cancel my paid plan?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Your Notion subscription, annual or monthly, will automatically renew until you cancel it. You can cancel your subscription by going to ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Settings","nodeType":"text"},{"data":{},"marks":[],"value":" in the left-hand sidebar on a desktop computer, then selecting ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Billing","nodeType":"text"},{"data":{},"marks":[],"value":", then ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"Change plan","nodeType":"text"},{"data":{},"marks":[],"value":". After you cancel, you’ll still have access to all the paid features until the end of your billing cycle.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Learn more about billing in ","nodeType":"text"},{"data":{"uri":"https://www.notion.com/help/billing"},"content":[{"data":{},"marks":[],"value":"this article","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"5sJ6QUFKiZgXzj6t03uT6A","type":"Entry","createdAt":"2021-06-08T20:37:42.252Z","updatedAt":"2026-09-17T04:52:11.946Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3274,"revision":649,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What happens if my payment fails? Like if my credit card expires?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Your account email will be notified after each failed payment. Payments may be retried up to 8 times within the next month. ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"After this, if the payment did not succeed, your workspace will get restricted to limited-access for a period of time before being downgraded to the Free plan.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"6bEIku3iF2m7YNP37dmt6Y","type":"Entry","createdAt":"2021-06-08T20:37:42.246Z","updatedAt":"2026-09-17T04:52:13.068Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3212,"revision":618,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"Can I change my payment method?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"You can change your payment method at any time in your billing settings.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"2y7D5K11HI66dHQUtHfijk","type":"Entry","createdAt":"2021-06-08T20:37:42.263Z","updatedAt":"2026-09-17T04:52:14.483Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2872,"revision":563,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"How do refunds work?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Our refund policy is simple. If you believe you've made a mistake signing up for a paid Notion subscription online or in-app, please contact us inside the app or email ","nodeType":"text"},{"data":{"uri":"mailto:team@makenotion.com"},"content":[{"data":{},"marks":[],"value":"team@makenotion.com","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":". We'll be happy to refund you the full amount (not pro-rated) if you downgrade your subscription within three days of signing up for monthly billing, or within 30 days of signing up for annual billing.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"If you have accidentally added members to your workspace, you can remove those members at any time. If you’ve been charged for members who were accidentally added, we're happy to provide a refund of the prorated charges if you reach out within three days of the invoice date (please make sure the additional members have been removed from your workspace when writing in).","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"And if for any reason you're unhappy with Notion, please let us know at ","nodeType":"text"},{"data":{"uri":"mailto:team@makenotion.com"},"content":[{"data":{},"marks":[],"value":"team@makenotion.com","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" — we'd love to hear your feedback, and will be happy to work with you to create the best experience possible.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"spoqsaf9291f"}},"id":"3Jw0LOnWd1i2rOLKy7PvZZ","type":"Entry","createdAt":"2021-06-08T20:37:44.059Z","updatedAt":"2026-05-18T09:31:05.772Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":118,"revision":34,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"faq"}},"locale":"en-US"},"fields":{"title":"What if I live in a region with a mandatory refund policy?","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"If you live in the European Union, United Kingdom, or another region with a mandatory refund policy, you may be eligible for a monthly subscription refund past 72 hours. For example, customers in the European Union can receive a full refund for a monthly subscription within 14 days of purchase, rather than 72 hours.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"To request a refund, please contact us inside the app or email ","nodeType":"text"},{"data":{"uri":"mailto:team@makenotion.com"},"content":[{"data":{},"marks":[],"value":"team@makenotion.com","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":". If you live in a region with a mandatory refund policy, please let us know and we'll be happy to assist you.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}}]}},"logoWall":{"eyebrow":"Trusted by teams at","logos":[{"name":"OpenAI","href":"/customers/openai","logoMonoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/6gu2Rybt4VdhS2GEEA99PO/ac0fedd553b2f541fde79cdda05271cc/OpenAI.svg"},"logoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/6gu2Rybt4VdhS2GEEA99PO/ac0fedd553b2f541fde79cdda05271cc/OpenAI.svg"},"id":"open-ai"},{"name":"Figma","href":"/customers/figma","logoMonoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/6T4QxYfpIzIbZgWUSa5Rb1/8c6cb40bbf2304f8486222d777314b83/Figma_Wordmark__Black_.svg"},"logoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/502ApiNcRHgIwrDU8XRYTQ/497492503acb3fa21bbd9dd1aec193c3/Figma-logo-color.svg"},"id":"figma"},{"name":"Volvo","logoMonoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/1TZBxOqNgDNBTJUEkD9Rn2/95219318a8bc7198d69e3fe0190ea94c/Volvo_Spread_Word_Mark_2025_bl.svg"},"logoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/1TZBxOqNgDNBTJUEkD9Rn2/95219318a8bc7198d69e3fe0190ea94c/Volvo_Spread_Word_Mark_2025_bl.svg"},"id":"volvo"},{"name":"Ramp","href":"/customers/ramp","logoMonoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/4KBpzIRuWO9Bkoho07RwHW/7e608b80b697431b92ffb144e545cf3c/Ramp.svg"},"logoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/4KBpzIRuWO9Bkoho07RwHW/7e608b80b697431b92ffb144e545cf3c/Ramp.svg"},"id":"ramp"},{"name":"Cursor","href":"/customers/cursor","logoMonoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/5zvQQUAMUwmWaGbC9qhXpK/633c8d40bbbb2b42faec7ea3339788ff/cursor-logo-mono.svg"},"logoImage":{"src":"https://images.ctfassets.net/spoqsaf9291f/9fIyqzilwFf5UU8mdwFaw/91c6852fa8c1e9ef611b073150cd66e4/cursor-logo.svg"},"id":"cursor"}]},"preview":false,"locale":"en-US","currencies":["USD"],"selectedCurrencyToShow":"USD","plans":{"student":{"USD":{"month":{"external_id":"student_free","product":"student","billing_interval":"month","currency":"USD","unit_amount":0,"state":"current"},"year":{"external_id":"student_free_yearly","product":"student","billing_interval":"year","currency":"USD","unit_amount":0,"state":"current"}}},"plus":{"USD":{"month":{"external_id":"plus_monthly_usd_202407","product":"plus","billing_interval":"month","currency":"USD","unit_amount":1200,"state":"current","eligibilityGroups":["plus_price_202407"]},"year":{"external_id":"plus_yearly_usd_202407","product":"plus","billing_interval":"year","currency":"USD","unit_amount":12000,"state":"current","eligibilityGroups":["plus_price_202407"]}}},"business":{"USD":{"month":{"external_id":"business_monthly_usd_202505","product":"business","billing_interval":"month","currency":"USD","unit_amount":2400,"state":"current","eligibilityGroups":["business_enterprise_price_202505"]},"year":{"external_id":"business_yearly_usd_202505","product":"business","billing_interval":"year","currency":"USD","unit_amount":24000,"state":"current","eligibilityGroups":["business_enterprise_price_202505"]}}},"enterprise":{"USD":{"month":{"external_id":"enterprise_monthly_usd_increase_q1_2026","product":"enterprise","billing_interval":"month","curren