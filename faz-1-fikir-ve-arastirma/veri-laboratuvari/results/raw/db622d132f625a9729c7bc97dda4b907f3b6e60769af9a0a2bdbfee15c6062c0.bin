"fr","fr-fr","ja","ja-jp","ko","ko-kr","pt","pt-br","da","nl","fi","nb","sv","da-dk","nl-nl","fi-fi","nb-no","sv-se","id","id-id","vi","vi-vn","th","th-th","en-gb","ar","ar-sa","he","he-il","it","it-it","pseudo"],"defaultLocale":"en-us","scriptLoader":[]}</script><div id="portal"></div></body></html>