ecommended brokers","_directory_categories_reviewed_by":"Reviewed By","_directory_categories_toc_collapse":"Show less","_directory_categories_toc_expend":"Show more","_directory_categories_toc_title":"In This Article","_directory_categories_trading_pairs":"Trading Pairs","_directory_categories_trusted_partner":"TRUSTED PARTNER","_directory_challenge_cost":"Challenge Cost","_directory_challenge_fee":"Challenge Fee","_directory_challenge_phases":"Challenge Phases","_directory_cold_storage":"Cold Storage %","_directory_commission_per_lot":"Commission Per Lot","_directory_commission_side":"Commission/Side","_directory_cons_title":"Where it falls short","_directory_contact_details":"{{BRAND_NAME}} contact details","_directory_contract_commission":"Contract Commission","_directory_contract_types":"Contract Types","_directory_copy_social_trading":"Copy / social trading","_directory_costs_explained_description":"Trading costs at {{BRAND_NAME}} depend on the account type, trading frequency, and whether positions are held overnight. Here's what matters most depending on how you trade.","_directory_costs_explained_key_costs":"Key costs","_directory_costs_explained_title":"Costs explained","_directory_country_by_edition":"the United States","_directory_currency_conversion_fee":"Currency Conversion Fee","_directory_daily_drawdown":"Daily Drawdown %","_directory_day_trading_margins":"Day Trading Margins","_directory_dedicated_account_manager":"Dedicated account manager","_directory_demo_account_available":"Demo account available","_directory_deposit_fee":"Deposit Fee","_directory_economic_calendar":"Economic calendar","_directory_exchanges":"Exchanges","_directory_execution_type":"Execution type","_directory_firm_name":"Firm Name","_directory_funding_available":"Funding Available","_directory_gallery_title":"Inside the {{BRAND_NAME}} platform","_directory_getting_started_description":"Opening an account with {{BRAND_NAME}} is a straightforward process that typically takes only a few minutes. Here's what to expect.","_directory_getting_started_pro_tip_text":"Use their mobile app to verify your identity. The camera integration makes the document upload process much faster than on desktop.","_directory_getting_started_pro_tip_title":"Pro tip","_directory_getting_started_step1_text":"Register on the {{BRAND_NAME}} website using your email and basic personal information.","_directory_getting_started_step1_title":"Create your account","_directory_getting_started_step2_text":"Upload identification documents to complete the KYC verification process.","_directory_getting_started_step2_title":"Verify your identity","_directory_getting_started_step3_text":"Deposit funds using supported payment methods such as bank transfer, credit card or e-wallet.","_directory_getting_started_step3_title":"Fund your account","_directory_getting_started_step4_text":"Once your account is verified and funded, you can access the trading platform and begin placing trades.","_directory_getting_started_step4_title":"Start trading","_directory_getting_started_title":"Getting started with {{BRAND_NAME}}","_directory_getting_started_what_you_need":"What you'll need","_directory_getting_started_what_you_need1":"Valid government ID","_directory_getting_started_what_you_need2":"Proof of address","_directory_getting_started_what_you_need3":"Email address","_directory_getting_started_what_you_need4":"Bank card or payment method for deposits","_directory_inactivity_fee":"Inactivity Fee","_directory_islamic_swap_free_account":"Islamic / swap-free account","_directory_key_features_account_types":"Account types","_directory_key_features_description":"{{BRAND_NAME}} offers a wide range of trading tools, account types, and platforms. Below you can explore the key features in more detail.","_directory_key_features_education_research":"Education \u0026 Research","_directory_key_features_platforms_tools":"Platforms \u0026 Tools","_directory_key_features_title":"{{BRAND_NAME}} Key features",