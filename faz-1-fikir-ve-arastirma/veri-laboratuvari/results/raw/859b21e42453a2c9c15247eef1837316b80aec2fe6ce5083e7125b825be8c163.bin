ard_view":"Card view","_directory_quiz_results_compare":"Compare","_directory_quiz_results_compare_assets":"Assets","_directory_quiz_results_compare_beginner_friendly":"Beginner friendly","_directory_quiz_results_compare_min_deposit":"Min. Deposit","_directory_quiz_results_cta":"Open account","_directory_quiz_results_no_results":"There are no brokers that match your criteria","_directory_quiz_results_retake":"Retake quiz","_directory_quiz_results_text":"Based on your answers, here are brokers that best fit your profile.","_directory_quiz_results_title":"Your broker matches","_directory_quiz_step0_bottom_text":"No personal details or commitment are required.","_directory_quiz_step0_cta":"Get Started","_directory_quiz_step0_text":"Answer 7 quick questions to see brokers that fit your needs.","_directory_quiz_step0_title":"Match me with a broker","_directory_quiz_step1_change_country":"Not your country? \u003cspan\u003eChange it\u003c/span\u003e","_directory_quiz_step1_select_country":"Select a country","_directory_quiz_step1_text":"This helps us show brokers available in your region.","_directory_quiz_step1_title":"Where do you live?","_directory_quiz_step2_bonds_exp":"US Treasuries, corporate, etc.","_directory_quiz_step2_cfds_exp":"Gold, indices, FX, etc.","_directory_quiz_step2_crypto_exp":"BTC, ETH, SOL, etc.","_directory_quiz_step2_dont_know":"I don't know","_directory_quiz_step2_forex_exp":"EUR/USD, GBP/USD, USD/JPY, etc.","_directory_quiz_step2_funds_exp":"Index funds, bond funds, etc.","_directory_quiz_step2_futures_exp":"Oil, gold, S\u0026P 500, etc.","_directory_quiz_step2_options_exp":"Calls, puts, spreads, etc.","_directory_quiz_step2_stocks_and_etfs":"Stocks \u0026 ETFs","_directory_quiz_step2_stocks_and_etfs_exp":"Apple, Tesla, S\u0026P 500, etc.","_directory_quiz_step2_text":"Choose one or more.","_directory_quiz_step2_title":"Which assets are most important to you?","_directory_quiz_step3_option1":"First-timer (no experience)","_directory_quiz_step3_option2":"I've made a few simple trades","_directory_quiz_step3_option3":"I've traded multiple products","_directory_quiz_step3_option4":"Professional and fully confident","_directory_quiz_step3_text":"We'll adjust recommendations for beginner-friendly vs advanced platforms.","_directory_quiz_step3_title":"What is your level of experience with trading and investing?","_directory_quiz_step4_option1":"Yes, I have an active account","_directory_quiz_step4_option2":"No, I don't have one yet","_directory_quiz_step4_text":"We'll adjust recommendations based on your current broker status.","_directory_quiz_step4_title":"Do you currently have a brokerage account?","_directory_quiz_step5_option1":"I'm okay with reasonable fees for exceptional services","_directory_quiz_step5_option2":"Pay as little as possible (basic functions)","_directory_quiz_step5_option3":"Zero-commission only","_directory_quiz_step5_option4":"I don't know","_directory_quiz_step5_text":"We'll prioritize brokers based on pricing style.","_directory_quiz_step5_title":"How important are fees and costs to you?","_directory_quiz_step6_option1":"Daily","_directory_quiz_step6_option2":"Weekly","_directory_quiz_step6_option3":"Monthly","_directory_quiz_step6_option4":"Yearly","_directory_quiz_step6_option5":"I don't know","_directory_quiz_step6_text":"This helps match your trading style.","_directory_quiz_step6_title":"How frequently do you plan to engage with your investments and trades?","_directory_quiz_step7_option1":"Less than $50","_directory_quiz_step7_option2":"$51–$200","_directory_quiz_step7_option3":"$201–$500","_directory_quiz_step7_option4":"$501–$1,000","_directory_quiz_step7_option5":"$1,001–$2,000","_directory_quiz_step7_option6":"More than $2,000","_directory_quiz_step7_option7":"I don't know","_directory_quiz_step7_text":"Some brokers have minimum deposit requirements.","_directory_quiz_step7_title":"What’s your planned first deposit?","_directory_review_acquired_description":"This broker has been acquired by {{ACQUIRED_BY}} as of {{ACQUIRED_DATE}}.\nThe original broker no longer operates independently. If you have an existing account, it may have been transferred to the new entity.","_directory_review_acquired_title":"BROKER ACQUIRED — NOW OPERATING UNDER NEW OWNERSHIP","_directory_review_archived_description":"This review of {{BROKER_NAME}} is archived and no longer updated by our editorial team. The information below may be outdated.","_directory_review_archived_title":"ARCHIVED REVIEW — NOT ACTIVELY MONITORED","_directory_review_at_a_glance":"{{BRAND_NAME}} at a glance","_directory_review_explore_recommended_brokers":"Explore recommended brokers","_directory_review_fees_title":"Fees that can catch traders off guard","_directory_review_learn_about_acquiring_company":"Learn more about the acquiring company:","_directory_review_looking_for_better_option":"Looking for a better option?","_directory_review_no_longer_operating_description":"This broker has ceased all business operations as of {{NO_LONGER_OPERATING_DATE}}.\nThe information below is for historical reference only. This broker is no longer active and should not be contacted for new accounts or services.","_directory_review_no_longer_operating_title":"BROKER CLOSED — NO LONGER OPERATING","_directory_review_not_recommended_description":"Investing.com does not recommend this broker. We have identified serious regulatory or operational concerns that pose significant risk to users.","_directory_review_not_recommended_title":"NOT RECOMMENDED — SERIOUS ISSUES IDENTIFIED","_directory_review_under_regulatory_review_description":"This broker's regulatory status is currently under official review. This is a developing situation.","_directory_review_under_regulatory_review_title":"REGULATORY CAUTION — OFFICIAL INVESTIGATION UNDERWAY","_directory_reviews_hub_description":"Welcome to our Broker Reviews Hub! Choosing the right broker matters, and we've got you covered. Explore expert, unbiased reviews of tradin