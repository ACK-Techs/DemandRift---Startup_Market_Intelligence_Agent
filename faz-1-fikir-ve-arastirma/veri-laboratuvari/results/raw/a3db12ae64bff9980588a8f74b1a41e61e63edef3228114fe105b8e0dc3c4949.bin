lock"> <a class="btn btn-primary" href="/contact-sales-form" > Book a demo</a></li><li class="cta-mobile md:hidden"> <a class="btn btn-primary" href="/contact-sales-form" > Book a demo</a></li></ul> </nav> <button class="nav-toggle md:hidden">Menu</button></div><div class="top-nav-mobile hidden"></div></div><div class="top-nav-container overflow-hidden md:hidden"></div></div><div class="nav-container overflow-hidden hidden"></div> </header> <main id="main-content" class="relative z-0 flex flex-col flex-grow"><div class="bg-white flex-grow"><div data-drupal-messages-fallback class="hidden"></div><article><div class="bg-white flex-grow flex flex-col"> <section class="section py-20 bg-primary-bass_black ut-bg-dark text-white container-deafult overflow-x-clip"><div class="container"><div class="ut-component-global-spacing"><div class="flex ut-component-global-spacing flex-col text-center items-center mx-auto" id="more-powerful-insights-together"><p class="ut-component-global-spacing eyebrow">Integrations and plugins</p><h1 >More powerful insights, together</h1><div class="rich-text-component ut-component-global-spacing text-formatted"><p>UserTesting helps you do more with your existing tools and solutions to further optimize your customer experience.</p></div></div></div></div></section> <section class="section py-20 bg-white container-deafult overflow-x-clip"><div class="container"><div class='tabs-container ut-component-global-spacing'><div class="tab-trigger-list mb-6 md:mb-8 flex flex-row justify-center overflow-x-auto snap-x snap-mandatory" role="tablist"> <button id="tab-item-trigger-8229" type="button" role="tab" aria-selected="true" aria-controls="tab-item-content-8229" class="is-active tab-item-trigger text-primary-adagio_gray w-[120px] min-w-[120px] md:w-[200px] md:min-w-[200px] pb-2 px-2 cursor-pointer"> Collaboration, design and development </button><button id="tab-item-trigger-9423" type="button" role="tab" aria-selected="false" aria-controls="tab-item-content-9423" tabindex="-1" class="tab-item-trigger text-primary-adagio_gray w-[120px] min-w-[120px] md:w-[200px] md:min-w-[200px] pb-2 px-2 cursor-pointer"> Digital optimization and analytics </button><button id="tab-item-trigger-4120" type="button" role="tab" aria-selected="false" aria-controls="tab-item-content-4120" tabindex="-1" class="tab-item-trigger text-primary-adagio_gray w-[120px] min-w-[120px] md:w-[200px] md:min-w-[200px] pb-2 px-2 cursor-pointer"> Customer relationship management </button><button id="tab-item-trigger-6082" type="button" role="tab" aria-selected="false" aria-controls="tab-item-content-6082" tabindex="-1" class="tab-item-trigger text-primary-adagio_gray w-[120px] min-w-[120px] md:w-[200px] md:min-w-[200px] pb-2 px-2 cursor-pointer"> Productivity </button></div><div id="tab-item-content-8229" role="tabpanel" tabindex="0" aria-labelledby="tab-item-trigger-8229" class="is-active tab-item-content w-full"><div class="ut-component-global-spacing info-card-container"><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/FigJam" class='absolute inset-y-0 left-0 w-full' aria-label="FigJam"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/nji9s2qa5r/web/ICON-2023-figma-figjam-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=c072cae8-2bac-4a99-a2c4-6af84f2100f2&amp;itok=lyT4GHjU" width="88" height="88" alt="ICON-2023-figma-figjam-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">FigJam</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Power collaboration and decision-making with customer insights by embedding UserTesting tests, videos, clips, or highlight reels in FigJam whiteboards.</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/FigJam" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="/solutions/integrations/figma" class='absolute inset-y-0 left-0 w-full' aria-label="Figma"></a><div class="media-block mb-4"> <article class="media media--type-image media--view-mode-icon"><div> <img src="/sites/default/files/usertestingv3/2025-02/ICON-2023-figma-figjam-176x176.webp?width=88&amp;height=88&amp;dpr=2" width="88" height="88" alt="Figjam logo" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Figma</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Link Figma prototypes to validate usability with higher sample size interaction tests, and &nbsp;find actionable insights with AI-powered analysis.</p></div></div> <a class="link link-primary" href="/solutions/integrations/figma" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="/solutions/integrations/jira" class='absolute inset-y-0 left-0 w-full' aria-label="Jira"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/q0sjwkoxpt/web/ICON-2023-jira-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=7b5239fe-cbfd-49bd-9ac4-2988a47a01b4&amp;itok=svKM_Iju" width="88" height="88" alt="ICON-2023-jira-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Jira</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Add UserTesting clips to Jira issues to scale human insights across product and development teams.</p></div></div> <a class="link link-primary" href="/solutions/integrations/jira" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="/solutions/integrations/Jira-Product-Discovery" class='absolute inset-y-0 left-0 w-full' aria-label="Jira Product Discovery"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/9kuy8etkip/web/ICON-2023-Jira-product-discovery-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=78231348-b67d-4948-bb20-210a1af8147b&amp;itok=8FKSj2xo" width="88" height="88" alt="ICON-2023-Jira-product-discovery-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Jira Product Discovery</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Support product discovery and prioritization decisions with customer insight captured from the UserTesting platform.</p></div></div> <a class="link link-primary" href="/solutions/integrations/Jira-Product-Discovery" > </a></div></div><div class="ut-component-global-spacing info-card-container"><div class="info-card flex flex-col h-auto three-card-width outline-styling"> <a target="_self" href="/solutions/integrations/confluence-whiteboards" class='absolute inset-y-0 left-0 w-full' aria-label="Confluence whiteboards"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/2c4zaaymef/web/ICON-2024-confluence-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=c5f8eab0-762b-4075-aa92-2ce4ffbadaa9&amp;itok=hAUAC3Hd" width="88" height="88" alt="Icon logo for Confluence integration. For use on the Integrations page only!" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Confluence whiteboards</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Embed richer UserTesting insights in Confluence whiteboards, making customer feedback more easily accessible and actionable.</p></div></div> <a class="link link-primary" href="/solutions/integrations/confluence-whiteboards" > </a></div><div class="info-card flex flex-col h-auto three-card-width outline-styling"> <a target="_self" href="/solutions/integrations/miro" class='absolute inset-y-0 left-0 w-full' aria-label="Miro"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/bc8lsk0khl/web/ICON-2023-Miro-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=54b9e263-b53f-4f07-a48a-dcf578033927&amp;itok=3gzLaXvf" width="88" height="88" alt="ICON-2023-Miro-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Miro</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Embed richer UserTesting insights in Miro to make customer feedback more easily accessible and actionable.</p></div></div> <a class="link link-primary" href="/solutions/integrations/miro" > </a></div><div class="info-card flex flex-col h-auto three-card-width outline-styling"> <a target="_self" href="/solutions/integrations/canva" class='absolute inset-y-0 left-0 w-full' aria-label="Canva"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/jlrqz6g03w/web/ICON-2023-Canva-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=13f581f4-fd1f-4b74-a2c1-970de5461d68&amp;itok=W43KCQGX" width="88" height="88" alt="ICON-2023-Canva-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Canva</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Embed and play richer insights from UserTesting in Canva assets to promote and evangelize key customer insights to your audiences.</p></div></div> <a class="link link-primary" href="/solutions/integrations/canva" > </a></div></div></div><div id="tab-item-content-9423" role="tabpanel" tabindex="0" aria-labelledby="tab-item-trigger-9423" class="tab-item-content w-full"><div class="ut-component-global-spacing info-card-container"><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/Contentsquare" class='absolute inset-y-0 left-0 w-full' aria-label="Contentsquare"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/obeswdeee4/web/ICON-2023-Content-square-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=8b77ead9-fb0c-48be-9352-5f615bc16edf&amp;itok=1DKf6JtW" width="88" height="88" alt="ICON-2023-Content-square-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Contentsquare</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Understand the "why" behind the "what" to deliver the digital experiences your customers desire most</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/Contentsquare" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/quantum-metric" class='absolute inset-y-0 left-0 w-full' aria-label="Quantum Metric"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/eknbuxor1f/web/ICON-2023-Quantum-metrics-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=5f07c41b-e5e2-4f6a-9d10-5b9ad8fb37f8&amp;itok=4rF5DHzf" width="88" height="88" alt="ICON-2023-Quantum-metrics-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Quantum Metric</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Put your customer at the heart of your digital experience with quantitative and qualitative insights</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/quantum-metric" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/fullstory" class='absolute inset-y-0 left-0 w-full' aria-label="FullStory"></a><div class="media-block mb-4"> <article class="media media--type-image media--view-mode-icon"><div> <img src="/sites/default/files/usertestingv3/2023-10/ICON-FS-logo-sq.png?width=88&amp;height=88&amp;dpr=2" width="88" height="88" alt="ICON-FS-logo-sq.png" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">FullStory</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>FullStory provides all the data you need to build better digital experiences within your website, mobile app, or software platform.</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/fullstory" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/qualtrics" class='absolute inset-y-0 left-0 w-full' aria-label="Qualtrics"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/wlcpwjjih2/web/ICON-2023-Qualtrics-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=a7379f8a-78a5-4687-bf7f-7bdd20e68cdc&amp;itok=5Cms4-tY" width="88" height="88" alt="ICON-2023-Qualtrics-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Qualtrics</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Leverage UserTesting capabilities within Qualtrics studies to better understand people’s actions, thoughts, and feelings.</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/qualtrics" > </a></div></div></div><div id="tab-item-content-4120" role="tabpanel" tabindex="0" aria-labelledby="tab-item-trigger-4120" class="tab-item-content w-full"><div class="ut-component-global-spacing info-card-container"><div class="info-card flex flex-col h-auto one-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/rally" class='absolute inset-y-0 left-0 w-full' aria-label="Rally"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/0x0aczrcg1/web/ICON-2023-Rally-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=48c600b3-6489-4d00-9701-14fe0c2845c6&amp;itok=6Vwbf7me" width="88" height="88" alt="Icon Logo for Integrations page" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Rally</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p dir="ltr">Efficiently connect with your own network of users and more to capture rich video-based insights</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/rally" > </a></div></div></div><div id="tab-item-content-6082" role="tabpanel" tabindex="0" aria-labelledby="tab-item-trigger-6082" class="tab-item-content w-full"><div class="ut-component-global-spacing info-card-container"><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://help.usertesting.com/hc/en-us/articles/11880308437917" class='absolute inset-y-0 left-0 w-full' aria-label="Google Calendar"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/dqdzwqzizq/web/ICON-2023-Google-calendar-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=c7758703-4726-4b62-abc4-f9ff2c47e526&amp;itok=53M30CbL" width="88" height="88" alt="ICON-2023-Google-calendar-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Google Calendar</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Easily schedule Live Conversation interviews based on your existing schedule and availability with Google Calendar.</p></div></div> <a class="link link-primary" href="https://help.usertesting.com/hc/en-us/articles/11880308437917" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/microsoft-teams" class='absolute inset-y-0 left-0 w-full' aria-label="Microsoft Teams"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/9t1vk0fekc/web/ICON-2023-Microsoft-teams-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=00b39aeb-86c1-4169-a869-ec4c50557abb&amp;itok=pjycFREx" width="88" height="88" alt="ICON-2023-Microsoft-teams-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Microsoft Teams</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Share videos and related content directly from the UserTesting platform to colleagues and teams on the Microsoft Teams platform</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/microsoft-teams" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/slack" class='absolute inset-y-0 left-0 w-full' aria-label="Slack"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/tfmnickuhp/web/ICON-2023-Slack-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=57d42649-b388-4b00-ab52-f1be3fb1db6c&amp;itok=B8sbkGzO" width="88" height="88" alt="ICON-2023-Slack-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Slack</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Easily share insights to designated Slack channels or contacts directly from UserTesting. Open Integrations and plugins configuration options SVG Trello atlassian logo</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/slack" > </a></div><div class="info-card flex flex-col h-auto four-card-width outline-styling"> <a target="_self" href="https://www.usertesting.com/solutions/integrations/trello" class='absolute inset-y-0 left-0 w-full' aria-label="Trello"></a><div class="media-block mb-4"> <article class="media media--type-acquia-dam-image-asset media--view-mode-icon"><div><img src="https://usertesting.widen.net/content/xys2ghx1ky/web/ICON-2023-trello-176x176.png?crop=yes&amp;k=c&amp;w=88&amp;h=88&amp;v=b6924236-0980-4f11-a2d6-fba2464c9d44&amp;itok=RqJLvLZ8" width="88" height="88" alt="ICON-2023-trello-176x176" loading="lazy" /></div> </article></div><div class="flex flex-col h-full ut-component-global-spacing"><div class="h4">Trello</div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Add UserTesting tests, videos, clips, or highlight reels to Trello cards to incorporate human insights in project workflows</p></div></div> <a class="link link-primary" href="https://www.usertesting.com/solutions/integrations/trello" > </a></div></div></div></div></div></section> <section class="section py-20 bg-white container-deafult overflow-x-clip"><div class="container"><div class="ut-component-global-spacing"><div class="flex flex-col md:grid two-columns gap-8 md:gap-20 md:grid-cols-2 ut-component-global-spacing"><div class="flex flex-col self-center"><div class="flex ut-component-global-spacing flex-col" id="ecosystem-capabilities"><h2 class="h2">Ecosystem capabilities</h2></div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>In addition to technical integrations, the UserTesting platform can be used in conjunction with many other business tools, empowering organizations to leverage synergistic technologies to gather human insights more effectively.</p></div><div class="flex flex-wrap gap-4 justify-center ut-component-global-spacing md:justify-start"> <a class="btn btn-primary" href="https://www.usertesting.com/partners/become-a-partner-form" > Become a partner</a></div></div><div class="flex self-center flex-col"><div class="ut-component-global-spacing w-full mx-auto flex [&amp;_img]:rounded-4xl"> <article class="media media--type-acquia-dam-image-asset media--view-mode-side"><div><img src="https://usertesting.widen.net/content/6stlm4yxav/web/IMAGE-integrations-ecosystem-1236x800.png?v=f008ac9b-03f3-476a-a946-048b3b12cdc1" width="1236" height="800" alt="image for integration ecosystem" loading="lazy" /></div> </article></div></div></div></div></div></section> <section class="section py-20 bg-white container-deafult overflow-x-clip"><div class="container"><div class="ut-component-global-spacing"><div class="flex flex-col md:grid two-columns gap-8 md:gap-20 md:grid-cols-2 ut-component-global-spacing"><div class="md:order-last flex flex-col self-center"><div class="flex ut-component-global-spacing flex-col" id="quantitative-studies"><h3 class="h3">Quantitative studies</h3></div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Use qualitative research before, during, or after conducting a quantitative study with tools such as Qualtrics, SurveyMonkey, or Medallia. With UserTesting, you can gain more in-depth insight into customer attitudes and behaviors as your customers narrate and provide context on their answers.</p></div></div><div class="flex self-center flex-col"><div class="ut-component-global-spacing w-full mx-auto flex [&amp;_img]:rounded-4xl"> <article class="media media--type-acquia-dam-image-asset media--view-mode-side"><div><img src="https://usertesting.widen.net/content/mao6eucbca/web/IMAGE-integrations-plugins-02-618x400.png?v=c4ff74af-0ec1-42f7-82f6-2d55ed5a813b" width="1236" height="800" alt="Images for Solutions - Integrations and plugins page" loading="lazy" /></div> </article></div></div></div></div></div></section> <section class="section py-20 bg-white container-deafult overflow-x-clip"><div class="container"><div class="ut-component-global-spacing"><div class="flex flex-col md:grid two-columns gap-8 md:gap-20 md:grid-cols-2 ut-component-global-spacing"><div class="flex flex-col self-center"><div class="flex ut-component-global-spacing flex-col" id="ux-design-and-prototyping"><h3 class="h3">UX design and prototyping</h3></div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>UserTesting works hand in hand with leading design tools such as Adobe XD, InVision, Sketch, Figma,&nbsp;FigJam and others. Get quick feedback from customers at any stage of the design process by using our plug-in for Adobe XD or linking another design URL into UserTesting.</p></div></div><div class="flex self-center flex-col"><div class="ut-component-global-spacing w-full mx-auto flex [&amp;_img]:rounded-4xl"> <article class="media media--type-acquia-dam-image-asset media--view-mode-side"><div><img src="https://usertesting.widen.net/content/bhddqvgohs/web/IMAGE-integrations-plugins-03-618x400.png?v=a5c7c3ad-f2ee-4357-a418-30e6d6b4ab69" width="1236" height="800" alt="Images for Solutions - Integrations and plugins page" loading="lazy" /></div> </article></div></div></div></div></div></section> <section class="section py-20 bg-white container-deafult overflow-x-clip"><div class="container"><div class="ut-component-global-spacing"><div class="flex flex-col md:grid two-columns gap-8 md:gap-20 md:grid-cols-2 ut-component-global-spacing"><div class="md:order-last flex flex-col self-center"><div class="flex ut-component-global-spacing flex-col" id="analytics"><h3 class="h3">Analytics</h3></div><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Understand the data generated by tools such as Adobe Analytics, Google Analytics, or Pendo. You can run UserTesting studies that match behavioral patterns to learn why customers abandon their carts at higher rates or why a page’s bounce rate is increasing.</p></div></div><div class="flex self-center flex-col"><div class="ut-component-global-spacing w-full mx-auto flex [&amp;_img]:rounded-4xl"> <article class="media media--type-acquia-dam-image-asset media--view-mode-side"><div><img src="https://usertesting.widen.net/content/on1e1vdrcx/web/IMAGE-integrations-plugins-04-618x400.png?v=82421eee-a831-451b-9c16-4c593340d23c" width="1236" height="800" alt="Images for Solutions - Integrations and plugins page" loading="lazy" /></div> </article></div></div></div></div></div></section> <section class="section py-20 bg-white container-narrow overflow-x-clip"><div class="container"><div class="flex ut-component-global-spacing flex-col text-center items-center mx-auto" id="frequently-asked-questions"><h2 >Frequently Asked Questions</h2></div><script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"FAQPage","@id":"https:\/\/www.usertesting.com\/solutions\/integrations#faq","isPartOf":{"@id":"https:\/\/www.usertesting.com\/solutions\/integrations#webpage"},"mainEntity":[{"@type":"Question","name":"What tools and apps does UserTesting integrate with?","acceptedAnswer":{"@type":"Answer","text":"UserTesting connects your user research workflows with the tools your team already uses across design, product, and analytics. These integrations make it easier to collect, share, and act on insights without switching between platforms.Common UX research integrations include:Design tools like FigmaCollaboration tools like SlackProduct tools like JiraExperience platforms like Qualtrics and ContentsquareUserTesting plugins and integrations help teams streamline research, centralize feedback, and bring customer insights into everyday decision-making."}},{"@type":"Question","name":"Does UserTesting integrate with Figma?","acceptedAnswer":{"@type":"Answer","text":"Yes, UserTesting integrates with Figma to help teams test prototypes and designs without leaving their workflow. The UserTesting Figma integration allows you to gather feedback on early concepts, validate design decisions, and iterate faster.UserTesting provides a dedicated integration and plugin experience for seamless testing. Learn more about Figma integration or explore how the UserTesting for Figma plugin works."}},{"@type":"Question","name":"How does UserTesting fit into existing product and design workflows?","acceptedAnswer":{"@type":"Answer","text":"UserTesting fits into existing workflows by integrating directly with the tools teams use to build, track, and optimize experiences. This makes it easier to bring user feedback into product decisions without adding friction.For example:Share insights directly in Slack channelsConnect feedback to development tasks with the UserTesting Jira integrationTest prototypes within design tools like FigmaUserTesting helps product and design teams embed UX research into daily workflows. Learn more about Jira integration or see how product design teams approach user research."}}]}</script><div class="accordion ut-component-global-spacing"><div class="accordion-item border-solid border-b-[0.5px] border-primary-insight_gray"> <button class="accordion-item-trigger relative flex items-center w-full md:px-4 py-6 text-left font-bold text-base leading-normal rounded-lg md:text-xl md:leading-snug after:font-icomoon after:text-sm after:text-primary-bravado_blue after:absolute after:right-0 md:after:right-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-primary-bravado_blue" type="button" id="accordion-trigger-242" aria-expanded="false" aria-controls="accordion-content-242"><h3 class="h5">What tools and apps does UserTesting integrate with?</h3> </button><div id="accordion-content-242" role="region" aria-labelledby="accordion-trigger-242" class="accordion-item-content hidden mb-6 md:mx-4"><div class="rich-text-component ut-component-global-spacing text-formatted"><p>UserTesting connects your user research workflows with the tools your team already uses across design, product, and analytics. These integrations make it easier to collect, share, and act on insights without switching between platforms.<br>Common UX research integrations include:</p><ul><li data-list-item-id="e36d69d16524f4ff8d8a00975235b206b">Design tools like Figma</li><li data-list-item-id="e9fb7a795c85f8592836f2f85c939e12a">Collaboration tools like Slack</li><li data-list-item-id="e29c9374318ea6a688520d95f07b06059">Product tools like Jira</li><li data-list-item-id="e6cbb0c3c8eaf4da26a370f26587f0219">Experience platforms like Qualtrics and Contentsquare</li></ul><p>UserTesting plugins and integrations help teams streamline research, centralize feedback, and bring customer insights into everyday decision-making.</p></div></div></div><div class="accordion-item border-solid border-b-[0.5px] border-primary-insight_gray"> <button class="accordion-item-trigger relative flex items-center w-full md:px-4 py-6 text-left font-bold text-base leading-normal rounded-lg md:text-xl md:leading-snug after:font-icomoon after:text-sm after:text-primary-bravado_blue after:absolute after:right-0 md:after:right-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-primary-bravado_blue" type="button" id="accordion-trigger-407" aria-expanded="false" aria-controls="accordion-content-407"><h3 class="h5">Does UserTesting integrate with Figma?</h3> </button><div id="accordion-content-407" role="region" aria-labelledby="accordion-trigger-407" class="accordion-item-content hidden mb-6 md:mx-4"><div class="rich-text-component ut-component-global-spacing text-formatted"><p>Yes, UserTesting integrates with Figma to help teams test prototypes and designs without leaving their workflow. The UserTesting Figma integration allows you to gather feedback on early concepts, validate design decisions, and iterate faster.<br>UserTesting provides a dedicated integration and plugin experience for seamless testing. Learn more about <a href="/solutions/integrations/figma" data-entity-type="node" data-entity-uuid="06b66f6d-ccc2-43b0-93c3-f3525499ca46" data-entity-substitution="canonical">Figma integration</a> or explore how the <a href="/blog/usertesting-for-figma-plugin" data-entity-type="node" data-entity-uuid="28d53eda-e612-4b77-a6cf-ebbe16728333" data-entity-substitution="canonical">UserTesting for Figma plugin</a> works.</p></div></div></div><div class="accordion-item border-solid border-b-[0.5px] border-primary-insight_gray"> <button class="accordion-item-trigger relative flex items-center w-full md:px-4 py-6 text-left font-bold text-base leading-normal rounded-lg md:text-xl md:leading-snug after:font-icomoon after:text-sm after:text-primary-bravado_blue after:absolute after:right-0 md:after:right-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-primary-bravado_blue" type="button" id="accordion-trigger-310" aria-expanded="false" aria-controls="accordion-content-310"><h3 class="h5">How does UserTesting fit into existing product and design workflows?</h3> </button><div id="accordion-content-310" role="region" aria-labelledby="accordion-trigger-310" class="accordion-item-content hidden mb-6 md:mx-4"><div class="rich-text-component ut-component-global-spacing text-formatted"><p>UserTesting fits into existing workflows by integrating directly with the tools teams use to build, track, and optimize experiences. This makes it easier to bring user feedback into product decisions without adding friction.<br>For example:</p><ul><li data-list-item-id="eee64303fe034cf47c3fcfc0315cc4ee5">Share insights directly in Slack channels</li><li data-list-item-id="e671007908cf3d366747cc569ccbe2a54">Connect feedback to development tasks with the UserTesting Jira integration</li><li data-list-item-id="ea5b4a3238cbc463520f0cae7e12b04e2">Test prototypes within design tools like Figma</li></ul><p>UserTesting helps product and design teams embed UX research into daily workflows. Learn more about <a href="/blog/jira-integration" data-entity-type="node" data-entity-uuid="8653765b-15ff-44ed-98ec-1f848b252474" data-entity-substitution="canonical">Jira integration</a> or see how <a href="https://www.usertesting.com/solutions/teams/product-design" data-entity-type="external">product design teams</a> approach user research.</p></div></div></div></div></div></section></div></article></div> </main><div class="region-footer ut-bg-dark bg-primary-bass_black text-white"><div class="region-content max-w-7xl mx-auto px-4 py-20"><div class="logo mb-9"> <a href="/" title="Home" rel="home"> <img src="/themes/custom/usertesting/assets/images/logo-white.svg" alt="UserTesting logo" width="191" height="49" /><p>Human understanding. Human experiences.</p> </a></div> <nav role="navigation" aria-labelledby="block-social-menu" id="block-social" class="menu--social"><h2 class="visually-hidden" id="block-social-menu">Social</h2><ul class="menu"><li class="menu-item"> <a href="https://www.facebook.com/UserTestingcom/">Facebook</a></li><li class="menu-item"> <a href="https://www.instagram.com/usertestingofficial/">Instagram</a></li><li class="menu-item"> <a href="https://www.linkedin.com/company/usertesting-com/">LinkedIn</a></li><li class="menu-item"> <a href="https://twitter.com/usertesting">Twitter</a></li></ul> </nav><nav role="navigation" aria-labelledby="block-footerquicklinks-menu" id="block-footerquicklinks" class="menu--footer-quick-links"><h2 id="block-footerquicklinks-menu">Quick Links</h2><ul class="menu"><li class="menu-item"> <a href="https://www.usertesting.com/company/about-us">About Us</a></li><li class="menu-item"> <a href="https://www.usertesting.com/contact-us">Contact Us</a></li><li class="menu-item"> <a href="https://www.usertesting.com/platform">UserTesting Human Insight Platform</a></li><li class="menu-item"> <a href="https://www.usertesting.com/login">Login</a></li><li class="menu-item"> <a href="https://www.usertesting.com/about-us/careers">Careers</a></li><li class="menu-item"> <a href="https://www.usertesting.com/platform/userzoom">UserZoom UX Research Platform</a></li></ul> </nav><nav role="navigation" aria-labelledby="block-footer-menu" id="block-footer" class="menu--footer"><h2 class="visually-hidden" id="block-footer-menu">Footer</h2><ul class="menu"><li class="menu-item menu-item--expanded"> <span>Platform &amp; Services</span><ul class="menu"><li class="menu-item menu-item--expanded"> <span>Platform overview</span><ul class="menu"><li class="menu-item"> <a href="/platform" data-drupal-link-system-path="node/886">UserTesting Human Insight Platform</a></li><li class="menu-item"> <a href="/platform/userzoom" data-drupal-link-system-path="node/1546">UserZoom UX Research Platform</a></li><li class="menu-item"> <a href="https://www.intellizoom.com/">Intellizoom</a></li></ul></li><li class="menu-item menu-item--expanded"> <span>Pricing Plans</span><ul class="menu"><li class=