 top-0 bg-border-faint absolute lg-max:hidden"></div><div class="w-2 h-16 bg-heat-100"></div><div class="flex gap-12 items-center !text-mono-x-small text-black-alpha-16 font-mono"><div>[ <span class="text-heat-100">02</span> /<!-- --> <!-- -->04<!-- --> ]</div><div class="w-8 text-center">·</div><div class="uppercase text-black-alpha-32">COMPARE PLANS</div></div></div></div></div><section class="container relative -mt-1 scroll-mt-24" id="compare-plans"><div class="overlay pointer-events-none contain-[layout,paint] curvy-rect"><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="-rotate-90 absolute top-0 left-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="absolute top-0 right-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="rotate-180 absolute bottom-0 left-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="rotate-90 absolute bottom-0 right-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg></div><div class="px-24 lg:px-64 py-24 lg:py-56 flex flex-col gap-16 border-b border-border-faint relative"><h2 class="text-title-h5 text-accent-black text-balance">Compare<span class="text-title-h5 text-heat-100"> Plans</span></h2><div class="text-body-large text-black-alpha-88 max-w-478">What changes from one plan to the next.</div></div><div class="px-24 lg:px-64 py-24 lg:py-32 border-b border-border-faint last:border-b-0 relative"><h3 class="text-label-large text-accent-black mb-16">Limits and Performance</h3><div class="overflow-x-auto"><table class="w-full min-w-840 table-fixed border-separate border-spacing-0 text-left"><caption class="sr-only">Limits and Performance<!-- -->, compared across every Firecrawl plan</caption><thead><tr><th class="sticky left-0 z-10 bg-background-lighter border-y border-r border-border-faint px-16 py-12 w-160 lg:w-220 text-label-x-small text-black-alpha-56 font-normal" scope="col">Feature</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Free</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Hobby</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Standard</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Growth</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Scale</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Enterprise</th></tr></thead><tbody><tr><th aria-label="Concurrent browsers" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-limits-and-performance-concurrent-browsers" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Concurrent browsers</button><span class="sr-only" id="plan-matrix-limits-and-performance-concurrent-browsers">Concurrent browsers set how many pages render at the same time.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">2</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">5</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">25</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">50</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">100</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Custom</td></tr><tr><th aria-label="Max queued jobs" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-limits-and-performance-max-queued-jobs" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Max queued jobs</button><span class="sr-only" id="plan-matrix-limits-and-performance-max-queued-jobs">This is how many jobs can wait in the queue at once. Above Scale you get 2,000 for each browser, up to 2,000,000.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">50,000</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">50,000</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">50,000</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">100,000<!-- --></td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">200,000+</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">200,000+</td></tr><tr><th aria-label="Rate limit, /scrape, /map and /search" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-limits-and-performance-rate-limit-scrape-map-and-search" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Rate limit, /scrape, /map and /search</button><span class="sr-only" id="plan-matrix-limits-and-performance-rate-limit-scrape-map-and-search">Your team gets this many requests a minute for each endpoint.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">10 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">100 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">500 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">5,000 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">10,000 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Custom</td></tr><tr><th aria-label="Rate limit, /crawl and /agent" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-limits-and-performance-rate-limit-crawl-and-agent" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Rate limit, /crawl and /agent</button><span class="sr-only" id="plan-matrix-limits-and-performance-rate-limit-crawl-and-agent">Your team can send this many requests a minute. Batch scrape shares the crawl limit, and extract shares the agent limit.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">2 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">20 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">100 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">1,000 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">2,000 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Custom</td></tr><tr><th aria-label="Rate limit, /interact" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-limits-and-performance-rate-limit-interact" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Rate limit, /interact</button><span class="sr-only" id="plan-matrix-limits-and-performance-rate-limit-interact">Your team can start this many browser sandbox sessions a minute.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">2 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">20 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">100 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">1,000 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">1,500 / min</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Custom</td></tr></tbody></table></div></div><div class="px-24 lg:px-64 py-24 lg:py-32 border-b border-border-faint last:border-b-0 relative"><h3 class="text-label-large text-accent-black mb-16">Team and Access</h3><div class="overflow-x-auto"><table class="w-full min-w-840 table-fixed border-separate border-spacing-0 text-left"><caption class="sr-only">Team and Access<!-- -->, compared across every Firecrawl plan</caption><thead><tr><th class="sticky left-0 z-10 bg-background-lighter border-y border-r border-border-faint px-16 py-12 w-160 lg:w-220 text-label-x-small text-black-alpha-56 font-normal" scope="col">Feature</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Free</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Hobby</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Standard</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Growth</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Scale</th><th class="bg-background-lighter border-y border-border-faint px-16 py-12 text-label-x-small text-black-alpha-56 font-normal whitespace-nowrap" scope="col">Enterprise</th></tr></thead><tbody><tr><th aria-label="Multi-team organizations" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-matrix-team-and-access-multi-team-organizations" class="cursor-help text-left underline decoration-dotted decoration-black-alpha-32 underline-offset-4 hover:decoration-heat-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heat-100" type="button">Multi-team organizations</button><span class="sr-only" id="plan-matrix-team-and-access-multi-team-organizations">An organization can run more than one team, and our team sets that up for you.</span><span class="contents"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></span></span></th><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums"><span aria-hidden="true" class="text-black-alpha-32">–</span><span class="sr-only">Not available</span></td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums"><span aria-hidden="true" class="text-black-alpha-32">–</span><span class="sr-only">Not available</span></td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums"><span aria-hidden="true" class="text-black-alpha-32">–</span><span class="sr-only">Not available</span></td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Contact support</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Contact support</td><td class="border-b border-border-faint px-16 py-12 align-top text-body-medium text-black-alpha-72 tabular-nums">Contact support</td></tr><tr><th aria-label="Single Sign-On" class="sticky left-0 z-10 bg-background-base border-b border-r border-border-faint px-16 py-12 w-160 lg:w-220 align-top text-body-medium text-accent-black font-normal" scope="row"><span class="relative inline-block"><button aria-describedby="plan-mat