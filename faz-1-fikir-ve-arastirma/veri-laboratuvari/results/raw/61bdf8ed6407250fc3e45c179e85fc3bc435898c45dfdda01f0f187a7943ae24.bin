t-black-alpha-72 text-body-medium"><div class="mt-1"><svg fill="none" height="20" viewBox="0 0 20 20" width="20" class="text-accent-black" xmlns="http://www.w3.org/2000/svg"><circle cx="10" cy="10" fill="black" fill-opacity="0.06" r="8"></circle><path d="M7 10.5L9 12.5L13 7.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.64" stroke-width="1.25"></path></svg></div><div class="relative flex items-center gap-8">Zero-data retention</div></div><div class="flex gap-12 items-start px-24 py-16 border-b border-border-faint text-black-alpha-72 text-body-medium"><div class="mt-1"><svg fill="none" height="20" viewBox="0 0 20 20" width="20" class="text-accent-black" xmlns="http://www.w3.org/2000/svg"><circle cx="10" cy="10" fill="black" fill-opacity="0.06" r="8"></circle><path d="M7 10.5L9 12.5L13 7.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.64" stroke-width="1.25"></path></svg></div><div class="relative flex items-center gap-8">SSO &amp; advanced security</div></div></div></div></div></div></div><div class="p-24 lg:p-32 relative -mt-1"><div class="h-1 bg-border-faint left-0 absolute w-full top-0"></div><div class="overlay pointer-events-none contain-[layout,paint] curvy-rect"><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="-rotate-90 absolute top-0 left-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="absolute top-0 right-0"><path d="M11 1L11 11L10 11L10 7C10 3.68629 7.31371 1 4 1L-4.37114e-08 1L0 -4.80825e-07L11 4.37114e-07L11 1Z" fill="var(--border-faint)"></path></svg><svg fill="none" height="11" viewBox="0 0 11 11" width="11" xmlns="http://www.w3.org/2000/svg" class="rotate-180 absolute bottom-0 left-0"><path d="M11 1L11 11L10 11L10