yle="--Paper-shadow:0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)"><div class="MuiCardMedia-root mui-b5mcph"><img title="Mead Johnson Logo" alt="Mead Johnson Logo" data-testid="Card-media" loading="lazy" width="340" height="90" decoding="async" data-nimg="1" class="mui-1vlr4m1-Image-root-Media-root" style="color:transparent" sizes="(max-width: 768px) 100vw, 50vw" srcSet="https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 384w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 640w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 750w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 828w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 1080w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 1200w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 1920w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 2048w, https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg 3840w" src="https://images.ctfassets.net/vfkpgemp7ek3/6xZFK2sJNMA6QWIoIyGwMV/290d9f5b0e7c2ff45eb377c54aab83ee/mead_johnson__1_.svg"/></div></div></div></div></div></div></div></div></div></section><section class="MuiBox-root mui-lr1pdu-Section-root" variant="two-per-row" id="2vU8FmzxCGPUGQ1CCiW15n"><div class="MuiContainer-root MuiContainer-maxWidthXl mui-1niwxtm-Section-contentContainer"><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-5 mui-7p41r-Section-gridContainer"><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-sm-6 mui-38gtdp-Section-gridItem"><div class="MuiContainer-root MuiContainer-maxWidthXl mui-1dq4ja6"><div class="mui-1v5fjuu"><iframe id="5E1fBu0Wxrls02i8i92K8L" title="Embedded Content" src="https://play.vidyard.com/7nBiisjGY5P2unSbz19Kmk.html?v=3.1.1&amp;vyetoken=c082e9eb-3f56-4488-874c-1ff5125fdb85&amp;frameborder=0" allowFullScreen="" class="mui-1u5uzvs-ModuleIntegrationIFrame-embedRoot"></iframe></div></div></div><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-sm-6 mui-38gtdp-Section-gridItem"><div class="MuiBox-root mui-158oofq-Text-root" data-testid="Text-root" id="IJ09uZNObFMF2DfZwl6Qb"><h3 class="MuiTypography-root MuiTypography-h3 mui-118qivm" data-testid="Text-h3">Know your existing audiences</h3><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">Discover the demographics of your existing app users and the ads they viewed, personas that make up your user base, the advertisers targeting them on social media, and the other apps they’re using.</p><br/></div></div></div></div></section><section class="MuiBox-root mui-kpy5d0-Section-root" variant="Collection_icon-dark-three_section-wrapper"><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-4 mui-pv3zgd-Section-gridContainer"><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-grow mui-1q1tf88-Section-gridItem"><div class="MuiBox-root mui-66hbl6-Collection-root" data-testid="Collection" id="zAEiCjnnpMad7P6xsQeT2"><div class="MuiContainer-root MuiContainer-maxWidthXl mui-1ai0sx8-Collection-contentContainer" data-testid="Collection-contentContainer"><div class="MuiBox-root mui-1iedn95-Section-root" data-testid="Collection-section" variant="icon-dark-three"><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-5 mui-txrp2r-Section-gridContainer"><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-md-4 mui-1hexbdp-Section-gridItem"><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root mui-ym82uv-Card-root" data-testid="Card" id="2dhMJbTIWAiRMIn3ahXYHr" style="--Paper-shadow:0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)"><div class="MuiCardMedia-root mui-b5mcph"><img title="First, we gather data Icon" alt="First, we gather data Icon" data-testid="Card-media" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="mui-1vlr4m1-Image-root-Media-root" style="color:transparent" sizes="(max-width: 767.95px) 100vw, 33vw" srcSet="https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 256w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 384w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 640w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 750w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 828w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 1080w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 1200w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 1920w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 2048w, https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg 3840w" src="https://images.ctfassets.net/vfkpgemp7ek3/2RpustwA8W3pmEC450H9a5/d153d6201fbb06a633020df0f8ea81a0/First_we_gather_data.svg"/></div><div class="MuiCardContent-root mui-15q2cw4"><h3 class="MuiTypography-root MuiTypography-h3 mui-118qivm" data-testid="Card-title">First, we gather data from the source – the consumer</h3><div class="MuiBox-root mui-1fqr005-Text-root" data-testid="Card-body"><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">This means first-party global app engagement and social ad data from <i>real </i>people.</p></div></div></div></div><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-md-4 mui-1hexbdp-Section-gridItem"><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root mui-ym82uv-Card-root" data-testid="Card" id="2sJ005YbBDF0ScxhbtGe44" style="--Paper-shadow:0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)"><div class="MuiCardMedia-root mui-b5mcph"><img title="Next we aggregate Icon" alt="Next we aggregate Icon" data-testid="Card-media" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="mui-1vlr4m1-Image-root-Media-root" style="color:transparent" sizes="(max-width: 767.95px) 100vw, 33vw" srcSet="https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 256w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 384w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 640w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 750w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 828w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 1080w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 1200w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 1920w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 2048w, https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg 3840w" src="https://images.ctfassets.net/vfkpgemp7ek3/1oc4EmOiEHdphPIGlV3LRZ/892d16942b55049bee008d8f86d200e9/Next_we_aggregate.svg"/></div><div class="MuiCardContent-root mui-15q2cw4"><h3 class="MuiTypography-root MuiTypography-h3 mui-118qivm" data-testid="Card-title">Next we aggregate and group the data</h3><div class="MuiBox-root mui-1fqr005-Text-root" data-testid="Card-body"><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">The organization of the data enables you to <!-- -->make the best decision, easily. </p><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">
</p></div></div></div></div><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-md-4 mui-1hexbdp-Section-gridItem"><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root mui-ym82uv-Card-root" data-testid="Card" id="5iX3HEeo09pOQGeU8XWNwh" style="--Paper-shadow:0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)"><div class="MuiCardMedia-root mui-b5mcph"><img title="Finally, we report the insights in a single UI Icon" alt="Finally, we report the insights in a single UI Icon" data-testid="Card-media" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="mui-1vlr4m1-Image-root-Media-root" style="color:transparent" sizes="(max-width: 767.95px) 100vw, 33vw" srcSet="https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 256w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 384w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 640w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 750w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 828w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 1080w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 1200w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 1920w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 2048w, https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg 3840w" src="https://images.ctfassets.net/vfkpgemp7ek3/iu4rnzl6DvC48aznfYoLU/5b3d0af3dafbd08f0c318e932f126916/Finally_we_report_the_insights.svg"/></div><div class="MuiCardContent-root mui-15q2cw4"><h3 class="MuiTypography-root MuiTypography-h3 mui-118qivm" data-testid="Card-title">Finally, we report the insights in a single UI</h3><div class="MuiBox-root mui-1fqr005-Text-root" data-testid="Card-body"><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">Now your team has the data at your fingertips, no more waiting for survey or research data.</p><p class="MuiTypography-root MuiTypography-body1 mui-npdgv7" data-testid="Text-body1">
</p></div></div></div></div></div></div></div></div></div></div></section><section class="MuiBox-root mui-hmaiu3-Section-root" variant="standard" id="3bmab2FYkmePWFMjYqDeRX"><div class="MuiContainer-root MuiContainer-maxWidthXl mui-1niwxtm-Section-contentContainer"><div class="MuiBox-root mui-1fiat88-Text-root-Section-introText" data-testid="Section-introText" id="1I8mSLSCr46lU9MNmJqfJF"><h2 class="MuiTypography-root MuiTypography-h2 mui-1k89rjx" data-testid="Text-h2">Audience Insights enables you to:</h2><br/></div><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-8 mui-u5mgj4-Section-gridContainer"><div class="MuiGrid-root MuiGrid-direction-xs-row mui-1pj9b3d-Section-gridItem"><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root mui-1q9ejbr-Card-root" data-testid="Card" id="2Emr0LYV6uVA6KyevJfDgh" style="--Paper-shadow:0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)"><div class="MuiCardMedia-root mui-b5mcph"><img title="Understand your competitors’ audiences Img" alt="Understand your competitors’ audiences Img" data-testid="Card-media" loading="lazy" width="1289" height="861" decoding="async" data-nimg="1" class="mui-1vlr4m1-Image-root-Media-root" style="color:transparent" sizes="(max-width: 768px) 100vw, 50vw" srcSet="https://images.ctfassets.net/vfkpgemp7ek3/5n5FFJoJhSAJjlt8NLTrDQ/16c0391ad83aa11de0f8473a79183966/Audience_-_Understand_your_competitors_audiences.png?w=384&amp;fm=webp&amp;q=40 384w, https://images.ctfassets.net/vfkpgemp7ek3/5n5FFJoJhSAJjlt8NLTrDQ/16c0391ad83aa11de0f8473a79183966/Audience_-_Understand_your_competitors_audiences.png?w=640&amp;fm=webp&amp;q=40 640w, https://images.ctfassets.net/vfkpgemp7ek3/5n5FFJoJhSAJjlt8NLTrDQ/16c0391ad83aa11de0f8473a79183966/Audience_-_Understand_your_competitors_audiences.png?w=750&amp;fm=webp&amp;q=40 750w, https://images.ctfassets.net/vfkpgemp7ek3/5n5FFJoJhSAJjlt8NLTrDQ/16c0391ad83a