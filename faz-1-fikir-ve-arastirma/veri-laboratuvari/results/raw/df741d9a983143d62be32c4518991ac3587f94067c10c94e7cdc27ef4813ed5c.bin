.c2 .item-row .content {
flex-direction: column;
padding: 0 0 20px;
overflow: hidden;
}
.c2 .item {
width: 100%;
display: grid;
row-gap: 5px;
column-gap: 10px;
justify-items: start;
grid-template-rows: 20px auto;
grid-template-columns: 60px 1fr;
margin: 0 0 9px;
}
.c2 .item::after {
content: '';
width: 100%;
height: 100%;
border-radius: 10px;
opacity: 0;
z-index: -1;
position: absolute;
background: #edf3f4;
transition: opacity 0.3s, transform 0.3s;
}
.c2 .item:hover::after {
opacity: 1;
transform: scale(1);
}
.c2 .item figure {
grid-row-start: 1;
grid-column-start: 1;
grid-row-end: 3;
grid-column-end: 2;
height: auto;
margin: 5px 5px 1px;
}
.c2 .item figure img {
