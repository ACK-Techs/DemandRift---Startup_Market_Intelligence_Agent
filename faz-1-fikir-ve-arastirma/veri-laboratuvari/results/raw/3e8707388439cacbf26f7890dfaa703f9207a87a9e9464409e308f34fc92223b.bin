i herkes için kolay ve keyifli bir hale getirmektedir.","email":"destek@pazarama.com","telephone":"0850 724 79 76","address":{"@type":"PostalAddress","streetAddress":"Levent Mahallesi Meltem Sokak İş Bankası Kuleleri No:10 İç Kapı No:7","addressLocality":"İstanbul","addressCountry":"TR","addressRegion":"Beşiktaş","postalCode":"34330"},"vatID":"8540156705"}</script><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-ad5c507f21906b32.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-4ca73898c0bfdc2f.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-b07037e226ef7329.css" as="style"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-34ca094a72576fe1.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-0c2c88e1c90ecd4c.css" as="style"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-27d71a3f17af4ce7.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-9e4865fa68d2374f.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-ee5f22d7ab5b98d9.css" as="style"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-475a714ab4cedbce.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-0bb5c0a8c34ed14f.css" as="style"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-2d7cf7029c37850e.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-6e6332671f6ca2c3.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-9851615f1aebbf17.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-baf5a286e76ce65b.css" as="style"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/js/pzcf-62335e247dd1bdf2.js" as="script"><link rel="preload" href="https://js.pzrmcdn.com/asset/_pzweb/css/pz-d25d2cf95a03187a.css" as