ation",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-01T16:52:23.606Z"},$R[91]={id:"7692dfc8-c538-44a8-ae4e-de9c51d1438c",slug:"agent-traffic-lab",name:"Agent Traffic Lab",tagline:"ATL doesn’t just help agents find tools — it gets the job done. It finds and chooses the right AI provider, tool, or MCP server, executes the task, and switches to a fallback when a provider fails. It can optimize for lo",iconUrl:"https://cdn.mcp.so/uploads/12860b1b819ec428dd7229f3f234c496.jpg",authorName:"Agent Traffic Lab",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"AI & Agents",categorySlug:void 0,status:"published",isRemote:!0,createdAt:"2026-09-26T13:05:12.378Z"},$R[92]={id:"a70375f9-7076-44dc-9c9f-556a732c71c2",slug:"agency-ai-mcp",name:"Agency AI MCP",tagline:"Agency AI MCP - Create, launch, automate and manage Meta and Google ads from Claude and ChatGPT. Pull live campaign performance, ROAS, pacing and anomalies, get budget and creative strategy, then create ads, edit campaig",iconUrl:"https://cdn.mcp.so/uploads/1b6a0a28af1128685101639e7e8f058d.png",authorName:"agency-ai-dev",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"Finance & Commerce",categorySlug:void 0,status:"published",isRemote:!0,createdAt:"2026-08-24T09:58:24.196Z"},$R[93]={id:"cd9c0abf-e5b0-475e-b60a-7b0460627a3d",slug:"kin",name:"Kin",tagline:"The system of record for AI-written software. A persistent graph of entities, relationships, changes, and provenance, so humans and AI agents see what a change touches before it merges. Beside Git today.",iconUrl:"https://cdn.mcp.so/uploads/7bca109155f74bda5f826a84264fa9f0.png",authorName:"Troy Fortin, Jr. (Firelock, LLC)",rating:void 0,ratingCount:void 0,installCount:void 0,stars:45,verified:!0,featured:!0,editorPick:!1,categoryName:"Version Control",categorySlug:void 0,status:"published",isRemote:!1,createdAt