d 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"AI & Agents",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-26T23:04:03.355Z"},$R[110]={id:"2f0962a2-f972-4d6b-9272-7714344d18ba",slug:"faivelo-email",name:"Faivelo Email",tagline:"Business email on your own domain for AI agents. Read, search and send mail, manage mailboxes and aliases, and set up DNS automatically, with unlimited mailboxes on one flat plan.",iconUrl:"https://avatars.githubusercontent.com/u/96845694?v=4",authorName:"Benjamin Brookarsh",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"Communication",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-26T07:06:32.970Z"},$R[111]={id:"c82f111f-ba22-4594-8c7a-909a0aa36b86",slug:"schemity",name:"Schemity",tagline:"Local database MCP server: your agent sees a migration's impact before it runs, for PostgreSQL, MySQL, SQL Server and SQLite, with no database credentials.",iconUrl:"https://cdn.mcp.so/uploads/c57d1a6177011ee5fa0386013e4c8466.png",authorName:"tbson",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"Databases",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-25T14:28:03.336Z"},$R[112]={id:"f56e3979-4302-41a7-b064-499bb428142b",slug:"soar-flight-booking-mcp",name:"Soar Flight Booking MCP",tagline:"Soar Flight Booking MCP is a remote MCP server available at https://mcp.soar.flights.",iconUrl:"https://cdn.mcp.so/uploads/b93317474a7b9b994fdc15e56624d9bc.png",authorName:void 0,rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"Other",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-25T11:58:07.297Z"},$R[113]={id:"6e9ee359-d535-4260-92cb-57394094844e",slug:"tyton-mcp",name:"Tyton MCP",tagline:"Meta Pixel not working, or you need a Meta tracking audit? Tyton MCP finds the break and sets up Meta Pixel plus the Conversions API. https://usetyton.com",iconUrl:"https://avatars.githubusercontent.com/u/325237868?v=4",authorName:"usetyton",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"Data & Analytics",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-25T05:21:53.912Z"},$R[114]={id:"e4da28a6-0818-46cb-a8ab-9bb427a05400",slug:"casefile",name:"Casefile",tagline:"AI agents forget everything between sessions. Casefile gives every task a case file — decisions, dead ends, open questions — so the next agent picks up where the last one stopped. Self-hosted MCP.",iconUrl:"https://cdn.mcp.so/uploads/cc33b8693303cf01f21e015cb083fd36.png",authorName:"azimov777",rating:void 0,ratingCount:void 0,installCount:void 0,stars:3,verified:!0,featured:!0,editorPick:!1,categoryName:"Developer Tools",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-23T23:33:54.944Z"},$R[115]={id:"eb030fa9-8a5f-4138-b856-eba998205d48",slug:"ads-uploader-meta-ads-mcp",name:"Ads Uploader — Meta Ads MCP",tagline:"Launch Meta ads with your AI agent. Bulk-create Facebook and Instagram ads, import Google Drive creatives, launch partnership ads with authorized creators, and review saved builds before launch.",iconUrl:"https://avatars.githubusercontent.com/u/332027175?v=4",authorName:"Ads Uploader",rating:void 0,ratingCount:void 0,installCount:void 0,stars:void 0,verified:!0,featured:!0,editorPick:!1,categoryName:"AI & Agents",categorySlug:void 0,status:"published",isRemote:!1,createdAt:"2026-09-23T18:38:00.164Z"}],featuredClients:$R[116]=[$R[117]={id:"fd68857d-bc4c-4ae1-bb5b-c088397d38ee",slug:"roamzy",name:"Roamzy",tagline:"Agent-native global eSIM over MCP — an AI agent buys one eSIM for 193 countries, anonymously, per-MB in USDT/USDC crypto, and earns 20% referral forever. Claude/Cursor/Continue + any MCP client.",iconUrl:"https://avatars.githubusercontent.com/u/286710550?v=4",authorName:"roamzy-io",stars:3,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-08-17T16:40:42.801Z"},$R[118]={id:"3b1dc9da-a809-4313-afd7-0c69d19490e3",slug:"formlm",name:"FormLM",tagline:"Build smart forms, scoring quizzes, and evaluation reports through natural language. An MCP Server that lets any AI agent create and manage complete assessment apps end-to-end.",iconUrl:"https://cdn.mcp.so/uploads/d1341762da73dfa75d09dca3c073ac88.png",authorName:"formlm",stars:1,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-08-06T11:43:32.763Z"},$R[119]={id:"f87f23f0-587e-4f6d-b214-1846999cb0d6",slug:"poyo-ai-1095ea",name:"PoYo.ai",tagline:"PoYo.ai gives developers one API key for 500+ AI models, including GPT Image 2, Seedance 2, Sora 2, Gemini 3, and Claude. Credit pricing, polling/webhook workflow, failed tasks not charged.",iconUrl:"https://cdn.mcp.so/uploads/732581d3c1b54526ef807d71e79d47e1.webp",authorName:"poyo.ai",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"web-chat",status:"published",createdAt:"2026-07-16T16:25:34.627Z"},$R[120]={id:"23224604-36e6-445c-8a4f-2fb7b3cf615d",slug:"prism",name:"Prism – Contract Deadline Reader",tagline:"Give your AI agent a contract reader. Prism reads leases, mortgages, insurance policies and HOA documents and returns every deadline with its exact date, what happens if it is missed, and the sentence it came from. Remot",iconUrl:"https://cdn.mcp.so/uploads/1ffca4d2fe48c6de3dc796ba9950f29b.png",authorName:"Built AI, Inc.",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-09-15T07:19:15.432Z"},$R[121]={id:"d469824b-7e5d-4672-a265-f0c59ef29f8d",slug:"apimart-481aef",name:"APIMart",tagline:"The most affordable unified AI API platform. Access GPT-5, Claude 4.5, Gemini, Sora 2 & Flux.1 through one OpenAI-compatible key — drop-in for any MCP client or AI agent. Pay-as-you-go pricing, 99.9% uptime, low latency,",iconUrl:"https://cdn.mcp.so/uploads/82ea0d0f20e13c828479a07cc5ea6716.jpg",authorName:"apimart.ai",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"web-chat",status:"published",createdAt:"2026-07-15T21:40:29.788Z"},$R[122]={id:"85583049-f028-44dd-8dfb-7bb44066c058",slug:"innovalyxx-sovereign-edge",name:"Innovalyxx Sovereign Edge",tagline:"Verified cyber-physical AI tools. 25 MCP tools, x402-payable on Base.",iconUrl:"https://cdn.mcp.so/uploads/1e5b905b039b29e55fb2a97f57c8c85c.png",authorName:"edge.innovalyxx.com",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-09-14T03:56:31.987Z"},$R[123]={id:"e32020a7-3068-49ac-b413-05c31376a1c3",slug:"gocosmik-485d24",name:"Gocosmik",tagline:"Gocosmik is an MCP client available at https://gocosmik.com.",iconUrl:"https://cdn.mcp.so/uploads/a9e5f4676622402d9fa9593022f9da21.png",authorName:"gocosmik.com",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-07-15T19:53:07.484Z"},$R[124]={id:"9ae2dd73-27f4-49b0-afae-0d2a9824b5af",slug:"prove-ai",name:"Prove AI",tagline:"Startup research engine. Scores ideas with live market data. Only 17.5% pass.",iconUrl:"https://cdn.mcp.so/uploads/dc7089dc7aeb9e44f437610f701438cd.png",authorName:"preuve.ai",stars:void 0,verified:!0,featured:!0,editorPick:!1,category:"other",status:"published",createdAt:"2026-09-09T16:04:44.713Z"}],featuredLoops:$R[125]=[$R[126]={id:"loop_f8f201f4-fea8-4e5d-b6fe-90372900d661",slug:"build-until-green",name:"Build Until Green",summary:"Run the production build, fix compile and bundling errors, and loop until the build succeeds.",category:"Testing",type:"manual",featured:!0,verified:!1,agents:$R[127]=[$R[128]={name:"Cursor",active:!0},$R[129]={name:"Claude Code",active:!0}]},$R[130]={id:"loop_6e762b62-28c7-442c-bee8-931b9579f496",slug:"a11y-audit-until-clean",name:"A11y Audit Until Clean",summary:"Run automated accessibility checks on changed routes, fix violations, and repeat until the audit is clean.",category:"Quality",type:"manual",featured:!0,verified:!1,agents:$R[131]=[$R[132]={name:"Cursor",active:!0},$R[133]={name:"Claude Code",active:!1}]},$R[134]={id:"loop_55ff4cdf-32b4-463a-82d9-67447688de14",slug:"coverage-until-threshold",name:"Coverage Until Threshold",summary:"Add focused tests until coverage meets your threshold (e.g. 80%), without changing production behavior unnecessarily.",category:"Testing",type:"manual",featured:!0,verified:!1,agents:$R[135]=[$R[136]={name:"Claude Code",active:!0},$R[137]={name:"Cursor",active:!1}]},$R[138]={id:"loop_cdbf3f89-0309-48f7-8aff-6cb290fad339",slug:"ci-failure-watcher",name:"CI Failure Watcher",summary:"Poll CI on an interval, investigate failures when checks go red, and push fixes until green.",category:"CI",type:"interval",featured:!0,verified:!1,agents:$R[139]=[$R[140]={name:"Cursor",active:!0},$R[141]={name:"Claude Code",active:!0}]},$R[142]={id:"loop_203a8ad8-358b-4a87-b448-dfcbf6c2c9cd",slug:"fix-ci-until-green",name:"Fix CI Until Green",summary:"Fetch the latest failed CI run, reproduce the failure locally, fix it, and repeat until checks pass.",category:"CI",type:"manual",featured:!0,verified:!1,agents:$R[143]=[$R[144]={name:"Cursor",active:!0},$R[145]={name:"Claude Code",active:!0}]},$R[146]={id:"loop_2b3fffef-0ae7-46de-a3e2-37a2d809a924",slug:"pr-babysitter",name:"PR Babysitter",summary:"Every 15 minutes, inspect open PRs with a watch label: nudge reviewers, fix CI, rebase if behind main.",category:"CI",type:"interval",featured:!0,verified:!1,agents:$R[147]=[$R[148]={name:"Codex",active:!0},$R[149]={name:"Cursor",active:!0}]},$R[150]={id:"loop_593619d1-0247-42c5-b051-41d48b072483",slug:"format-until-clean",name:"Format Until Clean",summary:"Run the formatter, fix any remaining style issues, and loop until the codebase formats cleanly with no diffs.",category:"Testing",type:"manual",featured:!0,verified:!1,agents:$R[151]=[$R[152]={name:"Cursor",active:!0}]},$R[153]={id:"loop_8330ad3b-76b5-4abd-a9af-407ca26e71a5",slug:"ralph-story-executor",name:"Ralph Story Executor",summary:"Fresh-context loop: pick one incomplete story from prd.json, implement it, run backpressure checks, commit, and update progress before the next iteration.",category:"Automation",type:"manual",featured:!0,verified:!1,agents:$R[154]=[$R[155]={name:"Cursor",active:!0},$R[156]={name:"Claude Code",active:!0},$R[157]={name:"Codex",active:!1}]}],featuredCli:$R[158]=[$R[159]={slug:"bun",name:"Bun",command:"bun",owner:"oven-sh",repository:"",homepage:"",install:"",category:"developer",kind:"developer-tool",official:!0,verified:!1,agentReady:!1,featured:!0,paidSubmission:!1,aliases:$R[160]=[],description:$R[161]={en:"An all-in-one JavaScript runtime, package manager, bundler, and test runner.",zh:"集 JavaScript Runtime、包管理、打包和测试于一体的工具链。"},capabilities:$R[162]={en:$R[163]=[],zh:$R[164]=[]},examples:$R[165]=[],sources:$R[166]=[]},$R[167]={slug:"cloudflare-wrangler",name:"Cloudflare Wrangler",command:"wrangler",owner:"cloudflare",repository:"",homepage:"",install:"",category:"cloud",kind:"service",official:!0,verified:!1,agentReady:!1,featured:!0,paidSubmission:!1,aliases:$R[168]=[],description:$R[169]={en:"The official Cloudflare developer CLI for Workers, D1, R2, KV, Queues, Workflows, and more.",zh:"Cloudflare 官方开发者 CLI，管理 Workers、D1、R2、KV、Queues、Workflows 等服务。"},capabilities:$R[170]={en:$R[171]=[],zh:$R[172]=[]},examples:$R[173]=[],sources:$R[174]=[]},$R[175]={slug:"duckdb",name:"DuckDB CLI",command:"duckdb",owner:"duckdb",repository:"",homepage:"",install:"",category:"database",kind:"developer-tool",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[176]=[],description:$R[177]={en:"Query local files and analytical datasets with an in-process SQL database.",zh:"使用进程内 SQL 数据库查询本地文件与分析数据集。"},capabilities:$R[178]={en:$R[179]=[],zh:$R[180]=[]},examples:$R[181]=[],sources:$R[182]=[]},$R[183]={slug:"ffmpeg",name:"FFmpeg",command:"ffmpeg",owner:"FFmpeg",repository:"",homepage:"",install:"",category:"media",kind:"developer-tool",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[184]=[],description:$R[185]={en:"Record, convert, stream, inspect, and process audio and video.",zh:"录制、转换、推流、检查和处理音视频。"},capabilities:$R[186]={en:$R[187]=[],zh:$R[188]=[]},examples:$R[189]=[],sources:$R[190]=[]},$R[191]={slug:"github-cli",name:"GitHub CLI",command:"gh",owner:"cli",repository:"",homepage:"",install:"",category:"developer",kind:"developer-tool",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[192]=[],description:$R[193]={en:"GitHub on the command line: repositories, pull requests, issues, Actions, releases, and API calls.",zh:"在命令行使用 GitHub：仓库、Pull Request、Issue、Actions、Release 与 API。"},capabilities:$R[194]={en:$R[195]=[],zh:$R[196]=[]},examples:$R[197]=[],sources:$R[198]=[]},$R[199]={slug:"github-copilot-cli",name:"GitHub Copilot CLI",command:"copilot",owner:"github",repository:"",homepage:"",install:"",category:"ai",kind:"service",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[200]=[],description:$R[201]={en:"GitHub’s terminal coding agent for planning, editing, running, and reviewing changes with repository context.",zh:"GitHub 的终端编程 Agent，可结合仓库上下文规划、编辑、运行并审查变更。"},capabilities:$R[202]={en:$R[203]=[],zh:$R[204]=[]},examples:$R[205]=[],sources:$R[206]=[]},$R[207]={slug:"gitlab-cli",name:"GitLab CLI",command:"glab",owner:"gitlabhq",repository:"",homepage:"",install:"",category:"developer",kind:"developer-tool",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[208]=[],description:$R[209]={en:"GitLab’s official CLI for merge requests, issues, pipelines, releases, snippets, and self-managed instances.",zh:"GitLab 官方 CLI，用于管理 Merge Request、Issue、Pipeline、Release、Snippet 和私有实例。"},capabilities:$R[210]={en:$R[211]=[],zh:$R[212]=[]},examples:$R[213]=[],sources:$R[214]=[]},$R[215]={slug:"google-workspace-cli",name:"Google Workspace CLI",command:"gws",owner:"googleworkspace",repository:"",homepage:"",install:"",category:"productivity",kind:"service",official:!0,verified:!1,agentReady:!0,featured:!0,paidSubmission:!1,aliases:$R[216]=[],description:$R[217]={en:"One command line for Gmail, Drive, Calendar, Sheets, Docs, Chat, Admin, and the rest of Google Workspace.",zh:"一个命令行管理 Gmail、Drive、Calendar、Sheets、Docs、Chat、Admin 等 Google Workspace 服务。"},capabilities:$R[218]={en:$R[219]=[],zh:$R[220]=[]},examples:$R[221]=[],sources:$R[222]=[]}],featuredSkills:$R[223]=[$R[224]={canonicalKey:"obra/superpowers#brainstorming",slug:"brainstorming",owner:"obra",repository:"superpowers",skillSlug:"brainstorming",name:"brainstorming",description:"You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.",summary:$R[225]=["Enforces a hard gate: no code, scaffolding, or implementation actions until design is presented and approved","Guides through nine sequential steps: context exploration, clarifying questions, approach proposals, design presentation, spec documentation, review loop, and user sign-off","Applies to all projects regardless of perceived complexity; even simple tasks require a brief design review to catch unexamined assumptions","Includes optional visual companion for mockups, diagrams, and layout comparisons during brainstorming","Terminates by invoking the writing-plans skill to create implementation roadmaps"],category:"agent-workflows",topics:$R[226]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[227]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[228]=[],sources:$R[229]=[]},$R[230]={canonicalKey:"obra/superpowers#systematic-debugging",slug:"systematic-debugging",owner:"obra",repository:"superpowers",skillSlug:"systematic-debugging",name:"systematic-debugging",description:"Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes",summary:$R[231]=["Four-phase process: root cause investigation, pattern analysis, hypothesis testing, and implementation with mandatory test cases","Requires completing Phase 1 (evidence gathering, error analysis, data flow tracing) before proposing any fixes; blocks symptom-based patching","Includes diagnostic instrumentation guidance for multi-component systems and backward call-stack tracing techniques to isolate failure points","Enforces stopping and questioning architecture after three failed fix attempts, treating repeated failures as a sign of fundamental design problems rather than implementation issues"],category:"agent-workflows",topics:$R[232]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[233]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[234]=[],sources:$R[235]=[]},$R[236]={canonicalKey:"obra/superpowers#writing-plans",slug:"writing-plans",owner:"obra",repository:"superpowers",skillSlug:"writing-plans",name:"writing-plans",description:"Use when you have a spec or requirements for a multi-step task, before touching code",summary:$R[237]=["Decomposes requirements into focused tasks (2–5 minutes each) following TDD: write failing test, verify failure, implement, verify pass, commit","Maps file structure upfront with clear boundaries and responsibilities, ensuring each file has one purpose and files that change together stay together","Includes exact file paths, complete code samples, and specific commands with expected outputs for each step","Requires plan review via subagent before execution; supports two execution modes (subagent-driven per task or inline batch execution)"],category:"agent-workflows",topics:$R[238]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[239]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[240]=[],sources:$R[241]=[]},$R[242]={canonicalKey:"obra/superpowers#using-superpowers",slug:"using-superpowers",owner:"obra",repository:"superpowers",skillSlug:"using-superpowers",name:"using-superpowers",description:"Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions",summary:$R[243]=[],category:"agent-workflows",topics:$R[244]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[245]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[246]=[],sources:$R[247]=[]},$R[248]={canonicalKey:"obra/superpowers#requesting-code-review",slug:"requesting-code-review",owner:"obra",repository:"superpowers",skillSlug:"requesting-code-review",name:"requesting-code-review",description:"Use when completing tasks, implementing major features, or before merging to verify work meets requirements",summary:$R[249]=["Integrates with subagent-driven development workflows, triggering review after each task or before merging to main","Provides code-reviewer subagent with precise git SHAs, implementation details, and requirements, keeping reviewer focused on work product rather than session history","Categorizes feedback into Critical (fix immediately), Important (fix before proceeding), and Minor (note for later) severity levels","Includes template-based dispatch mechanism using Task tool with placeholders for implementation summary, requirements, commit range, and description"],category:"agent-workflows",topics:$R[250]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[251]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[252]=[],sources:$R[253]=[]},$R[254]={canonicalKey:"obra/superpowers#test-driven-development",slug:"test-driven-development",owner:"obra",repository:"superpowers",skillSlug:"test-driven-development",name:"test-driven-development",description:"Use when implementing any feature or bugfix, before writing implementation code",summary:$R[255]=["Follows the red-green-refactor cycle: write a failing test, verify it fails correctly, implement minimal code to pass, then refactor while keeping tests green","Requires deleting any production code written before tests exist; no exceptions for \"reference\" or \"adaptation\"","Emphasizes watching tests fail as proof they actually test the right thing; tests that pass immediately prove nothing","Covers common rationalizations (testing after, manual verification, sunk cost) with concrete rebuttals and a verification checklist to confirm TDD was followed"],category:"agent-workflows",topics:$R[256]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[257]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[258]=[],sources:$R[259]=[]},$R[260]={canonicalKey:"obra/superpowers#executing-plans",slug:"executing-plans",owner:"obra",repository:"superpowers",skillSlug:"executing-plans",name:"executing-plans",description:"Use when you have a written implementation plan to execute in a separate session with review checkpoints",summary:$R[261]=["Requires loading and critically reviewing the plan before execution; raises concerns with the human partner if issues are identified","Executes tasks sequentially, marking progress and running verifications as specified in the plan","Stops immediately on blockers (missing dependencies, test failures, unclear instructions) rather than guessing; asks for clarification","Integrates with git-worktrees for isolated workspaces and finishing-a-development-branch to complete the work after all tasks verify","Works best on platforms with subagent support; recommends subagent-driven-development skill as the preferred alternative when available"],category:"agent-workflows",topics:$R[262]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[263]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[264]=[],sources:$R[265]=[]},$R[266]={canonicalKey:"obra/superpowers#subagent-driven-development",slug:"subagent-driven-development",owner:"obra",repository:"superpowers",skillSlug:"subagent-driven-development",name:"subagent-driven-development",description:"Use when executing implementation plans with independent tasks in the current session",summary:$R[267]=["Isolates each task to a dedicated subagent with precisely crafted context, preventing context pollution and keeping the controller focused on coordination","Enforces a two-stage review cycle: spec compliance reviewer confirms the implementation matches requirements, then code quality reviewer checks for issues","Handles implementer status signals (DONE, DONE_WITH_CONCERNS, NEEDS_CONTEXT, BLOCKED) with appropriate escalation or re-dispatch logic","Recommends model selection by task complexity: cheap models for mechanical 1–2 file tasks, standard models for multi-file integration, most capable models for architecture and review","Requires git worktree setup upfront and integrates with test-driven development and finishing-a-development-branch superpowers"],category:"agent-workflows",topics:$R[268]=[],installCommand:"",repositoryUrl:"",sourceUrl:"",installs:0,weeklyInstalls:$R[269]=[],stars:0,official:!1,verified:!1,featured:!1,paidSubmission:!1,securityAudits:$R[270]=[],sources:$R[271]=[]}]},ssr:!0}],lastMatchId:"␀␀"})($R["tsr"]);$_TSR.e();document.currentScript.remove()</script><script type="module" async="" src="/assets/index-0HrfM8QB.js"></script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a4192975ee122471',t:'MTc5MDQ5Nzk5MA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"e07251f9cb794ae69fdda7d2cd899709","r":1,"spa":2}' crossorigin="anonymous"></script>
