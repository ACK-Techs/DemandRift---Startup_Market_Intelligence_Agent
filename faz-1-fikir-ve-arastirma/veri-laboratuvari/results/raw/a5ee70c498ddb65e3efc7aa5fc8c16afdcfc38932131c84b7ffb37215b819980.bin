case leading-none print:break-after-avoid text-xl imt:text-lg md:text-3xl md:imt:text-[1.5rem] imt:mb-6 !mb-0">Connect to Opportunity</h4><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a data-is-button="true" href="#nyse-listings" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-none focus:outline-none focus-within:ring focus:ring focus:bg-gray-200 focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black admin:bg-primary greentrace:bg-primary-500 greentrace-acr:bg-acr-500 greentrace-art:bg-art-500 text-white border-black greentrace:border-primary-500 greentrace-acr:border-acr-500 greentrace-art:border-art-500 shadow-lg hover:bg-white greentrace:hover:bg-white greentrace-acr:hover:bg-white greentrace-art:hover:bg-white hover:text-black admin:hover:text-white greentrace:hover:text-primary-500 greentrace-acr:hover:text-acr-500 greentrace-art:hover:text-art-500 hover:border-black greentrace:hover:border-primary-500 greentrace-acr:hover:border-acr-500 greentrace-art:hover:border-art-500  greentrace:active:bg-primary-100 greentrace-acr:active:bg-acr-100 greentrace-art:active:bg-art-100 active:text-primary admin:hover:text-white greentrace:active:text-primary-500 greentrace-acr:active:text-acr-500 greentrace-art:active:text-art-500 greentrace:active:border-primary-500 greentrace-acr:active:border-acr-500 greentrace-art:active:border-art-500 active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-4 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-6 md:px-12 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Contact us</span></a></p></div></div></div></div></div></div></div></div></section><main><div data-testid="belt" class="px-3 lg:px-24"><div class="flex flex-1 flex-col items-center justify-center duration-300 hidden"><svg viewBox="0 0 66 66" class="w-full max-w-20" role="progressbar" data-testid="spinner" aria-label="Loading..." aria-busy="true" aria-live="polite"><g><g><circle fill="none" stroke-width="6" stroke-linecap="round" cx="33" cy="33" r="30" stroke-dasharray="187" stroke-dashoffset="0" transform-origin="center" stroke="currentColor"><animate attributeName="stroke-dashoffset" values="187;46.75;187" dur="1.4s" repeatCount="indefinite"></animate><animateTransform attributeName="transform" attributeType="XML" type="rotate" values="0 0 0;135 0 0;450 0 0" dur="1.4s" repeatCount="indefinite"></animateTransform></circle></g><animateTransform attributeName="transform" attributeType="XML" type="rotate" from="0 33 33" to="270 33 33" dur="1.4s" repeatCount="indefinite"></animateTransform></g><g class="duration-300 opacity-0"><path stroke-width="6" stroke="currentColor" d="M33,10 L33,40 M33,45 L33,55"></path></g></svg></div><div class="!mb-10 lg:!mb-20"><div id="integration-id-5e617cf" data-testid="belt" class=""><div class="!mb-8"><div id="integration-id-2b0eaad" class=""><div class="text-center"><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-3xl imt:text-[1.75rem] md:text-5xl md:imt:text-4xl imt:mb-6 !mb-0">A diverse community</h2><hr class="border-0 border-black border-t-2 w-1/5 border-solid mx-auto mt-4 mb-4"/><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Our community includes NYSE-listed global business icons and innovators of all sizes, in virtually every industry and geography. Of public companies listed on US exchanges, our community includes:</p></div></div></div><div class="hidden"></div><div class="infogram-embed [&amp;&gt;iframe]:!w-full" data-id="b06338d3-0fc9-4e32-86ca-2a6ad669cc30" data-type="interactive" data-title="Chart"></div></div></div><div class="!mb-10 lg:!mb-20"><div id="integration-id-f2e0258" data-testid="belt" class="-mx-3 lg:-mx-24"><div id="integration-id-725f99b" data-testid="belt" class="mx-auto w-full sm:w-[540px] md:w-[720px] lg:w-[960px] xl:w-[1140px] 2xl:w-[1320px]"><div class=""><div id="integration-id-bf65ddf" class=""><div class="text-center"><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-3xl imt:text-[1.75rem] md:text-5xl md:imt:text-4xl imt:mb-6 !mb-0">The NYSE Community across the globe</h2><hr class="border-0 border-black border-t-2 w-1/5 border-solid mx-auto mt-4 mb-0"/><div></div></div></div></div><div class=""><div class="hidden"></div><div class="infogram-embed [&amp;&gt;iframe]:!w-full" data-id="61f079b5-2970-4947-8907-1a5946d28762" data-type="interactive" data-title="NYSE community Map - Country of Domicile"></div></div></div></div></div><div class="!mb-10 lg:!mb-20"><div id="integration-id-8f81b2c" data-testid="belt" class=""><div class=""><div class="flex gap-8 flex-col xl:flex-row"><div style="max-width:100vw" class="flex flex-col justify-between flex-4"><div class="!mb-5"><div data-testid="belt" class=""><div class="!mb-8"><img src="https://www.nyse.com/publicdocs/images/NYSE_Community_The_epicenter_of_capital.png" alt="The epicenter of capital + culture" class=""/></div><div class=""><h4 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-xl imt:text-lg md:text-3xl md:imt:text-[1.5rem] imt:mb-6 !mb-0">Global impact</h4><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Over 500 of the world’s largest and most influential international companies spanning over 45 countries have chosen the NYSE as their listing exchange. With each new listing, NYSE connects issuers and investors alike to truly global opportunities.</p><div data-rich-text-ignore="true"><ul class="inline-block pr-0 text-left pl-8 space-y-4 [&amp;_ol]:mt-4 [&amp;_ul]:mt-4 list-disc list-outside"><li class="">NYSE-listed companies employ over 43 million people across the planet. Our community is unmatched in size and scale.</li></ul></div></div></div></div><div class=""><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="/listings/gallery" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">Learn more about our global reach</a></p></div></div><div style="max-width:100vw" class="flex flex-col justify-between flex-4"><div class="!mb-5"><div data-testid="belt" class=""><div class="!mb-8 !-ml-2"><img src="https://www.nyse.com/publicdocs/images/NYSE_Community_Global_impact.jpg" alt="Index Futures &amp; Options" class=""/></div><div class=""><div class=""><h4 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-xl imt:text-lg md:text-3xl md:imt:text-[1.5rem] imt:mb-6 !mb-0">Capitalism at its best</h4><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">NYSE listing standards seek to ensure fair, orderly markets and protect investors while helping issuers raise the capital they need to change the world. We are united by our vision for good governance, transparency and trust.</p><div data-rich-text-ignore="true"><ul class="inline-block pr-0 text-left pl-8 space-y-4 [&amp;_ol]:mt-4 [&amp;_ul]:mt-4 list-disc list-outside"><li class="">Our community includes 74% of the publicly listed Fortune 500 and 70% of the S&amp;P 500 (as of 5/12/2025).</li><li class="">NYSE-listed companies have a 17x higher median market cap than any other US exchange. </li></ul></div></div></div></div></div><div class=""><div class="text-left"><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="/listings/gallery" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">See who has recently listed</a> </p></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p></div></div><div style="max-width:100vw" class="flex flex-col justify-between flex-4"><div class="!mb-5"><div data-testid="belt" class=""><div class="!mb-8"><img src="https://www.nyse.com/publicdocs/images/NYSE_Community_Capitalism_at_its_best.jpg" alt="Capitalism at its best" class=""/></div><div class=""><h4 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-xl imt:text-lg md:text-3xl md:imt:text-[1.5rem] imt:mb-6 !mb-0">The epicenter of capital + culture</h4><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">NYSE hosts over 2,000 events annually serving our issuer community, from Investor Days and board meetings to celebrating key milestones. Our thought leadership programming includes our CEO Council, Tech Council, and regulatory advocacy programs, as well as meetings, forums and conferences that convene business leaders, policy makers and heads of state.</p><div data-rich-text-ignore="true"><ul class="inline-block pr-0 text-left pl-8 space-y-4 [&amp;_ol]:mt-4 [&amp;_ul]:mt-4 list-disc list-outside"><li class="">We welcome over 100,000 people to 11 Wall Street every year at the epicenter of capital and culture.</li></ul></div></div></div></div><div class=""><div class="text-left"><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="https://www.linkedin.com/company/nyse" target="_blank" rel="noopener noreferrer" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">See our community in action</a></p></div></div></div></div></div></div></div><div class=""><div id="integration-id-d1e9ca9" data-testid="belt" class="-mx-3 lg:-mx-24"><div class="bg-black text-white pt-10 pb-10 lg:pt-16 lg:pb-16"><div id="integration-id-0bbd84f" data-testid="belt" class="px-3 lg:px-24"><div id="integration-id-6c671a2" class=""><div class="text-center"><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-3xl imt:text-[1.75rem] md:text-5xl md:imt:text-4xl imt:mb-6 !mb-0">Want to learn more about the NYSE community?</h2><div class="mb-6"></div><div><a data-is-button="true" id="form" href="#nyse-listings" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-none focus:outline-none focus-within:ring focus:ring focus:bg-gray-200 focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black admin:bg-primary greentrace:bg-primary-500 greentrace-acr:bg-acr-500 greentrace-art:bg-art-500 text-white border-black greentrace:border-primary-500 greentrace-acr:border-acr-500 greentrace-art:border-art-500 shadow-lg hover:bg-white greentrace:hover:bg-white greentrace-acr:hover:bg-white greentrace-art:hover:bg-white hover:text-black admin:hover:text-white greentrace:hover:text-primary-500 greentrace-acr:hover:text-acr-500 greentrace-art:hover:text-art-500 hover:border-black greentrace:hover:border-primary-500 greentrace-acr:hover:border-acr-500 greentrace-art:hover:border-art-500  greentrace:active:bg-primary-100 greentrace-acr:active:bg-acr-100 greentrace-art:active:bg-art-100 active:text-primary admin:hover:text-white greentrace:active:text-primary-500 greentrace-acr:active:text-acr-500 greentrace-art:active:text-art-500 greentrace:active:border-primary-500 greentrace-acr:active:border-acr-500 greentrace-art:active:border-art-500 active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-4 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-6 md:px-12 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Contact us</span></a></div></div></div></div></div></div></div><div><div class="contents"></div></div></div></main><footer data-cms-snapshot-exclude="true"><div id="integration-id-4d59614" class="contents nyse"><section class="px-6 print:hidden bg-gray-200" id="integration-id-dfe4c2b"><div data-testid="belt" class="mx-auto max-w-[1872px] sm:w-full md:w-full"><footer><div class="py-16 sm:pb-12 sm:pt-24 md:grid md:grid-cols-12 md:gap-x-16"><div class="md:col-span-3"><a href="/"><svg role="img" viewBox="0 0 377.48 149.42" width="100" class="inline-block text-black"><title>NYSE Logo</title><polygon class="fill-current" points="52.33 121.54 14.26 68.42 0 68.42 0 147.48 15.23 147.48 15.23 94.32 53.3 147.48 67.56 147.48 67.56 68.42 52.33 68.42 52.33 121.54"></polygon><polygon class="fill-current" points="155.8 68.42 137.33 68.42 117.28 101.09 96.66 68.42 77.22 68.42 108 115.41 108 147.48 124.53 147.48 124.53 115.62 155.8 68.42"></polygon><path class="fill-current" d="M199.1,101.2l-9.25-2.11C179,96.66,176.7,94.71,176.7,90c0-4.55,4.7-8.77,13.63-8.77a32.48,32.48,0,0,1,21.6,7.8l9.58-12.67c-8.93-7.3-20.3