cdc0af43","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h4","children":[{"text":"Connect to Opportunity"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"size":"md","type":"spacer","children":[{}]},{"type":"paragraph","children":[{},{"href":"#nyse-listings","icon":"MoveRightIcon","type":"link","wide":true,"children":[{"text":"Contact us"}],"isButton":true},{}]}]}]}}]},"box1bg":"black","box2bg":"primary","variant":"multi-box","box1Text":"white","box2Text":"black","imageAlt":"NYSE","imageFit":"cover","imageSrc":"/publicdocs/images/Hero-NYSE_v2-1920x550-34.jpg","alignBoxes":"alignBoxBottoms","beltSpacing":"normal","imageObjectPosition":"center"},"layout":{"default":{"mb":10}}}],"main":[{"id":"95cb5550-3bb1-47ac-abf7-1b8629642f87","name":"cms-component-popup-video","props":{"slots":{"trigger-container":[]},"hash":"#ces","launchOn":"launcher-click","contentId":"6345374467112"}},{"id":"5e617cfb-2d47-49f6-bffc-c0237569a3b9","name":"cms-component-belt","props":{"slots":{"content":[{"id":"2b0eaad1-1476-4a05-97fe-47cdd354228b","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"text":"A diverse community"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"type":"hr","color":"black","center":true,"narrow":true,"variant":"solid","children":[{}]},{"type":"paragraph","children":[{"text":"Our community includes NYSE-listed global business icons and innovators of all sizes, in virtually every industry and geography. Of public companies listed on US exchanges, our community includes:"}]}]}]},"layout":{"default":{"mb":8},"lg":{},"xl":{}}},{"id":"b661d152-2545-4b16-a156-45d08734d49c","name":"cms-component-infogram-chart","props":{"slots":{},"chartId":"b06338d3-0fc9-4e32-86ca-2a6ad669cc30"}}]},"reverse":false,"spacing":"none"},"layout":{"default":{"mb":10},"lg":{"mb":20}}},{"id":"f2e02585-60bf-4d07-9b0b-8ed651ae6175","name":"cms-component-belt","props":{"slots":{"content":[{"id":"725f99bb-fbc7-4c76-bb56-d75ab5f48332","name":"cms-component-belt","props":{"slots":{"content":[{"id":"bf65ddfc-4e09-4442-b85a-b5628f6f5551","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"text":"The NYSE Community across the globe"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"type":"hr","color":"black","center":true,"narrow":true,"variant":"solid","children":[{}],"bottomSpacing":false},{"type":"div","children":[{}]}]}]},"layout":{"default":{},"lg":{},"xl":{}}},{"id":"e7308045-b79f-4173-92ee-dd030faf42ee","name":"cms-component-infogram-chart","props":{"slots":{},"chartId":"61f079b5-2970-4947-8907-1a5946d28762","chartTitle":"NYSE community Map - Country of Domicile"},"layout":{"xl":{"bw":0,"bc":""}}}]},"spacing":"fixed-1320"}}]},"reverse":true,"spacing":"normal"},"layout":{"default":{"mb":10},"lg":{"mb":20}}},{"id":"8f81b2cd-4d8b-46b7-8910-de54cbce1b53","name":"cms-component-belt","props":{"slots":{"content":[{"id":"fc926466-eeb8-445a-bb3b-a903ecec57ec","name":"cms-component-flex-row","props":{"slots":{"52f04157-3c42-46d4-9754-18e0f42f6048":[{"id":"2e8f37c8-ff64-4c67-a2f6-0c53722e765a","name":"cms-component-belt","props":{"slots":{"content":[{"id":"6c2d1e93-9f1e-4fb3-96b4-4e12fb288fa2","name":"cms-component-image","props":{"slots":{},"alt":"Capitalism at its best","src":"https://www.nyse.com/publicdocs/images/NYSE_Community_Capitalism_at_its_best.jpg","openInNewWindow":false},"layout":{"default":{"mb":8,"ml":0},"sm":{}}},{"id":"3da7dfe3-ec2e-4be3-9140-cdcd31441c7a","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"The epicenter of capital + culture"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"NYSE hosts over 2,000 events annually serving our issuer community, from Investor Days and board meetings to celebrating key milestones. Our thought leadership programming includes our CEO Council, Tech Council, and regulatory advocacy programs, as well as meetings, forums and conferences that convene business leaders, policy makers and heads of state."}]},{"type":"unordered-list","children":[{"type":"list-item","children":[{"text":"We welcome over 100,000 people to 11 Wall Street every year at the epicenter of capital and culture."}]}]}]}}]},"reverse":false,"spacing":"none"},"layout":{"default":{"mb":5}}},{"id":"8e23889a-0d53-49b2-8c80-c9a8e3381c4e","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"left","children":[{"type":"paragraph","children":[{},{"href":"https://www.linkedin.com/company/nyse","type":"link","wide":false,"target":"_blank","children":[{"text":"See our community in action"}],"isButton":false,"buttonBorder":true},{}]}]}]}}],"581f4669-4594-4f39-bbcc-ad943c1d3612":[{"id":"cb47d899-014e-43ae-ace1-983ddef3a319","name":"cms-component-belt","props":{"slots":{"content":[{"id":"fd4ebf82-d043-483e-a5ff-21c9a767ea7a","name":"cms-component-image","props":{"slots":{},"alt":"The epicenter of capital + culture","src":"https://www.nyse.com/publicdocs/images/NYSE_Community_The_epicenter_of_capital.png","openInNewWindow":false},"layout":{"default":{"mb":8,"ml":0},"sm":{}}},{"id":"c08f80e2-3efb-42a4-9017-e12481f4e808","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Global impact"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Over 500 of the world’s largest and most influential international companies spanning over 45 countries have chosen the NYSE as their listing exchange. With each new listing, NYSE connects issuers and investors alike to truly global opportunities."}]},{"type":"unordered-list","children":[{"type":"list-item","children":[{"text":"NYSE-listed companies employ over 43 million people across the planet. Our community is unmatched in size and scale."}]}]}]}}]},"reverse":false,"spacing":"none"},"layout":{"default":{"mb":5}}},{"id":"d84d0bc6-9c1e-4b04-b885-4c4da8c1c8f5","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{},{"href":"/listings/gallery","type":"link","wide":false,"children":[{"text":"Learn more about our global reach"}],"isButton":false,"buttonBorder":true},{}]}]}}],"dbe77831-140e-4f7c-9b35-0eab3e65f8af":[{"id":"6cbbe68a-80a0-4bdf-9892-4ef6a6a80b0d","name":"cms-component-belt","props":{"slots":{"content":[{"id":"6556a11c-9c7e-4fef-9ae0-d11212898fa8","name":"cms-component-image","props":{"slots":{},"alt":"Index Futures & Options","src":"https://www.nyse.com/publicdocs/images/NYSE_Community_Global_impact.jpg","openInNewWindow":false},"layout":{"default":{"mb":8,"ml":-2},"sm":{}}},{"id":"d25feec9-52f0-4a96-a638-29ec1b5ff418","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Capitalism at its best"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"NYSE listing standards seek to ensure fair, orderly markets and protect investors while helping issuers raise the capital they need to change the world. We are united by our vision for good governance, transparency and trust."}]},{"type":"unordered-list","children":[{"type":"list-item","children":[{"text":"Our community includes 74% of the publicly listed Fortune 500 and 70% of the S&P 500 (as of 5/12/2025)."}]},{"type":"list-item","children":[{"text":"NYSE-listed companies have a 17x higher median market cap than any other US exchange. "}]}]}]},"layout":{"lg":{}}}]},"reverse":false,"spacing":"none"},"layout":{"default":{"mb":5}}},{"id":"3e7fd747-3615-46d9-a542-5344ed0739d9","name":"cms-c