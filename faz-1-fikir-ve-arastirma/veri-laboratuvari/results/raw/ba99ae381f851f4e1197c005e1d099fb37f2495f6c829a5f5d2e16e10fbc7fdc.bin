<style>
.logo-scroll {
    position: relative;
    overflow: hidden;
    white-space: nowrap; /* Ensure logos stay in a single line */
opacity: 1;
}

.logo-scroll::before,
.logo-scroll::after {
    content: "";
    position: absolute;
    top: 0;
    width: 50px;
    height: 100%;
    pointer-events: none; /* Ensure it doesn't interfere with interactions */
    z-index: 10;
}

@media screen and (min-width: 782px) {
  .logo-scroll::before,
  .logo-scroll::after {
    width: 10vw; 
  }
}

.logo-scroll::before {
    left: 0;
    background: linear-gradient(to right, #1f0342, transparent);
}

.logo-scroll::after {
    right: 0;
    background: linear-gradient(to left, #1f0342, transparent);
}

.logo-scroll .wp-block-image {
   flex-shrink: 0;
}

body .logo-scroll t .wccom-effect-block.wccom-effect-ticker-scroll-container {
   margin-top: 0;
}

body .logo-scroll .wccom-effect-ticker-scroll {
   flex-basis: auto;
}
</style>



