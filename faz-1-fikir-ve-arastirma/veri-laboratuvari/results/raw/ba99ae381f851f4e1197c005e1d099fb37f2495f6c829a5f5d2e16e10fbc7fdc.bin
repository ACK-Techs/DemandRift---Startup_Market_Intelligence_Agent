<script>
    document.addEventListener("DOMContentLoaded", function() {
        var select27 = document.querySelector('select[name="input_27"]');

        // Function to hide options by value
        function hideOption(selectElement, optionValue) {
            var options = selectElement.querySelectorAll('option');
            options.forEach(function(option, index) {
                if (option.value === optionValue) {
                    option.style.display = "none";
                    selectElement.remove(index);
                }
            });
        }

        // Hide options on select[name="input_27"]
        hideOption(select27, "Find technical support for an existing Woo store");
    });
</script>

<style>

/* Kill Things We Don't like */

.page-section-get-woocommerce, .page-section-guarantee, .wccom-banners__overlay.wccom-banners__shown {
    display: none;
}

/* Make Text Pretty */

.text-balance-pretty {
	text-wrap: pretty;
}
.text-balance-balance {
	text-wrap: balance;
}

/* Hero Mobile Styling */

@media screen and (min-width: 782px) and  (max-width: 1180px) {
    .hero-col-right {
      display: none;
    }
    .hero-col-left {
        margin-left: var(--wccom-content-spacing-horizontal,24px)!important;
         flex-grow: 1!important;
    }
    .hero-col-left > div {
        margin-left: 0;
        max-width: none;
    }
}

/* Calculator CTA Mobile Styling */

@media screen and (min-width: 782px) {
  .calculator-image {
    display: flex;
  }

  .calculator-image figure.wp-block-image {
    display: block;
  }

  .calculator-image figure.wp-block-image img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: left center;
    max-width: none;
  }
}


/* Form Styling */

select[name="input_27"] option[value="Find technical support for my current Woo store"] {
    display: none;
}

/* Chili Piper Meeting Window */

.time-booking-form {
    padding: 24px;
}
.time-booking-form .gform_button.button {
    width: 100%;
    margin: 0;
}

@media (min-width: 700px) {
    .time-booking-form {
        padding: 32px;
    }
}

@media (min-width: 1043px) {
    .time-booking-form .book-title {
        margin: 0.5em 0 0;
    }
}

@media (max-width: 600px) {
    .book-columns {
        flex-direction: column-reverse;
    }
    .time-booking-form {
        padding: 32px;
    }
    .time-booking-form .book-title {
        margin: 0;
    }
}

/* Non-wrapping WooCommerce texts */
.never-break-words {
    overflow-wrap: normal;
    word-break: normal;
    white-space: normal;
    hyphens: none;
    position: relative;
}

</style>



