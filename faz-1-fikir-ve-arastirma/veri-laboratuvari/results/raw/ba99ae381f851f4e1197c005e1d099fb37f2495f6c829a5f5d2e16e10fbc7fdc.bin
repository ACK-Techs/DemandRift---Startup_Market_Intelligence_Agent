<figure class="wp-block-table comp-table is-style-regular" style="margin-top:var(--wp--preset--spacing--32)"><table class="has-woo-white-background-color has-background"><tbody><tr><td><strong>Cost category</strong></td><td><strong>First year cost&nbsp;</strong></td><td><strong>Ongoing annual cost</strong></td></tr><tr><td>Initial development</td><td>$70,000</td><td>$0</td></tr><tr><td>Yearly functional additions/maintenance</td><td>$15,000</td><td>$35,000</td></tr><tr><td>Third-party services (Algolia, Mailchimp, GDPR, Tripletex)</td><td>$3,000</td><td>$3,000</td></tr><tr><td>Server hosting</td><td>$300</td><td>$300</td></tr><tr><td>Premium plugins</td><td>$300</td><td>$300</td></tr><tr><td>Payment fees (~2.5% average, Klarna and Nexi)</td><td>~$50,000</td><td>~$50,000</td></tr><tr><td><strong>Total</strong></td><td><strong>~$139,000</strong></td><td><strong>~$89,500</strong></td></tr><tr><td><strong>Total cost as a percentage of revenue</strong></td><td><strong>6.95%</strong></td><td><strong>4.48%</strong></td></tr></tbody></table></figure>
