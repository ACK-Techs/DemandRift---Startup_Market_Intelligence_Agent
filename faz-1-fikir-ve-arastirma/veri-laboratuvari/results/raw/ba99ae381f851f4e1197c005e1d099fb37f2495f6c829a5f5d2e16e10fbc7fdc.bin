<div class="wp-block-group alignfull is-layout-flow wp-block-group-is-layout-flow" style="margin-bottom:var(--wp--preset--spacing--96)">
<style>
/* --- Platform Comparison Table Styling --- */

.platform-comp-wrapper {
   --max-content-width: calc(var(--wccom-block-content-width) - var(--wccom-content-spacing-horizontal) * 2);
   --side-spacing: calc((100vw - var(--scrollbar-width) - var(--max-content-width)) / 2);
   --border-color: #C3C4C7;
   --side-column-width: 32px;
   --first-column-width: 250px;
   --regular-column-width: 448px;
   --sticky-width: calc( var(--side-column-width) + var(--first-column-width) );
   --gradient-width: 96px;
   position: relative;
}

.platform-comp-wrapper.wccom-effect-horizontal-scroll::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: var(--gradient-width);
    bottom: var(--wp--preset--spacing--32);
    pointer-events: none;
    background: linear-gradient(to right, rgba(115,115,115,0), rgba(115, 115, 115, 0.2) 80%, #D9D9D9);
    transition: opacity 0.3s;
    opacity: 0;
}

.platform-comp-wrapper.wccom-effect-horizontal-scroll.with-gradient-right::after {
  opacity: 1;
}

/* hide scrolled content */
.platform-comp.wp-block-table::after {
    height: 100%;
    content: ' ';
    position: absolute;
    top: 0;
    background: white;
    left: 0px;
    width: calc( var(--side-spacing) + var(--sticky-width) );
    z-index: 1;
}

.platform-comp.wp-block-table {
   overflow-x: unset;
}

.platform-comp a {
   min-height: 56px;
   display: inline-block;
}

.platform-comp table {
   border-spacing: 0;
   border-collapse: separate!important;
   margin-bottom: 0;
  font-size: 87.5%;
}

.platform-comp table td {
  width: var(--regular-column-width);
  min-width: var(--regular-column-width);
  vertical-align: top;
  padding: 16px 32px 24px 32px;
  line-height: 1.25;
}

.platform-comp table td:last-child {
  padding: 0;
    width: var(--side-column-width);
    min-width: var(--side-column-width);
}

/* Make the first column sticky */
.platform-comp table td:first-child {
    position: sticky;
    left: var(--side-spacing);
    z-index: 2;
    background-color: #FFFFFF;
    width: var(--side-column-width);
    min-width: var(--side-column-width);
    padding: 0;
}

.platform-comp table td:nth-child(2) {
    position: sticky;
    left: calc( var(--side-spacing) + var(--side-column-width) );
    z-index: 2;
    background-color: #FFFFFF;
    width: var(--first-column-width);
    min-width: var(--first-column-width);
    padding-left: 12px;
    white-space: normal
}

.platform-comp table tr:not(:first-child, :last-child) td:nth-child(3) {
  background-color: #f2edff !important;
}

.platform-comp table tr:nth-child(2) td {
   padding-top: 24px;
   font-size: 22px;
   line-height: 25px;
}

.platform-comp table tr:nth-child(2) td:nth-child(3) {
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
}

.platform-comp table tr:nth-last-child(2) td:nth-child(3) {
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px; 
}

/* The button has its own padding, so we can reduce the cell padding */
.platform-comp table tr:last-child td:nth-child(2) {
    padding-top: 16px;
    padding-bottom: 30px;
}

.platform-comp table tr td {
  border-bottom: 1px solid var(--border-color);
  border-left: 0;
  border-right: 0;
  border-top: 0;
}

.platform-comp table tr:first-child td {
  border-top: 1px solid var(--border-color);
  border-bottom: 0;
}

.platform-comp table tr:nth-last-child(2) td {
  border-bottom: 0;
}

.platform-comp table tr:first-child td {
   padding: 0!important;
   height: 24px;
}

.platform-comp table tr:last-child td {
   padding-top: 16px!important;
   padding-bottom: 16px!important;
   text-align: center;
}

.platform-comp table tr td:first-child {
  border-left: 1px solid var(--border-color);
}

.platform-comp table tr td:last-child {
  border-right: 1px solid var(--border-color);
}

.platform-comp table tr:first-child td:first-child {
  border-top-left-radius: 16px;
}

.platform-comp table tr:last-child td:first-child {
  border-bottom-left-radius: 16px;
}

.platform-comp table tr:first-child td:last-child {
  border-top-right-radius: 16px;
}

.platform-comp table tr:last-child td:last-child {
  border-bottom-right-radius: 16px;
}

.platform-comp table tr:nth-child(2n+2) td {
   background: white;
}

.platform-comp table tr:not(:last-child) td:first-child,
.platform-comp table tr:not(:last-child) td:last-child {
   border-bottom: 0;
}

@media screen and (max-width: 782px) {
  .platform-comp-wrapper {
   --side-column-width: 16px;
   --first-column-width: 180px;
   --regular-column-width: 200px;
   --gradient-width: 32px;
  }

  .platform-comp table td {
    padding: 16px;
  }

  .platform-comp table td:first-child,
  .platform-comp table td:last-child {
     width: 16px;
     min-width: 16px;
  }

}

@media screen and (max-width: 500px) {
  .platform-comp-wrapper {
   --gradient-width: 24px;
   --first-column-width: 140px;
  }
}

/* Sticky Woo column */
@media screen and (min-width: 1280px) {
  .platform-comp table td:nth-child(3) {
     position: sticky;
     left: calc( var(--side-spacing) + var(--side-column-width) + var(--first-column-width ) );
     z-index: 1;
  }
}

.wccom-effect-horizontal-scroll.all-screens > :first-child.no-select {
  -webkit-user-select: none;
  user-select: none;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  let isDraggingScrollbar = false;
  const links = document.querySelectorAll('.platform-comp a ');
  links.forEach(link => {
    link.classList.add('wccom-button', 'is-style-primary', 'is-large');
  });

  const container = document.querySelector('.platform-comp-wrapper.wccom-effect-horizontal-scroll');
  const scrollableElement = document.querySelector('.platform-comp-wrapper.wccom-effect-horizontal-scroll > :first-child');
   const customScrollbar = document.querySelector('.platform-comp-wrapper .wccom-effect-horizontal-scroll__scrollbar');
  if( ! container || ! scrollableElement ) return;

  // When user starts dragging the scrollbar
  container.addEventListener('mousedown', (e) => {
    if (e.target.closest('.wccom-effect-horizontal-scroll__scrollbar')) {
      scrollableElement.classList.add('no-select');
      isDraggingScrollbar = true;
    }
  });

  // Stop dragging when mouse is released anywhere
  document.addEventListener('mouseup', () => {
    if (isDraggingScrollbar) {
      isDraggingScrollbar = false;
      scrollableElement.classList.remove('no-select');
    }
  });

  function updateRightGradient() {
    const target = scrollableElement.querySelector('.wp-block-table.platform-comp');
    if (!target) return;

    const containerRightEdge = scrollableElement.scrollLeft + scrollableElement.clientWidth;
    const targetRightEdge = target.offsetLeft + target.offsetWidth;
    const isOverflowingRight = targetRightEdge > containerRightEdge + 1;
    container.classList.toggle('with-gradient-right', isOverflowingRight);
  }

  // Debounce helper
  function debounce(fn, delay = 100) {
    let timeout;
    return function (...args) {
      clearTimeout(timeout);
      timeout = setTimeout(() => fn.apply(this, args), delay);
    };
  }

  const debouncedResizeHandler = debounce(updateRightGradient);

  // Listeners
  scrollableElement.addEventListener('scroll', updateRightGradient);
  window.addEventListener('resize', debouncedResizeHandler);

  // Initial check
  updateRightGradient();
});
</script>



