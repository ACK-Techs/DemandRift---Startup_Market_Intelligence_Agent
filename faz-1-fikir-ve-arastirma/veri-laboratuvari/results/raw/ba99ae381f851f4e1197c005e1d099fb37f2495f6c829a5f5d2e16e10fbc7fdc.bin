<body class="wp-singular page-template-default page page-id-18734006440458 wp-theme-woo theme-woo woocommerce-no-js page-pricing group-blog woocommerce-active no-horizontal-scroll wccom-additional-css-marketing">
		<script type="text/javascript">
		( function() {
			var LOCALES = {"en_US":{"name":"English","slug":"en-us"},"es_ES":{"name":"Espa\u00f1ol","slug":"es"},"fr_FR":{"name":"Fran\u00e7ais","slug":"fr"},"pt_BR":{"name":"Portugu\u00eas do Brasil","slug":"pt-br"},"it_IT":{"name":"Italiano","slug":"it"},"de_DE":{"name":"Deutsch","slug":"de"},"de_AT":{"name":"Deutsch (\u00d6sterreich)","slug":"de-at"},"nl_BE":{"name":"Nederlands (Belgi\u00eb)","slug":"nl-be"},"fr_BE":{"name":"Fran\u00e7ais (Belgique)","slug":"fr-be"},"nl_NL":{"name":"Nederlands","slug":"nl"},"pl_PL":{"name":"Polski","slug":"pl"},"pt_PT":{"name":"Portugu\u00eas","slug":"pt"},"de_CH":{"name":"Deutsch (Schweiz)","slug":"de-ch"},"fr_CH":{"name":"Fran\u00e7ais (Suisse)","slug":"fr-ch"},"it_CH":{"name":"Italiano (Svizzera)","slug":"it-ch"},"zh_SG":{"name":"\u4e2d\u6587 (\u65b0\u52a0\u5761)","slug":"zh-sg"},"zh_HK":{"name":"\u4e2d\u6587 (\u9999\u6e2f)","slug":"zh-hk"}};
			var cookieKey ='wccom-locale';
			var supportedLocales = ["en_US","es_ES","de_DE","fr_FR","it_IT","pt_BR"];
			var defaultLocale = 'en_US';
			// Locale from either URL path or a GET parameter
			var urlBasedLocale = 'en_US';
			var noticeText = 'This page is also <a href="%1$s" class="language-link" data-locale="%2$s">available in %3$s</a>.';

			/**
			 * Show the change locale notice notice
			 */
			function showChangeLocaleNotice( locale ) {
				var target = document.querySelector('.woocommerce-notices-wrapper');
				if ( ! supportedLocales.includes( locale ) ) {
					const prefix = locale.split('_')[0];
					locale = supportedLocales.find( supportedLocale => supportedLocale.startsWith( prefix ) );
				}

				if ( ! locale ) {
					return;
				}

				if ( target ) {
					target.classList.add( 'woocommerce-notices-wrapper-i18n' );
					var notice = document.createElement( 'div' );
					notice.classList.add( 'woocommerce-message' );
					notice.attributes['role'] = 'alert';

					notice.innerHTML = noticeText
						.replace( '%1$s', localeUrl( locale ) )
						.replace( '%2$s', locale )
						.replace( '%3$s', localeName( locale ) );

					target.appendChild( notice );

					const link = target.querySelector( 'a' );
					if ( link ) {
						link.addEventListener( 'click', function( event ) {
							setCookie( cookieKey, locale, 365 );
						} );
					}
				}
			}

			/**
			 * Get cookie from document cookie.
			 */
			function getCookie( cname ) {
				var name = cname + '=';
				var decodedCookie = decodeURIComponent( document.cookie );
				var ca = decodedCookie.split( ';' );
				for ( var i = 0; i < ca.length; i++ ) {
					var c = ca[ i ];
					while ( c.charAt(0) == ' ' ) {
						c = c.substring( 1 );
					}
					if ( c.indexOf( name ) == 0 ) {
						return c.substring( name.length, c.length );
					}
				}
				return '';
			}

			/**
			 * Set cookie
			 */
			function setCookie( name, value, days ) {
				var expires = '';
				if (days) {
					var date = new Date();
					date.setTime( date.getTime() + ( days*24*60*60*1000 ) );
					expires = '; expires=' + date.toUTCString();
				}
				document.cookie = name + '=' + (value || '')  + expires + '; sameSite=Strict; path=/';
			}

			/**
			 * Get locale slug from a given locale code.
			 */
			function localeSlug( locale ) {
				return LOCALES[ locale ]
					? LOCALES[ locale ].slug
					: '';
			}

			/**
			 * Get locale name from a given locale code.
			 */
			function localeName( locale ) {
				return LOCALES[ locale ]
					? LOCALES[ locale ].name
					: locale;
			}

			/**
			 * Get locale code from a given locale slug.
			 */
			function slugToLocale( slug ) {
				if ( '' === slug ) {
					return defaultLocale;
				}

				var locale = slug.substr( 0, 2 ) + '_' + slug.substr( -2 );
				return LOCALES[ locale ]
					? locale
					: '';
			}

			function generalizeLocale( locale ) {
				var localeMap = {
					es: 'es_ES',
					fr: 'fr_FR',
					pt: 'pt_BR',
					it: 'it_IT',
					de: 'de_DE',
				};

				var shortLocale = locale.substring( 0, 2 );

				return localeMap.hasOwnProperty( shortLocale )
					? localeMap[ shortLocale ]
					: locale;
			}

			/**
			 * Get browser locale
			 */
			function getBrowserLocale() {
				// browser locale uses - instead of _ e.g. en-US. We need to convert it to _ before using e.g. en_US
				var locale = window.navigator.language.replace( '-', '_' );
				return generalizeLocale( locale );
			}

			/**
			 * Get locale url
			 */
			function localeUrl( targetLocale ) {
				var path = window.location.pathname;

				// Check if path has locale
				var urlLocale = defaultLocale;
				for ( const loc in LOCALES ) {
					if ( path.startsWith( `/${ localeSlug( loc ) }/` ) ) {
						urlLocale = loc;
						break;
					}
				}

				// If path has locale remove it
				if ( urlLocale ) {
					path = path.replace( `/${ localeSlug( urlLocale ) }/`, '/' );
				}

				var newPath = path;
				const slug = localeSlug( targetLocale );
				if ( defaultLocale !== targetLocale && slug ) {
					newPath = newPath.replace( /^\//, '' ); // Remove a prepending slash.
					newPath = '/' + slug + '/' + newPath;
				}

				const [_, pathnameWithQuery] = window.location.href.split( window.location.origin );
				const newPathNameWithQuery = pathnameWithQuery.replace(
					window.location.pathname,
					newPath
				);

				return `${ window.location.origin }${ newPathNameWithQuery }`;
			}

			function processLocales( localeCookie, browserLocale, urlBasedLocale ) {
				let isCookieChangeNeeded = false,
					newCookieValue = null,
					isRedirectNeeded = false,
					redirectURL = null,
					refererLocale = null;

				if ( ! localeCookie ) { // Locale cookie was not set. On first visit, set cookie based on browser locale, not URL
					isCookieChangeNeeded = true;
					newCookieValue = browserLocale;

					// If user is on default locale page but browser wants non-default, redirect
					if ( urlBasedLocale === defaultLocale
						&& browserLocale !== defaultLocale
						&& supportedLocales.includes( browserLocale )
					) {
						isRedirectNeeded = true;
						redirectURL = localeUrl( browserLocale );
						refererLocale = urlBasedLocale;
					}
				} else if (
					urlBasedLocale === defaultLocale
					&& browserLocale !== defaultLocale // A user set non-default locale earlier
					&& supportedLocales.includes( browserLocale )
				) {
					isRedirectNeeded = true; // Redirect to locale of their previous choice
					redirectURL = localeUrl( browserLocale );
					refererLocale = browserLocale;
				}
				return {
					isCookieChangeNeeded,
					newCookieValue,
					isRedirectNeeded,
					redirectURL,
					refererLocale,
				};
			}

			// Check if user explicitly set locale via language switcher
			const urlParams = new URLSearchParams( window.location.search );
			const isExplicitSelection = '1' === urlParams.get( 'set_locale' );

			// Using this function because the object Cookie isn't available
			var localeCookie = getCookie( cookieKey );

			if ( isExplicitSelection ) {
				// Language switcher was used - cookie was already set.
				// If URL locale doesn't match cookie, redirect to correct locale
				if ( localeCookie && urlBasedLocale !== localeCookie ) {
					window.location.replace( localeUrl( localeCookie ) );
				} else {
					// Already on correct locale, just clean up the parameter
					const url = new URL( window.location.href );
					url.searchParams.delete( 'set_locale' );
					window.history.replaceState( {}, '', url.toString() );
				}
			} else {
				// Normal flow - not from language switcher
				// Cookie locale has priority over browser locale
				var browserLocale = localeCookie ? localeCookie : getBrowserLocale();

				const {
					isCookieChangeNeeded,
					newCookieValue,
					isRedirectNeeded,
					redirectURL,
					refererLocale,
				} = processLocales( localeCookie, browserLocale, urlBasedLocale );

				if ( isCookieChangeNeeded && newCookieValue ) {
					setCookie( cookieKey, newCookieValue, 365 );
				}

				if ( isRedirectNeeded && redirectURL ) {
					window.location.replace( redirectURL );
				}

				// Show locale changed notice if referer is the same page with a different language and language prefix is not the same as url locale.
				if ( refererLocale && urlBasedLocale !== refererLocale && urlBasedLocale.split('_')[0] !== refererLocale.split('_')[0] ) {
					document.body.classList.add( 'show-locale-notice' );
					window.addEventListener(
						'DOMContentLoaded',
						function() {
							showChangeLocaleNotice( refererLocale );
						}
					);
				}
			}
		}() );
	</script>
	
