<path fill-rule="evenodd" clip-rule="evenodd" d="M9.13992 4.02848C9.40033 3.7682 9.82244 3.7683 10.0827 4.02871L13.6097 7.55731C14.1301 8.07799 14.1301 8.92204 13.6097 9.44271L10.0827 12.9713C9.82244 13.2317 9.40033 13.2318 9.13992 12.9715C8.87951 12.7112 8.87941 12.2891 9.1397 12.0287L12.0004 9.16668H2.66667C2.29848 9.16668 2 8.8682 2 8.50001C2 8.13182 2.29848 7.83335 2.66667 7.83335H12.0004L9.1397 4.97129C8.87941 4.71088 8.87951 4.28877 9.13992 4.02848Z" fill="currentColor"/>
