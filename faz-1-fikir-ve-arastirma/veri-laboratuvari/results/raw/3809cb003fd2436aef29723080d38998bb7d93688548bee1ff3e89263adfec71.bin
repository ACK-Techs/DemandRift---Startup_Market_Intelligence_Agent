\": \"AggregateRating\",\n        \"ratingValue\": \"4.8\",\n        \"bestRating\": \"5\",\n        \"ratingCount\": \"181\"\n      },\n      \"description\": \"Çiçeksepeti mobil uygulaması ile online alışveriş kolaylığının tadını çıkarın! İster en güzel çiçek ve hediye çeşitlerimizi inceleyip hızlı sipariş verin, ister Extra'da milyonlarca trend ürün arasından alışverişe başlayın, online trendleri yakalayın!\"\n    }\n  ]\n}"])</script><script>self.__next_f.push([1,"f:[\"$\",\"$L16\",\"scripts-7\",{\"data\":{\"key\":\"mobile-schema\",\"value\":\"$17\"}}]\n18:Tcb6,"])</script><script>self.__next_f.push([1,"{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"Organization\",\n  \"@id\": \"https://www.ciceksepeti.com/#organization\",\n  \"name\": \"Çiçeksepeti\",\n  \"alternateName\": [\n    \"çiçek sepeti\",\n    \"ciceksepeti\",\n    \"cicek sepeti\",\n    \"Ciceksepeti\",\n    \"Çiçek Sepeti\",\n    \"Cicek sepeti\",\n    \"ciceksepeti.com\",\n    \"ÇiçekSepeti.com\",\n    \"Çiçeksepeti A.Ş.\"\n  ],\n  \"legalName\": \"Çiçeksepeti İnternet Hiz. A.Ş.\",\n  \"taxID\": \"253 075 95 03\",\n  \"vatID\": \"TR2530759503\",\n  \"ethicsPolicy\": \"https://cdn.ciceksepeti.com/editor/image/%C4%B0%C5%9F%20Ahlak%C4%B1%20ve%20Etik%20Kurallar%C4%B1.pdf\",\n  \"numberOfEmployees\": \"325\",\n  \"award\": [\n    \"2019 LinkedIn Türkiye Yetenek Ödülleri'nde En İyi İşveren Markası\",\n    \"2022 LinkedIn Türkiye Yetenek Ödülleri'nde En İyi İşveren Markası\"\n  ],\n  \"description\": \"Yüzlerce farklı kategoride binlerce ürün Çiçeksepeti'nde! Çiçek, çikolata, hediye seti, parfüm, hediyelik kişiye özel ürünler, yenilebilir çiçek ve daha fazlası online alışveriş sitesi Çiçeksepeti'nde sizleri bekliyor.\",\n  \"logo\": {\n    \"@type\": \"ImageObject\",\n    \"url\": \"https://cdn.ciceksepeti.com/editor/image/ciceksepeti-logo-kare.png\",\n    \"height\": \"112\",\n    \"width\": \"112\"\n  },\n  \"url\": \"https://www.ciceksepeti.com\",\n  \"foundingDate\": \"2006\",\n  \"knowsAbou