910,"2026-09-02T17:47:02.31881+00:00",{"author":1374,"tool":1271,"value":653,"id":1375,"created_at":1376},"c9a46332-8252-48cc-81b6-ae8550f111f1",142912,"2026-09-02T18:08:12.583892+00:00",{"author":1378,"tool":1271,"value":1286,"id":1379,"created_at":1380},"098b28cd-5827-428b-89db-6aff0b6ca8c9",142914,"2026-09-02T18:17:14.513364+00:00",{"author":1382,"tool":1271,"value":1286,"id":1383,"created_at":1384},"ca449b9b-dc52-4af1-9aba-c43c390b670d",142915,"2026-09-02T18:25:28.100147+00:00",{"author":1386,"tool":1271,"value":1286,"id":1387,"created_at":1388},"bcb5b904-ed48-47b7-bce0-b7dd425b8b2e",142917,"2026-09-02T18:34:10.919387+00:00",{"author":1390,"tool":1271,"value":1286,"id":1391,"created_at":1392},"188a0b2e-bfa2-4125-a4f9-1250cbc39fee",142919,"2026-09-02T19:04:52.66047+00:00",{"author":1394,"tool":1271,"value":1286,"id":1395,"created_at":1396},"1687aa33-20fa-45c8-a3bf-285c1cf4fe76",142920,"2026-09-02T19:10:32.962488+00:00",{"author":1398,"tool":1271,"value":1286,"id":1399,"created_at":1400},"8e81a8db-2cf5-49ac-9458-14ec9b3b6cee",142923,"2026-09-02T19:35:20.305962+00:00",{"author":1402,"tool":1271,"value":1403,"id":1404,"created_at":1405},"0ac5c64e-189a-428b-b203-bd65acf51ed7",4,142926,"2026-09-02T19:37:52.817492+00:00",{"author":1407,"tool":1271,"value":1286,"id":1408,"created_at":1409},"a489c035-227b-4774-95ee-cb30db3a3fec",142931,"2026-09-02T20:25:12.567184+00:00",{"author":1411,"tool":1271,"value":1286,"id":1412,"created_at":1413},"a9747c10-a394-44cc-8f4f-635f6f5b5efe",142938,"2026-09-02T20:54:35.862657+00:00",{"author":1415,"tool":1271,"value":1286,"id":1416,"created_at":1417},"fb3831ed-ca90-435d-b6ed-3625add1b4c7",142942,"2026-09-02T20:58:45.557981+00:00",{"author":1419,"tool":1271,"value":653,"id":1420,"created_at":1421},"be4910ca-a535-4825-98a5-f70b4180d464",142943,"2026-09-02T21:03:40.208483+00:00",{"author":1423,"tool":1271,"value":1286,"id":1424,"created_at":1425},"0f9ffe0d-ef61-4869-87d4-3670f189d4c3",142944,"2026-09-02T21:40:32.44424+00:00",{"author":1427