        <script>
            var navbarDropdownFunctionsUrl = document.getElementById('navbarDropdownFunctions').getAttribute('href');
            var navbarDropdownFunctionsResize = function() {
                if (window.innerWidth < 992) {
                    document.getElementById('navbarDropdownFunctions').setAttribute('href', '#');
                } else {
                    document.getElementById('navbarDropdownFunctions').setAttribute('href', navbarDropdownFunctionsUrl);
                }
            };
            window.addEventListener('DOMContentLoaded', function(event) {
                navbarDropdownFunctionsResize();
            });
            window.addEventListener('resize', function(event) {
                navbarDropdownFunctionsResize();
            });
            var navbarPrevent = function(event) {
                event.preventDefault();
                var menuHref = this.getAttribute('href');
                if(menuHref.length && menuHref != "#") window.location.href = menuHref;
            };
            document.addEventListener('click', (event) => {
                if (event.target.closest('#navbarSupportedContent .preventme')) {
                    navbarPrevent.call(event.target, event);
                }
            });
