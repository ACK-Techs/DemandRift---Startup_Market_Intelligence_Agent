<script>
document.addEventListener("DOMContentLoaded", function () {
    const link = document.querySelector("div.oc-home-search__links > a");
    if (link) {
        // Get only the text before the icon
        const icon = link.querySelector(".search_arrow");
        let textOnly = "";

        // Loop through child nodes to separate text from the icon
        link.childNodes.forEach(function (node) {
            if (node.nodeType === Node.TEXT_NODE) {
                textOnly += node.textContent;
            }
        });

        // Clean up spaces and nbsp characters
        textOnly = textOnly
            .replace(/ /g, " ")
            .replace(/\u00A0/g, " ")
            .replace(/\s{2,}/g, " ")
            .trim();

        // Clear link content and rebuild with clean text + icon
        link.innerHTML = textOnly + (icon ? " " + icon.outerHTML : "");
    }
});
</script>
