	display: none;
}

.project_box.type_one .image_box:before {
	background-image: none;
}

body:not(.archive) .auto-container,  body:not(.archive) .auto_container {
  max-width: 100%;
	padding: 0;
}

#main article {
	padding-left: 0;
	padding-right: 0;
}

#content {
	padding-top: 0;
	padding-bottom: 0;
}

@media (max-width: 550px){ 
	#content ul:not(.project_filter, .content_tabs_btns, .elementor-price-table__features-list) li {
		font-size: 14px !important;
		line-height: 24px !important;
	}
}

