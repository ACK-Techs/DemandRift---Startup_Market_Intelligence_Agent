","pricingPage.features.plans.sidekick_standard":"Up to 200 messages","pricingPage.features.plans.sidekick_pro":"Up to 300 messages","pricingPage.features.plans.sidekick_enterprise":"More than 2000 messages","pricingPage.products.core.featuresList.aiWorkflowsBuilder":"AI workflows builder","pricingPage.products.core.featuresList.aiWorkflowsBuilder.description":"Orchestrate workflows that connect agents and AI and watch work get done across every team","pricingPage.features.plans.ai_workflows_standard":"Up to 250 workflows runs","pricingPage.features.plans.ai_workflows_pro":"Up to 375 workflows runs","pricingPage.features.plans.ai_workflows_enterprise":"More than 2,500 workflows runs","pricingPage.products.core.featuresList.vibeAppBuilder":"Vibe app builder","pricingPage.products.core.featuresList.vibeAppBuilder.description":"Turn any business need into a custom business app in minutes","pricingPage.products.core.featuresList.aiColumns":"AI columns","pricingPage.products.core.featuresList.aiColumns.description":"AI columns run your repetitive work directly within your boards, so you can focus on your main priorities","pricingPage.features.plans.vibe_1_app":"1 published app","pricingPage.features.plans.vibe_2_apps":"2 published apps","pricingPage.features.plans.vibe_3_apps":"3 published apps","pricingPage.features.plans.vibe_5_apps":"5 published apps","pricingPage.features.plans.ai_columns_runs":"Up to 200 runs","pricingPage.credits.header.monthly":"{amount} credits/month","pricingPage.credits.header.perSeat":"{amount} credits/seat","pricingPage.credits.header.enterprise":"Start with {amount} credits","pricingPage.credits.table.aiAgents":"Up to {amount} AI agent tasks","pricingPage.credits.table.aiAgents.enterprise":"More than {amount} AI agent tasks","pricingPage.credits.table.aiNotetaker":"Up to {amount} notetaker hours","pricingPage.credits.table.aiNotetaker.enterprise":"More than {amount} notetaker hours","pricingPage.credits.table.sidekick":"Up to {amount} messag