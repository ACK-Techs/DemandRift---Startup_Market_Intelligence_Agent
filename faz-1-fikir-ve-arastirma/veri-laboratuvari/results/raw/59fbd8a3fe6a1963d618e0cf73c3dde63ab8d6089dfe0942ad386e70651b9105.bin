stimonials.defaults.thoughtworks.personName":"Samyuktha Shivakumar","pricingPage.testimonials.defaults.thoughtworks.personTitle":"Global Marketing Operation Manager, Thoughtworks","pricingPage.testimonials.defaults.telefonica.testimonialText":"With monday.com, we’re \u003cb\u003e30% more efficient\u003c/b\u003e at delivering hundreds of campaigns seen by millions of customers.","pricingPage.testimonials.defaults.telefonica.personName":"Tye Rapley-Hawkins","pricingPage.testimonials.defaults.telefonica.personTitle":"Head of Delivery at 02 Priority, Telefonica","pricingPage.testimonials.defaults.genpact.testimonialText":"Since adopting monday.com, our global marketing department has seen a \u003cb\u003e40% improvement in cross-team collaboration\u003c/b\u003e for successful end-to-end campaign planning and execution.","pricingPage.testimonials.defaults.genpact.personName":"Sarah Pharr","pricingPage.testimonials.defaults.genpact.personTitle":"AVP, Marketing, Genpact","pricingPage.products.core.title":"work management","pricingPage.products.core.longTitle":"monday work management","pricingPage.products.core.longTitleBold":"\u003cb\u003emonday\u003c/b\u003e work management","pricingPage.products.core.header.main":"Our core platform to run and scale any workflow","pricingPage.products.core.header.secondary":"Start your 14-day free trial. No credit card needed.","pricingPage.products.core.tiers.basic.description":"Manage all your team’s work in one place","pricingPage.products.core.tiers.basic.features.ai_credits":"AI credits","pricingPage.products.core.tiers.basic.features.ai_credits.description":"Run AI powered features that streamline your work","pricingPage.products.core.tiers.basic.features.sidekick_ai_assistant":"Sidekick AI Assistant (Limited)","pricingPage.products.core.tiers.basic.features.sidekick_ai_assistant.description":"An intelligent, context-aware AI assistant that understands, connects and runs your work.","pricingPage.products.core.tiers.enterprise.descrip