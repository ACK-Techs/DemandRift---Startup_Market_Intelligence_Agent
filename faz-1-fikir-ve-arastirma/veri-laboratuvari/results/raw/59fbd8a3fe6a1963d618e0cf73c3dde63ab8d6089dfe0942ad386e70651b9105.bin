"pricingPage.products.projectManagement.featuresList.slackIntegration":"Slack integration","pricingPage.products.service.featuresList.numberOfTickets":"Number of tickets","pricingPage.products.service.featuresList.numberOfTickets.description":"Easily track and manage an unlimited number of tickets, ensuring seamless support and efficient resolution of customer and employee requests.","pricingPage.products.service.featuresList.unlimitedCustomizable":"Unlimited customizable ticket fields and views","pricingPage.products.service.featuresList.unlimitedCustomizable.description":"Adapt ticket management to your needs with fully customizable fields and layouts, allowing you to capture, organize, and display relevant information for every request.","pricingPage.products.service.featuresList.aiPoweredSmartAssignment":"AI-powered Smart Assignment","pricingPage.products.service.featuresList.aiPoweredSmartAssignment.description":"Automatically route tickets to the right agent based on skills, workload, and priority.","pricingPage.products.service.featuresList.aiDrivenTicketTriage":"AI-driven Ticket Triage","pricingPage.products.service.featuresList.aiDrivenTicketTriage.description":"Categorize and prioritize tickets automatically using AI-driven rules.","pricingPage.products.service.featuresList.slaManagement":"SLA Management","pricingPage.products.service.featuresList.slaManagement.description":"Define, track, and enforce Service Level Agreements (SLAs) with automated escalations.","pricingPage.products.service.featuresList.mandatoryFieldsForResolution":"Mandatory Fields for Resolution","pricingPage.products.service.featuresList.mandatoryFieldsForResolution.description":"Require key information before a ticket can be closed.","pricingPage.products.service.featuresList.unlimitedTagsAndCustomFields":"Unlimited Tags \u0026 Custom Fields","pricingPage.products.service.featuresList.unlimitedTagsAndCustomFields.description":"Categorize and filter tickets with flexible metadata options.","pricingPage.products.service.featuresList.customizableTicketLayouts":"Customizable Ticket Layouts","pricingPage.products.service.featuresList.customizableTicketLayouts.description":"Configure ticket views and fields to match your workflows.","pricingPage.products.service.featuresList.customizableNotifications":"Customizable Notifications","pricingPage.products.service.featuresList.aiEmailGenerator":"AI Email Generator","pricingPage.products.service.featuresList.aiEmailGenerator.description":"Speed up responses with AI-powered email generation, automatically crafting context-aware replies to improve efficiency and consistency in communication.","pricingPage.products.service.featuresList.mergeDuplicateData":"Merge Duplicate Data","pricingPage.products.service.featuresList.mergeDuplicateData.description":"Maintain clean and accurate records by automatically identifying and merging duplicate tickets, contacts, or assets to prevent redundancy and improve data integrity.","pricingPage.products.service.featuresList.twoWayEmailIntegration":"2-Way Email Integration","pricingPage.products.service.featuresList.twoWayEmailIntegration.description":"Sync email conversations with Gmail and Outlook for smooth communication.","pricingPage.products.service.featuresList.formsToIntakeTickets":"Forms to Intake Tickets","pricingPage.products.service.featuresList.formsToIntakeTickets.description":"Simplify request submission with customizable forms, ensuring structured data collection for faster and more accurate ticket resolution.","pricingPage.products.service.featuresList.customizableEmailTemplatesAndSignatures":"Customizable Email Templates \u0026 Signatures","pricingPage.products.service.featuresList.customizableEmailTemplatesAndSignatures.description":"Use pre-configured templates and agent-specific email signatures.","pricingPage.products.service.featuresList.emailTrackingAndAutomation":"Email Tracking \u0026 Automation","pricingPage.products.service.featuresList.emailTrackin