{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is monday work management? ",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Built on top of monday.com Work OS, monday work management enables organizations, managers, and executives to reach shared goals faster and collaboratively at scale. From setting goals to navigating projects and everyday work, monday work management can help you streamline it all. Using powerful features such as automations and dashboards, teams and departments can easily adjust and customize any workflow for any business need."
      }
    },
    {
      "@type": "Question",
      "name": "Does monday.com have a free version?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "monday.com has a free plan which is ideal for freelancers and individual professionals. In addition, we offer a 14-day free trial for the Pro plan."
      }
    },
    {
      "@type": "Question",
      "name": "Is monday.com HIPPAA compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, monday.com complies with the Health Insurance Portability and Accountability Act (HIPAA)."
      }
    }]
}
