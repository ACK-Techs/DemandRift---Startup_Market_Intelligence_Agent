  <!--Addded font api url for NQAF-->
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;700&display=swap" rel="stylesheet" />

  <!-- See https://github.com/datacommonsorg/website/tree/master/packages/web-components -->


  <!--
    DataCommons web-components script. The host is environment-driven:
    Vite replaces https://unsd-datacommons.gcp.un-icc.cloud at build time from .env (local), or with the
    DC_API_ROOT at-brace token in the Docker build, which docker-entrypoint.sh
    substitutes at container startup. See .env.example and
    .claude/rules/datacommons/config.md.
  -->
  <script src="https://unsd-datacommons.gcp.un-icc.cloud/datacommons.js"></script>

