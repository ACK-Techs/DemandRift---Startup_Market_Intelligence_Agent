  <meta charset="utf-8" />
  <!-- Theme (UDC-184): set data-theme before first paint so no flash occurs.
       UDC-462: the toggle was removed and dark is now the only reachable
       theme, so this always sets 'dark' regardless of any persisted value
       from before the toggle's removal. The light theme CSS/assets are kept
       intact in case the toggle is restored later. -->
  <script>(function () {
      document.documentElement.setAttribute('data-theme', 'dark');
    })();</script>
  <!--<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">-->
  <meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#000000" />
  <base href="/" />
  <meta http-equiv="Content-Security-Policy"
    content="frame-src 'self' https://www.youtube.com https://platform.twitter.com/ https://syndication.twitter.com/ https://www.kaltura.com/ https://storymaps.arcgis.com/ https://unstats.un.org/ https://data.un.org/ https://unicc.atlassian.net/" />
  <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
  <meta http-equiv="Permissions-Policy" content="compute-pressure=()" />
