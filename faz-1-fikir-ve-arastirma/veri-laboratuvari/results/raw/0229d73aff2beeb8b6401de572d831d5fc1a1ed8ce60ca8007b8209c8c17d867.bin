<script>

    function showLoader(){
        $('.overlay').show();
    }

    function hideLoader(){
        $('.overlay').hide();
    }
    
    /* Api Manager for making Ajax Calls */
    var searchAjax = null;
    async function callApi(method, url, payload, imageUpload = false) 
    {
        if (url.endsWith("/search") && searchAjax != null) {
            searchAjax.abort();
        }
        const ajaxParams = {
            url: url,
            type: method,
            data: payload,
            dataType: "json",
            cache: false
        }
        if (imageUpload) {
            ajaxParams.contentType = false;
            ajaxParams.processData = false;
            ajaxParams.enctype = 'multipart/form-data';
        }
        const ajaxReq = $.ajax(ajaxParams).always(function(jqXHR, textStatus, errorThrown){
            hideLoader();
        }).done(function(response){
            return response;
        }).fail(function(jqXHR, textStatus, errorThrown){
            if (errorThrown !== "abort") {
                throw errorThrown;
            }
        });
        // Store the current search request
        if (url.endsWith("/search")) {
            searchAjax = ajaxReq;
        }
        return ajaxReq
    }

    /* For calling local API */
    async function callLocalApi(method, url, payload, imageUpload = false){
        var baseUrl = "https://www.saasworthy.com/api/v1";
        return await callApi(method, (baseUrl+url), payload, imageUpload);
    }

    function __loadAuthJS(method, url, payload){
        var baseUrl = "https://www.91-cdn.com/saasworthy-cdn/saasworthy-new/public";
        if (typeof authJSLoaded == 'undefined') {
            let authJS = baseUrl + '/js/web/auth.js';
            __mountScriptElement(__createScriptElement(authJS));
        }
    }

    function __loadLeadgenFormJS(method, url, payload){
        var baseUrl = "https://www.91-cdn.com/saasworthy-cdn/saasworthy-new/public";
        if (typeof LeadgenFormJSLoaded == 'undefined') {
            let LeadgenJS = baseUrl + '/js/web/leadgen-form.js?v=vv1j123bbj123';
            __mountScriptElement(__createScriptElement(LeadgenJS));
        }
    }

    function __loadLeadgenPopupV3Js(){
        var baseUrl = "https://www.91-cdn.com/saasworthy-cdn/saasworthy-new/public";
        if (typeof LeadgenPopupJSLoaded == 'undefined') {
            let LeadgenPopupV3JS = baseUrl + '/js/web/leadgen-popup-v3.js?v=vv1j123bbj123';
            console.log('loading');
            __mountScriptElement(__createScriptElement(LeadgenPopupV3JS));
        }
    }
</script>

