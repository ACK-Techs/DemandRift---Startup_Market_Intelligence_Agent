<script>
    $(function () {
        function dateConvertion(param) {
            var date = new Date(param);

            const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

            var s = date.toLocaleString("en-US", { timeZone: timezone });
            var month = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sept", "Oct", "Nov", "Dec"];
            var dayName = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

            var myDate = new Date(s);

            const timeZoneAbbreviated = () => {
                const { 1: tz } = new Date().toString().match(/\((.+)\)/);

                if (tz.includes(" ")) {
                    return tz
                        .split(" ")
                        .map(([first]) => first)
                        .join("");
                } else {
                    return tz;
                }
            };

            var finalArr = [dayName[myDate.getDay()] + " " + myDate.getDate() + " " + month[myDate.getMonth()] + " " + myDate.getFullYear(), ("0" + myDate.getHours()).slice(-2), ("0" + myDate.getMinutes()).slice(-2), timeZoneAbbreviated()];

            return finalArr;
        }

        $(".mydate").each(function (index) {
            var atAtr = $(this).attr("at");

            var atAtr2 = $(this).attr("at2");

            if (atAtr && atAtr2) {
                var finalDate = dateConvertion(atAtr);
                var finalDate2 = dateConvertion(atAtr2);
                if(finalDate[0] === finalDate2[0]){
                $(this)
                    .find(".dateSpan")
                    .html(finalDate[0] + " • " + finalDate[1] + ":" + finalDate[2] + " " + finalDate[3]);
            } else {
                $(this)
                    .find(".dateSpan")
                    .html(finalDate[0] + " – " + finalDate2[0] + " • " + finalDate[1] + ":" + finalDate[2] + " - " + finalDate2[1] + ":" + finalDate2[2] + " " + finalDate[3]);
                    }
            } else if (atAtr) {
                var finalDate = dateConvertion(atAtr);
                $(this)
                    .find(".dateSpan")
                    .html(finalDate[0] + " • " + finalDate[1] + ":" + finalDate[2] + " " + finalDate[3]);
            } else if (atAtr2) {
                var finalDate2 = dateConvertion(atAtr2);
                $(this)
                    .find(".dateSpan")
                    .html(finalDate2[0] + " • " + finalDate2[1] + ":" + finalDate2[2] + " " + finalDate2[3]);
            } else {
                $(this).find(".dateSpan").html("");
            }
        });
    });
</script>

    





    
    





<script>
    $(".owl-carousel")
        .owlCarousel({
            loop: false,
            margin: 24,
            nav: true,
            autoHeight: false,

            responsive: {
                0: {
                    items: 1,
                    slideBy: 1,
                    stagePadding: 24,
                    nav: false,
                    dots: false,
                    margin: 16,
                },
                576: {
                    items: 2,
                    slideBy: 2,
                    stagePadding: 36,
                    nav: false,
                    dots: false,
                },
                768: {
                    items: 2,
                    slideBy: 2,
                    stagePadding: 36,
                    nav: false,
                    dots: false,
                },
                992: {
                    items: 3,
                    slideBy: 3,
                },
                1200: {
                    items: 3,
                    slideBy: 3,
                },
                1400: {
                    items: 4,
                    slideBy: 4,
                },
            },
        })
        .on("dragged.owl.carousel", function (event) {
            var inline_css = $(".owl-stage").attr("style")?.split(";")[0]?.split("(")[1]?.split(",")[0];
            if (inline_css == "0px") {
                $(".owl-stage").addClass("pl-0");

            } else {
                $(".owl-stage").removeClass("pl-0");

            }

        });
</script>

<script>
