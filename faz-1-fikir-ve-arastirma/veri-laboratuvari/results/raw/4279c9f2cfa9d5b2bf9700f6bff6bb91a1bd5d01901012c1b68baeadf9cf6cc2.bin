<script>
    $(".owl-carousel")
        .owlCarousel({
            loop: false,
            margin: 24,
            nav: true,
            autoHeight: false,

            responsive: {
                0: {
                    items: 1,
                    slideBy: 1,
                    stagePadding: 24,
                    nav: false,
                    dots: false,
                    margin: 16,
                },
                576: {
                    items: 2,
                    slideBy: 2,
                    stagePadding: 36,
                    nav: false,
                    dots: false,
                },
                768: {
                    items: 2,
                    slideBy: 2,
                    stagePadding: 36,
                    nav: false,
                    dots: false,
                },
                992: {
                    items: 3,
                    slideBy: 3,
                },
                1200: {
                    items: 3,
                    slideBy: 3,
                },
                1400: {
                    items: 4,
                    slideBy: 4,
                },
            },
        })
        .on("dragged.owl.carousel", function (event) {
            var inline_css = $(".owl-stage").attr("style")?.split(";")[0]?.split("(")[1]?.split(",")[0];
            if (inline_css == "0px") {
                $(".owl-stage").addClass("pl-0");

            } else {
                $(".owl-stage").removeClass("pl-0");

            }

        });
</script>

<script>
