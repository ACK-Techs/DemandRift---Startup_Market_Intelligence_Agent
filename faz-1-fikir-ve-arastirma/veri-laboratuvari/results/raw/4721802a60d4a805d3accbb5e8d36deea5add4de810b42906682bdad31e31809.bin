            const updateAllCTAs = true;
            const newCtaCopy = "Request a demo";
            const customNavUrl = null;
            const navUrlOnly = false;

            const updateTalkToSalesCTAs = () => {
                const navComponents = ['inc_header_nav_deux'];
                const allCTAs = document.querySelectorAll('a[data-clog-ui-element="link_contact_sales"]');
                // URL-only mode: just update nav URL, no text changes
                if (navUrlOnly && customNavUrl) {
                    allCTAs.forEach((link) => {
                        const componentType = link.getAttribute('data-clog-ui-component');
                        if (componentType && navComponents.includes(componentType)) {
                            link.href = customNavUrl;
                        }
                    });
                    return;
                }

                if (updateAllCTAs) {
                    // Update all CTAs with the data attribute
                    allCTAs.forEach((link) => {
                        const linkText = link.textContent.trim();
                        if (linkText.toLowerCase() === 'talk to sales') {
                            link.textContent = newCtaCopy;
                        }
                    });

                    // Also check footer CTA with different selector
                    const footerCTA = document.querySelector('a[data-qa="footer_cta_contact_sales"]');
                    if (footerCTA && footerCTA.textContent.trim().toLowerCase() === 'talk to sales') {
                        footerCTA.textContent = newCtaCopy;
                    }
                } else {
                    // Desktop nav-only mode - ONLY update nav components
                    allCTAs.forEach((link) => {
                        const componentType = link.getAttribute('data-clog-ui-component');

                        // ONLY update if it's specifically a nav component
                        if (componentType && navComponents.includes(componentType)) {
                            const linkText = link.textContent.trim();
                            if (linkText.toLowerCase() === 'talk to sales') {
                                link.textContent = newCtaCopy;
                            }
                        }
                    });
                }
            };

            // Run when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', updateTalkToSalesCTAs);
            } else {
                updateTalkToSalesCTAs();
            }
        })();</script><script>			if (!window.reducedMotionToggle) window.reducedMotionToggle = {};
