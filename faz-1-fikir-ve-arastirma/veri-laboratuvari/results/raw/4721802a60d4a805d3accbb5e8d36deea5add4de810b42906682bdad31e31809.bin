v2.876h4.4v-2.876z"></path><path d="m32.623 21.984c0 .6904-.5596 1.25-1.25 1.25h-6.9c-.6903 0-1.25-.5596-1.25-1.25v-5.376c0-.6903.5597-1.25 1.25-1.25h6.9c.6904 0 1.25.5597 1.25 1.25zm-2.5-1.25v-2.876h-4.4v2.876z"></path><path d="m44.084 46.3561c0 .6903-.5597 1.25-1.25 1.25h-29.82c-.6904 0-1.25-.5597-1.25-1.25v-14.76c0-.6904.5596-1.25 1.25-1.25h29.82c.6903 0 1.25.5596 1.25 1.25zm-2.5-1.25v-12.26h-27.32v12.26z"></path><path d="m39.8711 31.5961c0 .6903-.5597 1.25-1.25 1.25h-6.9c-.6904 0-1.25-.5597-1.25-1.25v-5.376c0-.6904.5596-1.25 1.25-1.25h6.9c.6903 0 1.25.5596 1.25 1.25zm-2.5-1.25v-2.876h-4.4v2.876z"></path><path d="m15.9766 26.208c0-.6903.5596-1.25 1.25-1.25h6.9c.6903 0 1.25.5597 1.25 1.25v5.376c0 .6904-.5597 1.25-1.25 1.25h-6.9c-.6904 0-1.25-.5596-1.25-1.25zm2.5 1.25v2.876h4.4v-2.876z"></path></g></svg><p class="display-as-subhead"><strong>Build apps for your unique needs.</strong></p><p class="c-feature-grid__item__copy">Slack APIs make it easy to create apps suited for your company and work.</p></div></div></div></section><section class="o-section--feature v--borderless"><div class="o-content-container v--centered"><header class="u-text--center u-padding-bottom--x-large u-padding-top--large"><h2 class="o-section--feature__headline">All the Integrations You Need, from Anthropic to Zoom</h2><p class="o-section--feature__copy u-margin-bottom--medium">Easily connect agents, software, and all your apps in just a few clicks, and start using tools like ChatGPT, Claude, and Asana right within your chats.</p><p><a href="https://slack.com/marketplace" class="link-arrow_blue" data-clog-click data-clog-ui-component="inc_integration_grid" data-clog-ui-element="link_app_directory">Connect your go-to apps in Slack</a></p></header><section class="v--borderless c-integration-grid u-hide-on-mobile"><div class="c-integration-grid__icon" style="background:transparent;width:72px;height:72px"><a href="/marketplace/A01734836JY-asana" title="Asana" data-clog-click data-clog-ui-componen