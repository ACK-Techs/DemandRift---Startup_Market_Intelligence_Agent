olution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=1800" media="(min-width: 1200px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=600" media="(min-width: 900px) and (max-width: 1199px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=1200" media="(min-width: 900px) and (max-width: 1199px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=900" media="(min-width: 600px) and (max-width: 899px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=1800" media="(min-width: 600px) and (max-width: 899px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=600" media="(min-width: 0px) and (max-width: 599px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png?resize-width=1200" media="(min-width: 0px) and (max-width: 599px) and (min-resolution: 1.001dppx)"/><svg viewBox="0 0 900 673" preserveAspectRatio="xMidYMid slice" style="height:100%;width:100%;position:absolute"><foreignObject style="height:100%;width:100%"><div class="IwXXkw _qImYg JbJFjg _CObZw"></div></foreignObject></svg><img src="https://content-management-files.canva.com/217a4d2b-bddc-4ef1-a7d2-00babec7002d/3.png" alt="" height="673" width="900" loading="lazy" class="wfteUP8 _9N8KNO4" style="object-fit:cover;object-position:center center"/></picture></div></div><div class="QFWNFSe WFX_GpW pUgqvUx"><div class="pgwnrjs" style="--alignment:0"><div class="jv_R6g" style="--NZu1Zw:16px"><h2 class="Rm7uEec qcm1mUj I2jq234 PwaZ22p Qgmlf-n" style="--alignment:start;--font-size:calc(var(----lgQg, .1rem)*8/8*24);--line-height:calc(var(----lgQg, .1rem)*8/8*32);--font-variation:&quot;opsz&quot; 100;--font-size-medium-up:calc(var(----lgQg, .1rem)*8/8*32);--line-height-medium-up:calc(var(----lgQg, .1rem)*8/8*42);--font-variation-medium-up:&quot;opsz&quot; 100">Canvassadors</h2><div class="_6LuO_x2 qcm1mUj I2jq234 XhK5Vs8 s7iDOpk" style="--alignment:start;--font-size:calc(var(----lgQg, .1rem)*8/8*16);--line-height:calc(var(----lgQg, .1rem)*8/8*26);--font-variation:unset;--font-size-medium-up:calc(var(----lgQg, .1rem)*8/8*16);--line-height-medium-up:calc(var(----lgQg, .1rem)*8/8*26);--font-variation-medium-up:unset"><span class="jv_R6g" style="--NZu1Zw:8px"><p style="padding:0;margin:0"><span>Canvassadors are Canva advocates who inspire their communities to create with confidence. From hosting workshops and leading trainings to sharing real-world use cases, they help bring creativity to life — while shaping the future of Canva through feedback and collaboration.</span></p><p style="padding:0;margin:0"><span style="font-weight:600">How do I become a Canvassador?</span></p><p style="padding:0;margin:0"><span>Canvassadors are community members who are passionate about empowering others with Canva. Applications open periodically throughout the year. Keep an eye on our community channels for announcements and opportunities to apply.</span></p></span></div></div></div></div></div></div></section><section class="A7kraOt _zF40u8 CPBr2iX Y1TxiMR"><div class="_4-gPR6y"><div class="SwlpcA" style="--lIX0Wg:32px;--Bgy4yg:24px;--CcBh2g:2;--S8wiIA:1;--QrbJUA:center"><div class="npfyfJH kXFBzxL _8Ocs1c6"><div class="KP5ekAg" style="border-radius:16px"><picture class="m-HO09n"><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=900" type="image/avif" media="(min-width: 1200px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=1800" type="image/avif" media="(min-width: 1200px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=600" type="image/avif" media="(min-width: 900px) and (max-width: 1199px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=1200" type="image/avif" media="(min-width: 900px) and (max-width: 1199px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=900" type="image/avif" media="(min-width: 600px) and (max-width: 899px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=1800" type="image/avif" media="(min-width: 600px) and (max-width: 899px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=600" type="image/avif" media="(min-width: 0px) and (max-width: 599px) and (max-resolution: 1dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-format=avif&amp;resize-width=1200" type="image/avif" media="(min-width: 0px) and (max-width: 599px) and (min-resolution: 1.001dppx)"/><source srcSet="https://content-management-files.canva.com/7508fb4f-8325-4874-a8c9-4ebfeb57472d/3.verifiedexperts.png?resize-width=900" media="(min-width: 1200px) and (max-reso