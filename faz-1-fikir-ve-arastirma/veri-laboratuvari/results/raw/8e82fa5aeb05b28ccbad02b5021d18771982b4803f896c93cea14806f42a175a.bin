214"><div class="_ambientGlow_3e05m_42" aria-hidden="true"></div><div class="_cursorOverlay_3e05m_37" aria-hidden="true"></div><div class="_pulseOverlay_3e05m_198" aria-hidden="true"></div><div class="_scanlines_3e05m_242" aria-hidden="true"></div><div class="_borderGlow_3e05m_107" aria-hidden="true"></div><div class="_content_3e05m_272"><h3 class="_heading5_16iio_88 _title_3e05m_347">Fortune 500 leverage, without the team</h3><p class="_textBody_16iio_99 _text_16iio_48 _body_3e05m_352">Access pricing benchmarks and negotiation playbooks from 130,000+ enterprise deals. Know exactly what others pay before you talk to a vendor.</p><div class="_cta_3e05m_371"><span class="_ctaLink_3e05m_375"><span class="_readMoreLink_1wbw2_3 _darkMode_1wbw2_176"><span class="_iconCircle_1wbw2_18"><div class="_glowContainer_1wbw2_50"><div class="_glowWrapper_1wbw2_58"><div class="_glowTracker_1wbw2_74"><div class="_glowInner_1wbw2_85"><div class="_glowBlob1_1wbw2_92"></div><div class="_glowBlob2_1wbw2_104"></div></div></div></div></div><span class="_chevronWrapper_1wbw2_116"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronOut_1wbw2_141"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronIn_1wbw2_142"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg></span></span><span class="_text_1wbw2_36">See pricing benchmarks</span></span></span></div></div><div class="_imageContainer_3e05m_281"><svg width="100%" height="100%" viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="blFadeLeft" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="blFadeRight" x1="100%" y1="0%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="blFadeBottom" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="60%" stop-color="#0f0a19" stop-opacity="0.5"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient></defs><rect x="-30" y="20" width="280" height="200" rx="12" fill="#ffffff" fill-opacity="0.05" stroke="#ffffff" stroke-opacity="0.08"></rect><text x="20" y="50" fill="#ffffff" fill-opacity="0.5" font-size="10">PRICING INTELLIGENCE</text><text x="20" y="85" fill="#ffffff" fill-opacity="0.6" font-size="10">Your Quote</text><rect x="100" y="72" width="140" height="20" rx="4" fill="#ef4444" fill-opacity="0.3"></rect><text x="236" y="86" fill="#ffffff" font-size="11" font-weight="500" text-anchor="end">$185/seat</text><text x="20" y="120" fill="#ffffff" fill-opacity="0.6" font-size="10">Market Avg</text><rect x="100" y="107" width="95" height="20" rx="4" fill="#ffffff" fill-opacity="0.2"></rect><text x="191" y="121" fill="#ffffff" font-size="11" font-weight="500" text-anchor="end">$142/seat</text><text x="20" y="155" fill="#ffffff" fill-opacity="0.6" font-size="10">Best Price</text><rect x="100" y="142" width="70" height="20" rx="4" fill="#10b981" fill-opacity="0.4"></rect><text x="166" y="156" fill="#ffffff" font-size="11" font-weight="500" text-anchor="end">$118/seat</text><rect x="20" y="175" width="230" height="35" rx="6" fill="#a78bfa" fill-opacity="0.15"></rect><text x="30" y="196" fill="#ffffff" font-size="10">Negotiation opportunity:</text><text x="160" y="196" fill="#a78bfa" font-size="10" font-weight="600">23% below quote</text><rect x="265" y="30" width="170" height="180" rx="10" fill="#ffffff" fill-opacity="0.06"></rect><text x="285" y="60" fill="#ffffff" fill-opacity="0.5" font-size="10">LEVERAGE POINTS</text><rect x="285" y="75" width="130" height="40" rx="6" fill="#ffffff" fill-opacity="0.08"></rect><text x="295" y="93" fill="#ffffff" fill-opacity="0.7" font-size="9">End of quarter</text><text x="295" y="108" fill="#10b981" font-size="11" font-weight="500">High leverage</text><rect x="285" y="125" width="130" height="40" rx="6" fill="#ffffff" fill-opacity="0.08"></rect><text x="295" y="143" fill="#ffffff" fill-opacity="0.7" font-size="9">Multi-year discount</text><text x="295" y="158" fill="#10b981" font-size="11" font-weight="500">15-25% typical</text><rect x="285" y="175" width="130" height="40" rx="6" fill="#ffffff" fill-opacity="0.04" stroke="#ffffff" stroke-opacity="0.06"></rect><text x="295" y="193" fill="#ffffff" fill-opacity="0.7" font-size="9">Competitor pressure</text><text x="295" y="208" fill="#a78bfa" font-size="11" font-weight="500">Moderate</text><rect x="-40" y="-10" width="50" height="260" fill="url(#blFadeLeft)"></rect><rect x="390" y="-10" width="50" height="260" fill="url(#blFadeRight)"></rect><rect x="-40" y="200" width="490" height="50" fill="url(#blFadeBottom)"></rect></svg></div></a><a href="/ruth#how-it-works" class="_bentoCard_3e05m_3 _vertical_3e05m_301 _reverseOrder_3e05m_333 _bentoCardTopRight_1mpu7_219"><div class="_ambientGlow_3e05m_42" aria-hidden="true"></div><div class="_cursorOverlay_3e05m_37" aria-hidden="true"></div><div class="_pulseOverlay_3e05m_198" aria-hidden="true"></div><div class="_scanlines_3e05m_242" aria-hidden="true"></div><div class="_borderGlow_3e05m_107" aria-hidden="true"></div><div class="_content_3e05m_272"><h3 class="_heading5_16iio_88 _title_3e05m_347">We do the heavy lifting</h3><p class="_textBody_16iio_99 _text_16iio_48 _body_3e05m_352">No procurement expertise needed. Vendr&#x27;s agents draw on 130,000+ deals to draft the right emails, know which suppliers bend on price, and negotiate on your behalf.</p><div class="_cta_3e05m_371"><span class="_ctaLink_3e05m_375"><span class="_readMoreLink_1wbw2_3 _darkMode_1wbw2_176"><span class="_iconCircle_1wbw2_18"><div class="_glowContainer_1wbw2_50"><div class="_glowWrapper_1wbw2_58"><div class="_glowTracker_1wbw2_74"><div class="_glowInner_1wbw2_85"><div class="_glowBlob1_1wbw2_92"></div><div class="_glowBlob2_1wbw2_104"></div></div></div></div></div><span class="_chevronWrapper_1wbw2_116"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronOut_1wbw2_141"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronIn_1wbw2_142"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg></span></span><span class="_text_1wbw2_36">See how it works</span></span></span></div></div><div class="_imageContainer_3e05m_281"><svg width="100%" height="100%" viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="siFadeLeft" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="siFadeRight" x1="100%" y1="0%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="siFadeBottom" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="60%" stop-color="#0f0a19" stop-opacity="0.5"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient></defs><rect x="-20" y="15" width="330" height="210" rx="12" fill="#ffffff" fill-opacity="0.05" stroke="#ffffff" stroke-opacity="0.08"></rect><rect x="100" y="35" width="190" height="50" rx="10" fill="#ffffff" fill-opacity="0.12"></rect><text x="115" y="55" fill="#ffffff" fill-opacity="0.8" font-size="10">I got this quote for Salesforce.</text><text x="115" y="70" fill="#ffffff" fill-opacity="0.8" font-size="10">Is it a good deal?</text><rect x="20" y="95" width="260" height="110" rx="10" fill="#a78bfa" fill-opacity="0.12"></rect><circle cx="40" cy="115" r="12" fill="#a78bfa" fill-opacity="0.3"></circle><text x="40" y="115" text-anchor="middle" dominant-baseline="central" fill="#ffffff" font-size="10" font-weight="600">V</text><text x="60" y="118" fill="#ffffff" fill-opacity="0.9" font-size="10">Based on 847 similar deals:</text><rect x="35" y="130" width="95" height="30" rx="4" fill="#ffffff" fill-opacity="0.08"></rect><text x="82" y="142" fill="#ffffff" fill-opacity="0.5" font-size="8" text-anchor="middle">YOUR QUOTE</text><text x="82" y="154" fill="#ffffff" font-size="10" font-weight="500" text-anchor="middle">$185/seat</text><rect x="140" y="130" width="95" height="30" rx="4" fill="#ffffff" fill-opacity="0.08"></rect><text x="187" y="142" fill="#ffffff" fill-opacity="0.5" font-size="8" text-anchor="middle">FAIR PRICE</text><text x="187" y="154" fill="#10b981" font-size="10" font-weight="500" text-anchor="middle">$142/seat</text><rect x="35" y="168" width="225" height="25" rx="4" fill="#fef3c7" fill-opacity="0.15"></rect><text x="147" y="184" fill="#ffffff" fill-opacity="0.9" font-size="9" text-anchor="middle">Room to negotiate ~23% discount</text><rect x="320" y="40" width="110" height="160" rx="10" fill="#ffffff" fill-opacity="0.06"></rect><text x="340" y="70" fill="#ffffff" fill-opacity="0.5" font-size="9">UPLOADED</text><rect x="340" y="85" width="70" height="50" rx="6" fill="#ffffff" fill-opacity="0.1"></rect><rect x="350" y="98" width="50" height="4" rx="1" fill="#ffffff" fill-opacity="0.3"></rect><rect x="350" y="106" width="40" height="4" rx="1" fill="#ffffff" fill-opacity="0.2"></rect><rect x="350" y="114" width="45" height="4" rx="1" fill="#ffffff" fill-opacity="0.2"></rect><text x="375" y="130" text-anchor="middle" fill="#ffffff" fill-opacity="0.5" font-size="8">Quote.pdf</text><circle cx="375" cy="165" r="20" fill="#10b981" fill-opacity="0.15"></circle><path d="M367 165 L373 171 L383 159" stroke="#10b981" stroke-width="2" fill="none"></path><rect x="-30" y="-10" width="50" height="260" fill="url(#siFadeLeft)"></rect><rect x="380" y="-10" width="50" height="260" fill="url(#siFadeRight)"></rect><rect x="-30" y="200" width="460" height="50" fill="url(#siFadeBottom)"></rect></svg></div></a><a href="/ruth" class="_bentoCard_3e05m_3 _horizontal_3e05m_266 _bentoCardBottom_1mpu7_197"><div class="_ambientGlow_3e05m_42" aria-hidden="true"></div><div class="_cursorOverlay_3e05m_37" aria-hidden="true"></div><div class="_pulseOverlay_3e05m_198" aria-hidden="true"></div><div class="_scanlines_3e05m_242" aria-hidden="true"></div><div class="_borderGlow_3e05m_107" aria-hidden="true"></div><div class="_content_3e05m_272"><h3 class="_heading5_16iio_88 _title_3e05m_347">Skip the sales calls entirely</h3><p class="_textBody_16iio_99 _text_16iio_48 _body_3e05m_352">Vendr negotiates asynchronously over email, on your behalf. No meetings, no back-and-forth, no stress. Just savings delivered to your inbox.</p><div class="_cta_3e05m_371"><span class="_ctaLink_3e05m_375"><span class="_readMoreLink_1wbw2_3 _darkMode_1wbw2_176"><span class="_iconCircle_1wbw2_18"><div class="_glowContainer_1wbw2_50"><div class="_glowWrapper_1wbw2_58"><div class="_glowTracker_1wbw2_74"><div class="_glowInner_1wbw2_85"><div class="_glowBlob1_1wbw2_92"></div><div class="_glowBlob2_1wbw2_104"></div></div></div></div></div><span class="_chevronWrapper_1wbw2_116"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronOut_1wbw2_141"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="_chevronIn_1wbw2_142"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path></svg></span></span><span class="_text_1wbw2_36">Explore negotiation agent</span></span></span></div></div><div class="_imageContainer_3e05m_281"><svg width="100%" height="100%" viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="aeFadeLeft" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="aeFadeRight" x1="100%" y1="0%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="50%" stop-color="#0f0a19" stop-opacity="0.6"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient><linearGradient id="aeFadeBottom" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#0f0a19" stop-opacity="1"></stop><stop offset="60%" stop-color="#0f0a19" stop-opacity="0.5"></stop><stop offset="100%" stop-color="#0f0a19" stop-opacity="0"></stop></linearGradient></defs><rect x="-30" y="20" width="280" height="200" rx="12" fill="#ffffff" fill-opacity="0.05" stroke="#ffffff" stroke-opacity="0.08"></rect><text x="20" y="48" fill="#ffffff" fill-opacity="0.5" font-size="10">NEGOTIATION THREAD</text><rect x="20" y="60" width="210" height="38" rx="6" fill="#ffffff" fill-opacity="0.06"></rect><circle cx="38" cy="79" r="10" fill="#a78bfa" fill-opacity="0.3"></circle><text x="38" y="79" text-anchor="middle" dominant-baseline="central" fill="#ffffff" font-size="8" font-weight="600">V</text><text x="55" y="74" fill="#ffffff" fill-opacity="0.8" font-size="9">Initial proposal sent</text><text x="55" y="88" fill="#ffffff" fill-opacity="0.4" font-size="8">Requested 20% discount based on market data</text><rect x="20" y="105" width="210" height="38" rx="6" fill="#ffffff" fill-opacity="0.06"></rect><circle cx="38" cy="124" r="10" fill="#ffffff" fill-opacity="0.2"></circle><text x="38" y="128" text-anchor="middle" fill="#ffffff" fill-opacity="0.6" font-size="8">S</text><text x="55" y="119" fill="#ffffff" fill-opacity="0.8" font-size="9">Supplier counter-offer</text><text x="55" y="133" fill="#ffffff" fill-opacity="0.4" font-size="8">Offered 12% discount, 2-year term</text><rect x="20" y="150" width="210" height="38" rx="6" fill="#ffffff" fill-opacity="0.06"></rect><circle cx="38" cy="169" r="10" fill="#a78bfa" fill-opacity="0.3"></circle><text x="38" y="169" text-anchor="middle" dominant-baseline="central" fill="#ffffff" font-size="8" font-weight="600">V</text><text x="55" y="164" fill="#ffffff" fill-opacity="0.8" font-size="9">Final terms agreed</text><text x="55" y="178" fill="#10b981" fill-opacity="0.8" font-size="8">18% discount secured + payment terms</text><rect x="20" y="195" width="210" height="20" rx="4" fill="#10b981" fill-opacity="0.15"></rect><text x="125" y="209" text-anchor="middle" fill="#10b981" font-size="9">0 meetings required</text><rect x="265" y="30" width="170" height="180" rx="10" fill="#ffffff" fill-opacity="0.06"></rect><text x="285" y="60" fill="#ffffff" fill-opacity="0.5" font-size="10">OUTCOME</text><text x="285" y="90" fill="#ffffff" fill-opacity="0.6" font-size="9">Savings achieved</text><text x="285" y="115" fill="#a78bfa" font-size="26" font-weight="600">$18,400</text><text x="285" y="145" fill="#ffffff" fill-opacity="0.6" font-size="9">Time to close</text><text x="285" y="165" fill="#ffffff" font-size="16" font-weight="500">6 days</text><rect x="285" y="180" width="100" height="24" rx="6" fill="#10b981" fill-opacity="0.2"></rect><text x="335" y="196" text-anchor="middle" fill="#10b981" font-size="10" font-weight="500">Complete</text><rect x="-40" y="-10" width="50" height="260" fill="url(#aeFadeLeft)"></rect><rect x="390" y="-10" width="50" height="260" fill="url(#aeFadeRight)"></rect><rect x="-40" y="200" width="480" height="50" fill="url(#aeFadeBottom)"></rect></svg></div></a></div></div></section><section class="_integrationsSection_14r8v_1"><div class="_heading_14r8v_11"><h2 class="_heading4_16iio_78">Designed to handle growth and extend across your stack.</h2></div><div class="_grid_14r8v_22"><div class="_integrationsCard_14r8v_29"><div class="_cursorOverlay_14r8v_69" aria-hidden="true"></div><div class="_integrationsContent_14r8v_136 _cardContent_14r8v_144"><div class="_cardHeader_14r8v_243"><div class="_iconWrapper_14r8v_250 _integrations_14r8v_1"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M88.57,35A8,8,0,0,1,103.43,29l8,20A8,8,0,0,1,96.57,55ZM29,103.43l20,8A8,8,0,1,0,55,96.57l-20-8A8,8,0,0,0,29,103.43ZM227,152.57l-20-8A8,8,0,1,0,201,159.43l20,8A8,8,0,0,0,227,152.57ZM159.43,201A8,8,0,0,0,144.57,207l8,20A8,8,0,1,0,167.43,221ZM237.91,18.52a8,8,0,0,0-11.5-.18L174,70.75l-5.38-5.38a32,32,0,0,0-45.28,0L106.14,82.54a4,4,0,0,0,0,5.66l61.7,61.66a4,4,0,0,0,5.66,0l16.74-16.74a32.76,32.76,0,0,0,9.81-22.52,31.82,31.82,0,0,0-9.37-23.17l-5.38-5.37,52.2-52.17A8.22,8.22,0,0,0,237.91,18.52ZM85.64,90.34a8,8,0,0,0-11.49.18,8.22,8.22,0,0,0,.41,11.37L80.67,108,65.34,123.31A31.82,31.82,0,0,0,56,146.47,32.75,32.75,0,0,0,65.77,169l5,4.94L18.49,226.13a8.21,8.21,0,0,0-.61,11.1,8,8,0,0,0,11.72.43L82,185.25l5.37,5.38a32.1,32.1,0,0,0,45.29,0L148,175.31l6.34,6.35a8,8,0,0,0,11.32-11.32Z"></path></svg></div><span class="_cardTitle_14r8v_274">INTEGRATIONS</span></div><div class="_cardContentWrapper_14r8v_282"><div class="_cardHeading_14r8v_288"><h3 class="_heading5_16iio_88">Built to integrate</h3></div><div class="_cardBody_14r8v_300"><p class="_textBody_16iio_99 _text_16iio_48">Vendr&#x27;s pricing and negotiation agents are designed to live inside procurement workflows, and operate in sync with the platforms you use every day.</p></div></div></div></div><div class="_card_14r8v_144"><div class="_cardHeader_14r8v_243"><div class="_iconWrapper_14r8v_250 _api_14r8v_264"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM92.8,145.6a8,8,0,1,1-9.6,12.8l-32-24a8,8,0,0,1,0-12.8l32-24a8,8,0,0,1,9.6,12.8L69.33,128Zm58.89-71.4-32,112a8,8,0,1,1-15.38-4.4l32-112a8,8,0,0,1,15.38,4.4Zm53.11,60.2-32,24a8,8,0,0,1-9.6-12.8L186.67,128,163.2,110.4a8,8,0,1,1,9.6-12.8l32,24a8,8,0,0,1,0,12.8Z"></path></svg></div><span class="_cardTitle_14r8v_274">API</span></div><div class="_cardContentWrapper_14r8v_282"><div class="_cardHeading_14r8v_288"><h3 class="_heading5_16iio_88 _smallCardHeading_14r8v_294">Pricing intelligence as infrastructure</h3></div><div class="_cardBody_14r8v_300"><p class="_textBody_16iio_99 _text_16iio_48">Vendr exposes its pricing and negotiation data through APIs designed for modern, agent-driven procurement systems.</p></div><div class="_cardLink_14r8v_317"><a href="https://developers.vendr.com/docs/introduction" class="_readMoreLink_1wbw2_3"><span class="_iconCircle_1wbw2_18"><div class="_glowContainer_1wbw2_50"><div class="_glowWrapper_1wbw2_58"><div class="_glowTracker_1wbw2_74"><div class="_glowInner_1wbw2_85"><div class="_glowBlob1_1wbw2_92"></div><div class="_glowBlob2_1w