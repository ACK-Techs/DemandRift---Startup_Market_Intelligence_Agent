="8" fill="#ffffff" fill-opacity="0.04" stroke="#ffffff" stroke-opacity="0.06"></rect><text x="295" y="245" fill="#ffffff" fill-opacity="0.4" font-size="8">THIS QUARTER</text><text x="295" y="262" fill="#a78bfa" font-size="14" font-weight="600">$127k</text><text x="347" y="262" fill="#ffffff" fill-opacity="0.4" font-size="9">saved</text><rect x="395" y="225" width="105" height="45" rx="8" fill="#ffffff" fill-opacity="0.04" stroke="#ffffff" stroke-opacity="0.06"></rect><text x="410" y="245" fill="#ffffff" fill-opacity="0.4" font-size="8">LONG TAIL</text><text x="410" y="262" fill="#10b981" font-size="14" font-weight="600">47</text><text x="432" y="262" fill="#ffffff" fill-opacity="0.4" font-size="9">renewals captured</text><rect x="-30" y="-10" width="60" height="300" fill="url(#wfFadeLeft)"></rect><rect x="470" y="-10" width="60" height="300" fill="url(#wfFadeRight)"></rect><rect x="-30" y="235" width="560" height="55" fill="url(#wfFadeBottom)"></rect><rect x="-30" y="-10" width="560" height="35" fill="url(#wfFadeTop)"></rect></svg></div></a><a href="/ruth" class="_bentoCard_3e05m_3 _vertical_3e05m_301 _bentoCardBottomLeft_1mpu7_197"><div class="_ambientGlow_3e05m_42" aria-hidden="true"></div><div class="_cursorOverlay_3e05m_37" aria-hidden="true"></div><div class="_pulseOverlay_3e05m_198" aria-hidden="true"></div><div class="_scanlines_3e05m_242" aria-hidden="true"></div><div class="_borderGlow_3e05m_107" aria-hidden="true"></div><div class="_content_3e05m_272"><h3 class="_heading5_16iio_88 _title_3e05m_347">Built on 130,000+ real negotiations</h3><p class="_textBody_16iio_99 _text_16iio_48 _body_3e05m_352">Vendr&#x27;s agents learn from actual deal outcomes across thousands of suppliers—the strategies that work, the concessions that stick, the timing that matters.</p><div class="_cta_3e05m_371"><span class="_ctaLink_3e05m_375"><span class="_readMoreLink_1wbw2_3 _darkMode_1wbw2_176"><span class="_iconCircle_1wbw2_18"><div class="_glowContainer_1wbw2_50"><div class=