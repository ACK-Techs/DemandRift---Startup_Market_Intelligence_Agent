       .tooltip-container {
            position: relative; 
            display: inline-block; 
            cursor: pointer; 
            border-bottom: 1px dotted currentColor; 
            padding-bottom: 2px; 

        }

        /* Tooltip Text: The actual tooltip that appears. */
        .tooltip-text {
            visibility: hidden; 
            opacity: 0; 
            width: 300px; 
            background-color: #ffffff; 
            color: #595959; 
            text-align: left;
            padding: 24px; 
           border: 1px solid #D4D2D0;
          border-radius: 8px; 
            box-shadow: 0px 0px 2px rgba(45, 45, 45, 0.2), 0px 4px 8px rgba(45, 45, 45, 0.16), 0px 8px 16px rgba(45, 45, 45, 0.12);

            /* Positioning the tooltip */
            position: absolute;
            z-index: 1; 
            bottom: 125%; 
            left: 50%;
            transform: translateX(-50%) translateY(10px); 

            /* Smooth transition for visibility, opacity, and transform */
            transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
            pointer-events: none; 
        }


        .tooltip-text::after {
            content: "";
            position: absolute;
            top: 100%; 
            left: 50%;
            margin-left: -5px; 
            border-width: 5px;
            border-style: solid;
            border-color: #D4D2D0 transparent transparent transparent; 
        }


        .tooltip-container.tooltip-active .tooltip-text {
            visibility: visible; 
            opacity: 1; 
            transform: translateX(-50%) translateY(0); 
            transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0s; 
        }

     
</style>
