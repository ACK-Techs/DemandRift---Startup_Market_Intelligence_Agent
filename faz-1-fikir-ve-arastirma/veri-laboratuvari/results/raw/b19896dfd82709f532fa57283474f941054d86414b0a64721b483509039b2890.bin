<script>
				function convert_to_url(obj) {
					return Object
					.keys(obj)
					.map(k => `${encodeURIComponent(k)}=${encodeURIComponent(obj[k])}`)
					.join('&');
				}

				function pass_to_backend() {
					if(window.location.hash) {
						var hash = window.location.hash;
						var elements = {};
						hash.split("#")[1].split("&").forEach(element => {
							var vars = element.split("=");
							elements[vars[0]] = vars[1];
						});
						if(("access_token" in elements) || ("id_token" in elements) || ("token" in elements)) {
							if(window.location.href.indexOf("?") !== -1) {
								window.location = (window.location.href.split("?")[0] + window.location.hash).split('#')[0] + "?" + convert_to_url(elements);
							} else {
								window.location = window.location.href.split('#')[0] + "?" + convert_to_url(elements);
							}
						}
					}
				}

				pass_to_backend();
			</script>
<script> // Get all tooltip containers
        const tooltipContainers = document.querySelectorAll('.tooltip-container');

        // Add click event listener to each tooltip container
        tooltipContainers.forEach(container => {
            container.addEventListener('click', function(event) {
                event.stopPropagation(); // Prevent click from immediately closing due to document listener

                // Check if this tooltip is already active
                const isActive = this.classList.contains('tooltip-active');

                // First, deactivate all other tooltips
                tooltipContainers.forEach(otherContainer => {
                    if (otherContainer !== this) {
                        otherContainer.classList.remove('tooltip-active');
                    }
                });

                // Then, toggle the current tooltip
                if (isActive) {
                    this.classList.remove('tooltip-active');
                } else {
                    this.classList.add('tooltip-active');
                }
            });
        });

        // Add click event listener to the document to close tooltips when clicking outside
        document.addEventListener('click', function(event) {
            tooltipContainers.forEach(container => {
                // If the click is outside the container and its tooltip text, remove active class
                if (!container.contains(event.target)) {
                    container.classList.remove('tooltip-active');
                }
            });
        });</script>

