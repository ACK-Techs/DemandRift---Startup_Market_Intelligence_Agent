const pageviewPayload = null;
const isFootprintMigrationEnabled = false;
const comscorePublisherId = "6036206";
let count = 0;
const MAX_COUNT = 100;

window.s = window.s || {};
window.trulia = window.trulia || {};
window.trulia.dataLayer = window.trulia.dataLayer || {};
window.trulia.dataLayer.referrer = document.referrer;

function handleComscore(data, event) {
  if (!data) {
    return;
  }
  if (data.pageLoad === 1 ||
    data.pageLoad === '1' ||
    event === 'trackState'
  ) {
    const csParam = 'comscore';
    const kwSuffix = 'kw';
    const kwValue = 'truliarentals';
    const isRental = data.siteSection === 'rent' || data.pageDetails === 'rent';
    const query = isRental ? '?' + csParam + kwSuffix + '=' + kwValue : '';
    const url = "/api/comscore" + query;
    fetch(url, {
      cache: 'no-store',
      headers: { 'Cache-Control': 'no-store' },
    });

    if (event === 'trackState' && data.pageLoad !== 1 && data.pageLoad !== '1') {
      if (typeof COMSCORE !== 'undefined' && COMSCORE.beacon) {
        const beaconConfig = {c1: "2", c2: comscorePublisherId};
        beaconConfig[csParam + kwSuffix] = isRental ? kwValue : '';
        COMSCORE.beacon(beaconConfig);
      }
    }
  }
}

function handleFootprint(event, data) {
  const now = new Date();
  const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const day = dayNames[now.getDay()];
  const hhmm = now.toTimeString().substring(0,5);
  const gmt = now.toTimeString().substring(12,17);
  const clientDate = day + '|' + hhmm + '|' + gmt;

  const footprintData = {
    ...data,
    url: window.location.href,
    urlQuery: window.location.search,
    clientDate: clientDate,
  };

  fetch("https://www.trulia.com/fp/api/v1/browser", {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(footprintData),
  }).catch((error) => {
    console.log('fp error', error);
  });
};

function listenersDefined() {
  const listeners = window.trulia.dataLayer.listeners;
  return typeof listeners !== 'undefined' && listeners.length !== 0;
}


const handleEvent = function (event, data, isInitialPageView) {
