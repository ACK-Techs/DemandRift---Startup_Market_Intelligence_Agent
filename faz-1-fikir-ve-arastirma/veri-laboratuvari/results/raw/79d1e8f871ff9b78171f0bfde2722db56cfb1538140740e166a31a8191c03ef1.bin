$(document).ready(function(){
  $('#themePicker').on('input',function(e){
    var themePickerVal = $('#themePicker').val().toUpperCase();
    $('div.themes-c').find('div.th-wrapper').each(function(el){
      var lbl = $(this).text().toUpperCase();
      if (lbl.indexOf(themePickerVal) >= 0)
      {
        $(this).fadeIn(500); 
      }
      else
      {
        $(this).fadeOut(500); 
      }
    });
  });
 });
