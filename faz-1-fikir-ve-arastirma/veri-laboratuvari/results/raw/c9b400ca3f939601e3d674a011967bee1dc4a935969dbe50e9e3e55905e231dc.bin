        <script>
            window.__abtest_fy25_bucket = 'exp2';
            var sceneName = 'fy25-pc-home-all';
            var urlstr=location.href.toLowerCase();
            if(urlstr.indexOf("offer.alibaba.com")>-1||urlstr.indexOf("www.alibaba.com/showroom/")>-1||urlstr.indexOf("bm=cps")>-1||urlstr.indexOf("src=sem_")>-1||urlstr.indexOf("src=saf")>-1||urlstr.indexOf("from=cpm_fb")>-1||urlstr.indexOf("from=ugclickserver")>-1){window.__iscps = true;}
            if(window.__iscps){sceneName="pc-home-cps"}
            if(urlstr.indexOf("isspider=true")>-1){window.__sceneName="pc-home-abnormal"}
            // 网络性能指标异常用户单独分scene
            if (window.performance && window.performance.timing) {
                const performanceTiming = window.performance.timing;
                const redirectTime = performanceTiming.fetchStart - performanceTiming.navigationStart;
                const tcpTime = performanceTiming.connectEnd - performanceTiming.connectStart;
                const dnsTime = performanceTiming.responseStart - performanceTiming.requestStart;
                const sslTime = performanceTiming.secureConnectionStart > 0 ? performanceTiming.connectEnd - performanceTiming.secureConnectionStart : 0;
                if (dnsTime + tcpTime + sslTime >= 800) {
                    sceneName = "pc-home-abnormal";
                }
            }
            window.__BB = {
                disableStore: true,
                autoReportAPI: true,
                autoReportPerf: true,
                mode: -1, // 打点模式 (0: 自动打点，1: 不打点，-1: 轮询模式)
                token: 'ffabdd1adb434d2f927587826e8ffadd',
                scene: sceneName,
                group: 'pc-home-product-stream',
                BB_CWV_IGNORE: {
                  // 对 LCP Element 进行过滤（
                  lcp_element: ['div>img.mcfopu-h-full.mcfopu-w-full', 'img.mcfopu-absolute.mcfopu-h-200.mcfopu-light-ring.mcfopu-w-200.mcfopu-z-0', 'div.mcfopu-font-bold.mcfopu-leading-[29px].mcfopu-text-center', '#root>div.paylater-popup-container>div.paylater-popup'],
                  // 对 LCP 元素的 url 进行过滤
                  lcp_url: ['https://s.alicdn.com/@sc02/kf/Sc84d0c238b6f478a9302dd00430b3ba6b/1360x936.png'],
                }
            };

            // 用户与搜索框有过交互（聚焦/点击，含图搜、搜索按钮，覆盖首页搜索和头部搜索两个入口）时切到单独 group 上报（处理一次后卸载）
            (function () {
                function handler(event) {
                    var target = event.target;
                    if (target && target.closest && target.closest('.home-search, .header-tab-search-multi')) {
                        if (window.__BB) {
                            window.__BB.scene = 'pc-home-search-user';
                        }
                        document.removeEventListener('focusin', handler);
                        document.removeEventListener('pointerdown', handler);
                    }
                }
                document.addEventListener('focusin', handler);
                document.addEventListener('pointerdown', handler);
            })();

            // 用户访问过头部 Sign in 入口（悬停/点击/聚焦）时切到单独 scene 上报（处理一次后卸载）
            (function () {
                function handler(event) {
                    var target = event.target;
                    if (target && target.closest && target.closest('.tnh-ma')) {
                        if (window.__BB) {
                            window.__BB.scene = 'pc-home-sign-in';
                        }
                        document.removeEventListener('pointerover', handler);
                        document.removeEventListener('pointerdown', handler);
                        document.removeEventListener('focusin', handler);
                    }
                }
                document.addEventListener('pointerover', handler);
                document.addEventListener('pointerdown', handler);
                document.addEventListener('focusin', handler);
            })();

            // 用户点击过营销弹框时切到单独 scene 上报（弹框运行时注入，事件委托，处理一次后卸载）
            (function () {
                function handler(event) {
                    var target = event.target;
                    if (target && target.closest && target.closest('#icbu-marketing-pc-first-order-popup')) {
                        if (window.__BB) {
                            window.__BB.scene = 'pc-home-popup';
                        }
                        document.removeEventListener('pointerdown', handler);
                    }
                }
                document.addEventListener('pointerdown', handler);
            })();

            // 用户悬停或点击过 Ship to 入口时切到单独 group 上报（处理一次后卸载）
            (function () {
                function handler(event) {
                    var target = event.target;
                    if (target && target.closest && target.closest('.tnh-ship-to')) {
                        if (window.__BB) {
                            window.__BB.group = 'pc-home-ship-to';
                        }
                        document.removeEventListener('pointerover', handler);
                        document.removeEventListener('pointerdown', handler);
                    }
                }
                document.addEventListener('pointerover', handler);
                document.addEventListener('pointerdown', handler);
            })();
        </script>
