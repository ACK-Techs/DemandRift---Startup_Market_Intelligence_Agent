    <script type="text/javascript" id="fy25-home-js" src="//s.alicdn.com/@g/sc/pc-home-2022/0.0.387/js/fy25producthome.js" defer></script>
    <script type="text/javascript">
        (function () {
            var footerCss = '//s.alicdn.com/@g/sc/pc-home-2022/0.0.387/css/fy25producthomefooter.css';
            var footerJs = '//s.alicdn.com/@g/sc/pc-home-2022/0.0.387/js/fy25producthomefooter.js';

            function runWhenIdle(callback) {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(callback, { timeout: 1000 });
                    return;
                }
                setTimeout(callback, 1000);
            }

            function loadFooter() {
                loadStyleSheet(footerCss, function () {});

                var script = document.createElement('script');
                script.type = 'text/javascript';
                script.src = footerJs;
                script.async = true;
                document.body.appendChild(script);
            }

            // 等 fy25producthome.js 执行完成后，再在空闲时加载 footer
            // defer 脚本在此内联脚本之后才执行，因此此处监听 load 一定能捕获
            var homeScript = document.getElementById('fy25-home-js');
            if (homeScript) {
                homeScript.addEventListener('load', function () { runWhenIdle(loadFooter); });
                homeScript.addEventListener('error', function () { runWhenIdle(loadFooter); });             } else {
                runWhenIdle(loadFooter);
            }
        })();
    </script>


