    padding-top: 2px;
    box-sizing: content-box
}
.new-header-search-tab .search-tab-item:last-child {
    margin-right: 0
}
.new-header-search-tab .search-tab-item.active {
    color: #fff;
    font-weight: 700
}
.new-header-search-tab .search-tab-item.active.ai-background {
    color: #222
}
.new-header-search-tab .search-tab-item.active .tab-text:after {
    background-color: #fff;
    border-radius: 3px;
    bottom: -4px;
    content: "";
    height: 4px;
    left: 50%;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
    position: absolute;
    width: 60px
}
.new-header-search-tab .search-tab-item.active.ai-background .tab-text:after {
    background-color: #222
}
.new-header-search-tab.with-ai-mode .search-tab-item.active.ai-background {
    color: #fa6400
}
.new-header-search-tab.with-ai-mode .search-tab-item.active.ai-background .tab-text:after {
    background-color: #fa6400
}
.new-header-search-tab .search-tab-item:active {
    text-decoration: none
}
.new-header-search-tab .ai-mode-hover-tooltip {
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    margin-top: 12px;
    z-index: 100;
    visibility: hidden;
    opacity: 0
}
.new-header-search-tab .ai-mode-entry-wrapper:hover .ai-mode-hover-tooltip {
    visibility: visible;
    opacity: 1
