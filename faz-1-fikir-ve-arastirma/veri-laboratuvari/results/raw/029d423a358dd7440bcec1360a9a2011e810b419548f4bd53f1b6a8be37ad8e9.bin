<script>
function mktAnnoBarInit(){const mktAnnoBarDelicateClose=function (ev){ev.preventDefault();ev.stopPropagation();const bar=document.querySelector('div[class*="bar__BarContainer"]');ev.target.removeEventListener("click", mktAnnoBarDelicateClose);if (bar){mktAnnoBarHide(bar, ()=>{document.querySelector('[class*="close-button"]').click();});}return;};const mktAnnoBarHide=(el, callback)=>{const speed=Math.ceil(el.scrollHeight / 30);let height=el.clientHeight - speed;el.style.maxHeight=`${height < 0 ? 0 : height}px`;if (el.clientHeight >0){requestAnimationFrame(()=>{mktAnnoBarHide(el, callback);});} else{if (callback){callback();}}};const mktAnnoBarShow=(el)=>{const speed=Math.ceil(el.scrollHeight / 30);let height=el.clientHeight + speed;el.style.maxHeight=`${height}px`;if (el.clientHeight < el.scrollHeight){requestAnimationFrame(()=>{mktAnnoBarShow(el);});} else{el.style.maxHeight="max-content";}};const initInterval=setInterval(()=>{const closeButton=document.querySelector('[class*="close-button"]:not(.custom-init)');if (closeButton){clearInterval(initInterval);closeButton.classList.add("custom-init");closeButton.addEventListener("click", mktAnnoBarDelicateClose);const bar=document.querySelector('div[class*="bar__BarContainer"]');mktAnnoBarShow(bar);}}, 250)}
</script>

