<script type="text/javascript" src="https://cdn.weglot.com/weglot.min.js" async="async" onload="initWeglot()"></script>
<script>
    function initWeglot() {
        Weglot.on("initialized", initLangLinks);
        Weglot.initialize({
            api_key: 'wg_c5fa071ee8390df0357c7fb0f4d4b9181',
            cache: true,
            hide_switcher: true
        });
    }

    function initLangLinks() {
        const dropdownLangDiv = document.getElementById('lang-toggle-dropdown');
        const enabledLanguages = Weglot.options.languages.filter(function(lang) {
            return lang.enabled;
        });

        if (!enabledLanguages.length) {
            dropdownLangDiv.parentElement.style.display = 'none';
            return;
        }

        function addLangLink(to, host, isLink = true) {
            const li = document.createElement('li');
            const name = Weglot.getLanguageName(to);
            const href = "https://" + host + window.location.pathname;
            if (isLink) {
                li.innerHTML = '<a href="' + href + '">' + name + '</a>';
            } else {
                li.innerHTML = '<a href="javascript:void(0);" onclick="window.location.href = \'' + href + '\';">' + name + '</a>';
            }
            dropdownLangDiv.appendChild(li);
        }

        addLangLink('en', 'whoisxmlapi.com', false);
        enabledLanguages.forEach(function(lang) {
            addLangLink(lang.language_to, lang.connect_host_destination.host);
        });
    }
</script>
 
