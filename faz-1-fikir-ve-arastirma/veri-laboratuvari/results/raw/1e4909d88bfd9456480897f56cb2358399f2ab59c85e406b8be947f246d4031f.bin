<script src="https://main.whoisxmlapi.com/products-vue-assets/public/js/geoipify/manifest.js?id=395a4154819b0e37a0d2" defer></script>
    <script src="https://main.whoisxmlapi.com/products-vue-assets/public/js/geoipify/vendor.js?id=0a22906bd272778ea92e" defer></script>
    <script src="https://main.whoisxmlapi.com/products-vue-assets/public/js/geoipify/app.js?id=7d76debe318917f48588" defer></script>
<script type="text/javascript" defer>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll(".email-department").forEach(function (el) {
            if(el.value) {
                emailDepartmentChange(el);
            }

            el.onchange = function(e) {
                emailDepartmentChange(e.target);
            }
        });
    }, false);

    function generateDepartmentRelatedContactUsFormClassName(departmentName) {
        return `${departmentName}RFQ`;
    }

    function emailDepartmentChange(element) {
        const department = $(element).val().toLowerCase();
        const departmentClassName = generateDepartmentRelatedContactUsFormClassName(department);

        const closestForm = $(element).closest('form');
        const srcClassNameAttrName = 'data-src-class-name';
        if(!$(closestForm).attr(srcClassNameAttrName)) {
            $(closestForm).attr(srcClassNameAttrName, $(closestForm).attr('class'));
        }

        const srcClassName = $(closestForm).attr(srcClassNameAttrName);
        $(closestForm).attr('class', srcClassName).addClass(departmentClassName);
    }
</script>
</body>
</html>
