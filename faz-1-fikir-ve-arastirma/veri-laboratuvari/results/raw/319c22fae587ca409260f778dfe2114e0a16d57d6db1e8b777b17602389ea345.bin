arge/00191-ev-temizligi_thumb_875x500.jpg"><img fetchpriority="high" width="1400" height="600" alt="Ev Temizliği" src="https://cdn.armut.com/images/services/00191-ev-temizligi_thumb_875x500.jpg"></picture><div id="hero__description" class="hero__description"><h1 data-testid="seo-key-element" class="hero__description__title">Temizlikçi Arıyorsan Şimdi Rezervasyon Yap.</h1><p data-testid="seo-key-element" class="hero__description__detail"><b>10.116 Temizlikçi</b> hizmet vermeye hazır.</p><button data-testid="seo-key-element" type="button" class="callAngularApps button__cta button__cta--hero js-sentinel-button" data-buttonname="SEOS_stickyWeb_COB" data-url="/teklif/service/191/1">REZERVASYON YAP</button></div></div></app-hero><app-breadcrumb data-testid="seo-breadcrumb" _nghost-ng-c2990763111 ngh="1"><ul _ngcontent-ng-c2990763111 itemscope itemtype="http://schema.org/BreadcrumbList" class="breadcrumb"><li _ngcontent-ng-c2990763111 itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem"><a _ngcontent-ng-c2990763111 itemprop="item" title="Armut" href="https://armut.com"><span _ngcontent-ng-c2990763111 itemprop="name" class="js-sentinel-button" data-buttonname="SEOS_breadcrumb_homepage">Armut</span></a><meta _ngcontent-ng-c2990763111 itemprop="position" content="1"></li><li _ngcontent-ng-c2990763111 itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem"><a _ngcontent-ng-c2990763111 itemprop="item" style="pointer-events:none;cursor:default"><span _ngcontent-ng-c2990763111 itemprop="name">Ev Temizliği</span></a><meta _ngcontent-ng-c2990763111 itemprop="position" content="2"></li></ul></app-breadcrumb><app-cleaning-service _nghost-ng-c3667478727 ngh="0"><about-us _ngcontent-ng-c3667478727 _nghost-ng-c4226285044 ngh="0"><section _ngcontent-ng-c4226285044 class="about-us"><h1 _ngcontent-ng-c4226285044 class="about-us__title">Ev Temizliğinde İlk ve En Güvenilir Markayız</h1><p _ngcontent-ng-c4226285044 class="about-us__content">Tek yapman gereken web sitemizden veya uygulamamız üzerinden evinin büyüklüğünü bildirmek. Armut en iyi temizlikçileri getirir ve seni tüm streslerinden kurtarır.</p><picture _ngcontent-ng-c4226285044 class="about-us__image"><source _ngcontent-ng-c4226285044 media="(max-width: 600px)" srcset="https://cdn.armut.com/images/seo/191/about-us/bg-375.svg"><source _ngcontent-ng-c4226285044 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/about-us/bg-768.svg"><source _ngcontent-ng-c4226285044 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/about-us/bg-1024.svg"><source _ngcontent-ng-c4226285044 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/about-us/bg-1440.svg"><source _ngcontent-ng-c4226285044 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/about-us/bg-1920.svg"><img _ngcontent-ng-c4226285044 alt="about-us-background" src="https://cdn.armut.com/images/seo/191/about-us/bg-768.svg"></picture></section></about-us><cleaning-value-proposition _ngcontent-ng-c3667478727 _nghost-ng-c3988703658 ngh="0"><section _ngcontent-ng-c3988703658 class="cleaning-value-proposition__section"><card-list _ngcontent-ng-c3988703658 _nghost-ng-c426290801 ngh="3"><card _ngcontent-ng-c426290801 _nghost-ng-c2787029964 style="order:var(--card-order-experienced,initial)" ngh="2"><img _ngcontent-ng-c2787029964 class="card__image" alt="experienced" src="https://cdn.armut.com/images/seo/191/value-propositions/experienced.svg" style="width:var(--card-image-width-experienced);height:var(--card-image-height-experienced);position:var(--card-image-position-experienced);top:var(--card-image-position-top-experienced);left:var(--card-image-position-left-experienced)"><span _ngcontent-ng-c2787029964 class="card__title">Tecrübeli</span><p _ngcontent-ng-c2787029964 class="card__content">Armut, 2011'den beri ev temizliği ve yüzlerce diğer hizmette 10 milyondan fazla müşteriyi hizmet verenlerle buluşturuyor. Armut'u kullanan ev temizliği gündelikçileri, İstanbul, Ankara, İzmir, Bursa, Antalya, Adana, Eskişehir ve tüm Türkiye'de yüzbinlerce evin temizlenmesine yardımcı oluyor. Profesyonel ev temizliğine ihtiyaç duyduğun an aklına Armut gelsin.</p></card><card _ngcontent-ng-c426290801 _nghost-ng-c2787029964 style="order:var(--card-order-easy,initial)" ngh="2"><img _ngcontent-ng-c2787029964 class="card__image" alt="easy" src="https://cdn.armut.com/images/seo/191/value-propositions/easy.svg" style="width:var(--card-image-width-easy);height:var(--card-image-height-easy);position:var(--card-image-position-easy);top:var(--card-image-position-top-easy);left:var(--card-image-position-left-easy)"><span _ngcontent-ng-c2787029964 class="card__title">Kolay</span><p _ngcontent-ng-c2787029964 class="card__content">Yoğun iş hayatın evi temiz tutmayı zorlaştırıyor mu? Çocuklarla ilgilenmekten yerleri süpürmeye zaman kalmıyor mu? Günlük koşuşturma içinde bir de evi temizlemek gerçekten çok zor. Yardıma ihtiyacın olduğu an, Armut yanında.</p></card><card _ngcontent-ng-c426290801 _nghost-ng-c2787029964 style="order:var(--card-order-secure,initial)" ngh="2"><img _ngcontent-ng-c2787029964 class="card__image" alt="secure" src="https://cdn.armut.com/images/seo/191/value-propositions/secure.svg" style="width:var(--card-image-width-secure);height:var(--card-image-height-secure);position:var(--card-image-position-secure);top:var(--card-image-position-top-secure);left:var(--card-image-position-left-secure)"><span _ngcontent-ng-c2787029964 class="card__title">Güvenilir</span><p _ngcontent-ng-c2787029964 class="card__content">Armut aracılığıyla bir temizlik planlarsan, temizlikçin seçildiği andan yola çıktığı ana kadar her adımda haberin olur ve rahat edersin. Temizlikçimiz geldiği zaman yatak odalarını, banyolarını, mutfağını yani evini tertemiz hale getirir!</p></card><card _ngcontent-ng-c426290801 _nghost-ng-c2787029964 style="order:var(--card-order-flexible,initial)" ngh="2"><img _ngcontent-ng-c2787029964 class="card__image" alt="flexible" src="https://cdn.armut.com/images/seo/191/value-propositions/flexible.svg" style="width:var(--card-image-width-flexible);height:var(--card-image-height-flexible);position:var(--card-image-position-flexible);top:var(--card-image-position-top-flexible);left:var(--card-image-position-left-flexible)"><span _ngcontent-ng-c2787029964 class="card__title">Esnek</span><p _ngcontent-ng-c2787029964 class="card__content">Armut sadece haftalık düzenli temizlik arayanlar için değil. İstediğin zaman durdurabilir, istediğin zaman devam edebilirsin. Hizmet kapsamını da değiştirebilirsin. Özellikle dikkat edilmesini istediğin bir şey varsa belirtebilirsin. Ütü yaptırmak mı istiyorsun? Duvarların, fırın içinin veya buzdolabının da silinmesini mi istiyorsun? Ekstra isteklerini temizlikçine söyleyebilirsin.</p></card></card-list></section></cleaning-value-proposition><why-cleaning _ngcontent-ng-c3667478727 _nghost-ng-c3899017888 ngh="0"><section _ngcontent-ng-c3899017888 class="why-cleaning__section"><div _ngcontent-ng-c3899017888 class="why-cleaning__container"><picture _ngcontent-ng-c3899017888 class="why-cleaning__image"><source _ngcontent-ng-c3899017888 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/image-375.png"><source _ngcontent-ng-c3899017888 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/image-768.png"><source _ngcontent-ng-c3899017888 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/image-1024.png"><source _ngcontent-ng-c3899017888 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/image-1440.png"><source _ngcontent-ng-c3899017888 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/image-1920.png"><img _ngcontent-ng-c3899017888 alt="why-cleaning-image" src="https://cdn.armut.com/images/seo/191/why-cleaning/image-768.png"></picture><h1 _ngcontent-ng-c3899017888 class="why-cleaning__title">Armut Ev Temizliği Neden Tercih Ediliyor?</h1><p _ngcontent-ng-c3899017888 class="why-cleaning__content">Ev temizliği için bir temizlikçi arıyorsan, Armut en uygun seçenek. Çünkü fiyatlarımız uygun ve temizlikçilerimiz detaylara özen gösteren titiz ve profesyonel temizlikçiler. Tüm Türkiye'de on binden fazla profesyonel temizlikçimiz işe başlamaya hazır. Gerçek temizlik işleriyle test edilmiş temizlikçiler.</p></div><picture _ngcontent-ng-c3899017888 class="why-cleaning__bg"><source _ngcontent-ng-c3899017888 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/bg-375.svg"><source _ngcontent-ng-c3899017888 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/bg-768.svg"><source _ngcontent-ng-c3899017888 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/bg-1024.svg"><source _ngcontent-ng-c3899017888 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/bg-1440.svg"><source _ngcontent-ng-c3899017888 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/why-cleaning/bg-1920.svg"><img _ngcontent-ng-c3899017888 alt="why-cleaning-background" src="https://cdn.armut.com/images/seo/191/why-cleaning/bg-768.svg"></picture></section></why-cleaning><cleaning-services _ngcontent-ng-c3667478727 _nghost-ng-c2748726967 ngh="7"><section _ngcontent-ng-c2748726967 class="cleaning-services__section"><h1 _ngcontent-ng-c2748726967 class="cleaning-services__title">Ev Temizliğine Neler Dahil?</h1><p _ngcontent-ng-c2748726967 class="cleaning-services__subtitle">Günlük ev temizliği hizmetinde profesyonellerimiz belirlenen süre içinde bu hizmetleri gerçekleştiriyorlar:</p><div _ngcontent-ng-c2748726967 class="cleaning-services__container"><card _ngcontent-ng-c2748726967 _nghost-ng-c2787029964 style="order:var(--card-order-bedroom-living-room,initial)" ngh="5"><seo-image _ngcontent-ng-c2787029964 _nghost-ng-c59905255 ngh="4"><picture _ngcontent-ng-c59905255 class="image"><source _ngcontent-ng-c59905255 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-768.png"><source _ngcontent-ng-c59905255 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-1024.png"><img _ngcontent-ng-c59905255 alt="bedroom-living-room" src="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-1024.png"><source _ngcontent-ng-c59905255 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-1440.png"><source _ngcontent-ng-c59905255 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-1920.png"><source _ngcontent-ng-c59905255 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bedroom-living-room-1920.png"></picture></seo-image><span _ngcontent-ng-c2787029964 class="card__title">Yatak Odası, Oturma Odası/Salon</span><div _ngcontent-ng-c2787029964 class="card__content"><ul _ngcontent-ng-c2787029964 class="card__content--list"><li _ngcontent-ng-c2787029964 class="card__content--list-item">Yatakların yapılması ve açıktaki çamaşırların katlanması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Yerlerin süpürülüp silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Görünür yüzeyler, süpürgelikler ve peteklerin tozunun alınması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Mobilyaların tozlarının alınması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Cam silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Çöplerin boşaltılması</li></ul></div></card><card _ngcontent-ng-c2748726967 _nghost-ng-c2787029964 style="order:var(--card-order-kitchen,initial)" ngh="5"><seo-image _ngcontent-ng-c2787029964 _nghost-ng-c59905255 ngh="4"><picture _ngcontent-ng-c59905255 class="image"><source _ngcontent-ng-c59905255 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-768.png"><source _ngcontent-ng-c59905255 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-1024.png"><img _ngcontent-ng-c59905255 alt="kitchen" src="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-1024.png"><source _ngcontent-ng-c59905255 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-1440.png"><source _ngcontent-ng-c59905255 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-1920.png"><source _ngcontent-ng-c59905255 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/kitchen-1920.png"></picture></seo-image><span _ngcontent-ng-c2787029964 class="card__title">Mutfak</span><div _ngcontent-ng-c2787029964 class="card__content"><ul _ngcontent-ng-c2787029964 class="card__content--list"><li _ngcontent-ng-c2787029964 class="card__content--list-item">Tezgah, fayans, lavabo ve musluk temizliği</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Bulaşıkların yıkanması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Mikrodalga ve mini fırın dış ve iç temizliği</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Cam silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Dolap kapaklarının silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Yerlerin süpürülüp silinmesi ve çöplerin boşaltılması</li></ul></div></card><card _ngcontent-ng-c2748726967 _nghost-ng-c2787029964 style="order:var(--card-order-bathroom,initial)" ngh="5"><seo-image _ngcontent-ng-c2787029964 _nghost-ng-c59905255 ngh="4"><picture _ngcontent-ng-c59905255 class="image"><source _ngcontent-ng-c59905255 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-768.png"><source _ngcontent-ng-c59905255 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-1024.png"><img _ngcontent-ng-c59905255 alt="bathroom" src="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-1024.png"><source _ngcontent-ng-c59905255 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-1440.png"><source _ngcontent-ng-c59905255 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-1920.png"><source _ngcontent-ng-c59905255 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/bathroom-1920.png"></picture></seo-image><span _ngcontent-ng-c2787029964 class="card__title">Banyo</span><div _ngcontent-ng-c2787029964 class="card__content"><ul _ngcontent-ng-c2787029964 class="card__content--list"><li _ngcontent-ng-c2787029964 class="card__content--list-item">Tezgah, ayna, lavabo, musluk, duşakabin, küvet ve tuvalet temizliği</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Banyo tabanının süpürülüp silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Süpürgelik ve peteklerin tozunun alınması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Dolap kapaklarının silinmesi</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Temiz havluların düzgünce asılması ve/veya katlanması</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Çöplerin boşaltılması</li></ul></div></card><card _ngcontent-ng-c2748726967 _nghost-ng-c2787029964 style="order:var(--card-order-other-services,initial)" ngh="6"><seo-image _ngcontent-ng-c2787029964 _nghost-ng-c59905255 ngh="4"><picture _ngcontent-ng-c59905255 class="image"><source _ngcontent-ng-c59905255 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/other-768.png"><source _ngcontent-ng-c59905255 media="(max-width: 1024px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/other-1024.png"><img _ngcontent-ng-c59905255 alt="other-services" src="https://cdn.armut.com/images/seo/191/cleaning-services/other-1024.png"><source _ngcontent-ng-c59905255 media="(max-width: 1440px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/other-1440.png"><source _ngcontent-ng-c59905255 media="(max-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/other-1920.png"><source _ngcontent-ng-c59905255 media="(min-width: 1920px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-services/other-1920.png"></picture></seo-image><span _ngcontent-ng-c2787029964 class="card__title">Diğer</span><div _ngcontent-ng-c2787029964 class="card__content"><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Özel istek üzerine gündelikçilerimiz bu hizmetleri de verebilirler.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Evin için tavsiye ettiğimiz süreyi 1 veya 2 saat uzatman yeterli.</p><ul _ngcontent-ng-c2787029964 class="card__content--list"><li _ngcontent-ng-c2787029964 class="card__content--list-item">Ütü</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Buzdolabı içi temizliği</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Fırın içi temizliği</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Duvar silme</li><li _ngcontent-ng-c2787029964 class="card__content--list-item">Yemek yapma</li></ul></div></card></div></section></cleaning-services><cleaning-facts _ngcontent-ng-c3667478727 _nghost-ng-c2503275976 ngh="8"><section _ngcontent-ng-c2503275976 class="cleaning-facts__section"><h1 _ngcontent-ng-c2503275976 class="cleaning-facts__title">Nasıl En İyi Ev Temizliği Tecrübesini Yarattık?</h1><div _ngcontent-ng-c2503275976 class="cleaning-facts__container"><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Anında rezervasyon ile her gün her saat</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Anında online temizlik rezervasyonunu, yarından itibaren istediğin gün ve saate planla. Ev temizliğini haftada 7 gün saat 8'den akşam 8'e kadar istediğin saate alabilirsin.</p></div></fact><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Güleryüzlü temizlikçiler</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Armut platformundaki tüm profesyoneller güvenlik taramasından geçirilir, sabıka kayıtları kontrol edilir ve kimlik kopyaları alınır. En üst düzey kaliteyi ve motivasyonu sağlamak için müşteriler tarafından haftada birkaç kez değerlendirilirler.</p></div></fact><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Tam istediğin gibi temizlik</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Profesyoneller isteğine göre düzenleyebileceğin kapsamlı bir temizlik listesi ile çalışır. Her zaman aynı temizlikçi ile çalışabilirsin. Her müşteriyi en doğru profesyonel ile eşleştirmek için maksimum gayreti sarfediyoruz.</p></div></fact><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Esnek planlama</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Hayatına uyan bir temizlik takvimi seç. Temizlik sıklığını gerektiği gibi yeniden ayarlayabilirsin. Kolay ve güvenli online ödeme ile nakit için bankaya gitmekten kurtul.</p></div></fact><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Temizliği cep telefonundan takip et</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Temizlik sırasında evde duramıyor musun? Sorun değil. Armut uygulaması, temizlikçinin ne zaman geldiğini ve gittiğinden haberdar olmanı sağlar.</p></div></fact><fact _ngcontent-ng-c2503275976 _nghost-ng-c391164506 ngh="0"><div _ngcontent-ng-c391164506 class="fact__container"><div _ngcontent-ng-c391164506 class="fact__title-container"><icon-check _ngcontent-ng-c391164506 _nghost-ng-c1491440013 ngh="0"><svg _ngcontent-ng-c1491440013="" xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none"><path _ngcontent-ng-c1491440013="" fill-rule="evenodd" clip-rule="evenodd" d="M19.3337 2.73401C19.3337 3.04826 19.2213 3.31538 18.9965 3.53535L10.2773 12.0673L8.63946 13.67C8.41466 13.89 8.14169 14 7.82054 14C7.49939 14 7.22642 13.89 7.00162 13.67L5.36377 12.0673L1.0042 7.80135C0.779394 7.58137 0.666992 7.31425 0.666992 7C0.666992 6.68575 0.779394 6.41863 1.0042 6.19865L2.64205 4.59596C2.86685 4.37598 3.13982 4.26599 3.46097 4.26599C3.78212 4.26599 4.05509 4.37598 4.27989 4.59596L7.82054 8.07239L15.7208 0.329966C15.9456 0.109989 16.2185 0 16.5397 0C16.8608 0 17.1338 0.109989 17.3586 0.329966L18.9965 1.93266C19.2213 2.15264 19.3337 2.41975 19.3337 2.73401Z" fill="#2cb34f"/></svg></icon-check><h2 _ngcontent-ng-c391164506 class="fact__title">Tam Memnuniyet Garantisi</h2></div><p _ngcontent-ng-c391164506 class="fact__content">Eğer temizlikçiyi beğenmezsen veya temizlik tam istediğin gibi olmazsa, farklı bir temizlikçiyi ücretsiz olarak gönderiyoruz.</p></div></fact></div></section></cleaning-facts><cleaning-faq _ngcontent-ng-c3667478727 _nghost-ng-c1574377810 ngh="10"><section _ngcontent-ng-c1574377810 class="cleaning-faq__section"><h1 _ngcontent-ng-c1574377810 class="cleaning-faq__title">Ev Temizliği Hakkında En Çok Merak Edilenler</h1><div _ngcontent-ng-c1574377810 class="cleaning-faq__container"><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Evime hangi temizlikçi gelecek?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Armut, en deneyimli, en seçkin ve en yüksek yorumları alan 10.000'den fazla temizlikçiden oluşan Türkiye'nin en geniş temizlikçi ağına sahip. Ev adresin ve isteğinin gün / saatine bağlı olarak ağımızdaki en iyi profesyoneli senin rezervasyonuna atayacağız. Eğer bu temizlikçiden memnun kalırsan, kendisi ile çalışmaya devam edebilirsin. Memnun kalmazsan, değiştirebilirsin. Memnun kalacağın temizlikçi mutlaka Armut'ta.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Rezervasyon atlayabilir veya gün / saat değiştirebilir miyim?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Temizlik başlangıç saatinden en az 24 saat önce yaptığın sürece, herhangi bir rezervasyonu yeniden planlayabilirsin.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Ev temizlik fiyatları ne kadar?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Bu, evinin büyüklüğüne bağlı. Rezervasyon yaparken kaç yatak odası ve banyoya sahip olduğunu girdiğin anda buna göre önerdiğimiz temizlik süresini ve fiyatını görebilirsin. Fiyatlarımız piyasaya göre uygun fiyatlıdır, karşılaştırmanı tavsiye ederiz.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Ev temizliğini kendim yapsam? Temizlik hizmeti almaya değer mi?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Parmağını kaldırmadan tertemiz bir eve gelmeyi seviyor musun? Eğer seviyorsan, o zaman, evet, temizlik hizmeti almaya değer. Çalışma saatlerin uzunsa, çocuklar çok zamanını alıyorsa, bir de ev işleriyle uğraşmak çok zor değil mi? Hiç olmazsa ev işlerinin en zor kısmında sana yardımcı olacak birisi hayatını çok kolaylaştırabilir. En kaliteli ve uygun fiyatlı temizlik çözümünü geliştirdik. İzin ver, Armut seni en iyi ev temizlikçileri ile buluştursun. Alacağın hizmet hem uygun fiyatlı, hem de değerli: sana zamanını geri veriyoruz. Günün sonunda çocuklara ve dinlenmeye ayıracağın birkaç saat kadar değerli bir şey yok.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Çamaşır ve ütü dahil mi?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Eğer istersen, temizlikçimiz çamaşırlarını yıkayabilir, ütüleyebilir ve katlayabilir. Bu işlemler için bir saat ekleyip, isteklerini temizlikçine söylemen yeterli.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Ev temizliği ne kadar sürer?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Bu tamamen evin büyüklüğüne bağlı. Minimum rezervasyon süresi 3 saat. Yatak odası ve banyo sayısına bağlı olarak, 3 ila 9 saat arası bir süre tavsiye ediyoruz. Bu süreyi ihtiyacına göre ayarlayabilirsin.</p></accordion><accordion _ngcontent-ng-c1574377810 class="accordion" _nghost-ng-c96318605 ngh="0"><div _ngcontent-ng-c96318605 class="accordion__title-container"><span _ngcontent-ng-c96318605 class="accordion__title">Armut Ev Temizliği Nerede?</span><icon-plus _ngcontent-ng-c96318605 _nghost-ng-c2152214758 ngh="0"><svg _ngcontent-ng-c2152214758="" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none"><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 0.0751953C8.0868 0.0751953 8.5625 0.550893 8.5625 1.1377V13.8877C8.5625 14.4745 8.0868 14.9502 7.5 14.9502C6.9132 14.9502 6.4375 14.4745 6.4375 13.8877V1.1377C6.4375 0.550893 6.9132 0.0751953 7.5 0.0751953Z" fill="#111321"/><path _ngcontent-ng-c2152214758="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0625 7.5127C0.0625 6.92589 0.538197 6.4502 1.125 6.4502H13.875C14.4618 6.4502 14.9375 6.92589 14.9375 7.5127C14.9375 8.0995 14.4618 8.5752 13.875 8.5752H1.125C0.538197 8.5752 0.0625 8.0995 0.0625 7.5127Z" fill="#111321"/></svg></icon-plus><icon-minus _ngcontent-ng-c96318605 _nghost-ng-c1170768979 ngh="0"><svg _ngcontent-ng-c1170768979="" xmlns="http://www.w3.org/2000/svg" width="15" height="3" viewBox="0 0 15 3" fill="none"><path _ngcontent-ng-c1170768979="" fill-rule="evenodd" clip-rule="evenodd" d="M0.0507812 1.31836C0.0507812 0.766075 0.498497 0.318359 1.05078 0.318359H13.0508C13.6031 0.318359 14.0508 0.766075 14.0508 1.31836C14.0508 1.87064 13.6031 2.31836 13.0508 2.31836H1.05078C0.498497 2.31836 0.0507812 1.87064 0.0507812 1.31836Z" fill="#2cb34f"/></svg></icon-minus></div><p _ngcontent-ng-c96318605 class="accordion__content">Tüm Türkiye'de Armut markasıyla, yurtdışında da HomeRun markasıyla yüzlerce şehirde hizmet veriyoruz.</p></accordion></div><seo-image _ngcontent-ng-c1574377810 alt="cleaning-faq__bg" class="cleaning-faq__bg" _nghost-ng-c59905255 ngh="9"><picture _ngcontent-ng-c59905255 class="image"><source _ngcontent-ng-c59905255 media="(max-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-faq/bg-768.svg"><img _ngcontent-ng-c59905255 alt="cleaning-faq__bg" src="https://cdn.armut.com/images/seo/191/cleaning-faq/bg-768.svg"><source _ngcontent-ng-c59905255 media="(min-width: 768px)" srcset="https://cdn.armut.com/images/seo/191/cleaning-faq/bg-768.svg"></picture></seo-image></section></cleaning-faq><cleaning-details _ngcontent-ng-c3667478727 _nghost-ng-c490383519 ngh="13"><section _ngcontent-ng-c490383519 class="cleaning-details__section"><div _ngcontent-ng-c490383519 class="cleaning-details__container"><card _ngcontent-ng-c490383519 _nghost-ng-c2787029964 style="order:var(--card-order-reasonably-priced,initial)" ngh="11"><span _ngcontent-ng-c2787029964 class="card__title">Ev Temizliği Uygun Fiyatlı Ufak Bir Lüksün Olsun</span><div _ngcontent-ng-c2787029964 class="card__content"><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Armut ev temizliği olmayan bir dünya hayal et. Ofiste 12 saatlik bir gün geçirdin. Trafik berbat. Eve akşamın karanlık bir saatinde girdiğinde, lavaboya yığılmış kirli bulaşıklar var, kirli kıyafetler her yere yayılmış, yatağın yapılmamış, duş küf gibi kokmaya başlamış ve zeminler tozla kaplı.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Dünyada yapmak istediğin en son şey, sarı lastik eldivenlerini çekip, zeminleri fırçalamak ve yerleri süpürmek. Armut ile, bunları yapmak zorunda değilsin. Hemen ertesi gün için temizlik rezervasyonunu yap. Bir sonraki gün işten geldiğinde bambaşka bir dünya seni bekleyecek.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Güzel, taze kokulu, temiz bir eve gitmek gibi güzel bir his var mı? Tuvaleti temizlemek ve yerleri silmek yerine kanepe üzerinde gevşeyebilir, bir battaniyenin altında kıvrılıp da sevdiğin televizyon dizisini seyretmeye başlayabilirsin. Armut ev temizliği, kendine verebileceğin en iyi hediyelerden biri. Bugün Armut ile ev temizliği rezervasyonunu yap.</p></div></card><card _ngcontent-ng-c490383519 _nghost-ng-c2787029964 style="order:var(--card-order-easy-payment,initial)" ngh="12"><span _ngcontent-ng-c2787029964 class="card__title">Şeffaf Fiyatlar ve Kolay Ödeme</span><div _ngcontent-ng-c2787029964 class="card__content"><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Fiyatın şeffaf, dürüst ve kolay anlaşılır olması önemli. Kimse indirimli fiyat sözü verilip, sonra ekstra ücretlerle veya fiyat artışlarıyla kandırılmak istemez. Armut ile, ödeyeceğin ücret açık, şeffaf ve basittir. Sadece rezervasyon yaparken gördüğün ekonomik fiyatı ödüyorsun. Ek ücret yok. Kötü sürpriz yok.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Hepimizin başına gelmiştir. Temizlikçi geldiği an fark edersin ki cüzdanında nakit kalmamış. İşin yoksa ayakkabılarını giy, ceketini bul ve en yakın ATM'ye para çekmek için evden çık. Armut tamamen nakitsiz çalışıyor. Kredi kartından otomatik ödeme yapılır ve ödemen hallolur, bu kadar basit.</p></div></card><card _ngcontent-ng-c490383519 _nghost-ng-c2787029964 style="order:var(--card-order-perfect-cleaning,initial)" ngh="11"><span _ngcontent-ng-c2787029964 class="card__title">Temizlikçinin Mükemmel Bir İş Çıkarmasını Sağla</span><div _ngcontent-ng-c2787029964 class="card__content"><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Armut aracılığıyla bir ev temizlik hizmeti rezervasyonu yaptığında, evine bir yabancı kabul etmenin zor olduğunun farkındayız.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Ancak emin olabilirsin ki, Armut platformu üzerinden ayırttığın temizlikçi hakkında kimliğinden iş yapış biçimine kadar tek başına toplamanın mümkün olmadığı çok detaylı bilgiler topluyoruz. Üstelik her temizlikte en yüksek kalite, performans ve motivasyon için eşsiz ve detaylı bir değerlendirme sistemi kullanıyoruz.</p><p _ngcontent-ng-c2787029964 class="card__content--paragraph">Rezervasyon yaparken, temizlik tercihlerini belirterek ve ek talimatlar vererek temizlikçiden beklentilerini daha da detaylı anlatabilirsin. Örneğin tercih ettiğin özel bir temizlik yöntemi varsa, temizlikçine bu isteğini iletebilirsin. Temizlikçine ev temizlik görevlerini hangi sırayla yapması gerektiğini dahi söyleyebilirsin. Böylece temizlikçin en endişelendiğin konulara daha fazla ilgi ve özen gösterecektir.</p></div></card></div></section></cleaning-details><best-pros _ngcontent-ng-c3667478727 _nghost-ng-c2018509216 ngh="16"><section _ngcontent-ng-c2018509216 class="best-pros"><div _ngcontent-ng-c2018509216 class="container"><div _ngcontent-ng-c2018509216 class="row"><div _ngcontent-ng-c2018509216 class="col-12"><h2 _ngcontent-ng-c2018509216 data-testid="seo-key-element" class="seo-section__header best-pros__title">En İyi 40 Temizlikçi</h2></div></div><div _ngcontent-ng-c2018509216 class="row"><div _ngcontent-ng-c2018509216 class="col-12 col-md-8"><ngx-json-ld _ngcontent-ng-c2018509216 ngh="0"><script type="application/ld+json">{
