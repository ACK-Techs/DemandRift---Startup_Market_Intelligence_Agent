l1Id":42,"areaLevel1Name":"Konya","serviceId":191,"serviceName":"Ev Temizliği","url":"konya-ev-temizligi"},{"areaLevel1Id":45,"areaLevel1Name":"Manisa","serviceId":191,"serviceName":"Ev Temizliği","url":"manisa-ev-temizligi"},{"areaLevel1Id":38,"areaLevel1Name":"Kayseri","serviceId":191,"serviceName":"Ev Temizliği","url":"kayseri-ev-temizligi"},{"areaLevel1Id":27,"areaLevel1Name":"Gaziantep","serviceId":191,"serviceName":"Ev Temizliği","url":"gaziantep-ev-temizligi"},{"areaLevel1Id":22,"areaLevel1Name":"Edirne","serviceId":191,"serviceName":"Ev Temizliği","url":"edirne-ev-temizligi"},{"areaLevel1Id":61,"areaLevel1Name":"Trabzon","serviceId":191,"serviceName":"Ev Temizliği","url":"trabzon-ev-temizligi"}],"serviceProfessionalSingular":"Temizlikçi","serviceProfessionalsPlural":"Ev Temizliği","shouldNotIndex":false,"urlList":["ev-temizligi","haftalik-ev-temizligi"],"whereQuestionLabel":"Nerede temizlik yapılacak (adres)?","help":null,"priceCalculatorHtml":null,"domain":"https://armut.com","areTheLinksInEnglish":true,"cobLanguageUrl":"tr","canonical":"https://armut.com/ev-temizligi","keys":{"footer":{"about":"BİLGİ","aboutMenu1Text":"Nasıl Çalışır?","aboutMenu1Url":"https://info.armut.com/nasil-calisir","aboutMenu2Text":"İletişim","aboutMenu2Url":"https://armuttr.zendesk.com/hc/tr","aboutMenu3Text":"Blog","aboutMenu3Url":"https://blog2.armut.com/?utm_source=footer&utm_medium=organic","aboutMenu4Text":"Hakkımızda","aboutMenu4Url":"https://info.armut.com","aboutMenu5Text":"Kariyer","aboutMenu5Url":"https://info.armut.com/kariyer","services":"HİZMETLER","servicesMenu1Text":"Ev Temizliği","servicesMenu1Url":"//armut.com/ev-temizligi","servicesMenu2Text":"Evden Eve Nakliyat","servicesMenu2Url":"//armut.com/evden-eve-nakliyat","servicesMenu3Text":"Boya Badana","servicesMenu3Url":"//armut.com/boyaci-boya-badana-ustasi","servicesMenu4Text":"","servicesMenu4Url":"","servicesMenu5Text":"Usta Arıyorum","servicesMenu5Url":"//armut.com/usta-ariyorum","servicesMenu6Text":"En Yakın","servicesMenu6Url":"//armut.com/en-yakin","contactUs":"","contactUsEmail":"","copyright":"© 2011 - 2026 Armut Teknoloji AŞ, Tüm Hakları Saklıdır"},"h1Bm":"En İyi 40 Temizlikçi","heroTitle":"Temizlikçi Arıyorsan Şimdi Rezervasyon Yap.","heroTitleWithoutTop":"1 Ev Temizliği Fiyat Teklifi Al, İncele.","callToActionText":"REZERVASYON YAP","proCountInformation":"\u003Cb>10.116 Temizlikçi\u003C/b> hizmet vermeye hazır.","serviceNamePrices":"Fiyatları","similarServices":"Benzer Meslekler","customerReviews":"Müşteri Yorumları","nearThisAreaTitle":"Popüler Ev Temizliği Bölgeleri","faqQa4":"Hizmet verenlerimizin profil sayfalarında gördüğünüz yıldızlar ve yorumlar, sadece Armut üzerinden yapılan hizmetlerin sonucunda müşterilerin yazdığı yorumlardır. Bu işlerin gerçekten yapıldığını ve yorumların gerçek olduğunu kontrol ve garanti ediyoruz.","faqQq4":"4- Hizmet verenlere yapılan yorumlar gerçek mi? Bu yorumları kontrol ediyor musunuz?","faqQa3":"Tüm hizmet verenlerimizin en iyi hizmeti verdiklerinden emin olmak istiyoruz. Gönül rahatlığıyla hizmet alman için, Armut üzerinden halletiğin işler 2.000 TL’ye kadar korumamız altında.","faqQq3":"3- Armut Garantisi Nedir?","faqQa2":"Elbette. Bir çok kullanıcımız beğendiği ve tanıdığı temizlikçiyle devam etmeyi tercih ediyor. Memnun kalırsan devam etmek veya istersen farklı bir kişiyle çalışmak senin elinde.","faqQq2":"2- Aynı temizlikçi ile devam edebilir miyim?","faqQa1":"Standart temizlik kapsamımızda yerlerin süpürülüp silinmesi, toz alma, camların silinmesi, kapıların silinmesi, banyo/mutfak temizliği, dolapların ve buzdolabının dışarıdan temizliği ve çöplerin çıkarılması var. Daha detaylı bir temizlik için dolapların, fırının, buzdolabının iç temizliği ve ütü gibi ekstra taleplerini detaylarda belirtmen ve 1-2 saat süre eklemen yeterli.","faqQq1":"1- Temizliğe Neler Dahil?","faqUseTopQ":"6- En İyi nasıl belirleniyor?","faqUseTopA":"Bir alandaki En İyi hizmet verenler, Armut’taki müşteri yorumları, tamamladıkları iş sayısı, iş fırsatlarına dönüş performansları gibi birçok kriter dikkate alınarak algoritmalar tarafından belirlenir.","faq":"Sıkça Sorulan Sorular","whyArmut5":"Tüm hizmet verenlerimizin en iyi hizmeti verdiklerinden emin olmak istiyoruz. Gönül rahatlığıyla işini yaptırman için, Armut üzerinden tamamladığın Ev Temizliği işlerini Armut Garantisi kapsamında korumamız altına alıyoruz.","whyArmut4":"Yılda \u003Cb>88.027\u003C/b> kişi Ev Temizliği için Armut'a güveniyor.","whyArmut4WithoutTop":"Yılda \u003Cb>88.027\u003C/b> kişi Ev Temizliği için teklif alıyor.","whyArmut3":"Yazılan \u003Cb>411.911\u003C/b> gerçek ve onaylı yorumu inceleyerek kararını verebilirsin.","whyArmut2":"Ortalama \u003Cb>4,6\u003C/b> puan doğru hizmet vereni seçmen için işini kolaylaştırıyor.","whyArmut1":"Toplam \u003Cb>10.116\u003C/b> Temizlikçi en kaliteli hizmeti sunmak için hazır.","whyArmut1WithoutTop":"Toplam \u003Cb>10.116\u003C/b> Temizlikçi hizmet sunmak için hazır.","whyArmut":"Ev Temizliği için Neden Armut Tercih Edilmeli?","chooseTheOfferDetail":"İstediğin gün ve saatte garantili Ev Temizliği hizmetinin keyfini çıkar.","chooseTheOffer":"Garantili Hizmet Al","compareOffersDetail":"Uygun fiyatlı hizmet bedelini güvenli online ödeme ile öde.","compareOffers":"Güvenli Ödeme Yap","compareOffersWithoutTop":"Teklif Al, İncele","compareOffersDetailWithoutTop":"Akıllı eşleştirme algoritmamız sayesinde hizmet verenlerimizden gelen fiyat tekliflerini görüntüle.","chooseTheOfferDetailWithoutTop":"Hizmet verenlere sorularını sor, sana en uygun teklifi seç!","tellYourNeedDetail":"Ev Temizliği ihtiyacının detaylarını gir, 2 dakika içinde rezervasyonunu oluştur.","tellYourNeed":"Rezervasyon Bilgilerini Gir","howItWorks":"Armut’ta Ev Temizliği Nasıl Çalışır?","CTAButton":"Rezervasyon Yap","beProButton":"Hizmet Vermek İçin Bize Katıl","showProfile":"Profili Görüntüle","joinUs":"Hizmet Vermek İçin Bize Katıl","headerBeProButton":"Hizmet Ver","otherPricesTitle":"Ev Temizliği Fiyatları","price":"Fiyatlar","pageDescription":"Güvenilir Ev Temizliği hizmeti al, zaman kazan, garantide ol. 10.116 Temizlikçi hazır. Ödüllü girişim. Yılda 2 milyon mutlu müşteri. Hizmet piş, ağzıma düş!","pageDescriptionWithoutTop":"10.116 Temizlikçi hazır. Hizmet piş, ağzıma düş!","pageTitle":"Ev Temizliği | Memnuniyet Garantili Profesyonel Temizlikçi Armut'ta","blogTitle":"Aşağıdaki Konular İlgini Çekebilir","serviceTypesTitle":"Hangi Ev Temizliği Türlerinde Hizmet Alınabilir?","faqQa5":"Armut'ta Ev Temizliği fiyatları, talep detayına göre 479 TL ile 1.024 TL arasında değişmektedir.","faqQq5":"5- Armut'ta Ev Temizliği fiyatları ne kadar?"},"brand":"Armut","urls":{"proSignup":"https://armut.com/profesyonel-uye-ol-191","proSignupWithoutServiceId":"https://armut.com/profesyonel-uye-ol","cobUrl":"/teklif/service/191/1","domain":"https://armut.com"},"sentinelButtonNames":{"header":{"logo":"SEOS_topLeftLogo_homepage","proSignup":"SEOS_topRightProSignup_proSignupWid"},"hero":{"stickyWeb":"SEOS_stickyWeb_COB"},"pro":{"name":"SEOS_proName_proPage","photo":"SEOS_proPhoto_proPage"},"rightCTA":"SEOS_rightCTA_COB","stickyMobile":"SEOS_stickyMobile_COB","howItWorks":{"cta":"SEOS_howItWorksCTA_COB","proSignup":"SEOS_howItWorksProSignup_proSignupWid"},"faq":{"cta":"SEOS_faqCTA_COB","proSignup":"SEOS_faqProSignup_proSignupWid"},"footer":{"about":["SEOS_footerHowItWorks_howItWorks","SEOS_footerSupport_support","SEOS_footerBlog_blog","SEOS_footerAboutUs_aboutUs","SEOS_footerCareer_career"],"services":["SEOS_footerServices1_popService1","SEOS_footerServices2_popService2","SEOS_footerServices3_popService3","SEOS_footerServices3_rahattasin","SEOS_footerServices_ustaAriyorum","SEOS_footerServices_nearMe"],"contactUs":["SEOS_footerSupportMail_supportMail","SEOS_footerProSignup_proSignupWOid"]},"breadcrumb":["SEOS_breadcrumb_homepage"],"popularRegion":"SEOS_rightPopular_SEOS1","similarServices":"SEOS_similarServices_similarProService","prices":{"topServiceLink":"SEOS_rightPrices_SEOP","serviceLink":"SEOS_rightPrices_SEOP1"}}