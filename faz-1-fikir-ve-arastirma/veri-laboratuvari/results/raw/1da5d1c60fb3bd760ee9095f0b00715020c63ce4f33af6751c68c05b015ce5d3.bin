idget no_theme_toggle responsive" data-page_name="view_jam" data-host="itch.io"><div id="jam_layout_header_2522415" class="small_logo jam_layout_header_widget header_widget base_widget gray"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" title="itch.io - indie game hosting marketplace" href="/"><span class="visually_hidden">itch.io</span><img alt="itch.io logo &amp; title" height="199" src="https://static.itch.io/images/logo-black-new.svg" class="full_logo" width="775"/><img alt="itch.io logo" height="235" src="https://static.itch.io/images/itchio-textless-black.svg" class="minimal_logo" width="262"/></a></h1><div class="header_buttons"><a class="header_button browse_btn" data-label="browse" href="/games">Browse Games</a><a class="header_button jams_btn" data-label="jams" href="/jams">Game Jams</a><a class="header_button developers_btn" data-label="developers" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a class="header_button devlogs_btn" data-label="devlogs" href="/devlogs">Developer Logs</a><a class="header_button community.home_btn" data-label="community.home" href="/community">Community</a></div><form class="game_search" action="/search"><input type="text" placeholder="Search for games, jams, tags or creators" required="required" name="q" class="search_input"/><button aria-label="Search" class="submit_btn"><svg version="1.1" role="img" fill="none" viewBox="0 0 24 24" width="18" height="18" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" class="svgicon icon_search" aria-hidden stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div id="user_panel_1841104" class="user_panel_widget base_widget"><a data-register_action="header" class="panel_button" data-label="log_in" href="/login">Log in</a><a data-register_action="header" class="panel_button register_button" data-label="register" href="/register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div id="wrapper" class="jam_page_wrap"><div id="view_jam_3713226" class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS8zMzA5MjIvMTIxMzc4OTMucG5n/original/%2Bru2SV.png" class="jam_banner full_width"/></div><div class="jam_body"><div id="jam_header_5601742" class="jam_header_widget base_widget"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/versus">Fraud Krew&#039;s Versus Jam</a></h1><div class="jam_host_header">Hosted by <a href="https://doctorbutler.itch.io">DoctorButler</a> · <a href="https://bsky.app/hashtag/FraudKrewJam">#FraudKrewJam</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/versus/entries"><div class="stat_value">5</div><div class="stat_label">Entries</div></a></div><div class="stat_box"><div class="stat_value">25</div><div class="stat_label">Ratings</div></div></div></div><div class="header_tabs"><a class="header_tab active" data-label="tab_view_jam" href="/jam/versus">Overview</a><a class="header_tab" data-label="tab_view_jam_entries" href="/jam/versus/entries">Submissions</a><a class="header_tab" href="/jam/versus/results">Results</a><div class="tab_group"><a class="header_tab" href="/jam/versus/community">Community</a><span class="community_activity">2</span></div><a class="header_tab" data-label="tab_view_jam_feed" href="/jam/versus/feed">Submission feed</a></div></div></div><div class="submitter_outer"><div id="jam_submitter_2400719" class="jam_submitter_widget base_widget after_voting is_over"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2023-06-04 04:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2023-06-11 04:00:00</span>. <a href="/jam/versus/results">View results</a></p></div></div><div class="jam_content user_formatted"><p>The Fraud Krew steps out of the ring of competitive gaming, and throws their hat into the ring of <em>game making</em> competitions</p>
<p></p>
<p>This Jam is accepting Fighting-Games or any variety (footsie, anime, 3D, platformer) - we are also accepting any fighting-game adjacent games - for example, WindJammers, Twinkle Star Sprites, Puzzle Games - basically anything born in the arcade, that supports 2-players, where the explicit goal is to defeat the other player, is acceptable. </p>
<p>Games are ranked on Mechanical Depth, the uniqueness and creativity of said mechanics, and how fun the game is overall.</p>
<p>Dreamcast-compatible games are encouraged. Speaking of Dreamcast, the winner will recieve a physical copy of The Worst of Guys for Sega Dreamcast.</p>
<p><br>Fraud Krew will run an exhibition for submitted games.<br></p>
<p>Now get out there, make some games, and make Todd proud!<br></p>
<p><br></p></div></div><div id="entries" class="grid_outer"><div class="header_row"><h2>Submissions<span class="game_count">(5)</span></h2></div><div class="jam_filter_picker"><div class="filter_item active">All submissions</div><span class="divider"> · </span><div data-filter="filter_windows" class="filter_item">Windows (2)</div></div><div class="jam_filter_empty"><p>No submissions match your filter</p></div><div class="game_grid_widget base_widget browse_game_grid"><div dir="auto" data-game_id="2107381" class="game_cell has_cover lazy_images"><div class="game_thumb"><a tabindex="-1" data-action="game_grid" class="thumb_link game_link" data-label="game:2107381:thumb" href="https://battlecapacity.itch.io/roshambofg"><img width="315" height="250" data-lazy_src="https://img.itch.zone/aW1nLzEyNDA1NzIyLnBuZw==/315x250%23c/K2Bqc6.png" class="lazy_loaded"/></a><div class="game_cell_tools"><a class="action_btn add_to_collection_btn" href="/g/battlecapacity/roshambofg/add-to-collection" data-register_action="add_to_collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a class="title game_link" data-action="game_grid" data-label="game:2107381:title" href="https://battlecapacity.itch.io/roshambofg">RoshamboFG</a></div><div title="A classic game reimagined for the 21st century!" class="game_text">A classic game reimagined for the 21st century!</div><div class="game_author"><a href="https://battlecapacity.itch.io" data-action="game_grid" data-label="user:3852618">battlecapacity</a></div><div class="game_genre">Fighting</div></div></div><div dir="auto" data-game_id="2111897" class="game_cell filter_windows has_cover lazy_images"><div style="background-color:#1e2e7f;" class="game_thumb"><a tabindex="-1" data-action="game_grid" class="thumb_link game_link" data-label="game:2111897:thumb" href="https://phil-airdash.itch.io/mind-esoterica"><img width="315" height="250" data-lazy_src="https://img.