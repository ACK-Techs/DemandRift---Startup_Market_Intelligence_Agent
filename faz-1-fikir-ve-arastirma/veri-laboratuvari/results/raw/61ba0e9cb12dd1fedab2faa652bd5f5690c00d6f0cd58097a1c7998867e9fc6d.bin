.swiper-wrapper {padding-bottom:40px;}
.swiper {max-width: 1200px;width:100%;}
.swiper-slide {max-width:600px;width:100%;opacity:0.1;}
.swiper-slide-active {opacity:1;}
.swiper-slide:not(.swiper-slide-active) {pointer-events:none;}
.swiper-button-next, .swiper-button-prev {top:180px;color:#000000;}
.swiper-pagination {margin-top:20px;}
.swiper-pagination-bullet {border:1px solid #000000;background:none;width:12px;height:12px;opacity:1;margin-left:0.5rem!important;margin-right:0.5rem!important;}
.swiper-pagination-bullet-active {background:#71C5E8;border-color:#71C5E8;}
@media (max-width:767px) {
 .swiper-button-next, .swiper-button-prev {display:none;}
