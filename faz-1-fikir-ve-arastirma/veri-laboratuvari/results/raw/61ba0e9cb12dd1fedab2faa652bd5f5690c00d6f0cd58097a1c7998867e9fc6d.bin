before\\:right-0::before { content: var(--tw-content); right: 0px; }\n.before\\:top-0:before { content: var(--tw-content); top: 0; }\n.before\\:top-4::before { top: 1rem; }\n.before\\:w-full::before { content: var(--tw-content); width: 100%; }\n.-bottom-2 { bottom: -0.5rem; }\n.-bottom-4 { bottom: -1rem; }\n.bottom-16 { bottom: 4rem; }\n.left-1 { left: 0.25rem; }\n.left-2 { left: 0.5rem; }\n.left-8 { left: 2rem; }\n.right-1 { right: 0.25rem; }\n.aspect-square { aspect-ratio: 1/1; }\n.aspect-\\[1\\/1\\] { aspect-ratio: 1/1; }\n.aspect-\\[3\\/2\\] { aspect-ratio: 3/2; }\n.aspect-\\[4\\/3\\] { aspect-ratio: 4/3; }\n.aspect-\\[5\\/3\\] { aspect-ratio: 5/3; }\n.bg-black { --tw-bg-opacity: 1; background-color: rgb(0 0 0 / var(--tw-bg-opacity)); }\n.border-black { --tw-border-opacity: 1; border-color: rgb(0 0 0 / var(--tw-border-opacity)); }\n.hover\\:text-\\[\\#235f73\\]:hover { --tw-text-opacity: 1; color: rgb(35 95 115 / var(--tw-text-opacity)); }\n.group:hover .group-hover\\:ml-4 { margin-left: 1rem; }\n.py-40 { padding-top: 10rem; padding-bottom: 10rem; }\n.basis-\\[400px\\] { flex-basis: 400px; }\n.basis-\\[500px\\] { flex-basis: 500px; }\n.max-w-8xl {max-width: 96rem;}\n.min-h-\\[640px\\] {min-height: 640px;}\n.flare { position: relative;display:inline-block; }\n.flare * { position: relative; z-index: 1; }\n.flare:before, .flare:after { transition: 0.25s margin ease-in-out; content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; }\n.flare:before { background: #c4cef7; margin: -24px; }\n.flare:after { background: #839aff; margin: 24px; }\n.flare:hover:before { margin: -12px; }\n.flare:hover:after { margin: 12px; }\n.zoomable { overflow: hidden;position:relative;display:block; }\n.zoomable * { transition: 0.25s scale ease-in-out; }\n.zoomable:hover * { scale: 1.1; }\n.tracking-widest {letter-spacing:0.1rem;}\n[data-component-id=\"0e2eee06-b142-4eb1-9fd1-c9df1645f078\"] {background:#e2e2e2;}\n.overflow-clip {overflow:clip;}\ncolgroup {display:none}\n[data-partial=\"/mac-desk-daily-update\"] {display: flex; flex-direction: column; height: 100%;}\n[data-partial=\"/mac-desk-daily-update\"] > div > div:last-child { display:none; }\n[data-partial=\"/mac-desk-daily-update\"] > div > div:nth-last-child(2) { margin-top:auto; padding-bottom:0 }\n[data-partial=\"/mac-desk-daily-update\"] [data-is-button=true] { margin:0; }"},{"id":"96b3afa5-efd7-4a5a-942b-2d11f0a4fda5","name":"Tray","content":".js--tray {border:0;z-index:1;}\n.js--tray button {margin-top:220px;border:0;}\n.js--tray button:focus {outline:0;}"},{"id":"bc3cebe5-d7af-4a6e-bf7e-08155649024e","name":"hero","content":"#integration-id-6d88da0 video {\n max-width: 1872px;\n left: 50%;\n transform: translateX(-50%);\n}\n#hero { min-height:400px; display:flex; align-items:end; margin-bottom:4rem; }\n#hero-box { max-width:700px; width:100%; margin-top:200px; margin-bottom:-4rem;}\n@media (min-width:1024px) {\n #hero { min-height: 640px; }\n}"},{"id":"8ce366ca-791a-49fd-bd57-5664da45647d","name":"collage","content":".collage {position:relative;margin-bottom:6rem;max-width:920px;}\n.collage img {object-fit:cover;}\n.collage > img, .collage > span {position:absolute;object-fit:cover;object-position:center;display:none;}\n\n/* 1 */\n.collage > div {max-width:600px;margin:auto;z-index:50;}\n.collage > div + img {aspect-ratio:5 / 3;width:40%;top:-2%;left:-2%;}\n\n/* 2 */\n.collage > div + span {width:40%;top:-2%;left:-2%;z-index:10;}\n.collage > div + span img {aspect-ratio:5 / 3;}\n\n/* 3 */\n.collage > div + span + span {width:30%;bottom:-0%;left:-8%;z-index:20;}\n.collage > div + span + span img {aspect-ratio:4 / 3;}\n\n/* 4 */\n.collage > div + span + span + span {width:35%;bottom:-4%;right:2%;z-index:30;}\n.collage > div + span + span + span img {aspect-ratio:4 / 3;}\n\n/* 5 */\n.collage > div + span + span + span + span {width:30%;top:4%;right:-4%;z-index:40;}\n.collage > div + span + span + span + span img {aspect-ratio:3 / 2;}\n\n/* 6 */\n.collage > div + span + span + span + span + span {width:30%;top:-25%;left:-20%;z-index:15;}\n.collage > div + span + span + span + span + span img {aspect-ratio:3 / 2;}\n\n/* 7 */\n.collage > div + span + span + span + span + span + span {width:40%;top:60%;left:-35%;margin-top:-20%;}\n.collage > div + span + span + span + span + span + span img {aspect-ratio:3 / 2;}\n\n/* 8 */\n.collage > div + span + span + span + span + span + span + span {width:25%;bottom:-20%;left:-15%;}\n.collage > div + span + span + span + span + span + span + span img {aspect-ratio:3 / 2;}\n\n/* 9 */\n.collage > div + span + span + span + span + span + span + span + span {width:25%;bottom:-20%;right:-30%;}\n.collage > div + span + span + span + span + span + span + span + span img {aspect-ratio:4 / 3;}\n\n/* 10 */\n.collage > div + span + span + span + span + span + span + span + span + span {width:35%;top:55%;right:-45%;margin-top:-15%;}\n.collage > div + span + span + span + span + span + span + span + span + span img {aspect-ratio:4 / 3;}\n\n/* 11 */\n.collage > div + span + span + span + span + span + span + span + span + span + span {width:30%;top:-15%;right:-30%;}\n.collage > div + span + span + span + span + span + span + span + span + span + span img {aspect-ratio:3 / 2;}\n\n@media (min-width:768px) {\n .collage {padding:7rem;}\n .collage > img {display:block;}\n .collage > span {display:block;}\n}\n\n[data-box] {position:relative;}\n[data-box]:before {content:'';position:absolute;z-index:-1;border:2px solid #000000;}\n\n[data-box*=rect-wide]:before {width:50%;height:40px;}\n[data-box*=rect-wide-r]:before {top:40%;left:99%;margin-top:-20px;}\n[data-box*=rect-wide-br]:before {top:100%;left:100%;margin:-20px;}\n[data-box*=wider]:before {width:100%;}\n\n[data-box*=rect-tall]:before {width:40px;height:30%;}\n[data-box*=rect-tall-t]:before {top:-29%;left:50%;margin-left:-20px;}\n\n[data-box*=square]:before {width:40px;height:40px;}\n[data-box*=\"square-tl\"]:before {top:0;left:0;margin:-20px;}\n[data-box*=\"square-tr\"]:before {top:0;right:0;margin:-20px;}\n[data-box*=\"square-br\"]:before {bottom:0;right:0;margin:-20px;}\n[data-box*=\"square-bl\"]:before {bottom:0;left:0;margin:-20px;}\n[data-box*=\"back\"]:before {}\n[data-box*=\"front\"]:before {z-index:1;}"},{"id":"01297943-c9d2-4dc4-abd9-2e7e6318dfb3","name":"Subscribe","content":"#integration-id-36c6c2f > div > div {max-width: 900px;margin: auto;color:#ffffff;}\n#integration-id-36c6c2f > div > div a {color:#ffffff;text-decoration:underline;}\n#integration-id-36c6c2f > div > div a[href*=mailto] {white-space: nowrap;}\n#integration-id-36c6c2f form {max-width:600px;margin:auto;}\n#integration-id-36c6c2f form label {font-weight:400;color:#FFFFFF;font-size:1rem;}\n#integration-id-36c6c2f form input {border-color:#000000;}\n#integration-id-36c6c2f form button {border:0;padding:1rem 1.5rem;gap:0;border:2px solid #000000;font-size:1rem;transition-duration: .5s;}\n#integration-id-36c6c2f form button:hover {background: white;border: 2px solid #000000;color: #000000;}\n#integration-id-36c6c2f form button svg {display:none;}\n#integration-id-36c6c2f form button {letter-spacing:0.1rem;}"},{"id":"cf3e513b-9e89-4412-8f7a-2a0fce4d966f","name":"swiper","content":"/**\n * Swiper 11.2.6\n * Most modern mobile touch slider and framework with hardware accelerated transitions\n * https://swiperjs.com\n *\n * Copyright 2014-2025 Vladimir Kharlampidi\n *\n * Released under the MIT License\n *\n * Released on: March 19, 2025\n */\n\n@font-face{font-family:swiper-icons;src:url('data:application/font-woff;charset=utf-8;base64, ');font-weight:400;font-style:normal}:root{--swiper-theme-color:#007aff}:host{position:relative;display:block;margin-left:auto;margin-right:auto;z-index:1}.swiper{margin-left:auto;margin-right:auto;position:relative;overflow:hidden;list-style:none;padding:0;z-index:1;display:block}.swiper-vertical>.swiper-wrapper{flex-direction:column}.swiper-wrapper{position:relative;width:100%;height:100%;z-index:1;display:flex;transition-property:transform;transition-timing-function:var(--swiper-wrapper-transition-timing-function,initial);box-sizing:content-box}.swiper-android .swiper-slide,.swiper-ios .swiper-slide,.swiper-wrapper{transform:translate3d(0px,0,0)}.swiper-horizontal{touch-action:pan-y}.swiper-vertical{touch-action:pan-x}.swiper-slide{flex-shrink:0;width:100%;height:100%;position:relative;transition-property:transform;display:block}.swiper-slide-invisible-blank{visibility:hidden}.swiper-autoheight,.swiper-autoheight .swiper-slide{height:auto}.swiper-autoheight .swiper-wrapper{align-items:flex-start;transition-property:transform,height}.swiper-backface-hidden .swiper-slide{transform:translateZ(0);-webkit-backface-visibility:hidden;backface-visibility:hidden}.swiper-3d.swiper-css-mode .swiper-wrapper{perspective:1200px}.swiper-3d .swiper-wrapper{transform-style:preserve-3d}.swiper-3d{perspective:1200px}.swiper-3d .swiper-cube-shadow,.swiper-3d .swiper-slide{transform-style:preserve-3d}.swiper-css-mode>.swiper-wrapper{overflow:auto;scrollbar-width:none;-ms-overflow-style:none}.swiper-css-mode>.swiper-wrapper::-webkit-scrollbar{display:none}.swiper-css-mode>.swiper-wrapper>.swiper-slide{scroll-snap-align:start start}.swiper-css-mode.swiper-horizontal>.swiper-wrapper{scroll-snap-type:x mandatory}.swiper-css-mode.swiper-vertical>.swiper-wrapper{scroll-snap-type:y mandatory}.swiper-css-mode.swiper-free-mode>.swiper-wrapper{scroll-snap-type:none}.swiper-css-mode.swiper-free-mode>.swiper-wrapper>.swiper-slide{scroll-snap-align:none}.swiper-css-mode.swiper-centered>.swiper-wrapper::before{content:'';flex-shrink:0;order:9999}.swiper-css-mode.swiper-centered>.swiper-wrapper>.swiper-slide{scroll-snap-align:center center;scroll-snap-stop:always}.swiper-css-mode.swiper-centered.swiper-horizontal>.swiper-wrapper>.swiper-slide:first-child{margin-inline-start:var(--swiper-centered-offset-before)}.swiper-css-mode.swiper-centered.swiper-horizontal>.swiper-wrapper::before{height:100%;min-height:1px;w