.collage img {object-fit:cover;}
.collage > img, .collage > span {position:absolute;object-fit:cover;object-position:center;display:none;}

/* 1 */
.collage > div {max-width:600px;margin:auto;z-index:50;}
.collage > div + img {aspect-ratio:5 / 3;width:40%;top:-2%;left:-2%;}

/* 2 */
.collage > div + span {width:40%;top:-2%;left:-2%;z-index:10;}
.collage > div + span img {aspect-ratio:5 / 3;}

/* 3 */
.collage > div + span + span {width:30%;bottom:-0%;left:-8%;z-index:20;}
.collage > div + span + span img {aspect-ratio:4 / 3;}

/* 4 */
.collage > div + span + span + span {width:35%;bottom:-4%;right:2%;z-index:30;}
.collage > div + span + span + span img {aspect-ratio:4 / 3;}

/* 5 */
.collage > div + span + span + span + span {width:30%;top:4%;right:-4%;z-index:40;}
.collage > div + span + span + span + span img {aspect-ratio:3 / 2;}

/* 6 */
.collage > div + span + span + span + span + span {width:30%;top:-25%;left:-20%;z-index:15;}
.collage > div + span + span + span + span + span img {aspect-ratio:3 / 2;}

/* 7 */
.collage > div + span + span + span + span + span + span {width:40%;top:60%;left:-35%;margin-top:-20%;}
.collage > div + span + span + span + span + span + span img {aspect-ratio:3 / 2;}

/* 8 */
.collage > div + span + span + span + span + span + span + span {width:25%;bottom:-20%;left:-15%;}
.collage > div + span + span + span + span + span + span + span img {aspect-ratio:3 / 2;}

/* 9 */
.collage > div + span + span + span + span + span + span + span + span {width:25%;bottom:-20%;right:-30%;}
.collage > div + span + span + span + span + span + span + span + span img {aspect-ratio:4 / 3;}

/* 10 */
.collage > div + span + span + span + span + span + span + span + span + span {width:35%;top:55%;right:-45%;margin-top:-15%;}
.collage > div + span + span + span + span + span + span + span + span + span img {aspect-ratio:4 / 3;}

/* 11 */
.collage > div + span + span + span + span + span + span + span + span + span + span {width:30%;top:-15%;right:-30%;}
.collage > div + span + span + span + span + span + span + span + span + span + span img {aspect-ratio:3 / 2;}

@media (min-width:768px) {
 .collage {padding:7rem;}
 .collage > img {display:block;}
 .collage > span {display:block;}
}

