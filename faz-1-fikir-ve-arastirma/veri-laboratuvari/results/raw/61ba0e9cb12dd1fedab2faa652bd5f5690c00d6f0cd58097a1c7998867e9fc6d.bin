-index: 1;top:0;}\n  [data-partial=\"/partial/ticker\"] [data-testid=belt] .flex-col-reverse > div:first-child + div:before{background: linear-gradient(to right, white, transparent);}\n  [data-partial=\"/partial/ticker\"] [data-testid=belt] .flex-col-reverse > div:first-child + div:after{background: linear-gradient(to left, white, transparent);right:0;}\n}\n\n@media (min-width:1536px) {\n\n}\n\n@media (min-width:1872px) {\n[data-partial=\"/partial/ticker\"] [data-testid=belt] {padding-left:0;padding-right:0;}\n}"}]}},{"id":"6cca1747-eecf-4311-a326-875686546282","name":"cms-component-belt","props":{"slots":{"content":[{"id":"3928347d-fe2b-422c-bbe0-6f676448d46e","name":"cms-component-nyse-ticker","props":{"slots":{}}},{"id":"5d506820-2bc5-4346-b74d-ffa070c86a75","name":"cms-component-raw-html","props":{"slots":{},"html":"<div class=\"js-market-delay hidden relative text-xxs italic text-right\">\n  <div class=\"md:absolute left-0 w-full px-2 py-2 bottom-0 z-10\">\n    Market data delayed minimum of 15 minutes\n  <\/div>\n<\/div>\n<script>\n  setTimeout(() => {\n  if(document.querySelector('[data-partial=\"/partial/ticker\"] [data-testid=belt] > div:first-child > div:not(:empty)')) {\n  document.querySelector('.js-market-delay').classList.remove('hidden');\n  }\n  }, 3000);\n<\/script>"}}]}},"layout":{"default":{"bw":0,"bc":"gray"},"sm":{"pt":0,"pb":0},"md":{"pt":0,"bw":0},"lg":{}}}]},"initializeComponents":false,"siteName":"nyse"},"meta":{"snippets":[]}}]},"url":"/partial/ticker"},"layout":{"md":{"pt":6}}},{"id":"6d88da02-f757-4879-a305-73d96ac1a869","name":"cms-component-belt","props":{"slots":{"content":[{"id":"b70aa97f-3ee9-4ffa-b9ad-49555c157d95","name":"cms-component-raw-html","props":{"slots":{},"html":"<section id=\"hero\">\n  <div class=\"container mx-auto\">\n    <div class=\"flex\">\n      <div\n        id=\"hero-box\"\n        class=\"bg-white p-8 border border-2 border-black xl:ml-12\"\n      >\n        <h1 class=\"text-4xl xl:text-5xl font-bold\">\n          The home of market-defining IPOs\n        <\/h1>\n\n        <p class=\"text-base\">\n          The New York Stock Exchange is where icons and disruptors come to\n          shape what’s next\n        <\/p>\n        <a\n          rel=\"noopener noreferrer\"\n          class=\"inline-block bg-black text-white font-semibold uppercase mr-6 px-6 py-4 text-xs hover:bg-white hover:text-black border border-2 border-black whitespace-nowrap tracking-widest hover:no-underline duration-500\"\n          href=\"/listings\"\n          >Learn more<\/a\n        >\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>"}}]},"reverse":true,"spacing":"none","backgroundVideo":{"url":"https://www.ice.com/publicdocs/images/2026_NYSE_Midyear_Video_Loop.mp4","hideBgVideoOnBreakpoint":"sm"}}},{"id":"8ac9d5fd-6838-4fa6-a556-8002aa5f9d8d","name":"cms-component-anchor","props":{"slots":{},"name":"content-start"}},{"id":"61e1b020-dd51-4bcd-8d12-bc09c03a2a92","name":"cms-component-belt","props":{"slots":{"content":[{"id":"deff676f-f303-4a40-93a8-0ea0b11edd52","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h1","children":[{"bold":true,"text":"Capital markets happen here","underlined":true}]}]}]},"layout":{"default":{"pb":12},"xl":{"pb":20}}},{"id":"fdc70e61-8a9f-49da-91df-676b290db36c","name":"cms-component-raw-html","props":{"slots":{},"html":"<section class=\"pb-12 lg:pb-40\">\n  <div class=\"container mx-auto\">\n    <div data-experience=\"6a79deaf089ac67db73320ea\"><\/div>\n  <\/div>\n<\/section>\n<script src=\"https://players.brightcove.net/5805274531001/experience_6a79deaf089ac67db73320ea/live.js\"><\/script>"}}]}},"layout":{"default":{"pt":20},"xl":{"pt":40}}},{"id":"fdc29d2d-c265-48f1-9151-02a2526accd0","name":"cms-component-belt","props":{"slots":{"content":[{"id":"859243c4-67f3-4aaf-b8c9-026c367098ca","name":"cms-component-flex-row","props":{"slots":{"5c7d2912-eb04-4d9f-b6f2-cc14411dd824":[],"911c9411-5f67-4ea0-93fb-63084318493b":[],"f2736290-13db-4eba-a9d6-7c62d007a39e":[{"id":"81cbe18b-fc68-43a6-9b05-48cf4b4f5df4","name":"cms-component-image","props":{"slots":{},"alt":"#","src":"https://www.ice.com/publicdocs/images/NYSE-homepage-pattern-01.svg"},"layout":{"default":{"mb":20}}},{"id":"2f540384-124c-4cc4-85f7-9896e2d40ca5","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"bold":true,"text":"The New York Stock Exchange creates original programming that brings financial markets to life. "}]},{"type":"div","children":[{},{"type":"line-break","children":[{}]},{"bold":true,"text":"Market Update","textSize":"1.25"}]},{"type":"div","children":[{"bold":true,"textSize":"1.25"}]},{"size":"xs","type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Start your day with a one-minute snapshot of key equity market moves, economic data, and news from NYSE-listed and private companies, including major milestones, exchange launches, and headline partnerships. ","textSize":"1.25"}]},{"type":"paragraph","children":[{"text":" ","textSize":"1.25"}]},{"size":"lg","type":"spacer","children":[{}]},{"type":"div","children":[{"bold":true,"text":"NYSE Live","textSize":"1.25"}]},{"type":"div","children":[{"bold":true,"textSize":"1.25"}]},{"size":"xs","type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Our flagship morning show brings real-time market action, daily news, and the Opening Bell together in one place. Tune in for trading floor exclusives, company spotlights, and the stories behind the numbers.","textSize":"1.25"},{"type":"line-break","children":[{}]},{},{"type":"line-break","children":[{}]},{},{"type":"line-break","children":[{}]},{},{"href":"https://tv.nyse.com/","type":"link","wide":true,"target":"_blank","children":[{"text":"Watch now"}],"isButton":true},{}]}]}]}}]},"gap":0,"rowCols":[{"id":"911c9411-5f67-4ea0-93fb-63084318493b","gap":0,"flex":"1","advanced":{"basis":0}},{"id":"f2736290-13db-4eba-a9d6-7c62d007a39e","gap":0,"flex":"4","items":"center","advanced":{"basis":0}},{"id":"5c7d2912-eb04-4d9f-b6f2-cc14411dd824","gap":0,"flex":"1","advanced":{"basis":0}}],"columnBreakpoint":"lg"},"layout":{"default":{"pr":6,"pl":6}}}]},"spacing":"fixed-1320"},"layout":{"default":{"bg":"accent","text":"white","pt":20},"md":{"pb":0.5},"lg":{"bg":"","text":"","pt":40}}},{"id":"3c31f99f-fa32-42e3-9945-211199f4ac48","name":"cms-component-belt","props":{"slots":{"content":[{"id":"ec781e42-9ba7-4774-95be-74c69ae88d6e","name":"cms-component-collage-media","props":{"slots":{},"images":[{"id":"6d8d055a-649b-49aa-8469-baaae56c9607","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Klarna.jpg"},{"id":"07d1b4ab-3244-4bbd-b296-0236458c66f1","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Etsy.jpg"},{"id":"26e0233b-69d3-41c0-a1d5-23a03e1d04e1","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_AZ.jpg"},{"id":"f1fbbc75-cee9-4341-a162-b8f23dc70c05","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_GMR.jpg"},{"id":"eed9656e-a87a-4ac9-8b99-528a235d428f","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Elf.jpg"},{"id":"6938d323-5b9e-4596-8de0-fbc5c4d5de54","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Aevex.jpg"},{"id":"569647b0-574d-40a3-adfe-229c3414244b","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Fifth_Third.jpg"},{"id":"685a2862-e8bc-4e17-9ecf-5ef014f9e5d4","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Artemis.jpg"},{"id":"c725ea66-860c-46f3-b316-7d1ef8b73df6","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Figma.jpg"},{"id":"be23f531-fc9f-497e-866c-c4ff185addcf","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Ofarm.jpg"},{"id":"48f1b9cc-e837-48f2-824b-9d786c3f8d65","image":"https://www.nyse.com/publicdocs/images/NYSE_Homepage_Collage_Uber_Delta.jpg"}]}}]},"anchor":"fade-accent-to-white","spacing":"simple","containerWidth":"none","verticalPadding":"none"}},{"id":"c547e9f1-d5cb-4fa3-bc95-55e0d69ada08","name":"cms-component-belt","props":{"slots":{"content":[{"id":"99e7c5b8-5f2c-4bff-ba9c-89c78158aad9","name":"cms-component-raw-html","props":{"slots":{},"html":"<h3 class=\"text-5xl font-bold text-center\">Today’s Stock Market<\/h3>\n"},"layout":{"default":{"text":"","pb":12}}},{"id":"009ac019-647e-4d23-9529-93aa6e5764db","name":"cms-component-flex-row","props":{"slots":{"911c9411-5f67-4ea0-93fb-63084318493b":[{"id":"60d197fc-db1e-4c72-bdce-0f280ff98781","name":"cms-component-anchor","props":{"slots":{},"name":"accent-css"}},{"id":"1c39bf48-5052-49ba-bad6-2f7568b1cf66","name":"cms-component-flex-column","props":{"slots":{"content":[{"id":"eb9f0d13-6716-4fd8-8c2e-77ba9d28c086","name":"cms-component-partial","props":{"slots":{"content":[{"id":"05fa430f-0fcb-4a0e-9bf3-1d202eb40fa1","name":"cms-template-partial","props":{"slots":{"body":[{"id":"0969f367-eb40-4821-8d72-6f498899d54e","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{"type":"div","children":[{"bold":true,"text":"Eric Criscuolo"}]},{"type":"div","children":[{"bold":true,"text":"Market Strategist"}]}]}]}},{"id":"9bcd4bc4-e6a3-4ede-9445-5ffa413ac722","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"left","children":[{"type":"paragraph","children":[{"text":"September 2, 2026 at 9:00 a.m. EST","textSize":"1"}],"paragraphType":"disclaimer"}]}]},"layout":{"default":{"pb":2.5}}},{"id":"100284b8-4d21-4c67-abf9-634d1e3eda98","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"Good morning and Happy Birthday Nolan and First Day of Middle School Devon! The worst month for stocks started according to plan yesterday. The S&P 500 fell 0.7%, equal-weight -0.8% and Russell 2000 -1.2%. The re-emergence of Middle East hostilities over the weekend continued into Tuesday after Iran struck two tankers and the US responded with strikes on IRGC targets later in the day. Oil rose 5%, treasuries rose 3-5bp and gold, silver and bitcoin fell 2-4%. Energy led as expected with oil’s strength, while the defensively-oriented Utilities, Healthcare and Staples also saw gains. Discretionary lagged, and Industrials, Materials and Tech sectors also fell 1%-plus. Economic data including ISM Manufacturing and JOLTS didn’t lean too meaningfully to either the Bull or Bear side. "}]},{"type":"paragraph","children":[{"text":"US equity futures were lower this morning along with rest of the globe. Losses were modest however and futures bounced off their lows to turn positive as Treasury yields turned lower. DELL (+9% pre-market) was the big earnings print last night, and the company blew away estimates and raised guidance. The AI business was a standout as expected but even traditional products showed strong growth. Treasury yields are down ~2bp and the US Dollar Index is adding to yesterday’s gains, nearing 100 again. The 30y has pulled back from its earlier highs ~5.3%. The ADP monthly employment report showed 38K private jobs were added in August, below the 47K estimate and down from July’s 44K. It was the slowest pace since January and continues the cooling trend in the labor market."}]},{"type":"paragraph","children":[{"text":"Commodities are rather subdued. Oil is slightly lower and well off its overnight high ~$97 as the November contract pulled back from a test of its May highs. Chevron signed an agreement to expand its operations in Venezuela. Gold is lower, continuing its downtrend and falling below its 100d ma/$4400. Copper is unchanged, looking to hold its 50d after a run to record highs. Crypto continues to consolidate late August’s sharp rally.  "}]}]},"layout":{"default":{"pb":5}}},{"id":"fd78b51d-d49a-4e18-a8f0-8770a4ee6faf","name":"cms-component-rich-text","props":{"slot