    <script>
        function initPiwik(){
            var _paq = window._paq = window._paq || [];
            
            _paq.push(['trackPageView', document.title, {
                    dimension2: 'pg_directory',
                
                dimension3: SF.devicePixelRatio,
                
            }]);
            _paq.push(['enableLinkTracking']);
            
