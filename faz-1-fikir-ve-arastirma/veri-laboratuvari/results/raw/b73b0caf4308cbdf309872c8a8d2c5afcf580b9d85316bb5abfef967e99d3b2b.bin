<section class="md:mb-[-18.75rem] relative z-10" id="pricingCalculator"
         data-aos="fade-down"
         data-aos-offset="300"
         data-aos-duration="1500">
  <div id="pollfish-pricing-calculator" class="max-w-full md:max-w-[55.875rem] lg:max-w-[71.125rem] mx-auto md:rounded-[0.625rem] bg-white shadow-[0rem_0rem_3.75rem_0rem_#5C67761A] pt-[2.8125rem] px-[1.5rem] pb-[3.5rem] md:p-[3.5rem] lg:pt-[2.75rem] lg:pl-[3.375rem] lg:pr-[3.5625rem] lg:pb-[3.75rem]">

    <header class="text-center mb-8 lg:mb-9">
      <h2 class="text-[2.5rem] leading-[3.75rem] font-bold text-bright-gray mb-4">Survey Pricing Calculator</h2>
      <p class="text-bright-gray max-w-[15.625rem] md:max-w-full mx-auto ">Get an instant estimate for your survey project</p>
    </header>

    <div class="mb-8 lg:mb-9">

      <div class="mb-8 lg:mb-9">
        <h3 class="text-bright-gray font-bold text-[1.5rem] leading-[2.25rem]">Survey</h3>
      </div>

      <div class="grid grid-cols-1 gap-[1.6875rem] mb-[1.6875rem]">
        <div>
          <label class="block font-semibold text-[1rem] leading-[1.5rem] text-bright-gray mb-1 text-sm p-0">Number of Survey Questions (Approximate length of interview):</label>
          <div class="relative w-full">
            <select id="questionCount" class="w-full appearance-none px-4 py-4 bg-white font-light shadow-[0px_0px_60px_0px_#5C67761A] border border-heather rounded-[0.625rem] text-bright-gray transition-all outline-none focus:border-blue-ribbon pr-10
                          bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEwIDgiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0wLjM5OTk5NCAwLjI5OTk4OEw0Ljg5OTk5IDYuMjk5OTlMOS4zOTk5OSAwLjI5OTk4OCIgc3Ryb2tlPSIjOEY5OEE5Ii8+Cjwvc3ZnPgo=')]
                          bg-[position:right_1.0625rem_center]
                          bg-[length:1.25rem_1.25rem]
                          bg-no-repeat
                          bg-auto">
              <option value="1-5">1-5 Questions (&lt;2 mins)</option>
              <option value="6-10">6-10 Questions (2-3 mins)</option>
              <option value="11-15">11-15 Questions (5 mins)</option>
              <option value="16-20">16-20 Questions (6-7 mins)</option>
              <option value="21-25">21-25 Questions (7-8 mins)</option>
              <option value="26-30">26-30 Questions (9-10 mins)</option>
              <option value="31-35">31-35 Questions (10-12 mins)</option>
              <option value="36-40">36-40 Questions (12-13 mins)</option>
              <option value="41-45">41-45 Questions (13-15 mins)</option>
              <option value="46-50">46-50 Questions (15-17 mins)</option>
              <option value="51-55">51-55 Questions (18-19 mins)</option>
              <option value="56-60">56-60 Questions (19-20 mins)</option>
              <option value="61-65">61-65 Questions (20-22 mins)</option>
              <option value="66-70">66-70 Questions (22-23 mins)</option>
              <option value="71-75">71-75 Questions (23-25 mins)</option>
              <option value="76-80">76-80 Questions (26-27 mins)</option>
              <option value="81-85">81-85 Questions (28-29 mins)</option>
              <option value="86-90">86-90 Questions (29-30 mins)</option>
              <option value="91-95">91-95 Questions (30-31 mins)</option>
              <option value="96-100">96-100 Questions (32-33 mins)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-semibold text-[1rem] leading-[1.5rem] text-bright-gray mb-1 text-sm p-0">Target Number of Responses</label>
          <input type="number" id="responseCount" value="100" min="10" max="10000" class="w-full font-light px-2.5 py-4 bg-white shadow-[0px_0px_60px_0px_#5C67761A] border border-heather rounded-[0.625rem] text-bright-gray transition-all outline-none focus:border-blue-ribbon">
        </div>
      </div>

      <div class="mb-8">
        <label class="block font-semibold text-[1rem] leading-[1.5rem] text-bright-gray mb-1 text-sm p-0">Screening Questions</label>
        <div class="relative w-full">
          <select id="screeningQuestions" class="w-full appearance-none px-4 py-4 bg-white font-light shadow-[0px_0px_60px_0px_#5C67761A] border border-heather rounded-[0.625rem] text-bright-gray transition-all outline-none focus:border-blue-ribbon pr-10
