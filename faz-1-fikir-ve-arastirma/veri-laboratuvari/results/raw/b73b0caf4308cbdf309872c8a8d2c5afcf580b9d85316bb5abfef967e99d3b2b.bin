<script>
  // Temporary polyfill: the header's hover dropdowns (.hs-dropdown[--trigger:hover]) are
  // powered by Preline, whose JS ships in the large footer-loaded app bundle. The header
  // paints (and becomes hoverable) well before that bundle finishes loading, so hovering
  // right after a page load can silently do nothing. This inline script runs immediately
  // at this point in the HTML stream and replicates Preline's own open/close class
  // toggling (not a competing CSS rule) so hover works from the first paint. Once Preline
  // itself initializes (detected via window.$hsDropdownCollection), this hands off and
  // removes its own listeners to avoid double-handling.
  (function () {
    var dropdowns = document.querySelectorAll('.hs-dropdown.\\[--trigger\\:hover\\]');
    if (!dropdowns.length) return;

    function openDropdown(dropdown, menu, toggle) {
      if (dropdown.classList.contains('open')) return;
      dropdown.classList.add('open');
      menu.classList.remove('hidden');
      menu.classList.add('block');
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown(dropdown, menu, toggle) {
      if (!dropdown.classList.contains('open')) return;
      dropdown.classList.remove('open');
      menu.classList.remove('block');
      menu.classList.add('hidden');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    }

    var handlers = [];

    dropdowns.forEach(function (dropdown) {
      var menu = dropdown.querySelector(':scope > .hs-dropdown-menu');
      var toggle = dropdown.querySelector(':scope > .hs-dropdown-toggle');
      if (!menu) return;

      var onEnter = function () { openDropdown(dropdown, menu, toggle); };
      var onLeave = function () { closeDropdown(dropdown, menu, toggle); };

      dropdown.addEventListener('mouseenter', onEnter);
      dropdown.addEventListener('mouseleave', onLeave);

      handlers.push({ dropdown: dropdown, onEnter: onEnter, onLeave: onLeave });
    });

    var checks = 0;
    var maxChecks = 100;
    var interval = setInterval(function () {
      checks++;
      if (window.$hsDropdownCollection && window.$hsDropdownCollection.length) {
        handlers.forEach(function (h) {
          h.dropdown.removeEventListener('mouseenter', h.onEnter);
          h.dropdown.removeEventListener('mouseleave', h.onLeave);
        });
        clearInterval(interval);
      } else if (checks >= maxChecks) {
        clearInterval(interval);
      }
    }, 500);
  })();
</script>
