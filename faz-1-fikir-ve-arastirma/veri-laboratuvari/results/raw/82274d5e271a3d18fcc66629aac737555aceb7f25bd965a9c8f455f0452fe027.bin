  margin:10px 0 8px !important;
}
@media (min-width:768px){
  body.single-toptools .elementor-widget-theme-post-title h1,
  body.single-toptools .elementor-widget-theme-post-title .elementor-heading-title,
  .elementor-10348 .elementor-widget-theme-post-title h1,
  .elementor-10348 .elementor-widget-theme-post-title .elementor-heading-title{
    font-size:2.15rem !important;
  }
}

/* Hide Top Tools chip + coral slash; keep the date as a quiet line under the H1 */
body.single-toptools .cat-date > span:first-child,
body.single-toptools .cat-date .seprater,
.elementor-10348 .cat-date > span:first-child,
.elementor-10348 .cat-date .seprater{
  display:none !important;
}
body.single-toptools .elementor-element-36e0696e,
body.single-toptools .date_n_cate,
