  padding-top:0 !important;
}
body.single-toptools .elementor-widget-theme-post-content p:first-child,
.elementor-10348 .elementor-widget-theme-post-content p:first-child{
  margin-top:0 !important;
}

/* H1: same words, tighter */
body.single-toptools .elementor-widget-theme-post-title,
body.single-toptools .elementor-widget-theme-post-title .elementor-widget-container,
body.single-toptools .elementor-element-7969312b,
.elementor-10348 .elementor-widget-theme-post-title,
.elementor-10348 .elementor-widget-theme-post-title .elementor-widget-container,
.elementor-10348 .elementor-element-7969312b{
  margin:0 !important;
  padding:0 !important;
}
body.single-toptools .elementor-widget-theme-post-title h1,
body.single-toptools .elementor-widget-theme-post-title .elementor-heading-title,
.elementor-10348 .elementor-widget-theme-post-title h1,
.elementor-10348 .elementor-widget-theme-post-title .elementor-heading-title{
  font:700 1.7rem/1.18 Poppins,sans-serif !important;
  letter-spacing:-.03em !important;
