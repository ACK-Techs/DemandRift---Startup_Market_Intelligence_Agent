  .elementor-10348 .elementor-element-2fba97a8 .elementor-shortcode,
  .elementor-10348 .elementor-element-2fba97a8 .autor-content,
  .elementor-10348 .elementor-element-2fba97a8 .author-area,
  .elementor-10348 .elementor-element-2fba97a8 .auth-content,
  .elementor-10348 .elementor-element-2fba97a8 .auth-img,
  .elementor-10348 .elementor-element-2fba97a8 .list-c-btn{
    display:none !important;
    visibility:hidden !important;
    pointer-events:none !important;
    overflow:hidden !important;
    height:0 !important;
    max-height:0 !important;
    width:0 !important;
    max-width:0 !important;
    margin:0 !important;
    padding:0 !important;
  }
}
body.single-toptools .ss-byline,
.elementor-10348 .ss-byline{
  margin:4px 0 8px !important;
  padding-bottom:12px !important;
}
/* TOC in-flow slot collapses only when JS parks it as a rail (already also in :has rule above). */
body.single-toptools .elementor-widget-theme-post-content,
body.single-toptools .elementor-widget-theme-post-content > .elementor-widget-container,
.elementor-10348 .elementor-widget-theme-post-content,
.elementor-10348 .elementor-widget-theme-post-content > .elementor-widget-container{
