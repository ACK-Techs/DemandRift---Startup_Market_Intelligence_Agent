/* StartupStash article chrome — compact byline + extended credits */
.elementor-10348 .elementor-widget-html .ss-byline,
.elementor-widget-html .ss-byline,
div.ss-byline,
.ss-byline{
  position:relative;
  display:flex !important;
  flex-wrap:wrap !important;
  align-items:center !important;
  gap:6px 20px;
  margin:4px 0 20px;
  padding:0 0 16px;
  border-bottom:1px solid #E6EBEF;
  font-family:Poppins,Nunito Sans,sans-serif;
  font-size:13px;
  font-weight:500;
  line-height:1.3;
  color:#5B6B80;
  overflow:visible;
}
.ss-person{
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:8px;
  cursor:pointer;
}
.ss-person img{
  width:32px;
  height:32px;
  border-radius:50%;
  object-fit:cover;
  object-position:center 25%;
  background:#fff;
  flex:0 0 32px;
  box-shadow:0 0 0 1px #E6EBEF;
}
.ss-person .ss-lbl{white-space:nowrap}
.ss-person .ss-lbl a{
  color:#0F3766;
  font-weight:600;
  text-decoration:none;
}
.ss-person:hover .ss-lbl a,
.ss-person:focus-within .ss-lbl a{color:#FF6644}
.ss-sep{
  width:1px;
  height:16px;
  background:#D5DEE6;
  flex:0 0 1px;
}
.ss-tip{
  visibility:hidden;
  opacity:0;
  pointer-events:none;
  position:absolute;
  left:0;
  top:100%;
  z-index:50;
  width:320px;
  max-width:min(320px, calc(100vw - 32px));
  box-sizing:border-box;
  background:transparent;
  border:0;
  box-shadow:none;
  padding:12px 8px 8px 0;
  text-align:left;
  text-transform:none;
  letter-spacing:0;
  white-space:normal;
  font-weight:400;
  overflow-wrap:break-word;
  word-break:break-word;
  transition:opacity .15s ease, visibility .15s linear;
  transition-delay:.25s;
}
.ss-tip:before{
  content:"";
  position:absolute;
  left:0;
  right:8px;
  top:12px;
  bottom:6px;
  background:#fff;
  border:1.5px dashed #0F3766;
  border-radius:10px;
  box-shadow:4px 4px 0 #0F3766;
  z-index:-1;
}
.ss-person:hover .ss-tip,
.ss-person:focus-within .ss-tip,
.ss-pill:hover .ss-tip,
.ss-pill:focus-within .ss-tip{
  visibility:visible;
  opacity:1;
  pointer-events:auto;
  transition-delay:0s;
}
.ss-tip > img{
  display:block;
  width:48px;
  height:48px;
  margin:16px 16px 0;
  border-radius:50%;
  object-fit:cover;
  object-position:center 25%;
  box-shadow:none;
  position:relative;
}
.ss-tip .n,
.ss-tip .t,
.ss-tip .b,
.ss-tip .links{
  padding-left:16px;
  padding-right:16px;
}
.ss-tip .n{
  margin:10px 0 0;
  font:600 15px/1.25 Poppins,sans-serif;
  color:#0F3766;
  text-transform:none;
  letter-spacing:0;
}
.ss-tip .n a{color:#0F3766;text-decoration:none}
.ss-tip .t{
  margin:2px 0 8px;
  font:500 12px/1.35 Poppins,sans-serif;
  color:#5B6B80;
  text-transform:none;
  letter-spacing:0;
}
.ss-tip .b{
  margin:0 0 10px;
  font:400 13px/1.5 Poppins,Nunito Sans,sans-serif;
  color:#0F3766;
  text-transform:none;
  letter-spacing:0;
  white-space:normal;
}
.ss-tip .links{
  display:flex;
  align-items:center;
  gap:10px;
  margin:0;
  padding-bottom:16px;
}
.ss-tip .links a{
  display:inline-flex;
  align-items:center;
  gap:5px;
  margin:0;
  font:500 11px/1 Poppins,sans-serif;
  color:#FF6644;
  text-decoration:none;
  text-transform:none;
  letter-spacing:0;
}
.ss-tip .links a.ss-li{
  width:18px;
  height:18px;
  flex:0 0 18px;
}
.ss-tip .links a.ss-li svg{display:block;width:18px;height:18px}
.ss-tip .links a.ss-review-link{font:500 11px/1 Poppins,sans-serif}

.ss-pill{
  position:relative;
  display:inline-flex;
  align-items:center;
  margin-left:auto;
  border:1px solid #FF6644;
  color:#0F3766;
  border-radius:999px;
  padding:5px 11px;
  font:600 10px/1 Poppins,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
  cursor:pointer;
  background:#fff;
  white-space:nowrap;
}
.ss-byline > .ss-person ~ .ss-person .ss-tip,
.ss-pill .ss-tip{
  left:auto;
  right:0;
}
.ss-pill .ss-tip{
  width:280px;
  max-width:min(280px, calc(100vw - 32px));
  text-transform:none;
  letter-spacing:0;
  white-space:normal;
  font:400 13px/1.5 Poppins,sans-serif;
  color:#0F3766;
}
.elementor-10348 .elementor-widget-html,
.elementor-10348 .elementor-widget-html .elementor-widget-container{
  overflow:visible !important;
}
@media (max-width:767px){
  .ss-sep{display:none}
  .ss-pill{margin-left:0}
  .ss-person,
  .ss-pill{position:static}
  .ss-byline .ss-tip,
  .ss-pill .ss-tip,
  .ss-byline > .ss-person ~ .ss-person .ss-tip{
    left:0 !important;
    right:0 !important;
    width:auto !important;
    max-width:none !important;
    padding:12px 8px 8px 0;
  }
}

.ss-cta{
  display:flex;
  flex-wrap:wrap;
  gap:14px 20px;
  align-items:center;
  background:#0F3766;
  color:#fff;
  border-radius:12px;
  padding:20px 22px;
  margin:36px 0 24px;
  font-family:Poppins,Nunito Sans,sans-serif;
}
.ss-cta p{
  margin:0 0 4px;
  font:600 16px/1.3 Poppins,sans-serif;
}
.ss-cta span{
  display:block;
  font:400 13px/1.45 Poppins,sans-serif;
  color:#E8EEF4;
}
.ss-cta a{
  display:inline-block;
  margin-left:auto;
  background:#FF6644;
  color:#fff;
  text-decoration:none;
  font:600 13px/1 Poppins,sans-serif;
  border-radius:999px;
  padding:11px 16px;
  white-space:nowrap;
}

.ss-credits{
  margin:8px 0 28px;
  padding:0;
  background:transparent;
  font-family:Poppins,Nunito Sans,sans-serif;
}
.ss-credits > .kicker{
  font:700 22px/1.2 Poppins,sans-serif;
  letter-spacing:-.02em;
  text-transform:none;
  color:#111;
  margin:0 0 14px;
}
.ss-credits-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
  align-items:stretch;
}
.ss-credit{
  display:block;
  min-width:0;
  background:#F7F9FA;
  border-radius:12px;
  padding:20px 20px 18px;
  border:1.5px dotted #0F3766;
}
.ss-credit{position:relative}
.ss-credit .ss-review-link{
  position:absolute;
  top:14px;
  right:14px;
  display:inline-flex;
  align-items:center;
  gap:5px;
  font:500 11px/1 Poppins,sans-serif;
  color:#FF6644;
  text-decoration:none;
  letter-spacing:0;
}
.ss-tip .ss-review-link{
  position:static;
}
.ss-review-link svg{flex:0 0 12px}
.ss-credit .kicker{
  font:600 11px/1.2 Poppins,sans-serif;
  letter-spacing:.05em;
  text-transform:uppercase;
  color:#5B6B80;
  margin:0 0 12px;
}
.ss-credit-head{
  display:flex;
  gap:14px;
  align-items:center;
  margin:0 0 12px;
}
.ss-credit img{
  width:72px;
  height:72px;
  border-radius:50%;
  object-fit:cover;
  object-position:center 25%;
  flex:0 0 72px;
  background:#fff;
}
.ss-credit .who{
  margin:0;
  font:600 18px/1.25 Poppins,sans-serif;
}
.ss-credit .who a{color:#0F3766;text-decoration:none}
.ss-credit .role{
  margin:3px 0 0;
  font:500 13px/1.3 Poppins,sans-serif;
  color:#5B6B80;
}
.ss-credit .bio{
  margin:0 0 12px;
  font:400 14px/1.5 Poppins,Nunito Sans,sans-serif;
  color:#0F3766;
}
.ss-credit{
  display:flex;
  flex-direction:column;
}
.ss-credit .more{
  margin:auto 0 0;
  padding-top:4px;
  min-height:20px;
  display:flex;
  align-items:center;
  gap:12px;
  font:600 13px/1.3 Poppins,sans-serif;
}
.ss-credit .more a{color:#FF6644;text-decoration:none}
.ss-credit .more a.ss-li{
  display:inline-flex;
  align-items:center;
  width:20px;
  height:20px;
  flex:0 0 20px;
  color:inherit;
}
.ss-credit .more a.ss-li svg{display:block;width:20px;height:20px}
@media (max-width:720px){
  .ss-credits-row{grid-template-columns:1fr}
}

.ss-protip{
  background:#F7F9FA;
  border-left:4px solid #FF6644;
  border-radius:0 10px 10px 0;
  padding:14px 16px;
  margin:1.4em 0;
  font-family:Poppins,Nunito Sans,sans-serif;
}
.ss-protip strong{
  display:block;
  font:600 11px/1.2 Poppins,sans-serif;
  letter-spacing:.05em;
  text-transform:uppercase;
  color:#FF6644;
  margin:0 0 6px;
}

/* How we review tools — page 50633 */
.ss-review{
  font-family:Poppins,Nunito Sans,sans-serif;
  color:#0F3766;
  max-width:760px;
}
.ss-review .lede{
  font:400 18px/1.55 Poppins,sans-serif;
  color:#0F3766;
  margin:0 0 28px;
}
.ss-flow{
  margin:8px 0 36px;
  padding:22px 22px 8px;
  background:#F7F9FA;
  border-radius:16px;
  border:1px solid #E6EBEF;
}
.ss-flow figcaption{
  font:600 11px/1.2 Poppins,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#FF6644;
  margin:0 0 18px;
}
.ss-flow ol{
  list-style:none;
  margin:0;
  padding:0;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px 12px;
  counter-reset:step;
}
.ss-flow li{
  position:relative;
  background:#fff;
  border-radius:12px;
  padding:16px 14px 14px;
  box-shadow:0 1px 0 #E6EBEF;
  min-height:132px;
}
/* 3-up featured last card is for the review-page grid only.
   Article figures reuse .ss-flow as a vertical list (navy number pills, paper cards).
   House lock: never paint black body text on navy. */
.ss-review .ss-flow li:last-child{
  grid-column:1 / -1;
  background:#0F3766;
  color:#fff;
  min-height:auto;
}
.ss-review .ss-flow li:last-child,
.ss-review .ss-flow li:last-child strong,
.ss-review .ss-flow li:last-child span,
.ss-review .ss-flow li:last-child p,
.ss-review .ss-flow li:last-child .ss-num{
  color:#fff;
}
.ss-review .ss-flow li:last-child p{color:#E8EEF4}
.ss-review .ss-flow li:last-child .ss-num{background:#FF6644;color:#fff}

/* Vertical list (4+ rows, or any ss-flow in article body): paper cards, no navy last row. */
.elementor-widget-theme-post-content .ss-flow ol,
.ss-flow ol:has(> li:nth-child(4)){
  display:flex;
  flex-direction:column;
  grid-template-columns:none;
  gap:0;
}
.elementor-widget-theme-post-content .ss-flow li,
.ss-flow ol:has(> li:nth-child(4)) > li{
  min-height:0;
  background:transparent;
  box-shadow:none;
  padding:0;
}
.elementor-widget-theme-post-content .ss-flow li:last-child,
.ss-flow ol:has(> li:nth-child(4)) > li:last-child{
  grid-column:auto;
  background:transparent;
  color:inherit;
  min-height:0;
}
.elementor-widget-theme-post-content .ss-flow li:last-child strong,
.elementor-widget-theme-post-content .ss-flow li:last-child p,
.ss-flow ol:has(> li:nth-child(4)) > li:last-child strong,
.ss-flow ol:has(> li:nth-child(4)) > li:last-child p{
  color:inherit;
}
.ss-num{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:28px;
  height:28px;
  border-radius:50%;
  background:#0F3766;
  color:#fff;
  font:600 11px/1 Poppins,sans-serif;
  margin:0 0 10px;
}
.ss-flow strong{
  display:block;
  font:600 14px/1.25 Poppins,sans-serif;
  color:#0F3766;
  margin:0 0 6px;
}
.ss-flow p{
  margin:0;
  font:400 12px/1.45 Poppins,sans-serif;
  color:#5B6B80;
}
.ss-review h2{
  font:600 22px/1.25 Poppins,sans-serif;
  color:#0F3766;
  margin:36px 0 12px;
}
.ss-review .body{
  font:400 16px/1.6 Poppins,sans-serif;
  margin:0 0 14px;
}
.ss-checks{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:16px 0 24px;
  padding:0;
  list-style:none;
}
.ss-checks li{
  background:#F7F9FA;
  border-radius:10px;
  padding:12px 14px;
  font:400 14px/1.45 Poppins,sans-serif;
  color:#0F3766;
  border-left:3px solid #FF6644;
}
.ss-who{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
  margin:16px 0 28px;
}
.ss-who-card{
  background:#fff;
  border-radius:10px;
  padding:18px;
  border:1.5px dotted #0F3766;
}
.ss-who-card img{
  width:56px;
  height:56px;
  border-radius:50%;
  object-fit:cover;
  object-position:center 25%;
}
.ss-who-card .nm{
  margin:10px 0 0;
  font:600 16px/1.25 Poppins,sans-serif;
}
.ss-who-card .nm a{color:#0F3766;text-decoration:none}
.ss-who-card .rl{
  margin:2px 0 8px;
  font:500 13px/1.3 Poppins,sans-serif;
  color:#5B6B80;
}
.ss-who-card p.bio{
  margin:0;
  font:400 13px/1.5 Poppins,sans-serif;
  color:#0F3766;
}
.ss-honest{
  background:#0F3766;
  color:#fff;
  border-radius:14px;
  padding:22px 24px;
  margin:28px 0 8px;
}
.ss-honest strong{
  display:block;
  font:600 11px/1.2 Poppins,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:#FF6644;
  margin:0 0 8px;
}
.ss-honest p{
  margin:0 0 10px;
  font:400 15px/1.55 Poppins,sans-serif;
  color:#F7F9FA;
}
.ss-honest a{color:#FF6644;font-weight:600;text-decoration:none}
@media (max-width:900px){
  .ss-flow ol{grid-template-columns:1fr 1fr}
}
@media (max-width:720px){
  .ss-flow ol,.ss-checks,.ss-who{grid-template-columns:1fr}
  .ss-flow{padding:16px 14px 6px}
  .ss-review .lede{font-size:16px}
  .ss-review h2{font-size:20px;margin:28px 0 10px}
}

/* Related posts heading — navy, house look. Copy stays "More articles". */
.elementor-10348 .related-p .elementor-heading-title,
.elementor-10348 .related-p h2,
.elementor-10348 .related-p h3,
.related-p .elementor-heading-title,
.elementor-10348 .related-blog-posts .elementor-heading-title,
.elementor-10348 .elementor-element-21c647f6 .elementor-heading-title,
.related-blog-posts .elementor-heading-title,
.elementor-element-21c647f6 .elementor-heading-title{
  color:#0F3766 !important;
  font-family:Poppins,Nunito Sans,sans-serif !important;
  font-weight:600 !important;
  letter-spacing:-0.01em;
}
.elementor-10348 .related-p .elementor-post__title a,
.related-p .elementor-post__title a,
.elementor-10348 .elementor-element-342b3570 .elementor-post__title a,
.elementor-element-342b3570 .elementor-post__title a{
  font-family:Poppins,sans-serif !important;
  font-weight:600 !important;
  color:#111 !important;
}

/* Hide the corner back-to-top control */
.elementor-10348 a[href="#top"],
body.single-toptools a[href="#top"],
body.single-toptools #back-to-top,
body.single-toptools .back-to-top,
body.single-toptools .go-top,
body.single-toptools .elementor-button[href="#top"]{
  display:none !important;
}

/* Article type: one family, real weights */
.elementor-10348 .elementor-widget-theme-post-title .elementor-heading-title,
.elementor-10348 h1.entry-title,
.elementor-10348 .elementor-widget-theme-post-title h1{
  font-family:Poppins,Nunito Sans,sans-serif !important;
