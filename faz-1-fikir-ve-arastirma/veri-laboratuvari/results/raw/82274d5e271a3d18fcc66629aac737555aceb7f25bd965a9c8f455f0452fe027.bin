  color:#111 !important;
  line-height:1.2 !important;
}
.elementor-10348 .elementor-widget-theme-post-content,
.elementor-10348 .elementor-widget-theme-post-content p{
  font-family:Poppins,Nunito Sans,sans-serif !important;
