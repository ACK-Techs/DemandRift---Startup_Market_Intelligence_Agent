body.single-toptools .cat-date span,
.elementor-10348 .cat-date,
.elementor-10348 .cat-date span{
  font:500 13px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  letter-spacing:0 !important;
  text-transform:none !important;
  font-weight:500 !important;
}

/* ==========================================================================
   Alternatives singles — CPT `alternative`, plugin `alternative-shortcode`.
   Shared template (elementor-page-16617 is header/footer only). Scope
   body.single-alternative so every alternatives article picks this up.
   Do NOT reuse toptools / Elementor 10348 title-stack widget IDs or JS.
   ========================================================================== */

body.single-alternative{
  font-family:Poppins,Nunito Sans,sans-serif;
  color:#1a2a3a;
}
body.single-alternative .alternative-single,
body.single-alternative .alt-container,
body.single-alternative .alt-content-area,
body.single-alternative .alt-main-content,
body.single-alternative .alt-data,
body.single-alternative .alternative-box,
body.single-alternative .more-al,
body.single-alternative .more-alt-boxes{
  overflow:visible !important;
}

/* Breadcrumbs already sit above the H1 on this template (ul.alt-breadcrumbs).
   Coral links, hide last crumb + the inline » separators, same left edge. */
body.single-alternative .alt-breadcrumbs{
  font:500 12px/1.4 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  list-style:none !important;
  margin:0 0 4px !important;
  padding:8px 0 0 !important;
}
body.single-alternative .alt-breadcrumbs li{
  display:inline !important;
  font-size:0 !important; /* swallow » text nodes */
  color:#5B6B80 !important;
  margin:0 !important;
  padding:0 !important;
}
body.single-alternative .alt-breadcrumbs li a{
  color:#FF6644 !important;
  text-decoration:none !important;
  font:500 12px/1.4 Poppins,sans-serif !important;
}
body.single-alternative .alt-breadcrumbs li:last-child{
  display:none !important;
}
body.single-alternative .alt-breadcrumbs li:not(:last-child):not(:nth-last-child(2)):after{
  content:" \203A\00a0";
  color:#5B6B80;
  font:500 12px/1.4 Poppins,sans-serif;
}

/* H1: black, tighter title stack, less leftover whitespace */
body.single-alternative .blog-t,
body.single-alternative .alt-main-content .blog-t{
  margin:0 !important;
  padding:0 !important;
}
body.single-alternative .blog-t h1,
body.single-alternative .alt-main-content h1{
  font:700 1.7rem/1.18 Poppins,sans-serif !important;
  letter-spacing:-.03em !important;
  color:#111 !important;
  text-align:left !important;
  margin:10px 0 8px !important;
}
@media (min-width:768px){
  body.single-alternative .blog-t h1,
  body.single-alternative .alt-main-content h1{
    font-size:2.15rem !important;
  }
}

/* Date under H1 if a date exists — do not invent one */
body.single-alternative .cat-date,
body.single-alternative .date_n_cate,
body.single-alternative time.entry-date{
  display:block !important;
  font:500 13px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  letter-spacing:0 !important;
  text-transform:none !important;
  margin:0 0 6px !important;
  padding:0 !important;
}

/* Intro / in-article type + coral links */
body.single-alternative .alt-post-content,
body.single-alternative .alt-post-content p{
  font-family:Poppins,Nunito Sans,sans-serif !important;
  font-size:17px;
  line-height:1.7;
  font-weight:400;
  color:#1a2a3a;
}
body.single-alternative .alt-post-content p{margin:0 0 1.05em}
body.single-alternative .alt-post-content a{
  color:#FF6644 !important;
  text-decoration:none;
}
body.single-alternative .alt-post-content a:hover{color:#e25536 !important}

/* Product screenshots — thin frame */
body.single-alternative .alt-post-content img,
body.single-alternative .img_content img{
  border-radius:10px;
  box-shadow:0 0 0 1px #E6EBEF, 0 6px 18px rgba(15,55,102,.08);
}

/* Left Get Listed card (.alt-content-area .auth-bio .author-area, left:-280px).
   Desktop ≥1180 has a real left gutter. Below that the plugin's
   .author-area {position:relative;left:0} at ≤768 parks it on the title.
   Hide the TITLE-STACK card only. Keep .auth-bio.mb-bio (in-article block).
   Header pill a.ss-m-listed is sitewide — leave it alone. */
@media (max-width:1179px){
  body.single-alternative .alt-content-area .auth-bio,
  body.single-alternative .alt-content-area .auth-bio .autor-content,
  body.single-alternative .alt-content-area .auth-bio .author-area,
  body.single-alternative .alt-content-area .auth-bio .auth-content,
  body.single-alternative .alt-content-area .auth-bio .auth-img,
  body.single-alternative .alt-content-area .auth-bio .list-c-btn,
  body.single-alternative .alt-content-area .auth-bio .autor-img{
    display:none !important;
    visibility:hidden !important;
    pointer-events:none !important;
    overflow:hidden !important;
    height:0 !important;
    max-height:0 !important;
    width:0 !important;
    max-width:0 !important;
    margin:0 !important;
    padding:0 !important;
  }
}

/* Rank cards — unique layout. Stamped deck, not a flat 2023 dump.
   Plugin used width:76% + soft gray shadow. Full column + house stamp. */
body.single-alternative .alternative-box{
  margin:22px 0 !important;
  padding:0 !important;
}
body.single-alternative .main_alternative{
  width:100% !important;
  max-width:100% !important;
  box-sizing:border-box;
  background:#fff !important;
  border:1.5px dashed #0F3766 !important;
  border-radius:10px !important;
  box-shadow:4px 4px 0 #0F3766 !important;
  padding:20px 20px 18px !important;
  margin:0 !important;
}
body.single-alternative .header_logo{
  align-items:center;
  margin:0 0 8px;
}
body.single-alternative .header_logo img{
  width:36px;
  height:auto;
  margin-right:10px !important;
}
body.single-alternative .head_content p{
  font-family:Poppins,sans-serif !important;
  color:#0F3766 !important;
  margin:0 0 2px !important;
}
body.single-alternative .head_content p:first-child{
  font:700 15px/1.2 Poppins,sans-serif !important;
  letter-spacing:-.01em;
}
body.single-alternative .head_content p:last-child{
  font:500 12px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
}
body.single-alternative .alt_name h2{
  font-family:Poppins,sans-serif !important;
  font-weight:700 !important;
  color:#FF6644 !important;
  letter-spacing:-.02em;
}
body.single-alternative .alt-category{
  font:500 12px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
}
body.single-alternative .alt-category a{
  background:#F7F9FA !important;
  color:#0F3766 !important;
  border:1px solid #E6EBEF;
  margin-left:6px;
  padding:4px 10px !important;
  border-radius:999px !important;
  font:600 11px/1.2 Poppins,sans-serif !important;
}
body.single-alternative .alt_social i{color:#FF6644 !important}
body.single-alternative .img_content p,
body.single-alternative .img_content h5{
  font-family:Poppins,Nunito Sans,sans-serif !important;
  font-size:16px;
  line-height:1.65;
  color:#1a2a3a;
}

/* Quiet date under H1 (injected when the plugin has no date line). */
body.single-alternative .ss-alt-date{
  display:block;
  font:500 13px/1.3 Poppins,sans-serif;
  color:#5B6B80;
  margin:0 0 8px;
  padding:0;
}
body.single-alternative .ss-byline{
  margin:4px 0 16px !important;
  padding-bottom:14px !important;
}

/* More alternatives — compact stamped cards (no cover image).
   Child theme sets .bg-alt-img min-height:200px, h3 min-height:75px,
   p min-height:165px. Zero those. Coral pill must keep a white label
   (earlier color:#FF6644 on #FF6644 fill made the CTA look empty). */
body.single-alternative .more-al{
  background:transparent !important;
  padding:8px 0 24px !important;
  margin-top:28px !important;
}
body.single-alternative .more-al > h2{
  font:700 22px/1.2 Poppins,sans-serif !important;
  color:#0F3766 !important;
  letter-spacing:-.02em !important;
  margin:0 0 16px !important;
  text-align:left !important;
  font-size:0 !important;
  line-height:0 !important;
}
body.single-alternative .more-al > h2::after{
  content:"More alternatives";
  display:block;
  font:700 22px/1.2 Poppins,sans-serif;
  color:#0F3766;
  letter-spacing:-.02em;
  line-height:1.2;
}
body.single-alternative .more-alt-boxes{
  display:flex !important;
  flex-wrap:wrap !important;
  gap:16px !important;
  overflow:visible !important;
}
body.single-alternative .more-alt-boxes .alt-box{
  flex:1 1 0;
  min-width:0;
  width:auto !important;
  max-width:100%;
  margin:0 !important;
  background:#fff !important;
  border:1.5px dashed #0F3766 !important;
  border-radius:10px !important;
  box-shadow:4px 4px 0 #0F3766 !important;
  overflow:hidden;
  padding:0 0 12px !important;
  transform:none;
  transition:transform .15s ease, box-shadow .15s ease;
}
body.single-alternative .more-alt-boxes .alt-box:hover{
  transform:translate(-2px,-2px) !important;
  box-shadow:6px 6px 0 #0F3766 !important;
  z-index:2;
}
/* Hide featured/cover images on More alternatives related cards only.
   Ranked in-article screenshots (Juniper Square etc.) stay. */
body.single-alternative .more-alt-boxes .bg-alt-img,
body.single-alternative .more-alt-boxes .bg-alt-img img{
  display:none !important;
  height:0 !important;
  min-height:0 !important;
  max-height:0 !important;
  margin:0 !important;
  padding:0 !important;
  background:none !important;
  overflow:hidden !important;
  border:0 !important;
  box-shadow:none !important;
}
body.single-alternative .more-alt-boxes .alt-box-cont{
  padding:14px 12px 2px !important;
}
body.single-alternative .more-alt-boxes .alt-box-cont h3{
  min-height:0 !important;
}
body.single-alternative .more-alt-boxes .alt-box-cont h3,
body.single-alternative .more-alt-boxes .alt-box-cont h3 a{
  font:600 14px/1.3 Poppins,sans-serif !important;
  color:#111 !important;
  margin:0 0 4px !important;
  text-decoration:none !important;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
body.single-alternative .more-alt-boxes .alt-box-cont h3 a:hover{color:#FF6644 !important}
body.single-alternative .more-alt-boxes .alt-cat,
body.single-alternative .more-alt-boxes .alt-cat a{
  font:600 11px/1.2 Poppins,sans-serif !important;
  color:#FF6644 !important;
  text-decoration:none !important;
}
body.single-alternative .more-alt-boxes .alt-box-cont p{
  min-height:0 !important;
  margin:6px 0 8px !important;
  font:400 13px/1.45 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  display:-webkit-box !important;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
body.single-alternative .more-alt-boxes .read-m-btn{
  display:inline-block !important;
  background:#FF6644 !important;
  color:#fff !important;
  fill:#fff !important;
  font:600 12px/1 Poppins,sans-serif !important;
  text-decoration:none !important;
  border-radius:999px !important;
  padding:9px 14px !important;
  margin:2px 12px 0 !important;
  white-space:nowrap;
  box-sizing:border-box;
  max-width:calc(100% - 24px);
  overflow:hidden;
  text-overflow:ellipsis;
}
body.single-alternative .more-alt-boxes .read-m-btn i{display:none !important}
body.single-alternative .more-alt-boxes .read-m-btn:empty::after{
  content:"See alternatives";
  color:#fff;
  font:600 12px/1 Poppins,sans-serif;
}

@media (max-width:767px){
  body.single-alternative{overflow-x:hidden}
  body.single-alternative .more-alt-boxes{
    flex-direction:column !important;
    gap:14px !important;
  }
  body.single-alternative .more-alt-boxes .alt-box{
    width:100% !important;
  }
  body.single-alternative .main_alternative{
    width:100% !important;
  }
  body.single-alternative .img_content{width:100% !important; margin:0 !important}
}

/* Compact Get Listed sidebar bio */
.author-area .auth-content > p{
  font-size:0 !important;
  line-height:0 !important;
}
.author-area .auth-content > p::after{
  content:"An editorial team. Writers who work in each category research the shortlists. We check first-party pages and public prices before publish.";
  display:block;
  font:400 14px/1.45 Poppins,sans-serif;
  color:#242429;
  white-space:normal;
}

/* StartupStash mega-menu — Yuval middle-nav (19 Aug 2026) */

.header-area.mob-c-head,
.sticky-c-head,
.custom-header,
.head-container,
.site-c-menu,
.site-nav,
.desktop-c-menu{
  overflow:visible !important;
}
.header-area.mob-c-head,
.sticky-c-head{
  z-index:10060 !important;
}

/* Hide the old WP middle items immediately (do not wait for JS / .ss-mega-on).
   That wait is the one-frame flash of Tools/Categories/Blog. */
.desktop-c-menu #menu-main-menu,
.desktop-c-menu .site-c-menu ul.site-m-nav,
.desktop-c-menu .site-nav > ul#menu-main-menu,
#ss-mega-root{
  display:none !important;
  visibility:hidden !important;
}

/* Kill the native Top Lists flyout */
.desktop-c-menu .site-nav li .sub-menu,
.desktop-c-menu .menu-item-has-children > .sub-menu{
  display:none !important;
  visibility:hidden !important;
}

/* Desktop Get listed / List a Product: coral, white, bold */
.desktop-c-menu a.list-c-btn,
.desktop-c-menu a.list-c-btn span,
.header-area a.list-c-btn,
.header-area a.list-c-btn span,
a.list-c-btn,
a.list-c-btn span{
  background:#FF6644 !important;
  color:#fff !important;
  font-weight:700 !important;
}

/* Positioned ancestor for full-width panels */
body.ss-mega-on .custom-header.desktop-c-menu{
  position:relative;
}
body.ss-mega-on .head-container,
body.ss-mega-on .site-c-menu,
body.ss-mega-on .site-c-menu .sc-padding,
body.ss-mega-on .site-nav,
body.ss-mega-on .ss-nav,
body.ss-mega-on .ss-nav-item{
  position:static;
}
body.ss-mega-on .desktop-c-menu .site-nav{
  display:flex !important;
  align-items:center;
  justify-content:center;
  width:100%;
  min-width:0;
}

/* ===== Desktop middle nav ===== */
body.ss-mega-on .ss-nav{
  display:flex;
  align-items:center;
  gap:2px;
  height:100%;
  flex:1 1 auto;
  min-width:0;
  justify-content:center;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-nav-item{
  height:100%;
  display:flex;
  align-items:center;
}
body.ss-mega-on .ss-nav-btn{
  background:none;
  border:0;
  cursor:pointer;
  font-family:Poppins,Nunito Sans,sans-serif !important;
  font-size:15px;
  font-weight:700;
  color:#0F3766;
  padding:9px 14px;
  border-radius:10px;
  display:flex;
  align-items:center;
  gap:6px;
  transition:background .15s,color .15s;
  line-height:1.2;
}
body.ss-mega-on .ss-nav-btn:hover,
body.ss-mega-on .ss-nav-item.is-open .ss-nav-btn{
  background:#FDE9E4;
  color:#FF6644;
}
body.ss-mega-on .ss-chev{
  width:9px;
  height:9px;
  border-right:2px solid currentColor;
  border-bottom:2px solid currentColor;
  transform:rotate(45deg) translateY(-2px);
  transition:transform .15s;
  flex:0 0 9px;
}
body.ss-mega-on .ss-nav-item.is-open .ss-chev{
  transform:rotate(225deg) translateY(-1px);
}

/* ===== Panels ===== */
body.ss-mega-on .ss-panel{
  position:absolute;
  top:100%;
  left:0;
  right:0;
  display:none;
  justify-content:center;
  pointer-events:none;
  z-index:10070;
  box-sizing:border-box;
}
body.ss-mega-on .ss-nav-item.is-open .ss-panel{
  display:flex;
  pointer-events:auto;
}
body.ss-mega-on .ss-panel-in{
  background:#fff;
  border:1.5px dashed #0F3766;
  border-radius:14px;
  box-shadow:6px 6px 0 rgba(15,55,102,.14);
  margin:10px 24px 0;
  animation:ss-nav-drop .16s ease;
  overflow:hidden;
  flex-shrink:0;
  max-width:calc(100vw - 48px);
  font-family:Poppins,Nunito Sans,sans-serif;
  color:#0F3766;
  box-sizing:border-box;
}
@keyframes ss-nav-drop{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  body.ss-mega-on .ss-panel-in{animation:none}
}

body.ss-mega-on .ss-eyebrow{
  font-size:11px;
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#5B6B80;
  margin-bottom:14px;
}

body.ss-mega-on .ss-mrow{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:10px 12px;
  border-radius:10px;
  transition:background .12s;
  text-decoration:none !important;
  color:#0F3766 !important;
  box-sizing:border-box;
  min-width:0;
}
body.ss-mega-on .ss-mrow:hover,
body.ss-mega-on .ss-mrow:focus{
  background:#FDE9E4;
}
body.ss-mega-on .ss-mrow:hover .ss-mrow-t,
body.ss-mega-on .ss-mrow:focus .ss-mrow-t{
  color:#FF6644;
}
body.ss-mega-on .ss-mico{
  width:36px;
  height:36px;
  border-radius:9px;
  background:#0F3766;
  color:#fff;
  display:grid;
  place-items:center;
  flex-shrink:0;
  font-size:15px;
  font-weight:800;
  box-shadow:2px 2px 0 #FF6644;
  position:relative;
  overflow:hidden;
  line-height:1;
}
body.ss-mega-on .ss-mico .ss-fav{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:contain;
  background:#fff;
  padding:6px;
  border-radius:inherit;
  box-sizing:border-box;
}
body.ss-mega-on .ss-mrow-t{
  display:block;
  font-size:15px;
  font-weight:800;
  color:#0F3766;
  line-height:1.25;
  transition:color .12s;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-mrow-d{
  display:block;
  font-size:13px;
  color:#5B6B80;
  margin-top:2px;
  line-height:1.35;
  font-weight:400;
}

body.ss-mega-on .ss-panel-foot{
  border-top:1px dashed #D6DEE8;
  padding:13px 26px;
  display:flex;
  align-items:center;
  gap:24px;
  background:#F7F9FA;
  font-size:14px;
  font-weight:800;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-panel-foot a{
  color:#FF6644 !important;
  display:flex;
  align-items:center;
  gap:6px;
  text-decoration:none !important;
}
body.ss-mega-on .ss-panel-foot a:hover{text-decoration:underline !important}
body.ss-mega-on .ss-panel-foot .ss-sep{color:#D6DEE8}

/* Tools */
body.ss-mega-on .ss-p-tools{width:min(880px,calc(100vw - 48px))}
body.ss-mega-on .ss-p-tools-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:4px 16px;
  padding:24px 26px 20px;
}
body.ss-mega-on .ss-p-tools-grid .ss-eyebrow{grid-column:1/-1}

/* Alternatives */
body.ss-mega-on .ss-p-alt{width:min(760px,calc(100vw - 48px))}
body.ss-mega-on .ss-p-alt-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4px 16px;
  padding:24px 26px 20px;
}
body.ss-mega-on .ss-p-alt-grid .ss-eyebrow{grid-column:1/-1}

/* Top Lists */
body.ss-mega-on .ss-p-lists{width:min(880px,calc(100vw - 48px))}
body.ss-mega-on .ss-p-lists-grid{
  display:grid;
  grid-template-columns:300px 1fr;
  gap:24px;
  padding:24px 26px 22px;
}
body.ss-mega-on .ss-feat{
  background:#0F3766;
  color:#fff;
  border-radius:12px;
  padding:20px 22px;
  display:flex;
  flex-direction:column;
  gap:8px;
  box-shadow:4px 4px 0 #FF6644;
  text-decoration:none !important;
  box-sizing:border-box;
}
body.ss-mega-on .ss-feat:hover{box-shadow:6px 6px 0 #FF6644}
body.ss-mega-on .ss-feat .ss-tag{
  font-size:11px;
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#FF6644;
}
body.ss-mega-on .ss-feat h4{
  margin:0;
  font-size:19px;
  font-weight:800;
  line-height:1.25;
  color:#fff;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-feat p{
  margin:0;
  font-size:13px;
  color:#D6DEE8;
  line-height:1.45;
}
body.ss-mega-on .ss-feat-btn{
  margin-top:8px;
  align-self:flex-start;
  background:#FF6644;
  color:#fff;
  border:0;
  font-size:13px;
  font-weight:800;
  padding:9px 16px;
  border-radius:9px;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-feat-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:12px;
}
body.ss-mega-on .ss-mini{
  border:1.5px dashed #D6DEE8;
  border-radius:10px;
  padding:12px 14px;
  transition:border-color .12s;
  text-decoration:none !important;
  background:#fff;
  box-sizing:border-box;
}
body.ss-mega-on .ss-mini:hover{border-color:#FF6644}
body.ss-mega-on .ss-mini .ss-tag{
  font-size:10px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:#FF6644;
}
body.ss-mega-on .ss-mini h5{
  font-size:14px;
  font-weight:800;
  color:#0F3766;
  margin:2px 0 0;
  font-family:Poppins,Nunito Sans,sans-serif;
}

/* Blog */
body.ss-mega-on .ss-p-blog{width:min(960px,calc(100vw - 48px))}
body.ss-mega-on .ss-p-blog-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  padding:24px 26px 22px;
}
body.ss-mega-on .ss-p-blog-grid .ss-eyebrow{grid-column:1/-1;margin-bottom:2px}
body.ss-mega-on .ss-bpost{
  display:flex;
  flex-direction:column;
  gap:9px;
  text-decoration:none !important;
  min-width:0;
}
body.ss-mega-on .ss-bpost-img{
  aspect-ratio:16/10;
  border-radius:10px;
  overflow:hidden;
  background:#F7F9FA;
  border:1.5px solid #D6DEE8;
  transition:border-color .12s;
}
body.ss-mega-on .ss-bpost:hover .ss-bpost-img{border-color:#FF6644}
body.ss-mega-on .ss-bpost-img img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
body.ss-mega-on .ss-bpost h5{
  margin:0;
  font-size:14px;
  font-weight:800;
  color:#0F3766;
  line-height:1.35;
  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
  transition:color .12s;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-bpost:hover h5{color:#FF6644}

/* Resources */
body.ss-mega-on .ss-p-res3{width:min(900px,calc(100vw - 48px))}
body.ss-mega-on .ss-p-res3-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:16px;
  padding:24px 26px;
}
body.ss-mega-on .ss-rbox{
  border-radius:12px;
  padding:20px 20px 18px;
  display:flex;
  flex-direction:column;
  gap:8px;
  transition:transform .12s, box-shadow .12s;
  text-decoration:none !important;
  box-sizing:border-box;
  min-width:0;
}
body.ss-mega-on .ss-rbox:hover{transform:translate(-2px,-2px)}
body.ss-mega-on .ss-rbox .ss-tag{
  font-size:11px;
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
}
body.ss-mega-on .ss-rbox h4{
  margin:0;
  font-size:18px;
  font-weight:800;
  line-height:1.25;
  font-family:Poppins,Nunito Sans,sans-serif;
}
body.ss-mega-on .ss-rbox p{
  margin:0;
  font-size:13px;
  line-height:1.5;
  flex:1;
}
body.ss-mega-on .ss-rbox-cta{
  font-size:13px;
  font-weight:800;
  margin-top:6px;
}
body.ss-mega-on .ss-rbox-navy{
  background:#0F3766;
  color:#fff;
  box-shadow:4px 4px 0 #FF6644;
}
body.ss-mega-on .ss-rbox-navy:hover{box-shadow:6px 6px 0 #FF6644}
body.ss-mega-on .ss-rbox-navy .ss-tag,
body.ss-mega-on .ss-rbox-navy .ss-rbox-cta{color:#FF6644}
body.ss-mega-on .ss-rbox-navy h4{color:#fff}
body.ss-mega-on .ss-rbox-navy p{color:#D6DEE8}
body.ss-mega-on .ss-rbox-coral{
  background:#FF6644;
  color:#fff;
  box-shadow:4px 4px 0 #0F3766;
}
body.ss-mega-on .ss-rbox-coral:hover{box-shadow:6px 6px 0 #0F3766}
body.ss-mega-on .ss-rbox-coral .ss-tag,
body.ss-mega-on .ss-rbox-coral .ss-rbox-cta{color:#FFE3DA}
body.ss-mega-on .ss-rbox-coral h4{color:#fff}
body.ss-mega-on .ss-rbox-coral p{color:#FFE9E2}
body.ss-mega-on .ss-rbox-light{
  background:#F7F9FA;
  border:1.5px dashed #0F3766;
  color:#0F3766;
  box-shadow:4px 4px 0 rgba(15,55,102,.14);
}
body.ss-mega-on .ss-rbox-light:hover{box-shadow:6px 6px 0 rgba(15,55,102,.14)}
body.ss-mega-on .ss-rbox-light .ss-tag,
body.ss-mega-on .ss-rbox-light .ss-rbox-cta{color:#FF6644}
body.ss-mega-on .ss-rbox-light h4{color:#0F3766}
body.ss-mega-on .ss-rbox-light p{color:#5B6B80}

/* ===== Mobile drawer accordion ===== */
body.ss-mega-on #myLinks .site-m-nav,
body.ss-mega-on #myLinks #menu-main-menu-1,
body.ss-mega-on .mobile-c-menu .site-m-nav > li.menu-item{
  display:none !important;
}
body.ss-mega-on .ss-mob{
  display:none;
}
@media (max-width:767px){
  body.ss-mega-on .ss-nav{display:none !important}
  body.ss-mega-on .ss-panel{display:none !important}
  body.ss-mega-on{overflow-x:hidden}
  body.ss-mega-on #myLinks{
    overflow-x:hidden;
    box-sizing:border-box;
  }
  body.ss-mega-on #myLinks .ss-mob{
    display:block;
    width:100%;
    font-family:Poppins,Nunito Sans,sans-serif;
  }
  body.ss-mega-on .ss-acc{border-bottom:1px solid #D6DEE8}
  body.ss-mega-on .ss-acc-btn{
    width:100%;
    background:none;
    border:0;
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:16px 20px;
    font-size:16px;
    font-weight:800;
    color:#0F3766;
    font-family:Poppins,Nunito Sans,sans-serif;
    text-decoration:none !important;
    box-sizing:border-box;
    text-align:left;
  }
  body.ss-mega-on .ss-acc-btn .ss-chev{
    width:9px;
    height:9px;
    border-right:2px solid currentColor;
    border-bottom:2px solid currentColor;
    transform:rotate(45deg);
    transition:transform .15s;
    translate:none;
  }
  body.ss-mega-on .ss-acc.is-open .ss-acc-btn{color:#FF6644}
  body.ss-mega-on .ss-acc.is-open .ss-acc-btn .ss-chev{transform:rotate(225deg)}
  body.ss-mega-on .ss-acc-body{display:none;padding:0 20px 14px}
  body.ss-mega-on .ss-acc.is-open .ss-acc-body{display:block}
  body.ss-mega-on .ss-acc-body a{
    display:flex;
    justify-content:space-between;
    padding:10px 4px;
    font-size:15px;
    font-weight:700;
    color:#0F3766;
    text-decoration:none !important;
    font-family:Poppins,Nunito Sans,sans-serif;
  }
  body.ss-mega-on .ss-acc-body a:hover{color:#FF6644}
  body.ss-mega-on .top-n-bar{
    display:flex !important;
    align-items:center;
    gap:12px;
  }
  body.ss-mega-on .top-n-bar a.ss-m-listed{
    display:inline-flex !important;
    background:#FF6644 !important;
    color:#fff !important;
    margin-left:auto !important;
    margin-right:10px !important;
  }
  body.ss-mega-on .top-n-bar .icon.mob-c-ico,
  body.ss-mega-on .top-n-bar a.icon.mob-c-ico{
    border-radius:0 !important;
    -webkit-border-radius:0 !important;
    width:36px !important;
    height:36px !important;
  }
}
@media (min-width:768px){
  body.ss-mega-on .ss-mob{display:none !important}
}

/* Archive title stack + All Alternatives full list (19 Aug 2026) */
body.post-type-archive-alternative .load-btns,
body.post-type-archive-alternative .load-btn,
body.post-type-archive-alternative .e-load-more-anchor,
body.post-type-archive-alternative .jet-listing-grid__loader,
body.post-type-archive-alternative .jet-filters-pagination,
body.page-template-toptools .load-btns,
body.page-template-toptools-php .load-btns,
body.page-id-28888 .load-btns{
  display:none !important;
  visibility:hidden !important;
  height:0 !important;
  margin:0 !important;
  padding:0 !important;
  overflow:hidden !important;
  pointer-events:none !important;
}
body.post-type-archive-alternative .sec-4.h-blog .blog-box.hide-box{display:block !important}
body.post-type-archive-alternative .sec-4.h-blog .blog-box.hide-box .blog-fea-img{background-image:none !important}
body.post-type-archive-alternative .sec-4.h-blog .blog-box,
body.page-template-toptools .sec-4.h-blog .blog-box,
body.page-template-toptools-php .sec-4.h-blog .blog-box,
body.page-id-28888 .sec-4.h-blog .blog-box{
  content-visibility:auto;
  contain-intrinsic-size:auto 320px;
}
body.post-type-archive-alternative .product-section > .prod-container > .product-section,
body.page-template-toptools .product-section > .prod-container > .product-section,
body.page-template-toptools-php .product-section > .prod-container > .product-section,
body.page-id-28888 .product-section > .prod-container > .product-section{padding-top:8px}
body.post-type-archive-alternative .breadcurmbs,
body.page-template-toptools .breadcurmbs,
body.page-template-toptools-php .breadcurmbs,
body.page-id-28888 .breadcurmbs{
  display:flex !important;
  flex-wrap:wrap;
  justify-content:center;
  align-items:center;
  width:100% !important;
  list-style:none !important;
  margin:4px 0 0 !important;
  padding:0 12px !important;
  text-align:center;
  box-sizing:border-box;
}
body.post-type-archive-alternative .breadcurmbs li,
body.page-template-toptools .breadcurmbs li,
body.page-template-toptools-php .breadcurmbs li,
body.page-id-28888 .breadcurmbs li{
  display:inline !important;
  margin:0 !important;
  font:500 12px/1.4 Poppins,Nunito Sans,sans-serif !important;
  color:#5B6B80 !important;
}
body.post-type-archive-alternative .breadcurmbs a,
body.page-template-toptools .breadcurmbs a,
body.page-template-toptools-php .breadcurmbs a,
body.page-id-28888 .breadcurmbs a{
  color:#FF6644 !important;
  text-decoration:none !important;
  font:500 12px/1.4 Poppins,Nunito Sans,sans-serif !important;
}
body.post-type-archive-alternative .breadcurmbs .fa,
body.page-template-toptools .breadcurmbs .fa,
body.page-template-toptools-php .breadcurmbs .fa,
body.page-id-28888 .breadcurmbs .fa{color:#5B6B80 !important;margin:0 6px}
body.post-type-archive-alternative .sec-4.h-blog > .title-n-link,
body.page-template-toptools .sec-4.h-blog > .title-n-link,
body.page-template-toptools-php .sec-4.h-blog > .title-n-link,
body.page-id-28888 .sec-4.h-blog > .title-n-link{
  display:flex !important;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  width:100% !important;
  max-width:100%;
  text-align:center !important;
  margin-top:8px !important;
  margin-bottom:16px !important;
  padding:0 16px;
  box-sizing:border-box;
}
body.post-type-archive-alternative .title-n-link::before,
body.page-template-toptools .title-n-link::before,
body.page-template-toptools-php .title-n-link::before,
body.page-id-28888 .title-n-link::before{
  content:none !important;
  display:none !important;
}
body.post-type-archive-alternative .title-n-link .main-title,
body.page-template-toptools .title-n-link .main-title,
body.page-template-toptools-php .title-n-link .main-title,
body.page-id-28888 .title-n-link .main-title,
body.post-type-archive-alternative .title-n-link h1,
body.page-template-toptools .title-n-link h1,
body.page-template-toptools-php .title-n-link h1,
body.page-id-28888 .title-n-link h1{
  display:block !important;
  width:auto !important;
  max-width:20em;
  box-sizing:border-box;
  margin:4px 0 10px !important;
  padding:0 0 10px;
  font-family:Poppins,Nunito Sans,sans-serif !important;
  font-weight:800 !important;
  font-size:40px !important;
  line-height:1.12 !important;
  letter-spacing:-.03em !important;
  color:#0F3766 !important;
  background:transparent;
  border:0;
  border-radius:0;
  box-shadow:none;
  border-bottom:3px solid #FF6644;
}
body.post-type-archive-alternative .title-n-link::after,
body.page-template-toptools .title-n-link::after,
body.page-template-toptools-php .title-n-link::after,
body.page-id-28888 .title-n-link::after{
