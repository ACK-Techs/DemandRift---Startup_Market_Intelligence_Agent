/* TOC — in-flow on every width; JS adds .is-rail when there is room. Never hide. */
.ss-toc{
  display:block;
  position:static;
  width:100%;
  max-width:100%;
  box-sizing:border-box;
  margin:0 0 22px;
  padding:16px 16px 14px;
  background:#fff;
  border:1.5px dashed #0F3766;
  border-radius:10px;
  box-shadow:4px 4px 0 #0F3766;
  font-family:Poppins,sans-serif;
  z-index:30;
}
.ss-toc strong{
  display:block;
  font:700 14px/1.25 Poppins,sans-serif;
  letter-spacing:-.01em;
  text-transform:none;
  color:#111;
  margin:0 0 10px;
}
.ss-toc-progress{
  height:3px;
  background:#E6EBEF;
  border-radius:2px;
  margin:0 0 12px;
  overflow:hidden;
}
.ss-toc-progress i{
  display:block;
  height:100%;
  width:0;
  background:#FF6644;
  border-radius:2px;
}
.ss-toc ol{
  margin:0;
  padding:0;
  list-style:none;
  columns:1;
}
.ss-toc li{
  position:relative;
  margin:0 0 8px;
  padding:0 0 0 12px;
  font:400 13px/1.4 Poppins,sans-serif;
}
.ss-toc li:last-child{margin-bottom:0}
.ss-toc li:before{
  content:"";
  position:absolute;
  left:0;
  top:.55em;
  width:5px;
  height:5px;
  border-radius:50%;
  background:transparent;
}
.ss-toc li.is-active{font-weight:600}
.ss-toc li.is-active:before{background:#FF6644}
.ss-toc a{color:#111;text-decoration:none}
.ss-toc a:hover{color:#FF6644}
.ss-toc.is-rail{
  position:fixed;
  top:240px;
  right:20px;
  width:220px;
  max-height:calc(100vh - 260px);
  overflow:auto;
  margin:0;
}
.elementor-element-c7e5f104{
  margin:0 !important;
  padding:0 !important;
}
.elementor-element-c7e5f104:has(.ss-toc.is-rail),
.elementor-element-c7e5f104:has(.ss-toc.is-rail) > .elementor-widget-container{
  height:0 !important;
  min-height:0 !important;
  margin:0 !important;
  padding:0 !important;
  overflow:visible !important;
}
.ss-toc.is-past.is-rail{visibility:hidden;pointer-events:none}
@media (max-width:720px){
  .ss-toc{padding:12px 14px 10px}
  .ss-toc li{font-size:13px}
}

/* FAQ — paper panel, white cards, circular toggle.
   Scope under post-content so article H2/p rules cannot flatten the type. */
.elementor-10348 .elementor-widget-theme-post-content .ss-faq,
.ss-faq{
  margin:2.2em 0 2em;
  padding:26px 22px 16px;
  background:#F7F9FA;
  border-radius:16px;
  font-family:Poppins,Nunito Sans,sans-serif;
  border:0;
}
.elementor-10348 .elementor-widget-theme-post-content .ss-faq > h2,
.elementor-10348 .elementor-widget-theme-post-content .ss-faq .ss-faq-kicker,
.ss-faq > h2,
.ss-faq > strong,
.ss-faq .ss-faq-kicker{
  display:block !important;
  font:700 32px/1.15 Poppins,sans-serif !important;
  letter-spacing:-.03em !important;
  text-transform:none !important;
  color:#111 !important;
  margin:0 0 18px !important;
}
.elementor-10348 .elementor-widget-theme-post-content .ss-faq details,
.ss-faq details{
  background:#fff;
  border-radius:12px;
  padding:0;
  margin:0 0 10px;
  border:0;
  box-shadow:0 1px 3px rgba(15,55,102,.08);
}
.ss-faq details:last-child{margin-bottom:4px}
.elementor-10348 .elementor-widget-theme-post-content .ss-faq summary,
.ss-faq summary{
  cursor:pointer;
  list-style:none;
  position:relative;
  padding:16px 56px 16px 18px;
  font:600 16px/1.35 Poppins,sans-serif !important;
  color:#111 !important;
}
.ss-faq summary::-webkit-details-marker{display:none}
.ss-faq summary:after{
  content:"+";
  position:absolute;
  right:14px;
  top:50%;
  transform:translateY(-50%);
  width:24px;
  height:24px;
  border-radius:50%;
  background:#0F3766;
  color:#fff;
  font:500 16px/24px Poppins,sans-serif;
  text-align:center;
  float:none;
  margin:0;
}
.ss-faq details[open] summary:after{content:"\2013"}
.elementor-10348 .elementor-widget-theme-post-content .ss-faq details p,
.ss-faq details p{
  margin:0 !important;
  padding:0 18px 16px !important;
  font:400 14px/1.55 Poppins,Nunito Sans,sans-serif !important;
  color:#5B6B80 !important;
}

/* Key takeaways — only renders when the article includes .ss-takeaways */
.ss-takeaways{
  position:relative;
  margin:10px 12px 28px;
  padding:22px 26px 20px;
  background:#F7F9FA;
  border:none;
  border-radius:10px;
  font-family:Poppins,Nunito Sans,sans-serif;
  overflow:visible;
  box-sizing:border-box;
}
.ss-takeaways:after{content:none;display:none}
.ss-takeaways:before{
  content:"";
  display:block;
  position:absolute;
  inset:3px;
  border:1.5px dashed #0F3766;
  border-radius:8px;
  pointer-events:none;
  z-index:0;
}
.ss-takeaways h2,
.ss-takeaways ul{position:relative;z-index:1}
.ss-takeaways h2{
  margin:0 0 12px !important;
  font:700 22px/1.2 Poppins,sans-serif !important;
  color:#111 !important;
  letter-spacing:-.02em;
  border:0;
}
.ss-takeaways ul{
  margin:0;
  padding:0 0 0 1.15em;
}
.ss-takeaways li{
  margin:0 0 8px;
  padding:0;
  font:400 15px/1.5 Poppins,sans-serif;
  color:#222;
}
.ss-takeaways li:last-child{margin-bottom:0}
.ss-takeaways li strong{
  font-weight:600;
  color:#111;
}

/* Quote box — stamped card: dotted navy, hard offset, coral mark */
.elementor-10348 .elementor-widget-theme-post-content blockquote,
.single-toptools .elementor-widget-theme-post-content blockquote{
  position:relative;
  margin:1.8em 14px 1.8em 6px !important;
  padding:26px 20px 18px 20px !important;
  background:#fff !important;
  border:1.5px dashed #0F3766 !important;
  border-left:1.5px dashed #0F3766 !important;
  border-radius:10px !important;
  box-shadow:6px 6px 0 #0F3766 !important;
  overflow:visible !important;
  box-sizing:border-box;
}
.elementor-10348 .elementor-widget-theme-post-content blockquote:before,
.single-toptools .elementor-widget-theme-post-content blockquote:before{
  content:"\201C";
  position:absolute;
  top:6px;
  left:14px;
  font:700 34px/1 Georgia,"Times New Roman",serif;
  color:#FF6644;
  pointer-events:none;
  letter-spacing:0;
}
.elementor-10348 .elementor-widget-theme-post-content blockquote:after,
.single-toptools .elementor-widget-theme-post-content blockquote:after{
  content:none !important;
  display:none !important;
}
.elementor-10348 .elementor-widget-theme-post-content blockquote p,
.single-toptools .elementor-widget-theme-post-content blockquote p{
  margin:0 !important;
  padding:16px 2px 0 !important;
  font:400 18.5px/1.55 Poppins,Nunito Sans,sans-serif !important;
  color:#0F3766 !important;
  font-style:normal !important;
}
.elementor-10348 .elementor-widget-theme-post-content blockquote p:first-child{
  padding-top:16px !important;
}
.elementor-10348 .elementor-widget-theme-post-content blockquote cite,
.single-toptools .elementor-widget-theme-post-content blockquote cite{
  display:block;
  margin-top:10px;
  font:600 12px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  font-style:normal !important;
}

/* Article tables — body-adjacent type, more cell air */
.elementor-10348 .elementor-widget-theme-post-content{
  max-width:100%;
  min-width:0;
  overflow-x:clip;
}
.elementor-10348 .elementor-widget-theme-post-content table{
  width:100%;
  max-width:100%;
  display:block;
  border-collapse:separate;
  border-spacing:0;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  border-radius:12px;
  font-family:Poppins,Nunito Sans,sans-serif;
  font-size:16px;
  line-height:1.55;
  margin:1.3em 0 1.7em;
  box-shadow:0 0 0 1px #E6EBEF, 0 10px 28px rgba(15,55,102,.12);
  background:#fff;
}
/* display:block on table is the scrollport. Force the inner table to fill the card
   so 2-col SKU tables do not shrink (Netskope). Wide tables still overflow-x:auto
   inside this box; the page must not shift sideways. */
.elementor-10348 .elementor-widget-theme-post-content table thead,
.elementor-10348 .elementor-widget-theme-post-content table tbody,
.elementor-10348 .elementor-widget-theme-post-content table tfoot{
  display:table;
  width:100%;
  min-width:100%;
  table-layout:auto;
}
.elementor-10348 .elementor-widget-theme-post-content table tr{
  width:100%;
}
@media (max-width:767px){
  body.single-toptools,
  body.author{
    overflow-x:hidden;
  }
  .elementor-10348,
  .elementor-10348 .elementor-section,
  .elementor-10348 .elementor-container,
  .elementor-10348 .elementor-widget-theme-post-content{
    max-width:100%;
    overflow-x:clip;
  }
  .elementor-10348 .elementor-widget-theme-post-content img{
    max-width:100%;
    height:auto;
  }
}
.elementor-10348 .elementor-widget-theme-post-content table th{
  background:#0F3766;
  color:#fff;
  font-weight:600;
  font-size:13px;
  letter-spacing:.02em;
  text-transform:none;
  text-align:left;
  padding:13px 18px;
  border:0;
}
.elementor-10348 .elementor-widget-theme-post-content table td{
  padding:16px 18px;
  border:0;
  border-bottom:1px solid #E6EBEF;
  background:#fff;
  color:#1a2a3a;
  font-weight:400;
  vertical-align:top;
}
.elementor-10348 .elementor-widget-theme-post-content table tbody tr:nth-child(even) td{
  background:#F7F9FA;
}
.elementor-10348 .elementor-widget-theme-post-content table tbody tr:last-child td{
  border-bottom:0;
}
.elementor-10348 .elementor-widget-theme-post-content table td:first-child{
  font-weight:600;
  color:#111;
  white-space:nowrap;
}

/* In-article images — thin frame + light shadow */
.elementor-10348 .elementor-widget-theme-post-content img{
  border-radius:10px;
  box-shadow:0 0 0 1px #E6EBEF, 0 6px 18px rgba(15,55,102,.08);
}

/* Related / More articles — stamped cards as a 3-across deck.
   No stack peek (:before/:after) — the hard navy offset is the deck language.
   Shared gray tray + vertical dividers removed. */
.elementor-10348 .elementor-element-21c647f6 .elementor-heading-title,
.elementor-10348 .related-blog-posts .elementor-heading-title{
  font:700 22px/1.2 Poppins,sans-serif !important;
  color:#0F3766 !important;
  letter-spacing:-.02em;
}
.elementor-10348 .elementor-element-21c647f6 > .elementor-widget-container{
  margin:0 0 14px !important;
}
.elementor-10348 .elementor-element-342b3570 > .elementor-widget-container{
  margin:0 0 8px !important;
  padding:0 8px 12px 0 !important;
  overflow:visible !important;
}
.elementor-10348 .elementor-element-6ea8109e,
.elementor-10348 .elementor-element-783ca33a{
  display:none !important;
}

/* Break the shared gray tray */
.elementor-10348 .elementor-element-342b3570,
.elementor-10348 .related-p{
  background:transparent !important;
  border-radius:0 !important;
  padding:4px 10px 16px 2px !important;
  overflow:visible !important;
}

/* Parents often clip hard offset shadows — keep this section open */
.elementor-10348 .elementor-element-1002b711,
.elementor-10348 .elementor-element-1002b711 > .elementor-container,
.elementor-10348 .elementor-element-144a580c,
.elementor-10348 .elementor-element-144a580c > .elementor-widget-wrap,
.elementor-10348 .elementor-element-342b3570,
.elementor-10348 .related-p,
.elementor-10348 .related-p .elementor-widget-container,
.elementor-10348 .elementor-element-342b3570 .elementor-widget-container,
.elementor-10348 .related-p .elementor-posts-container,
.elementor-10348 .elementor-element-342b3570 .elementor-posts-container,
.elementor-10348 .related-p .elementor-post,
.elementor-10348 .elementor-element-342b3570 .elementor-post{
  overflow:visible !important;
}

.elementor-10348 .related-p .elementor-posts-container.elementor-grid,
.elementor-10348 .elementor-element-342b3570 .elementor-posts-container.elementor-grid{
  display:flex !important;
  gap:20px !important;
  overflow:visible !important;
}
.elementor-10348 .related-p .elementor-post,
.elementor-10348 .elementor-element-342b3570 .elementor-post{
  flex:1 1 0;
  min-width:0;
}

.elementor-10348 .related-p .elementor-post__card,
.elementor-10348 .elementor-element-342b3570 .elementor-post__card{
  position:relative;
  z-index:1;
  box-sizing:border-box;
  background:#fff !important;
  border:1.5px dashed #0F3766 !important;
  border-radius:10px !important;
  box-shadow:4px 4px 0 #0F3766 !important;
  padding:12px 12px 14px !important;
  overflow:visible !important;
  transform:none;
  transition:transform .15s ease, box-shadow .15s ease;
}
.elementor-10348 .related-p .elementor-post__card:hover,
.elementor-10348 .elementor-element-342b3570 .elementor-post__card:hover{
  transform:translate(-2px,-2px) !important;
  box-shadow:6px 6px 0 #0F3766 !important;
  color:inherit !important;
  z-index:2;
}
.elementor-10348 .related-p .elementor-post__thumbnail,
.elementor-10348 .elementor-element-342b3570 .elementor-post__thumbnail{
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 0 0 1px #E6EBEF;
}
.elementor-10348 .related-p .elementor-post__thumbnail img,
.elementor-10348 .elementor-element-342b3570 .elementor-post__thumbnail img{
  border-radius:10px;
}
.elementor-10348 .related-p .elementor-post__text,
.elementor-10348 .elementor-element-342b3570 .elementor-post__text{
  margin-top:10px !important;
}
.elementor-10348 .related-p .elementor-post__text:before,
.elementor-10348 .elementor-element-342b3570 .elementor-post__text:before{
  content:"Top Tools";
  display:inline-block;
  background:#FF6644;
  color:#fff;
  font:600 10px/1 Poppins,sans-serif;
  letter-spacing:.03em;
  padding:5px 10px;
  border-radius:999px;
  margin:0 0 10px;
}
.elementor-10348 .related-p .elementor-post__title,
.elementor-10348 .related-p .elementor-post__title a,
.elementor-10348 .elementor-element-342b3570 .elementor-post__title,
.elementor-10348 .elementor-element-342b3570 .elementor-post__title a{
  font:600 15px/1.3 Poppins,sans-serif !important;
  color:#111 !important;
  margin:0 0 4px !important;
}
.elementor-10348 .related-p .elementor-post__title a:hover,
.elementor-10348 .elementor-element-342b3570 .elementor-post__title a:hover{
  color:#FF6644 !important;
}
.elementor-10348 .related-p .elementor-post__meta-data,
.elementor-10348 .elementor-element-342b3570 .elementor-post__meta-data{
  font:400 12px/1.3 Poppins,sans-serif !important;
  color:#5B6B80 !important;
}
@media (max-width:767px){
  .elementor-10348 .related-p .elementor-posts-container.elementor-grid,
  .elementor-10348 .elementor-element-342b3570 .elementor-posts-container.elementor-grid{
    display:flex !important;
    flex-direction:column !important;
    gap:16px !important;
  }
  .elementor-10348 .elementor-element-342b3570,
  .elementor-10348 .related-p{
    padding:4px 8px 18px 2px !important;
  }
  .elementor-10348 .elementor-element-1002b711,
  .elementor-10348 .elementor-element-1002b711 > .elementor-container,
  .elementor-10348 .elementor-element-144a580c,
  .elementor-10348 .elementor-element-144a580c > .elementor-widget-wrap,
  .elementor-10348 .elementor-element-342b3570,
  .elementor-10348 .related-p{
    overflow:visible !important;
    overflow-x:visible !important;
  }
}

/* Author archive */
body.author .site-main{
  max-width:1120px;
  margin:0 auto;
  padding:28px 20px 72px;
  font-family:Poppins,Nunito Sans,sans-serif;
  color:#111;
}
body.author .page-header{display:none !important}
body.author .page-content{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:22px;
  background:#F7F9FA;
  border-radius:16px;
  padding:18px;
}
body.author .ss-author-profile{
  grid-column:1 / -1;
  display:flex;
  gap:22px;
  align-items:center;
  background:#fff;
  border-radius:14px;
  padding:22px 24px;
  box-shadow:0 0 0 1px #E6EBEF;
}
body.author .ss-author-avatar-wrap{
  flex:0 0 96px;
}
body.author .ss-author-avatar,
body.author .ss-author-avatar-wrap img{
  width:96px;
  height:96px;
  border-radius:50%;
  object-fit:cover;
  background:#fff;
  box-shadow:0 0 0 1px #E6EBEF, 0 6px 18px rgba(15,55,102,.08);
}
body.author .ss-author-kicker{
  margin:0 0 4px;
  font:600 12px/1.2 Poppins,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:#FF6644;
}
body.author .ss-author-name,
body.author h1.ss-author-name{
  margin:0 0 8px;
  font:700 32px/1.15 Poppins,sans-serif;
  letter-spacing:-.02em;
  color:#111;
}
body.author .ss-author-bio{
  margin:0 0 12px;
  max-width:62ch;
  font:400 15px/1.55 Poppins,sans-serif;
  color:#5B6B80;
  white-space:pre-line;
}
body.author .ss-author-links{
  display:flex;
  flex-wrap:wrap;
  gap:10px 16px;
  margin:0;
}
body.author .ss-author-link{
  color:#FF6644;
  font:600 14px/1.2 Poppins,sans-serif;
  text-decoration:none;
}
body.author .ss-author-link:hover{color:#0F3766}
body.author .ss-author-grid-title{
  grid-column:1 / -1;
  margin:6px 4px 0;
  font:700 22px/1.2 Poppins,sans-serif;
  letter-spacing:-.02em;
  color:#111;
}
body.author article.post,
body.author article.ss-author-card{
  display:flex;
  flex-direction:column;
  background:#fff;
  border-radius:14px;
  padding:12px 12px 16px;
  box-shadow:0 0 0 1px #E6EBEF;
  min-width:0;
}
body.author article.post .entry-title,
body.author article.ss-author-card .entry-title{
  order:2;
  margin:12px 4px 4px;
  font:600 18px/1.3 Poppins,sans-serif;
  color:#111;
}
body.author article.post .entry-title a,
body.author article.ss-author-card .entry-title a{
  color:#111;
  text-decoration:none;
}
body.author article.post .entry-title a:hover,
body.author article.ss-author-card .entry-title a:hover{color:#FF6644}
body.author article.post > a,
body.author article.ss-author-card > a,
body.author .ss-author-thumb-link{
  order:1;
  display:block;
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 0 0 1px #E6EBEF;
  aspect-ratio:16/10;
  background:#F7F9FA;
}
body.author article.post > a img,
body.author article.ss-author-card > a img,
body.author .ss-author-thumb{
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:10px;
  display:block;
}
body.author article.post .entry-excerpt,
body.author article.post > p,
body.author article.ss-author-card > p{
  order:3;
  margin:0 4px;
}
body.author .ss-author-date{
  order:4;
  display:block;
  margin:4px 4px 0;
  font:400 13px/1.3 Poppins,sans-serif;
  color:#5B6B80;
}
body.author .page-content > nav.pagination,
body.author nav.pagination{
  grid-column:1 / -1;
  margin:8px 4px 0;
}
body.author nav.pagination a,
body.author nav.pagination span{
  color:#FF6644;
  font:600 14px/1.2 Poppins,sans-serif;
}
@media (max-width:767px){
  body.author .page-content{grid-template-columns:1fr; padding:12px}
  body.author .ss-author-profile{flex-direction:column; align-items:flex-start; gap:14px}
  body.author .ss-author-name, body.author h1.ss-author-name{font-size:26px}
}

/* Mobile: hide TOC; Get listed in the top bar */
@media (max-width:767px){
  .ss-toc{display:none !important}
  .top-n-bar{
    display:flex !important;
    align-items:center;
    justify-content:flex-start;
    gap:10px;
    padding:8px 12px !important;
    box-sizing:border-box;
  }
  .top-n-bar .site-m-logo{
    flex:1 1 auto;
    min-width:0;
    max-width:calc(100% - 168px);
  }
  .top-n-bar .site-m-logo img{max-width:100%; height:auto}
  a.ss-m-listed,
  .top-n-bar a.ss-m-listed{
    display:inline-flex !important;
    align-items:center !important;
    justify-content:center !important;
    margin-left:auto !important;
    margin-right:8px !important;
    background:#FF6644 !important;
    color:#fff !important;
    font:600 12px/1.25 Poppins,sans-serif !important;
    padding:8px 14px !important;
    width:auto !important;
    min-width:max-content !important;
    max-width:none !important;
    height:auto !important;
    min-height:0 !important;
    box-sizing:border-box !important;
    border-radius:999px !important;
    text-decoration:none !important;
    white-space:nowrap !important;
    overflow:visible !important;
    flex:0 0 auto !important;
    flex-shrink:0 !important;
    position:static !important;
    z-index:1;
    letter-spacing:0 !important;
    text-indent:0 !important;
    line-height:1.25 !important;
  }
  .top-n-bar .icon.mob-c-ico,
  .top-n-bar a.icon.mob-c-ico,
  .top-n-bar .mob-c-ico{
    position:static !important;
    right:auto !important;
    top:auto !important;
    left:auto !important;
    bottom:auto !important;
    transform:none !important;
    margin:0 !important;
    width:36px !important;
    height:36px !important;
    min-width:36px !important;
    min-height:36px !important;
    display:inline-flex !important;
    align-items:center;
    justify-content:center;
    flex:0 0 36px;
    z-index:2;
    border-radius:0 !important;
    -webkit-border-radius:0 !important;
    background:#F2F2F2 !important;
    box-shadow:none !important;
    overflow:hidden;
  }
  .top-n-bar .icon.mob-c-ico:before,
  .top-n-bar .icon.mob-c-ico:after,
  .top-n-bar .icon.mob-c-ico *,
  .top-n-bar .mob-c-ico:before,
  .top-n-bar .mob-c-ico:after,
  .top-n-bar .mob-c-ico *{
    border-radius:0 !important;
    -webkit-border-radius:0 !important;
  }
}
@media (min-width:768px){
  a.ss-m-listed{display:none !important}
}

/* Title stack — global on toptools singles + any listicle using template 10348.
   Approved on post 50624; postid gate removed. Widget IDs are template-level. */

/* Breadcrumbs: Home › Top Tools — hide the last crumb (repeats the H1) */
body.single-toptools #breadcrumbs,
.elementor-10348 #breadcrumbs,
body.single-toptools .elementor-widget-breadcrumbs,
.elementor-10348 .elementor-widget-breadcrumbs{
  font:500 12px/1.4 Poppins,sans-serif !important;
  color:#5B6B80 !important;
  margin:0 !important;
  padding:0 !important;
}
body.single-toptools #breadcrumbs > span,
.elementor-10348 #breadcrumbs > span{
  font-size:0 !important; /* swallow Yoast » text nodes */
  color:#5B6B80 !important;
}
body.single-toptools #breadcrumbs > span > span,
.elementor-10348 #breadcrumbs > span > span{
  font:500 12px/1.4 Poppins,sans-serif !important;
  color:#5B6B80 !important;
}
body.single-toptools #breadcrumbs a,
.elementor-10348 #breadcrumbs a{
  color:#FF6644 !important;
  text-decoration:none !important;
  font:500 12px/1.4 Poppins,sans-serif !important;
}
body.single-toptools #breadcrumbs .breadcrumb_last,
.elementor-10348 #breadcrumbs .breadcrumb_last{
  display:none !important;
}
body.single-toptools #breadcrumbs > span > span:first-of-type:after,
.elementor-10348 #breadcrumbs > span > span:first-of-type:after{
  content:" \203A\00a0";
  color:#5B6B80;
  font:500 12px/1.4 Poppins,sans-serif;
}

/* Same column: crumbs → H1 → date → byline. Later widgets keep source order. */
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-widget,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-widget{
  order:10;
}
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-2fba97a8,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-2fba97a8{
  order:1;
  display:block !important; /* Get Listed card — abs-positioned left; keep in-flow height 0 */
  height:0 !important;
  min-height:0 !important;
  margin:0 !important;
  padding:0 !important;
  overflow:visible !important;
}
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-7969312b,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-7969312b{order:2} /* H1 */
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-36e0696e,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-36e0696e{order:3} /* date */
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-a8f3c1e2,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-a8f3c1e2{order:4} /* byline */
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-29dc04b,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-29dc04b{order:0} /* crumbs moved above H1 */
body.single-toptools .elementor-element-5b248346,
.elementor-10348 .elementor-element-5b248346{display:none !important} /* 10px spacer */

/* Crumbs live in section 5e82f26 / col 1260d8c; H1 is the next row (776be41d / 69a6e7c7).
   Collapse extras; keep crumb-to-H1 ~10px. */
body.single-toptools .elementor-element-29dc04b,
body.single-toptools .elementor-element-29dc04b > .elementor-widget-container,
.elementor-10348 .elementor-element-29dc04b,
.elementor-10348 .elementor-element-29dc04b > .elementor-widget-container{
  margin:0 !important;
  padding:0 !important;
}

/* Hide crumbs in the left column on first paint; JS moves them onto the H1 */
.elementor-element-5e82f26 #breadcrumbs,
.elementor-element-1260d8c #breadcrumbs,
.elementor-element-5e82f26 .elementor-element-29dc04b{
  visibility:hidden !important;
  height:0 !important;
  max-height:0 !important;
  overflow:hidden !important;
  margin:0 !important;
  padding:0 !important;
}
.elementor-element-69a6e7c7 #breadcrumbs,
.elementor-element-69a6e7c7 .elementor-element-29dc04b{
  visibility:visible !important;
  height:auto !important;
  max-height:none !important;
  overflow:visible !important;
}

/* Do NOT hide section 5e82f26 — it holds the left Get Listed card.
   Crumbs are moved out by JS; only collapse leftover crumb-row padding. */
body.single-toptools .elementor-element-5e82f26 > .elementor-container,
body.single-toptools .elementor-element-1260d8c > .elementor-widget-wrap,
.elementor-10348 .elementor-element-5e82f26 > .elementor-container,
.elementor-10348 .elementor-element-1260d8c > .elementor-widget-wrap{
  padding-bottom:0 !important;
}
body.single-toptools .elementor-element-776be41d,
body.single-toptools .elementor-element-776be41d > .elementor-container,
body.single-toptools .elementor-element-69a6e7c7,
body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap,
.elementor-10348 .elementor-element-776be41d,
.elementor-10348 .elementor-element-776be41d > .elementor-container,
.elementor-10348 .elementor-element-69a6e7c7,
.elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap{
  padding-top:0 !important;
  margin-top:0 !important;
}
body.single-toptools .elementor-element-2fba97a8,
.elementor-10348 .elementor-element-2fba97a8{
  margin:0 !important;
  padding:0 !important;
  min-height:0 !important;
  height:0 !important;
  overflow:visible !important;
}
/* Left Get Listed card (2fba97a8 / .author-area, left:-280px).
   Desktop ≥1180 has a real left gutter (~x=13, 255px). Below that the
   height:0 + overflow:visible unhide paints the card on the title stack
   (shortcode also forces .author-area {position:relative;left:0} at ≤768).
   Header pill a.ss-m-listed is NOT this card — leave it alone. */
@media (max-width:1179px){
  body.single-toptools .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-2fba97a8,
  .elementor-10348 .elementor-element-69a6e7c7 > .elementor-widget-wrap > .elementor-element-2fba97a8,
  body.single-toptools .elementor-element-2fba97a8,
  .elementor-10348 .elementor-element-2fba97a8,
  body.single-toptools .elementor-element-2fba97a8 .elementor-widget-container,
  body.single-toptools .elementor-element-2fba97a8 .elementor-shortcode,
  body.single-toptools .elementor-element-2fba97a8 .autor-content,
  body.single-toptools .elementor-element-2fba97a8 .author-area,
  body.single-toptools .elementor-element-2fba97a8 .auth-content,
  body.single-toptools .elementor-element-2fba97a8 .auth-img,
  body.single-toptools .elementor-element-2fba97a8 .list-c-btn,
