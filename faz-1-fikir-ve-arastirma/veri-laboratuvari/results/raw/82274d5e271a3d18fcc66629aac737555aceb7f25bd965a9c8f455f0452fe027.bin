  margin:0 0 .7em;
}
.elementor-10348 .elementor-widget-theme-post-content li:last-child{margin-bottom:0}
.elementor-10348 .elementor-widget-theme-post-content h2{
  font-family:Poppins,sans-serif !important;
  font-weight:600;
  font-size:1.5rem;
