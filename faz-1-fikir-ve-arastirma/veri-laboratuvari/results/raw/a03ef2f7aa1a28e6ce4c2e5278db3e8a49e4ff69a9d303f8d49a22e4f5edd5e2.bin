            tw-col-span-12 lg:tw-col-span-10 lg:tw-col-start-2"><div class="rich-text-block-text md:tw-w-[50%]"><div class="rich-text-spacing   theme-text"><h4>Hello, Yoshi!</h4><p>Are you ready to play? With this free application, you and your child can play with Yoshi&#x27;s face and delight in all his various expressions.</p><table><tbody><tr><td><p><a href="https://apps.apple.com/au/app/hello-yoshi/id6752240613" class="" target="_blank" rel="norefferer noopener nofollow"><picture><img alt="Apple App Store" loading="lazy" width="200" height="59" decoding="async" data-nimg="1" class="tw-bg-center tw-bg-no-repeat tw-w-auto tw-mx-auto" style="color:transparent;width:200px;background-image:url(https://assets.nintendo.com.au/image/private/f_auto/q_auto/c_limit,e_blur:100,f_auto,q_auto,w_16/v1730433650/ginq3co8zn6ti4621vzj);background-size:cover" src="https://assets.nintendo.com.au/image/private/f_auto/q_auto/v1730433650/ginq3co8zn6ti4621vzj"/></picture></a></p></td><td><p><a href="https://play.google.com/store/apps/details?id=com.nintendo.zaya" class="" target="_blank" rel="norefferer noopener nofollow"><picture><img alt="Google Play Store" loading="lazy" width="200" height="60" decoding="async" data-nimg="1" class="tw-bg-center tw-bg-no-repeat tw-w-auto tw-mx-auto" style="color:transparent;width:200px;background-image:url(https://assets.nintendo.com.au/image/private/f_auto/q_auto/c_limit,e_blur:100,f_auto,q_auto,w_16/v1730433620/wwzqah3xkxkhccpmrynv);background-size:cover" src="https://assets.nintendo.com.au/image/private/f_auto/q_auto/v1730433620/wwzqah3xkxkhccpmrynv"/></picture></a></p></td></tr></tbody></table><p></p></div></div><div class="rich-text-block-img md:tw-w-[50%]"><div class="aspect-ratio-box no-ratio "><figure><picture><img alt="Apps - Hello, Yoshi! Banner" loading="lazy" width="720" height="405" decoding="async" data-nimg="1" class="tw-bg-center tw-bg-no-repeat tw-w-full" style="color:transparent;background-image:url(https://assets.nintendo.com.au/image/private/f_auto/q_auto/c_limit,e_blur:100,f_auto,q_auto,w_16/v1776044762/jajhvdjgky1k4kfkhajt);background-size:cover" src="https://assets.nintendo.com.au/image/private/f_auto/q_auto/c_scale,dpr_1.5,w_720/v1776044762/jajhvdjgky1k4kfkhajt"/></picture></figure></div></div></div></div></div></section></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
