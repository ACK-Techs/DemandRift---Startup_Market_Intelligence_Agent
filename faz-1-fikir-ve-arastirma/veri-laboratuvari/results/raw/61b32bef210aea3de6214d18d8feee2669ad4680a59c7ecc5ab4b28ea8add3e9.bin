-tables-section .price-table-category-non-clickable .price-table-category-inner .button-nice {        padding: 0.6770833333vw 1.25vw;        font-size: 0.8333333333vw;        border: none;    }    .price-tables-section .price-table-category.packages .price-table-column:first-child .price-table-head {        border-top-left-radius: 1.0416666667vw;    }    .price-tables-section .price-table-category.packages .price-table-column:first-child .price-table-line:last-child {        border-bottom-left-radius: 1.0416666667vw;    }    .price-tables-section .price-table-category.packages .price-table .price-table-head.last .price {        font-size: 1.5625vw;    }    .price-tables-section .price-table-category.packages .price-table .notes p {        font-size: 0.9375vw;    }    .price-tables-section .price-table-category.packages .price-table-line .tooltip-text {        padding: 0.2604166667vw;        font-size: 0.625vw;    }    .price-tables-section .price-table-category.packages .price-table-line p.title {        font-size: 1.0416666667vw;    }    .price-tables-section .price-table-category.packages .price-table-line .price-text-wrap p {        font-size: 0.8333333333vw;        margin-right: 0.2604166667vw;    }    .price-tables-section .price-table-category .price-table-category-inner,    .price-tables-section .price-table-category-non-clickable .price-table-category-inner {        margin-top: 3.6458333333vw;        border-radius: 1.0416666667vw;        border: 0.2604166667vw solid #f7f7f7;        padding: 1.3020833333vw 2.34375vw;    }    .price-tables-section .price-table-category .text-wrap p.sm,    .price-tables-section .price-table-category-non-clickable .text-wrap p.sm {        font-size: 0.9375vw;    }    .price-tables-section .price-table-category.first,    .price-tables-section .price-table-category-non-clickable.first {        margin-top: 1.5625vw;    }    .price-tables-section .price-table-category-inner p,    .price-tables-section .price-table-category-non-clickable-inner p {        font-size: 1.25vw;    }    .price-tables-section .price-table-category-inner .btn-wrap:after,    .price-tables-section .price-table-category-non-clickable-inner .btn-wrap:after {        width: 2.9166666667vw;        height: 2.9166666667vw;    }    .price-tables-section .price-table-category-inner img,    .price-tables-section .price-table-category-non-clickable-inner img {        max-width: 2.9166666667vw;    }    .price-tables-section .price-table-category.opened .price-table .price-table-head,    .price-tables-section .price-table-category-non-clickable.opened .price-table .price-table-head {        top: 7vw;    }    .price-tables-section .price-table-left .price-table-line {        font-size: 1.0416666667vw;    }    .price-tables-section .price-table-head h3 {        font-size: 0.8333333333vw;    }    .price-tables-section .price-table-head .price {        margin-top: 0.78125vw;        margin-bottom: 0.5208333333vw;        font-size: 1.875vw;    }    .price-tables-section .price-table-head p {        font-size: 0.625vw;    }    .price-tables-section .price-table-head.last .price {        font-size: 1.1458333333vw;    }    .price-tables-section .price-table-line {        padding: 1.3020833333vw 0.625vw;        height: 4.6875vw;    }    .price-tables-section .price-table-line img {        max-width: 1.8229166667vw;    }    .price-tables-section .price-table-line.prehead {        height: 6.25vw;    }    .price-tables-section .price-table-line.prehead .price {        margin-top: 0.78125vw;        margin-bottom: 0.5208333333vw;        font-size: 1.6666666667vw;    }    .price-tables-section .price-table-line.prehead p {        font-size: 0.625vw;    }    .text-section {        border-radius: 0.8333333333vw;        margin: 0.5208333333vw;        padding-top: 6.7708333333vw;        padding-bottom: 5.7291666667vw;    }    .text-section h2 {        font-size: 2.1875vw;    }    .text-section h2 + p {        font-size: 1.0416666667vw;        margin: 1.