n: 1ms;        animation-duration: 1ms;        -webkit-animation-iteration-count: 1;        animation-iteration-count: 1;        -webkit-transition-delay: 0s;        transition-delay: 0s;        -webkit-transition-duration: 0s;        transition-duration: 0s;    }}@media (--medium-small-viewport) {    .glightbox-container .ginner-container {        width: auto;        height: auto;        -webkit-box-orient: horizontal;        -webkit-box-direction: normal;        -ms-flex-direction: row;        flex-direction: row;    }    .glightbox-container .ginner-container.desc-top .gslide-description {        -webkit-box-ordinal-group: 1;        -ms-flex-order: 0;        order: 0;    }    .glightbox-container .ginner-container.desc-top .gslide-image,    .glightbox-container .ginner-container.desc-top .gslide-image img {        -webkit-box-ordinal-group: 2;        -ms-flex-order: 1;        order: 1;    }    .glightbox-container .ginner-container.desc-left .gslide-description {        -webkit-box-ordinal-group: 1;        -ms-flex-order: 0;        order: 0;    }    .glightbox-container .ginner-container.desc-left .gslide-image {        -webkit-box-ordinal-group: 2;        -ms-flex-order: 1;        order: 1;    }    .gslide-image img {        max-height: 97vh;        max-width: 100%;    }    .gslide-image img.zoomable {        cursor: -webkit-zoom-in;        cursor: zoom-in;    }    .zoomed .gslide-image img.zoomable {        cursor: -webkit-grab;        cursor: grab;    }    .gslide-inline {        max-height: 95vh;    }    .gslide-external {        max-height: 100vh;    }    .gslide-description.description-left,    .gslide-description.description-right {        max-width: 275px;    }    .glightbox-open {        height: auto;    }    .goverlay {        background: rgba(0, 0, 0, 0.92);    }    .glightbox-clean .gslide-media {        -webkit-box-shadow: 1px 2px 9px 0px rgba(0, 0, 0, 0.65);        box-shadow: 1px 2px 9px 0px rgba(0, 0, 0, 0.65);    }    .glightbox-clean .description-left .gdesc-inner,    .glightbox-clean .description-right .gdesc-inner {        position: absolute;        height: 100%;        overflow-y: auto;    }    .glightbox-clean .gprev,    .glightbox-clean .gnext,    .glightbox-clean .gclose {        background-color: rgba(0, 0, 0, 0.32);    }    .glightbox-clean .gprev:hover,    .glightbox-clean .gnext:hover,    .glightbox-clean .gclose:hover {        background-color: rgba(0, 0, 0, 0.7);    }    .glightbox-clean .gprev {        top: 45%;    }    .glightbox-clean .gnext {        top: 45%;    }}@media screen and (max-height: 420px) {    .goverlay {        background: #000;    }}@media (--medium-viewport) {    .glightbox-clean .gclose {        opacity: 0.7;        right: 20px;    }}@media (-ms-high-contrast: active), (-ms-high-contrast: none) {    footer .footer__content .footer__content__text .footer__content__text__left \u003e a:after {        content: \"\u003e\";        font-family: Arial;        font-size: 24px;        font-weight: 500;    }    footer .footer__content .footer__content__text .footer__content__text__left \u003e a:hover:before body:not(.public-safety) {        width: 200%;    }}@media (hover) {    footer .footer__content .footer__content__text .footer__content__text__left \u003e a:hover {        color: #fff !important;        background-color: #333;    }    footer .footer__content .footer__content__text .footer__content__text__left \u003e a:hover body:not(.public-safety) {        padding-left: 42.75px;        padding-right: 29.75px;    }    /*footer .footer__content .footer__content__text .footer__content__text__left\u003ea:hover:after{content:\"\\f061\"}*/    footer .footer__content .footer__content__text .footer__content__text__left \u003e a:hover:before {        width: 200%;    }}.pricing-container .button-nice.button-play.button-black:not(.button-arrow),.pricing-container .button-nice.button-play.button-white:not(.button-arrow),.pricing-container .button-nice.button-download.button-black:not(.button-arrow),.pricing-container .button-nice.button-download.button-blue:not(.button-arrow) {  padding-left: 44px !important;  padding-right: 20px !important;}.pricing-container .price-table-category-non-clickable .price-table-category-inner .btn-wrap.button-nice.button-play.button-white {  padding-left: 20px !important;  padding-right: 20px !important;}@media (min-width: 1025px) {  .pricing-container .button-nice.button-play.button-black:not(.button-arrow),  .pricing-container .button-nice.button-play.button-white:not(.button-arrow),  .pricing-container .button-nice.button-download.button-black:not(.button-arrow),  .pricing-container .button-nice.button-download.button-blue:not(.button-arrow) {    padding-left: 44px !important;    padding-right: 20px !important;  }  .pricing-container .price-table-category-non-clickable .price-table-category-inner .btn-wrap.button-nice.button-play.button-white {    padding-left: 20px !important;    padding-right: 20px !important;  }}.pricing-container .button-nice.button-arrow.button-download {  padding-left: 20px !important;  padding-right: 44px !important;}@media (min-width: 1025px) {  .pricing-container .button-nice.button-arrow.button-download {    padding-left: 20px !important;    padding-right: 44px !important;  }}.pricing-container .button-nice.button-play:not(.button-arrow):before,.pricing-container .button-nice.button-play:not(.button-arrow):after,.pricing-container .button-nice.button-download:not(.button-arrow):before,.pricing-container .button-nice.button-download:not(.button-arrow):after {  position: absolute !important;  left: 3px !important;  top: 50%;  transform: translateY(-50%);  margin: 0 !important;  outline: none;  border: 1px solid transparent;}.pricing-container .button-nice.button-arrow:before,.pricing-container .button-nice.button-arrow:after {  position: absolute !important;  right: 3px !important;  left: auto !important;  top: 50%;  transform: translateY(-50%);  margin: 0 !important;  outline: none;  border: 1px solid transparent;}.pricing-container .button-nice.button-play:before,.pricing-container .button-nice.button-download:before {  opacity: 0 !important;}.pricing-container .button-nice.button-play:after,.pricing-container .button-nice.button-download:after {  opacity: 1 !important;}.pricing-container .button-nice.button-play:hover:before,.pricing-container .button-nice.button-download:hover:before {  opacity: 1 !important;}.pricing-container .button-nice.button-play:hover:after,.pricing-container .button-nice.button-download:hover:after {  opacity: 0 !important;}.pricing-container .button-nice.button-arrow:before {  opacity: 0 !important;}.pricing-container .button-nice.button-arrow:after {  opacity: 1 !important;}.pricing-container .button-nice.button-arrow:hover:before {  opacity: 1 !important;}.pricing-container .button-nice.button-arrow:hover:after {  opacity: 0 !important;}\u003c/style\u003e\u003cscript src=\"/pricing-assets/js/main.js\" defer=\"\"\u003e\u003c/script\u003e\u003cdiv class=\"pricing-container\"\u003e    \u003csection class=\"hero\" id=\"hero\"\u003e        \u003cimg class=\"bg-img\" src=\"/pricing-assets/img/hero-bg-1.1.png\" alt=\"\"\u003e                \u003cdiv class=\"container\"\u003e            \u003cdiv class=\"title-block\"\u003e                \u003c!-- \u003ch2 class=\"pretitle\"\u003ePricing\u003c/h2\u003e --\u003e                \u003ch1\u003eFind the Right \u003cbr\u003ePackage for You\u003c/h1\u003e                \u003cp\u003eOur flexible packages allow you to customize NiCE CXone pricing to your unique business needs. Get everything you need to delight customers and scale operations with our all-in-one CCaaS platform.\u003c/p\u003e                \u003cdiv class=\"btn-wrap\"\u003e                    \u003ca href=\"#price-tables-section\" class=\"button-nice button-play button-black\"\u003eView Pricing\u003c/a\u003e                    \u003ca href=\"https://www.nice.com/get-quote\" class=\"button-nice button-play button-white\" target=\"_blank\"\u003eRequest a quote\u003c/a\u003e                \u003c/div\u003e            \u003c/div\u003e            \u003cdiv class=\"img-block\"\u003e                \u003cimg src=\"/pricing-assets/img/header-img.png\" alt=\"\"\u003e            \u003c/div\u003e        \u003c/div\u003e    \u003c/section\u003e    \u003cdiv class=\"price-tables-section\" id=\"price-tables-section\"\u003e        \u003cdiv class=\"container\"\u003e            \u003cdiv class=\"title-block\"\u003e                \u003ch2\u003eFlexible pricing and scalable capabilities \u003cbr\u003efor unique business needs\u003c/h2\u003e                \u003cp\u003eNiCE offers the most customer-friendly pricing in the market—monthly billing in arrears, no prepay, no \u003cbr\u003esurprise charges. Our usage-based, tiered model lowers costs as your business grows.\u003c/p\u003e                \u003cdiv class=\"btn-wrap\"\u003e                    \u003ca href=\"#price-table-first\" class=\"button-nice button-arrow button-download button-black\"\u003eCore Packages\u003c/a\u003e                    \u003ca href=\"#packages\" class=\"button-nice button-arrow button-download button-blue\"\u003eIndustry Packages\u003c/a\u003e                \u003c/div\u003e            \u003c/div\u003e            \u003cdiv class=\"price-table-title-row\" id=\"price-table-first\"\u003e                \u003cdiv class=\"price-table-title\"\u003e                    \u003cimg src=\"/pricing-assets/img/price-tables/check-icon-purple-new.svg\" alt=\"\"\u003e                    \u003cp\u003eIncluded\u003c/p\u003e                \u003c/div\u003e                \u003cdiv class=\"price-table-title\"\u003e                    \u003cimg src=\"/pricing-assets/img/price-tables/plus-icon-light-blue.svg\" alt=\"\"\u003e                    \u003cp\u003eAdd on\u003c/p\u003e                \u003c/div\u003e                \u003cdiv class=\"price-table-title\"\u003e                    \u003cimg src=\"/pricing-assets/img/price-tables/speed-icon.svg\" alt=\"\"\u003e                    \u003cp\u003eConsumption based\u003c/p\u003e                \u003c/div\u003e                \u003cdiv class=\"price-table-title\"\u003e                    \u003cimg src=\"/pricing-assets/img/price-tables/infinity.svg\" alt=\"\"\u003e                    \u003cp\u003eAI Ready\u003c/p\u003e                \u003c/div\u003e            \u003c/div\u003e            \u003cdiv class=\"price-table-category first opened\"\u003e                \u003cdiv class=\"price-table-category-inner\"\u003e                    \u003cdiv class=\"text-wrap\"\u003e                        \u003cp\u003eEngagement Orchestration\u003c/p\u003e                        \u003cp class=\"sm\"\u003eEvolve from interaction management to workflow orchestration across the entire organization.\u003c/p\u003e                    \u003c/div\u003e                    \u003ca href=\"#\" class=\"btn-wrap\"\u003e                        \u003cimg src=\"/pricing-assets/img/price-tables/download-icn-black.svg\" alt=\"\"\u003e                    \u003c/a\u003e                \u003c/div\u003e                \u003cdiv class=\"price-table\" style=\"display: flex;\"\u003e                    \u003cdiv class=\"price-table-left\"\u003e                        \u003cdiv class=\"price-table-column\"\u003e                            \u003cdiv class=\"price-table-head\"\u003e\u003cp\u003eCore CCaaS Features\u003c/p\u003e\u003c/div\u003e                            \u003cdiv class=\"price-table-line grey\"\u003eVoice and Digital channels\u003c/div\u003e                            \u003cdiv class=\"price-table-line\"\u003eOmnichannel Routing\u003c/div\u003e                            \u003cdiv class=\"price-table-line grey\"\u003e\u003cp\u003e\u003cspan\u003eProactive web engagement\u003c/span\u003e \u003cspan class=\"symb\"\u003e\u003cimg src=\"/pricing-assets/img/price-tables/infinity.svg\" alt=\"\"\u003e\u003c/span\u003e\u003c/p\u003e\u003c/div\u003e                            \u003cdiv class=\"price-table-line\"\u003eRecording and compliance\u003c/div\u003e                            \u003cdiv class=\"price-table-line grey\"\u003e\u003cp\u003e\u003cspan\u003eAI routing\u003c/span\u003e \u003cspan class=\"symb\"\u003e\u003cimg src=\"/pricing-assets/img/price-tables/infinity.svg\" alt=\"\"\u003e\u003c/span\u003e \u003cspan class=\"symb speed\"\u003e\u003cimg src=\"/pricing-assets/img/price-tables/speed-icon.svg\" alt=\"\"\u003e\u003c/span\u003e\u003c/p\u003e\u003c/div\u003e                            \u003cdiv class=\"price-table-line\"\u003e\u003cp\u003e\u003cspan\u003eOutbound Engagement\u003c/span\u003e \u003cspan class=\"symb\"\u003e\u003cimg src=\"/pricing-assets/img/price-tables/infinity.svg\" alt=\"\"\u003e\u003c/span\u003e \u003cspan class=\"symb speed\"\u003e\u003cimg src=\"/pricing-assets/img/price-tables/speed-icon.svg\" alt=\"\"\u003e\u003c/span\u003e\u003c/p\u003e\u003c/div\u003e                        \u003c/div\u003e                    \u003c/div\u003e                    \u003cdiv class=\"price-table-right\"\u003e                        \u003cdiv class=\"price-table-column\"\u003e                            \u003cdiv class=\"price-table-head\"\u003e                                \u003ch3\u003eOmnichannel Suite\u003c/h3\u003e                                \u003cdiv class=\"price\"\u003e$110\u003c/div\u003e                                \u003cp\u003ePer agent per month\u003c/p\u003e                            \u003c/div\u003e                            \u003cdiv class=\"price-table-line grey\"\u003e                                \u003cimg src=\"/pricing-assets/img/price-tables/check-icon-purple-new.svg\" alt=\"\"\u003e                            \u003c/div\u003e                            \u003cdiv class=\"price-table-line\"\u003e                                \u003cimg src=\"/pricing-assets/img/price-tables/check-icon-purple-new.svg\" alt=\"\"\u003e                            \u003c/div\u003e                            \u003cdiv class=\"pr