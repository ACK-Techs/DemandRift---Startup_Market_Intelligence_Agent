-download.button-blue:not(.button-arrow) {    padding-left: 44px !important;    padding-right: 20px !important;  }  .pricing-container .price-table-category-non-clickable .price-table-category-inner .btn-wrap.button-nice.button-play.button-white {    padding-left: 20px !important;    padding-right: 20px !important;  }}.pricing-container .button-nice.button-arrow.button-download {  padding-left: 20px !important;  padding-right: 44px !important;}@media (min-width: 1025px) {  .pricing-container .button-nice.button-arrow.button-download {    padding-left: 20px !important;    padding-right: 44px !important;  }}.pricing-container .button-nice.button-play:not(.button-arrow):before,.pricing-container .button-nice.button-play:not(.button-arrow):after,.pricing-container .button-nice.button-download:not(.button-arrow):before,.pricing-container .button-nice.button-download:not(.button-arrow):after {  position: absolute !important;  left: 3px !important;  top: 50%;  transform: translateY(-50%);  margin: 0 !important;  outline: none;  border: 1px solid transparent;}.pricing-container .button-nice.button-arrow:before,.pricing-container .button-nice.button-arrow:after {  position: absolute !important;  right: 3px !important;  left: auto !important;  top: 50%;  transform: translateY(-50%);  margin: 0 !important;  outline: none;  border: 1px solid transparent;}.pricing-container .button-nice.button-play:before,.pricing-container .button-nice.button-download:before {  opacity: 0 !important;}.pricing-container .button-nice.button-play:after,.pricing-container .button-nice.button-download:after {  opacity: 1 !important;}.pricing-container .button-nice.button-play:hover:before,.pricing-container .button-nice.button-download:hover:before {  opacity: 1 !important;}.pricing-container .button-nice.button-play:hover:after,.pricing-container .button-nice.button-download:hover:after {  opacity: 0 !important;}.pricing-container .button-nice.button-arrow:before {  opacity: 0 !important;}.pricing-container .button-nice.button-arrow:after {  opacity: 1 !important;}.pricing-container .button-nice.button-arrow:hover:before {  opacity: 1 !important;}.pricing-container .button-nice.button-arrow:hover:after {  opacity: 0 !important;}</style><script src="/pricing-assets/js/main.js" defer=""></script><div class="pricing-container">    <section class="hero" id="hero">        <img class="bg-img" src="/pricing-assets/img/hero-bg-1.1.png" alt="">                <div class="container">            <div class="title-block">                <!-- <h2 class="pretitle">Pricing</h2> -->                <h1>Find the Right <br>Package for You</h1>                <p>Our flexible packages allow you to customize NiCE CXone pricing to your unique business needs. Get everything you need to delight customers and scale operations with our all-in-one CCaaS platform.</p>                <div class="btn-wrap">                    <a href="#price-tables-section" class="button-nice button-play button-black">View Pricing</a>                    <a href="https://www.nice.com/get-quote" class="button-nice button-play button-white" target="_blank">Request a quote</a>                </div>            </div>            <div class="img-block">                <img src="/pricing-assets/img/header-img.png" alt="">            </div>        </div>    </section>    <div class="price-tables-section" id="price-tables-section">        <div class="container">            <div class="title-block">                <h2>Flexible pricing and scalable capabilities <br>for unique business needs</h2>                <p>NiCE offers the most customer-friendly pricing in the market—monthly billing in arrears, no prepay, no <br>surprise charges. Our usage-based, tiered model lowers costs as your business grows.</p>                <div class="btn-wrap">                    <a href="#price-table-first" class="button-nice button-arrow button-download button-black">Core Packages</a>                    <a href="#packages" class="button-nice button-arrow button-download button-blue">Industry Packages</a>                </div>            </div>            <div class="price-table-title-row" id="price-table-first">                <div class="price-table-title">                    <img src="/pricing-assets/img/price-tables/check-icon-purple-new.svg" alt="">                    <p>Included</p>                </div>                <div class="price-table-title">                    <img src="/pricing-assets/img/price-tables/plus-icon-light-blue.svg" alt="">                    <p>Add on</p>                </div>                <div class="price-table-title">                    <img src="/pricing-assets/img/price-tables/speed-icon.svg" alt="">                    <p>Consumption based</p>                </div>                <div class="price-table-title">                    <img src="/pricing-assets/img/price-tables/infinity.svg" alt="">                    <p>AI Ready</p>                </div>            </div>            <div class="price-table-category first opened">                <div class="price-table-category-inner">                    <div class="text-wrap">                        <p>Engagement Orchestration</p>                        <p class="sm">Evolve from interaction management to workflow orchestration across the entire organization.</p>                    </div>                    <a href="#" class="btn-wrap">                        <img src="/pricing-assets/img/price-tables/download-icn-black.svg" alt="">                    </a>                </div>                <div class="price-table" style="display: flex;">                    <div class="price-table-left">                        <div class="price-table-column">                            <div class="price-table-head"><p>Core CCaaS Features</p></div>                            <div class="price-table-line grey">Voice and Digital channels</div>                            <div class="price-table-line">Omnichannel Routing</div>           