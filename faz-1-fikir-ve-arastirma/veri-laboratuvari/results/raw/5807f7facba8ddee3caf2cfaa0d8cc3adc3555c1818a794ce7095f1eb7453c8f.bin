<script id="popover-component-template" type="text/x-template">

    
    <div id="popover-component">
        <div class="popover in" :class="currentPopoverPosition" :style="popoverStyle" style="display: block; z-index: 10001;" ref="popover-box" @mouseenter="$emit('mouseenter')" @mouseleave="$emit('mouseleave')">
