                    <span :title="'Explore ' + item + ' in Site Explorer'">
                        <a :href="'/reports/site-explorer?q=' + encodeURIComponent(item) + scopeParam + wildcard + '&IndexDataSource=' + indexDataSource" :alt="'Explore ' + item + ' in Site Explorer'">
                            <img width="16" height="16" src="/static/images/icons/cog-explorer.png" :alt="'Explore ' + item + ' in Site Explorer'">
                            <span class="action">Site Explorer</span>
