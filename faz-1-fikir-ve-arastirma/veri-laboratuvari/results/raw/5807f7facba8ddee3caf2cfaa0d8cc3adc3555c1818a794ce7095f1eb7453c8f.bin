                        <a :href="'/reports/site-explorer/referring-domains?q=' + encodeURIComponent(item) + scopeParam + wildcard + '&IndexDataSource=' + indexDataSource" :alt="'Explore ' + item + ' in Site Explorer'">
                            <span class="action">Ref Domains</span>
