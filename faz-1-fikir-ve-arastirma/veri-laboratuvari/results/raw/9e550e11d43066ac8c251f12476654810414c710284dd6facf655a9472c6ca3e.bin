    <!-- Snippet: bUkWwjt0q -->
<script>
function injectCookieStyles() {
  const id = "cookie-custom-style"

  let style = document.getElementById(id)

  if (!style) {
    style = document.createElement("style")
    style.id = id
    document.head.appendChild(style)
  }

  style.innerHTML = `
    /* COOKIEYES MODAL */
    .cky-modal {
      background-color: transparent!important;
    }

    .cky-preference-center {
      background: var(--token-a29b0e60-0ecc-4982-99d6-731ac9a01046) !important;
      color: white !important;
      border: 1px solid var(--ic-border) !important;
      border-radius: 16px !important;
      box-shadow: 0 24px 80px rgba(0,0,0,0.45) !important;
      overflow: hidden !important;
    }

    .cky-preference-header {
      background: var(--ic-bg) !important;
      border-bottom: 1px solid var(--ic-border) !important;
      padding: 24px 32px !important;
    }

    .cky-preference-title {
      color: var(--ic-text) !important;
      font-size: 24px !important;
      font-weight: 600 !important;
    }

    .cky-preference-body-wrapper,
    .cky-preference-content-wrapper,
    .cky-accordion-header-des,
    .cky-accordion-header-des p {
      background: var(--ic-bg) !important;
      color: var(--ic-text-secondary) !important;
    }

    .cky-preference-content-wrapper p {
      color: var(--ic-text-secondary) !important;
      font-size: 16px !important;
      line-height: 1.6 !important;
    }

    .cky-horizontal-separator,
    .cky-accordion,
    .cky-accordion-item {
      border-color: var(--token-67692729-257d-474e-bdbe-2734e90e0c38) !important;
    }

    .cky-accordion-btn {
      color: var(--ic-text) !important;
      font-size: 18px !important;
      font-weight: 600 !important;
    }

    .cky-always-active,
    .cky-show-desc-btn {
      color: var(--ic-pink) !important;
      font-weight: 600 !important;
    }

    .cky-audit-table {
      background: var(--ic-surface) !important;
      color: var(--ic-text-secondary) !important;
      border-color: var(--ic-border) !important;
      border-radius: 12px !important;
    }

    .cky-cookie-des-table,
    .cky-cookie-des-table li,
    .cky-cookie-des-table div,
    .cky-empty-cookies-text {
      color: var(--ic-text-secondary) !important;
      border-color: var(--token-67692729-257d-474e-bdbe-2734e90e0c38) !important;
    }

    .cky-switch input[type="checkbox"] {
      background-color: #3A487C !important;
    }

    /* CONSENT BAR */
    .cky-consent-bar {
      background-color: var(--token-a29b0e60-0ecc-4982-99d6-731ac9a01046) !important;
      color: white!important;
      border-color: var(--token-67692729-257d-474e-bdbe-2734e90e0c38) !important;
      box-shadow: 0 -1px 10px 0 #101b8d !important;
    }

    .cky-consent-bar .cky-notice-des p, .cky-gpc-wrapper .cky-gpc-desc p, .cky-preference-body-wrapper .cky-preference-content-wrapper p, .cky-accordion-header-wrapper .cky-accordion-header-des p, .cky-cookie-des-table li div:last-child p {
      color: white!important;
    }

    .cky-notice .cky-title {
      color: white!important;
    }

    /* 🔥 LINKS (NEW) */
    .cky-consent-bar a,
    .cky-preference-center a {
      color: #7dd3fc !important;
    }

    /* BUTTONS */
    .cky-consent-bar button,
    .cky-preference-center button {
      border-radius: 8px !important;
      font-weight: 500 !important;
    }

    /* 🔥 PRIMARY BUTTONS (UPDATED COLOR) */
    .cky-btn-accept, 
    .cky-button-accept {
      background-color: #f72585 !important;
      border-color: #f72585 !important;
      color: #ffffff !important;
    }

    /* 🔥 SECONDARY BUTTONS (UPDATED COLOR) */
   

    .cky-btn-customize,
    .cky-btn-preferences {
      background: transparent !important;
      border: 1px solid white  !important;
      color: white !important;
    }

    .cky-btn-accept:hover,
    .cky-btn-preferences:hover,
    .cky-button-accept:hover {
      filter: brightness(1.08) !important;
    }

    /* SWITCHES */
    .cky-switch input,
    .cky-switch input:checked {
      background-color: var(--ic-pink) !important;
    }

    /* FOOTER */
    .cky-footer-wrapper,
    .cky-prefrence-btn-wrapper {
      background: var(--ic-bg) !important;
      border-top-color: var(--token-67692729-257d-474e-bdbe-2734e90e0c38) !important;
    }

    .cky-footer-shadow {
      background: linear-gradient(180deg, rgba(9,15,28,0) 0%, var(--ic-bg) 100%) !important;
    }

    [data-cky-tag="detail-powered-by"] {
      background: var(--ic-surface) !important;
      color: var(--ic-text-secondary) !important;
      border-radius: 0 0 16px 16px !important;
    }
  `
}

function startCookieStyling() {
  injectCookieStyles()

  const interval = setInterval(injectCookieStyles, 500)

  setTimeout(() => {
    clearInterval(interval)
  }, 8000)

  document.addEventListener("click", injectCookieStyles)
}

startCookieStyling()
</script>
