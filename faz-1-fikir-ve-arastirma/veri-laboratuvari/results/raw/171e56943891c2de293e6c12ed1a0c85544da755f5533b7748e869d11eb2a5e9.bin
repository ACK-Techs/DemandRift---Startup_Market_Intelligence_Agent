\&quot;592\&quot; height\u003d\&quot;468\&quot; loading\u003d\&quot;lazy\&quot;\u003e\n                                \u003c/picture\u003e\n                              \u003c/div\u003e\n                              \u003cdiv class\u003d\&quot;TemplateCardCarousel_mediaCardCopyWrap\&quot;\u003e\n                                \u003cdiv class\u003d\&quot;TemplateCardCarousel_mediaCardBadge\&quot;\u003e\n                                  \u003cpicture\u003e\u003cimg src\u003d\&quot;https://storage.googleapis.com/gweb-workspace-assets/uploads/7uffzv9dk4sn-P1K7qHcFALYDVzVzvES0k-22539c59700c37e426329a3e82806223-TemplateTileSimple_GShield.svg\&quot; alt\u003d\&quot;Щит со значком Google в виде буквы \u0026quot;G\u0026quot; \&quot; width\u003d\&quot;101\&quot; height\u003d\&quot;100\&quot; loading\u003d\&quot;lazy\&quot;\u003e\u003c/picture\u003e\n                                  \u003cdiv class\u003d\&quot;Text_container Text_body Text_xs\&quot;\u003eБезопасность\u003c/div\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d\&quot;Text_container Text_body Text_lg TemplateCardCarousel_body\&quot;\u003e\n                                  \u003ch3 class\u003d\&quot;Heading_heading heading Heading_size:h6\&quot;\u003eЗащищайте конфиденциальные данные\u003c/h3\u003e\n                                  \u003cp\u003eИИ-функции помогают предотвращать потерю данных и соблюдать нормативные требования благодаря автоматическому распознаванию и классификации конфиденциальных сведений.\u003c/p\u003e\n                                \u003c/div\u003e\n                              \u003c/div\u003e\n                            \u003c/div\u003e\n                          \u003c/slot\u003e\n                        \u003c/gws-card-wrapper\u003e\u003c/div\u003e\n                    \u003c/div\u003e\n                  \u003c/gws-carousel\u003e\u003c/div\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/section\u003e\n        \u003cdiv id\u003d\&quot;m9\&quot; data-module\u003d\&quot;TemplateSpacer\&quot; data-g-section-id\u003d\&quot;spacer\&quot;\u003e\n          \u003cdiv style\u003d\&quot;--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:60px;--gws-spacer-desktop-size:80px;\&quot; class\u003d\&quot;Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all\&quot;\u003e\u003c/div\u003e\n        \u003c/div\u003e\n        \u003csection id\u003d\&quot;pricing\&quot; data-module\u003d\&quot;TemplateBackgroundContainer\&quot; data-g-section-id\u003d\&quot;pricing\&quot;\u003e\n          \u003cdiv class\u003d\&quot;TemplateBackgroundContainer_container\&quot;\u003e\n            \u003cdiv class\u003d\&quot;TemplateBackgroundContainer_wrapper TemplateBackgroundContainer_white\&quot;\u003e\n              \u003cdiv class\u003d\&quot;TemplateBackgroundContainer_modules\&quot;\u003e\n                \u003csection id\u003d\&quot;m10-1\&quot; data-module\u003d\&quot;TemplateSectionBreak\&quot;\u003e\n                  \u003cdiv style\u003d\&quot;Grid_grid\&quot; class\u003d\&quot;Grid_grid TemplateSectionBreak_grid\&quot;\u003e\n                    \u003cdiv style\u003d\&quot;--gws-column-laptop-start:3;--gws-column-laptop-end:10;\&quot; class\u003d\&quot;Grid_column TemplateSectionBreak_container\&quot;\u003e\n                      \u003cdiv class\u003d\&quot;Text_container Text_body Text_lg TemplateSectionBreak_copyGroup\&quot;\u003e\n                        \u003ch2 class\u003d\&quot;Heading_heading heading Heading_size:h2\&quot;\u003eПодберите оптимальный для вас тарифный план. У вас будет 14 дней, чтобы попробовать его бесплатно.\u003c/h2\u003e\n                        \u003cp\u003eВыберите версию Google Workspace для вашего бизнеса.\u003c/p\u003e\n                      \u003c/div\u003e\n                    \u003c/div\u003e\n                  \u003c/div\u003e\n                \u003c/section\u003e\n  