a.com/privacy&quot;],&quot;linkType&quot;:[0,&quot;custom&quot;]}]}],[0,{&quot;type&quot;:[0,&quot;text&quot;],&quot;version&quot;:[0,1],&quot;detail&quot;:[0,0],&quot;mode&quot;:[0,&quot;normal&quot;],&quot;style&quot;:[0,&quot;&quot;],&quot;format&quot;:[0,0],&quot;text&quot;:[0,&quot; affords all users of our software (not only EU citizens) the rights stipulated by the GDPR. You may also sign our Data Processing Schedule to ensure your own GDPR compliance when using Lyssna as a Data Processor. Please visit &quot;]}],[0,{&quot;type&quot;:[0,&quot;link&quot;],&quot;id&quot;:[0,&quot;bdb73239942d19a1bbffd074&quot;],&quot;direction&quot;:[0,&quot;ltr&quot;],&quot;format&quot;:[0,&quot;&quot;],&quot;version&quot;:[0,3],&quot;indent&quot;:[0,0],&quot;textFormat&quot;:[0,8],&quot;children&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;text&quot;],&quot;version&quot;:[0,1],&quot;detail&quot;:[0,0],&quot;mode&quot;:[0,&quot;normal&quot;],&quot;style&quot;:[0,&quot;&quot;],&quot;format&quot;:[0,8],&quot;text&quot;:[0,&quot;this article&quot;]}]]],&quot;fields&quot;:[0,{&quot;newTab&quot;:[0,true],&quot;url&quot;:[0,&quot;http://help.usabilityhub.com/en/articles/4952927-gdpr-compliance&quot;],&quot;linkType&quot;:[0,&quot;custom&quot;]}]}],[0,{&quot;type&quot;:[0,&quot;text&quot;],&quot;version&quot;:[0,1],&quot;detail&quot;:[0,0],&quot;mode&quot;:[0,&quot;normal&quot;],&quot;style&quot;:[0,&quot;&quot;],&quot;format&quot;:[0,0],&quot;text&quot;:[0,&quot; for more information.&quot;]}]]]}]]]}]}],&quot;id&quot;:[0,&quot;68e70d4cb30bfc460c71c6b8&quot;]}],[0,{&quot;blockType&quot;:[0,&quot;accordionItem&quot;],&quot;title&quot;:[0,&quot;If I use demographic filters does it increase the cost?&quot;],&quot;description&quot;:[0,{&quot;root&quot;:[0,{&quot;direction&quot;:[0,&quot;ltr&quot;],&quot;format&quot;:[0,&quot;&quot;],&quot;indent&quot;:[0,0],&quot;type&quot;:[0,&quot;root&quot;],&quot;version&quot;:[0,1],&quot;children&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;paragraph&quot;],&quot;textFormat&quot;:[0,0],&quot;version&quot;:[0,1],&quot;direction&quot;:[0,&quot;ltr&quot;],&quot;format&quot;:[0,&quot;&quot;],&quot;indent&quot;:[0,0],&quot;children&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;text&quot;],&quot;version&quot;:[0,1],&quot;detail&quot;:[0,0],&quot;mode&quot;:[0,&quot;normal&quot;],&quot;style&quot;:[0,&quot;&quot;],&quot;format&quot;:[0,0],&quot;text&quot;:[0,&quot;No. We include unlimited demographic filters when you order from the research panel at no additional charge.&quot;]}]]]}]]]}]}],&quot;id&quot;:[0,&quot;68e70d4cb30bfc460c71c6b9&quot;]}]]],&quot;id&quot;:[0,&quot;68e70d4cb30bfc460c71c6ba&quot;]}]}" ssr client="visible" opts="{&quot;name&quot;:&quot;InfoAccordion&quot;,&quot;value&quot;:true}" await-children><div class="mx-auto max-w-[630px] pb-20 pt-[26px] lg:max-w-[850px] lg:pt-[62px]"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are panel responses included in my subscription?","acceptedAnswer":{"@type":"Answer","text":"No. The Lyssna panel is priced separately. You can pay to recruit from our panel as you go or you can purchase bulk panel credits at a discount to use as you need. Recruiting your own users, however, is free."}},{"@type":"Question","name":"Is there a minimum subscription term?","acceptedAnswer":{"@type":"Answer","text":"You can subscribe to the Starter and Growth plan on a monthly or annual basis. When paying annually, you can access the annual study limits upfront. The Free plan has no subscription term or ongoing fees."}},{"@type":"Question","name":"How does the Free plan work?","acceptedAnswer":{"@type":"Answer","text":"The Free plan has no ongoing fees. It includes a limited feature set. You can still recruit from the panel or your own audience."}},{"@type":"Question","name":"What are credits?","acceptedAnswer":{"@type":"Answer","text":"Credits can be used to recruit participants from the Lyssna panel. You can purchase credits and store them on your account to use as needed. They never expire and there are discounts when purchasing in bulk."}},{"@type":"Question","name":"What’s included in the Enterprise plan?","acceptedAnswer":{"@type":"Answer","text":"The Enterprise plan is suited to companies with sophisticated procurement needs. We can provide SLAs, perform security audits, review and implement custom terms, make arrangements for larger teams and provide access to professional services. Please contact sales to schedule a short exploratory conversation."}},{"@type":"Question","name":"What are the payment options?","acceptedAnswer":{"@type":"Answer","text":"Secure payments with Visa, Mastercard, and AMEX. Manual invoicing is available on Annual and Enterprise plans. Contact us for details."}},{"@type":"Question","name":"Is Lyssna GDPR compliant?","acceptedAnswer":{"@type":"Answer","text":"Yes. As a Data Controller, Lyssna's privacy policy affords all users of our software (not only EU citizens) the rights stipulated by the GDPR. You may also sign our Data Processing Schedule to ensure your own GDPR compliance when using Lyssna as a Data Processor. Please visit this article for more information."}},{"@type":"Question","name":"If I use demographic filters does it increase the cost?","acceptedAnswer":{"@type":"Answer","text":"No. We include unlimited demographic filters when you order from the research panel at no additional charge."}}]}</script><div data-animate class="flex flex-col"><div class="border-b border-neutral-05 px-4 py-6 first:pt-4.5 sm:mx-0 sm:px-0 lg:py-8 lg:first:pt-5 "><button type="button" aria-expanded="false" aria-controls="accordion-panel-P214-0" class="w-full cursor-pointer bg-transparent text-left"><span class="relative flex w-full justify-between gap-6 lg:gap-[38px] lg:pt-0"><span class="font-mint lg:text-heading-s text-m-heading-s font-medium">Are panel responses included in my subscription?</span><span><span class="flex h-7 w-7 items-center justify-center rou