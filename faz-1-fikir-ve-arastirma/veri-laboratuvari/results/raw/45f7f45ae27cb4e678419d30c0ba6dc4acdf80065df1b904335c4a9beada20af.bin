            <script>
            
              function isBot() {
                // Pollinator (Selenium & Cypress) uses Chrome webdriver
                return !!(navigator.webdriver ||
                        window.document.documentElement.getAttribute('webdriver') ||
                        window.callPhantom ||
                        window._phantom ||
                        (navigator.userAgent.indexOf('jsdom') > -1));
              }
            
            
              var gtag = function () {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(arguments);
              }
            
              function loadGoogleAnalytics() {
                let ga = document.createElement('script');
                ga.type = 'text/plain';
                // Category 3 (performance) must match the consent category the event-level
                // gates check (canSendPerformanceAnalytics). Tagging the transport as
                // category 4 (targeting) meant users who accepted analytics but declined
                // advertising passed the gate while gtag.js never loaded, so their events
                // were pushed into window.dataLayer and silently never sent.
                ga.className = 'optanon-category-3';
                ga.async = true;
                ga.src = "https://www.googletagmanager.com/gtag/js?id=UA-6032469-13";
                let s = document.getElementsByTagName('script')[0];
                s.parentNode.insertBefore(ga, s);
              }
            
              function initializeGoogleAnalytics() {
                if(isBot()) {
                  gtag = function(){};
                  return;
                }
            
                loadGoogleAnalytics();
            
                gtag('js', new Date());
                gtag('config', "UA-6032469-13", {
                 'anonymize_ip': true,
                 'groups': 'atlassianGroup',
                 'send_page_view': false,
                });
            
                gtag('config', "G-Z8B17X4R8Q" , {
                 'groups': 'atlassianGroup',
                 'send_page_view': false,
                });
            
              }
            
              initializeGoogleAnalytics();
            
            </script>
