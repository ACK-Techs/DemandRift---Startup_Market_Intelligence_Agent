  /* Anti alias on text */
  * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  /* Global rich text styling */
  .text-rich-text p:last-child {
    margin-bottom: 0px;
  }
  .w-richtext b {
    font-weight: 500 !important;
  }
  .w-richtext strong {
    font-weight: 500 !important;
  }
  /* List style with numbers */
  .list-style-v2-numbers ol {
    padding-left: 0 !important;
  }
  .list-style-v2-numbers li {
    padding: 0.75rem 0rem;
    margin-bottom: 0px;
    border-top: 1px solid var(--border--subtle);
    border-bottom: 1px solid var(--border--subtle);
    display: flex;
    align-items: flex-start;
    /* gap: 10px; */
    counter-increment: list-counter;
  }
  /* gap between numbers and start*/
  .list-style-v2-numbers li::before {
    margin-right: 10px;
  }
  .list-style-v2-numbers li + li {
    border-top: none;
  }
  .list-style-v2-numbers li::before {
    content: counter(list-counter);
    color: var(--text--neutral);
    min-width: 1rem;
  }
  /* List style with drop arrow */
  .list-style-v2-arrows ul {
    padding-left: 0 !important;
    font-family:
      ABC Diatype,
      Arial,
      sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 130%;
  }
  .list-style-v2-arrows li::before {
    content: '';
    background-image: url('https://cdn.prod.website-files.com/651206cc884d0caef0f4c520/69b70758646bd86ef33c46a4_Vector%20(3).svg');
    background-size: contain;
    background-repeat: no-repeat;
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .list-style-v2-arrows li {
    padding: 0.75rem 0rem;
    margin-bottom: 0px;
    border-top: 1px solid var(--border--subtle);
    border-bottom: 1px solid var(--border--subtle);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .list-style-v2-arrows li + li {
    border-top: none;
  }
  .list-style-v2-arrows.is-dark li + li {
    border-top: none;
  }
  /* Dark background list styling */
  .list-style-v2-arrows.is-dark li {
    border-top: 1px solid var(--border--neutral);
    border-bottom: 1px solid var(--border--neutral);
    color: #fff;
  }

  /* List style for checkmarks exp. pricing page */
  .list-style-v2-checkmarks li::before {
    content: '';
    background-image: url('https://cdn.prod.website-files.com/651206cc884d0caef0f4c520/69c880127fe94077a0b0b303_check.svg');
    background-size: contain;
    background-repeat: no-repeat;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 4px;
  }
  /* has larger padding than arrows */
  .list-style-v2-checkmarks li {
    padding: 1.2rem 0rem;
    margin-bottom: 0px;
    border-top: 1px solid var(--border--subtle);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .list-style-v2-checkmarks li:last-child {
    border-bottom: 1px solid var(--border--subtle);
  }
  .list-style-v2-checkmarks.is-extra-strong li {
    border-top: 1px solid var(--border--neutral);
  }
  .list-style-v2-checkmarks.is-extra-strong li:last-child {
    border-bottom: 1px solid var(--border--neutral);
  }

  /* For xmark style that is a check for compare tables */
  .list-style-v2-checkmarks.is-xmarkstyle li::before {
    background-image: url(https://cdn.prod.website-files.com/651206cc884d0caef0f4c520/6a39c2522e322725c881af3c_check-medium.svg);
  }
  .list-style-v2-checkmarks.is-xmarkstyle li {
    border-top: 1px solid #dddcd9;
  }
  .list-style-v2-checkmarks.is-xmarkstyle li:last-child {
    border-bottom: 1px solid #dddcd9;
  }

  /* Dark mode for checkmarks */
  .list-style-v2-checkmarks.is-dark-mode li::before {
    content: '';
    background-image: url('https://cdn.prod.website-files.com/651206cc884d0caef0f4c520/69d02ca98343fa3418480ed8_check.svg');
    background-size: contain;
    background-repeat: no-repeat;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 4px;
  }
  .list-style-v2-checkmarks.is-dark-mode li {
    border-top: 1px solid var(--border--neutral);
  }
  .list-style-v2-checkmarks.is-dark-mode li:last-child {
    border-bottom: 1px solid var(--border--neutral);
  }
  /* List style for x mark list (compare pages) */
  .list-style-v2-xmark li::before {
    content: '';
    background-image: url('https://cdn.prod.website-files.com/651206cc884d0caef0f4c520/6a31db58f2c45b6772886e9d_Frame%20(2).svg');
    background-size: contain;
    background-repeat: no-repeat;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 4px;
  }
  /* has larger padding than arrows */
  .list-style-v2-xmark li {
    padding: 1.2rem 0rem;
    margin-bottom: 0px;
    border-top: 1px solid #dddcd9;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .list-style-v2-xmark li:last-child {
    border-bottom: 1px solid #dddcd9;
  }

  /* Coming soon tag styling on list item */
  .list-style-v2-arrows li.li-item_eyebrow {
    align-items: center;
  }

  .list-style-v2-arrows li.li-item_eyebrow::before {
    align-self: flex-start;
    margin-top: 8px;
  }

  .list-style-v2-arrows li.li-item_eyebrow::after {
    content: 'Coming soon';
    font-family:
      ABC Diatype,
      Arial,
      sans-serif;
    font-size: 0.75rem;
    color: #6e6d6a;
    background: #e8e7e6;
    border-radius: 100px;
    padding: 4px 8px;
    white-space: nowrap;
    flex-shrink: 0;
    align-self: center;
    margin-left: auto;
  }
  /* List styles for heading lists (no bullets + big text) */
  .list-style-v2-headings li {
    padding: 1.25rem 0rem;
    margin-bottom: 0px;
    border-top: 1px solid var(--border--subtle);
    border-bottom: 1px solid var(--border--subtle);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .list-style-v2-headings li + li {
    border-top: none;
  }
  .list-style-v2-headings li:last-child {
    border-bottom: none;
  }

  /* Pricing page section with left dashed lines */
  .dashed-border-line_vertical-dark::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2rem;
    border-top: 1px dashed var(--border--neutral);
  }
  .dashed-border-line_vertical-dark::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2rem;
    border-bottom: 1px dashed var(--border--neutral);
  }
  @media (max-width: 991px) {
    .dashed-border-line_vertical-dark::before {
      width: 1.25rem;
    }
    .dashed-border-line_vertical-dark::after {
      width: 1.25rem;
    }
  }
  @media (max-width: 991px) {
    .navbar-wrapper[data-wf--nav-april-2026--variant='clear-mode']:has(.w--open) {
      background-color: var(--background--mid-tone) !important;
      transition: none !important;
    }
  }
  /* Integrations link styling */
  .integrations-list_link:hover .integrations-list_link_arrow {
    transform: translateX(5px); /* move right */
    filter: invert(100%);
  }
  .integrations-list_link.is-nolink .integrations-list_link_arrow {
    opacity: 0;
  }
  .integrations-list_container:last-child .integrations-list_link {
    border-top: 1px solid var(--border--subtle);
  }
  .integrations-list_container .integrations-list_link:last-child {
    border-bottom: 1px solid var(--border--subtle);
  }

  /* Compare pages table stylings  */
  .comparison-grid_v2 li {
    height: 100%;
  }
  .comparison-grid_v2 ol {
    height: 100%;
  }
  .comparison-grid_v2 ul {
