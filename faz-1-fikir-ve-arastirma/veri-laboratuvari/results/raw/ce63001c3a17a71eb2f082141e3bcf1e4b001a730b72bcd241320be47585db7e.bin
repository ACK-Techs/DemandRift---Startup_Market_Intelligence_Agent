_157\":183,\"_49\":201,\"_160\":185,\"_162\":202,\"_164\":203,\"_166\":167},{\"_153\":196,\"_155\":156,\"_157\":183,\"_49\":197,\"_160\":185,\"_162\":198,\"_164\":199,\"_166\":167},{\"_153\":192,\"_155\":156,\"_157\":158,\"_49\":193,\"_160\":161,\"_162\":194,\"_164\":195,\"_166\":167},{\"_153\":188,\"_155\":156,\"_157\":158,\"_49\":189,\"_160\":161,\"_162\":190,\"_164\":191,\"_166\":167},{\"_153\":182,\"_155\":156,\"_157\":183,\"_49\":184,\"_160\":185,\"_162\":186,\"_164\":187,\"_166\":167},{\"_153\":178,\"_155\":156,\"_157\":158,\"_49\":179,\"_160\":161,\"_162\":180,\"_164\":181,\"_166\":167},{\"_153\":174,\"_155\":156,\"_157\":158,\"_49\":175,\"_160\":161,\"_162\":176,\"_164\":177,\"_166\":167,\"_172\":173},{\"_153\":168,\"_155\":156,\"_157\":158,\"_49\":169,\"_160\":161,\"_162\":170,\"_164\":171,\"_166\":167,\"_172\":173},{\"_153\":154,\"_155\":156,\"_157\":158,\"_49\":159,\"_160\":161,\"_162\":163,\"_164\":165,\"_166\":167},\"definition\",\"savedsearch\",\"type\",\"named\",\"category\",\"strictly necessary\",\"Saves your search temporarily when you attempt to save a search without being logged in.\",\"behaviour\",\"mandatory\",\"domains\",[119,120,121,122],\"policy\",[],\"expiration\",\"session\",\"rma_email_resend_expiry\",\"Used to store the time of a 60-second countdown during multi-factor authentication (MFA) flow when the user clicks the Resend button to resend the Email code. This ensures the countdown continues accurately even if the user reloads the page or screen.\",[119,120,121,122],[120],\"policyPrefix\",\"www\",\"rma_email_code_verification_expiry\",\"Used to store the start time of a 10-minute countdown during multi-factor authentication (MFA) flow when the Email code is sent. This ensures the countdown continues accurately even if the user reloads the page.\",[119,120,121,122],[120],\"filterPersistence_marketShareReport\",\"Used to store filters in our Market Share Reports within our professional users' site, Rightmove Plus so retains filters when page is refreshed.\",[119,120,121,122],[],\"selectedTab\",\"functional\",\"When you use the professional users’ platform, Rightmove Plus, it stores the most recent tab you were on so that this can be open by default on refresh.\",\"opt-in\",[119,120,121,122],[],\"feedbacks.queue\",\"Stores the reason you provide for hiding a property from your search results.\",[119,120,121,122],[],\"hideproperties.queue\",\"Stores details of which properties you wish to hide from your search results. so that they do not appear in your results.\",[119,120,121,122],[],\"addedToPropertyPropertyId\",\"Stores your last saved property ID to allow you to change the list it's saved in.\",[119,120,121,122],[],\"addedToPropertyListId\",\"Stores your default saved property list so you can add new saved properties to your list.\",[119,120,121,122],[],\"showTrayConsent\",\"When you log in through our one time link, this makes sure that the page landed on then opens up consent in the tray.\",[119,120,121,122],[],\"otl\",\"Marks that user has logged in through one time link.\",[119,120,121,122],[],\"react-router-scroll-positions\",\"Used for our commercial property details page, to improve the Browse experience.\",[119,120,121,122],[],\"postcodeSectors\",\"Used to display the relevant postcode sectors for the members patch management functionality within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"pdwSchoolFilters\",\"Stores the school filters that you select so they are applied whenever you move to any school map view.\",[119,120,121,122],[],\"saveproperties.queue\",\"Stores details of properties you are interested in.\",[119,120,121,122],[],\"trayShowWelcomeBackScreen\",\"Used to show the re-onboarding flow in the tray for the one time link flow.\",[119,120,121,122],[],\"testsession\",\"targeting\",\"Test 2 - session\",[119,120,121,122],[],\"rm_displayPhoneLeadBanner\",\"When you click to call about a property, we will continue to show you a banner about whether you wish to add your phone enquiry to your sent enquiries.\",[119,120,121,122],[],\"pvw.saveproperties.queue\",[119,120,121,122],[],\"pvw.hidefeedbacks.queue\",[119,120,121,122],[],\"myPlaces\",\"Used to remember your saved places within a session.\",[119,120,121,122],[],\"CDWBrochureFormSubmitted\",\"Used for our commercial property details page, to store whether you have submitted a brochure request form. This helps to prevent you being re-prompted to complete the form again when interacting with the brochure.\",[119,120,121,122],[],\"patchId\",\"Used to display the relevant market share data for the members patch within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"pvw.hideproperties.queue\",[119,120,121,122],[],\"rma_code_verification_expiry\",\"Used to store the start time of a 10-minute countdown during multi-factor authentication (MFA) setup. This ensures the countdown continues accurately even if the user reloads the page.\",[119,120,121,122],[],\"rm_displayPhoneLeadWidget\",\"When you click to call about a property, a widget will appear showing you your most recent phone lead enquiries and prompting you as to whether you would like to add these to your sent enquiries.\",[119,120,121,122],[],\"pdwBrochureFormSubmitted\",\"Stores your brochure enquiry form submission to prevent you from seeing the same form again for the remaining session.\",[119,120,121,122],[],\"pdwBackLink\",\"Stores your search parameters when navigating back from the property details page. This allows you to return to the same search results as before.\",[119,120,121,122],[],\"page_history\",\"Used to store historic property details when previewing listings within our professional users' platform, Rightmove Plus.\",[119,120,121,122],[],\"msr:onBoardingCompleted\",\"Used to store whether the Market Share Reports tour has been dismissed within our professional users' site, Rightmove Plus, to determine whether to show it again or not.\",[119,120,121,122],[],[288,289,290,