167},{\"_153\":348,\"_155\":156,\"_157\":183,\"_49\":349,\"_160\":185,\"_162\":350,\"_164\":351,\"_166\":167},{\"_153\":344,\"_155\":156,\"_157\":183,\"_49\":345,\"_160\":185,\"_162\":346,\"_164\":347,\"_166\":167},\"savedPropertiesTooltipClosed\",\"Stores that you have closed the 'saved properties' tooltip so we don't keep showing it to you again.\",[119,120,121,122],[],\"intelligent-suggestion-feedback-sent\",\"Used to determine whether you are shown the option to provide feedback to us.\",[119,120,121,122],[],\"hasUserCompletedTour_admanager\",\"When you complete a tour, it stores a value to show this has been completed so we know whether to show you the tour or not.\",[119,120,121,122],[],\"RM.recentSearches_BUILD_TO_RENT\",\"Stores your recent searches for build to rent lettings\",[119,120,121,122],[120],\"local\",\"sct-whats-new-dialog-interactions\",\"Used to store how many times a Surveyor Comparable Tool announcement has been dismissed by our members within our professional users' site, Rightmove Plus so we know whether to display it or not in the future.\",[119,120,121,122],[],\"rma_resend_expiry\",\"Used to store the start time of a 60-second countdown during multi-factor authentication (MFA) setup when the user clicks the Resend button. This ensures the countdown continues accurately even if the user reloads the page or screen.\",[119,120,121,122],[],\"closed_clr_onboarding\",\"Used to store whether the  Company Level Reports announcement has been dismissed by our members within our professional users' site, Rightmove Plus so we know whether to display it or not in the future.\",[119,120,121,122],[],\"RM.conversationalAIState\",\"Stores stateful user interface information to improve the conversational AI experience.\",[120],[120],\"domainPrefix\",\"RIGHTMOVE.UTIL.userPreferences\",\"Stores the channel (lettings, sales etc) that you last searched in, for Draw a Search.\",[119,120,121,122],[],\"tenancy:filters\",\"Stores the dashboard filters selected within Tenancy Manager for members who use our professional users site, Rightmove Plus.\",[119,120,121,122],[],\"previewPropertyListing\",\"Stores propertyListingResponse in preview mode for page consumption. It updates during the commercial add/edit flow to let users preview changes. Will be replaced by an IndexedDB in the future.\",[119,120,121,122],[],\"pcrLocationList\",\"Stores your last 10 searches for postcodes across the site, used for your Price Comparison report.\",[119,120,121,122],[],\"manualAddTooltipClosed\",\"Stores that you have closed the tooltip explaining how to manually add properties to sent enquiries so that we don't keep showing it to you again.\",[119,120,121,122],[],\"RM.viewedArchiveableProperties\",\"Stores whether you have seen the archivable properties modal on sent enquiries so you can archive older enquiries you have sent.\",[119,120,121,122],[],\"sct-whats-new-notification\",\"Used to indicate if the member has interacted with the 'whats new' icon within our professional users' site, Rightmove Plus, so we know whether to continue highlighting a new notification.\",[119,120,121,122],[],\"recentlyViewedProperties\",\"Stores a list of up to 20 recently viewed properties to support the user in selecting a property for their mortgage application. This feature is only available if the user consents to functional cookies.\",[119,120,121,122],[],\"hjViewportId\",\"Stores user viewport details such as size and dimensions.\",[119,120,121,122],[],\"BRANCH_MARKETING_TOUR_FLAG\",\"Used to store whether the Branch Marketing tour has been dismissed in within our professional users' site, Rightmove Plus to improve page reload times.\",[119,120,121,122],[],\"rm-broker-context-data\",\"Used to remember your property details page calculator data to give you an affordability calculation\",[119,120,121,122],[120],\"hjActiveViewportIds\",\"Stores user active viewports IDs.\",[119,120,121,122],[],\"addCollaboratorTooltipClosed\",\"Used to make sure the user doesn't repeatedly see the add collaborator tooltip after dismissing it.\",[119,120,121,122],[120],\"RM.recentSearches_LETTING\",\"Stores your recent searches for letting property.\",[119,120,121,122],[],\"wholeOrderArchivedNotifications\",\"Used to store the IDs of 'archiving order data' notifications that were dismissed by our member within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"typeAheadHist\",\"Holds a history of locations you typed into search, so that these appear first in the list when you start searching again\",[119,120,121,122],[],\"_hjUserAttributes\",\"Stores User Attributes sent through the Hotjar Identify API.\",[119,120,121,122],[],\"tenancy_id\",\"Used to store the tenancy identifier to link to a reference within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"recentSearches_OVERSEAS\",\"Stores your recent searches for overseas property.\",[119,120,121,122],[],\"movingJourneyPrototype\",\"Used to track user’s progress on the moving journey diary studies.\",[119,120,121,122],[120],\"archivedNotifications\",\"Used to store the IDs of 'archiving applicants data' notifications that were dismissed by our member within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"ab.storage.\",\"prefixed\",\"Used to integrate with Braze.\",[119,120,121,122],[],\"sct-ribbon-state\",\"Used to store whether a Surveyor Comparable Tool announcement has been dismissed by our members within our professional users' site, Rightmove Plus so we know whether to display it or not in the future.\",[119,120,121,122],[],\"reportHistoryFilters\",\"Used to store details of what sorting or filtering options the member has selected in our Property Assessment Web tool, within our professional users' site, Rightmove Plus.  This improves usability of the page.\",[119,120,121,122],[],\"adManagerRecentBranchSearchHistory\",\"Holds a history of member branches you searched, so that these appear when you start searching again.\",[119,120,121,122],[],\"enquiredProperties\",\"Allows us to tell you that an enquiry has been sent and it is currently loading into your sent enquiries page.\",[119,120,121,122],[],\"ab.optOut\",[119,120,121,122],[],\"hasSeenCollaborationIntroModal\",\"Stores whether you have seen the announcement about the new collaboration feature so we know whether to show it again or not.\",[119,120,121,122],[],\"cup:announcementHidden:\",\"Used to store whether the Ad Manager announcement has been dismissed by our members within our professional users' site, Rightmove Plus so we know whether to display it or not in the future.\",[119,120,121,122],[],\"canceledNotifications\",\"Used to store the IDs of 'cancelled orders' notifications that were dismissed by our member within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"RM.recentSearches_STUDENTS\",\"Stores your recent searches for student lettings.\",[119,120,121,122],[],\"RM.recentSearches_BUYING\",\"Stores your recent searches for buying property.\",[119,120,121,122],[],\"rightmove.rm-page-breadcrumb\",\"Used for Clickstream tracking when activating a new member within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"referencingModalSeen\",\"We store this information to ensure we don't show the referencing completed modal more than once per device.\",[119,120,121,122],[120],\"addCommercialPropertyPage_visited\",\"Used to determine whether to show the onboarding modal for the new commercial add/edit flow in RightmovePlus.\",[119,120,121,122],[519],\"rmplus\",\"rmplus.rightmove.co.uk\",\"RM.recentSearches_COMMERCIAL_BUYING\",\"Stores your recent searches for commercial property to buy.\",[119,120,121,122],[],\"isReturnUser\",\"Used to know whether visitors are return users for Google Analytics within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"closed_ppg_dashboard_onboarding\",\"Used to store whether our Premium Price Guide announcement has been dismissed by our members within our professional users' site, Rightmove Plus so we know whether to display it or not in the future.\",[119,120,121,122],[],\"RM.viewedEnquiriesAnnouncement\",\"Stores whether you have seen the announcement about the sent enquiries feature so we know whether to show it again or not.\",[119,120,121,122],[],\"hasDeclinedProfileDataRequest\",\"Stores whether you have chosen to fill in profile questions later so we know whether to display them again or not.\",[119,120,121,122],[],\"searchLocation\",\"Used to store details of the location which the member has searched for in our Market Intelligence Centre within our professional users' site, Rightmove Plus to improve usability of the page.\",[119,120,121,122],[],\"cup:patchId\",\"Used to determine the previously selected  members patch preset for the Rightmove Plus dashboard page within our professional users' site, Rightmove Plus.\",[119,120,121,122],[],\"RM.recentSearches_COMMERCIAL_LETTING\",\"Stores your recent searches for commercial property to rent.\",[119,120,121,122],[],\"seenSavedPropChannelDropdownTooltip\",\"Stores that you have closed the tooltip explaining how to switch between channels on saved properties so that we don't keep showing it to you again.\",[119,120,121,122],[],\"historicalSearches\",\"Stores your recent searches so you can be displayed these.\",[119,120,121,122],[],\"allSearchCriteria\",\"Used to store our members search criteria in the Market Intelligence Centre within our professional users' site, Rightmove Plus to improve usability of the page.\",[119,120,121,122],[],\"admin-reports-\",\"Used to store details of the property, the email of the recipient and any comments in the Marketing Report within our professional user's site, Rightmove Plus to improve page reload times.\",[119,120,121,122],[],\"Rightmove-Profile-Banner\",\"Stores whether you have chosen to close the profile banner so we know whether to show it again or not.\",[119,120,121,122],[],[574,575,576