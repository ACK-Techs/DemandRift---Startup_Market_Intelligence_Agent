y":["www.rightmove.co.uk"],"expiration":"session","policyPrefix":"www"},{"definition":"savedsearch","type":"named","category":"strictly necessary","description":"Saves your search temporarily when you attempt to save a search without being logged in.","behaviour":"mandatory","domains":["rightmove.co.uk","www.rightmove.co.uk",".rightmove.co.uk",".www.rightmove.co.uk"],"policy":[],"expiration":"session"}],"defaultDomains":["rightmove.co.uk","www.rightmove.co.uk",".rightmove.co.uk",".www.rightmove.co.uk"]}},"elasticRum":{"enabled":true,"url":"https://rightmove-logging.apm.europe-west2.gcp.elastic-cloud.com","environment":"prod","transactionRate":0.01},"routeStaticData":{"wordpressContent":[{"label":"Property News","title":"What are the current UK mortgage rates?","excerpt":"Check the average 2 and 5-year fixed rates for a range of deposit sizes.","image":"https://www.rightmove.co.uk/news/content/uploads/2026/01/BoardwalkBristolResized-740x400.jpg","link":{"title":"Take a look","url":"https://www.rightmove.co.uk/news/articles/property-news/current-uk-mortgage-rates/","target":""},"title_filtered":"What are the current UK mortgage rates?","excerpt_filtered":"Check the average 2 and 5-year fixed rates for a range of deposit sizes."},{"label":"First-time buyers","title":"First-time homebuyer guides","excerpt":"Feel confident in what you can afford and understand the buying process.","image":"https://www.rightmove.co.uk/news/content/uploads/2026/05/FirstTimeBuyerGuides-740x400.jpg","link":{"title":"Take a look","url":"https://www.rightmove.co.uk/mortgages/guides/first-time-buyers/ ","target":""},"title_filtered":"First-time homebuyer guides","excerpt_filtered":"Feel confident in what you can afford and understand the buying process."}],"hideAppBanner":false}};</script><link rel="stylesheet" href="https://media.rightmove.co.uk/assets/7fb0c8adf9bad14b85d82c635308c18c/root-yrxIf1ZI.css"/><link rel="stylesheet" href="https://media.rightmove.co.uk/assets/7fb0c8adf9bad14b85d82c63