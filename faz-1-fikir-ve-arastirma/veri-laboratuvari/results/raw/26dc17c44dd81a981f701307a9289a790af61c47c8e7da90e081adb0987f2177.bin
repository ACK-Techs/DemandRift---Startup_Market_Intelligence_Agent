7-31T10:00:14.776Z"}},{"__typename":"Section2","title":null,"subtitle":null,"text":null,"label":null,"type":"reviews","layout":null,"mediaPosition":null,"removeStickyNav":false,"lottiePlayer":null,"vidyardId":null,"hideNav":false,"selectMedia":null,"rive":null,"navattic":null,"isTop":false,"reverseContent":false,"secondaryCta":null,"bannerType":null,"isFormPopupButton":false,"addForm":false,"hideBreadcrumbs":false,"json":{"button":null,"rating":null,"product":"zoominfo","addReviews":true},"isVideo":false,"video":null,"hideLabel":false,"form":null,"expandForm":null,"formButton":null,"popupButton":null,"logo":null,"link":null,"button":null,"richText":null,"image":null,"reviews":{"__typename":"Section2ReviewsCollection","items":[{"__typename":"Review","name":"Daniil K, Global Sales Development Manager","quote":"We migrated off of Drift and saw a ton of value","text":"ZoomInfo's website chat is an amazing tool set to build new playbooks fast and leverage existing playbooks to build faster.\"","rating":5,"link":"https://www.g2.com/products/zoominfo-marketingos/reviews/zoominfo-marketingos-review-4784116","image":{"__typename":"Asset","height":100,"width":100,"url":"https://images.ctfassets.net/kyld7105l6mt/678AOyM7abRKzaMwf1TQya/9ca9cb8101776be7632eba5251e01530/Daniil-k.jpeg"},"sys":{"__typename":"Sys","id":"5ytH9ucHWd1lz9qUXurQXS","publishedAt":"2026-08-29T05:25:05.686Z","firstPublishedAt":"2025-07-31T10:00:16.065Z"}},{"__typename":"Review","name":"Jenn S, Chief Marketing Officer","quote":"Knocked my socks off","text":"This is the ultimate website chat for an ABM shop. Native chat inside Slack with the ability for sales reps to invite anyone in the company to ask questions, great integrations with my tech stack - it feels like it has nearly everything.","rating":5,"link":"https://www.g2.com/products/zoominfo-marketingos/reviews/zoominfo-marketingos-review-4637738","image":{"__typename":"Asset","height":100,"width":100,"url":"https://images.ctfassets.net/kyld7105l6mt/6VQVTOHdGMsYa5RRMgVLrC/2b71d3a353fd028ebb2569d95a53ec2f/Jenn-S.webp"},"sys":{"__typename":"Sys","id":"3IlXEAjU8PeYDZhn3iVN1m","publishedAt":"2026-08-29T05:25:11.956Z","firstPublishedAt":"2025-07-31T10:00:18.567Z"}},{"__typename":"Review","name":"Lisa B, Co-Founder","quote":"The last chatbot you'll ever need","text":"The branching logic to given custom pathways for visitors (we have a diverse set target audiences), is the best I've seen in any chatbot to date!","rating":5,"link":"https://www.g2.com/products/zoominfo-marketingos/reviews/zoominfo-marketingos-review-4637843","image":{"__typename":"Asset","height":100,"width":100,"url":"https://images.ctfassets.net/kyld7105l6mt/4apyrh2fs0KhKT5Yg07kF3/cdb929bc26ff16b2a4230da0e4ea400f/Lisa-B.webp"},"sys":{"__typename":"Sys","id":"5PN0ZSLpy1j8c1bcHNAVCM","publishedAt":"2026-08-29T05:25:18.175Z","firstPublishedAt":"2025-07-31T10:00:21.242Z"}}]},"testimonials":{"__typename":"Section2TestimonialsCollection","items":[]},"cards":{"__typename":"Section2CardsCollection","items":[]},"planCards":{"__typename":"Section2PlanCardsCollection","items":[]},"links":{"__typename":"Section2LinksCollection","items":[]},"buttons":{"__typename":"Section2ButtonsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[{"__typename":"Asset","height":576,"width":500,"url":"https://images.ctfassets.net/kyld7105l6mt/1OS9cObhsl2Z0p26TexQFR/55ca5d4e623df45de6696b4da93893f2/Lead_Intelligence.png"},{"__typename":"Asset","height":576,"width":500,"url":"https://images.ctfassets.net/kyld7105l6mt/dXjwGpvFW4rbyQ4fBVMag/8f87a15707b90bc9bc21aaa2f710a2cd/Marketing_Account_Intelligence.png"},{"__typename":"Asset","height":576,"width":500,"url":"https://images.ctfassets.net/kyld7105l6mt/45D4jVTjGQZkD0a3BDnTSG/410dffda274388a85d56fafd4707faa6/Buyer_Intent.png"}]},"accordions":{"__typename":"Section2AccordionsCollection","items":[]},"sys":{"__typename":"Sys","id":"4ELmRTDY8ZuUPHEI6tzy3r","publishedAt":"2025-08-14T17:25:04.334Z","firstPublishedAt":"2025-07-31T10:00:24.307Z"}},{"__typename":"Section2","title":null,"subtitle":null,"text":null,"label":null,"type":"testimonials","layout":null,"mediaPosition":null,"removeStickyNav":false,"lottiePlayer":null,"vidyardId":null,"hideNav":false,"selectMedia":null,"rive":null,"navattic":null,"isTop":false,"reverseContent":false,"secondaryCta":null,"bannerType":null,"isFormPopupButton":false,"addForm":false,"hideBreadcrumbs":false,"json":null,"isVideo":false,"video":null,"hideLabel":false,"form":null,"expandForm":null,"formButton":null,"popupButton":null,"logo":null,"link":null,"button":null,"richText":null,"image":null,"reviews":{"__typename":"Section2ReviewsCollection","items":[]},"testimonials":{"__typename":"Section2TestimonialsCollection","items":[{"__typename":"Testimonial","title":"Compared to our previous vendor, we’re seeing 30% more engagement with ZoomInfo Chat.  With plug-and-play integrations, real-time insights, easy-to-use conversation builder, and a live meeting scheduler, it was like we had struck gold. \"","text":"ZoomInfo Chat checked all our boxes. With plug-and-play integrations, real-time insights, easy-to-use conversation builder, and a live meeting scheduler, it was like we had struck gold. ","authorName":"Alex Weihmann","authorTitle":"Marketing Manager, ChurnZero","hideQuoteIcon":null,"backgroundColorOptions":{"__typename":"BackgroundColor","backgroundColor":"neutral-800-bg"},"logo":{"__typename":"Asset","height":38,"width":275,"url":"https://images.ctfassets.net/kyld7105l6mt/5aoFlGC3tEm6JRh7i1EaUg/d0c3a167ab83d496c67281d4977f12ab/ChurnZero-Logo.svg"},"authorImage":{"__typename":"Asset","height":208,"width":208,"url":"https://images.ctfassets.net/kyld7105l6mt/5zK8XNaNn16an1zhOHxCcZ/51eaffd0bbac3a42df9c906e3bf8186d/alex-weihmann-img-dark.png"},"link":null,"sys":{"__typename":"Sys","id":"6F6bv6kjqRZ8Wbgh6bJkVx","publishedAt":"2026-08-28T22:29:26.798Z","firstPublishedAt":"2025-07-31T10:00:27.216Z"}}]},"cards":{"__typename":"Section2CardsCollection","items":[]},"planCards":{"__typename":"Section2PlanCardsCollection","items":[]},"links":{"__typename":"Section2LinksCollection","items":[]},"buttons":{"__typename":"Section2ButtonsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"accordions":{"__typename":"Section2AccordionsCollection","items":[]},"sys":{"__typename":"Sys","id":"48dZcowVXDjAvrkVqzF9bU","publishedAt":"2025-07-31T10:00:27.690Z","firstPublishedAt":"2025-07-31T10:00:27.690Z"}},{"__typename":"Section2","title":"Get Answers: Conversational Sales \u0026 Marketing FAQs","subtitle":null,"text":null,"label":null,"type":"faqAccordion","layout":null,"mediaPosition":null,"removeStickyNav":false,"lottiePlayer":null,"vidyardId":null,"hideNav":false,"selectMedia":null,"rive":null,"navattic":null,"isTop":false,"reverseContent":false,"secondaryCta":null,"bannerType":null,"isFormPopupButton":false,"addForm":false,"hideBreadcrumbs":false,"json":null,"isVideo":false,"video":null,"hideLabel":false,"form":null,"expandForm":null,"formButton":null,"popupButton":null,"logo":null,"link":null,"button":null,"richText":null,"image":null,"reviews":{"__typename":"Section2ReviewsCollection","items":[]},"testimonials":{"__typename":"Section2TestimonialsCollection","items":[]},"cards":{"__typename":"Section2CardsCollection","items":[{"__typename":"Card","json":null,"text":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eA conversational marketing platform is software that allows you to talk to prospective leads on social media or when they visit your website. This is a critical time to get your prospects’ attention.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eConversational marketing software and conversational sales software create an instant connection between your business and your potential buyers at the exact time they’re the most interested — when they’ve intentionally visited your website. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eLive chat platforms allow you to answer questions or guide your prospects to your latest product launches and timely offers — all in real time. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eWhat else can a conversational marketing platform do for you? Learn more about \u003c/span\u003e\u003ca href=\"https://pipeline.zoominfo.com/marketing/what-is-conversational-marketing\"\u003e\u003cspan style=\"font-weight: 400;\"\u003ehow chat can turn visitors into buyers\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"font-weight: 400;\"\u003e. \u003c/span\u003e\u003c/p\u003e\n","title":"What is a conversational marketing platform?","subtitle":null,"cardType":"faq","label":null,"quote":null,"addChecklist":false,"position":null,"hideLink":false,"link":null,"image":null,"logo":null,"subsections":{"__typename":"CardSubsectionsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"testimonial":null,"vidyardId":null,"lottiePlayer":null},{"__typename":"Card","json":null,"text":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eExamples of conversational marketing include chatbots with pre-populated answers to frequently asked questions. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eConversational marketing also comes in the form of sales chatbots that can complete a transaction or book an appointment. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBusinesses can also leverage a live chat component to connect sales or support staff with prospects one-on-one. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eRead up on \u003c/span\u003e\u003ca href=\"https://pipeline.zoominfo.com/marketing/arjun-pillai-zoominfo-chat\"\u003e\u003cspan style=\"font-weight: 400;\"\u003ehow ZoomInfo’s Chat platform works\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"font-weight: 400;\"\u003e.\u003c/span\u003e\u003c/p\u003e\n","title":"What is an example of conversational marketing?","subtitle":null,"cardType":"faq","label":null,"quote":null,"addChecklist":false,"position":null,"hideLink":false,"link":null,"image":null,"logo":null,"subsections":{"__typename":"CardSubsectionsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"testimonial":null,"vidyardId":null,"lottiePlayer":null},{"__typename":"Card","json":null,"text":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eOne of the biggest benefits of conversational marketing platforms is the ability to engage potential customers in real time, earlier in the buying process. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eThis allows you to shorten your sales cycle, increase close rates and prioritize the customer experience. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eInstead of asking your prospects to fill out forms or make a phone call, you can engage them with personalized communication in real time \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eand\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e on their timeline.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eThinking about implementing conversational marketing for your business? Read the \u003c/span\u003e\u003ca href=\"https://pipeline.zoominfo.com/marketing/choosing-right-chat-platform\"\u003e\u003cspan style=\"font-weight: 400;\"\u003ebuyer’s guide to choosing the right chat platform\u003c/span\u003e\u003c/a\u003e\u003cspan style=\"font-weight: 400;\"\u003e. \u003c/span\u003e\u003c/p\u003e\n","title":"What are the benefits of conversational marketing?","subtitle":null,"cardType":"faq","label":null,"quote":null,"addChecklist":false,"position":null,"hideLink":false,"link":null,"image":null,"logo":null,"subsections":{"__typename":"CardSubsectionsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"testimonial":null,"vidyardId":null,"lottiePlayer":null},{"__typename":"Card","json":null,"text":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChatbots help sales by showing you who is on your website, qualifying your potential customers, and connecting them to your sales reps right away. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChatbots can save your potential customers time by answering questions, guiding them to the right solutions, and even booking meetings. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBy automating some of these motions, chatbots make your sales team more efficient. This allows your sales reps to focus more on relationship-building and less on administrative tasks.  \u003c/span\u003e\u003c/p\u003e\n","title":"How do chatbots help sales? ","subtitle":null,"cardType":"faq","label":null,"quote":null,"addChecklist":false,"position":null,"hideLink":false,"link":null,"image":null,"logo":null,"subsections":{"__typename":"CardSubsectionsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"testimonial":null,"vidyardId":null,"lottiePlayer":null}]},"planCards":{"__typename":"Section2PlanCardsCollection","items":[]},"links":{"__typename":"Section2LinksCollection","items":[]},"buttons":{"__typename":"Section2ButtonsCollection","items":[]},"images":{"__typename":"AssetCollection","items":[]},"accordions":{"__typename":"Section2AccordionsCollection","items":[]},"sys":{"__typename":"Sys","id":"1FTNCReTcBr03YfI2tJKyi","publishedAt":"2026-08-29T02:47:10.975Z","firstPublishedAt":"2025-07-31T10:00:36.464Z"}},{"__typename":"Section2","title":"LIVE CHAT","subtitle":"Accelerate primed to buy leads to the finish line.","text":"\u003cp\u003eGet instant alerts when ideal leads or existing customers are on your website, then kick off the conve