AN-cBLpOj-size-2 c-PJLV-iiaMOGV-css">Unlimited</span></span></td><td class="c-boMPVq"><span class="c-LrTUv"><span class="c-PJLV c-KxQAN c-KxQAN-cBLpOj-size-2 c-PJLV-iiaMOGV-css">Unlimited</span></span></td></tr><tr class="c-liGZFs"><th scope="row" class="c-gMhLWL"><span tabindex="0" data-state="closed" class="c-fRWQiy c-fRWQiy-kMBHLg-hasInfo-true">Offer Templates</span><p style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal" class="c-lcEjxv">Reusable offer letter templates with substitution tokens that auto-fill candidate, job, and offer details.</p></th><td class="c-boMPVq"><span class="c-LrTUv"><span class="c-PJLV c-KxQAN c-KxQAN-cBLpOj-size-2 c-PJLV-iiaMOGV-css">Limited to 1 Template</span></span></td><td class="c-boMPVq"><span class="c-LrTUv"><span class="c-PJLV c-KxQAN c-KxQAN-cBLpOj-size-2 c-PJLV-iiaMOGV-css">Unlimited</span></span></td><td class="c-boMPVq"><span class="c-LrTUv"><span class="c-PJLV c-KxQAN c-KxQAN-cBLpOj-size-2 c-PJLV-iiaMOGV-css">Unlimited</span></span></td></tr><tr class="c-liGZFs"><th scope="row" class="c-gMhLWL"><span tabindex="0" data-state="closed" class="c-fRWQiy c-fRWQiy-kMBHLg-hasInfo-true">Offer Formula Fields</span><p style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal" class="c-lcEjxv">Custom offer fields that compute values with math or logic, usable in reporting and offer letter tokens.</p></th><td class="c-boMPVq"><span aria-label="Not included" class="c-fvJrVK c-fvJrVK-cHZnbS-inline-true c-fvJrVK-kWpDfM-size-1 c-fvJrVK-iknCAuN-css"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 