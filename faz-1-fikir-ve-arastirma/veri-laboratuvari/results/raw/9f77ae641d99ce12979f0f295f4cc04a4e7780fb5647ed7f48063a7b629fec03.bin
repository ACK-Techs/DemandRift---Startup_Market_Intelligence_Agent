SvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">Partners</span></a></div></div></div><div class="c-PJLV c-fixGjY c-PJLV-eKWVTQ-spacing-5"><h2 class="c-PJLV c-erPqIQ c-PJLV-kPsjaG-color-muted c-erPqIQ-faDtMC-size-1">Company</h2><div class="c-PJLV c-fixGjY c-PJLV-kdofoX-spacing-2"><div class="c-PJLV c-fixGjY c-PJLV-kdofoX-spacing-2 c-fixGjY-JrrAq-align-start"><a href="/story" class="c-cKrAvE c-cKrAvE-igOpguH-css"><span class="c-PJLV c-hSaSvL c-PJLV-djcNJv-color-dark c-hSaSvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">Our Story</span></a><a href="/careers" class="c-cKrAvE c-cKrAvE-igOpguH-css"><span class="c-PJLV c-hSaSvL c-PJLV-djcNJv-color-dark c-hSaSvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">Careers</span></a><a href="/team" class="c-cKrAvE c-cKrAvE-igOpguH-css"><span class="c-PJLV c-hSaSvL c-PJLV-djcNJv-color-dark c-hSaSvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">Team</span></a></div></div></div><div class="c-PJLV c-fixGjY c-PJLV-eKWVTQ-spacing-5"><h2 class="c-PJLV c-erPqIQ c-PJLV-kPsjaG-color-muted c-erPqIQ-faDtMC-size-1">Developers</h2><div class="c-PJLV c-fixGjY c-PJLV-kdofoX-spacing-2"><div class="c-PJLV c-fixGjY c-PJLV-kdofoX-spacing-2 c-fixGjY-JrrAq-align-start"><a href="https://developers.ashbyhq.com/" class="c-cKrAvE c-cKrAvE-igOpguH-css"><span class="c-PJLV c-hSaSvL c-PJLV-djcNJv-color-dark c-hSaSvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">API</span></a><a href="/resources/vulnerability-disclosure" class="c-cKrAvE c-cKrAvE-igOpguH-css"><span class="c-PJLV c-hSaSvL c-PJLV-djcNJv-color-dark c-hSaSvL-iMVRpC-size-3 c-PJLV-ijVJrOI-css">Vulnerability Disclosure</span></a></div></div></div></div></div></section></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"customerQuotes":[{"slug":"melissa-netgear","quoteText":"We needed an applicant tracking system that works for us. Ashby checked every box, from automation to AI to All-in-One visibility.","quoteAuthor":{"slug":"melissa-potter","name":"Melissa Potter","title":"Global Talent Acquisition Leader ","avatar":"/customers/champions/melissa-potter.jpeg","company":{"slug":"netgear","name":"NETGEAR","logo":"/customers/profiles/netgear.svg","founded":"1996","website":{"url":"https://www.netgear.com/","label":"Website"},"product":"Ashby All-In-One"}}},{"slug":"tom-dave","quoteText":"They weren’t just pitching us the All-in-One product, they were helping me build a stronger TA function.","quoteAuthor":{"slug":"tom-chapman","name":"Tom Chapman","title":"Head of TA","avatar":"/customers/champions/tom-chapman.jpeg","company":{"slug":"dave","name":"Dave","logo":"/customers/profiles/dave-customer-logo.png","founded":"2016","website":{"url":"https://dave.com/","label":"dave.com"},"product":"Ashby All-In-One"}}},{"slug":"will-innovative-solution","quoteText":"After 20 years in this industry, we're finally starting to see some real change to help and modernize every part of the recruiting process, and Ashby is absolutely leading this charge.","quoteAuthor":{"slug":"will-barnett","name":"Will Barnett","title":"Direct of Talent Acquisition","avatar":"/customers/champions/will-barnett.png","company":{"slug":"rad-ai","name":"Rad AI","logo":"/customers/profiles/radai.png","description":"The Generative Al Leader in Healthcare","founded":"2018","website":{"url":"https://www.radai.com/","label":"www.radai.com"},"product":null}},"quoteType":"ats"}],"pricingFAQ":[{"slug":"why_demo","question":"Why take a demo?","answer":"Your hiring processes and workflows are unique and critical to your entire team’s efficiency. We therefore feel it is important to invest a short amount of time upfront to ensure Ashby is the right fit to set you up for success. The call will quickly cover your hiring goals, give you a brief demo of the relevant product features and workflows, and allow you to assess whether we have the right solution. We are committed to transparent pricing so the above price will not change during the sales process.","testimonial":"Daniel Grayson, VP of Talent at Astronomer, recently told us that “We've been getting fantastic feedback from our recruiting team and hiring managers. Once Ashby is set up it removes a TON of friction from the experience for both candidates and managers.“"},{"slug":"pricing_work","question":"How does pricing work for startups?","answer":"Our startup pricing model is based on the size of your organization at that point of purchase, not on a seat or talent team basis. Startup plans also include 200 email lookups per month, and more can be purchased. Pricing is reassessed annually. The aim is to provide affordable usage so you can put the right tooling for scale in early. Once your organization exceeds 100 individuals in your workforce, we move to a custom pricing model so that we can consider the complexities of your business."},{"slug":"charge_module","question":"Does Ashby charge for each module?","answer":"No. With our All-in-One solution, it’s one price for the entire platform across ATS, Sourcing, CRM, Scheduling, and Analytics.","testimonial":"Camilla Lever, Director of People at Coder, shared that she “found Ashby to be the missing link between sourcing and staying on top of active candidates. I wanted to consolidate my tools, and this was a great way for me to combine Sourcing and CRM with an ATS.“ \u003ca href=\"https://www.ashbyhq.com/customers/coder\"\u003eRead how\u003c/a\u003e Coder consolidated their 4 tools into one with Ashby."},{"slug":"support_type","question":"What type of support does Ashby offer?","answer":"Our support team is available to help all customers via email and widely regarded as best-in-class. For more strategic questions around hiring excellence and implementation, we have a customer success team that can support you.","testimonial":"Chandon Lohdan, Hiring at CoinTracker, was kind enough to say about Ashby: “Best of all they have a strong \u0026 responsive support team, they make on-boarding super easy. I wish Ashby had been around when we launched so we could have just started with them from the beginning.“"},{"slug":"charge_impl","question":"Does Ashby charge for implementation?","answer":"Baseline onboarding resources and Customer Success support are included for every Ashby customer. For our largest and most sophisticated customers, implementation is priced as an Enterprise Implementation Service. Optional Professional Services are also available, with any additional scope and fees outlined upfront."},{"slug":"what_ats","question":"What ATS can I use Ashby Analytics with?","answer":"Greenhouse and Lever. We are integrating with new ATS tools currently, so please reach out if you are interested in a specific integration."},{"slug":"importing_spreadsheet","question":"How does importing data from my current ATS or spreadsheet work?","answer":"We provide an API integration with Greenhouse and Lever instances for a fast and robust data migration. You can expect data migration to take a day or two and our customer success team will then guide you on additional configuration options. We also offer a CSV import tool for structured candidate data coming from other ATSs or spreadsheets."},{"slug":"payment","question":"What are my payment options?","answer":"You can select a monthly or annual plan. Annual plans include 10% savings relative to the equivalent monthly option. Monthly plans require payment by credit card, while annual plans can be paid by credit card, direct deposit, and wire transfers."},{"slug":"charge_integration","question":"Do you charge for integrations?","answer":"No. And if we are missing an integration, we are happy to discuss adding it. Reach out to your Customer Success Manager or our \u003ca href=\"mailto:support@ashbyhq.com\"\u003eSupport Team\u003c/a\u003e to request an integration. You can learn more about our extensive integration ecosystem and and our \u003ca href=\"https://developers.ashbyhq.com/\" target=\"_blank\" ref=\"noopener noreferrer\"\u003eopen API here.\u003c/a\u003e"},{"slug":"referral_bonus","question":"Is there a referral bonus if we refer new customers?","answer":"Yes. If your referral becomes an Ashby customer and has come through your referral link (which can be found \u003ca href=\"https://app.ashbyhq.com/settings/refer-ashby\" target=\"_blank\"\u003ehere\u003c/a\u003e), we’ll send over a $200 Amazon gift card to both you and your referral."},{"slug":"cancel_plan","question":"How do I cancel my plan?","answer":"You can reach out to \u003ca href=\"mailto:support@ashbyhq.com\"\u003esupport@ashbyhq.com\u003c/a\u003e, or contact your dedicated customer success manager if you need to cancel your plan."}],"pricingFeatures":[{"_uid":"33e4061a-4220-401e-b489-767d33e11902","table":{"tbody":[{"_uid":"739398d1-6506-4a78-ba38-2d648b363b54","body":[{"_uid":"74f5a65b-3277-4e95-b37c-4f277c4db8b0","value":"Automated Sequences (Multi-Touch and Multi-Channel)","component":"_table_col"},{"_uid":"ad87573f-0572-4f01-94cc-53f0f543e04c","value":"Sends multi-stage candidate outreach across email and LinkedIn InMail or connection stages with scheduled follow-ups.","component":"_table_col"},{"_uid":"4e0130cd-e54f-4d6f-b6cb-a48765db74d9","value":"Yes","component":"_table_col"},{"_uid":"1ab5ff9d-cecc-4913-8611-56a28f03e1cb","value":"Yes","component":"_table_col"},{"_uid":"8d36e456-2e26-4b88-b9c8-d96cf085da0d","value":"Yes","component":"_table_col"}],"component":"_table_row"},{"_uid":"55671afe-ddba-4143-8850-3589e29fa1aa","body":[{"_uid":"cefb148b-e1e1-4336-b953-c8354ca1feda","value":"Shared Sequences, Bulk Send, Send on Behalf Of","component":"_table_col"},{"_uid":"a36e79ec-6140-4eb4-8267-9b75d404f7c1","value":"Share sequence templates across the team, enroll candidates in bulk, and send on behalf of other users.","component":"_table_col"},{"_uid":"d4e2c7bb-16f1-473f-bc32-dc5da9fe0ebb","value":"Yes","component":"_table_col"},{"_uid":"548c3424-7709-482a-9fdc-08d72dfe71ff","value":"Yes","component":"_table_col"},{"_uid":"3a18b3d1-b8c6-4476-a41b-5913c433ad60","value":"Yes","component":"_table_col"}],"component":"_table_row"},{"_uid":"bff60ddc-2603-4382-953d-28ea7fb85c77","body":[{"_uid":"9063e8bf-53b0-4fbe-b20a-4d60a8feed46","value":"Sourcing Chrome Extension","component":"_table_col"},{"_uid":"7f67a0f4-e5fa-4945-8215-e788995171de","value":"Source candidates directly from your browser and add them to Ashby, enroll in sequences, and consider for jobs.","component":"_table_col"},{"_uid":"b1cae0d1-9e30-464b-aac9-ff0c0285fd1a","value":"Yes","component":"_table_col"},{"_uid":"d959c7a8-b542-4551-915e-e6b2d9c15b23","value":"Yes","component":"_table_col"},{"_uid":"a9bd5ad5-c2bf-4db5-8ce2-42e196813b1f","value":"Yes","component":"_table_col"}],"component":"_table_row"},{"_uid":"609faf12-f9f2-41f8-aa6b-d28e5d32ddc6","body":[{"_uid":"9d7f958e-a357-40a9-9386-30e29fdc58d2","value":"Sourcing Projects","component":"_table_col"},{"_uid":"0ce92567-77b7-4c40-9b59-ef8a06292f46","value":"Organizes prospects you're not actively interviewing into talent pools for emailing, sequencing, and considering for future roles.","component":"_table_col"},{"_uid":"2098101d-b259-45b3-aac5-6f8f0ae254ea","value":"Yes","component":"_table_col"},{"_uid":"ac63c084-acb0-404a-b3d5-fb42a5cbcfe2","value":"Yes","component":"_table_col"},{"_uid":"0f42476d-e789-4199-a09e-64ba2fb3c656","value":"Yes","component":"_table_col"}],"component":"_table_row"},{"_uid":"f559ff42-b56a-4128-acb2-7a4adc5f12f9","body":[{"_uid":"f1fe1ee8-c867-4475-9552-d186d801cb46","value":"Candidate Search (including Advanced Filters)","component":"_table_col"},{"_uid":"12257d6b-da23-4a82-9746-5079697a0082","value":"Basic, advanced, and Boolean filters, saves searches, and runs bulk actions on results.","component":"_table_col"},{"_uid":"d4abebea-ebcb-4d0c-a511-1f0130f9b817","value":"Yes","component":"_table_col"},{"_uid":"957b4ab3-ecd9-444b-850a-cb6e5c146d9f","value":"Yes","component":"_table_col"},{"_uid":"822f19cc-5f95-474c-b150-dfb81fe87b10","value":"Yes","component":"_table_col"}],"component":"_table_row"},{"_uid":"1ea3a9b7-2d3d-4d26-8c77-f2723a25bf8e