7 8.14645 11.1464L11.2929 8H2.5C2.22386 8 2 7.77614 2 7.5C2 7.22386 2.22386 7 2.5 7H11.2929L8.14645 3.85355C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span></span></a></div></div></div><div style="opacity:0;will-change:transform,opacity;transform:translateY(8%)" class="c-PJLV c-fixGjY c-PJLV-kJJwbO-spacing-7 c-PJLV-icxfUmi-css"><div class="c-PJLV c-fixGjY c-PJLV-eKWVTQ-spacing-5 c-PJLV-ibVmQYH-css"><div class="c-PJLV c-fixGjY c-PJLV-eKWVTQ-spacing-5"><div class="c-PJLV c-iSwBqf c-PJLV-fVlWzK-spacing-3 c-iSwBqf-jroWjL-align-center"><span class="c-fvJrVK c-fvJrVK-hFitLN-size-4"><span style="box-sizing:border-box;display:inline-block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative;max-width:100%"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;max-width:100%"><img style="display:block;max-width:100%;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0" alt="" aria-hidden="true" src="data:image/svg+xml,%3csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20version=%271.1%27%20width=%2788%27%20height=%2788%27/%3e"/></span><img alt="AI Notetaker" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" decoding="async" data-nimg="intrinsic" class="c-PJLV" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%"/><noscript><img alt="AI Notetaker" loading="lazy" decoding="async" data-nimg="intrinsic" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%" class="c-PJLV" srcSet="/_next/image?url=%2Fimages%2FAINotetaker%402x.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2FAINotetaker%402x.png&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2FAINotetaker%402x.png&amp;w=256&amp;q=75"/></noscript></span></span><h2 class="c-PJLV c-erPqIQ c-erPqIQ-jgiWaE-size-5">AI Notetaker</h2></div><p class="c-PJLV c-hSaSvL c-hSaSvL-iMVRpC-size-3">Ashby&#x27;s AI Notetaker records, transcribes, and summarizes your interviews. Designed so you can fully engage candidates, deliver higher-quality feedback, and make faster, more confident hiring decisions.</p></div><div class="c-PJLV c-iSwBqf c-PJLV-iSZeJd-spacing-4 c-iSwBqf-bICGYT-justify-center c-iSwBqf-jroWjL-align-center c-PJLV-icyWVEJ-css"><a href="/add-ons/ai-notetaker" class="c-efuyxN c-efuyxN-hJjffa-color-primary"><span class="c-PJLV c-iSwBqf c-PJLV-kdofoX-spacing-2 c-iSwBqf-jroWjL-align-center c-iSwBqf-cHZnbS-inline-true"><span class="c-lesPJm">Learn more</span><span class="c-fvJrVK c-fvJrVK-RExwg-size-em"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.14645 3.14645C8.34171 2.95118 8.65829 2.95118 8.85355 3.14645L12.8536 7.14645C13.0488 7.34171 13.0488 7.65829 12.8536 7.85355L8.85355 11.8536C8.65829 12.0488 8.34171 12.0488 8.14645 11.8536C7.95118 11.6583 7.95118 11.3417 8.14645 11.1464L11.2929 8H2.5C2.22386 8 2 7.77614 2 7.5C2 7.22386 2.22386 7 2.5 7H11.2929L8.14645 3.85355C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span></span></a></div></div></div></div></div></div></section><section class="c-PJLV c-PJLV-eRbzmG-size-3 c-byLGmG c-byLGmG-icmpvrW-css"><div class="c-durDQG c-PJLV c-PJLV-dzcdLJ-size-default"><div aria-live="polite" role="region" class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0"><div data-component="Pagination" class="c-lesPJm c-lesPJm-ihTYUSm-css"><div class="c-lesPJm c-lesPJm-idDlQPH-css"><div class="c-lesPJm c-lesPJm-igTTwil-css"><button class="c-cKrAvE c-cKrAvE-icLSTdP-css isActive" role="tab" aria-label="NETGEAR Testimonial" aria-expanded="true" aria-controls="netgear-testimonial-region"><div class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center"><img src="/customers/profiles/netgear.svg" alt="NETGEAR" height="100" style="transform:scale(1)" class="c-PJLV c-kSvhLY c-kSvhLY-duYSPQ-size-3"/><div class="c-fpMFcS c-nNXAK"><div style="transform:scaleX(0)" class="c-gcwkSn"></div></div></div></button></div><div class="c-lesPJm c-lesPJm-igTTwil-css"><button class="c-cKrAvE c-cKrAvE-icLSTdP-css" role="tab" aria-label="Dave Testimonial" aria-expanded="false" aria-controls="dave-testimonial-region"><div class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center"><img src="/customers/profiles/dave-customer-logo.png" alt="Dave" height="100" style="transform:scale(1)" class="c-PJLV c-kSvhLY c-kSvhLY-duYSPQ-size-3"/></div></button></div><div class="c-lesPJm c-lesPJm-igTTwil-css"><button class="c-cKrAvE c-cKrAvE-icLSTdP-css" role="tab" aria-label="Rad AI Testimonial" aria-expanded="false" aria-controls="rad-ai-testimonial-region"><div class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center"><img src="/customers/profiles/radai.png" alt="Rad AI" height="100" style="transform:scale(1)" class="c-PJLV c-kSvhLY c-kSvhLY-duYSPQ-size-3"/></div></button></div></div></div><div class="c-dKbsSX"><blockquote aria-hidden="false" aria-expanded="true" class="c-PJLV c-fixGjY c-cGMevF c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center active" role="tabpanel" tabindex="-1" id="netgear-testimonial-region"><p class="c-hinMwX">We needed an applicant tracking system that works for us. Ashby checked every box, from automation to AI to All-in-One visibility.</p><footer class="c-PJLV c-iSwBqf c-PJLV-dCpVsf-spacing-6 c-iSwBqf-bICGYT-justify-center c-iSwBqf-jroWjL-align-center"><div class="c-eOJMKX c-eOJMKX-feUgXn-size-2 c-eOJMKX-hcDfaR-bordered-true c-eOJMKX-bStVNv-size-3 c-eOJMKX-ihoCJyY-css"><span style="box-sizing:border-box;display:block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;padding-top:100%"></span><img alt="Melissa Potter" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" decoding="async" data-nimg="responsive" class="c-PJLV" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%"/><noscript><img alt="Melissa Potter" loading="lazy" decoding="async" data-nimg="responsive" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%" class="c-PJLV" sizes="100vw" srcSet="/_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fcustomers%2Fchampions%2Fmelissa-potter.jpeg&amp;w=3840&amp;q=75"/></noscript></span></div><div class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0 c-fixGjY-JrrAq-align-start"><p class="c-PJLV c-hSaSvL c-PJLV-hJuKPH-color-heading c-hSaSvL-jHjtjI-weight-heading c-hSaSvL-iMVRpC-size-3">Melissa Potter</p><p class="c-PJLV c-hSaSvL c-hSaSvL-cBLpOj-size-2">Global Talent Acquisition Leader <!-- --> at <cite class="c-PJLV c-KxQAN c-PJLV-hJuKPH-color-heading c-KxQAN-jHjtjI-weight-heading">NETGEAR</cite></p></div></footer></blockquote><blockquote aria-hidden="true" aria-expanded="false" class="c-PJLV c-fixGjY c-cGMevF c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center went-right" role="tabpanel" tabindex="-1" id="dave-testimonial-region"><p class="c-hinMwX">They weren’t just pitching us the All-in-One product, they were helping me build a stronger TA function.</p><footer class="c-PJLV c-iSwBqf c-PJLV-dCpVsf-spacing-6 c-iSwBqf-bICGYT-justify-center c-iSwBqf-jroWjL-align-center"><div class="c-eOJMKX c-eOJMKX-feUgXn-size-2 c-eOJMKX-hcDfaR-bordered-true c-eOJMKX-bStVNv-size-3 c-eOJMKX-ihoCJyY-css"><span style="box-sizing:border-box;display:block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;padding-top:100%"></span><img alt="Tom Chapman" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" decoding="async" data-nimg="responsive" class="c-PJLV" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%"/><noscript><img alt="Tom Chapman" loading="lazy" decoding="async" data-nimg="responsive" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%" class="c-PJLV" sizes="100vw" srcSet="/_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fcustomers%2Fchampions%2Ftom-chapman.jpeg&amp;w=3840&amp;q=75"/></noscript></span></div><div class="c-PJLV c-fixGjY c-PJLV-gCTusx-spacing-0 c-fixGjY-JrrAq-align-start"><p class="c-PJLV c-hSaSvL c-PJLV-hJuKPH-color-heading c-hSaSvL-jHjtjI-weight-heading c-hSaSvL-iMVRpC-size-3">Tom Chapman</p><p class="c-PJLV c-hSaSvL c-hSaSvL-cBLpOj-size-2">Head of TA<!-- --> at <cite class="c-PJLV c-KxQAN c-PJLV-hJuKPH-color-heading c-KxQAN-jHjtjI-weight-heading">Dave</cite></p></div></footer></blockquote><blockquote aria-hidden="true" aria-expanded="false" class="c-PJLV c-fixGjY c-cGMevF c-PJLV-gCTusx-spacing-0 c-fixGjY-jroWjL-align-center went-right" role="tabpanel" tabindex="-1" id="rad-ai-testimonial-region"><p class="c-hinMwX">After 20 years in this industry, we're finally starting to see some real change to help and modernize every part of the recruiting process, and Ashby is absolutely leading this charge.</p><footer class="c-PJLV c-iSwBqf c-PJLV-dCpVsf-spacing-6 c-iSwBqf-bICGYT-justify-center c-iSwBqf-jroWjL-align-center"><div class="c-eOJMKX c-eOJMKX-feUgXn-size-2 c-eOJMKX-hcDfaR-bordered-true c-eOJMKX-bStVNv-size-3 c-eOJMKX-ihoCJyY-css"><span style="box-sizing:border-box;display:block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative"><span style="box-sizing:border-box;display:block;width:initial;height:initi