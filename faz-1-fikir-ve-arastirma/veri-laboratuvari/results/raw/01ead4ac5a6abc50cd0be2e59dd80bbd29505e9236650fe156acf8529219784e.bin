concept\" src=\"https://www.youtube.com/embed/k43KNpYvngc?rel=0\" style=\"top: 0; left: 0; width: 100%; height: 100%; position: absolute; border: 0;\" allowfullscreen scrolling=\"no\" allow=\"accelerometer *; clipboard-write *; encrypted-media *; gyroscope *; picture-in-picture *; web-share *;\" referrerpolicy=\"strict-origin\"\u003e\u003c/iframe\u003e\u003c/div\u003e\u003c/div\u003e\n\u003c/div\u003e\u003c/figure\u003e\n","placement":"default"}},{"__typename":"QuickPostResourceType","publishedAt":"2026-09-04T17:11:42+00:00","id":"dmcyOnF1aWNrUG9zdDo5OTAzNDA=","__isContentResourceInterface":"QuickPostResourceType","__isFeedContentResourceInterface":"QuickPostResourceType","wpId":990340,"globalId":"dmcyOnF1aWNrUG9zdDo5OTAzNDA","chorusId":null,"chorusUuid":null,"resourceType":"quickPost","site":{"isCrossCommunity":false,"wpId":2},"dek":{"html":""},"permalink":"https://www.theverge.com/tech/990340/insta360s-luna-pro-shoots-4k-vertical-video","title":"Insta360’s Luna Pro shoots 4K vertical video.","authors":[{"name":"Dominic Preston","path":"/authors/dominic-preston","id":"dmcyOmF1dGhvclByb2ZpbGU6MTI1","permalink":"https://www.theverge.com/authors/dominic-preston","title":"News Editor","profileImage":{"thumbnails":{"square":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2025/01/DOM_BLURPLE-1.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"}},"id":"dmcyOmltYWdlOjgxMzAyNA=="},"posts":{"edges":[{"node":{"__typename":"QuickPostResourceType","publishedAt":"2026-09-16T09:54:44+00:00","id":"dmcyOnF1aWNrUG9zdDo5OTYxNjA="}}]}}],"primaryCategory":{"title":"Tech","id":"dmcyOmNhdGVnb3J5OjU4"},"categories":[{"id":"dmcyOmNhdGVnb3J5OjQ5NA==","title":"Cameras","slug":"cameras","path":"/cameras"},{"id":"dmcyOmNhdGVnb3J5Ojk2","title":"Gadgets","slug":"gadgets","path":"/gadgets"},{"id":"dmcyOmNhdGVnb3J5OjMyNg==","title":"Hands-on","slug":"hands-on","path":"/hands-on"},{"id":"dmcyOmNhdGVnb3J5OjI5NzU=","title":"IFA 2026","slug":"ifa-berlin","path":"/ifa-berlin"},{"id":"dmcyOmNhdGVnb3J5OjMyNQ==","title":"Reviews","slug":"reviews","path":"/reviews"},{"id":"dmcyOmNhdGVnb3J5OjU4","title":"Tech","slug":"tech","path":"/tech"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"Insta360’s Luna Pro shoots 4K vertical video.","description":{"html":""},"image":null},"primaryCampaign":null,"ledeMedia":null,"comments":{"enabled":true,"mode":"standard"},"streams":{"nodes":[{"title":"IFA 2026: the biggest tech and gadget announcements","id":"dmcyOnN0cmVhbTo5ODYxNzg="}]},"blocks":[{"__typename":"CoreParagraphBlockType","__isBlockType":"CoreParagraphBlockType","paragraphContents":[{"html":"The Luna Pro is already out in China. We’re still waiting for a US launch, but it was on the company’s stand at IFA so I had a play. It’s single-lens, but can use the 8K sensor to capture 4K footage either landscape or portrait, and has the \u003ca href=\"https://www.theverge.com/tech/947218/insta360-luna-ultra-dual-camera-stabilized-8k-telephoto-leica-us-availability-pricing\"\u003eUltra\u003c/a\u003e’s detachable display too."}],"dropcap":false,"endmark":false,"lead":false}],"createdAt":"2026-09-04T16:57:37+00:00","excludedFromHomepage":false,"path":"/tech/990340/insta360s-luna-pro-shoots-4k-vertical-video","originalPublishedAt":"2026-09-04T17:11:42+00:00","updatedAt":null,"hasAffiliateLinks":false,"quickAttachment":{"__isBlockType":"ImageSliderBlockType","__typename":"ImageSliderBlockType","imagesOrientation":"horizontal","images":[{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eThe Luna Pro looks a lot like the Ultra, with similar controls.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-3.jpg?quality=90\u0026strip=all","originalHeight":2456,"originalWidth":3684,"thumbnails":{"original":{"normalizedRatio":1.5}},"id":"dmcyOmltYWdlOjk5MDM0NQ=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eUnlike the Ultra, it only has a single lens.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-1.jpg?quality=90\u0026strip=all","originalHeight":2731,"originalWidth":4096,"thumbnails":{"original":{"normalizedRatio":1.499817}},"id":"dmcyOmltYWdlOjk5MDM0Mw=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eVisuals are co-engineered with Leica again, who provided three color profiles too.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-2.jpg?quality=90\u0026strip=all","originalHeight":2720,"originalWidth":4080,"thumbnails":{"original":{"normalizedRatio":1.5}},"id":"dmcyOmltYWdlOjk5MDM0NA=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eYou can still detach the display to use it as a remote.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-4.jpg?quality=90\u0026strip=all","originalHeight":2619,"originalWidth":3929,"thumbnails":{"original":{"normalizedRatio":1.500191}},"id":"dmcyOmltYWdlOjk5MDM0Ng=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eIt comes in black too, and shoots native 4K vertical video.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-5.jpg?quality=90\u0026strip=all","originalHeight":2515,"originalWidth":3772,"thumbnails":{"original":{"normalizedRatio":1.499801}},"id":"dmcyOmltYWdlOjk5MDM0Nw=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":"Photo: Dominic Preston / The Verge"},"caption":{"html":"\u003cem\u003eAn NFC tag in the camera head can open the Insta360 app with a tap for quicker file transfer, though the “Kiss \u0026 Fly” name is questionable at best.\u003c/em\u003e"},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/insta360-luna-pro-6.jpg?quality=90\u0026strip=all","originalHeight":2557,"originalWidth":3836,"thumbnails":{"original":{"normalizedRatio":1.500196}},"id":"dmcyOmltYWdlOjk5MDM1MA=="}}],"placement":"default"}},{"__typename":"QuickPostResourceType","publishedAt":"2026-09-03T16:00:00+00:00","id":"dmcyOnF1aWNrUG9zdDo5ODg5NzM=","__isContentResourceInterface":"QuickPostResourceType","__isFeedContentResourceInterface":"QuickPostResourceType","wpId":988973,"globalId":"dmcyOnF1aWNrUG9zdDo5ODg5NzM","chorusId":null,"chorusUuid":null,"resourceType":"quickPost","site":{"isCrossCommunity":false,"wpId":2},"dek":{"html":""},"permalink":"https://www.theverge.com/tech/988973/lenovo-made-an-incredibly-lappable-detachable-tablet-keyboard","title":"Lenovo made an incredibly lappable detachable tablet keyboard.","authors":[{"name":"Sean Hollister","path":"/authors/sean-hollister","id":"dmcyOmF1dGhvclByb2ZpbGU6MzQz","permalink":"https://www.theverge.com/authors/sean-hollister","title":"Senior Editor","profileImage":{"thumbnails":{"square":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2025/01/Sean_BLURPLE.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"}},"id":"dmcyOmltYWdlOjkxMTcwMA=="},"posts":{"edges":[{"node":{"__typename":"QuickPostResourceType","publishedAt":"2026-09-17T23:46:20+00:00","id":"dmcyOnF1aWNrUG9zdDo5OTczMjc="}}]}}],"primaryCategory":{"title":"Tech","id":"dmcyOmNhdGVnb3J5OjU4"},"categories":[{"id":"dmcyOmNhdGVnb3J5Ojk2","title":"Gadgets","slug":"gadgets","path":"/gadgets"},{"id":"dmcyOmNhdGVnb3J5OjMyNg==","title":"Hands-on","slug":"hands-on","path":"/hands-on"},{"id":"dmcyOmNhdGVnb3J5OjI5NzU=","title":"IFA 2026","slug":"ifa-berlin","path":"/ifa-berlin"},{"id":"dmcyOmNhdGVnb3J5OjUzNA==","title":"Laptops","slug":"laptops","path":"/laptops"},{"id":"dmcyOmNhdGVnb3J5OjUzMw==","title":"Lenovo","slug":"lenovo","path":"/lenovo"},{"id":"dmcyOmNhdGVnb3J5OjMyNQ==","title":"Reviews","slug":"reviews","path":"/reviews"},{"id":"dmcyOmNhdGVnb3J5OjU4","title":"Tech","slug":"tech","path":"/tech"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"Lenovo made an incredibly lappable detachable tablet keyboard.","description":{"html":""},"image":{"thumbnails":{"horizontal":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132930_0034_D.jpg?quality=90\u0026strip=all\u0026crop=7.8125,0,84.375,100"},"square":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132930_0034_D.jpg?quality=90\u0026strip=all\u0026crop=21.875,0,56.25,100"}},"id":"dmcyOmltYWdlOjk4ODk4NQ=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132930_0034_D.jpg?quality=90\u0026strip=all\u0026crop=7.8125,0,84.375,100"},"square":{"url":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132930_0034_D.jpg?quality=90\u0026strip=all\u0026crop=21.875,0,56.25,100"}},"id":"dmcyOmltYWdlOjk4ODk4NQ=="}},"comments":{"enabled":true,"mode":"standard"},"streams":{"nodes":[{"title":"IFA 2026: the biggest tech and gadget announcements","id":"dmcyOnN0cmVhbTo5ODYxNzg="}]},"blocks":[{"__typename":"CoreParagraphBlockType","__isBlockType":"CoreParagraphBlockType","paragraphContents":[{"html":"I am largely uninterested in Android tablets these days — and yet! This \u003ca href=\"https://news.lenovo.com/pressroom/press-releases/yoga-portfolio-new-ai-pcs-and-tablets/\"\u003ejust-announced\u003c/a\u003e Lenovo Yoga Tab Plus Gen 2 surprised me in person. Magnetically snaps right onto this “OneStep” keyboard frame, surprisingly excellent typing with 1.5mm key travel, firm non-slip leatherette base. Doesn’t open one-handed, though, and I’d like it better with a carry handle."}],"dropcap":false,"endmark":false,"lead":false}],"createdAt":"2026-09-03T00:30:15+00:00","excludedFromHomepage":false,"path":"/tech/988973/lenovo-made-an-incredibly-lappable-detachable-tablet-keyboard","originalPublishedAt":"2026-09-03T16:00:00+00:00","updatedAt":"2026-09-03T16:38:11+00:00","hasAffiliateLinks":false,"quickAttachment":{"__isBlockType":"ImageSliderBlockType","__typename":"ImageSliderBlockType","imagesOrientation":"original","images":[{"alt":"","hideCredit":false,"credit":{"plaintext":""},"caption":{"html":""},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132930_0034_D.jpg?quality=90\u0026strip=all","originalHeight":2160,"originalWidth":3840,"thumbnails":{"original":{"normalizedRatio":1.777778}},"id":"dmcyOmltYWdlOjk4ODk4NQ=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":""},"caption":{"html":""},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132947_0035_D.jpg?quality=90\u0026strip=all","originalHeight":1917,"originalWidth":3409,"thumbnails":{"original":{"normalizedRatio":1.778299}},"id":"dmcyOmltYWdlOjk4ODk4MQ=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":""},"caption":{"html":""},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819132821_0028_D.jpg?quality=90\u0026strip=all","originalHeight":2160,"originalWidth":3840,"thumbnails":{"original":{"normalizedRatio":1.777778}},"id":"dmcyOmltYWdlOjk4ODk4Mw=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":""},"caption":{"html":""},"image":{"originalUrl":"https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/DJI_20260819133022_0038_D.jpg?quality=90\u0026strip=all","originalHeight":2160,"originalWidth":3840,"thumbnails":{"original":{"normalizedRatio":1.777778}},"id":"dmcyOmltYWdlOjk4ODk4NA=="}},{"alt":"","hideCredit":false,"credit":{"plaintext":""},"capti