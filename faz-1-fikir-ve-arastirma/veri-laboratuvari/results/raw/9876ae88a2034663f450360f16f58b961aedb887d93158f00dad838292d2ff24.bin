  <div class="shared-terms_reacceptance_modal_component__overlay shared-terms_reacceptance_modal_component__hidden"
     data-controller="terms-reacceptance-modal"
     data-terms-reacceptance-modal-submit-path-value="/my/terms"
     data-terms-reacceptance-modal-noscroll-class="shared-terms_reacceptance_modal_component__noscroll"
     data-terms-reacceptance-modal-hidden-class="shared-terms_reacceptance_modal_component__hidden">
  <div class="shared-terms_reacceptance_modal_component__modal"
       data-terms-reacceptance-modal-target="dialog"
       tabindex="-1"
       role="dialog"
       aria-modal="true"
       aria-labelledby="terms-reacceptance-modal-title"
       aria-describedby="terms-reacceptance-modal-subtitle">
    <div class="shared-terms_reacceptance_modal_component__header">
      <h2 id="terms-reacceptance-modal-title" class="shared-terms_reacceptance_modal_component__title">Terms &amp; policies</h2>
      <p id="terms-reacceptance-modal-subtitle" class="shared-terms_reacceptance_modal_component__subtitle">To continue, please review and accept Envato’s Terms &amp; policies.</p>
    </div>

    <div class="shared-terms_reacceptance_modal_component__agreeBand">
      <label class="shared-terms_reacceptance_modal_component__agree">
        <input type="checkbox"
               class="shared-terms_reacceptance_modal_component__checkbox"
               data-terms-reacceptance-modal-target="checkbox"
               data-action="change->terms-reacceptance-modal#toggleSubmit">
        <span>
          I agree to Envato’s
          <a target="_blank" rel="noopener" class="shared-terms_reacceptance_modal_component__link" href="https://www.envato.com/terms-policies">Terms &amp; policies</a>
          that apply to my use of Envato products.
        </span>
      </label>
    </div>

    <div class="shared-terms_reacceptance_modal_component__footer">
      <p class="shared-terms_reacceptance_modal_component__error shared-terms_reacceptance_modal_component__hidden"
         data-terms-reacceptance-modal-target="error"
         role="alert"
         aria-live="assertive">Something went wrong. Please try again.</p>

      <div class="shared-terms_reacceptance_modal_component__actions">
        <button type="button"
                class="shared-terms_reacceptance_modal_component__submit"
                data-terms-reacceptance-modal-target="submit"
                data-action="click->terms-reacceptance-modal#submit"
                disabled>
          Agree &amp; continue
        </button>
      </div>
    </div>
  </div>
</div>

