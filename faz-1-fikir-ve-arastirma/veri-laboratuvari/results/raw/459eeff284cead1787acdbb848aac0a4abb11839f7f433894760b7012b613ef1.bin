":\"Reranked results are distilled into information-rich snippets, so agents reason without wasting tokens on noise.\",\"eyebrow\":\"/search\",\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"Docs\"},\"title\":\"Retrieve fresh, reranked web context that agents can reason over.\"},{\"_key\":\"8addafdccb42bf94fabd5b641b03bed8\",\"accentColor\":null,\"description\":\"Pages are converted into agent-ready content that minimizes boilerplate and reduce downstream token usage.\",\"eyebrow\":\"/extract\",\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"Docs\"},\"title\":\"Extract web data without the noise.\"},{\"_key\":\"4dbb795b4d48\",\"accentColor\":null,\"description\":\"Perform comprehensive research on a given topic by conducting multiple searches, analyzing sources, and creating a detailed report.\",\"eyebrow\":\"/research\",\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/research\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"Docs\"},\"title\":\"Generate comprehensive research reports. \"},{\"_key\":\"f93eee7dcaf357c70ca50a96a6bab943\",\"accentColor\":null,\"description\":\"Map and extract entire sites using an explicit objective, producing stable, repeatable inputs for research pipelines and long-running agent flows.\",\"eyebrow\":\"/crawl\",\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/crawl\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"Docs\"},\"title\":\"Capture entire sites with intent.\"},{\"_key\":\"d9aeb39e61d1dc6b8d5f1e35c91f9d74\",\"accentColor\":null,\"description\":\"Generate normalized, deduplicated site graphs so agents know what pages exist, what’s reachable, and where to focus before fetching content.\",\"eyebrow\":\"/map\",\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/map\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"Docs\"},\"title\":\"Turn fragmented pages into site graphs.\"}],\"eyebrow\":\"/the endpoints\"},{\"_key\":\"7409eb7fd782\",\"_type\":\"module.featuresCards\",\"cards\":[{\"backgroundImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-67d277c725aaec9e95d747fd747ba178dd46b116-2560x1792-png\",\"_type\":\"reference\"},\"crop\":{\"_type\":\"sanity.imageCrop\",\"bottom\":0.6714821443791017,\"left\":0,\"right\":0.7281329728119901,\"top\":0},\"hotspot\":{\"_type\":\"sanity.imageHotspot\",\"height\":0.3285178556208983,\"width\":0.2718670271880099,\"x\":0.13593351359400496,\"y\":0.16425892781044915}},\"description\":\" AgentCore Tool Catalog\",\"icon\":null,\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://aws.amazon.com/marketplace/seller-profile?id=seller-mncovc7l7fqy2\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":null,\"text\":\"aws marketplace\"},\"tag\":\" \",\"tagColor\":\"#ff7300\",\"tagLogo\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-4c322aa55420a990c4c58fdafb2550c4ef7b97c6-800x478-png\",\"_type\":\"reference\"}},\"title\":\"AWS\"},{\"backgroundImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-67d277c725aaec9e95d747fd747ba178dd46b116-2560x1792-png\",\"_type\":\"reference\"},\"crop\":{\"_type\":\"sanity.imageCrop\",\"bottom\":0.6589320719338617,\"left\":0.7433316187887902,\"right\":0,\"top\":0},\"hotspot\":{\"_type\":\"sanity.imageHotspot\",\"height\":0.3410679280661383,\"width\":0.25666838121120983,