 type="video/webm"/>Your browser does not support the video tag.</video></div></div></div></section></div><div class="page-module"><section class="Endpoints-module-scss-module__PuSaJq__endpoints " style="--endpoint-accent:#79DEEB;--endpoint-accent-rgb:121, 222, 235"><div class="Endpoints-module-scss-module__PuSaJq__header"><p class="Endpoints-module-scss-module__PuSaJq__eyebrow">/the endpoints</p></div><div class="Endpoints-module-scss-module__PuSaJq__content"><div class="Endpoints-module-scss-module__PuSaJq__endpointList"><span class="Endpoints-module-scss-module__PuSaJq__floatingIndicator" style="transform:translateY(0px)"></span><button class="Endpoints-module-scss-module__PuSaJq__endpointItem Endpoints-module-scss-module__PuSaJq__active"><span class="Endpoints-module-scss-module__PuSaJq__inlineIndicator"></span><span class="Endpoints-module-scss-module__PuSaJq__endpointTitle">/search</span></button><hr class="Endpoints-module-scss-module__PuSaJq__divider"/><button class="Endpoints-module-scss-module__PuSaJq__endpointItem "><span class="Endpoints-module-scss-module__PuSaJq__inlineIndicator"></span><span class="Endpoints-module-scss-module__PuSaJq__endpointTitle">/extract</span></button><hr class="Endpoints-module-scss-module__PuSaJq__divider"/><button class="Endpoints-module-scss-module__PuSaJq__endpointItem "><span class="Endpoints-module-scss-module__PuSaJq__inlineIndicator"></span><span class="Endpoints-module-scss-module__PuSaJq__endpointTitle">/research</span></button><hr class="Endpoints-module-scss-module__PuSaJq__divider"/><button class="Endpoints-module-scss-module__PuSaJq__endpointItem "><span class="Endpoints-module-scss-module__PuSaJq__inlineIndicator"></span><span class="Endpoints-module-scss-module__PuSaJq__endpointTitle">/crawl</span></button><hr class="Endpoints-module-scss-module__PuSaJq__divider"/><button class="Endpoints-module-scss-module__PuSaJq__endpointItem "><span class="Endpoints-module-scss-module__PuSaJq__inlineIndicator"></span><span class="Endpoints-module-scss-module__PuSaJq__endpointTitle">/map</span></button></div><div class="Endpoints-module-scss-module__PuSaJq__visualArea Endpoints-module-scss-module__PuSaJq__hasImage"><div class="Endpoints-module-scss-module__PuSaJq__visualContent  "><img alt="Retrieve fresh, reranked web context that agents can reason over." loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/images/products/search.webp"/></div><div class="Endpoints-module-scss-module__PuSaJq__visualContent  Endpoints-module-scss-module__PuSaJq__hidden"><img alt="Extract web data without the noise." loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/images/products/extract.webp"/></div><div class="Endpoints-module-scss-module__PuSaJq__visualContent  Endpoints-module-scss-module__PuSaJq__hidden"><img alt="Generate comprehensive research reports. " loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/images/products/research.webp"/></div><div class="Endpoints-module-scss-module__PuSaJq__visualContent  Endpoints-module-scss-module__PuSaJq__hidden"><img alt="Capture entire sites with intent." loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/images/products/crawl.webp"/></div><div class="Endpoints-module-scss-module__PuSaJq__visualContent  Endpoints-module-scss-module__PuSaJq__hidden"><img alt="Turn fragmented pages into site graphs." loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/images/products/map.webp"/></di