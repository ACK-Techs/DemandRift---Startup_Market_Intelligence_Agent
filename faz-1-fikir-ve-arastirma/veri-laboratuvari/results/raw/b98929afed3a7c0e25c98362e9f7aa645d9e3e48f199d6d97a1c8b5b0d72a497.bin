ed\"},\"gpuRam\":{\"title\":\"GPU RAM (GiB)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"RAM for One GPU in Gibibytes\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"gpuTotalRam\":{\"title\":\"GPU Total RAM (GiB)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Total RAM in Gibibytes\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"osDiskSizeInMB\":{\"title\":\"OS Disk Size (GiB)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"In Gibibytes\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"resourceDiskSizeInMB\":{\"title\":\"Res Disk Size (GiB)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"In Gibibytes\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"maxDataDiskCount\":{\"title\":\"Max Disks\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"regionName\":{\"title\":\"Region\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"currency\":{\"title\":\"Currency\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"linuxPrice\":{\"title\":\"Linux Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"windowsPrice\":{\"title\":\"Windows Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"redHatEntPrice\":{\"title\":\"RHEL Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"redHatEntHaPrice\":{\"title\":\"RHEL HA Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"ubuntuProPrice\":{\"title\":\"Ubuntu Pro Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"slesPrice\":{\"title\":\"SLES Price\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Hours in a day - 24, hours in a month - 730, months per year - 12\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"pricePerMemoryLinux\":{\"title\":\"Price per Memory (Linux)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Price per 1 GiB, that could help you find the most valuable VM from a memory perspective.\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"pricePerCoreLinux\":{\"title\":\"Price per vCPU (Linux)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Price divided by the number of vCPU, that could help you find the most valuable VM from vCPU perspective.\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"pricePerCoreWindows\":{\"title\":\"Price per vCPU (Win)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Price divided by the number of vCPU, that could help you find the most valuable VM from vCPU perspective.\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"pricePerMemoryWindows\":{\"title\":\"Price per Memory (Win)\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Price per 1 GiB, that could help you find the most valuable VM from a memory perspective.\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"supportPremiumDisk\":{\"title\":\"Support Premium Disk\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"hyperVGen\":{\"title\":\"Hyper-V Generations\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Generation 2 VMs support key features that aren't supported in generation 1 VMs. These features include increased memory, Intel Software Guard Extensions (Intel SGX), and virtualized persistent memory (vPMEM).\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"cpuDesc\":{\"title\":\"Proccessor\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"perfScore\":{\"title\":\"Performance Score\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"CoreMark is a benchmark that tests the functionality of a microcontroller (MCU) or central processing unit (CPU). More information you can get on https://cloudprice.net/performance page\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"numaNodes\":{\"title\":\"NUMA Nodes\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Non-uniform memory access (NUMA) is a computer memory design used in multiprocessing, where the memory access time depends on the memory location relative to the processor.\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"maxNetInter\":{\"title\":\"Max Network Interfaces\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"rdmaEnabled\":{\"title\":\"RDMA Enabled\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Remote Direct Memory Access, or RDMA, is a technology that provides a low-latency network connection between processing running on two servers, or virtual machines in Azure\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"acceleratedNet\":{\"title\":\"Accelerated Net\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"This feature enable bypasses the host from the datapath, reducing latency, jitter, and CPU utilization, for use with the most demanding network workloads on supported VM types\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"combinedIOPS\":{\"title\":\"Combined IOPS\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Combined IOPS is a max of all attached disk's IOPs\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"uncachedDiskIOPS\":{\"title\":\"Uncached Disk IOPS\",\"sortable\":true,\"align\":\"right\",\"tooltip\":null,\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"combinedWriteBSecond\":{\"title\":\"Combined Write B/Sec\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Combined Write B/Sec is a max of all attached disk's Write B/Sec througthput\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"combinedReadBSecond\":{\"title\":\"Combined Read B/Sec\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Combined Read B/Sec is a max of all attached disk'sRead B/Sec througthput\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"acUs\":{\"title\":\"ACUs\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"Azure compute unit, provides a way of comparing compute (CPU) performance across Azure SKUs. This will help you easily identify which SKU is most likely to satisfy your performance needs. ACU is currently standardized on a Small (Standard_A1) VM being 100 and all other SKUs then represent approximately how much faster that SKU can run a standard benchmark\",\"control\":null,\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"__savingsOptions\":{\"title\":\"Savings Options\",\"sortable\":false,\"align\":\"center\",\"tooltip\":\"Compare pricing across different type of savings for particular instance\",\"control\":\"button\",\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"__alternativevms\":{\"title\":\"Alternative VMs\",\"sortable\":false,\"align\":\"center\",\"tooltip\":\"Best similar VMs based on number of vCPUs, memory and performance\",\"control\":\"button\",\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"bestPriceRegion\":{\"title\":\"Best Price Region / Diff\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"The cheapest region with that VM and the difference between current and the cheapest regions.\",\"control\":\"button\",\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"},\"bestSecondPriceRegion\":{\"title\":\"2nd Best Price Region / Diff\",\"sortable\":true,\"align\":\"right\",\"tooltip\":\"The 2nd cheapest region with that VM and the difference between current and the cheapest regions.\",\"control\":\"button\",\"hidden\":false,\"filterSection\":\"$undefined\",\"filterTitle\":\"$undefined\",\"filterUnit\":\"$undefined\"}},\"names\":[\"$$id\",\"name\",\"numberOfCores\",\"memoryInMB\",\"linuxPrice\",\"windowsPrice\",\"__alternativevms\",\"__savingsOptions\",\"bestPriceRegion\"],\"sort\":{\"sortField\":\"name\",\"sortOrder\":true}},\"total\":1429,\"rows\":[[\"Standard_A1_v2\",\"Standard_A1_v2\",1,2,\"0.0430\",\"0.0650\",\"find better\",\"compare\",\"West US 2 / -16.3%\"],[\"Standard_A2_v2\",\"Standard_A2_v2\",2,4,\"0.0903\",\"0.1360\",\"find better\",\"compare\",\"West US 2 / -16.3%\"],[\"Standard_A2m_v2\",\"Standard_A2m_v2\",2,16,\"0.1190\",\"0.1800\",\"find better\",\"compare\",\"West US 3 / -16.8%\"],[\"Standard_A4_v2\",\"Standard_A4_v2\",4,8,\"0.1910\",\"0.2860\",\"find better\",\"compare\",\"West US 3 / -16.8%\"],[\"Standard_A4m_v2\",\"Standard_A4m_v2\",4,32,\"0.2370\",\"0.3600\",\"find better\",\"compare\",\"West US 2 / -16%\"],[\"Standard_A8_v2\",\"Standard_A8_v2\",8,16,\"0.3990\",\"0.6000\",\"find better\",\"compare\",\"West US 3 / -16.5%\"],[\"Standard_A8m_v2\",\"Standard_A8m_v2\",8,64,\"0.4750\",\"0.7200\",\"find better\",\"compare\",\"West US 2 / -16.4%\"],[\"Standard_B12ms\",\"Standard_B12ms\",12,48,\"0.4990\",\"0.5470\",\"find better\",\"compare\",\"West US 3 / 0%\"],[\"Standard_B16als_v2\",\"Standard_B16als_v2\",16,32,\"0.5330\",\"0.6060\",\"find better\",\"compare\",\"Jio India West / -34.5%\"],[\"Standard_B16as_v2\",\"Standard_B16as_