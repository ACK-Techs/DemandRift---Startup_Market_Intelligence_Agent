<script>
// Mobile hamburger toggle. Bootstrap 5's collapse data-api is delegated on
// `document`, which iOS Safari intermittently fails to fire for (tap does
// nothing). Bind a DIRECT click listener on the toggler instead — direct
// listeners on the button are reliable on iOS — and drop `data-bs-toggle` so
// Bootstrap's data-api can't also fire (double-toggle) on browsers where it
// works. Visibility still rides on Bootstrap's own `.collapse:not(.show)` CSS.
(function () {
  function initNavToggle() {
    var togglers = document.querySelectorAll('#navigation-new .navbar-toggler[data-bs-target]');
    for (var i = 0; i < togglers.length; i++) {
      var btn = togglers[i];
      if (btn.dataset.navToggleBound) continue;
      var target = document.querySelector(btn.getAttribute('data-bs-target'));
      if (!target) continue;
      btn.dataset.navToggleBound = '1';
      btn.removeAttribute('data-bs-toggle');
      (function (button, panel) {
        button.addEventListener('click', function (e) {
          e.preventDefault();
          var open = panel.classList.toggle('show');
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      })(btn, target);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavToggle);
  } else {
    initNavToggle();
  }
})();
</script>


