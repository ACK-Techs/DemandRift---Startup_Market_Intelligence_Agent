<style id="wp-custom-css">
#tgwc-woocommerce .woocommerce-MyAccount-navigation {display:none}

.tgwc-user-avatar .tgwc-user-info a {display:none}

.ast-article-single .ast-no-thumbnail h1 {display:none}


/* Navigation */
.learndash-shortcode-wrap .ld-topic-status nav{
	display:none;
}

/* Content actions */
.learndash_post_sfwd-topic .learndash-wrapper .ld-content-actions{
	display:none !important;
	
}

/* Menu Item */
.widget nav .menu-item{
	font-weight:600;
	line-height:2.5em;
}

/* Menu Link */
.menu .menu-item .menu-link{
	text-transform:uppercase;
	letter-spacing:0px;
	line-height:2em;
	font-size:16px;
}

/* Menu Link */
#primary-site-navigation-desktop .menu-item:nth-child(7) .menu-link{
	text-decoration:underline;
}

/* Menu Link */
#primary-site-navigation-desktop .menu-item:nth-child(8) .menu-link{
	text-decoration:underline;
}

/* Menu Link */
#ast-hf-account-menu .menu-item .menu-link{
	text-transform:uppercase;
	font-weight:500;
}

/* Menu Link */
#ast-hf-account-menu .menu-item .menu-link{
	color:#020202;
	font-weight:600;
	background-color:#ffffff;
	text-align:center;
	text-decoration:none;
	font-size:16px;
	
}

/* Menu Link */
.ast-grid-center-col-layout .site-header-primary-section-right .site-header-focus-item .ast-header-account-wrap .ast-header-account-inner-wrap .ast-hf-account-menu-wrap .account-main-header-bar-navigation #account-site-navigation .account-main-navigation #ast-hf-account-menu .menu-item .menu-link{
	font-family:'Jost', sans-serif !important;
}
/* Post Meta Division */
.ast-no-date-box .entry-header .entry-meta{
	display:none;
}

/* Heading */
#ld-focus-content h1{
	font-size:24px;
	
}

/* Section heading */
.learndash-wrapper--course .learndash .ld-section-heading{
	display:none;
	
}

/* Hide gallery social icon if link is not LinkedIn */
.eb-img-gallery-action:not([href*="linkedin.com"]) {
    display: none !important;
}

.tribe-events-single .tribe-events-event-image {
  text-align: center;
}
.tribe-events-single .tribe-events-event-image img {
  display: block;
  margin-left: auto;
  margin-right: auto;
}
</style>
