<!-- Hubspot banner fix -->

<script>
(function () {
  // ─── CONFIG ──────────────────────────────────────────────────────────────────
  var TRANSITION_MS        = 400;
  var NAV_SELECTOR         = '.navigation_updated';
  var TRANSPARENT_NAV_SEL  = '.transparent_navigation';
  var SPACER_SELECTOR      = '.navigation-spacer';
  // ─────────────────────────────────────────────────────────────────────────────

  var lastBannerHeight = 0;
  var mainObserver     = null;
  var bannerObserver   = null;
  var resizeTimer      = null;
  var initTimer        = null;
  var clearTimer       = null;

  var HS_SELECTORS = [
    '.hs-cta-embed__loaded',
    '[id^="hs-overlay-cta-"]',
    '[id^="hs-web-interactives-top"]',
    '#hs-banner-parent',
    '.hs-announcement-bar',
    '.hs-announcement-bar-container',
    '.hs-banner',
    '.leadinModal--banner',
    '.leadinModal.leadinModal--top'
  ];

  // ── Inject base styles ───────────────────────────────────────────────────────

  function injectStyles() {
    if (document.getElementById('hs-banner-fix-styles')) return;
    var style = document.createElement('style');
    style.id = 'hs-banner-fix-styles';
    style.textContent = [
      ':root { --hs-banner-height: 0px; }',

      'body {',
      '  transition: margin-top ' + TRANSITION_MS + 'ms ease !important;',
      '}',

      NAV_SELECTOR + ' {',
      '  z-index: 1000 !important;',
      '  top: var(--hs-banner-height) !important;',
      '  transition: top ' + TRANSITION_MS + 'ms ease !important;',
      '}',

      '.hs-cta-embed__loaded,',
      '[id^="hs-overlay-cta-"],',
      '[id^="hs-web-interactives-top"] {',
      '  z-index: 1001 !important;',
      '}',

      '#hs-web-interactives-top-anchor,',
      '#hs-web-interactives-top-push-anchor,',
      '.go2933276541 {',
      '  pointer-events: none !important;',
      '}',

      '#hs-web-interactives-top-anchor iframe {',
      '  pointer-events: auto !important;',
      '  max-height: 300px !important;',
      '  overflow: hidden !important;',
      '}',

      '#hs-web-interactives-top-anchor .hs-cta-embed__loaded {',
      '  pointer-events: auto !important;',
      '}',

      'body.hs-banner-active ' + SPACER_SELECTOR + ' {',
      '  display: none !important;',
      '}'
    ].join('\n');
    document.head.appendChild(style);
  }

  // ── Helpers ──────────────────────────────────────────────────────────────────

  // Banner is considered active only if it exists, has height,
  // AND is visible — HubSpot dismisses by setting visibility:hidden
  function getBanner() {
    for (var i = 0; i < HS_SELECTORS.length; i++) {
      var el = document.querySelector(HS_SELECTORS[i]);
      if (el && el.offsetHeight > 0 && window.getComputedStyle(el).visibility !== 'hidden') {
        return el;
      }
    }
    return null;
  }

  function setBannerHeight(px) {
    document.documentElement.style.setProperty('--hs-banner-height', px + 'px');

    var nav = document.querySelector(NAV_SELECTOR);
    if (nav) {
      if (px > 0) {
        nav.style.top = px + 'px';
      } else {
        nav.style.removeProperty('top');
      }
    }

    document.body.style.marginTop = px > 0 ? px + 'px' : '';

    if (px > 0) {
      document.body.classList.add('hs-banner-active');
    } else {
      document.body.classList.remove('hs-banner-active');
    }

    var transparentNav = document.querySelector(TRANSPARENT_NAV_SEL);
    if (transparentNav) {
      if (px > 0) {
        transparentNav.style.transform      = 'translateY(-' + px + 'px) translate3d(0px, -100%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg)';
        transparentNav.style.transformStyle = 'preserve-3d';
      } else {
        transparentNav.style.removeProperty('transform');
        transparentNav.style.removeProperty('transform-style');
      }
    }
  }

  // ── Core logic ───────────────────────────────────────────────────────────────

  function applyOffset(banner) {
    var h = banner ? banner.offsetHeight : 0;
    if (h === lastBannerHeight) return;
    lastBannerHeight = h;
    setBannerHeight(h);
  }

  function clearOffset() {
    if (lastBannerHeight === 0) return;

    // Scroll-position correction
    var scrollY = window.scrollY || window.pageYOffset;
    if (scrollY > 0) {
      var html = document.documentElement;
      var prev = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';
      window.scrollTo(0, Math.max(0, scrollY - lastBannerHeight));
      requestAnimationFrame(function () {
        html.style.scrollBehavior = prev;
      });
    }

    lastBannerHeight = 0;
    setBannerHeight(0);
    startClearPolling();
  }

  // ── Clear polling ─────────────────────────────────────────────────────────────

  function startClearPolling() {
    if (clearTimer) clearInterval(clearTimer);
    var attempts = 0;

    clearTimer = setInterval(function () {
      attempts++;

      document.documentElement.style.setProperty('--hs-banner-height', '0px');

      var nav = document.querySelector(NAV_SELECTOR);
      if (nav) nav.style.removeProperty('top');

      document.body.style.marginTop = '';
      document.body.classList.remove('hs-banner-active');

      var transparentNav = document.querySelector(TRANSPARENT_NAV_SEL);
      if (transparentNav) {
        transparentNav.style.removeProperty('transform');
        transparentNav.style.removeProperty('transform-style');
      }

      if (nav) {
        var navTop = window.getComputedStyle(nav).top;
        if (navTop === '0px') {
          clearInterval(clearTimer);
          return;
        }
      }

      if (attempts >= 20) clearInterval(clearTimer);
    }, 100);
  }

  // ── Observers ────────────────────────────────────────────────────────────────

  function watchBannerForDismissal(banner) {
    if (bannerObserver) bannerObserver.disconnect();

    bannerObserver = new MutationObserver(function () {
      var b = getBanner();
      if (!b) {
        // Banner gone or hidden — clear everything
        clearOffset();
        bannerObserver.disconnect();
      } else if (b.offsetHeight !== lastBannerHeight) {
        lastBannerHeight = 0;
        applyOffset(b);
      }
    });

    // Watch the banner element itself for visibility changes
    bannerObserver.observe(banner, {
      attributes:      true,
      attributeFilter: ['style', 'class']
    });

    // Also watch its parent in case HubSpot hides a wrapper
    if (banner.parentElement) {
      bannerObserver.observe(banner.parentElement, {
        attributes:      true,
        attributeFilter: ['style', 'class'],
        childList:       true
      });
    }
  }

  function startMainObserver() {
    if (mainObserver) return;
    mainObserver = new MutationObserver(function () {
      var banner = getBanner();
      if (banner && banner.offsetHeight !== lastBannerHeight) {
        applyOffset(banner);
        watchBannerForDismissal(banner);
      }
    });
    mainObserver.observe(document.body, { childList: true });
  }

  // ── Init polling ─────────────────────────────────────────────────────────────

  function startInitPolling() {
    var attempts = 0;
    var maxAttempts = 100;

    initTimer = setInterval(function () {
      attempts++;

      var banner = getBanner();
      var nav    = document.querySelector(NAV_SELECTOR);

      if (banner && nav) {
        var h = banner.offsetHeight;
        setBannerHeight(h);
        lastBannerHeight = h;

        setTimeout(function () {
          var navTop = window.getComputedStyle(nav).top;
          if (navTop === h + 'px') {
            clearInterval(initTimer);
            watchBannerForDismissal(banner);
          }
        }, TRANSITION_MS + 50);
      }

      if (attempts >= maxAttempts) {
        clearInterval(initTimer);
      }
    }, 100);
  }

  // ── Resize handler ───────────────────────────────────────────────────────────

  function onResize() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      var banner = getBanner();
      if (banner) {
        lastBannerHeight = 0;
        applyOffset(banner);
      } else {
        clearOffset();
      }
    }, 120);
  }

  // ── Init ─────────────────────────────────────────────────────────────────────

  function init() {
    injectStyles();
    startMainObserver();
    startInitPolling();
    window.addEventListener('resize', onResize);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script></body></html>