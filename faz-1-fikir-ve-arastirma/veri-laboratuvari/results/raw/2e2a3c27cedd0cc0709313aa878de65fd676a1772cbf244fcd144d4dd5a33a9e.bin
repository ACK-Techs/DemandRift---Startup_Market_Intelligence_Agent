<!--Select css based on the variant-->
<script>
document.addEventListener("DOMContentLoaded", function () {
    setTimeout(() => {
      const formLayout = document.querySelector('[data-wf--form-layout-selector--variant]')
        ?.getAttribute('data-wf--form-layout-selector--variant');

      if (formLayout === 'two-column') {
        document.getElementById('two-column').disabled = false;
      } else {
        document.getElementById('two-column').disabled = true;
      }
    }, 200); // delay of 200ms
  });
