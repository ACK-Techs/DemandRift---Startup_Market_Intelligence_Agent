<path fill-rule="evenodd" clip-rule="evenodd" d="M29.1666 23.3334C29.1666 26.555 26.5549 29.1667 23.3333 29.1667C20.1116 29.1667 17.4999 26.555 17.4999 23.3334C17.4999 20.1117 20.1116 17.5 23.3333 17.5C26.5549 17.5 29.1666 20.1117 29.1666 23.3334ZM28.0147 29.1933C26.7316 30.2196 25.1041 30.8334 23.3333 30.8334C19.1911 30.8334 15.8333 27.4755 15.8333 23.3334C15.8333 19.1912 19.1911 15.8334 23.3333 15.8334C27.4754 15.8334 30.8333 19.1912 30.8333 23.3334C30.8333 25.1042 30.2195 26.7317 29.1932 28.0148L33.0892 31.9108L31.9107 33.0893L28.0147 29.1933Z" fill="currentColor"/>
</svg></div></div><nav class="dropdown1_dropdown-list w-dropdown-list"><form action="/search" class="search w-form"><div class="search_field-wrap"><input class="search_input w-input" maxlength="256" name="query" placeholder="What can we help you find?" type="search" id="search" required=""/><input type="submit" class="search_button w-button" value=""/></div></form></nav></div><a sign-in="" nav-link="light" href="https://app.dscout.com/auth/sign_in?_ga=2.206541651.1972459815.1742741359-197364905.1715721955&amp;_gac=1.180278102.1742261014.Cj0KCQjwytS-BhCKARIsAMGJyzr0h6K2fuRljQ6ElcbirMGxK0ya_Xd9ZEj9rVJELvbctedasiytu5QaAiKDEALw_wcB" target="_blank" class="navigation_link sign-in w-nav-link">Sign in</a><div nav-button-group="light" class="nav-button-group"><a href="/participate-in-research-studies" class="button-ctanav_secondary w-inline-block"><div nav-button-text="light" class="text-block">Get paid to test</div></a><a href="/schedule-a-demo" class="button-ctanav_primary w-inline-block"><div>Schedule a demo</div></a></div><div fs-scrolldisable-element="enable" class="scroll-enable"></div></div></div><div nav-toggle="" class="navigation-menu-button w-nav-button"><a nav-button-mobile="light" href="#" class="navigation_menu-button w-inline-block"><div>Menu</div></a></div></div></div><div class="dropdown_list-overlay-wrapper"><div class="dropdown_list-overlay"></div></div><div class="mobile-dropdown-script w-embed w-script"><!--<script defer src="http://127.0.0.1:5502/dscout/js/nav-dropdown.js"></script>-->
<script>
  document.addEventListener('DOMContentLoaded', function () {

  function getDropdowns() {
    return document.querySelectorAll('[dscout-dropdown]');
  }

  function openDropdown(list, inner, arrow) {
    list.style.height = list.scrollHeight + 'px';
    if (inner) inner.style.opacity = '1';
    if (arrow) arrow.style.transform = 'rotate(360deg)';
  }

  function closeDropdown(list, inner, arrow) {
    list.style.height = list.scrollHeight + 'px';
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        list.style.height = '0';
        if (inner) inner.style.opacity = '0';
        if (arrow) arrow.style.transform = 'rotate(270deg)';
      });
    });
  }

  function handleToggleClick(toggle, list, inner, arrow) {
    toggle.addEventListener('click', function () {
      var isOpen = list.dataset.open === 'true';

      if (!isOpen) {
        openDropdown(list, inner, arrow);
        list.dataset.open = 'true';
      } else {
        closeDropdown(list, inner, arrow);
        list.dataset.open = 'false';
      }
    });
  }

  function initDropdown(dropdown) {
    var toggle = dropdown.querySelector('[dscout-dropdown-toggle]');
    var list = dropdown.querySelector('[dscout-dropdown-list]');
    var inner = list ? list.firstElementChild : null;
    var arrow = dropdown.querySelector('[dropdown-toggle-arrow]');

    if (!toggle || !list) return;

    list.style.height = '0';
    list.style.overflow = 'hidden';
    list.style.transition = 'height 0.35s ease';
    list.dataset.open = 'false';

    if (inner) {
      inner.style.opacity = '0';
      inner.style.transition = 'opacity 0.3s ease';
    }

    if (arrow) {
      arrow.style.transition = 'transform 0.35s ease';
      arrow.style.transform = 'rotate(270deg)';
    }

    handleToggleClick(toggle, list, inner, arrow);
  }

  function initAllDropdowns() {
    getDropdowns().forEach(function (dropdown) {
      initDropdown(dropdown);
    });
  }

  function destroyDropdown(dropdown) {
    var list = dropdown.querySelector('[dscout-dropdown-list]');
    var inner = list ? list.firstElementChild : null;
    var arrow = dropdown.querySelector('[dropdown-toggle-arrow]');

    if (list) {
      list.style.height = '';
      list.style.overflow = '';
      list.style.transition = '';
      list.dataset.open = '';
    }

    if (inner) {
      inner.style.opacity = '';
      inner.style.transition = '';
    }

    if (arrow) {
      arrow.style.transition = '';
      arrow.style.transform = '';
    }
  }

  function destroyAllDropdowns() {
    getDropdowns().forEach(function (dropdown) {
      destroyDropdown(dropdown);
    });
  }

  function handleResize() {
    if (window.innerWidth <= 991) {
      initAllDropdowns();
    } else {
      destroyAllDropdowns();
    }
  }

  function disableScroll() {
    document.body.style.overflow = 'hidden';
  }

  function enableScroll() {
    document.body.style.overflow = '';
  }

  function checkNavToggleOpen(navToggle) {
    setTimeout(function () {
      var isOpen = navToggle.classList.contains('w--open');
      console.log(isOpen);

      if (isOpen) {
        disableScroll();
      } else {
        enableScroll();
      }
    }, 50);
  }

  function initNavToggle() {
    var navToggle = document.querySelector('[nav-toggle]');
    if (!navToggle) return;

    navToggle.addEventListener('click', function () {
      checkNavToggleOpen(navToggle);
    });
  }

  if (window.innerWidth <= 991) {
    initAllDropdowns();
  }

  initNavToggle();

  window.addEventListener('resize', handleResize);
});
</script></div></div><div data-wf--navigation-padding--variant="light" class="navigation-spacer"></div><section id="header-form" data-wf--headerform--background-color="light-background" class="headerform"><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div><div id="w-node-ea197c46-896b-149d-5062-90e5e3bf4031-e3bf4030" class="w-layout-layout form-grid wf-layout-layout"><div class="w-layout-cell"><div class="headerform_sticky"><div class="headerform_left-column"><div class="hide-tablet"><div><div data-wf--page-header---left--light-text="dark-text" class="heading-wrapper"><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div><div class="page-header_headlines"><div data-wf--headline-wrap--headline-alignment="align-left" class="text-alignment w-variant-c6952ad7-f7a9-4e96-49a6-0e4af43e16c7"><div><div class="headerhero-max-width w-variant-c6952ad7-f7a9-4e96-49a6-0e4af43e16c7"><h1 data-wf--sans-serif-headline--variant="step-6" class="sans-serif-headline_inline w-variant-70d3c7d1-5ca8-c0ef-cc40-00fad7f4746e">Award-winning UX research, </h1><h1 data-wf--serif-headline--variant="step-6" class="serif-headline_inline w-variant-1266ba90-7bd2-40b8-7a10-d73a047b2670">All on one platform</h1><h1 data-wf--serif-headline--variant="step-6" class="serif-headline_inline w-variant-1266ba90-7bd2-40b8-7a10-d73a047b2670">‍</h1></div></div></div></div><div data-wf--vertical-space--variant="s" class="spacer w-variant-d5999bef-cbc7-290e-f889-7175919e6506"></div><div class="headline-max-width"><div class="component_rtb-dark-text w-richtext"><p>Discover why Dscout is trusted (and loved!) by top brands for their research needs. Explore how our platform enables everything from <strong>quick-turn surveys</strong> and <strong>usability testing</strong> to <strong>moderated live interviews</strong> and <strong>diary studies.</strong></p></div></div><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div></div><img src="https://cdn.prod.website-files.com/6740a730413debfacf115060/6a95c645a879e4f9485cb25a_G2%20Badges%20-%20Summer%2026.avif" loading="lazy" width="70" data-wf--image--image-style="rounded" alt="" data-style-image="" class="full-width_img"/><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div></div></div></div></div></div><div id="w-node-ea197c46-896b-149d-5062-90e5e3bf4043-e3bf4030" class="w-layout-cell"><div class="headerform_right-column"><div class="hide-desktop"><div><div data-wf--page-header---left--light-text="dark-text" class="heading-wrapper"><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div><div class="page-header_headlines"><div data-wf--headline-wrap--headline-alignment="align-left" class="text-alignment w-variant-c6952ad7-f7a9-4e96-49a6-0e4af43e16c7"><div><div class="headerhero-max-width w-variant-c6952ad7-f7a9-4e96-49a6-0e4af43e16c7"><h1 data-wf--serif-headline--variant="step-6" class="serif-headline_inline w-variant-1266ba90-7bd2-40b8-7a10-d73a047b2670">Recognized as </h1><h1 data-wf--sans-serif-headline--variant="step-6" class="sans-serif-headline_inline w-variant-70d3c7d1-5ca8-c0ef-cc40-00fad7f4746e">the leading </h1><h1 data-wf--serif-headline--variant="step-6" class="serif-headline_inline w-variant-1266ba90-7bd2-40b8-7a10-d73a047b2670">Experience Research platform</h1></div></div></div></div><div data-wf--vertical-space--variant="s" class="spacer w-variant-d5999bef-cbc7-290e-f889-7175919e6506"></div><div class="headline-max-width"><div class="component_rtb-dark-text w-richtext"><p>Discover why Dscout is trusted by leading companies for their research needs. Explore how our platform enables everything from quick-turn surveys and usability testing to moderated live interviews and diary studies.</p></div></div><div data-wf--vertical-space--variant="s" class="spacer w-variant-d5999bef-cbc7-290e-f889-7175919e6506"></div><div class="page-header_buttons-left"><img src="https://cdn.prod.website-files.com/6740a730413debfacf115060/6a95c645a879e4f9485cb25a_G2%20Badges%20-%20Summer%2026.avif" loading="lazy" width="70" data-wf--image--image-style="rounded" alt="" data-style-image="" class="full-width_img"/></div><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div></div><div data-wf--vertical-space--variant="l" class="spacer w-variant-13e4797a-c62b-b476-4a73-bfbaabf18a32"></div></div></div><div data-form-style="light" hs-button-bg="" hs-button-bg-hover="" hs-button-color="" data-wf--form---contact-form--form-styles-form-color="light" class="form_wrapper"><div class="form"><div class="form-wrapper"><div data-hubspot-form-id="34acdb95-fa51-4d8b-8f40-93c17772c4f5" class="w-embed w-script"><div class="hc-contact-form light-form" id="hubspot-form-container" data-hubspot-form-id=""></div>
<script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const formContainer = document.querySelector("[data-hubspot-form-id]");
    
    if (formContainer) {
      const formId = formContainer.getAttribute("data-hubspot-form-id")?.trim();
      if (formId && formId !== "") {
        console.log("✅ HubSpot Form ID found:", formId);
        
        hbspt.forms.create({
          region: "na1",
          portalId: "2206648",
          formId: formId,
          target: `#hubspot-form-container`
        });
      } else {
        console.warn("⚠️ No valid HubSpot Form ID found in data-hubspot-form-id attribute.");
      }
    } else {
      console.error("❌ HubSpot form container not found.");
    }
  });
</script></div><div class="w-embed w-script"><script>
  function applyHubSpotFix() {
    const form = document.querySelector("form[action*='forms.hsforms.com']");
    if (form) {
      console.log("✅ HubSpot form detected! Applying Webflow styles...");
      // Ensure full width fieldsets
      form.querySelectorAll("fieldset").forEach(fieldset => {
        fieldset.style.width = "100%";
        fieldset.style.maxWidth = "100%";
      });
      // Completely hide hidden UTM fields (removing any extra spacing)
      form.querySelectorAll("[style*='display: none']").forEach(hiddenField => {
        hiddenField.style.height = "0";
        hiddenField.style.padding = "0";
        hiddenField.style.margin = "0";
        hiddenField.style.overflow = "hidden";
        hiddenField.style.visibility = "hidden";
      });
      // Completely remove empty UTM fieldsets
      form.querySelectorAll("fieldset").forEach(fieldset => {
        if (fieldset.innerHTML.includes("utm_campaign") || fieldset.innerHTML.includes("utm_medium")) {
          fieldset.style.display = "none";
        }
      });
      console.log("🎨 Webflow styles applied!");
    }
  }
  // Detect when HubSpot injects the form
  const observer = new MutationObserver((mutations, obs) => {
    const form = document.querySelector("form[action*='forms.hsforms.com']");
    if (form) {
      applyHubSpotFix();
      obs.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
  console.log("🔎 Watching for any HubSpot form to appear...");
</script>

