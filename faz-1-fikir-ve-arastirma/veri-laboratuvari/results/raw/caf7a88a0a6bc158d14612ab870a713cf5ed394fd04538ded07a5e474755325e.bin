<style>
.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 30px;
}

.grid-item {
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
}


.box {
    background-color: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    padding: 20px;
    height: 100%;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
}

.box h2 {
    font-size: 1.1rem !important;
    color: #182970;
    margin: 0;
}
.blue{
    border-bottom: 2px solid #ced3d5
}
.blue:hover {
    border-bottom: 2px solid #00b1ed;
}

.link-icon {
    position: absolute;
    bottom: 18px;
    right: 22px;
    color: #182970;
    opacity: 0.06;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.grid-item:hover .link-icon {
    opacity: 0.12;
}

@media (max-width: 576px) {
    .box {
        padding: 25px 20px;
    }
}

</style>
