    -moz-border-radius: 6px !important;
    box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.03) !important;
    border: 1px solid rgba(245, 245, 245, 0.9);
}

.main aside ul li a {
    border-bottom: solid 1px rgba(248, 248, 248, 0.8) !important;
    font-size: 13px;
    color: #333333 !important;
    font-weight: 400;
    font-family: Poppins;
    line-height: 18px;
    display: flex;
