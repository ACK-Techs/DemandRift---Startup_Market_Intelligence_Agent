    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #666;
    padding: 8px 10px;
    border-radius: 10px;
    transition: all 0.3s ease;
    position: relative;
    text-align: center;
      
        }

        .mobile-nav-item.active,
        .mobile-nav-item:hover {
