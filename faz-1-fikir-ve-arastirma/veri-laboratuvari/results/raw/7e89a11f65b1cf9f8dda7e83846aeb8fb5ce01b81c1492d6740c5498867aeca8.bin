  <script
  type="text/javascript"
  nonce="DnlGsgfrt8ge2yQi4k5VdQ=="
  id="dux-data"
  
  
  data-mode=production>
  (function () {
    function getData(key) {
      const dux_info = document.getElementById('dux-data');
      if (dux_info && dux_info.dataset && dux_info.dataset[key]) {
        return dux_info.dataset[key];
      }
      return;
    }

    function loadScript(src) {
      const promise = new Promise(function(resolve, reject){
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.nonce = "DnlGsgfrt8ge2yQi4k5VdQ==";
        script.type = 'module';
        script.onload = () => {
          resolve(true);
        };
        script.onerror = () => {
          reject(false);
        };
        if (document.body) {
          document.body.appendChild(script);
        } else {
          document.addEventListener('DOMContentLoaded', () => {
            document.body.appendChild(script);
          });
        }
      });
      return promise;
    }

    function duxConfig() {
      return {
        service: 'appstore',
        mode: getData('mode') || 'development',
        enableGtm: false,
        enableGtmLoader: false,
        enableActiveConsent: true,
        enableConsentBuffer: true,
        enableDenormalization: true,
        disableLegacyTracking: true,
        countryCode: "TR",
        locale: "en",
        shopId: getData('shop_id'),
        identityUuid: getData('identity_uuid'),
        enableSessionWrites: true,
        protoSessionAppType: 'merchant',
      };
    }

    function initDux(config) {
      Dux.init(config);
    }

    function fallbackToLegacyDux(error) {
      console.error('Failed to initialize Dux Event Refinery migration, falling back to legacy Dux config.', error);

      loadScript('https://cdn.shopify.com/shopifycloud/dux/dux-portal-6.4.1.min.js').then(() => {
        initDux({
          ...duxConfig(),
          eventHandlerEndpoint: 'https://apps.shopify.com/.well-known/dux',
        });
      }).catch((legacyError) => {
        console.error('Failed to initialize legacy Dux config after Event Refinery fallback.', legacyError);
      });
    }

    loadScript('https://cdn.shopify.com/shopifycloud/dux/dux-portal-7.5.0.min.js').then(() => {
      try {
        initDux({
          ...duxConfig(),
          eventHandlerEndpoint: 'https://apps.shopify.com/.well-known/dux?v2',
          protoEventSource: 'EVENT_APP_APP_STORE',
        });
      } catch (error) {
        fallbackToLegacyDux(error);
      }
    }).catch((error) => {
      fallbackToLegacyDux(error);
    });
  })();
</script>

