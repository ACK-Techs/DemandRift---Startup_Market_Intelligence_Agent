  function isReplaceableLogo(logoId) {
    return (
      logoId === "#is24_logo_topnav" ||
      logoId === "#is24_logo_sidebar" ||
      logoId === "#is24_logo_footer" ||
      logoId === "#is24_logo_inverted"
    );
  }

  function createJulyLogo(originalLogo, logoId) {
    var container = document.createElement("div");
    var logoClass = originalLogo.getAttribute("class");
    var clipPathId;
    var clipPath;
    var clippedGroup;
    var logo;

    window.__is24JulyLogoIndex = (window.__is24JulyLogoIndex || 0) + 1;
    clipPathId = "is24_logo_july_clippath_" + window.__is24JulyLogoIndex;

    container.innerHTML = julyLogoMarkup(logoId);
    logo = container.firstChild;
    logo.setAttribute("id", "is24_logo_july_" + window.__is24JulyLogoIndex);
    logo.setAttribute("data-is24-july-logo", "true");

    if (logoClass) {
      logo.setAttribute("class", logoClass);
    }

    clipPath = logo.querySelector("#clippath");
    clippedGroup = logo.querySelector(".st8");

    if (clipPath && clippedGroup) {
      clipPath.setAttribute("id", clipPathId);
      clippedGroup.setAttribute("clip-path", "url(#" + clipPathId + ")");
      clippedGroup.removeAttribute("class");
    }

    return logo;
  }

  if (currentTime < startTime || currentTime > endTime) {
    return;
  }

  logoUses = document.querySelectorAll(
    ".page-header__logo use, .sidebarnavigation__logo use, .page-footer use",
  );

  for (i = 0; i < logoUses.length; i++) {
    logoUse = logoUses[i];
    currentLogoId = getCurrentLogoId(logoUse);

    if (!isReplaceableLogo(currentLogoId)) {
      continue;
    }

    logoSvg = logoUse.ownerSVGElement;
    if (!logoSvg || logoSvg.getAttribute("data-is24-july-logo") === "true") {
      continue;
    }

    julyLogo = createJulyLogo(logoSvg, currentLogoId);
    logoSvg.parentNode.replaceChild(julyLogo, logoSvg);
  }
