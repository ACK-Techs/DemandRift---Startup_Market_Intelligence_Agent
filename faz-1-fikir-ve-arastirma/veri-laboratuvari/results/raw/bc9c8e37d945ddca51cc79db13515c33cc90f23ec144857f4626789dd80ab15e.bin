\u002F4011\u002F4011381.svg?modified=1725275339","thumbnail_h":92,"thumbnail_src":"https:\u002F\u002Faddons.mozilla.org\u002Fuser-media\u002Fversion-previews\u002Fthumbs\u002F4011\u002F4011381.jpg?modified=1725275339","thumbnail_w":720,"title":null,"w":720}],"promoted":[{"category":"recommended","apps":["firefox","android"]}],"ratings":{"average":5,"bayesian_average":2.358229121485034,"count":1,"text_count":0},"requires_payment":false,"review_url":"https:\u002F\u002Faddons.mozilla.org\u002Fen-US\u002Freviewers\u002Freview\u002F2865831","slug":"cool_summer","status":"public","summary":"Summer them.","support_email":"tspans@gmail.com","support_url":null,"tags":[],"type":"statictheme","url":"https:\u002F\u002Faddons.mozilla.org\u002Fen-US\u002Ffirefox\u002Faddon\u002Fcool_summer\u002F","weekly_downloads":284,"currentVersionId":5801938,"isMozillaSignedExtension":false,"isAndroidCompatible":false},{"authors":[{"id":18867149,"name":"spedwagoon","url":"https:\u002F\u002Faddons.mozilla.org\u002Fen-US\u002Ffirefox\u002Fuser\u002F18867149\u002F","username":"anonymous-bc1f953f081af67cf4aba1007dd33d2f"}],"average_daily_users":252,"categories":["other"],"contributions_url":"","created":"2026-01-10T16:19:15Z","default_locale":"en-US","description":"Ver 1.1\n\n1.1 Notes - 7\u002F6\u002F26\n- Added a solid Tab Selected background color\n- Removed some toolbar borders\n\npool, pool day, water, frutiger, frutiger aero, aesthetic, clean, cleancore, summer, swim, swimming","developer_comments":null,"edit_url":"https:\u002F\u002Faddons.mozilla.org\u002Fen-US\u002Fdevelopers\u002Faddon\u002Fpool-day\u002Fedit","guid":"{55b91f5d-3205-4447-97b5-2745a72e2aa1}","has_eula":false,"has_privacy_policy":false,"homepage":null,"icon_url":"https:\u002F\u002Faddons.mozilla.org\u002Fstatic-server\u002Fimg\u002Faddon-icons\u002Fdefault-64.png","icons":{"32":"https:\u002F\u002Faddons.mozilla.org\u002Fstatic-server\u002Fimg\u002Faddon-icons\u002Fdefault-32.png","64":"https:\u002F\u002Faddons.mozilla.org\