<style id="wp-custom-css">
/*Ne Yapıyoruz > Geliştiriciler İçin Alt Menu Sol Gap*/
.ne-yapiyoruz-submenu{
	padding-left: 15px !important;
}

@media screen and (max-width: 600px){
  .header_top.clearfix {
    background: #3a3a3a !important;
    padding-top: 0px !important;
	}
}

@media screen and (max-width: 600px){
  .header_top.clearfix {
    background: #fff !important;
    padding-top: 0px !important;
	}
}

/*Blog Single ".entry_title" Hide*/
article > div > div.post_text > div > h2.entry_title{
	display: none;
}
article .title_subtitle_holder{
	text-align: center;
}

.search-results h2.entry_title {
    display: block !important;
	font-size: 18px!important;
}
input.wpcf7-form-control.wpcf7-submit[disabled] {
    color: #818181;
    border: 2px solid #818181;
    cursor: not-allowed;
}

/* =========================
   WPBakery - Modern Tables (Safe)
   Scope: wpb_wrapper + entry-content
   ========================= */

.wpb_wrapper table,
.entry-content table {
  width: 100%;
  max-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background: #fff;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 14px;
  overflow: hidden; /* radius clipping */
  box-shadow: 0 10px 25px rgba(0,0,0,.06);
  table-layout: auto; /* IMPORTANT: avoid cramped fixed layout */
}

/* Cells */
.wpb_wrapper th,
.wpb_wrapper td,
.entry-content th,
.entry-content td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid rgba(0, 0, 0, .06);
    font-size: 15px;
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: keep-all;
}

/* Header */
.wpb_wrapper thead th,
.entry-content thead th {
  font-weight: 700;
  font-size: 13px;
  letter-spacing: .02em;
  color: rgba(0,0,0,.75);
  background: rgba(0,0,0,.03);
  border-bottom: 1px solid rgba(0,0,0,.08);
}

/* Zebra rows */
.wpb_wrapper tbody tr:nth-child(even) td,
.entry-content tbody tr:nth-child(even) td {
  background: rgba(0,0,0,.015);
}

/* Hover */
.wpb_wrapper tbody tr:hover td,
.entry-content tbody tr:hover td {
  background: rgba(0,0,0,.03);
}

/* Last row border */
.wpb_wrapper tbody tr:last-child td,
.entry-content tbody tr:last-child td {
  border-bottom: 0;
}

/* Optional: nicer link style */
.wpb_wrapper td a,
.entry-content td a {
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* =========================
   Responsive: horizontal scroll ONLY on small screens
   (no markup changes required)
   ========================= */
@media (max-width: 768px) {
  .wpb_wrapper table,
  .entry-content table {
    display: block;         /* enable scroll container */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 12px;
  }

  .wpb_wrapper thead,
  .wpb_wrapper tbody,
  .wpb_wrapper tfoot,
  .entry-content thead,
  .entry-content tbody,
  .entry-content tfoot {
    width: max-content;     /* allow table to be wider than screen */
  }

  .wpb_wrapper th,
  .wpb_wrapper td,
  .entry-content th,
  .entry-content td {
    min-width: 140px;       /* keeps columns readable */
    padding: 12px 12px;
    font-size: 14px;
  }
}
.carousel-caption div {
	    flex-direction: column;
}

.eventer-ticket-confirmation-footer {
	display: none !important;
}
</style>
<style type="text/css" data-type="vc_custom-css">@media only screen and (max-width: 768px){
    #avantajlar .vc_col-sm-4.vc_col-xs-6 .wpb_text_column h4{
        font-size: 16px;
    }
    #avantajlar .vc_col-sm-4.vc_col-xs-6{
        min-height: 240px;
    }
    #anasayfaneyapiyoruz .vc_inner .wpb_column {
        padding: 10px;
    }
}
.header_top {
    -webkit-box-shadow: 0px 1px 1px #bdbdbd;
    -moz-box-shadow: 0px 1px 1px #bdbdbd;
    box-shadow: 0px 1px 1px #bdbdbd;
}
/*Programlarimiz*/

#programlarimiz .icon_title{
    min-height: 70px;
}

/*Müşteri Yorumları Ne Dediler Kısmı*/

#ne-dediler .testimonials_c_holder .testimonial_content_inner{
    background: transparent;
    padding: 0px 25px;
}

#ne-dediler .testimonial_text_holder .testimonial_text_inner{
    display: flex;
    flex-direction: column;
    align-items: center;
}

#ne-dediler .testimonial_author{
    order: -1;
    box-shadow: 0 2px 10px rgb(42 65 232 / 25%);
    background-color: #f6921e;
    border-radius: 6px;
    color: #fff !important;
    width: fit-content;
    padding: 3px 12px;
    margin: 10px 0 30px;
}

#ne-dediler .testimonial_image_holder{
    margin-bottom: -30px;
    width: 70px;
}

#ne-dediler .testimonial_text_holder{
    background: #fff;
    padding: 0px 10px;
    box-shadow: 0px 25px 30px rgb(0 0 0 / 8%);
    border-radius: 0px 0px 6px 6px;
}

#ne-dediler .testimonial_title_holder{
    background: #fff;
    padding-top: 50px;
    box-shadow: 0 -25px 20px rgb(0 0 0 / 8%);
    border-radius: 6px 6px 0px 0px;
}

#ne-dediler .testimonial_title_holder h4{
    font-weight: 600;
}
@media only screen and (min-width: 1200px){
    #ne-dediler .testimonial_text_inner p{
        font-size: 0.74vmax !important;
        line-height: 2.5vmin;
    }
    #ne-dediler .testimonial_text_holder{
    min-height: 330px;
    }
}
@media only screen and (max-width: 1200px) and (min-width: 992px){
    #ne-dediler{
        padding-right: 3% !important;
        padding-left: 3% !important;
    }
    #ne-dediler .vc_column-inner{
        padding-right: 0;
        padding-left: 0;
    }
    #ne-dediler .testimonial_text_holder .testimonial_text_inner{
        min-height: 345px;
    }
}
/*Müşteri Yorumları Ne Dediler Kısmı*/

#basari-hikayeleri .carousel-caption{
    text-shadow: none;
}

/*40’ı Aşkın Paydaşımız Kısmı*/
.paydaslar-btn{
    height: 130px;
    width: 84px !important;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    line-height: 25px;
    margin-bottom: 25px;
    box-shadow: 4px 4px 0px rgb(255 255 255 / 41%);
    background: transparent !important;
    border-width: 4px;
    padding: 0 23px !important;
    color: #303030 !important;
    border-color: #303030 !important;
}

.paydaslar-btn:hover {
    color: #f6921e !important;
    border-color: #f6921e !important;
}

.anasayfapaydaslar{
    text-align: -webkit-center !important;
}

.anasayfapaydaslar .vc_column_container .vc_column-inner > .wpb_wrapper {
    box-shadow: 0px 0px 10px #f5f5ee;
    margin: 10px 10px;
    border-radius: 10px;
    padding: 25px 0px;
    background: #f5f5ee !important;
}

.anasayfapaydaslar .vc_tta-container{
    background-color: #fff;
    border-radius: 10px;
    margin: 13px;
}

/*40’ı Aşkın Paydaşımız Kısmı*/

/*Basında İTÜ Çekirdek*/
.q_masonry_blog article .q_masonry_blog_post_text{
    min-height: 150px;
    background: #f5f5ee;
}
/*Basında İTÜ Çekirdek*/

