    }
input[type=email]{
    margin-top: 5px;
    padding: 1em !important;
    background-color: #ffffff !important;
    border: 1px solid rgb(51,51,51) !important;
}


.vc-hoverbox-block {
    background-size: contain !important;
    background-repeat: no-repeat !important;
    width: 368px !important;
    height: 231px !important;
}

.vc-hoverbox-back {
    background: #f5f5ee !important;
    border: 1px solid #f5f5f5 !important;
    box-shadow: 0px 0px 10px #f5f5ee;
}

.box {
    cursor: pointer !important;
}

.tdt-slider .slick-prev {
    left: -15px !important;
}

.tdt-slider .slick-next {
    right: -15px !important; 
}

.q_masonry_blog article .q_masonry_blog_post_image img {
    border-radius: 10px !important;
}







.category-blog-icerikleri {
    padding: 20px !important;
    border-radius: 10px !important;
    box-shadow: 0px 0px 10px #f5f5ee !important;
    background-color: #fff !important;
}


.category-blog-icerikleri .q_masonry_blog_post_text {
    background: #fff !important;
    min-height: 100px !important;
    padding-bottom: 0px !important;
    background-color: #fff !important;
}



.category-haberler {
    padding: 20px !important;
    border-radius: 10px !important;
    box-shadow: 0px 0px 10px #f5f5ee !important;
    background-color: #f5f5ee !important;
}

.category-haberler .q_masonry_blog_post_text {
    background: #fff !important;
    min-height: 100px !important;
    padding-bottom: 0px !important;
    background-color: #f5f5ee !important;
}



























.custom-content-box {
    height: 400px !important;
    width: 32% !important;
}

.custom-content-box .title-block {
    position: relative;
    height: 55px;
}

.custom-content-box .vc_column-inner {
    height: 100% !important;
    border-radius: 20px !important;
    padding: 50px 30px !important;
}

.custom-boxes .full_section_inner {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
}

@media (max-width: 767px) {
    .custom-boxes .full_section_inner {
    flex-direction: column !important;
    gap: 30px !important;
}



.custom-content-box {
    width: 100% !important;
}
}

@media (min-width: 768px) and (max-width: 1024px) {
   .custom-content-box .title-block {
    height: 75px;
}
}

.rounded-bar {
    width: 150px; /* Genişliği ayarlayın */
    height: 5px; /* Yüksekliği ayarlayın */
    background-color: white; /* Arkaplan rengi */
    border-radius: 10px; /* Köşe yuvarlama */
    margin-top: 10px; /* Üstten boşluk */
    margin-bottom: 10px !important;
        position: absolute;
    bottom: 0;
}

.custom-content-box .wpb_wrapper {
    min-height: 130px;
}











/*new css*/

.custom-slider-logos .section_inner_margin {
    display:flex;
    align-items:center;
}

.custom-slider-logos .slick-slide img {
    margin: 0 !important;
}

.custom-slider-logos .slick-slide img {
    width: 60% !important;
}

.custom-slider-logos .slick-slide .content-section,
.custom-slider-logos .slick-slide .slick-dots {
    display: none !important;
}

.custom-slider-logos .slider ul {
    display: none !important;
}

.custom-slider-logos .section_inner_margin {
    background: #fff !important;
    border-radius: 20px !important;
    padding: 0 20px !important;
    margin-bottom: 20px !important;
}

.custom-slider-logos .slick-dotted.slick-slider {
    margin-bottom: 0 !important;
}

.custom-slider-logos .slick-prev{
    left: -20px !important;
}

.custom-slider-logos .slick-next {
    right: -20px !important;
}

.carousel-caption div {
    display: flex;
    align-items:center;
    justify-content:center;
    flex-direction: column;
}


@media(max-width: 767px) {
   .custom-slider-logos .altin-wrapper .slick-list {
       width: 80% !important;
   }
   .custom-slider-logos .altin-wrapper .slick-next {
       right: 45px !important;
   }
   
   .custom-slider-logos .mobile-block .section_inner_margin {
       flex-direction: column;
       padding: 20px !important;
   }
   
   .custom-slider-logos .mobile-block .section_inner_margin .wpb_column {
       width: 100% !important;
   }
   
   .custom-slider-logos .mobile-block .section_inner_margin .wpb_column h3 {
       text-align: center !important;
   }
   
    .custom-slider-logos .elmas-wrapper .carousel-caption img {
       width: 40% !important;
   }
}

@media(min-width:768px) and (max-width: 1024px) {
    .custom-slider-logos .elmas-wrapper .carousel-caption img,
    .custom-slider-logos .altin-wrapper .carousel-caption img {
        width: 100% !important;
    }
}

.slick-next:before {
    font-size: 18px !important;
}
.carousel-caption img {
    width: 150px !important;
