    <script nonce="BKDfzKqrdMlthnHe7pFcrA">function initSignup() {
  const personalDesc = document.querySelector('#_0_acc_type_personal');
  const teamDesc = document.querySelector('#_0_acc_type_team');
  const companyInput = document.querySelector('#_0_company_input');

  const teamRadio = document.querySelector('#account_type_team');
  const personalRadio = document.querySelector('#account_type_personal');

  if (!teamRadio || !personalRadio)
    return;

  personalRadio.onchange = () => {
    if (!personalRadio.checked)
      return;

    teamDesc.hidden = true;
    personalDesc.hidden = false;
    companyInput.hidden = true;
    companyInput.required = false;
  }

  teamRadio.onchange = () => {
    if (!teamRadio.checked)
      return;

    teamDesc.hidden = false;
    personalDesc.hidden = true;
    companyInput.hidden = false;
    companyInput.required = true;
  };
}

initSignup();
</script>
  
