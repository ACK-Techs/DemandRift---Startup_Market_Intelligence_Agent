          Individual
        </a>

        <a  href="/pricing?plan=family">
          Family
        </a>

        <a  href="/pricing?plan=team">
          Team
        </a>
      </div>

        
      
        <div class="tabs-component --no-border --shadow">
          <a aria-current="true" href="/pricing?plan=individual&period=monthly">
