  <script nonce="BKDfzKqrdMlthnHe7pFcrA">window.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('#signInForm');
  const email_error_message_box = document.querySelector('#_0_email_error_message_box');
  const password_error_message_box = document.querySelector('#_0_password_error_message_box');
  const email_input_label = document.querySelector('#_0_label_signInEmailBox');
  const password_input_label = document.querySelector('#_0_label_signInPasswordBox');
  const popupCheckBoxInput = document.querySelector("#free_search_signup_box_close");
  const _isMobile = document.querySelector('body').classList.contains('mob');

  if (!form) return;

  if (!email_error_message_box || !email_input_label || !password_input_label) {
    console.log('No error labels found');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clear_error_label();
    const csrf = document.querySelector('input[name="_csrf"]').value || '';
    const email = document.querySelector('input[name="email"]').value || '';
    const password = document.querySelector('input[name="password"]').value || '';
    const referred_from = document.querySelector('input[name="referred_from"]').value || '';

    const formBody = new URLSearchParams();
    formBody.append('_csrf', csrf);
    formBody.append('email', email);
    formBody.append('password', password);
    formBody.append('referred_from', referred_from);
    formBody.append('js', '1');

    fetch('/sign_up', {
      method: 'POST',
      body: formBody.toString(),
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      credentials: 'same-origin'
    })
      .then((resp) => {
        if (resp.ok) {
          successMessage();
          return;
        } else if (resp.status === 500) {
          console.log("ERROR 500");
          return;
        } else if (resp.status === 400) {
          resp.text().then((text) => {
            render_error(text);
          });
        }
      })
      .catch((error) => {
        console.error(error);
      });
  });

  function render_error(error_type) {
    if (error_type == "bad_password") {
      const invalidPasswordTemplateElement = document.querySelector('#_0_invalid_password_template');
      const invalidPasswordTemplate = invalidPasswordTemplateElement ? invalidPasswordTemplateElement.content : false;
      const newTemplate = invalidPasswordTemplate.cloneNode(true);
      password_error_message_box.hidden = false;
      password_input_label.classList.add('error');
      password_error_message_box.appendChild(newTemplate);
    } else {
      let error_text = null;
      const invalidEmailTemplateElement = document.querySelector('#_0_invalid_email_template');
      const invalidEmailTemplate = invalidEmailTemplateElement ? invalidEmailTemplateElement.content : false;

      switch (error_type) {
        case "bad_email":
          const bad_email_error_element = document.querySelector('._0_free_search_signup_box #bad_email')
          if (!bad_email_error_element) console.error("bad_email error text element not found");
          error_text = bad_email_error_element.value;
          break;
        case "error":
          const generic_error_element = document.querySelector('._0_free_search_signup_box #bad_email')
          if (!generic_error_element) console.error("generic_error error text element not found");
          error_text = generic_error_element.value;
          break;
      }

      const newTemplate = invalidEmailTemplate.cloneNode(true);
      newTemplate.querySelector('#_0_email_error_message_text').innerHTML = error_text;
      email_error_message_box.innerHTML = "";
      email_error_message_box.hidden = false;
      email_input_label.classList.add('error');
      email_error_message_box.appendChild(newTemplate);
    }
  }

  function clear_error_label() {
    email_error_message_box.innerHTML = "";
    password_error_message_box.innerHTML = "";
    email_error_message_box.hidden = true;
    password_error_message_box.hidden = true;
    email_input_label.classList.remove('error');
    password_input_label.classList.remove('error');
  }

  function successMessage() {
    const hideOnSuccessElements = document.querySelectorAll('._0_fsp_signup_h');
    const showOnSuccessElements = document.querySelectorAll('._0_fsp_signup_s');

    hideOnSuccessElements.forEach(hideOnSuccessElement => {
      hideOnSuccessElement.hidden = true;
    });

    showOnSuccessElements.forEach(showOnSuccessElement => {
      showOnSuccessElement.hidden = false;
    });

    setTimeout(() => {
      window.location.reload();
    }, 1000);
  }

  if (popupCheckBoxInput && _isMobile) {
    popupCheckBoxInput.addEventListener("change", (e) => {
      const popupOpen = e.target.checked;
      if (popupOpen) {
        document.body.classList.add("o-h");
      } else {
        document.body.classList.remove("o-h");
      }
    });
  }

});
</script>
  <script nonce="BKDfzKqrdMlthnHe7pFcrA">window.addEventListener('DOMContentLoaded', () => {
  const showPasswordToggles = document.querySelectorAll('.showPasswordEye input');

  showPasswordToggles.forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const passwordField = toggle.closest('.input-pass, .relative')?.querySelector('._0_pass_field');
      if (passwordField) {
        passwordField.type = toggle.checked ? 'text' : 'password';
      }
    });
  });
});
</script>


