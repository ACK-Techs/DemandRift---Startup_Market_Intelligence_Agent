<style>
/* ---------- Tokens ---------- */
:root {
color-scheme: light dark;
--font-regular: 'geomanistregular', sans-serif;
--font-medium: 'geomanistmedium', sans-serif;
--size0-text: 10px;
--base-text: 12px;
--size1-text: 16px;
--size2-text: 20px;
--size3-text: 32px;
--size4-text: 48px;
--size-h1-desktop: 90px;
/* Marca */
--color1: #1F4E5A;
--color2: #00AAD5;
--color3: #EDF3F4;
--turbo: #E06290;
/* Semánticos (claro) */
--page: #ffffff;
--ink: var(--color1);
--ink-soft: #4E7580;
--surface: var(--color3);
--surface-raised: #ffffff;
--surface-deep: var(--color1);
--border: #DCE7E9;
--accent-soft: rgba(0, 170, 213, 0.1);
--spacing: 10px;
--spacing2: 20px;
--spacing4: 40px;
--spacing8: 80px;
--gutter: 20px;
--section-y: 64px;
--radius: 14px;
--radius-sm: 10px;
--radius-lg: 24px;
--maxw: 1120px;
--maxw-text: 65ch;
--shadow-sm: 0 1px 2px rgba(31, 78, 90, 0.06), 0 8px 24px rgba(31, 78, 90, 0.06);
--shadow-md: 0 12px 32px rgba(31, 78, 90, 0.12);
--lineheight: 150%;
}
/* ---------- Base ---------- */
body {
font-family: var(--font-regular);
background: var(--page);
color: var(--ink);
}
.content header {
position: sticky;
top: 0;
overflow: hidden;
z-index: 20;
}
.breadcrumb {
box-sizing: border-box;
width: 100%;
margin: 0 auto;
font-size: var(--base-text);
padding: var(--spacing) var(--gutter);
color: var(--ink-soft);
}
.breadcrumb a {
color: var(--ink-soft);
text-decoration: none;
}
.breadcrumb a:hover,
.breadcrumb a:focus-visible {
color: var(--color2);
text-decoration: underline;
}
:where(a, button):focus-visible {
outline: 2px solid var(--color2);
outline-offset: 3px;
border-radius: 4px;
}
/* ---------- Ritmo de sección ---------- */
/* Cada sección paga su propio espaciado y puede ocupar el ancho
completo; el contenido se centra con una medida máxima propia. */
main {
display: flex;
flex-direction: column;
margin: 0;
gap: 0;
}
main section {
display: flex;
flex-direction: column;
align-items: center;
gap: var(--spacing2);
padding: var(--section-y) var(--gutter);
text-align: center;
}
main section > * {
width: 100%;
max-width: var(--maxw);
}
/* Bandas con superficie propia, para separar bloques sin reglas */
.security,
.installer {
background: var(--surface);
}
.turbo {
background: linear-gradient(180deg, rgba(224, 98, 144, 0.08), rgba(224, 98, 144, 0.14));
}
/* ---------- Tipografía ---------- */
.title-h1 {
font-family: var(--font-medium);
font-size: clamp(34px, 7vw, 48px);
line-height: 1.1;
letter-spacing: -0.5px;
color: var(--ink);
text-wrap: balance;
}
.title-h1 span {
color: var(--color2);
}
.title-h2 {
font-family: var(--font-medium);
font-size: clamp(26px, 4.4vw, 34px);
line-height: 1.2;
letter-spacing: -0.3px;
color: var(--ink);
text-wrap: balance;
}
.title-h2 span {
color: var(--color2);
}
.turbo .title-h2 span {
color: var(--turbo);
}
.subtitle,
.text {
color: var(--ink-soft);
line-height: var(--lineheight);
font-size: var(--size1-text);
max-width: var(--maxw-text);
margin: 0 auto;
}
.text a,
.subtitle a {
color: var(--color2);
font-family: var(--font-medium);
text-decoration: underline;
text-underline-offset: 2px;
}
.bold {
font-family: var(--font-medium);
}
.center {
text-align: center;
align-self: center;
}
/* ---------- Botones ---------- */
main button,
main .button {
background: var(--color2);
border: 1px solid var(--color2);
width: fit-content;
max-width: 100%;
color: #ffffff;
padding: 14px var(--spacing2);
border-radius: var(--radius-sm);
text-transform: uppercase;
font-family: var(--font-medium);
font-size: var(--base-text);
letter-spacing: 0.4px;
display: inline-flex;
align-items: center;
justify-content: center;
gap: var(--spacing);
cursor: pointer;
text-decoration: none;
box-shadow: 0 8px 20px rgba(0, 170, 213, 0.24);
transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}
main .button:hover {
transform: translateY(-2px);
box-shadow: 0 14px 28px rgba(0, 170, 213, 0.32);
}
main .button:active {
transform: translateY(0);
}
.turbo .button {
background: var(--turbo);
border-color: var(--turbo);
box-shadow: 0 8px 20px rgba(224, 98, 144, 0.28);
}
.turbo .button:hover {
box-shadow: 0 14px 28px rgba(224, 98, 144, 0.36);
}
a .button img,
a.button img {
filter: brightness(0) invert(1);
}
/* ---------- Hero ---------- */
/* El orden visual no es el del marcado: titulo, reclamo, texto,
mockup y por ultimo las cifras. */
.hero {
padding-top: var(--spacing4);
padding-bottom: var(--spacing4);
gap: var(--spacing2);
}
.hero .title-h1 { order: 1; }
.hero .title-h2 { order: 2; }
.hero .subtitle { order: 3; }
.hero .feature { order: 4; }
.hero .list { order: 5; }
.hero .title-h2 {
font-family: var(--font-regular);
font-size: clamp(20px, 3vw, 26px);
color: var(--ink-soft);
letter-spacing: 0;
}
.feature {
display: block;
margin: var(--spacing2) auto 0;
width: 100%;
max-width: 360px;
height: auto;
}
/* ---------- Cifras ---------- */
section ul.list {
list-style: none;
display: grid;
grid-template-columns: 1fr;
gap: var(--spacing2);
padding: 0;
margin: var(--spacing2) 0 0;
}
section ul.list li {
display: flex;
align-items: center;
justify-content: center;
gap: var(--spacing2);
padding: var(--spacing2);
background: var(--surface);
border: 1px solid var(--border);
border-radius: var(--radius);
text-align: left;
}
.list li > h3 {
display: flex;
align-items: center;
gap: var(--spacing2);
width: 100%;
justify-content: center;
}
section ul.list li span {
font-family: var(--font-medium);
color: var(--color2);
font-size: clamp(38px, 8vw, 52px);
line-height: 1;
text-align: right;
flex: none;
}
.list li > h3 div {
flex: 1;
max-width: 22ch;
font-size: var(--size1-text);
font-family: var(--font-regular);
color: var(--ink-soft);
line-height: 1.35;
}
section ul.list li b {
font-family: var(--font-medium);
color: var(--ink);
}
/* ---------- Productos ---------- */
section .box {
display: grid;
grid-template-columns: 1fr;
gap: var(--spacing2);
width: 100%;
align-items: stretch;
}
.products {
position: relative;
background: var(--surface);
border: 1px solid var(--border);
border-radius: var(--radius);
padding: var(--spacing) var(--spacing) var(--spacing2);
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
gap: var(--spacing);
transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}
.products:hover,
.products:has(.button:focus-visible) {
transform: translateY(-4px);
border-color: rgba(0, 170, 213, 0.35);
box-shadow: var(--shadow-md);
}
.products .button::after {
content: '';
position: absolute;
inset: 0;
}
.products .button:hover,
.products .button:active {
transform: none;
}
.products .mockup-wrap {
display: flex;
align-items: flex-end;
justify-content: center;
width: 100%;
height: 200px;
padding: var(--spacing2) var(--spacing2) 0;
border-radius: calc(var(--radius) - 4px);
overflow: hidden;
}
.products .mockup {
max-width: 100%;
max-height: 100%;
width: auto;
object-fit: contain;
object-position: bottom;
transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.products:hover .mockup {
transform: translateY(-6px) scale(1.02);
}
/* La captura del cliente se monta en un monitor sin peana, para que
pese lo mismo que los renders de dispositivo de las otras tarjetas. */
/* Los renders de movil se apoyan abajo; el monitor, mas bajo, se
centra en el panel para no dejar el hueco arriba. */
.products .mockup-wrap:has(.monitor) {
align-items: center;
padding: var(--spacing2) 0 0;
}
.products .monitor {
display: block;
width: 100%;
max-width: 250px;
margin: 0 auto;
padding: 9px 9px 20px;
border-radius: 12px;
background: linear-gradient(180deg, #2E4048 0%, #1D2C33 65%, #16232A 100%);
box-shadow:
0 18px 34px rgba(0, 0, 0, 0.3),
inset 0 1px 0 rgba(255, 255, 255, 0.14);
transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
/* Marca del chasis: sugiere el monitor sin dibujar la peana */
.products .monitor::after {
content: '';
display: block;
width: 32px;
height: 3px;
margin: 8px auto 0;
border-radius: 2px;
background: rgba(255, 255, 255, 0.2);
}
.products .monitor .mockup {
display: block;
width: 100%;
max-width: none;
max-height: none;
aspect-ratio: 16 / 10;
object-fit: cover;
object-position: top center;
border-radius: 4px;
transform: none;
}
.products:hover .monitor {
transform: translateY(-6px) scale(1.02);
}
.products:hover .monitor .mockup {
transform: none;
}
.products h3 {
color: var(--ink);
font-size: var(--size2-text);
font-family: var(--font-medium);
line-height: 1.25;
margin-top: var(--spacing);
text-wrap: balance;
}
.products p {
font-size: var(--base-text);
color: var(--ink-soft);
line-height: var(--lineheight);
max-width: 34ch;
margin: 0 auto;
text-wrap: pretty;
}
.products .platforms {
display: flex;
align-items: center;
justify-content: center;
gap: 8px;
margin-top: auto;
padding-top: var(--spacing);
}
.products .platform {
width: 28px;
height: 28px;
border-radius: 50%;
border: 1px solid var(--border);
color: var(--ink-soft);
display: flex;
align-items: center;
justify-content: center;
flex: none;
}
.products .platform svg {
width: 14px;
height: 14px;
}
.products .button {
text-decoration: underline;
text-underline-offset: 2px;
min-width: 180px;
margin-bottom: var(--spacing);
text-decoration: none;
}
/* ---------- Ventajas ---------- */
section ul.points {
list-style: none;
display: grid;
grid-template-columns: 1fr;
gap: var(--spacing2);
padding: 0;
margin: var(--spacing2) 0 0;
text-align: left;
}
section ul.points li {
position: relative;
display: grid;
grid-template-columns: auto minmax(0, 1fr);
align-items: start;
gap: var(--spacing2);
padding: var(--spacing2);
background: var(--surface-raised);
border: 1px solid var(--border);
border-radius: var(--radius);
box-shadow: var(--shadow-sm);
transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}
section ul.points li:hover {
transform: translateY(-3px);
border-color: rgba(0, 170, 213, 0.35);
box-shadow: var(--shadow-md);
}
/* El rombo de marca hace de icono, a tamaño de chip */
section ul.points li svg {
position: static;
width: 34px;
height: 34px;
flex: none;
}
section li h3 {
font-family: var(--font-medium);
color: var(--ink);
font-size: var(--size1-text);
display: block;
line-height: 1.3;
}
.point {
display: flex;
flex-direction: column;
gap: 6px;
}
.point span {
color: var(--ink-soft);
font-size: var(--base-text);
line-height: var(--lineheight);
}
section li span a {
font-family: var(--font-medium);
color: var(--color2);
text-decoration: underline;
text-underline-offset: 2px;
}
section li span a:lang(ro), section li span a:lang(ru), section li span a:lang(tr), section li span a:lang(vi) {
font-weight: 600;
font-family: sans-serif;
}
/* ---------- Breakpoints ---------- */
@media (min-width: 600px) {
:root {
--gutter: 32px;
--section-y: 80px;
}
section ul.list,
section ul.points {
grid-template-columns: repeat(2, 1fr);
}
section .box {
grid-template-columns: repeat(2, 1fr);
}
}
@media (min-width: 1024px) {
:root {
--size0-text: 12px;
--base-text: 14px;
--size1-text: 18px;
--size2-text: 22px;
--size3-text: 40px;
--size4-text: 80px;
--gutter: 40px;
--section-y: 112px;
}
.title-h1 {
font-size: clamp(48px, 5vw, var(--size-h1-desktop));
}
.title-h1:lang(hi),
.title-h1 span:lang(hi) {
line-height: normal;
}
.feature {
max-width: 420px;
}
/* Hero a dos columnas: el marcado sigue igual, la colocacion es
explicita para no depender del orden de los nodos. */
.hero {
display: grid;
grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
column-gap: var(--spacing8);
row-gap: var(--spacing2);
align-items: center;
justify-content: center;
text-align: start;
padding-top: var(--spacing8);
/* La rejilla del hero se cine a la misma medida que el resto
de secciones, cuyos hijos van topados a --maxw. */
max-width: var(--maxw);
margin-inline: auto;
}
.hero > * {
max-width: none;
}
.hero .title-h1 { grid-area: 1 / 1; }
.hero .title-h2 { grid-area: 2 / 1; }
.hero .subtitle { grid-area: 3 / 1; margin: 0; max-width: 54ch; }
.hero .feature { grid-area: 1 / 2 / 4 / 3; margin: 0; justify-self: center; }
.hero .list { grid-area: 4 / 1 / 5 / -1; margin-top: var(--spacing4); }
section ul.list {
grid-template-columns: repeat(3, 1fr);
}
section ul.points {
grid-template-columns: repeat(3, 1fr);
}
section .box {
grid-template-columns: repeat(4, 1fr);
gap: 25px;
}
.products {
padding: var(--spacing) var(--spacing) 25px;
}
.products .mockup-wrap {
height: 240px;
}
.products h3 {
font-size: 24px;
}
section ul.points li {
padding: var(--spacing4) var(--spacing2);
}
}
/* ---------- Modo oscuro ---------- */
@media (prefers-color-scheme: dark) {
:root {
--page: #0E1F24;
--ink: #D7E2E4;
--ink-soft: #9CB4BA;
--surface: #16333B;
--surface-raised: #16333B;
--surface-deep: #123039;
--border: #24454E;
--color3: #16333B;
--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
--shadow-md: 0 12px 32px rgba(0, 0, 0, 0.45);
}
.turbo {
background: linear-gradient(180deg, rgba(224, 98, 144, 0.1), rgba(224, 98, 144, 0.18));
}
.products .mockup-wrap {
}
}
/* ---------- Accesibilidad ---------- */
@media (prefers-reduced-motion: reduce) {
* {
transition-duration: 0.01ms !important;
animation-duration: 0.01ms !important;
}
}
@font-face {
font-family: 'geomanistmedium';
src: url('https://stc.utdstc.com/fonts/geomanist-medium-webfont.woff2') format('woff2');
font-weight: 500;
font-style: normal;
font-display: swap;
}
@font-face {
font-family: 'geomanistregular';
src: url('https://stc.utdstc.com/fonts/geomanist-regular-webfont.woff2') format('woff2');
font-weight: 400;
font-style: normal;
font-display: swap;
}
</style>
</head>
<body>
<div class="content">
<style>
a,abbr,acronym,address,applet,aside,audio,b,big,blockquote,body,canvas,caption,center,cite,code,dd,del,details,dfn,dl,dt,em,embed,fieldset,figcaption,figure,form,h1,h2,h3,h4,h5,h6,header,hgroup,html,i,iframe,img,ins,kbd,label,legend,li,mark,menu,nav,object,ol,output,p,pre,q,ruby,s,samp,section,small,span,strike,strong,sub,summary,sup,table,tbody,td,tfoot,th,thead,time,tr,tt,u,ul,var,video {margin: 0;padding: 0;border: 0;font-size: 100%;font: inherit;vertical-align: baseline;text-rendering: geometricPrecision;}
body {background: #eeeeee;font-family: 'geomanistregular', sans-serif;margin:0;}
body > .content {max-width: 1366px;margin: auto;background: white;position: relative;}
a {text-decoration: none;color: inherit;cursor:pointer;}
.hidden {display: none;}
section {display: flex;justify-content: center;align-items: center;flex-direction: column;padding: 50px 0 0;}
section .content {padding: 10px 10px 15px;}
section .title {font-family: 'geomanistmedium', sans-serif;color: #00AAD5;font-size: 20px;font-weight:600;padding: 20px 10px 0;display: inline-block;text-transform: uppercase;}
section .title + span {font-family: 'geomanistregular', sans-serif;color: #7F949A;font-size: 14px;font-weight: 300;padding: 0 10px 0;display: block;}
section .title + span b {color:#1F4E5A;font-family: 'geomanistmedium', sans-serif;}
header {display:flex;position:fixed;height:50px;width: 100%;z-index:4;border-bottom: 1px solid #eeeeee;background: white;justify-content: space-between;}
header a {-ms-flex-align: center;align-items: center;display: -ms-flexbox;display: inline-flex;-ms-flex-pack: center;justify-content: center;cursor:pointer;}
header .logo {position: absolute;top: 15px;right: 0;left: 9px;width: 200px;}
header .logo img {height: 20px;}
header .menu-button {height: 50px;width: 50px;padding: 0;font-family: 'geomanistregular', sans-serif;font-size: 12px;}
header .menu-button:lang(ar) {rotate:180deg;}
header .menu-button svg {margin-right: 20px;fill: #00aad5;}
header .menu-button span {display: none;color: #0081A2;}
header .search {height: 50px;width: 50px;fill:#0081A2;}
header > svg {display: none;}
.nav-main, .panel, .shadow {transition: all .5s cubic-bezier(.165,.84,.44,1);transition-timing-function: cubic-bezier(.165,.84,.44,1);}
.nav-main {position: fixed;top: 0;right: 0;bottom: 0;left: -256px;width: 256px;height: auto;z-index: 5;background: white;overflow: auto;}
@media (min-width: 1366px) {
section .content {padding: 10px 20px 15px;}
section .title {padding: 20px 20px 0;font-family: 'geomanistregular', sans-serif;color: #1F4E5A;font-size: 30px;font-weight: 600;}
section .title + span {padding: 0 20px 10px;font-family: 'geomanistregular', sans-serif;color: #7F949A;font-size: 20px;font-weight: 300;}
header {max-width:1366px;margin: auto;left:0;right:0;position: relative;height: 80px;justify-content: flex-start;}
header .menu-button {height: 80px; width:auto;padding: 0 20px 0;display:flex; gap:20px;}
header > svg {display: block;fill:#2D709B;padding: 30px;margin-left: auto;}
header .menu-button span {display: block;font-size: 14px;}
header .logo {transform: scale(1.5);position: relative;top: 3px;left: -20px;}
header .logo img {height: 20px;}
}
@media (prefers-color-scheme: dark) {
body {background: #09191d;}
body > .content {background: #0F292F;}
header {background: #0F292F;}
header .search, header .menu-button, header > svg {fill:#fff;}
header .menu-button span {color: white;}
header .menu-button svg {fill: #fff;}
section .title {color: white;}
section .title + span {color: white;}
}
</style>
