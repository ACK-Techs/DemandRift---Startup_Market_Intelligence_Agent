<script>

    $(document).ready(function() {
     function getPathname(url) {
        return new URL(url, window.location.origin).pathname
            .replace(/\/$/, '')   // remove trailing slash
            .toLowerCase();      // normalize
    }

       var currentUrl = window.location.pathname;
    var matched = false; // flag to track if exact match was found

    // Step 1: Exact match
    $('.lp__page_navitem a').each(function() {
        var linkUrl = $(this).attr('href');
        if(linkUrl){
            linkUrl = getPathname(linkUrl);
        }

        if (linkUrl === currentUrl) {
            $(this).parent().addClass('active').siblings().removeClass('active');
            matched = true;
            return false; // stop looping after exact match
        }
    });

    // Step 2: Fallback to contains if no exact match
    if (!matched) {
        $('.lp__page_navitem a').each(function() {
            var linkUrl = $(this).attr('href');
            if(linkUrl){
            linkUrl = getPathname(linkUrl);
        }

            if (currentUrl.indexOf(linkUrl) > -1) {
                $(this).parent().addClass('active').siblings().removeClass('active');
                return false; // stop after first contains match
            }
        });
    }

           $(tab).find(".lp__tab_active").removeClass("lp__tab_active");
      var hashValue = window.location.hash.match(/\d+/)=== null?1:window.location.hash.match(/\d+/)[0];
      hashValue = parseInt(hashValue);

     console.log("hashValue",hashValue);
     var addActiveTo = (hashValue>tabObj.length)?(tabObj.length-1):hashValue;
       if(hashValue > 1){
     $(".lp__tab_components").find(".lp__wrapper ul.lp__tablist li").find("#"+addActiveTo+"-tab")[0].click();
}

    });
</script></div>

