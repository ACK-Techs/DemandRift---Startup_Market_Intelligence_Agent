    " target="" rel="noopener noreferrer" href="https://app.prolific.com/register/researcher/email?utm_content=pricing"><div>Get started for free</div></a></div></div></div></div></div></div></div><!--$--><!--/$--></div><div class="Footer" role="contentinfo"><div class="wrap"><div class="Footer__inner"><div class="Footer__top"><div class="Footer__left"><div class="Footer__brand"><a class="Footer__logo" aria-label="Go to home" href="/"><svg class="" viewBox="0 0 1180.3 275.9"><g><path d="M464.1,53.9h-36.3c-.1,0-.3,0-.4,0h-36.5c-3,0-4.5,3.2-2.4,5.1,5,4.6,11.7,12.2,11.7,23s0,.1,0,.2v117.8s0,0,0,.1c0,10.8-6.7,18.4-11.7,23-2.1,1.9-.6,5.1,2.4,5.1h49.9c3,0,4.5-3.1,2.5-5-5-4.6-11.7-12.3-11.7-23s0-.2,0-.4v-37.6c0-1.5,1.2-2.8,2.8-2.8h24.4c36.3,0,65.4-16.7,65.4-54.3s-23.3-51.1-60.1-51.1ZM448.3,142.3h-13.9c-1.5,0-2.8-1.2-2.8-2.8v-66.6c0-1.5,1.2-2.8,2.8-2.8h14.2c24.5,0,41.9,9.9,41.9,35.4s-18.2,36.8-42.2,36.8Z"></path><path d="M604.6,108.9c-13.6,0-25,11.1-30.5,29.1v-7.1c0,0,0-.2,0-.3l-2-20.3c-.2-2-2.4-3.2-4.2-2.1l-36.4,21c-1.4.8-1.7,2.5-1,3.8.3.6,1,1,1.6,1.1l4.5.7c4.8.7,8.3,4.8,8.4,9.6h0v55.8s0,0,0,0c0,10.8-5.8,18.4-10.2,23-1.8,1.9-.5,5.1,2.1,5.1h45.2c2.6,0,4-3.1,2.2-5-4.4-4.6-10.1-12.2-10.2-22.8v-35.3c0,0,0-.1,0-.2,1-16.9,7.5-29.2,13.3-29.2s7.5,11.6,20.1,11.6,17-8.7,17-18.9-9.7-19.4-19.9-19.4Z"></path><path d="M687.8,109.6c38,0,60.8,26.2,61.1,60.3,0,37.6-24.5,59.9-61.1,60.6-36.6-.5-61.1-22.8-61.1-60.1s25-60.8,61.1-60.8ZM715.2,170.2c0-25.7-6.1-49-27.4-49.2-21.6-.2-27.4,23.3-27.4,49.2s5.8,48.7,27.4,48.7,27.4-22.8,27.4-48.7Z"></path><path d="M809.4,223c-4.4-4.5-10.4-12-10.4-23s0-.4,0-.5V51.1c0-2.1-2.3-3.5-4.2-2.5l-38.9,21.2c-1.9,1-1.6,3.8.4,4.5h0s4,.3,4,.3c5.2.4,9.4,4.6,9.5,9.9,0,0,0,.1,0,.2v115.5c0,10.9-6.1,18.3-10.5,22.8-1.8,1.9-.5,5.1,2.1,5.1h45.7c2.7,0,4-3.2,2.1-5.1Z"></path><path d="M881.6,223c-4.4-4.4-10.8-11.3-11-22.5v-89.9c0-2.1-2.3-3.5-4.1-2.4l-38.3,21c-.5.3-.8.6-1.1,1-1,1.6.3,3.7,2.2,3.9l3,.3c5.1.5,9.1,4.6,9.3,9.8,0,0,0,.1,0,.2v56c0,11.2-6.5,18.3-10.9,22.7-1.9,1.9-.5,5.1,