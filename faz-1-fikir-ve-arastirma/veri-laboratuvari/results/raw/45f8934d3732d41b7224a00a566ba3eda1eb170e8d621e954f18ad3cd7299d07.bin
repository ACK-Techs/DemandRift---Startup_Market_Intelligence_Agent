08T17:43:06.674Z","firstPublishedAt":"2025-07-08T17:43:06.674Z"}},"categories":null,"slug":null,"testimonial":{"__typename":"TestimonialPostTestimonial","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Thanks to ZoomInfo, we no longer have to question the source or reliability of the data in our systems. We’re now able to enrich and integrate data in any workflow, in real-time, at scale.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"sys":{"__typename":"Sys","id":"EudHd1CDxojAdny57sZvt","publishedAt":"2026-08-28T21:18:52.076Z","firstPublishedAt":"2025-07-08T17:43:07.163Z"}},{"__typename":"TestimonialPost","name":"Andy Ruffles","jobTitle":"Director of Sales Operations \u0026 Strategy at Capital One","hq":null,"logo":{"__typename":"Asset","title":"capital-one-logo","description":"","contentType":"image/png","fileName":"capital-one-logo.png","size":982,"url":"https://images.ctfassets.net/kyld7105l6mt/4HNibQWNyjIwWqfIQmDNzE/31885c45f200eac58c32421c7a9fa4f4/capital-one-logo.png","width":67,"height":24,"sys":{"__typename":"Sys","id":"4HNibQWNyjIwWqfIQmDNzE","publishedAt":"2025-07-08T17:43:06.677Z","firstPublishedAt":"2025-07-08T17:42:56.782Z"}},"categories":null,"slug":null,"testimonial":{"__typename":"TestimonialPostTestimonial","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo has become an integral part of our business. Simply put, without it, we would have a huge gap in our sales enablement strategy that we would be scrambling to figure out how to fill.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"sys":{"__typename":"Sys","id":"4WmAZgAsNLDwSV3LeSC3KV","publishedAt":"2026-08-28T21:18:57.973Z","firstPublishedAt":"2025-07-08T17:43:07.183Z"}},{"__typename":"TestimonialPost","name":"Heidi Lindstad","jobTitle":"Strategic Account Development at Snowlflake","hq":null,"logo":{"__typename":"Asset","title":"snowflake-logo 1","description":"","contentType":"image/png","fileName":"snowflake-logo__1_.png","size":993,"url":"https://images.ctfassets.net/kyld7105l6mt/42gGu4kSdnBqQUgJgmeTgg/1c5463fafeca0f7a3fc474e6b45916f3/snowflake-logo__1_.png","width":113,"height":24,"sys":{"__typename":"Sys","id":"42gGu4kSdnBqQUgJgmeTgg","publishedAt":"2025-07-08T17:43:06.681Z","firstPublishedAt":"2025-07-08T17:43:06.681Z"}},"categories":null,"slug":null,"testimonial":{"__typename":"TestimonialPostTestimonial","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"All those times I was looking for numbers of important prospects and I didn't find them. In despair, I'd look for them in ZoomInfo and find them. Like an early Xmas gift!","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"sys":{"__typename":"Sys","id":"0t46lGFiRx2jFB0q5wH8s","publishedAt":"2026-08-28T21:19:04.225Z","firstPublishedAt":"2025-07-08T17:43:07.197Z"}},{"__typename":"TestimonialPost","name":"Ashley Stoltz ","jobTitle":"Supply Chain Solutions Consultant at Staples ","hq":null,"logo":{"__typename":"Asset","title":"staples-logo","description":"","contentType":"image/png","fileName":"staples-logo.png","size":883,"url":"https://images.ctfassets.net/kyld7105l6mt/3j4StOUBoR1RKqlsDnBD3E/f8e3445b353d4e8d9d684aa199fe8313/staples-logo.png","width":136,"height":24,"sys":{"__typename":"Sys","id":"3j4StOUBoR1RKqlsDnBD3E","publishedAt":"2025-07-08T17:43:06.683Z","firstPublishedAt":"2025-07-08T17:43:06.683Z"}},"categories":null,"slug":null,"testimonial":{"__typename":"TestimonialPostTestimonial","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"It's saving me so much time finding new prospects with correct contact information. I love their social accounts are all on the same dashboard as wel!! It's a one stop shop!!","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"sys":{"__typename":"Sys","id":"Ah8DTn7JYtjn3xP8qL8De","publishedAt":"2026-08-28T21:19:10.094Z","firstPublishedAt":"2025-07-08T17:43:07.215Z"}}]},"formPopupButton":{"__typename":"ButtonPopupForm","button":{"__typename":"Button","target":null,"title":"Free Trial","url":"https://www.zoominfo.com/free-trial","type":null,"icon":null,"media":null,"vidyardId":null,"hasAnalytics":null,"copyUrl":null,"copySuccessMessage":null,"analyticsElementName":null,"analyticsElementTitle":null,"analyticsUiElementType":null,"sys":{"__typename":"Sys","id":"65i77skB0xX09ETike9kes","publishedAt":"2026-08-30T01:02:34.857Z","firstPublishedAt":"2025-07-08T17:43:07.148Z"}},"form":{"__typename":"Form","campId":"7017y00001JJKUKAA5","offerType":"none","submitText":"Free Trial","submitButtonType":null,"subtitle":null,"thankYouMessage":null,"title":"Start Free Trial","isCustomFormDesign":null,"bulletListItems":{"__typename":"FormBulletListItemsCollection","items":[]},"recentMktResponse":null,"ftorigin":null,"formType":"default","customRedirect":null,"customRedirectToAFile":null,"disableAutoprovisionFlow":false,"disableRedirect":null,"enableEmployeeCountFlow":true,"noBackgroundColor":null,"hideGlassEffect":null,"designType":null,"isFormOpen":null,"colorTheme":"default","isFormPopupButton":false,"addRequiredCheckbox":null,"checkboxText":null,"ctaPlacement":null,"isCloseIconLight":null,"sys":{"__typename":"Sys","id":"62w8iml9jxawbwKSlKelUa","publishedAt":"2026-08-29T15:37:45.561Z","firstPublishedAt":"2025-07-08T18:05:46.815Z"}},"sys":{"__typename":"Sys","id":"242tQInRJ46zp8WjO7xkue","publishedAt":"2025-07-08T18:06:33.034Z","firstPublishedAt":"2025-07-08T17:43:07.056Z"}},"backgroundColorOptions":null,"sys":{"__typename":"Sys","id":"6l6ifjFfekmvsSHWYXcXrM","publishedAt":"2026-08-29T01:43:42.243Z","firstPublishedAt":"2025-07-08T17:43:06.943Z"}},{"__typename":"SectionTrustBanner","title":"Join the ABM platform trusted by over 250 million users","subtitle":null,"rank":{"__typename":"HeroBannerRank","text":"8,000+ G2 Reviews","isReversed":null,"size":null,"image":{"__typename":"Asset","title":"stars-container","description":"","contentType":"image/svg+xml","fileName":"stars-container.svg","size":3277,"url":"https://images.ctfassets.net/kyld7105l6mt/3DOFwfuFhZX35863WAxXpq/b89e4177a47e63f642db9f88995f8f76/stars-container.svg","width":104,"height":18,"sys":{"__typename":"Sys","id":"3DOFwfuFhZX35863WAxXpq","publishedAt":"2026-08-20T21:11:35.235Z","firstPublishedAt":"2025-11-10T19:36:35.923Z"}},"sys":{"__typename":"Sys","id":"2sOYD2OxbU4MO3esDLWxW4","publishedAt":"2026-08-29T06:19:19.871Z","firstPublishedAt":"2025-05-28T02:59:39.414Z"}},"button":{"__typename":"Button","target":null,"title":"Free Trial","url":"/free-trial?camp_id=7017y00001JIxRJAA1","type":null,"icon":null,"media":null,"vidyardId":null,"hasAnalytics":null,"copyUrl":null,"copySuccessMessage":null,"analyticsElementName":null,"analyticsElementTitle":null,"analyticsUiElementType":null,"sys":{"__typename":"Sys","id":"2izSwgeVf6Kv3pKoMOUwz6","publishedAt":"2026-08-30T01:02:44.212Z","firstPublishedAt":"2025-07-08T18:11:18.570Z"}},"form":null,"badges":{"__typename":"SectionTrustBannerBadgesCollection","total":0,"items":[]},"images":{"__typename":"AssetCollection","total":4,"items":[{"__typename":"Asset","title":"Sales-Engagement","description":null,"contentType":"image/png","fileName":"Sales Engagement.png","size":20870,"url":"https://images.ctfassets.net/kyld7105l6mt/5daduevzmWNLnpbqYwYIFx/0e9c03f707ab03604602e78b7cace6e6/Sales_Engagement.png","width":500,"height":576,"sys":{"__typename":"Sys","id":"5daduevzmWNLnpbqYwYIFx","publishedAt":"2025-06-27T17:21:28.889Z","firstPublishedAt":"2025-06-26T14:19:17.322Z"}},{"__typename":"Asset","title":"Marketing Account Intelligence","description":null,"contentType":"image/png","fileName":"Marketing Account Intelligence.png","size":22494,"url":"https://images.ctfassets.net/kyld7105l6mt/dXjwGpvFW4rbyQ4fBVMag/8f87a15707b90bc9bc21aaa2f710a2cd/Marketing_Account_Intelligence.png","width":500,"height":576,"sys":{"__typename":"Sys","id":"dXjwGpvFW4rbyQ4fBVMag","publishedAt":"2025-06-27T17:41:25.782Z","firstPublishedAt":"2025-06-27T17:41:25.782Z"}},{"__typename":"Asset","title":"Sales-Intelligence","description":null,"contentType":"image/png","fileName":"Sales Intelligence.png","size":20211,"url":"https://images.ctfassets.net/kyld7105l6mt/79oIlhLrqfIBVsHf92Xvf9/4c5bb5461f868139089d04f58bf1bc59/Sales_Intelligence.png","width":500,"height":576,"sys":{"__typename":"Sys","id":"79oIlhLrqfIBVsHf92Xvf9","publishedAt":"2026-02-05T17:53:52.790Z","firstPublishedAt":"2025-06-26T14:18:58.986Z"}},{"__typename":"Asset","title":"Email Verification Tracking G2 Spring -25 Leader Badge-7","description":null,"contentType":"image/svg+xml","fileName":"Email Verification Tracking G2 Spring -25 Leader Badge-7.svg","size":36627,"url":"https://images.ctfassets.net/kyld7105l6mt/70RfBegowVCyseHhXhiW5z/b04f7df3a16d76e22cd88ae76841a128/Email_Verification_Tracking_G2_Spring_-25_Leader_Badge-7.svg","width":500,"height":576,"sys":{"__typename":"Sys","id":"70RfBegowVCyseHhXhiW5z","publishedAt":"2025-07-08T17:43:06.686Z","firstPublishedAt":"2025-07-08T17:43:06.686Z"}}]},"trustCards":{"__typename":"SectionTrustBannerTrustCardsCollection","total":0,"items":[]},"backgroundColorOptions":{"__typename":"BackgroundColor","backgroundColor":"neutral-0-bg"},"padding":null,"sys":{"__typename":"Sys","id":"aBQFKKMwzBTGk0SqQw75q","publishedAt":"2026-08-29T01:38:27.713Z","firstPublishedAt":"2025-07-08T17:43:07.231Z"}},{"__typename":"SectionFaqAccordion","title":"Frequently Asked Questions","label":null,"subtitle":null,"view":"centered","titleLeftAligned":null,"links":{"__typename":"SectionFaqAccordionLinksCollection","total":1,"items":[{"__typename":"Link","target":null,"title":"Learn more about Zoominfo pricing","url":"/free-trial?camp_id=7014y000001YVtKAAW","hidden":null,"hasAnalytics":null,"analyticsElementName":null,"analyticsElementTitle":null,"analyticsUiElementType":null,"icon":null,"media":null,"file":null,"hasAmplitude":null,"sys":{"__typename":"Sys","id":"hnJfUsK3R0N5gqStW4Cza","publishedAt":"2026-08-29T10:10:44.282Z","firstPublishedAt":"2025-05-16T20:41:58.421Z"}}]},"faqs":{"__typename":"SectionFaqAccordionFaqsCollection","total":7,"items":[{"__typename":"Faq","question":"Is ZoomInfo worth the price?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo has a proven track record of helping our customers reach their most important goal: profitable growth to the bottom line.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The B2B intelligence and automation available to ZoomInfo customers powers their go-to-market strategies and gives them the ability to deliver the right message, at the right time, to the perfect prospect.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Need examples? Check out our ","nodeType":"text"},{"data":{"uri":"/about/case-studies/instapage"},"content":[{"data":{},"marks":[],"value":"case study featuring Instapage","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", a software company that increased year-over-year bookings by 192% after implementing ZoomInfo. Meanwhile, ","nodeType":"text"},{"data":{"uri":"/about/case-studies/clum-creative"},"content":[{"data":{},"marks":[],"value":"Clum Creative realized a 10x Return On Investment (ROI) with ZoomInfo","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", after the video production company achieved a 104% increase in appointments set and a 60% increase in leads.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"From enterprise organizations to rapidly growing start-ups and SMBs, over 30,000 customers rely on ZoomInfo to identify, connect with, and engage buyers within a Total Addressable Market (TAM). Just ask the Managing Director of Deal IQ, Aaron Kotick. After adopting ZoomInfo, his team ","nodeType":"text"},{"data":{"uri":"/about/case-studies/deal-iq"},"content":[{"data":{},"marks":[],"value":"realized an increase of over 1900% (!) in annual revenue","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":". “This is how a start-up hyper-accelerates,” Kotick explained. “We went from being a firm no one knew about to working with the largest companies in the world – all because we found them in ZoomInfo. We’ve seen a 1900% increase in annual revenue since implementing ZoomInfo.”","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Success stories like the ones above are the reason ","nodeType":"text"},{"data":{"uri":"https://www.zoominfo.com/newsroom/press-releases/zoominfo-earns-19-top-placements-g2-2020-fall-grid-reports"},"content":[{"data":{},"marks":[],"value":"ZoomInfo earned top rankings in 19 categories in the Fall 2020 reports from G2","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", a user reviews publication, even garnering a track record of superlatives issued to solutions that deliver ease-of-use, results, and ROI across all company segments.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"2G96ANew3WMNH51XjDWM9g","publishedAt":"2026-08-29T17:50:52.592Z","firstPublishedAt":"2025-05-16T20:41:51.886Z"}},{"__typename":"Faq","question":"How much does ZoomInfo cost annually?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo pricing is based on the following criteria:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"• Features and functionality\n• Number of licenses\n• Credit usage","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The cost of ZoomInfo credits is based on the depth of information a customer requires. More robust credits cover advanced B2B intelligence, such as technographics, department budgets and org charts, and real-time alerts related to company events, like funding rounds and product launches. On the other hand, basic credits offer traditional demographic and firmographic details.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Add-on solutions to the ZoomInfo platform and integrations can also impact pricing and packaging. For example, our Streaming Intent solution is available as an add on for organizations that want real-time visibility into when companies are actively searching for the products and services they provide. Pricing for Streaming Intent, like our credit model, is based on expected usage, specifically around the volume of keywords and account universe a customer is interested in tracking.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Integrations can also impact price. Our platform seamlessly integrates with popular sales and marketing technologies, including out-of-the-box integrations with Customer Relationship Management (CRM), sales automation software, and marketing automation tools. These pre-packaged integrations typically have a base cost to use and install and require a minimum purchase of bulk credits for immediate use upon installation. If credit consumption is more than originally anticipated, customers can purchase additional credits.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"6mbjscVkgam9Ki8ap4SBOC","publishedAt":"2026-08-29T17:51:09.559Z","firstPublishedAt":"2025-05-16T20:41:52.856Z"}},{"__typename":"Faq","question":"How do ZoomInfo packages work?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo takes a SaaS-based approach to pricing and packaging that provides us the flexibility to deliver our customers with the depth of B2B intelligence that matches their needs.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Packaging is based on the number of licenses our customers require and the desired level of access to data and features.. More advanced packages enable access well beyond basic contact and firmographic information; instead revealing insights like department sizes, org charts, technographics, and more.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Customers can also purchase out-of-the-box, plug-and-play integrations that sync ZoomInfo data directly into CRMs, marketing automation platforms, and sales automation tools.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"18cik4pbyjFI5gS8anrP5e","publishedAt":"2026-08-29T17:51:26.493Z","firstPublishedAt":"2025-05-16T20:41:53.844Z"}},{"__typename":"Faq","question":"What are ZoomInfo credits?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo credits represent the consumption (export) of a professional or company profile from the ZoomInfo platform. This export can originate from the primary ZoomInfo platform, the ReachOut Chrome Extension, or any time an API call is made from any number of our integrations, including CRMs, marketing automation platforms, and sales automation tools.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Each export costs one credit, and credits can be added to any package as needs change. Overall ZoomInfo pricing is based on licenses and credit usage, as well as desired features.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Your ZoomInfo package will include a predetermined number of monthly credits based on your needs. While each unique package offers a tailored number of credits based on your intended use of ZoomInfo, all credits function the same way. Whenever your team exports company or contact information, a credit is consumed.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"5vfD2tvp6iV45QzqKWq5X","publishedAt":"2026-08-29T17:50:58.215Z","firstPublishedAt":"2025-05-16T20:41:52.249Z"}},{"__typename":"Faq","question":"What is the cost per contact on ZoomInfo?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Credit usage occurs only when a user exports a contact or company profile from the platform to a CSV file or an application, most commonly an Excel file or internal CRM.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"GuyIvD65otzlGCwBPDBk4","publishedAt":"2026-08-29T17:51:03.798Z","firstPublishedAt":"2025-05-16T20:41:52.558Z"}},{"__typename":"Faq","question":"Does ZoomInfo allow monthly payments?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo offers multiple payment options depending on your package, add-on features, and number of users. Our sales team will work with you on payment frequency and options.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"4Jdu5P7nWa3sJqQNWoAU5e","publishedAt":"2026-08-29T17:51:20.832Z","firstPublishedAt":"2025-05-16T20:41:53.576Z"}},{"__typename":"Faq","question":"How do I pay ZoomInfo invoices?","answer":{"__typename":"FaqAnswer","json":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"ZoomInfo offers multiple ways for you to conveniently pay your invoice. Automatic payments including credit/debit card and ACH Debit or manual payments including wire/bank transfer, EFT, ACH, and check are all accepted.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"For more information please visit our billing and payment support page at: ","nodeType":"text"},{"data":{"uri":"https://www.zoominfo.com/about/payments"},"content":[{"data":{},"marks":[],"value":"https://www.zoominfo.com/about/payments","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"links":{"__typename":"FaqAnswerLinks","assets":{"__typename":"FaqAnswerAssets","block":[]}}},"link":null,"sys":{"__typename":"Sys","id":"GeZWU62h0wui30v9OPGL6","publishedAt":"2026-08-29T17:51:15.258Z","firstPublishedAt":"2025-05-16T20:41:53.284Z"}}]},"padding":"page-pt-pb","backgroundColorOptions":null,"sys":{"__typename":"Sys","id":"bceWXsibQNfLqGfnR7Y9G","publishedAt":"2026-08-29T03:09:49.848Z","firstPublishedAt":"2025-05-16T20:42:49.123Z"}}]},"seo":{"__typename":"Seo","proSchemasManual":{"name":"ZoomInfo Products","@type":"ItemList","@context":"https://schema.org","itemListElement":[{"item":{"@id":"https://www.zoominfo.com/products/sales#product","url":"https://www.zoominfo.com/products/sales","name":"ZoomInfo Sales","@type":"Product","aggregateRating":{"@type":"AggregateRating","ratingValue":"4.5","reviewCount":"8721"}},"@type":"ListItem","position":1},{"item":{"@id":"https://www.zoominfo.com/products/marketing#product","url":"https://www.zoominfo.com/products/mark