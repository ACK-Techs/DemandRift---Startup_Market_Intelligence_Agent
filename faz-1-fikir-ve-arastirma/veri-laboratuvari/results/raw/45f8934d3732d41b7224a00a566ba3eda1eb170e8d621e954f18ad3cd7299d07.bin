odule-scss-module__cWygWW__tag_container"><div data-cy="tag" class="Tag-module-scss-module__8wnQpW__tag_container Tag-module-scss-module__8wnQpW__filled Tag-module-scss-module__8wnQpW__xs" style="background-color:rgba(32, 43, 82, 0.70);color:#FFFFFF"><p class="xs">Read More</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__popup_container"><img alt="adobe-logomark" data-cy="image" loading="eager" width="32" height="32" decoding="async" data-nimg="1" class="LogoQuoteItem-module-scss-module__cWygWW__popup_logo" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/2975IPpb0Yn2OeXvpcWKft/612cd8771f797bdde2f79f9113106b62/adobe-logomark.svg"/><p class="LogoQuoteItem-module-scss-module__cWygWW__popup_text small max-text-rows-5">&quot;I was able to directly connect VP Tech using ZoomInfo which helped me grab a wholesome deal covering 43 percent of my QRF.&quot;</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_name neutral-800 xs bold">Abhishek Kumar</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_title neutral-800 xs">SDR</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:2.4rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="Google logo" data-cy="image" loading="eager" width="65" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/7fbVHLgfktvq1TlEtgTPBQ/c425ac20ba4db93d9a902c5bea4d6593/google-logo.svg"/></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:5.3rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="microsoft-logo" data-cy="image" loading="eager" width="95" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/3crRP9t8cAIwvZSrs9Rssm/d0a93167d89bb67f620321e234c7581b/microsoft-logo.svg"/></div><div class="LogoQuoteItem-module-scss-module__cWygWW__tag_container"><div data-cy="tag" class="Tag-module-scss-module__8wnQpW__tag_container Tag-module-scss-module__8wnQpW__filled Tag-module-scss-module__8wnQpW__xs" style="background-color:rgba(32, 43, 82, 0.70);color:#FFFFFF"><p class="xs">Read More</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__popup_container"><img alt="microsoft-logomark" data-cy="image" loading="eager" width="32" height="32" decoding="async" data-nimg="1" class="LogoQuoteItem-module-scss-module__cWygWW__popup_logo" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/2emV17ejDpWsYAVuvYLlpZ/e805924b7a725a316fd0075c4029c9d2/microsoft-logomark.svg"/><p class="LogoQuoteItem-module-scss-module__cWygWW__popup_text small max-text-rows-5">&quot;Using ZoomInfo, I was able to get in touch with a new CIO, and start a new sales process. The way they have updates on companies and industries really helped me to be educated when speaking with new prospects.&quot;</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_name neutral-800 xs bold">Caio Lima</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_title neutral-800 xs">Digital Sales</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:2.4rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="airbnb logo.svg" data-cy="image" loading="eager" width="65" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/5EVqixotGqk1Jwq8OSWewF/50c6b5569057bf57e2f7867060be9ef2/logo-container.svg"/></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:5.3rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="aws logo" data-cy="image" loading="eager" width="34" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/yp19aWhGGABtJsvhAxCHn/14db6108733949d342f5a3b6fb1820fb/aws_logo.svg"/></div><div class="LogoQuoteItem-module-scss-module__cWygWW__tag_container"><div data-cy="tag" class="Tag-module-scss-module__8wnQpW__tag_container Tag-module-scss-module__8wnQpW__filled Tag-module-scss-module__8wnQpW__xs" style="background-color:rgba(32, 43, 82, 0.70);color:#FFFFFF"><p class="xs">Read more</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__popup_container"><img alt="AWS logomark" data-cy="image" loading="eager" width="32" height="32" decoding="async" data-nimg="1" class="LogoQuoteItem-module-scss-module__cWygWW__popup_logo" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/1gygG9XfaR6ThIqbLvK70J/c58a366dc32dd8aafc653c3d29d3a07f/aws-logomark.svg"/><p class="LogoQuoteItem-module-scss-module__cWygWW__popup_text small max-text-rows-5">&quot;ZoomInfo allows me to find out more useful information about a wider range of companies that other tools do not have, such as company revenue and industry. This gives me wider account visibility, and my pipeline has grown 4x&quot;</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_name neutral-800 xs bold">Ariff Ridzuan</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_title neutral-800 xs"></p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:2.4rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="figma-logo" data-cy="image" loading="eager" width="72" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/3cFGJYeYt1wRwuy9DmBNys/4637f8e9bd8ccec1acc0a6b8b07bde30/logo-quote.svg"/></div></div><a data-cy="logo-image" data-automation-id="link" href="https://www.zoominfo.com/about/case-studies/seismic" class="LogoQuoteItem-module-scss-module__cWygWW__logo_container pointer" style="height:5.3rem"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="seismic-logo" data-cy="image" loading="eager" width="109" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/1pPuXiR1oFnLCOXJJPQUUB/8e0838ff500f2ded284bca8f7b4f1d8f/seismic-logo.svg"/></div><div class="LogoQuoteItem-module-scss-module__cWygWW__tag_container"><div data-cy="tag" class="Tag-module-scss-module__8wnQpW__tag_container Tag-module-scss-module__8wnQpW__filled Tag-module-scss-module__8wnQpW__xs" style="background-color:rgba(32, 43, 82, 0.70);color:#FFFFFF"><p class="xs">Case Study</p></div></div><div class="LogoQuoteItem-module-scss-module__cWygWW__popup_container"><img alt="Seismic logomark" data-cy="image" loading="eager" width="32" height="32" decoding="async" data-nimg="1" class="LogoQuoteItem-module-scss-module__cWygWW__popup_logo" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/4GLNhMeKfmCjZGZdovmm7n/5d3929a88ef2396d7fcb4aef08dec686/seismic-logomark.svg"/><p class="LogoQuoteItem-module-scss-module__cWygWW__popup_text small max-text-rows-5">&quot;I’m really excited about the power of generative AI in general, and working with Copilot is a no-brainer because ZoomInfo is one of the key platforms in our tech stack.&quot;</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_name neutral-800 xs bold">Toby Carrington</p><p class="LogoQuoteItem-module-scss-module__cWygWW__author_title neutral-800 xs">Chief Business Officer</p></div></a><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_container" style="height:2.4rem" data-cy="logo-image"><div class="LogoQuoteItem-module-scss-module__cWygWW__logo_wrapper"><img alt="canva-logo" data-cy="image" loading="eager" width="63" height="20" decoding="async" data-nimg="1" class="cimg LogoQuoteItem-module-scss-module__cWygWW__cimg" style="color:transparent" src="https://images.ctfassets.net/kyld7105l6mt/4cb1FjN0i72oQ0pxBnBeIf/c90ead2b91582fe6164322967774241c/canva-logo.svg"/></div></div></div></div></div></div></div></div></div></div><div><div class="SectionPricingCardTabs-module-scss-module__RLyDDa__wrapper text-center" data-cy="section-pricing-card-tabs"><div class="SectionPricingCardTabs-module-scss-module__RLyDDa__header" data-cy="tabs-header"><h2 class="SectionPricingCardTabs-module-scss-module__RLyDDa__title h2" data-cy="tabs-title">Learn more about each package that ZoomInfo products offer</h2></div><div class="SectionPricingCardTabs-module-scss-module__RLyDDa__tabs tabs" data-cy="tabs-container"><div class="TabContainer-module-scss-module__aUicSG__wrapper"><div class="TabContainer-module-scss-module__aUicSG__tab_container TabContainer-module-scss-module__aUicSG__light"><div class="TabContainer-module-scss-module__aUicSG__tab_content"><button role="tab" data-cy="tab-button" data-tab-index="0" class="TabContainer-module-scss-module__aUicSG__tab_item TabContainer-module-scss-module__aUicSG__active"><span class="TabContainer-module-scss-module__aUicSG__tab_text_wrapper"><span class="TabContainer-module-scss-module__aUicSG__tab_text p">Sales plans</span><span class="TabContainer-module-scss-module__aUicSG__tab_text_placeholder p" aria-hidden="true">Sales plans</span></span></button><button role="tab" data-cy="tab-button" data-tab-index="1" class="TabContainer-module-scss-module__aUicSG__tab_item"><span class="TabContainer-module-scss-module__aUicSG__tab_text_wrapper"><span class="TabContainer-module-scss-module__aUicSG__tab_text p">Marketing plans</span><span class="TabContainer-module-scss-module__aUicSG__tab_text_placehold