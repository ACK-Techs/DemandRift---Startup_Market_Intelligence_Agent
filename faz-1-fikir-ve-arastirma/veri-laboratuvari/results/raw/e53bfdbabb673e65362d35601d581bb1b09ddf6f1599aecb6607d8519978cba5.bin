ta":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"informationRibbon"},"productRatings":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"18","name":"Ratings & Reviews","impressionType":"ratingsOverview","idType":"sequential","impressionIndex":2}},"contentType":"productRatings","marker":null,"items":[{"$kind":"Ratings","productId":"546473125","ratingAverage":4.8,"totalNumberOfRatings":1120700,"context":"productPage","ratingCounts":[991924,72589,20370,6917,28900]}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"See All","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/546473125?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"SeeAllReviews"}],"eventType":"click","targetType":"button","targetId":"SeeAllReviews","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageUrl":"https://apps.apple.com/us/app/546473125?see-all=reviews&platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","platform":"iphone","id":"546473125","see-all":"reviews","$kind":"SeeAllPageIntent"}},"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"productRatings"},"allProductReviews":{"$kind":"Shelf","impressionMetrics":null,"contentType":"productReview","marker":null,"items":[{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"12951600868","title":"A Complete Guide to What I Think of Quizlet","date":"2025-07-29T18:30:48.000Z","dateText":"* null *","contents":"This helps me a lot to remember words. Just know that I think your best bet to acing your test would be to start with Flashcards, in which you can organize the cards from Know to Don't Know. Then you can practice the terms you Don't know. Then, you can do the other stuff. The \"Learn\" is also nice, but you have to pay to do it, in which it is slightly aggravating, but they have other options as well. After doing all of them, I like to take a test, just to make sure. I really liked Q-chat, but I think they got rid of them. I don't know why. That helped me A LOT. People who know what I mean, I get you. When you first start, locating all those buttons is A LITTLE hard, but once you get it you get it. It's like riding a bike, it sticks with you. Anyway, it is also amazing because you can ask AI to help you make a study guide and if you don't understand what it's saying, you can make it reword. This helps me a lot. It says it makes mistakes, BUT I have not had a problem and I've made SO MANY study guides. It is also really easy to keep organized with the Quizlet's ability to make folders, sets, and name things. This app is also REALLY aesthetic, so I appreciate that. GOOD JOB, QUIZLET! You can also make your sets public and private. I appreciate all those people who make their sets public, in which I can connect with them and realize I'm not the only one studying haha. Overall, it's great. Does this help you guys?","rating":5,"reviewerName":"- ImakeHELPFULreviews -","dateAuthorText":"* null * · - ImakeHELPFULreviews -","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"12951600868","title":"A Complete Guide to What I Think of Quizlet","date":"2025-07-29T18:30:48.000Z","dateText":"* null *","contents":"This helps me a lot to remember words. Just know that I think your best bet to acing your test would be to start with Flashcards, in which you can organize the cards from Know to Don't Know. Then you can practice the terms you Don't know. Then, you can do the other stuff. The \"Learn\" is also nice, but you have to pay to do it, in which it is slightly aggravating, but they have other options as well. After doing all of them, I like to take a test, just to make sure. I really liked Q-chat, but I think they got rid of them. I don't know why. That helped me A LOT. People who know what I mean, I get you. When you first start, locating all those buttons is A LITTLE hard, but once you get it you get it. It's like riding a bike, it sticks with you. Anyway, it is also amazing because you can ask AI to help you make a study guide and if you don't understand what it's saying, you can make it reword. This helps me a lot. It says it makes mistakes, BUT I have not had a problem and I've made SO MANY study guides. It is also really easy to keep organized with the Quizlet's ability to make folders, sets, and name things. This app is also REALLY aesthetic, so I appreciate that. GOOD JOB, QUIZLET! You can also make your sets public and private. I appreciate all those people who make their sets public, in which I can connect with them and realize I'm not the only one studying haha. Overall, it's great. Does this help you guys?","rating":5,"reviewerName":"- ImakeHELPFULreviews -","dateAuthorText":"* null * · - ImakeHELPFULreviews -"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"12951600868"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":0}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"11110451786","title":"So far so good.","date":"2024-04-01T17:52:30.000Z","dateText":"* null *","contents":"I have been using this app for a while now and it’s helped me with many test. I found that when I don’t use the app often then the information or materials I enter to study is not helping. It’s only when one uses the app daily to help retain all materials one puts in the app to study. This app is help for all learners except those who have ADHD or ADD.  I could be more profitable for those who created this app to reach others who have disabilities in learning as well. Suggestion. May a learning style test could be given to help others and the test and app could be more tailored to each person using it. I do absolutely love this app those. Could you add record your own audio to this app because I would love to record and pit in more information I can study on this app to help me retain even more study materials I need to remember. Other than that it’s a great app however additional feature add would be excellent. Also, can you add another feature so if one wants to combine study materials they can do so? Oh year, ca. you also make an option where a person purchase the app for 6 months if possible?\n\nExcellent app well plan carefully but need more feature. I’m pleased with all of the feature just need to tweak it a little bit.  I would give you guys who ever created Quizlet, on a scale  of 1-5 I would give who every created this app 4.5 out of 5 stars. Please can you add the other features to take in consideration of addding the above feature suggested. Thank you so very much for creating this excellent app. \n\nHave a great day🥰😊","rating":5,"reviewerName":"AWpumkin7","dateAuthorText":"* null * · AWpumkin7","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"11110451786","title":"So far so good.","date":"2024-04-01T17:52:30.000Z","dateText":"* null *","contents":"I have been using this app for a while now and it’s helped me with many test. I found that when I don’t use the app often then the information or materials I enter to study is not helping. It’s only when one uses the app daily to help retain all materials one puts in the app to study. This app is help for all learners except those who have ADHD or ADD.  I could be more profitable for those who created this app to reach others who have disabilities in learning as well. Suggestion. May a learning style test could be given to help others and the test and app could be more tailored to each person using it. I do absolutely love this app those. Could you add record your own audio to this app because I would love to record and pit in more information I can study on this app to help me retain even more study materials I need to remember. Other than that it’s a great app however additional feature add would be excellent. Also, can you add another feature so if one wants to combine study materials they can do so? Oh year, ca. you also make an option where a person purchase the app for 6 months if possible?\n\nExcellent app well plan carefully but need more feature. I’m pleased with all of the feature just need to tweak it a little bit.  I would give you guys who ever created Quizlet, on a scale  of 1-5 I would give who every created this app 4.5 out of 5 stars. Please can you add the other features to take in consideration of addding the above feature suggested. Thank you so very much for creating this excellent app. \n\nHave a great day🥰😊","rating":5,"reviewerName":"AWpumkin7","dateAuthorText":"* null * · AWpumkin7"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"11110451786"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"1","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":1}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"10693531202","title":"The membership is more than I could have hoped for!","date":"2023-12-14T14:08:28.000Z","dateText":"* null *","contents":"As a freshman in a college preparatory highschool, this is my first time with real “finals” I would be stressed beyond belief if quizlet wasn’t so useful when it comes to studying. I’m currently using my free trial for quizlet plus but I might buy a year of it just because it’s worth it. There’s so many features I didn’t even know quizlet had! It made a flashcard set for my Honors English class just by looking at a word document and now I can study for the lit terms final without worrying. I also talked to an Ai bot who helped me learn the material for APHUG which is my worst class, and I’m confident enough for the test now! It even helped me with honors geometry; they provide tons of different textbooks with step-by-step solutions. APES was what I was most worried about, but I could just look up “APES Unit 1-5” and I found tons of quizlets that were helpful. Even when I wasn’t using the free trial and I was on basic quizlet it’s still super helpful for learning, there’s a really cool feature where you can sort flashcards into “know” and “don’t know” to help you learn the material that I’ve taken advantage of for ages and love. I highly recommend quizlet, subscription or not it’s a super useful app for studying, especially with finals coming up! Goodluck to you all, not that you’ll need it :)","rating":5,"reviewerName":"Jellyfish654","dateAuthorText":"* null * · Jellyfish654","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"10693531202","title":"The membership is more than I could have hoped for!","date":"2023-12-14T14:08:28.000Z","dateText":"* null *","contents":"As a freshman in a college preparatory highschool, this is my first time with real “finals” I would be stressed beyond belief if quizlet wasn’t so useful when it comes to studying. I’m currently using my free trial for quizlet plus but I might buy a year of it just because it’s worth it. There’s so many features I didn’t even know quizlet had! It made a flashcard set for my Honors English class just by looking at a word document and now I can study for the lit terms final without worrying. I also talked to an Ai bot who helped me learn the material for APHUG which is my worst class, and I’m confident enough for the test now! It even helped me with honors geometry; they provide tons of different textbooks with step-by-step solutions. APES was what I was most worried about, but I could just look up “APES Unit 1-5” and I found tons of quizlets that were helpful. Even when I wasn’t using the free trial and I was on basic quizlet it’s still super helpful for learning, there’s a really cool feature where you can sort flashcards into “know” and “don’t know” to help you learn the material that I’ve taken advantage of for ages and love. I highly recommend quizlet, subscription or not it’s a super useful app for studying, especially with finals coming up! Goodluck to you all, not that you’ll need it :)","rating":5,"reviewerName":"Jellyfish654","dateAuthorText":"* null * · Jellyfish654"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"10693531202"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":2}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"9304092596","title":"It's meh.","date":"2022-11-19T02:21:51.000Z","dateText":"* null *","contents":"Firstly: If you use a screen reader, you likely already know Quizlet has never been accessible on any platform whatsoever. But if you don't know, don't use the app. Use the web browser version if you have to and can, but if you somewhat use vision, you can use the app for class. The interface is awful on both, with or without a screen reader, but slightly less awful on browser if you use a screen reader. I'd go into detail, but if you use one you can find out without wasting my time. –– OTHER THAN THAT, if you have iPad, use that instead of the iPhone. Text size is a pretty wacky thing on Quizlet, so if you have medium-long words/phrases in your study set, you'll want a bugger screen because bigger text doesn't work out on the app or the web version. And now, unrelated to most of you reading: Since Quizlet's younger days. It became another feature downgraded cash grab. If it's worth it to you, no judgement there, but it won't stop me from criticizing an app that has you pay for a randomized study quiz and a badge by your name, compared to many other apps with similar subscription rates and more variety of useful features. This one is just one of few known studying apps, which is why it's worth it to people, whether they are happy about it or not. The app (Quizlet in general) is just limited in features, especially compared to what it used to be. But hey, maybe that's just because I'm blind and all this app ever says to me is \"Button.\"","rating":3,"reviewerName":"Laully_","dateAuthorText":"* null * · Laully_","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"9304092596","title":"It's meh.","date":"2022-11-19T02:21:51.000Z","dateText":"* null *","contents":"Firstly: If you use a screen reader, you likely already know Quizlet has never been accessible on any platform whatsoever. But if you don't know, don't use the app. Use the web browser version if you have to and can, but if you somewhat use vision, you can use the app for class. The interface is awful on both, with or without a screen reader, but slightly less awful on browser if you use a screen reader. I'd go into detail, but if you use one you can find out without wasting my time. –– OTHER THAN THAT, if you have iPad, use that instead of the iPhone. Text size is a pretty wacky thing on Quizlet, so if you have medium-long words/phrases in your study set, you'll want a bugger screen because bigger text doesn't work out on the app or the web version. And now, unrelated to most of you reading: Since Quizlet's younger days. It became another feature downgraded cash grab. If it's worth it to you, no judgement there, but it won't stop me from criticizing an app that has you pay for a randomized study quiz and a badge by your name, compared to many other apps with similar subscription rates and more variety of useful features. This one is just one of few known studying apps, which is why it's worth it to people, whether they are happy about it or not. The app (Quizlet in general) is just limited in features, especially compared to what it used to be. But hey, maybe that's just because I'm blind and all this app ever says to me is \"Button.\"","rating":3,"reviewerName":"Laully_","dateAuthorText":"* null * · Laully_"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"9304092596"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":3}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"3631310226","title":"Used to be a good app","date":"2019-01-09T20:59:03.000Z","dateText":"* null *","contents":"The app used to be pretty great, it was simple and very effective to make a set or study a set in order to learn something. Then they introduce ads, which is fine. Then they introduce an option to pay to use the app without ads. Fine again. But now the ads are hard to avoid and I’m pretty sure they slow down the app which then makes scrolling inaccurate. So yeah, they have now made it difficult to use the app in order to make money, which is great because it feels like now quizlet values pushing for more money from people who are just trying to view a list. Thats all the app is, a list app. The app doesn’t provide information or anything except for a network of user generated lists. So now they deserve my money so i can view a stranger’s list, a stranger who never gets any amount of money. Which again, i would be fine with if they didn’t put a huge ad right after the first three items and then another right at the top that then goes to the bottom of the screen when you scroll down. So now an ad doesn't even go away unless you hit the x on it and then that portion of the screen just says ads closed by google and you still dont get any of the screen space back. Really irritating and impinges on the usefulness of the app unless i pay them $12-22 for a product they essentially do not even make worth anything in any way except by being fortunate enough to be used by so many people. Charge for maintaining the app, thats fine, but dont ransom the usefulness of the app to the users.","rating":3,"reviewerName":"Raydiggitynodoubt","dateAuthorText":"* null * · Raydiggitynodoubt","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"3631310226","title":"Used to be a good app","date":"2019-01-09T20:59:03.000Z","dateText":"* null *","contents":"The app used to be pretty great, it was simple and very effective to make a set or study a set in order to learn something. Then they introduce ads, which is fine. Then they introduce an option to pay to use the app without ads. Fine again. But now the ads are hard to avoid and I’m pretty sure they slow down the app which then makes scrolling inaccurate. So yeah, they have now made it difficult to use the app in order to make money, which is great because it feels like now quizlet values pushing for more money from people who are just trying to view a list. Thats all the app is, a list app. The app doesn’t provide information or anything except for a network of user generated lists. So now they deserve my money so i can view a stranger’s list, a stranger who never gets any amount of money. Which again, i would be fine with if they didn’t put a huge ad right after the first three items and then another right at the top that then goes to the bottom of the screen when you scroll down. So now an ad doesn't even go away unless you hit the x on it and then that portion of the screen just says ads closed by google and you still dont get any of the screen space back. Really irritating and impinges on the usefulness of the app unless i pay them $12-22 for a product they essentially do not even make worth anything in any way except by being fortunate enough to be used by so many people. Charge for maintaining the app, thats fine, but dont ransom the usefulness of the app to the users.","rating":3,"reviewerName":"Raydiggitynodoubt","dateAuthorText":"* null * · Raydiggitynodoubt"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"3631310226"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":4}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"5235965306","title":"Great Study Tool","date":"2019-12-05T12:02:20.000Z","dateText":"* null *","contents":"I love this app. I started using it with just the free version and some sets that I had been given access to. So far, I have used it mostly to help me learn languages. With the pre-made one it was nice to hear the recordings the creators of my course made. This application was a big help in my mastery of the language in just a few short months. It really helped me learn the vocab. Later on, I started wanting to use it offline due to limited internet where I was. That was when I bought the year subscription. It is a reasonable price and was worth it to me in the long run. \n\nNow, I am in a different country and trying to learn a different language. There were not sets made for my particular course yet so I have been adding them as I go. The ability to scan documents has been a huge time saver and makes it easy to create new sets in minutes. I also like the new flip cards, it makes it that much easier to study as if I actually had flashcards in my hands. That way I don't have to make and carry around piles of flash cards. Plus, there a many ways to study and learn the materials and I like the variety of options available. It keeps it fresh. \n\nThe one thing that I think could make it better would be if you could combine lists together for review purposes. That way I could study all the words at once that I have learned. However, I can still go back to another set very easily to review. Maybe on one set I'll run through the flash cards, maybe on another I'll take a quiz to check what I remember, and on another I might play the speed matching game a few times. All-in-all it is an excellent app! I'm so glad to have it!!","rating":5,"reviewerName":"Katt2218","dateAuthorText":"* null * · Katt2218","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"5235965306","title":"Great Study Tool","date":"2019-12-05T12:02:20.000Z","dateText":"* null *","contents":"I love this app. I started using it with just the free version and some sets that I had been given access to. So far, I have used it mostly to help me learn languages. With the pre-made one it was nice to hear the recordings the creators of my course made. This application was a big help in my mastery of the language in just a few short months. It really helped me learn the vocab. Later on, I started wanting to use it offline due to limited internet where I was. That was when I bought the year subscription. It is a reasonable price and was worth it to me in the long run. \n\nNow, I am in a different country and trying to learn a different language. There were not sets made for my particular course yet so I have been adding them as I go. The ability to scan documents has been a huge time saver and makes it easy to create new sets in minutes. I also like the new flip cards, it makes it that much easier to study as if I actually had flashcards in my hands. That way I don't have to make and carry around piles of flash cards. Plus, there a many ways to study and learn the materials and I like the variety of options available. It keeps it fresh. \n\nThe one thing that I think could make it better would be if you could combine lists together for review purposes. That way I could study all the words at once that I have learned. However, I can still go back to another set very easily to review. Maybe on one set I'll run through the flash cards, maybe on another I'll take a quiz to check what I remember, and on another I might play the speed matching game a few times. All-in-all it is an excellent app! I'm so glad to have it!!","rating":5,"reviewerName":"Katt2218","dateAuthorText":"* null * · Katt2218"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"5235965306"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":5}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"13818308908","title":"Amazing Website, but App is Not Necessary","date":"2026-03-06T03:07:23.000Z","dateText":"* null *","contents":"Quizlet is such an amazing site, which helps me memorize a lot of information in a short amount of time. I definitely recommend turning on the “track progress” feature when you’re doing flashcards, so you can focus on what you’re struggling with. My school has a program that enables us to get access to quizlet plus for free, but I would still pay even if I had to. This is one of the very few apps that I would say is actually worth the money. One of the things that I find most helpful is that you can send Quizlets to other people, and you can even search the web for study sets. I often search up names of my friends or teachers, which ends up saving me lots of time. The new AI teacher feature is actually so helpful. The only thing I would say, is that the app is not that necessary. Sure, it’s more organized than the website, but it does not have many of the website’s features, including some of my favorites such as study groups and the ability to combine multiple Quizlets into one. I have this app, but I almost always use the website instead. Overall, I think that using Quizlet is necessary, but the app is not. I give this five stars because there were so many A’s that I couldn’t have gotten without using Quizlet. Thanks for reading if you made it to the end!","rating":4,"reviewerName":"reviewsbytara","dateAuthorText":"* null * · reviewsbytara","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"8","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"13818308908","title":"Amazing Website, but App is Not Necessary","date":"2026-03-06T03:07:23.000Z","dateText":"* null *","contents":"Quizlet is such an amazing site, which helps me memorize a lot of information in a short amount of time. I definitely recommend turning on the “track progress” feature when you’re doing flashcards, so you can focus on what you’re struggling with. My school has a program that enables us to get access to quizlet plus for free, but I would still pay even if I had to. This is one of the very few apps that I would say is actually worth the money. One of the things that I find most helpful is that you can send Quizlets to other people, and you can even search the web for study sets. I often search up names of my friends or teachers, which ends up saving me lots of time. The new AI teacher feature is actually so helpful. The only thing I would say, is that the app is not that necessary. Sure, it’s more organized than the website, but it does not have many of the website’s features, including some of my favorites such as study groups and the ability to combine multiple Quizlets into one. I have this app, but I almost always use the website instead. Overall, I think that using Quizlet is necessary, but the app is not. I give this five stars because there were so many A’s that I couldn’t have gotten without using Quizlet. Thanks for reading if you made it to the end!","rating":4,"reviewerName":"reviewsbytara","dateAuthorText":"* null * · reviewsbytara"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"13818308908"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":6}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8959315926","title":"Do better.","date":"2022-08-09T00:50:12.000Z","dateText":"* null *","contents":"I LOVED Quizlet. But when you risk the education of others just to make more money?? I personally paid for a quiz plus a few years ago, but when I heard from my classmates and fellow students that they had to PAY for QUIZLET and could no longer continue studying how they are expected  to study for school. How is it fair that using resources like Quizlet should be at cost to struggling families and students. My fellow  classmates and I use Quizlet almost every day in our classes as a part of our education. Even though there are still features on Quizlet that are free, the most vital features on Quizlet are now at cost for our own education. Now they can  no longer exceed expectations that school requires for studying , with having to pay for test mode and more learning rounds— which helps millions of students study every single day?! Thousands and thousands of teachers use Quizlet to help teach their classes and help their students have a higher education. We beg of you PLEASE QUIZLET, I’m speaking on behalf of the thousands and thousands of students, teachers, & schools that use Quizlet on a daily basis. Not everyone is capable of paying in order to succeed in school. This is absolutely incredibly unacceptable and disgusting. When I first heard the news, I thought it was a joke. Please  Quizlet, bring back the old you. Bring back the Quizlet we all knew and loved. Make Quizlet amazing again. Thank you.\n#standwiththefight #wewanttheoldquizlet #bringbackOURquizlet","rating":1,"reviewerName":"lunafeta","dateAuthorText":"* null * · lunafeta","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"9","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8959315926","title":"Do better.","date":"2022-08-09T00:50:12.000Z","dateText":"* null *","contents":"I LOVED Quizlet. But when you risk the education of others just to make more money?? I personally paid for a quiz plus a few years ago, but when I heard from my classmates and fellow students that they had to PAY for QUIZLET and could no longer continue studying how they are expected  to study for school. How is it fair that using resources like Quizlet should be at cost to struggling families and students. My fellow  classmates and I use Quizlet almost every day in our classes as a part of our education. Even though there are still features on Quizlet that are free, the most vital features on Quizlet are now at cost for our own education. Now they can  no longer exceed expectations that school requires for studying , with having to pay for test mode and more learning rounds— which helps millions of students study every single day?! Thousands and thousands of teachers use Quizlet to help teach their classes and help their students have a higher education. We beg of you PLEASE QUIZLET, I’m speaking on behalf of the thousands and thousands of students, teachers, & schools that use Quizlet on a daily basis. Not everyone is capable of paying in order to succeed in school. This is absolutely incredibly unacceptable and disgusting. When I first heard the news, I thought it was a joke. Please  Quizlet, bring back the old you. Bring back the Quizlet we all knew and loved. Make Quizlet amazing again. Thank you.\n#standwiththefight #wewanttheoldquizlet #bringbackOURquizlet","rating":1,"reviewerName":"lunafeta","dateAuthorText":"* null * · lunafeta"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"546473125","targetReviewId":"8959315926"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":7}}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"allProductReviews"},"mostRecentVersion":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"20","name":"What’s New","impressionType":"versionHistory","idT