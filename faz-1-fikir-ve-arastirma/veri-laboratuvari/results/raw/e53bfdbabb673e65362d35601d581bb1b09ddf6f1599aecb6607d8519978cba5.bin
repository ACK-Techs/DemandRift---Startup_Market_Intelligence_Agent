nArtwork%2CcustomPromotionalText%2CcustomScreenshotsByType%2CcustomVideoPreviewsByType%2Cdescription%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"541164041","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"541164041","name":"Microsoft Copilot","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":0,"contentRating":313,"bundleId":"com.microsoft.officemobile"}}},{"$kind":"Lockup","adamId":"546473125","bundleId":"com.quizlet.quizlet","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.21176470588235294,"green":0.25882352941176473,"blue":0.788235294117647,"type":"rgb"},"textColor":{"red":0.9098039215686274,"green":0.9176470588235294,"blue":0.996078431372549,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/a3/0a/00/a30a002a-74c9-1056-32c2-8f91515ecd95/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Quizlet: More than Flashcards","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Walk into every test ready","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Walk into every test ready","editorialTagline":"Study smarter","shortEditorialDescription":"Study smarter.","ageRating":"4+","productDescription":"Whatever you're studying, a language, the MCAT, or next week's history quiz, Quizlet helps you turn any material into personalized study tools, then practice with the methods that actually work for you.\n\nOver 60 million students, teachers, and lifelong learners use Quizlet to study smarter, including 2 in 3 high schoolers and 1 in 2 college students. Students say Quizlet is the fastest way to prepare for a test and 87% say it helps them build a real study habit.\n\nTurn any material into study tools in seconds\n- Audio Recording: Record or upload a lecture and Quizlet turns it into organized study guides and flashcards automatically, so you can spend less time transcribing, more time learning.\n- Flashcards & Study Guides: Type, paste, or upload your notes and Quizlet builds a complete study set for you.\n- Ask Quizlet: Get instant, clear explanations for to get unstuck on homework or practice problems. \n\nStudy in the moments that work for you\n- Podcasts: Turn your notes, sets, and study guides into conversational audio you can review on your commute, at the gym, or anywhere you're not at a desk.\n- Learn: Adaptive practice that meets you at your level and adjusts as you improve.\n\nPractice with confidence, not guesswork\n- Practice Tests: Simulate the real thing so you walk in ready.\n- Spaced Repetition: Quizlet intelligently resurfaces exactly what you need to review, right when you need it, so what you learn actually sticks.\n- Retention insights: Track your mastery over time instead of hoping it's sinking in.\n\nMake studying something you want to come back to\n- Charms: A puzzle game that turns your real course material into something genuinely fun to play.\n- Study With Friends: Track progress alongside classmates and turn solo study anxiety into shared accountability.\n\nWhy students trust Quizlet\n- 2 in 3 students trust Quizlet more than any other study app\n- 87% of students say Quizlet helps them build a study habit\n\nSource: Quizlet Survey, May 2026\n\nQuizlet is the study platform that adapts to you. Start strong, stay on track, and finish strong with confidence.\n\nQuizlet Plus subscriptions will be charged to your iTunes account. Your monthly or annual subscription automatically renews unless canceled at least 24 hours before the end of the current period. Manage your subscriptions in your Account Settings after purchase. Some features may not be available in your country or region. \n\nTerms of Service: https://quizlet.com/tos\nPrivacy Policy: https://quizlet.com/privacy","rating":4.8,"ratingCount":"1.1M","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=546473125&pricingParameters=STDQ&pg=default&appExtVrsId=891420488"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"546473125"},{"locationPosition":1,"locationType":"lockup","name":"Quizlet: More than Flashcards","idType":"its_id","id":"546473125"},{"locationPosition":1,"locationType":"todayCard","name":"Master Your Major","idType":"its_id","id":"1528380133"},{"locationPosition":11,"locationType":"swoosh","name":"Featured In","idType":"sequential","id":"25"}],"jet_adamId":"546473125","eventType":"click","targetType":"button","targetId":"546473125","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressio