d":"6663574866","name":"StudyFetch: AI Tutor","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":6,"contentRating":100,"bundleId":"com.studyfetch.mobile"}}},{"$kind":"Lockup","adamId":"1439949520","bundleId":"com.studysmarter","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.08627450980392157,"green":0.2196078431372549,"blue":0.7372549019607844,"type":"rgb"},"textColor":{"red":0.7647058823529411,"green":0.8117647058823529,"blue":0.984313725490196,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/1d/8d/5e/1d8d5e4e-5aae-fc90-7b83-c00c1a781665/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Vaia: Flashcards & Study Guide","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"AI Homework, Notes & Planner","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"AI Homework, Notes & Planner","editorialTagline":"Robust study tool","shortEditorialDescription":"Learn with more than 30 million cards.","ageRating":"4+","productDescription":"Your notes can do more than sit in a folder.\n\nTurn lecture slides, PDFs, and class notes into a personal study path with Vaia. Use AI to create flashcards and summaries, get help understanding tricky topics, and practice what you need for homework, midterms, and finals.\n\nYOUR MATERIALS, MADE FOR LEARNING\n\nA stack of slides and no idea where to start? Upload your materials and build a study guide around your own course.\n\n• Break down your material with explanations and summaries\n• Generate AI flashcards to practice key ideas\n• Follow a learning path with chapters, lessons, and questions\n\nGo from collecting notes to actually working through them.\n\nHOMEWORK HELP THAT BUILDS UNDERSTANDING\n\nStuck on a topic while doing homework? Ask Vaia's AI assistant questions about your study materials and get explanations to help you move forward. Use the homework scanner to capture a problem as input.\n\nThen put your understanding to work with flashcards and practice questions. Get help with today's material and build knowledge you can use on your next test.\n\nFLASHCARDS THAT FIT YOUR COURSE\n\nGenerate flashcards from your notes, create your own cards, or explore sets shared by other students. Practice definitions, formulas, and vocabulary by recalling the answer before you flip the card.\n\nUse spaced repetition to revisit material over time. Fit in a few cards between classes or settle into a longer study session.\n\nA STUDY PLANNER WITH A CLEAR NEXT STEP\n\nYour course becomes a structured learning path. Work through chapters, read explanations, and practice with interactive questions. See your progress and pick up where you left off.\n\nFrom biology to economics, keep your study materials and your next lesson together in one place.\n\nFIND THE GAPS BEFORE EXAM DAY\n\nThat topic looked familiar. Could you explain it without your notes? Find out with quizzes, exercises, and practice tests.\n\n• Check your understanding with multiple-choice and fill-in-the-blank questions\n• Try practice exam mode and review your results afterward\n• Revisit the topics that need more work before your midterm or final\n\nGIVE YOUR NOTES A VOICE\n\nCreate study podcasts from your materials and listen on the go. Review a topic on your commute or switch things up when you need a break from reading.\n\nSHARE THE WORK. KEEP LEARNING.\n\nExplore shared flashcards, study notes, and summaries to complement your own materials. Share your sets with classmates and bring useful resources together for your course.\n\nFrom high school homework to college finals, Vaia helps you turn your materials into something you can learn from.\n\nDownload Vaia, upload your first notes, and start your first chapter.\n\nTerms of Use: https://www.vaia.com/en-us/terms/\nPrivacy Policy: https://www.vaia.com/en-us/privacy/","rating":4.7,"ratingCount":"1.5K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1439949520&pricingParameters=STDQ&pg=default&appExtVrsId=891412563"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1439949520"},{"locationPosition":7,"locationType":"lockup","name":"Vaia: Flashcards & Study Guide","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1439949520"},{"locationPosition":14,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1439949520","eventType":"click","targetType":"button","targetId":"1439949520","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1439949520"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1439949520","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1439949520&pricingParameters=STDQ&pg=default&appExtVrsId=891412563","vendor":"StudySmarter GmbH","appName":"Vaia: Flashcards & Study Guide","bundleId":"com.studysmarter","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":false,"supportsVisionOSCompatibleIOSBinary":false,"remoteDownloadIden