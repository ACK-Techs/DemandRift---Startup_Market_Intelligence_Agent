blue":0.9764705882352941,"type":"rgb"},"textColor":{"red":0.1607843137254902,"green":0.1568627450980392,"blue":0.16470588235294117,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/b3/b0/00/b3b00078-8c7b-6bc9-6e1f-d34705c37c9c/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"StudyFetch: AI Tutor","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Trusted AI, Better Grades","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Trusted AI, Better Grades","ageRating":"4+","productDescription":"Designed by learning experts and used by millions of students worldwide, StudyFetch turns your own course materials into a study plan built around how you learn. Upload your lectures, PDFs, slides, or videos and get flashcards, quizzes, notes, and a personal AI tutor in seconds.\n\nLearning should meet you where you are, not the other way around. Every feature is built for lasting understanding so it is still there when exam day comes.\n\nHow it works:\nDrop in your material and Sparky, your personal AI tutor, creates a comprehensive study plan and breaks it into the formats proven to help you remember. You are always learning in the way that works for you.\n\nWhat you get:\n · Flashcards, quizzes, and detailed notes generated from anything you upload\n · Sparky, a voice-to-voice AI tutor you can talk with anytime, on any topic\n · Real-time lecture recording that transcribes and turns class into notes as you go\n · Progress tracking that shows what you have down and what needs more focus\n · Achievements and daily streaks to keep you consistent\n · Support for 20+ languages\n\nWhy students trust StudyFetch:\n92% of students who use StudyFetch report improved grades. Millions of students worldwide use it to prep for exams, master course content, and build knowledge that lasts. Whether you are in high school, university, or learning on your own, StudyFetch adapts to you.\n\nStudyFetch is backed by Owl Ventures and The College Board and built to help you actually learn, not to hand you the answer and move on.\n\nYour future is in your hands. StudyFetch is here to help you see it.\n\nApp EULA:\nhttps://www.apple.com/legal/internet-services/itunes/dev/stdeula/\n","rating":4.8,"ratingCount":"14K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6663574866&pricingParameters=STDQ&pg=default&appExtVrsId=891842751"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6663574866"},{"locationPosition":6,"locationType":"lockup","name":"StudyFetch: AI Tutor","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6663574866"},{"locationPosition":14,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"6663574866","eventType":"click","targetType":"button","targetId":"6663574866","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6663574866"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"6663574866","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=6663574866&pricingParameters=STDQ&pg=default&appExtVrsId=891842751","vendor":"Study Fetch","appName":"StudyFetch: AI Tutor","bundleId":"com.studyfe