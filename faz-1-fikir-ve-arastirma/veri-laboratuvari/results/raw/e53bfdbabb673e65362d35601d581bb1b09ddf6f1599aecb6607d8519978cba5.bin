stallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"669486043","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"669486043","name":"Flash Cards Flashcards Maker","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":4,"contentRating":100,"bundleId":"com.AndrewMaule.FlashCardsFree"}}},{"$kind":"Lockup","adamId":"689185915","bundleId":"com.ankiapp.client","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9882352941176471,"green":0.7725490196078432,"blue":0.4627450980392157,"type":"rgb"},"textColor":{"red":0.08627450980392157,"green":0.08235294117647059,"blue":0.0784313725490196,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/3a/67/54/3a675454-2afa-5c25-bfe0-cb0e7114f4f3/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"AlgoApp - Flashcards","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Advanced spaced repetition","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Advanced spaced repetition","ageRating":"13+","productDescription":"Learn languages, or study for school and tests, with the most powerful and user-friendly flashcard app. Millions of language-learners and students have studied over 2 billion flashcards with AlgoApp. Ranked #1 Education app in multiple countries world-wide. Featured in the New York Times.\n\nDesigned by learning experts, including a published neuroscientist. Whether you're learning a language to live somewhere new or just for fun, need to get through med school, or just want to crush your tests, AlgoApp has already done it for over 5 million people.\n\nWhy AlgoApp?\n\nFOR LANGUAGE LEARNERS\n• Automatic translation. Make vocab flashcards faster by typing words in the language you know, then AlgoApp translates to the language you're learning (or vice versa). Supports 120 languages including Japanese, Chinese, Korean, English, German, French, and more...\n\n• Speaks flashcards to you, in dozens of languages (automatic text-to-speech). Supports 39 languages including Japanese, Chinese, Korean, English, German, French, and more...\n\n• Automatically generates furigana annotations for kanji, or pinyin annotations for hanzi.\n\nFOR STUDENTS\n• Converts PDFs directly into flashcards using AI. Upload lecture slides and have a full deck of flashcards ready in seconds.\n\n• Prompt AI to make flashcards for you based on text and pictures. Turns handwritten notes and diagrams into flash cards for you.\n\n• Format your cards with colored text, bulleted lists, underlines, and more (no CSS needed).\n\n• Works offline, so you can study and make cards even when you don't have signal.\n\n• Syncs automatically with desktop, web app, and your other phones and tablets. So you can make cards on a computer with a full keyboard, then study on your phone.\n\n• Natively supports FSRS, the most-advanced spaced repetition algorithm.\n\n• Imports Anki decks (.apkg), AlgoApp (.xml) files, or spreadsheets (.csv).\n\n• Supports folders and subfolders, to keep your classes organized.\n\n• Notifications tell you when it's time to study (opt-in).\n\n• Share decks and study with your friends using Study Groups.\n\n• No ads.\n\nFor the most-dedicated students, try AlgoApp Unlimited free for 7 days. Study as much as you want on all your devices.\n\nIf you want to upgrade to AlgoApp Unlimited, you can either purchase \"Unlimited: 1-Year\" which is a 1-year auto-renewing subscription, or \"Unlimited: Lifetime\" which is a one-time purchase.\n• Unlimited grants you access to unlimited cross-platform multi-device sync, and more..\n• If you choose \"Unlimited: 1-Year\", the subscription will automatically renew, unless auto-renew is turned off at least 24-hours before the end of the current period. Payment will be charged to your Apple Account within 24-hours before the end of the current period (renewal or trial period).\n• You can manage your subscription and disable auto-renewal by going to your Account Settings after purchase.\n\nTerms of Service: https://www.algoapp.ai/terms.html\nPrivacy Policy: https://www.algoapp.ai/privacy.html\n","rating":4.7,"ratingCount":"20K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=689185915&pricingParameters=STDQ&pg=default&appExtVrsId=891743837"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"689185915"},{"locationPosition":5,"locationType":"lockup","name":"AlgoApp - Flashc