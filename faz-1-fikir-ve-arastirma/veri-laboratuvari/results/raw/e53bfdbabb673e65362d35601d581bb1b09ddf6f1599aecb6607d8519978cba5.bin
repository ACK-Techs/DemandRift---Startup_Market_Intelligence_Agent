nterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1573585542","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1573585542","name":"Noji - Flashcards study app","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":1,"contentRating":100,"bundleId":"com.vedasapps.flashcards"}}},{"$kind":"Lockup","adamId":"442415567","bundleId":"com.brain-scape.sa.portal","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"textColor":{"red":0.13725490196078433,"green":0.11372549019607843,"blue":0.10980392156862745,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/7d/13/69/7d13690c-fe22-8af1-d6e1-0f7c463f5322/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Brainscape - Study Flashcards","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Learn Faster & Remember Longer","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Learn Faster & Remember Longer","ageRating":"9+","productDescription":"Learn faster and remember longer with Brainscape, the AI flashcard app that combines scientifically proven spaced repetition and active recall.  Create flashcards instantly from notes, PDFs, images, and text, or study millions of expert-created flashcards for exams, languages, certifications, and more. Whether you're switching from Anki or another flashcard app, Brainscape helps you study more efficiently.\n\nBrainscape’s intelligent study system is designed around proven cognitive science principles that help you learn faster and remember longer. By combining active recall, metacognition, and spaced repetition, Brainscape helps serious learners spend less time studying and retain more of what they learn.\n\nHow Brainscape works.\nStudy any subject using smart flashcards designed to maximize retention:\n- Actively recall answers instead of passively rereading notes\n- Rate your confidence from 1–5 after each card\n- Let Brainscape automatically optimize review timing using spaced repetition\n- Focus more time on difficult concepts and less on material you've already mastered\n\nThis unique combination of active recall, self-assessment (metacognition), and spaced repetition is designed to help you learn more efficiently.\n\nWhere do all of Brainscape’s awesome flashcards come from? Three places:\n\n1. Exper-created flashcards: Study professionally designed collections covering:\n- Foreign languages\n- MBE (Bar Exam)\n- NCLEX\n- MCAT\n- AP courses\n- Series 7\n- GRE\n- And many more\n\n2. Community-created flashcards: Search millions of flashcards created by students, teachers, professionals, and organizations around the world.\n\n3. Create your own flashcards: Instantly create multimedia flashcards from:\n- Notes\n- PDFs\n- Images\n- Documents\n- Text input\n\nAdd images, audio, and collaborate with classmates or colleagues.\n\nWhy learners all over the world use Brainscape\n- AI-powered flashcard creation\n- Scientifically designed spaced repetition\n- Active recall learning techniques\n- Progress tracking and study insights\n- Millions of existing flashcards ready to study\n- Available across web and mobile devices\n\nHow much does it cost? Creating and sharing great text flashcards is FREE. (Woohoo! And sorry, we do have to charge for image creation for security reasons.) And for unlimited access to ALL of Brainscape's user-generated and premium, expert-curated content, as well as optional features, like bookmarks and card reversibility--or to me your content private, you can upgrade to Pro for $19.99 (monthly), $59.99 (every 6 months), or $95.99 (annually). Alternatively, you can unlock a LIFETIME of learning with Brainscape for a one-time cost of only $199.99 American dolla billz.\n\nThe fine print: The 3 recurring subscriptions (monthly, semiannual, and annual) will renew automatically within 24 hours before the end of the current period, unless auto-renew is turned off at least 24 hours before the end of the period. You can cancel auto-renewal any time by going to Account Settings, and the cancellation will apply after the active subscription period is complete. Go ahead and learn more about our Terms and Privacy Policy at brainscape.com/terms.\n\nWhat’s on the horizon? It’s our vision to empower everyone, everywhere to rise to the challenge of personalized forever-learning. And for this reason, we love hearing from our user community: it’s through your feedback that we can continue to innovate our platform to be more convenient, efficient, and even fun and social to use!","rating":4.8,"ratingCount":"21K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=442415567&pricingParameters=STDQ&pg=default&appExtVrsId=891490961"},"location":[{"locationPosition":0,"locationType":"button","name":"Get"