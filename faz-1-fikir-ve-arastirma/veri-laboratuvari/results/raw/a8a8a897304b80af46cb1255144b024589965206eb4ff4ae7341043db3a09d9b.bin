        </div>

        <button class="menu-item">Ekran Okuyucu</button>
        <button class="menu-item">Seçili Alan Okuyucu</button>
        <button class="menu-item">Bağlantı Vurgula</button>
        <button class="menu-item">Büyük Metin</button>
        <button class="menu-item">Metni Sola Hizala</button>
        <button class="menu-item">İmleç</button>
        <button class="menu-item">Okuma Kılavuzu</button>
        <button class="menu-item">Okuma Maskesi</button>
        <button class="menu-item">Disleksi Dostu</button>
        <button class="menu-item">Kontrast</button>
        <button class="menu-item">Solgunlaştırma</button>
        <button class="menu-item">Düşük Doygunluk</button>
        <button class="menu-item">Yüksek Doygunluk</button>

        <div class="menu-footer">
            <button id="reset-accessibility">Erişilebilirlik Ayarlarını Temizle</button>
        </div>
    </div>
