<script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            // --- 1. Değişken Tanımlamaları ---
            var button = document.getElementById('accessibility-button');
            var menu = document.getElementById('accessibility-menu');
            var body = document.body;

            var menuItems = menu ? menu.querySelectorAll('.menu-item') : null;
            var resetButton = document.getElementById('reset-accessibility');

            var contentWrapper = document.getElementById('main-content-wrapper') || body;

            // Okuma Aracı Değişkenleri
            var readingGuide = document.getElementById('reading-guide');
            var maskTop = document.getElementById('reading-mask-top');
            var maskBottom = document.getElementById('reading-mask-bottom');

            // Sesli Okuma Değişkenleri
            var isSpeaking = false;
            var speechUtterance = null;
            var synth = window.speechSynthesis;

            // Durum Değişkenleri
            var isScreenReaderActive = false;
            var isSelectionReaderActive = false;

            // Özellik Eşlemesi
            var features = {
                'Ekran Okuyucu': 'screen-reader-active',
                'Seçili Alan Okuyucu': 'highlight-focus',
                'Bağlantı Vurgula': 'highlight-links',
                'Büyük Metin': 'large-text',
                'Metni Sola Hizala': 'align-left',
                'İmleç': 'large-cursor',
                'Okuma Kılavuzu': 'reading-guide-active',
                'Okuma Maskesi': 'reading-mask-active',
                'Disleksi Dostu': 'dyslexia-friendly',
                'Kontrast': 'high-contrast',
                'Solgunlaştırma': 'desaturate',
                'Düşük Doygunluk': 'low-saturation',
                'Yüksek Doygunluk': 'high-saturation'
            };

            var colorClasses = ['high-contrast', 'desaturate', 'low-saturation', 'high-saturation'];


            // --- 2. Yardımcı Fonksiyonlar ---

            function moveGuide(e) {
                if (readingGuide && body.classList.contains('reading-guide-active')) {
                    var guideHeight = readingGuide.offsetHeight;
                    readingGuide.style.top = (e.clientY - (guideHeight / 2)) + 'px';
                }
            }
            function moveMask(e) {
                if (maskTop && maskBottom && body.classList.contains('reading-mask-active')) {
                    var lineFocus = 40;
                    maskTop.style.height = Math.max(0, e.clientY - lineFocus) + 'px';
                    maskBottom.style.height = Math.max(0, window.innerHeight - e.clientY - lineFocus) + 'px';
                }
            }


            // Sesli Okuma Fonksiyonu
            function toggleSpeech(textToRead) {
                if (!('speechSynthesis' in window)) {
                    console.error("Tarayıcınız Metin Okuma özelliğini desteklemiyor.");
                    return;
                }

                if (isSpeaking) {
                    synth.cancel();
                    isSpeaking = false;
                    updateActiveState();
                    return;
                }

                if (!textToRead || textToRead.trim().length === 0) {
                    return;
                }

                if (synth.speaking) {
                    synth.cancel();
                    isSpeaking = false;
                    updateActiveState();
                }

                speechUtterance = new SpeechSynthesisUtterance(textToRead);
                speechUtterance.lang = document.documentElement.lang || 'tr-TR';

                speechUtterance.onend = function () { isSpeaking = false; updateActiveState(); };
                speechUtterance.onerror = function (event) {
                    console.error('Speech Synthesis Error:', event);
                    isSpeaking = false; updateActiveState();
                };

                synth.speak(speechUtterance);
                isSpeaking = true;
                updateActiveState();
            }

            // Seçili Metni Alıp Okuyan Fonksiyon
            function readSelectedTextAfterSelection() {
                if (!isSelectionReaderActive || isSpeaking) {
                    return;
                }

                var selectedText = '';
                if (window.getSelection) {
                    selectedText = window.getSelection().toString();
                } else if (document.selection && document.selection.type !== "Control") {
                    selectedText = document.selection.createRange().text;
                }

                if (selectedText && selectedText.trim().length > 0) {
                    toggleSpeech(selectedText.trim());
                }
            }

            // Tüm Sayfayı Okuma Mantığı
            function readFullPage() {
                var targetElement = contentWrapper || body;

                var contentText = targetElement.innerText || targetElement.textContent;
                if (menu) {
                    // Menü metnini temizle
                    contentText = contentText.replace(new RegExp(menu.textContent.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), '');
                }
                contentText = contentText.replace(/\s\s+/g, ' ').trim();
                toggleSpeech(contentText);
            }

            // Aktif Buton Durumunu Güncelleme
            function updateActiveState() {
                if (!menuItems) return;

                menuItems.forEach(function (item) {
                    var itemText = item.textContent.trim();
                    var itemClass = features[itemText];
                    var isActive = false;

                    var elementToTest = colorClasses.includes(itemClass) ? contentWrapper : body;

                    if (itemText === 'Ekran Okuyucu') {
                        isActive = isScreenReaderActive;
                    } else if (itemText === 'Seçili Alan Okuyucu') {
                        isActive = isSelectionReaderActive || elementToTest.classList.contains(itemClass);
                    } else if (itemClass) {
                        isActive = elementToTest.classList.contains(itemClass);
                    }

                    if (isActive) {
                        item.classList.add('active-feature');
                    } else {
                        item.classList.remove('active-feature');
                    }
                });
            }


            // --- 3. Olay Dinleyicileri ---

            // Menü Açma/Kapama 
            if (button && menu) button.addEventListener('click', function () { menu.classList.toggle('hidden'); updateActiveState(); });
            if (document.getElementById('close-menu') && menu) document.getElementById('close-menu').addEventListener('click', function () { menu.classList.add('hidden'); });

            // KRİTİK GÜNCELLEME: Menü Dışına Tıklama ile Kapatma
            document.addEventListener('click', function (event) {
                // Metin seçimi aktifse ve tıklanan yer menü veya buton değilse, menüyü kapatma.
                if (isSelectionReaderActive) {
                    // Metin seçme işlemi menünün kapanmasını engeller
                    return;
                }

                var isClickInside = menu && button && (menu.contains(event.target) || button.contains(event.target));

                if (menu && !isClickInside && !menu.classList.contains('hidden')) {
                    menu.classList.add('hidden');
                }
            });

            // Ana Menü Öğesi Tıklama İşleyicisi
            if (menuItems && menuItems.length > 0) {
                menuItems.forEach(function (item) {
                    item.addEventListener('click', function () {
                        var text = item.textContent.trim();
                        var className = features[text];

                        if (!className) return;

                        var targetElement = colorClasses.includes(className) ? contentWrapper : body;

                        // ÖZEL İŞLEV: EKRAN OKUYUCU (Tüm Sayfayı Okuma)
                        if (text === 'Ekran Okuyucu') {
                            if (isScreenReaderActive) {
                                if (isSpeaking) synth.cancel();
                                isSpeaking = false;
                                isScreenReaderActive = false;
                            } else {
                                isScreenReaderActive = true;
                                readFullPage();
                            }
                            body.classList.toggle('screen-reader-active');
                            updateActiveState();
                            return;
                        }

                        // ÖZEL İŞLEV: SEÇİLİ ALAN OKUYUCU (Seçili Metni Okuma)
                        if (text === 'Seçili Alan Okuyucu') {

                            body.classList.toggle(className);

                            if (isSelectionReaderActive) {
                                isSelectionReaderActive = false;
                                document.removeEventListener('mouseup', readSelectedTextAfterSelection);
                                document.removeEventListener('keyup', readSelectedTextAfterSelection);
                                if (isSpeaking) synth.cancel();
                                isSpeaking = false;
                            } else {
                                isSelectionReaderActive = true;
                                // Olay dinleyicileri eklendiğinde, menü dışına tıklama kuralı engellenecek (Yukarıdaki click dinleyicisini kontrol edin)
                                document.addEventListener('mouseup', readSelectedTextAfterSelection);
                                document.addEventListener('keyup', readSelectedTextAfterSelection);
                            }
                            updateActiveState();
                            return;
                        }


                        // Diğer özelliklerin toggle mantığı
                        targetElement.classList.toggle(className);
                        var isActive = targetElement.classList.contains(className);

                        // Birbirini Dışlayan Özellikler (Kontrast/Doygunluk Yönetimi)
                        if (isActive && colorClasses.includes(className)) {
                            colorClasses.forEach(function (cls) {
                                if (cls !== className) {
                                    contentWrapper.classList.remove(cls);
                                }
                            });
                        }

                        // Özel Durum Yönetimi (Mouse Dinleyicileri - Okuma Kılavuzu/Maskesi)
                        if (className === 'reading-guide-active') {
                            if (isActive) { document.addEventListener('mousemove', moveGuide); }
                            else { document.removeEventListener('mousemove', moveGuide); }
                        }
                        if (className === 'reading-mask-active') {
                            if (isActive) { document.addEventListener('mousemove', moveMask); }
                            else {
                                document.removeEventListener('mousemove', moveMask);
                                if (maskTop && maskBottom) {
                                    maskTop.style.height = '0';
                                    maskBottom.style.height = '0';
                                }
                            }
                        }

                        updateActiveState();
                    });
                });
            }

            // --- Temizle Butonuna Tıklama Olayı ---
            if (resetButton) resetButton.addEventListener('click', function () {

                colorClasses.forEach(function (cls) {
                    contentWrapper.classList.remove(cls);
                });

                for (var key in features) {
                    var cls = features[key];
                    if (!colorClasses.includes(cls)) {
                        body.classList.remove(cls);
                    }
                }

                if (isSpeaking) synth.cancel();
                isSpeaking = false;

                isScreenReaderActive = false;
                isSelectionReaderActive = false;

                document.removeEventListener('mouseup', readSelectedTextAfterSelection);
                document.removeEventListener('keyup', readSelectedTextAfterSelection);

                document.removeEventListener('mousemove', moveGuide);
                document.removeEventListener('mousemove', moveMask);
                if (maskTop && maskBottom) {
                    maskTop.style.height = '0';
                    maskBottom.style.height = '0';
                }

                updateActiveState();
            });

            // Sayfa yüklendiğinde mevcut aktif ayarları işaretle
            updateActiveState();
        });
    </script>

<body class="home">

    <div id="reading-guide"></div>
    <div id="reading-mask-top"></div>
    <div id="reading-mask-bottom"></div>

    <div id="accessibility-button">
