    // HTMLDialogElement shipped in Chrome 37, Edge 79, Firefox 98, and Safari 15.4.
    // Our supported floor (go/browser-support) includes Firefox 78 and Safari 12.1, which
    // pre-date those releases. In those browsers the prototype patch is a no-op anyway
    // because Transcend's airgap.js also won't call showModal there, so we bail silently.
    if (typeof HTMLDialogElement === 'undefined') { return; }

    var SHADOW_HOST_ID = 'transcend-shadow-root';
    var DIALOG_CSS = 'dialog{pointer-events:none!important}dialog>*{pointer-events:auto!important}';
    var originalShowModal = HTMLDialogElement.prototype.showModal;

    HTMLDialogElement.prototype.showModal = function () {
        var root = this.getRootNode();
        if (root && root.host && root.host.id === SHADOW_HOST_ID) {
            this.show();
            return;
        }
        return originalShowModal.apply(this, arguments);
    };

    var dialogStylesheet = new CSSStyleSheet();
    dialogStylesheet.replaceSync(DIALOG_CSS);

    function adoptStylesheetIfReady() {
        var shadowHost = document.getElementById(SHADOW_HOST_ID);
        // shadowRoot is null for closed shadow roots. Transcend uses an open shadow root;
        // this entire approach (including the prototype patch above) depends on that
        // assumption. If Transcend ever switches to closed mode, the observer below would
        // never disconnect, but the CSS would also never be applied — both are acceptable
        // no-ops in that hypothetical scenario.
        if (!shadowHost || !shadowHost.shadowRoot) {
            return false;
        }
        var shadowRoot = shadowHost.shadowRoot;
        shadowRoot.adoptedStyleSheets = shadowRoot.adoptedStyleSheets.concat(dialogStylesheet);
        return true;
    }

    // The shadow root does not exist yet (this runs before airgap.js); watch for
    // it to appear, then stop — the adopted sheet persists across child re-renders.
    if (!adoptStylesheetIfReady()) {
        var observer = new MutationObserver(function () {
            if (adoptStylesheetIfReady()) {
                observer.disconnect();
            }
        });
        observer.observe(document.documentElement, {childList: true, subtree: true});
    }
})();</script><script nonce="Ikg2CWyxff8f" src="https://transcend-cdn.com/cm/619e6e3b-1a5c-4516-be11-6d77bdcbd717/airgap.js" data-cfasync="false"></script><link nonce="Ikg2CWyxff8f" rel="stylesheet" type="text/css" href="https://static.airtable.com/css/compiled/v2/public_blocks_gallery.76b66b336583724f998c5ac16c635010ad70c1b0.css"/><link nonce="Ikg2CWyxff8f" rel="stylesheet" type="text/css" href="https://static.airtable.com/css/compiled/v2/fontcustom.3cf6a1d77b4d7b83dbccdf238100db4cf55060c9.css"/><link nonce="Ikg2CWyxff8f" rel="stylesheet" type="text/css" href="https://static.airtable.com/css/compiled/v2/ios7-style-font-icons.min.f52c48deb031c9ae49b8f95f0804fd4e35b9af00.css"/><script async="" src="https://www.googletagmanager.com/gtag/js?id=G-VJY8J9RFZM" nonce="Ikg2CWyxff8f" referrerPolicy="no-referrer"></script><script type="text/javascript" nonce="Ikg2CWyxff8f">window.dataLayer = window.dataLayer || [];
