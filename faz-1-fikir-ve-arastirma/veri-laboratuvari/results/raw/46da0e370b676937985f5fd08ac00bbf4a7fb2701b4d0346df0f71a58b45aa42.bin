<script>
(function () {
  if (window.__nlCaptchaGuard) return;
  window.__nlCaptchaGuard = true;

  function isSignupForm(form) {
    try {
      var action = form.getAttribute("action") || "";
      return action.indexOf("/newsletter/subscribe") !== -1 &&
             !form.querySelector('input[name="captcha_token"]');
    } catch (_) { return false; }
  }

  document.addEventListener("submit", function (e) {
    var form = e.target;
    if (!form || form.tagName !== "FORM" || !isSignupForm(form)) return;
    e.preventDefault();
    e.stopPropagation();

    fetch("/newsletter/captcha", { headers: { "Accept": "application/json" } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "captcha_token";
        input.value = data.token || "";
        form.appendChild(input);
        form.submit(); // native submit — does not re-trigger this listener
      })
      .catch(function () { form.submit(); });
  }, true);
})();
</script>

