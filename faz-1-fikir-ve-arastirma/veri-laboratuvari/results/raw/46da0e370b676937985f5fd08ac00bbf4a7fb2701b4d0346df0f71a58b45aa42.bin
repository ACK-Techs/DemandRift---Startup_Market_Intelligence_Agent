  <div id="fi-banner-760" style="position:relative;">
  <button type="button" class="fi-banner-dismiss" data-banner-id="760"
          aria-label="Dismiss banner"
          style="position:absolute; right:10px; top:50%; transform:translateY(-50%); z-index:1002; background:rgba(0,0,0,0.25); border:0; color:#fff; width:26px; height:26px; border-radius:50%; font-size:15px; line-height:1; cursor:pointer;">&times;</button>
  <link href="https://fonts.googleapis.com/css?family=DM+Sans:400,500,700&display=swap" rel="stylesheet">
  <style>
    .fi-banner-link { transition: filter 0.15s ease; }
    .fi-banner-link:hover { filter: brightness(1.1); }
    .fi-banner-content {
      flex: 1;
      text-align: center;
      color: #fff;
      font-family: 'DM Sans', Helvetica, Arial, sans-serif;
      font-size: 18px;
      font-weight: 700;
      padding: 0 0.75rem;
      user-select: none;
      line-height: 1.2;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .fi-banner-content b {
      display: inline-block;
      background: rgba(255,255,255,0.92);
      color: #15803d;
      padding: 3px 14px;
      border-radius: 20px;
      font-weight: 700;
      font-family: 'DM Sans', Helvetica, Arial, sans-serif;
      font-size: 0.88em;
      margin-left: 10px;
      vertical-align: middle;
      transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }
    .fi-banner-link:hover .fi-banner-content b {
      background: #fff;
      color: #166534;
      transform: scale(1.05);
    }
    .fi-banner-content u { text-underline-offset: 3px; }
    @media (max-width: 640px) {
      .fi-banner-link { height: auto !important; min-height: 60px; padding: 10px 0 14px; }
      .fi-banner-stripe { width: 50px !important; }
      .fi-banner-content { -webkit-line-clamp: 2 !important; }
    }
  </style>
  <a href="/banners/760/click" target="_blank" rel="noopener noreferrer"
     class="fi-banner-link"
     style="height:60px; background:linear-gradient(90deg,#15803d,#22c55e 30%,#16a34a 50%,#22c55e 70%,#15803d); display:flex; align-items:center; overflow:hidden; text-decoration:none; position:sticky; top:0; z-index:1001; flex-shrink:0; width:100%;">
    <img src="/banners/760/impression.gif" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" loading="eager">
    <div class="fi-banner-stripe" style="flex-shrink:0; width:80px; height:100%;
                background:repeating-linear-gradient(45deg,rgba(255,255,255,0.18) 0,rgba(255,255,255,0.18) 4px,transparent 4px,transparent 10px);
                -webkit-mask-image:linear-gradient(to right,black 0%,transparent 100%);
                mask-image:linear-gradient(to right,black 0%,transparent 100%);"></div>
    <div class="fi-banner-content">
      We're hiring a Venture Associate to manage our global deal flow. Check it out.
    </div>
    <div class="fi-banner-stripe" style="flex-shrink:0; width:80px; height:100%;
                background:repeating-linear-gradient(45deg,rgba(255,255,255,0.18) 0,rgba(255,255,255,0.18) 4px,transparent 4px,transparent 10px);
                -webkit-mask-image:linear-gradient(to left,black 0%,transparent 100%);
                mask-image:linear-gradient(to left,black 0%,transparent 100%);"></div>
  </a>
</div>
<script>
  (function() {
    if (window.__fiBannerDismissBound) return;
    window.__fiBannerDismissBound = true;
    document.addEventListener('click', function(event) {
      var button = event.target.closest('.fi-banner-dismiss');
      if (!button) return;
      event.preventDefault();
      var id = button.getAttribute('data-banner-id');
      var container = document.getElementById('fi-banner-' + id) ||
                      document.getElementById('fi-logged-in-banner-' + id);
      if (container) container.style.display = 'none';
      document.body.classList.add('fi-banner-dismissed');
      fetch('/banners/' + encodeURIComponent(id) + '/dismiss', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
    });
  })();
</script>




