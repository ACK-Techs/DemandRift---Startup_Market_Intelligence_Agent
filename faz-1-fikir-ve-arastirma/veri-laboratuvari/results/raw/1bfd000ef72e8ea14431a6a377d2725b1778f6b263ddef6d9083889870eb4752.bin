a7e896676/stylesheets/common.purged.css" crossOrigin="anonymous"/><link data-react-helmet="true" rel="stylesheet" type="text/css" href="/r/dc2851b460fe11960cb032c32bbb6d0a7e896676/stylesheets/CategoryPage.css" crossOrigin="anonymous"/><link data-react-helmet="true" rel="canonical" href="https://www.trustradius.com/application-infrastructure"/><meta name="csrf-token" content="DFAKiLGx-GENXHiKmGHiF-FyN3kOXVg8BKE4"><meta http-equiv="Accept-CH" content="Viewport-Width, Downlink, Device-Memory, RTT, ECT"><meta http-equiv="Accept-CH-Lifetime" content="86400"><!-- OneTrust Cookies Consent Notice start --><script src="https://cdn.cookielaw.org/scripttemplates/otSDKStub.js" type="text/javascript" charset="UTF-8" data-domain-script="fb3dddcb-2b8d-4220-a235-e8897e09a331"></script><script type="text/javascript" src="https://cdn.cookielaw.org/consent/fb3dddcb-2b8d-4220-a235-e8897e09a331-test/OtAutoBlock.js"></script><!-- OneTrust Cookies Consent Notice end --><script>// this overrides OneTrust's geolocation in favor of the one we get from CloudFlare
var OneTrust = {
  geolocationResponse: {
    countryCode: "US"
  }
};

function OptanonWrapper() {
  // Don't show Vendor Shout-out (aka Bluebeard) before knowing whether cookie banner will be shown
  var bodyClassName = document.body.className;
  document.body.className = bodyClassName + ' js-vendor-shout-suppress';

  function revealShoutOut() {
    document.body.className = bodyClassName; // remove js-vendor-shout-suppressed
  }

  // Set a data attribute on body element to record that OneTrust loaded
  const el = document.querySelector('body');
  el.setAttribute('data-onetrust-ready', 'ready');
  // Get whether react data attribute shows ready or not
  const reactReady = el.getAttribute('data-react-ready') === 'ready';

  // Being careful about attempting events
  if (document.body && document.body.dispatchEvent && typeof Event !== 'undefined') {
    const otEvent = new Event('onetrust-refresh');
    const nodeEnv = "production";

    // Dispatch a custom event to indicate the OneTrust-powered cookie
    // privacy setting(s) have changed (allows react app pages to
    // properly initialize GA)
    if (reactReady) {
      if (nodeEnv === 'development' || nodeEnv === 'review') {
        console.info('React won race, so Onetrust OptanonWrapper dispatching event to say that OT is ready');
      }
      // If React is ready, then simply send the event
      document.body.dispatchEvent(otEvent);
    }
    else {
      if (nodeEnv === 'development' || nodeEnv === 'review') {
        console.info('Onetrust won race, so Onetrust creating an event listener to hear back when React is ready');
      }
      // If React is not ready, listen for an event from React
      document.body.addEventListener('react-ready-for-google-analytics', function (event) {
        // Then send the onetrust ready event
        document.body.dispatchEvent(otEvent);
      });
    }
  }

  if ((false || false) && !window.OneTrust.IsAlertBoxClosed()) {
    // When a user takes an action on the OneTrust consent form, this function is called
    window.OneTrust.OnConsentChanged(function() {
      revealShoutOut();
    });
  }
  else {
    revealShoutOut();
  }
}
