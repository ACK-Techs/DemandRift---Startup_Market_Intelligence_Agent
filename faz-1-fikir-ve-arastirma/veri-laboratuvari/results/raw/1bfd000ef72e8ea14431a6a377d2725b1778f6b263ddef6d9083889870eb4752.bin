ws" target="_blank" rel="noreferrer"><div class="CategoryProduct_logo__++lGd"><img alt="Gatsby" src="/vendor-logos/hq/yi/7K1FC8JS7N3G-180x180.PNG" height="110" width="110" class="lazyload Image_image__i4q4b" loading="lazy"/></div></a><div class="CategoryProduct_card-heading__TFhRe"><div class="CategoryProduct_card-product-title-wrap__ypX14"><h3 class="CategoryProduct_card-product-title__hhfnd" title="Gatsby"><a href="/products/gatsby/reviews" target="_blank" rel="noreferrer">Gatsby</a></h3></div><div class="CategoryProduct_card-rating__RVDLo"><div class="RatingStars_stars__MkCSo RatingStars_small__ZygDO"><div class="RatingStars_star__hElsq RatingStars_empty__cmKQY" data-testid="star-element"></div><div class="RatingStars_star__hElsq RatingStars_empty__cmKQY" data-testid="star-element"></div><div class="RatingStars_star__hElsq RatingStars_empty__cmKQY" data-testid="star-element"></div><div class="RatingStars_star__hElsq RatingStars_empty__cmKQY" data-testid="star-element"></div><div class="RatingStars_star__hElsq RatingStars_empty__cmKQY" data-testid="star-element"></div></div><div class="CategoryProduct_card-counts__zZrlC"><span>0 reviews</span></div></div></div><div class="CategoryProduct_card-save__vnf3e"><button style="opacity:0" class="HeartButton_icon-only__6x7jx HeartButton_save-button__fcJQ3 save-product-research-board" data-login-source="Add to List" data-hide-3q="true" aria-label="Save"><div class="HeartButton_heart-icon__5rmU9"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#191919" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart" data-testid="heart-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></div></button></div><div class="CategoryProduct_card-subheading__FiSmU"><div class="CategoryProduct_card-badges__ejDhV"><a class="Chip_chip__RmBez" 