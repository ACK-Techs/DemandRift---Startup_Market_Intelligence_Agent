# Isolated test application settings
NODE_ENV=test
APP_NAME=DemandRift-Test
APP_URL=http://localhost:3100
APP_PORT=3100
LOG_LEVEL=warn
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
AUTH_SECRET=test-only-placeholder-not-for-production

# Test PostgreSQL database
DATABASE_URL=postgresql://demandrift_test:demandrift_test@localhost:5433/demandrift_test
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=4

# Test Temporal namespace and task queue
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=demandrift-test
TEMPORAL_TASK_QUEUE=demandrift-test
TEMPORAL_TLS_ENABLED=false

# Test S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=demandrift-test
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=test-placeholder-access-key
S3_SECRET_ACCESS_KEY=test-placeholder-secret-key

# Deterministic provider mocks; real provider keys remain empty
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_BASE_URL=http://localhost:4011
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=mock-model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# Connector sandbox
CONNECTOR_HTTP_USER_AGENT=DemandRift-Test/0.1
CONNECTOR_REQUEST_TIMEOUT_MS=3000
CONNECTOR_MAX_RESPONSE_BYTES=1048576
CONNECTOR_BROWSER_ENABLED=false
CONNECTOR_DEEP_RESEARCH_ENABLED=false

# Optional test coordination
REDIS_URL=redis://localhost:6380/0

# Local test telemetry
OTEL_SERVICE_NAME=demandrift-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
