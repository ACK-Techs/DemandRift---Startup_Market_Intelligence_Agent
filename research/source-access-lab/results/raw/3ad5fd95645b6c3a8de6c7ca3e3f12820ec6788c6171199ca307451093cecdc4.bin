<style>
/* BRC consultation hero — aligned to site design tokens (clay palette, hairlines, LT Pro cuts) */
.brc-hero{background:var(--black);padding:0;font-family:var(--font-sans);}
.brc-hero__link{display:block;text-decoration:none;color:inherit;}
.brc-hero__frame{position:relative;overflow:hidden;
  padding:clamp(36px,5vw,72px) clamp(24px,4.6vw,64px);}
.brc-hero__glow{position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(720px 420px at 85% 15%, rgba(209,94,20,.16), transparent 70%),
    url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='66' height='66'%3E%3Cpath d='M0 0.5H66M0.5 0V66' stroke='rgba(255,255,255,0.05)'/%3E%3Cpath d='M33 27V39M27 33H39' stroke='rgba(255,255,255,0.14)'/%3E%3C/svg%3E");}
.brc-hero__inner{position:relative;z-index:1;display:flex;align-items:center;
  justify-content:space-between;gap:clamp(28px,5vw,72px);flex-wrap:wrap;
  max-width:1280px;margin:0 auto;}
.brc-hero__main{flex:1 1 460px;min-width:0;}
.brc-hero__chips{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;}
.brc-hero__chip{display:inline-block;border:1px solid rgba(255,255,255,.28);border-radius:999px;
  color:#fff;font-family:var(--font-label);font-weight:500;font-size:.78rem;
  letter-spacing:.06em;padding:6px 14px;}
.brc-hero__chip--live{border-color:rgba(209,94,20,.55);color:var(--clay);}
.brc-hero__title{color:#fff;font-family:var(--font-display);font-weight:700;line-height:1.12;
  margin:0 0 16px;font-size:clamp(1.5rem,2.7vw,2.3rem);}
.brc-hero__title--accent{color:var(--clay);}
.brc-hero__sub{color:var(--g300);font-weight:400;font-size:clamp(.95rem,1.3vw,1.08rem);
  line-height:1.6;max-width:600px;margin:0 0 28px;}
.brc-hero__cta{display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
.brc-hero__btn{display:inline-flex;align-items:center;gap:10px;background:var(--clay);color:#fff;
  font-family:var(--font-label);font-weight:600;font-size:1rem;border-radius:8px;
  padding:0.9rem 2.2rem;transition:background var(--transition-fast);}
.brc-hero__link:hover .brc-hero__btn{background:var(--clay-deep);}
.brc-hero__window{flex:0 0 auto;padding:26px 32px;border:1px solid rgba(255,255,255,.18);
  border-radius:12px;background:rgba(255,255,255,.04);}
.brc-hero__window-label{color:var(--g300);font-family:var(--font-label);font-weight:500;
  letter-spacing:.12em;text-transform:uppercase;font-size:.7rem;margin:0 0 18px;}
.brc-hero__dates{display:flex;align-items:center;gap:16px;}
.brc-hero__date{display:flex;flex-direction:column;line-height:1;}
.brc-hero__date--end{align-items:flex-end;}
.brc-hero__date-num{color:#fff;font-family:var(--font-numeral);font-weight:700;
  font-size:clamp(2rem,3.2vw,2.7rem);}
.brc-hero__date--end .brc-hero__date-num{color:var(--clay);}
.brc-hero__date-unit{color:var(--g300);font-family:var(--font-label);font-weight:500;
  letter-spacing:.14em;text-transform:uppercase;font-size:.68rem;margin-top:8px;}
.brc-hero__date-line{flex:1 1 70px;min-width:56px;height:1px;background:var(--clay);margin-bottom:22px;}
.brc-hero__window-note{color:var(--g300);font-size:.78rem;margin:16px 0 0;
  padding-top:14px;border-top:1px solid rgba(255,255,255,.12);}
</style>
<section class="premium-hero brc-hero">
<a class="brc-hero__link" href="https://bit.ly/brc-secondcall" target="_blank" rel="noopener noreferrer" aria-label="Second Community Consultation on the Draft Amended AFRINIC Constitution — open the consultation platform">
<div class="brc-hero__frame">
<div class="brc-hero__glow" aria-hidden="true"></div>
<div class="brc-hero__inner">
<div class="brc-hero__main">
<div class="brc-hero__chips">
<span class="brc-hero__chip">Bylaws Review Committee</span>
<span class="brc-hero__chip brc-hero__chip--live">Second round · Now open</span>
</div>
<h1 class="brc-hero__title">Community Consultation on the<br/><span class="brc-hero__title--accent">Draft Amended Constitution</span></h1>
<p class="brc-hero__sub">Review the proposed amendments section by section — the existing provision, the amendment, and the rationale — and submit your comments.</p>
<div class="brc-hero__cta">
<span class="brc-hero__btn">Open the consultation platform <span aria-hidden="true">→</span></span>
</div>
</div>
<div class="brc-hero__window">
<p class="brc-hero__window-label">Consultation Window</p>
<div class="brc-hero__dates">
<span class="brc-hero__date"><span class="brc-hero__date-num">04</span><span class="brc-hero__date-unit">Aug</span></span>
<span class="brc-hero__date-line" aria-hidden="true"></span>
<span class="brc-hero__date brc-hero__date--end"><span class="brc-hero__date-num">21</span><span class="brc-hero__date-unit">Aug</span></span>
</div>
<p class="brc-hero__window-note">Closes 21 August 2026 · 23:59 UTC</p>
</div>
</div>
</div>
</a>
</section>
